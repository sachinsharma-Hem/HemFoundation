@using Microsoft.Extensions.Configuration
@using System

@inject IConfiguration Configuration

@{
    ViewData["Title"] = "Activity Submission";
    Layout = "~/Views/Shared/Layouts/_TeacherLayout.cshtml";

    int valueItemId = ViewBag.ValueItemId;

    string fileUploadApiUrl =
        Configuration["FileSettings:InHouseUploadUrl"] ?? "";

    string fileBaseUrl = "";

    if (Uri.TryCreate(
        fileUploadApiUrl,
        UriKind.Absolute,
        out Uri? fileUri))
    {
        fileBaseUrl =
            $"{fileUri.Scheme}://{fileUri.Authority}";
    }

    // string googlePickerApiKey =
    //     Configuration["GoogleDrivePicker:ApiKey"] ?? "";

    // string googlePickerClientId =
    //     Configuration["GoogleDrivePicker:ClientId"] ?? "";

    // string googlePickerAppId =
    //     Configuration["GoogleDrivePicker:AppId"] ?? "";
}

<div class="container-fluid py-4">
    <!-- Header -->
    <div class="custom-page-header mb-4 p-4 rounded-4 shadow-sm text-white d-flex justify-content-between align-items-center">
        <div>
            <h3 class="fw-bolder mb-1" id="lblActivityTitle">Loading Activity...</h3>
            <span class="badge bg-light text-primary px-3 py-2 rounded-pill shadow-sm" id="lblGrade">Grade</span>
        </div>
        <a href="/ValueOfYear/Index" class="btn btn-light rounded-pill fw-bold text-primary px-4 shadow-sm">
            <i class="bi bi-arrow-left me-1"></i> Back to Calendar
        </a>
    </div>

    <!-- STEP 1: TEAM/GROUP MANAGEMENT -->
    <div class="card border-0 shadow-sm rounded-4 bg-white p-4 mb-4 glass-card-bg">
        <h5 class="fw-bold text-dark mb-3"><i class="bi bi-people-fill text-primary me-2"></i> Step 1: Manage Student Teams</h5>
        
        <div class="alert bg-warning-subtle text-warning border-warning-subtle fw-semibold d-none rounded-3" id="alertUnassigned">
            <i class="bi bi-exclamation-triangle-fill me-2"></i> All students must be assigned to a team to unlock the Activity Submission section.
        </div>

        <div class="row g-4">
            <!-- Left Panel: Create Teams -->
            <div class="col-md-4 border-end pe-md-4">
                <h6 class="fw-bold text-muted mb-3">1. Create New Team</h6>
                <div class="input-group mb-4 shadow-sm">
                    <input type="text" id="txtNewGroupName" class="form-control shadow-none bg-light border-0" placeholder="e.g. Group A">
                    <button class="btn btn-primary fw-bold px-3" onclick="addGroup()"><i class="bi bi-plus-lg"></i> Add</button>
                </div>
                <div id="groupBadgesContainer" class="d-flex flex-wrap gap-2 mb-4"></div>

                <hr class="text-muted">

                <h6 class="fw-bold text-muted mb-3">2. Bulk Assign Students</h6>
                <div class="bg-light p-3 rounded-3 border mb-3">
                    <label class="small fw-bold text-dark mb-1">Auto-Check Unassigned Students</label>
                    <div class="input-group input-group-sm mb-3 shadow-sm">
                        <input type="number" id="txtAutoCheck" class="form-control shadow-none border-0" placeholder="Qty (e.g. 50)" min="1">
                        <button class="btn btn-dark fw-bold px-3" onclick="autoCheckStudents()"><i class="bi bi-check2-all"></i> Check</button>
                    </div>

                    <label class="small fw-bold text-dark mb-1">Assign Checked To Team</label>
                    <div class="input-group input-group-sm shadow-sm">
                        <select id="ddlBulkTeam" class="form-select shadow-none border-0">
                            <option value="">-- Select Team --</option>
                        </select>
                        <button class="btn btn-success fw-bold px-3" onclick="assignSelected()"><i class="bi bi-person-check-fill"></i> Assign</button>
                    </div>
                </div>
            </div>
            
            <!-- Right Panel: Student List -->
            <div class="col-md-8 ps-md-4">
                <h6 class="fw-bold text-muted mb-3">Student Roster</h6>
                <div class="table-responsive border rounded-3 shadow-sm" style="max-height: 400px; overflow-y: auto;">
                    <table class="table table-hover align-middle mb-0" id="tblStudents">
                        <thead class="table-light sticky-top">
                            <tr>
                                <th width="5%"><input type="checkbox" id="checkAll" class="form-check-input shadow-none" onclick="toggleAllChecks()"></th>
                                <th>Student Name</th>
                                <th>Current Team</th>
                            </tr>
                        </thead>
                        <tbody></tbody>
                    </table>
                </div>
                <button class="btn btn-primary w-100 rounded-pill fw-bold mt-4 py-2 shadow-sm fs-5" onclick="saveGroups()">
                    <i class="bi bi-save me-1"></i> Save Teams & Unlock Submission
                </button>
            </div>
        </div>
    </div>

    <!-- STEP 2: ACTIVITY SUBMISSION (Capacity Wise) -->
    <div class="card border-0 shadow-sm rounded-4 bg-white p-4 glass-card-bg d-none" id="submissionSection">
        <h5 class="fw-bold text-dark mb-4 border-bottom pb-3"><i class="bi bi-cloud-arrow-up-fill text-success me-2"></i> Step 2: Capacity Activity Submission</h5>

        <div id="uploadFormContainer">
            <div class="card bg-light border-0 rounded-4 p-4">
                <form id="frmSubmitActivity">
                    <input type="hidden" name="ValueItemId" value="@valueItemId" />
                    
                    <div class="mb-3 bg-white p-3 rounded-3 border">
                        <label class="small fw-bold text-dark mb-2">Upload Image Activity (*.jpeg, *.jpg, *.png)</label>
                        <input type="file" class="form-control shadow-none" name="ImageFile" accept="image/*">
                    </div>
                    
                    @* <div class="mb-3 bg-white p-3 rounded-3 border">
                        <label class="small fw-bold text-dark mb-2">Upload Video Activity (*.mp4, *.mov)</label>
                        <input type="file" class="form-control shadow-none" name="VideoFile" accept="video/mp4,video/quicktime">
                    </div> *@

                    <div class="mb-3 bg-white p-3 rounded-3 border">
                        <label class="small fw-bold text-dark mb-2">
                            Video Activity Submission
                        </label>

                        <select id="videoSubmissionType"
                                class="form-select mb-3">
                            <option value="file">Upload Video(Max 100 MB)</option>
                            <option value="drive">Choose from Google Drive</option>
                             <option value="link">Enter Manual Cloud Link</option>
                        </select>

                        <div id="videoFileContainer">
                            <input type="file"
                                   class="form-control"
                                   name="VideoFile"
                                   id="VideoFile"
                                   accept="video/mp4,video/quicktime" />
                            <small class="text-muted">
                                Upload an MP4 or MOV video directly. Maximum size: 100 MB.
                            </small>
                               <div id="videoSizeError"
                                class="text-danger small mt-2 d-none"></div>
                        </div>

                        <div id="videoDriveContainer" class="d-none">
                            <button type="button"
                                    id="btnChooseDriveVideo"
                                    class="btn btn-outline-primary">
                                <i class="bi bi-google me-1"></i>
                                Choose Video from Google Drive
                            </button>

                            <input type="hidden"
                                   id="VideoDriveFileId"
                                   name="VideoDriveFileId"
                                   disabled />

                            <div id="selectedDriveVideo"
                                 class="alert alert-success mt-3 mb-0 d-none">
                                <i class="bi bi-check-circle-fill me-1"></i>
                                Selected: <span id="selectedDriveVideoName"></span>

                                <button type="button"
                                        id="btnRemoveDriveVideo"
                                        class="btn btn-sm btn-outline-danger ms-2">
                                    Remove
                                </button>
                            </div>

                            @* <small class="d-block text-muted mt-2">
                                Select an existing video from your Google Drive.
                                The video itself will not be uploaded to this server.
                            </small> *@
                        </div>
                         <div id="videoLinkContainer" class="d-none">
                                <label for="VideoCloudUrl" class="form-label">
                                    Video link
                                </label>

                                <input type="url"
                                       class="form-control"
                                       id="VideoCloudUrl"
                                       name="VideoCloudUrl"
                                       placeholder="https://drive.google.com/... or https://onedrive.live.com/..."
                                       disabled />

                                <small class="text-muted d-block mt-2">
                                    Paste a Google Drive, OneDrive, Dropbox, or other cloud video link.
                                    Ensure the recipient has permission to view the video.
                                </small>
                            </div>
                    </div>
                    <div class="mb-4 bg-white p-3 rounded-3 border">
                        <label class="small fw-bold text-dark mb-2" for="ActivityComment">  Enter Comment / Observation</label>
                        <textarea class="form-control shadow-none" id="ActivityComment" name="Comment" rows="3" placeholder="Write your overall observation for this capacity here..." required></textarea>
                        <small class="text-muted">
        Comments are mandatory.
    </small>
    <div id="commentError" class="text-danger small mt-2 d-none"></div>
                    </div>

                    <button type="submit" class="btn btn-success w-100 rounded-pill fw-bold py-2 shadow-sm fs-5">
                        <i class="bi bi-check-circle-fill me-1"></i> Submit Capacity Activity
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>

<style>
    .custom-page-header { background: linear-gradient(135deg, #6236d6 0%, #8b5cf6 100%); }
    .glass-card-bg { background: rgba(255, 255, 255, 0.9); border: 1px solid rgba(0,0,0,0.05); }
    .student-cb { cursor: pointer; }
</style>

@section Scripts {
    
    <script>
        const fileBaseUrl = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(fileBaseUrl));

        function getCentralFileUrl(filePath) {
            if (!filePath) return "";

            if (/^https?:\/\//i.test(filePath)) {
                return filePath;
            }

            return fileBaseUrl.replace(/\/+$/, "") +
                "/" +
                filePath.replace(/^\/+/, "");
        }


        let VID = @valueItemId;
        let students = []; // Array of { id, name, team: '' }
        let groups = [];   // Array of string names
        let existingSubmission = null;

        $(document).ready(function () {
              $('#videoSubmissionType').trigger('change');
            loadPageData();

        


        });
 const googlePickerConfig = @Html.Raw(
    System.Text.Json.JsonSerializer.Serialize(new
    {
        apiKey = Configuration["GoogleDrivePicker:ApiKey"] ?? "",
        clientId = Configuration["GoogleDrivePicker:ClientId"] ?? "",
        appId = Configuration["GoogleDrivePicker:AppId"] ?? ""
    })
);

let googleTokenClient = null;
let googleAccessToken = null;
let pickerApiLoaded = false;
let googleIdentityLoaded = false;

function onGooglePickerApiLoaded() {
    gapi.load('picker', function () {
        pickerApiLoaded = true;
    });
}

function onGoogleIdentityLoaded() {
     if (!window.google?.accounts?.oauth2) {
        console.error('Google Identity Services failed to load.');
        return;
    }

    googleTokenClient = google.accounts.oauth2.initTokenClient({
        client_id: googlePickerConfig.clientId,
        scope: 'https://www.googleapis.com/auth/drive.file',
        callback: function (response) {
            if (response.error) {
                alert('Google authorization failed. Please try again.');
                return;
            }

            googleAccessToken = response.access_token;
            createGoogleDrivePicker();
        }
    });

    googleIdentityLoaded = true;
}

function openGoogleDrivePicker() {
    if (!googlePickerConfig.apiKey ||
        !googlePickerConfig.clientId ||
        !googlePickerConfig.appId) {
        alert('Google Drive Picker is not configured.');
        return;
    }

    if (!pickerApiLoaded || !googleIdentityLoaded) {
        alert('Google Drive Picker is still loading. Please try again.');
        return;
    }

    googleTokenClient.requestAccessToken({
        prompt: googleAccessToken ? '' : 'consent'
    });
}

function createGoogleDrivePicker() {
    const videoView = new google.picker.DocsView(
        google.picker.ViewId.DOCS
    );

    videoView.setMimeTypes(
        'video/mp4,video/quicktime,video/webm,video/x-msvideo,video/*'
    );

    const picker = new google.picker.PickerBuilder()
        .setAppId(googlePickerConfig.appId)
        .setDeveloperKey(googlePickerConfig.apiKey)
        .setOAuthToken(googleAccessToken)
        .setOrigin(window.location.origin)
        .addView(videoView)
        .enableFeature(google.picker.Feature.NAV_HIDDEN)
        .setCallback(function (data) {
            if (data.action !== google.picker.Action.PICKED) {
                return;
            }

            const selectedFiles =
                data[google.picker.Response.DOCUMENTS];

            if (!selectedFiles || selectedFiles.length === 0) {
                return;
            }

            const selectedFile = selectedFiles[0];
            const fileId =
                selectedFile[google.picker.Document.ID];

            const fileName =
                selectedFile[google.picker.Document.NAME] || 'Selected video';

            const mimeType =
                selectedFile[google.picker.Document.MIME_TYPE] || '';

            if (!fileId || !mimeType.startsWith('video/')) {
                alert('Please select a video file.');
                return;
            }

            $('#VideoDriveFileId').val(fileId);
            $('#selectedDriveVideoName').text(fileName);
            $('#selectedDriveVideo').removeClass('d-none');
        })
        .build();

    picker.setVisible(true);
}

//$(document).ready(function () {
    const MAX_VIDEO_SIZE = 100 * 1024 * 1024;

            $('#videoSubmissionType').on('change', function () {
                const type = this.value;

                $('#videoFileContainer').toggleClass('d-none', type !== 'file');
                $('#videoDriveContainer').toggleClass('d-none', type !== 'drive');
                $('#videoLinkContainer').toggleClass('d-none', type !== 'link');

                $('#VideoFile').prop('disabled', type !== 'file');
                $('#VideoDriveFileId').prop('disabled', type !== 'drive');
                $('#VideoCloudUrl').prop('disabled', type !== 'link');

                if (type !== 'file') {
                    $('#VideoFile').val('');
                    $('#videoSizeError').addClass('d-none').text('');
                }

                if (type !== 'drive') {
                    $('#VideoDriveFileId').val('');
                    $('#selectedDriveVideo').addClass('d-none');
                }

                if (type !== 'link') {
                    $('#VideoCloudUrl').val('');
                }
            });
            $('#VideoFile').on('change', function () {
                    const file = this.files && this.files[0];

                    if (file && file.size > MAX_VIDEO_SIZE) {
                        $('#videoSizeError')
                            .text('Video exceeds 100 MB. Please choose a smaller video or use a cloud link.')
                            .removeClass('d-none');

                        this.value = '';
                    } else {
                        $('#videoSizeError').addClass('d-none').text('');
                    }
                });

             $('#btnChooseDriveVideo').on('click', openGoogleDrivePicker);

            $('#btnRemoveDriveVideo').on('click', function () {
                $('#VideoDriveFileId').val('');
                $('#selectedDriveVideo').addClass('d-none');
            });
        function loadPageData() {
            $.get('/api/value/activity-page-data/' + VID, function (res) {
                if (res.success) {
                    //$('#lblActivityTitle').text(res.activity.valueTitleEng + ' (' + res.activity.capacityName + ')');
                    $('#lblActivityTitle').text(res.activity.valueTitleEng);
                    $('#lblGrade').text(res.activity.gradeName);
                    
                    groups = res.groups.map(g => g.groupName);
                    if(groups.length === 0) { groups = ['Group 1']; }
                    
                    students = res.students.map(s => {
                        let assignedTeam = '';
                        res.groups.forEach(g => {
                            if(g.studentIds.includes(s.id)) assignedTeam = g.groupName;
                        });
                        return { id: s.id, name: s.name, team: assignedTeam };
                    });

                    existingSubmission = res.submissions.length > 0 ? res.submissions[0] : null;
                    
                    renderGroupManagement();
                }
            });
        }

        // ================= TEAM CREATION & RENDERING =================
        function addGroup() {
            let name = $('#txtNewGroupName').val().trim();
            if(!name || groups.includes(name)) return;
            groups.push(name);
            $('#txtNewGroupName').val('');
            renderGroupManagement();
        }

        function removeGroup(name) { 
            groups = groups.filter(g => g !== name);
            // Unassign students from this group
            students.forEach(s => { if(s.team === name) s.team = ''; });
            renderGroupManagement(); 
        }

        function renderGroupManagement() {
            // Render Badges
            let badgeHtml = '';
            groups.forEach(g => {
                badgeHtml += `<span class="badge bg-purple text-white px-3 py-2 fs-6 shadow-sm" style="background-color: #6236d6;">${g} <i class="bi bi-x-circle ms-2" style="cursor:pointer;" onclick="removeGroup('${g}')"></i></span>`;
            });
            $('#groupBadgesContainer').html(badgeHtml);

            // Populate Bulk Dropdown
            let ddlHtml = '<option value="">-- Select Team --</option>';
            groups.forEach(g => ddlHtml += `<option value="${g}">${g}</option>`);
            $('#ddlBulkTeam').html(ddlHtml);

            // Render Student Table
            let tableHtml = '';
            let unassignedCount = 0;

            students.forEach(s => {
                if(!s.team) unassignedCount++;
                let teamBadge = s.team 
                    ? `<span class="badge bg-success-subtle text-success border border-success-subtle">${s.team}</span>` 
                    : `<span class="badge bg-danger-subtle text-danger border border-danger-subtle">Unassigned</span>`;

                tableHtml += `<tr>
                    <td><input type="checkbox" class="form-check-input shadow-none student-cb" value="${s.id}" data-team="${s.team}"></td>
                    <td class="fw-semibold text-dark">${s.name}</td>
                    <td>${teamBadge}</td>
                </tr>`;
            });
            $('#tblStudents tbody').html(tableHtml);

            // Reset select all
            $('#checkAll').prop('checked', false);

            // Toggle Submission Section
            if(unassignedCount > 0 || students.length === 0) {
                $('#alertUnassigned').removeClass('d-none');
                $('#submissionSection').addClass('d-none');
            } else {
                $('#alertUnassigned').addClass('d-none');
                $('#submissionSection').removeClass('d-none');
                renderSubmissionSection();
            }
        }

        // ================= BULK ASSIGNMENT LOGIC =================
        function toggleAllChecks() {
            let isChecked = $('#checkAll').is(':checked');
            $('.student-cb').prop('checked', isChecked);
        }

        function autoCheckStudents() {
            let count = parseInt($('#txtAutoCheck').val());
            if(isNaN(count) || count <= 0) return;

            $('.student-cb').prop('checked', false); // Reset all
            let checkedCount = 0;

            $('.student-cb').each(function() {
                let isUnassigned = !$(this).data('team');
                if (isUnassigned && checkedCount < count) {
                    $(this).prop('checked', true);
                    checkedCount++;
                }
            });
        }

        function assignSelected() {
            let selectedTeam = $('#ddlBulkTeam').val();
            if(!selectedTeam) { alert("Please select a team from the dropdown to assign."); return; }

            let assignedAny = false;
            $('.student-cb:checked').each(function() {
                let sid = parseInt($(this).val());
                let student = students.find(s => s.id === sid);
                if(student) {
                    student.team = selectedTeam;
                    assignedAny = true;
                }
            });

            if(!assignedAny) { alert("Please check at least one student to assign."); return; }

            $('#txtAutoCheck').val(''); // Clear input
            renderGroupManagement(); // Re-render updates the UI
        }

        function saveGroups() {
            let hasUnassigned = students.some(s => !s.team);
            if(hasUnassigned) {
                alert("Please assign all students to a team before saving."); return;
            }

            let payload = groups.map(gName => ({ 
                groupName: gName, 
                studentIds: students.filter(s => s.team === gName).map(s => s.id) 
            }));

            let $btn = $(event.currentTarget);
            let originalText = $btn.html();
            $btn.prop('disabled', true).html('<span class="spinner-border spinner-border-sm me-1"></span> Saving...');

            $.ajax({
                url: '/api/value/save-groups/' + VID,
                type: 'POST', 
                contentType: 'application/json',
                data: JSON.stringify(payload),
                success: function(res) {
                    if(res.success){
                        alert(res.message);
                        loadPageData(); 
                    } else { alert(res.message); }
                },
                error: function(xhr) {
                    alert("Error saving groups.");
                },
                complete: function() { $btn.prop('disabled', false).html(originalText); }
            });
        }

        // ================= SUBMISSION MANAGEMENT (CAPACITY WISE) =================
        function renderSubmissionSection() {
            if(existingSubmission) {
                $('#uploadFormContainer').html(`
                    <div class="alert alert-success fw-bold p-4 rounded-4 shadow-sm border-0 d-flex align-items-center">
                        <i class="bi bi-check-circle-fill fs-2 me-3"></i> 
                        <div>
                            <h5 class="mb-1 fw-bolder">Capacity Activity Completed!</h5>
                            <p class="mb-0 text-dark fw-normal">You have successfully submitted the activity for this capacity.</p>
                        </div>
                    </div>
                    <div class="card bg-light border-0 rounded-4 p-4 mt-3">
                                <p class="mb-3"><b>Your Observation:</b> <br> ${existingSubmission.shortDescription || 'N/A'}</p>
                        <div class="d-flex gap-2">
                                ${existingSubmission.imageActivity
                        ? `<a href="${getCentralFileUrl(existingSubmission.imageActivity)}"
                  target="_blank"
                  class="btn btn-outline-dark fw-bold rounded-pill">
                  <i class="bi bi-image"></i> View Image
               </a>`
                        : ''}

        ${existingSubmission.videoActivity
                        ? `<a href="${getCentralFileUrl(existingSubmission.videoActivity)}"
                  target="_blank"
                  class="btn btn-outline-dark fw-bold rounded-pill">
                  <i class="bi bi-camera-video"></i> View Video
               </a>`
                        : ''}
                             </div>
                    </div>
                `);
            }
        }
        $('#ActivityComment').on('input', function () {
    if ($(this).val().trim()) {
        $('#commentError').addClass('d-none').text('');
    }
});
        $('#frmSubmitActivity').on('submit', function(e) {
            e.preventDefault();
            const comment = $('#ActivityComment').val().trim();

if (!comment) {
    $('#commentError')
        .text('Please enter a comment or observation.')
        .removeClass('d-none');

    $('#ActivityComment').focus();
    return;
}

$('#commentError').addClass('d-none').text('');
                    const videoType = $('#videoSubmissionType').val();
                    const file = $('#VideoFile')[0].files?.[0];

                    const $btn = $(this).find('button[type="submit"]');
                    const originalText = $btn.html();
                    if (videoType === 'file' && !file) {
                        alert('Please select a video file.');
                        $('#VideoFile').focus();
                        return;
                    }
                    if (videoType === 'file' && file && file.size > MAX_VIDEO_SIZE) {
                        alert('Video size cannot exceed 100 MB.');
                        return;
                    }

                    if (videoType === 'drive' && !$('#VideoDriveFileId').val()) {
                        alert('Please select a video from Google Drive.');
                        return;
                    }

                    if (videoType === 'link') {
                        const link = $('#VideoCloudUrl').val().trim();

                        if (!link) {
                            alert('Please enter a cloud video link.');
                            return;
                        }

                        try {
                            const url = new URL(link);

                            if (!['http:', 'https:'].includes(url.protocol)) {
                                throw new Error('Invalid protocol');
                            }
                        } catch {
                            alert('Please enter a valid HTTP or HTTPS video link.');
                            return;
                        }
                    }

                    const imageFile = $(this).find('[name="ImageFile"]')[0].files[0];

                if (!imageFile) {
                    alert('Please select an image for the activity.');
                    return;
                }

                const allowedImageTypes = [
                    'image/jpeg',
                    'image/png'
                ];

                if (!allowedImageTypes.includes(imageFile.type)) {
                    alert('Please upload a JPG, JPEG, or PNG image.');
                    return;
                }

                if (imageFile.size > 10 * 1024 * 1024) {
                    alert('Image size cannot exceed 10 MB.');
                    return;
                }
            $btn.prop('disabled', true).html('<span class="spinner-border spinner-border-sm me-1"></span> Submitting...');

            $.ajax({
                url: '/api/value/submit-activity', type: 'POST', data: new FormData(this),
                processData: false, contentType: false,
                success: function(res) {
                  alert(res.message || 'Activity submitted successfully.');
            if (res.success) {
                loadPageData();
            }// Reloads to show success message
                },
                 error: function (xhr) {
            const message =
                xhr.responseJSON?.message ||
                (xhr.status === 413
                    ? 'The upload is too large. Please use a smaller video or submit a cloud link.'
                    : 'Unable to submit the activity. Please try again.');

            alert(message);
        },
                complete: function() { $btn.prop('disabled', false).html(originalText); }
            });
        });
    </script>

    <script async defer
            src="https://apis.google.com/js/api.js"
            onload="onGooglePickerApiLoaded()"></script>

    <script async defer
            src="https://accounts.google.com/gsi/client"
            onload="onGoogleIdentityLoaded()"></script>
}