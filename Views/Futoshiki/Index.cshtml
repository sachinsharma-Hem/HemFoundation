                    <div class="futoshiki-row-symbol" style="width: 55px;" id="txt_User_Input42">&nbsp;</div>
                </div>
                <div class="d-flex align-items-center justify-content-center mb-4">
                    <input type="text" class="form-control futoshiki-cell" id="txt_User_Input43" onclick="txt_click(this.id)" maxlength="1">
                    <div class="futoshiki-symbol" id="txt_User_Input44">&nbsp;</div>
                    <input type="text" class="form-control futoshiki-cell" id="txt_User_Input45" onclick="txt_click(this.id)" maxlength="1">
                    <div class="futoshiki-symbol" id="txt_User_Input46">&nbsp;</div>
                    <input type="text" class="form-control futoshiki-cell" id="txt_User_Input47" onclick="txt_click(this.id)" maxlength="1">
                    <div class="futoshiki-symbol" id="txt_User_Input48">&nbsp;</div>
                    <input type="text" class="form-control futoshiki-cell" id="txt_User_Input49" onclick="txt_click(this.id)" maxlength="1">
                </div>
            </div>

            <!-- Virtual Keypad & Actions -->
            <div class="row justify-content-center g-2 mb-3">
                <div class="col-auto">
                    <button class="btn btn-primary pad-btn mx-1" id="btn_No1" onclick="display(this.id)">1</button>
                    <button class="btn btn-primary pad-btn mx-1" id="btn_No2" onclick="display(this.id)">2</button>
                    <button class="btn btn-primary pad-btn mx-1" id="btn_No3" onclick="display(this.id)">3</button>
                    <button class="btn btn-primary pad-btn mx-1" id="btn_No4" onclick="display(this.id)">4</button>
                </div>
            </div>

            <div class="row justify-content-center g-2">
                <div class="col-12 text-center d-flex flex-wrap justify-content-center gap-2">
                    <button class="btn btn-warning text-dark pad-btn" id="btn_Reset" onclick="reset()">
                        <i class="fa fa-sync me-1"></i> Reset
                    </button>
                    <button class="btn btn-danger text-white pad-btn" id="btn_Erase" onclick="erase()">
                        <i class="fa fa-eraser me-1"></i> Erase
                    </button>
                    @if (isInWJTeacherRole)
                    {
                        <button class="btn btn-success pad-btn" id="btn_Check" disabled>
                            <i class="fa fa-check me-1"></i> Check
                        </button>
                    }
                    else
                    {
                        <button class="btn btn-success pad-btn" id="btn_Check" onclick="solve()">
                            <i class="fa fa-check me-1"></i> Check
                        </button>
                    }
                </div>
            </div>
        </div>
    </div>
</div>