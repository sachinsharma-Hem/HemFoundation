                            </div>

                            <div class="sql-status-bar" id="sqlExecutionStatus">
                                <i class="bi bi-terminal me-1"></i>Ready.
                            </div>

                            <div class="sql-result-tabs">
                                <ul class="nav nav-tabs border-0">
                                    <li class="nav-item"><button class="nav-link active" id="sqlTabResultsBtn" onclick="switchSqlTab('results')">
                                        <i class="bi bi-terminal-split me-1"></i>Terminal
                                    </button></li>
                                    <li class="nav-item"><button class="nav-link" id="sqlTabHistoryBtn" onclick="switchSqlTab('history')">
                                        <i class="bi bi-clock-history me-1"></i>History <span class="badge bg-secondary ms-1" id="sqlHistoryCountBadge">0</span>
                                    </button></li>
                                </ul>
                                <button class="btn btn-sm btn-link text-muted" id="clearTerminalBtn" onclick="clearSqlTerminal()" title="Clear terminal log">
                                    <i class="bi bi-eraser me-1"></i>Clear log
                                </button>
                            </div>

                            <div class="sql-result-panel" id="sqlPaneResults">
                                <div class="sql-empty-state">
                                    <i class="bi bi-terminal d-block mb-2"></i>
                                    No query executed yet. Write some SQL above and hit <strong>Execute</strong>.
