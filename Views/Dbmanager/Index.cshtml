@{
    ViewData["Title"] = "Database Manager";
    Layout = "~/Views/Shared/Layouts/_AdminLayout.cshtml";
}

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/codemirror/5.65.16/codemirror.min.css" />
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/codemirror/5.65.16/theme/dracula.min.css" />

<div class="container-fluid py-4" id="dbManagerRoot">

    <!-- ========================================================= -->
    <!-- HEADER -->
    <!-- ========================================================= -->

    <div class="d-flex flex-wrap align-items-center justify-content-between mb-4 gap-3">

        <div>
            <h3 class="fw-bold text-dark mb-1">
                <i class="bi bi-database-gear text-primary me-2"></i>
                Database Manager
            </h3>

            <p class="text-muted mb-0" id="dbSubtitle">
                Manage PostgreSQL database objects directly from the admin panel.
            </p>
        </div>

        <div class="d-flex align-items-center gap-2">
            <span class="badge rounded-pill bg-success-subtle text-success border px-3 py-2" id="connectionBadge">
                <i class="bi bi-circle-fill small me-1"></i>
                Checking...
            </span>

            <button class="btn btn-light border shadow-sm"
                    onclick="refreshCurrentSection()">
                <i class="bi bi-arrow-clockwise me-1"></i>
                Refresh
            </button>
        </div>

    </div>


    <!-- ========================================================= -->
    <!-- OVERVIEW CARDS -->
    <!-- ========================================================= -->

    <div id="overviewSection">

        <div class="row g-3 mb-3" id="dbInfoRow" style="display:none;">
            <div class="col-12">
                <div class="d-flex flex-wrap gap-3 small text-muted bg-white border rounded-3 px-3 py-2">
                    <span><strong>Database:</strong> <span id="infoDbName">-</span></span>
                    <span><strong>Version:</strong> <span id="infoVersion">-</span></span>
                    <span><strong>Size:</strong> <span id="infoSize">-</span></span>
                    <span><strong>Schema:</strong> <span id="infoSchema">-</span></span>
                    <span><strong>Server:</strong> <span id="infoServer">-</span></span>
                </div>
            </div>
        </div>

        <div class="row g-3 mb-4">

            <div class="col-xl-3 col-lg-4 col-md-6">
                <div class="db-stat-card">
                    <div class="db-stat-icon bg-primary-subtle text-primary">
                        <i class="bi bi-diagram-3"></i>
                    </div>
                    <div>
                        <div class="db-stat-label">Schemas</div>
                        <div class="db-stat-value" id="countSchemas">0</div>
                    </div>
                </div>
            </div>

            <div class="col-xl-3 col-lg-4 col-md-6">
                <div class="db-stat-card">
                    <div class="db-stat-icon bg-success-subtle text-success">
                        <i class="bi bi-table"></i>
                    </div>
                    <div>
                        <div class="db-stat-label">Tables</div>
                        <div class="db-stat-value" id="countTables">0</div>
                    </div>
                </div>
            </div>

            <div class="col-xl-3 col-lg-4 col-md-6">
                <div class="db-stat-card">
                    <div class="db-stat-icon bg-info-subtle text-info">
                        <i class="bi bi-layout-text-window-reverse"></i>
                    </div>
                    <div>
                        <div class="db-stat-label">Views</div>
                        <div class="db-stat-value" id="countViews">0</div>
                    </div>
                </div>
            </div>

            <div class="col-xl-3 col-lg-4 col-md-6">
                <div class="db-stat-card">
                    <div class="db-stat-icon bg-warning-subtle text-warning">
                        <i class="bi bi-braces"></i>
                    </div>
                    <div>
                        <div class="db-stat-label">Functions</div>
                        <div class="db-stat-value" id="countFunctions">0</div>
                    </div>
                </div>
            </div>

            <div class="col-xl-3 col-lg-4 col-md-6">
                <div class="db-stat-card">
                    <div class="db-stat-icon bg-danger-subtle text-danger">
                        <i class="bi bi-terminal"></i>
                    </div>
                    <div>
                        <div class="db-stat-label">Procedures</div>
                        <div class="db-stat-value" id="countProcedures">0</div>
                    </div>
                </div>
            </div>

            <div class="col-xl-3 col-lg-4 col-md-6">
                <div class="db-stat-card">
                    <div class="db-stat-icon bg-secondary-subtle text-secondary">
                        <i class="bi bi-lightning-charge"></i>
                    </div>
                    <div>
                        <div class="db-stat-label">Triggers</div>
                        <div class="db-stat-value" id="countTriggers">0</div>
                    </div>
                </div>
            </div>

            <div class="col-xl-3 col-lg-4 col-md-6">
                <div class="db-stat-card">
                    <div class="db-stat-icon bg-dark-subtle text-dark">
                        <i class="bi bi-list-columns-reverse"></i>
                    </div>
                    <div>
                        <div class="db-stat-label">Indexes</div>
                        <div class="db-stat-value" id="countIndexes">0</div>
                    </div>
                </div>
            </div>

        </div>

    </div>


    <!-- ========================================================= -->
    <!-- MAIN CARD -->
    <!-- ========================================================= -->

    <div class="card border-0 shadow-sm rounded-4 overflow-hidden" id="mainCard">

        <div class="row g-0">

            <!-- SIDEBAR -->
            <div class="col-lg-2 border-end bg-light" id="dbSidebarCol">

                <div class="db-sidebar p-3">

                    <div class="small fw-bold text-uppercase text-muted px-2 mb-2">Database</div>

                    <button class="db-menu active" data-section="overview" onclick="openSection('overview')">
                        <i class="bi bi-speedometer2"></i> Overview
                    </button>

                    <button class="db-menu" data-section="schemas" onclick="openSection('schemas')">
                        <i class="bi bi-diagram-3"></i> Schemas
                    </button>

                    <button class="db-menu" data-section="tables" onclick="openSection('tables')">
                        <i class="bi bi-table"></i> Tables
                    </button>

                    <button class="db-menu" data-section="views" onclick="openSection('views')">
                        <i class="bi bi-layout-text-window-reverse"></i> Views
                    </button>

                    <button class="db-menu" data-section="functions" onclick="openSection('functions')">
                        <i class="bi bi-braces"></i> Functions
                    </button>

                    <button class="db-menu" data-section="procedures" onclick="openSection('procedures')">
                        <i class="bi bi-terminal"></i> Procedures
                    </button>

                    <button class="db-menu" data-section="triggers" onclick="openSection('triggers')">
                        <i class="bi bi-lightning-charge"></i> Triggers
                    </button>

                    <button class="db-menu" data-section="indexes" onclick="openSection('indexes')">
                        <i class="bi bi-list-columns-reverse"></i> Indexes
                    </button>

                    <div class="border-top my-3"></div>

                    <div class="small fw-bold text-uppercase text-muted px-2 mb-2">Developer</div>

                    <button class="db-menu" data-section="sql" onclick="openSection('sql')">
                        <i class="bi bi-code-square"></i> SQL Console
                    </button>

                </div>

            </div>

            <!-- CONTENT -->
            <div class="col-lg-10" id="dbContentCol">

                <div class="p-4" id="dbContentPad">

                    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-2" id="sectionHeaderRow">

                        <div>
                            <h5 class="fw-bold mb-1" id="sectionTitle">Database Overview</h5>
                            <p class="text-muted small mb-0" id="sectionDescription">Overview of database objects.</p>
                        </div>

                        <div class="d-flex align-items-center gap-2">

                            <div id="objectSearchContainer" class="d-none">
                                <input type="text" id="objectSearchInput" class="form-control form-control-sm"
                                       placeholder="Search..." oninput="debouncedObjectFilter()" style="min-width:200px;" />
                            </div>

                            <div id="schemaFilterContainer" class="d-none">
                                <select id="schemaFilter" class="form-select form-select-sm" onchange="loadCurrentSection()">
                                    <option value="">All Schemas</option>
                                </select>
                            </div>

                        </div>

                    </div>

                    <div id="contentArea">
                        <div class="text-center py-5">
                            <div class="spinner-border text-primary"></div>
                            <div class="text-muted mt-2">Loading database...</div>
                        </div>
                    </div>

                </div>

            </div>

        </div>

    </div>

</div>


<!-- ============================================================= -->
<!-- OBJECT DEFINITION MODAL -->
<!-- ============================================================= -->

<div class="modal fade" id="objectDefinitionModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg rounded-4 overflow-hidden">
            <div class="modal-header bg-dark text-white">
                <div>
                    <h5 class="modal-title mb-1" id="definitionTitle">Object Definition</h5>
                    <small class="text-white-50" id="definitionSubtitle"></small>
                </div>
                <div class="d-flex align-items-center gap-2">
                    <button class="btn btn-sm btn-outline-light" onclick="copyDefinitionToClipboard()">
                        <i class="bi bi-clipboard me-1"></i>Copy
                    </button>
                    <button class="btn btn-sm btn-outline-light" onclick="openDefinitionInSqlEditor()">
                        <i class="bi bi-code-square me-1"></i>Open in SQL Editor
                    </button>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>
            </div>
            <div class="modal-body p-0">
                <pre id="definitionContent" class="sql-definition mb-0"></pre>
            </div>
        </div>
    </div>
</div>


<!-- ============================================================= -->
<!-- TABLE STRUCTURE MODAL -->
<!-- ============================================================= -->

<div class="modal fade" id="tableStructureModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg rounded-4 overflow-hidden">
            <div class="modal-header bg-dark text-white">
                <div>
                    <h5 class="modal-title mb-1">Table Structure</h5>
                    <small class="text-white-50" id="structureSubtitle"></small>
                </div>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body p-0 bg-dark">
                <ul class="nav nav-tabs px-3 pt-2 border-0" style="border-bottom:1px solid #343a40;">
                    <li class="nav-item">
                        <button class="nav-link active text-white" id="structTabColumnsBtn" onclick="switchStructureTab('columns')">Columns</button>
                    </li>
                    <li class="nav-item">
                        <button class="nav-link text-white-50" id="structTabConstraintsBtn" onclick="switchStructureTab('constraints')">Constraints</button>
                    </li>
                    <li class="nav-item">
                        <button class="nav-link text-white-50" id="structTabIndexesBtn" onclick="switchStructureTab('indexes')">Indexes</button>
                    </li>
                </ul>
                <div style="max-height:65vh; overflow:auto;">
                    <div id="structurePaneColumns"></div>
                    <div id="structurePaneConstraints" style="display:none;"></div>
                    <div id="structurePaneIndexes" style="display:none;"></div>
                </div>
            </div>
        </div>
    </div>
</div>


<!-- ============================================================= -->
<!-- TABLE DATA MODAL -->
<!-- ============================================================= -->

<div class="modal fade" id="tableDataModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-fullscreen">
        <div class="modal-content">

            <div class="modal-header bg-dark text-white">
                <div>
                    <h5 class="modal-title" id="tableDataTitle">Table Data</h5>
                    <small class="text-white-50" id="tableDataSubtitle"></small>
                </div>
                <div class="d-flex align-items-center gap-2">
                    <button class="btn btn-sm btn-outline-light" onclick="exportTableDataCsv()">
                        <i class="bi bi-download me-1"></i>Export CSV
                    </button>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>
            </div>

            <div class="modal-body bg-light">

                <div class="card border-0 shadow-sm mb-3">
                    <div class="card-body">
                        <div class="row g-2 align-items-center">
                            <div class="col-md-5">
                                <div class="input-group">
                                    <span class="input-group-text"><i class="bi bi-search"></i></span>
                                    <input type="text" id="tableSearch" class="form-control"
                                           placeholder="Search in table..."
                                           onkeydown="if(event.key === 'Enter') loadTableData(1)" />
                                </div>
                            </div>
                            <div class="col-md-2">
                                <select id="pageSize" class="form-select" onchange="loadTableData(1)">
                                    <option value="25">25 rows</option>
                                    <option value="50" selected>50 rows</option>
                                    <option value="100">100 rows</option>
                                    <option value="250">250 rows</option>
                                    <option value="500">500 rows</option>
                                </select>
                            </div>
                            <div class="col-md-5 text-md-end">
                                <span class="text-muted small" id="tableRecordInfo"></span>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="card border-0 shadow-sm">
                    <div class="table-responsive table-data-container">
                        <table class="table table-hover table-sm align-middle mb-0" id="tableDataTable">
                            <thead class="table-light"></thead>
                            <tbody></tbody>
                        </table>
                    </div>
                </div>

                <div class="d-flex justify-content-between align-items-center mt-3">
                    <button class="btn btn-outline-secondary" id="prevPageBtn" onclick="changeTablePage(-1)">
                        <i class="bi bi-chevron-left"></i> Previous
                    </button>
                    <span id="pageInfo" class="text-muted small"></span>
                    <button class="btn btn-outline-secondary" id="nextPageBtn" onclick="changeTablePage(1)">
                        Next <i class="bi bi-chevron-right"></i>
                    </button>
                </div>

            </div>

        </div>
    </div>
</div>


<!-- ============================================================= -->
<!-- SQL CONFIRM MODAL -->
<!-- ============================================================= -->

<div class="modal fade" id="sqlConfirmModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg rounded-4">
            <div class="modal-header">
                <h5 class="modal-title fw-bold">
                    <i class="bi bi-exclamation-triangle text-warning me-2"></i>
                    Confirm execution
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <p class="mb-2">This statement looks potentially destructive:</p>
                <div class="alert alert-warning small mb-0" id="sqlConfirmReason">
                    This can permanently modify or delete data.
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-light border" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-danger" onclick="confirmExecuteSql()">
                    <i class="bi bi-play-fill me-1"></i>Execute anyway
                </button>
            </div>
        </div>
    </div>
</div>


<style>

    .db-stat-card {
        background: #ffffff;
        border: 1px solid #e4e8ec;
        border-radius: 16px;
        padding: 20px;
        display: flex;
        align-items: center;
        gap: 15px;
        height: 100%;
        transition: all .2s ease;
        box-shadow: 0 .125rem .25rem rgba(0,0,0,.04);
    }

        .db-stat-card:hover {
            transform: translateY(-2px);
            box-shadow: 0 .5rem 1rem rgba(0,0,0,.08);
        }

    .db-stat-icon {
        width: 52px;
        height: 52px;
        border-radius: 14px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 23px;
        flex-shrink: 0;
    }

    .db-stat-label {
        font-size: 13px;
        color: #6c757d;
        margin-bottom: 2px;
    }

    .db-stat-value {
        font-size: 25px;
        font-weight: 700;
        color: #212529;
    }

    .db-menu {
        width: 100%;
        border: 0;
        background: transparent;
        text-align: left;
        padding: 10px 12px;
        border-radius: 10px;
        color: #495057;
        font-size: 14px;
        margin-bottom: 3px;
        transition: all .15s ease;
    }

        .db-menu i {
            width: 22px;
            margin-right: 7px;
        }

        .db-menu:hover {
            background: #e9ecef;
            color: #212529;
        }

        .db-menu.active {
            background: #e8f0ff;
            color: #0d6efd;
            font-weight: 600;
        }

    .db-table th {
        white-space: nowrap;
        font-size: 12px;
        text-transform: uppercase;
        letter-spacing: .02em;
    }

    .db-table td {
        font-size: 13px;
        vertical-align: middle;
    }

    .object-row {
        cursor: pointer;
    }

        .object-row:hover {
            background: #f8f9fa;
        }

    .code-preview {
        max-width: 500px;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
        font-family: Consolas, monospace;
        font-size: 12px;
    }

    .sql-definition {
        background: #111827;
        color: #e5e7eb;
        padding: 24px;
        min-height: 500px;
        max-height: 75vh;
        overflow: auto;
        font-family: Consolas, "Courier New", monospace;
        font-size: 13px;
        line-height: 1.6;
        white-space: pre-wrap;
    }

    .table-data-container {
        max-height: calc(100vh - 260px);
        overflow: auto;
    }

    #tableDataTable {
        min-width: 100%;
        white-space: nowrap;
    }

        #tableDataTable th {
            position: sticky;
            top: 0;
            z-index: 5;
            white-space: nowrap;
            font-size: 12px;
        }

        #tableDataTable td {
            font-size: 12px;
            max-width: 350px;
            overflow: hidden;
            text-overflow: ellipsis;
            cursor: pointer;
        }

            #tableDataTable td.is-null {
                color: #adb5bd;
                font-style: italic;
            }

    .schema-badge {
        font-size: 11px;
        background: #f1f3f5;
        color: #495057;
        border: 1px solid #dee2e6;
    }

    .empty-state {
        padding: 60px 20px;
        text-align: center;
        color: #6c757d;
    }

        .empty-state i {
            font-size: 45px;
            opacity: .4;
        }

    /* ---------------- SQL CONSOLE ---------------- */

    .sql-console-shell {
        background: #0b0f19;
        border-radius: 14px;
        overflow: hidden;
        border: 1px solid #1f2937;
    }

    .sql-console-toolbar {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 8px;
        padding: 10px 14px;
        background: #111827;
        border-bottom: 1px solid #1f2937;
    }

        .sql-console-toolbar .btn {
            font-size: 13px;
        }

    .sql-console-editor-wrap {
        position: relative;
    }

        .sql-console-editor-wrap .CodeMirror {
            height: 260px;
            font-family: Consolas, "Courier New", monospace;
            font-size: 14px;
        }

    #dbManagerRoot.sql-fullscreen-active {
        position: fixed;
        inset: 0;
        z-index: 1080;
        background: #f8f9fa;
        overflow: auto;
        padding: 16px !important;
    }

        #dbManagerRoot.sql-fullscreen-active .sql-console-editor-wrap .CodeMirror {
            height: 46vh;
        }

        #dbManagerRoot.sql-fullscreen-active #overviewSection,
        #dbManagerRoot.sql-fullscreen-active #dbSidebarCol,
        #dbManagerRoot.sql-fullscreen-active .d-flex.flex-wrap.align-items-center.justify-content-between.mb-4.gap-3 {
            display: none !important;
        }

        #dbManagerRoot.sql-fullscreen-active #dbContentCol {
            flex: 0 0 100%;
            max-width: 100%;
        }

    .sql-status-bar {
        padding: 10px 14px;
        font-size: 13px;
        font-family: Consolas, monospace;
        border-top: 1px solid #1f2937;
        background: #111827;
        color: #9ca3af;
        min-height: 42px;
    }

        .sql-status-bar.status-success {
            color: #4ade80;
        }

        .sql-status-bar.status-error {
            color: #f87171;
        }

        .sql-status-bar.status-running {
            color: #facc15;
        }

    .sql-result-tabs {
        background: #f8f9fa;
        border-bottom: 1px solid #dee2e6;
        padding: 4px 8px 0;
    }

        .sql-result-tabs .nav-link {
            font-size: 13px;
            color: #495057;
        }

            .sql-result-tabs .nav-link.active {
                color: #0d6efd;
                font-weight: 600;
            }

    .sql-result-panel {
        max-height: 45vh;
        overflow: auto;
        background: #fff;
    }

        .sql-result-panel table {
            white-space: nowrap;
            font-size: 13px;
        }

        .sql-result-panel th {
            position: sticky;
            top: 0;
            background: #f8f9fa;
            z-index: 2;
        }

        .sql-result-panel td.is-null {
            color: #adb5bd;
            font-style: italic;
        }

        .sql-result-panel td {
            cursor: pointer;
            max-width: 320px;
            overflow: hidden;
            text-overflow: ellipsis;
        }

    .sql-history-item {
        padding: 8px 12px;
        border-bottom: 1px solid #eee;
        cursor: pointer;
        font-size: 12.5px;
    }

        .sql-history-item:hover {
            background: #f1f3f5;
        }

        .sql-history-item .hist-sql {
            font-family: Consolas, monospace;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
            display: block;
        }

    @@media (max-width: 991px) {
        .db-sidebar {
            display: flex;
            flex-wrap: wrap;
            gap: 4px;
        }

        .db-menu {
            width: auto;
            flex: 0 0 auto;
        }
    }

    /* ---------------- SQL CONSOLE (terminal log + grids) ---------------- */

    kbd {
        background: #1f2937;
        color: #e5e7eb;
        border-radius: 4px;
        padding: 1px 6px;
        font-size: 11px;
        border: 1px solid #374151;
    }

    .sql-console-resize-handle {
        height: 12px;
        background: #111827;
        border-bottom: 1px solid #1f2937;
        display: flex;
        align-items: center;
        justify-content: center;
        cursor: row-resize;
        color: #4b5563;
    }

        .sql-console-resize-handle:hover {
            color: #9ca3af;
        }

    .sql-empty-state {
        padding: 48px 20px;
        text-align: center;
        color: #6c757d;
        font-size: 13.5px;
    }

        .sql-empty-state i {
            font-size: 32px;
            opacity: .35;
        }

    .sql-terminal-entry {
        border-bottom: 1px solid #eee;
        padding: 12px 16px;
    }

        .sql-terminal-entry:first-child {
            background: #fbfdff;
        }

    .sql-terminal-echo pre {
        background: #0b0f19;
        color: #93c5fd;
        border-radius: 8px;
        padding: 10px 12px;
        font-family: Consolas, monospace;
        font-size: 12.5px;
        white-space: pre-wrap;
        margin-top: 4px;
    }

    .sql-terminal-status {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 10px;
        font-weight: 600;
        font-size: 13.5px;
        padding: 8px 4px;
    }

        .sql-terminal-status.status-success {
            color: #15803d;
        }

        .sql-terminal-status.status-error {
            color: #b91c1c;
        }

    .sql-terminal-meta {
        font-weight: 400;
        color: #6b7280;
        font-size: 12.5px;
    }

    .sql-terminal-subheading {
        font-size: 12.5px;
        font-weight: 600;
        color: #495057;
        padding: 8px 4px 4px;
    }

    .sql-terminal-error {
        background: #fef2f2;
        border: 1px solid #fecaca;
        border-radius: 8px;
        padding: 10px 12px;
        margin: 4px 0;
    }

        .sql-terminal-error pre {
            white-space: pre-wrap;
            font-family: Consolas, monospace;
            font-size: 12.5px;
            color: #7f1d1d;
