        gap: 8px;
    }

    .db-toast {
        background: #212529;
        color: #fff;
        padding: 10px 16px;
        border-radius: 10px;
        font-size: 13px;
        box-shadow: 0 6px 16px rgba(0,0,0,.2);
        opacity: 0;
        transform: translateY(8px);
        transition: all .2s ease;
    }

        .db-toast.show {
            opacity: 1;
            transform: translateY(0);
        }

</style>


@section Scripts {

    <script src="https://cdnjs.cloudflare.com/ajax/libs/codemirror/5.65.16/codemirror.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/codemirror/5.65.16/mode/sql/sql.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/codemirror/5.65.16/addon/edit/matchbrackets.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/sql-formatter/4.0.2/sql-formatter.min.js"></script>

    <script>

        // ============================================================
        // GLOBAL STATE
        // ============================================================

        let currentSection = "overview";

        let currentTableSchema = "";
        let currentTableName = "";
        let currentTablePage = 1;
        let currentTableData = { columns: [], rows: [] };

        let currentStructureSchema = "";
        let currentStructureTable = "";

        let objectFilterTimer = null;

        let pendingSql = "";

        let sqlEditor = null;
        let sqlRunning = false;
        let sqlHistory = [];
        const SQL_HISTORY_KEY = "dbmanager_sql_history";
        const SQL_HISTORY_LIMIT = 100;


        // ============================================================
        // AJAX HELPER (uses the app's existing cookie/session auth)
        // ============================================================

        function apiGet(url, successCallback, errorCallback) {

            $.ajax({
                url: url,
                type: "GET",
                success: function(response) {
                    if (response.success) {
                        successCallback(response);
                    } else {
                        if (errorCallback) errorCallback(response.message);
                        else showError(response.message || "Unable to load data.");
                    }
                },
                error: function(xhr) {
                    if (xhr.status === 401) {
                        showError("Your session has expired. Please log in again.");
                        return;
                    }
                    let message = "Something went wrong.";
                    if (xhr.responseJSON && xhr.responseJSON.message) message = xhr.responseJSON.message;
                    if (errorCallback) errorCallback(message);
                    else showError(message);
                }
            });
        }


        // ============================================================
        // DOCUMENT READY
        // ============================================================

        $(document).ready(function() {

            loadOverview();
            loadDatabaseInfo();
            loadSqlHistoryFromStorage();

            document.addEventListener("keydown", function(e) {
                if (e.key === "Escape" && document.getElementById("dbManagerRoot").classList.contains("sql-fullscreen-active")) {
                    toggleSqlFullscreen(false);
                }
            });
        });


        // ============================================================
        // DATABASE INFO (Overview header strip + connection badge)
        // ============================================================

        function loadDatabaseInfo() {

            apiGet("/api/dbmanager/database-info", function(res) {

                const d = res.data;

                $("#connectionBadge").html('<i class="bi bi-circle-fill small me-1"></i> Database Connected');
                $("#connectionBadge").removeClass("bg-danger-subtle text-danger").addClass("bg-success-subtle text-success");

                $("#infoDbName").text(d.databaseName || "-");
                $("#infoVersion").text(d.version || "-");
                $("#infoSize").text(d.size || "-");
                $("#infoSchema").text(d.currentSchema || "-");
                $("#infoServer").text(d.server || "-");
                $("#dbInfoRow").show();

            }, function() {

                $("#connectionBadge").html('<i class="bi bi-circle-fill small me-1"></i> Disconnected');
                $("#connectionBadge").removeClass("bg-success-subtle text-success").addClass("bg-danger-subtle text-danger");
            });
        }


        // ============================================================
        // SECTION NAVIGATION
        // ============================================================

        function openSection(section) {

            currentSection = section;

            $(".db-menu").removeClass("active");
            $('.db-menu[data-section="' + section + '"]').addClass("active");

            $("#schemaFilterContainer").addClass("d-none");
            $("#objectSearchContainer").addClass("d-none");
            $("#objectSearchInput").val("");
            $("#sectionHeaderRow").show();

            const needsSchemaFilter = ["tables", "views", "functions", "procedures", "triggers", "indexes"];

            if (needsSchemaFilter.includes(section)) {
                $("#schemaFilterContainer").removeClass("d-none");
                $("#objectSearchContainer").removeClass("d-none");
                loadSchemaFilter();
            }

            switch (section) {

                case "overview":
                    $("#sectionTitle").text("Database Overview");
                    $("#sectionDescription").text("Overview of database objects.");
                    loadOverview();
                    loadDatabaseInfo();
                    break;

                case "schemas":
                    $("#objectSearchContainer").removeClass("d-none");
                    $("#sectionTitle").text("Schemas");
                    $("#sectionDescription").text("Database schemas available in PostgreSQL.");
                    loadSchemas();
                    break;

                case "tables":
                    $("#sectionTitle").text("Tables");
                    $("#sectionDescription").text("Browse database tables and their records.");
                    loadTables();
                    break;

                case "views":
                    $("#sectionTitle").text("Views");
                    $("#sectionDescription").text("Manage and inspect database views.");
                    loadViews();
                    break;

                case "functions":
                    $("#sectionTitle").text("Functions");
                    $("#sectionDescription").text("PostgreSQL functions and their definitions.");
                    loadFunctions();
                    break;

                case "procedures":
                    $("#sectionTitle").text("Procedures");
                    $("#sectionDescription").text("PostgreSQL stored procedures.");
                    loadProcedures();
                    break;

                case "triggers":
                    $("#sectionTitle").text("Triggers");
                    $("#sectionDescription").text("Database triggers configured on tables.");
                    loadTriggers();
                    break;

                case "indexes":
                    $("#sectionTitle").text("Indexes");
                    $("#sectionDescription").text("Database indexes and their definitions.");
                    loadIndexes();
                    break;

                case "sql":
                    $("#sectionHeaderRow").hide();
                    loadSqlConsole();
                    break;
            }
        }

        function refreshCurrentSection() { loadCurrentSection(); }

        function loadCurrentSection() {
            switch (currentSection) {
                case "overview": loadOverview(); loadDatabaseInfo(); break;
                case "schemas": loadSchemas(); break;
                case "tables": loadTables(); break;
                case "views": loadViews(); break;
                case "functions": loadFunctions(); break;
                case "procedures": loadProcedures(); break;
                case "triggers": loadTriggers(); break;
                case "indexes": loadIndexes(); break;
                case "sql": break; // console keeps its own state
            }
        }

        function debouncedObjectFilter() {
            clearTimeout(objectFilterTimer);
            objectFilterTimer = setTimeout(applyObjectFilter, 300);
        }

        function applyObjectFilter() {
            const term = ($("#objectSearchInput").val() || "").toLowerCase().trim();
            $("#contentArea table tbody tr").each(function() {
                const text = $(this).text().toLowerCase();
                $(this).toggle(text.indexOf(term) !== -1);
            });
        }


        // ============================================================
        // OVERVIEW
        // ============================================================

        function loadOverview() {

            $("#contentArea").html(`
                        <div class="text-center py-5">
                            <div class="spinner-border text-primary"></div>
                            <div class="text-muted mt-2">Loading database overview...</div>
                        </div>
                    `);

            apiGet("/api/dbmanager/overview", function(res) {

                const d = res.data;
                $("#countSchemas").text(d.schemas || 0);
                $("#countTables").text(d.tables || 0);
                $("#countViews").text(d.views || 0);
                $("#countFunctions").text(d.functions || 0);
                $("#countProcedures").text(d.procedures || 0);
                $("#countTriggers").text(d.triggers || 0);
                $("#countIndexes").text(d.indexes || 0);

                $("#contentArea").html(`
                            <div class="row g-3">
                                <div class="col-md-6">
                                    <div class="alert alert-primary border-0">
                                        <div class="fw-semibold mb-1"><i class="bi bi-database me-1"></i> PostgreSQL Database</div>
                                        <div class="small">Connected using the application's existing ApplicationDbContext.</div>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="alert alert-warning border-0">
                                        <div class="fw-semibold mb-1"><i class="bi bi-shield-exclamation me-1"></i> Admin Access</div>
                                        <div class="small">SQL Console can modify database structure and data.</div>
                                    </div>
                                </div>
                            </div>
                            <div class="card border rounded-3">
                                <div class="card-body">
                                    <h6 class="fw-bold">Database Manager</h6>
                                    <p class="text-muted small mb-0">
                                        Use the left menu to browse schemas, tables, views, functions,
                                        procedures, triggers and indexes.
                                    </p>
                                </div>
                            </div>
                        `);
            });
        }


        // ============================================================
        // SCHEMA FILTER
        // ============================================================

        function loadSchemaFilter() {
            apiGet("/api/dbmanager/schemas", function(res) {
                const current = $("#schemaFilter").val() || "";
                let html = `<option value="">All Schemas</option>`;
                res.data.forEach(function(item) {
                    const selected = current === item.name ? "selected" : "";
                    html += `<option value="${escapeHtml(item.name)}" ${selected}>${escapeHtml(item.name)}</option>`;
                });
                $("#schemaFilter").html(html);
            });
        }

        function selectedSchema() { return $("#schemaFilter").val() || ""; }


        // ============================================================
        // SCHEMAS
        // ============================================================

        function loadSchemas() {
            showLoading();
            apiGet("/api/dbmanager/schemas", function(res) {

                if (!res.data.length) { showEmpty("bi-diagram-3", "No schemas found."); return; }

                let html = `
                            <div class="table-responsive">
                                <table class="table db-table table-hover align-middle">
                                    <thead class="table-light">
                                        <tr><th>Schema</th><th>Owner</th><th>Tables</th><th>Views</th><th>Functions</th></tr>
                                    </thead>
                                    <tbody>
                        `;

                res.data.forEach(function(row) {
                    html += `
                                <tr>
                                    <td><span class="badge schema-badge px-2 py-1"><i class="bi bi-diagram-3 me-1"></i>${escapeHtml(row.name)}</span></td>
                                    <td>${escapeHtml(row.owner || "")}</td>
                                    <td>${formatNumber(row.tableCount || 0)}</td>
                                    <td>${formatNumber(row.viewCount || 0)}</td>
                                    <td>${formatNumber(row.functionCount || 0)}</td>
                                </tr>
                            `;
                });

                html += `</tbody></table></div>`;
                $("#contentArea").html(html);
            });
        }


        // ============================================================
        // TABLES
        // ============================================================

        function loadTables() {
            showLoading();
            const schema = encodeURIComponent(selectedSchema());

            apiGet("/api/dbmanager/tables?schema=" + schema, function(res) {

                if (!res.data.length) { showEmpty("bi-table", "No tables found."); return; }

                let html = `
                            <div class="table-responsive">
                                <table class="table db-table table-hover align-middle">
                                    <thead class="table-light">
                                        <tr><th>Schema</th><th>Table</th><th>Estimated Rows</th><th class="text-end">Actions</th></tr>
                                    </thead>
                                    <tbody>
                        `;

                res.data.forEach(function(row) {
                    html += `
                                <tr>
                                    <td><span class="badge schema-badge">${escapeHtml(row.schema)}</span></td>
                                    <td class="fw-semibold"><i class="bi bi-table text-success me-1"></i>${escapeHtml(row.name)}</td>
                                    <td>${formatNumber(row.estimatedRows || 0)}</td>
                                    <td class="text-end">
                                        <button class="btn btn-sm btn-outline-primary me-1"
                                                onclick="openTableData('${jsQuote(row.schema)}','${jsQuote(row.name)}')">
                                            <i class="bi bi-eye me-1"></i>Data
                                        </button>
                                        <button class="btn btn-sm btn-outline-secondary me-1"
                                                onclick="openTableStructure('${jsQuote(row.schema)}','${jsQuote(row.name)}')">
                                            <i class="bi bi-layout-text-sidebar-reverse me-1"></i>Structure
                                        </button>
                                        <button class="btn btn-sm btn-outline-dark"
                                                onclick="generateSelectForTable('${jsQuote(row.schema)}','${jsQuote(row.name)}')"
                                                title="Open SELECT in SQL Console">
                                            <i class="bi bi-code-square"></i>
                                        </button>
                                    </td>
                                </tr>
                            `;
                });

                html += `</tbody></table></div>`;
                $("#contentArea").html(html);
            });
        }

        function generateSelectForTable(schema, table) {
            const sql = `SELECT *\nFROM ${quoteIdentJs(schema)}.${quoteIdentJs(table)}\nLIMIT 100;`;
            openSection("sql");
            setTimeout(function() { if (sqlEditor) sqlEditor.setValue(sql); }, 50);
        }

        function quoteIdentJs(name) {
            return /^[A-Za-z_][A-Za-z0-9_$]*$/.test(name) ? name : '"' + name.replace(/"/g, '""') + '"';
        }


        // ============================================================
        // TABLE STRUCTURE (Columns / Constraints / Indexes)
        // ============================================================

        function openTableStructure(schema, table) {

            currentStructureSchema = schema;
            currentStructureTable = table;

            $("#structureSubtitle").text(schema + "." + table);
            $("#structurePaneColumns").html('<div class="text-white-50 p-4">Loading columns...</div>');
            $("#structurePaneConstraints").html("");
            $("#structurePaneIndexes").html("");
            switchStructureTab("columns");

            const modal = new bootstrap.Modal(document.getElementById("tableStructureModal"));
            modal.show();

            apiGet(
                "/api/dbmanager/table-structure?schema=" + encodeURIComponent(schema) + "&table=" + encodeURIComponent(table),
                function(res) {

                    let html = "";

                    if (!res.data.length) {
                        html = '<div class="text-white-50 p-4">No columns found.</div>';
                    } else {
                        html = `
                                    <table class="table table-dark table-hover mb-0">
                                        <thead>
                                            <tr><th>#</th><th>Column</th><th>Data Type</th><th>Nullable</th><th>Default</th><th>Max Length</th></tr>
                                        </thead>
                                        <tbody>
                                `;

                        res.data.forEach(function(row) {
                            html += `
                                        <tr>
                                            <td>${row.ordinal ?? ""}</td>
                                            <td><strong>${escapeHtml(row.columnName || "")}</strong>
                                                ${row.comment ? `<div class="text-white-50 small">${escapeHtml(row.comment)}</div>` : ""}
                                            </td>
                                            <td>${escapeHtml(row.dataType || "")}
                                                ${row.udtName ? `<small class="text-white-50 ms-1">(${escapeHtml(row.udtName)})</small>` : ""}
                                            </td>
                                            <td>${row.nullable === "YES" ? "YES" : "NO"}</td>
                                            <td class="code-preview text-white-50">${escapeHtml(row.defaultValue || "")}</td>
                                            <td>${row.maxLength ?? ""}</td>
                                        </tr>
                                    `;
                        });

                        html += `</tbody></table>`;
                    }

                    $("#structurePaneColumns").html(html);
                }
            );

            apiGet(
                "/api/dbmanager/table-constraints?schema=" + encodeURIComponent(schema) + "&table=" + encodeURIComponent(table),
                function(res) {

                    const d = res.data;

                    let cHtml = "";
                    if (!d.constraints.length) {
                        cHtml = '<div class="text-white-50 p-4">No primary key, unique or foreign key constraints.</div>';
                    } else {
                        cHtml = `
                                    <table class="table table-dark table-hover mb-0">
                                        <thead><tr><th>Name</th><th>Type</th><th>Column</th><th>References</th></tr></thead>
                                        <tbody>
                                `;
                        d.constraints.forEach(function(row) {
                            const ref = row.foreignTable
                                ? `${escapeHtml(row.foreignSchema)}.${escapeHtml(row.foreignTable)}.${escapeHtml(row.foreignColumn)}`
                                : "";
                            cHtml += `
                                        <tr>
                                            <td class="font-monospace small">${escapeHtml(row.name)}</td>
                                            <td><span class="badge bg-secondary">${escapeHtml(row.type)}</span></td>
                                            <td>${escapeHtml(row.column || "")}</td>
                                            <td class="text-white-50">${ref}</td>
                                        </tr>
                                    `;
                        });
                        cHtml += `</tbody></table>`;
                    }

                    if (d.checks.length) {
                        cHtml += `<div class="p-3 text-white-50 small fw-bold">CHECK constraints</div>
                                           <table class="table table-dark table-hover mb-0"><tbody>`;
                        d.checks.forEach(function(row) {
                            cHtml += `<tr><td class="font-monospace small">${escapeHtml(row.name)}</td>
                                               <td class="font-monospace small text-white-50">${escapeHtml(row.definition)}</td></tr>`;
                        });
                        cHtml += `</tbody></table>`;
                    }

                    $("#structurePaneConstraints").html(cHtml);

                    let iHtml = "";
                    if (!d.indexes.length) {
                        iHtml = '<div class="text-white-50 p-4">No indexes on this table.</div>';
                    } else {
                        iHtml = `<table class="table table-dark table-hover mb-0"><tbody>`;
                        d.indexes.forEach(function(row) {
                            iHtml += `<tr><td class="font-monospace small">${escapeHtml(row.name)}</td>
                                               <td class="font-monospace small text-white-50">${escapeHtml(row.definition)}</td></tr>`;
                        });
                        iHtml += `</tbody></table>`;
                    }
                    $("#structurePaneIndexes").html(iHtml);
                }
            );
        }

        function switchStructureTab(tab) {
            ["columns", "constraints", "indexes"].forEach(function(t) {
                $("#structurePane" + capitalize(t)).toggle(t === tab);
                $("#structTab" + capitalize(t) + "Btn").toggleClass("active text-white", t === tab);
                $("#structTab" + capitalize(t) + "Btn").toggleClass("text-white-50", t !== tab);
            });
        }


        // ============================================================
        // TABLE DATA
        // ============================================================

        function openTableData(schema, table) {

            currentTableSchema = schema;
            currentTableName = table;
            currentTablePage = 1;

            $("#tableDataTitle").text(table);
            $("#tableDataSubtitle").text(schema + "." + table);
            $("#tableSearch").val("");

            const modal = new bootstrap.Modal(document.getElementById("tableDataModal"));
            modal.show();

            loadTableData(1);
        }

        function loadTableData(page) {

            currentTablePage = page || 1;
            const search = $("#tableSearch").val() || "";
            const pageSize = $("#pageSize").val() || 50;

            $("#tableDataTable tbody").html(`
                        <tr><td colspan="100" class="text-center py-5">
                            <div class="spinner-border spinner-border-sm text-primary"></div>
                            <div class="small text-muted mt-2">Loading records...</div>
                        </td></tr>
                    `);

            apiGet(
                "/api/dbmanager/table-data" +
                "?schema=" + encodeURIComponent(currentTableSchema) +
                "&table=" + encodeURIComponent(currentTableName) +
                "&page=" + currentTablePage +
                "&pageSize=" + pageSize +
                "&search=" + encodeURIComponent(search),

                function(res) {

                    const columns = res.columns || [];
                    const rows = res.data || [];

                    currentTableData = { columns, rows };

                    let head = "<tr>";
                    columns.forEach(function(column) { head += `<th>${escapeHtml(column)}</th>`; });
                    head += "</tr>";
                    $("#tableDataTable thead").html(head);

                    if (!rows.length) {
                        $("#tableDataTable tbody").html(`
                                    <tr><td colspan="${columns.length || 1}" class="text-center py-5 text-muted">
                                        <i class="bi bi-inbox fs-3 d-block mb-2"></i>No records found.
                                    </td></tr>
                                `);
                    } else {
                        let body = "";
                        rows.forEach(function(row) {
                            body += "<tr>";
                            columns.forEach(function(column) {
                                const value = row[column];
                                const isNull = value === null || value === undefined;
                                const display = formatCellValue(value);
                                body += `<td class="${isNull ? "is-null" : ""}" title="${escapeHtml(display)}"
                                                     onclick="copyToClipboard('${jsQuote(display)}')">${isNull ? "NULL" : escapeHtml(display)}</td>`;
                            });
                            body += "</tr>";
                        });
                        $("#tableDataTable tbody").html(body);
                    }

                    const p = res.pagination;
                    $("#tableRecordInfo").text(formatNumber(p.totalRows) + " total records");
                    $("#pageInfo").text("Page " + p.page + " of " + Math.max(p.totalPages, 1));
                    $("#prevPageBtn").prop("disabled", p.page <= 1);
                    $("#nextPageBtn").prop("disabled", p.page >= p.totalPages);
                }
            );
        }

        function changeTablePage(direction) {
            const next = currentTablePage + direction;
            if (next < 1) return;
            loadTableData(next);
        }

        function exportTableDataCsv() {

            const { columns, rows } = currentTableData;
            if (!rows.length) { showToast("Nothing to export."); return; }

            const csvRows = [columns.map(csvEscape).join(",")];
            rows.forEach(function(row) {
                csvRows.push(columns.map(function(c) { return csvEscape(formatCellValue(row[c])); }).join(","));
            });

            downloadTextFile(currentTableName + ".csv", csvRows.join("\n"));
        }

        function csvEscape(value) {
            const s = String(value ?? "");
            if (/[",\n]/.test(s)) return '"' + s.replace(/"/g, '""') + '"';
            return s;
        }

        function downloadTextFile(filename, content) {
            const blob = new Blob([content], { type: "text/plain;charset=utf-8" });
            const url = URL.createObjectURL(blob);
            const a = document.createElement("a");
            a.href = url;
            a.download = filename;
            document.body.appendChild(a);
            a.click();
            document.body.removeChild(a);
            URL.revokeObjectURL(url);
        }


        // ============================================================
        // VIEWS
        // ============================================================

        function loadViews() {
            showLoading();
            const schema = encodeURIComponent(selectedSchema());

            apiGet("/api/dbmanager/views?schema=" + schema, function(res) {

                if (!res.data.length) { showEmpty("bi-layout-text-window-reverse", "No views found."); return; }

                let html = `
                            <div class="table-responsive">
                                <table class="table db-table table-hover align-middle">
                                    <thead class="table-light"><tr><th>Schema</th><th>View</th><th class="text-end">Action</th></tr></thead>
                                    <tbody>
                        `;

                res.data.forEach(function(row) {
                    html += `
                                <tr class="object-row">
                                    <td><span class="badge schema-badge">${escapeHtml(row.schema)}</span></td>
                                    <td class="fw-semibold"><i class="bi bi-layout-text-window-reverse text-info me-1"></i>${escapeHtml(row.name)}</td>
                                    <td class="text-end">
                                        <button class="btn btn-sm btn-outline-dark"
                                                onclick="showDefinition('view','${jsQuote(row.schema)}','${jsQuote(row.name)}')">
