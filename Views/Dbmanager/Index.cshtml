                matchBrackets: true,
                styleActiveLine: true,
                indentUnit: 4,
                extraKeys: {
                    "Ctrl-Enter": function() { executeSql(); },
                    "F5": function() { executeSql(); },
                    "Cmd-Enter": function() { executeSql(); }
