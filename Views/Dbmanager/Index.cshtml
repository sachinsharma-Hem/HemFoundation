        function setupSqlResizeHandle() {

            const handle = document.getElementById("sqlResizeHandle");
            if (!handle) return;

            let dragging = false;
            let startY = 0;
            let startHeight = 0;

            handle.addEventListener("mousedown", function(e) {
                dragging = true;
                startY = e.clientY;
                startHeight = sqlEditor.getWrapperElement().offsetHeight;
                document.body.style.userSelect = "none";
            });

            document.addEventListener("mousemove", function(e) {
                if (!dragging) return;
                const delta = e.clientY - startY;
                const newHeight = Math.max(140, Math.min(startHeight + delta, window.innerHeight - 260));
                sqlEditor.getWrapperElement().style.height = newHeight + "px";
                sqlEditor.refresh();
            });

            document.addEventListener("mouseup", function() {
                if (!dragging) return;
                dragging = false;
                document.body.style.userSelect = "";
            });
        }

        function switchSqlTab(tab) {
            ["results", "history"].forEach(function(t) {
                $("#sqlPane" + capitalize(t)).toggle(t === tab);
                $("#sqlTab" + capitalize(t) + "Btn").toggleClass("active", t === tab);
            });
            $("#clearTerminalBtn").toggle(tab === "results");
            if (tab === "history") renderSqlHistoryPane();
        }

        function clearSqlEditor() {
            if (sqlEditor) sqlEditor.setValue("");
            setSqlStatus("Ready.", "");
        }

        function clearSqlTerminal() {
            $("#sqlPaneResults").html(`
                        <div class="sql-empty-state">
                            <i class="bi bi-terminal d-block mb-2"></i>
                            No query executed yet. Write some SQL above and hit <strong>Execute</strong>.
                        </div>
                    `);
        }

        function formatSqlEditor() {
            if (!sqlEditor) return;
            try {
                const selected = sqlEditor.getSelection();
                const source = selected && selected.trim() ? selected : sqlEditor.getValue();
                const formatted = window.sqlFormatter ? sqlFormatter.format(source) : source;
                if (selected && selected.trim()) sqlEditor.replaceSelection(formatted);
                else sqlEditor.setValue(formatted);
                showCopyToast("SQL formatted.");
            } catch (e) {
                showCopyToast("Could not format this SQL.");
            }
        }

        function toggleSqlFullscreen(force) {
            const root = document.getElementById("dbManagerRoot");
            const shouldBeFullscreen = typeof force === "boolean" ? force : !root.classList.contains("sql-fullscreen-active");
            root.classList.toggle("sql-fullscreen-active", shouldBeFullscreen);
            if (sqlEditor) setTimeout(function() { sqlEditor.refresh(); }, 50);
        }


        // ------------------------------------------------------------
        // EXECUTE
        // ------------------------------------------------------------

        function getSqlToRun() {
            if (!sqlEditor) return "";
            const selected = sqlEditor.getSelection();
            return (selected && selected.trim()) ? selected.trim() : sqlEditor.getValue().trim();
        }

        function isDestructiveSql(sql) {
            const trimmed = sql.trim();

            if (/^(DROP|TRUNCATE)\b/i.test(trimmed)) {
                return "DROP/TRUNCATE statements permanently remove objects or data.";
            }
            if (/^DELETE\b/i.test(trimmed) && !/\bWHERE\b/i.test(trimmed)) {
                return "DELETE without a WHERE clause will remove every row in the table.";
            }
            if (/^UPDATE\b/i.test(trimmed) && !/\bWHERE\b/i.test(trimmed)) {
                return "UPDATE without a WHERE clause will modify every row in the table.";
            }
            return null;
        }

        function executeSql() {

            if (sqlRunning) return;

            const sql = getSqlToRun();

            if (!sql) {
                setSqlStatus("Please enter a SQL query.", "error");
                return;
            }

            pendingSql = sql;

            const reason = isDestructiveSql(sql);

            if (reason) {
                $("#sqlConfirmReason").text(reason);
                const modal = new bootstrap.Modal(document.getElementById("sqlConfirmModal"));
                modal.show();
                return;
            }

            runPendingSql();
        }

        function confirmExecuteSql() {
            const modalEl = document.getElementById("sqlConfirmModal");
            const modal = bootstrap.Modal.getInstance(modalEl);
            if (modal) modal.hide();
            runPendingSql();
        }

        function runPendingSql() {

            if (sqlRunning) return;
            sqlRunning = true;

            $("#sqlRunBtn").prop("disabled", true).html('<span class="spinner-border spinner-border-sm me-1"></span>Running...');
            setSqlStatus("Executing query...", "running");

            const startedAt = performance.now();
            const sqlThatRan = pendingSql;

            $.ajax({
                url: "/api/dbmanager/execute",
                type: "POST",
                contentType: "application/json",
                data: JSON.stringify({ sql: sqlThatRan }),

                success: function(res) {

                    const clientMs = Math.round(performance.now() - startedAt);
                    const elapsed = res.executionTimeMs !== undefined ? res.executionTimeMs
                        : (res.elapsedMs !== undefined ? res.elapsedMs : clientMs);

                    if (res.type === "result") {

                        setSqlStatus(`✓ ${res.command || "SELECT"} executed successfully — ${res.rowCount} row(s) returned — ${elapsed} ms`, "success");
                        appendTerminalEntry(sqlThatRan, buildResultEntryHtml(res, elapsed));
                        addSqlHistoryEntry(sqlThatRan, true, elapsed, `${res.rowCount} rows`);

                    } else {

                        const label = res.command || "Command";
                        setSqlStatus(`✓ ${label} executed successfully — ${res.affectedRows} row(s) affected — ${elapsed} ms`, "success");
                        appendTerminalEntry(sqlThatRan, buildCommandEntryHtml(res, elapsed));
                        addSqlHistoryEntry(sqlThatRan, true, elapsed, `${res.affectedRows} affected`);

                        refreshAfterWrite(res);
                    }

                    $("#sqlLastRunBadge").removeClass("bg-danger-subtle text-danger").addClass("bg-success-subtle text-success")
                        .text(`Last run: ${elapsed} ms`);

                    switchSqlTab("results");
                },

                error: function(xhr) {

                    const clientMs = Math.round(performance.now() - startedAt);
                    let message = "SQL execution failed.";
                    let elapsed = clientMs;

                    if (xhr.responseJSON) {
                        if (xhr.responseJSON.message) message = xhr.responseJSON.message;
                        if (xhr.responseJSON.executionTimeMs !== undefined) elapsed = xhr.responseJSON.executionTimeMs;
                        else if (xhr.responseJSON.elapsedMs !== undefined) elapsed = xhr.responseJSON.elapsedMs;
                    }

                    if (xhr.status === 401) {
                        message = "Your session has expired. Please log in again.";
                    }

                    setSqlStatus(`✕ SQL execution failed — ${elapsed} ms`, "error");
                    appendTerminalEntry(sqlThatRan, buildErrorEntryHtml(message, elapsed));

                    $("#sqlLastRunBadge").removeClass("bg-success-subtle text-success").addClass("bg-danger-subtle text-danger")
                        .text("Last run failed");

                    addSqlHistoryEntry(sqlThatRan, false, elapsed, message);
                    switchSqlTab("results");
                },

                complete: function() {
                    sqlRunning = false;
                    $("#sqlRunBtn").prop("disabled", false).html('<i class="bi bi-play-fill me-1"></i>Execute');
                }
            });
        }

        function setSqlStatus(text, kind) {
            const el = $("#sqlExecutionStatus");
            el.removeClass("status-success status-error status-running");
            if (kind === "success") el.addClass("status-success");
            if (kind === "error") el.addClass("status-error");
            if (kind === "running") el.addClass("status-running");
            const icon = kind === "success" ? "bi-check-circle" : kind === "error" ? "bi-x-circle" : kind === "running" ? "bi-hourglass-split" : "bi-terminal";
            el.html(`<i class="bi ${icon} me-1"></i>${escapeHtml(text)}`);
        }


        // ------------------------------------------------------------
        // AFTER-WRITE REFRESH
        //
        // Keeps the SQL editor content and history untouched. Only
        // refreshes the specific section/table that the statement
        // actually touched, and never reloads the page.
        // ------------------------------------------------------------

        const SECTION_BY_OBJECT_KIND = {
            "view": "views",
            "materialized view": "views",
            "function": "functions",
            "procedure": "procedures",
            "trigger": "triggers",
            "index": "indexes",
            "table": "tables",
            "schema": "schemas"
        };

        function refreshAfterWrite(res) {

            // Always keep the Overview counters honest.
            if (currentSection === "overview") loadOverview();

            const kind = (res.objectKind || "").toLowerCase();
            const targetSection = SECTION_BY_OBJECT_KIND[kind];

            if (targetSection && currentSection === targetSection) {
                loadCurrentSection();
            }

            // If a table data modal happens to be open, refresh it too -
            // covers INSERT/UPDATE/DELETE against the table being browsed.
            const tableModalEl = document.getElementById("tableDataModal");
            if (tableModalEl && tableModalEl.classList.contains("show") && currentTableSchema && currentTableName) {
                loadTableData(currentTablePage);
            }
        }


        // ------------------------------------------------------------
        // TERMINAL LOG (Results tab)
        // ------------------------------------------------------------

        const MAX_TERMINAL_ENTRIES = 25;

        function appendTerminalEntry(sql, bodyHtml) {

            const time = new Date().toLocaleTimeString();

            const entryHtml = `
                        <div class="sql-terminal-entry">
                            <div class="sql-terminal-echo">
                                <span class="text-muted small">${time}</span>
                                <pre class="mb-0">${escapeHtml(sql)}</pre>
                            </div>
                            ${bodyHtml}
                        </div>
                    `;

            const pane = document.getElementById("sqlPaneResults");

            if (pane.querySelector(".sql-empty-state")) pane.innerHTML = "";

            pane.insertAdjacentHTML("afterbegin", entryHtml);

            // Cap the DOM so a long session doesn't get sluggish.
            const entries = pane.querySelectorAll(".sql-terminal-entry");
            for (let i = MAX_TERMINAL_ENTRIES; i < entries.length; i++) entries[i].remove();

            pane.scrollTop = 0;
        }

        function buildResultEntryHtml(res, elapsed) {

            const rows = res.data || [];
            const columns = res.columns || (rows.length ? Object.keys(rows[0]) : []);

            let html = `
                        <div class="sql-terminal-status status-success">
                            <i class="bi bi-check-circle-fill me-1"></i>
                            ${escapeHtml(res.command || "SELECT")} executed successfully
                            <span class="sql-terminal-meta">Rows returned: <strong>${res.rowCount}</strong> &middot; ${elapsed} ms</span>
                        </div>
                    `;

            if (rows.length) {
                html += renderDataGrid(columns, rows, "sql-" + Date.now());
            } else {
                html += `<div class="text-muted small px-3 pb-2">Query executed successfully but returned no rows.</div>`;
            }

            return html;
        }

        function buildCommandEntryHtml(res, elapsed) {

            let html = `
                        <div class="sql-terminal-status status-success">
                            <i class="bi bi-check-circle-fill me-1"></i>
                            ${escapeHtml(res.message || (res.command + " executed successfully."))}
                            <span class="sql-terminal-meta">Rows affected: <strong>${res.affectedRows}</strong> &middot; ${elapsed} ms</span>
                        </div>
                    `;

            if (res.verification && res.verification.data && res.verification.data.length) {
                html += `
                            <div class="sql-terminal-subheading">
                                <i class="bi bi-eye me-1"></i>Updated row(s)
                            </div>
                        `;
                html += renderDataGrid(res.verification.columns, res.verification.data, "verify-" + Date.now());
            }

            return html;
        }

        function buildErrorEntryHtml(message, elapsed) {
            return `
                        <div class="sql-terminal-status status-error">
                            <i class="bi bi-x-circle-fill me-1"></i>
                            SQL execution failed
                            <span class="sql-terminal-meta">${elapsed} ms</span>
                        </div>
                        <div class="sql-terminal-error">
                            <pre class="mb-2">${escapeHtml(message)}</pre>
                            <button class="btn btn-sm btn-outline-danger" onclick="copyToClipboard('${jsQuote(message)}')">
                                <i class="bi bi-clipboard me-1"></i>Copy error
                            </button>
                        </div>
                    `;
        }


        // ------------------------------------------------------------
        // SHARED DATA GRID (used by SQL results + verification rows)
        // ------------------------------------------------------------

        function renderDataGrid(columns, rows, gridId) {

            window["__grid_" + gridId] = { columns, rows };

            let html = `
                        <div class="data-grid-toolbar">
                            <span class="small text-muted">${rows.length} row(s)</span>
                            <div class="d-flex gap-2">
                                <button class="btn btn-sm btn-outline-secondary" onclick="copyGridResult('${gridId}')">
                                    <i class="bi bi-clipboard me-1"></i>Copy All
                                </button>
                                <button class="btn btn-sm btn-outline-secondary" onclick="exportGridCsv('${gridId}')">
                                    <i class="bi bi-download me-1"></i>Export CSV
                                </button>
                            </div>
                        </div>
                        <div class="data-grid-scroll">
                            <table class="table table-sm table-hover mb-0">
                                <thead><tr>
                    `;

            columns.forEach(function(c) { html += `<th>${escapeHtml(c)}</th>`; });
            html += `</tr></thead><tbody>`;

            rows.forEach(function(row) {
                html += "<tr>";
                columns.forEach(function(c) {
                    html += renderGridCell(row[c]);
                });
                html += "</tr>";
            });

            html += `</tbody></table></div>`;
            return html;
        }

        function renderGridCell(value) {

            if (value === null || value === undefined) {
                return `<td class="is-null" onclick="copyToClipboard('')">NULL</td>`;
            }

            if (typeof value === "boolean") {
                const cls = value ? "bool-true" : "bool-false";
                return `<td class="${cls}" onclick="copyToClipboard('${value}')">${value}</td>`;
            }

            if (typeof value === "object") {
                let json = "";
                try { json = JSON.stringify(value); } catch { json = String(value); }
                const pretty = escapeHtml(JSON.stringify(value, null, 2));
                return `<td class="is-json" title="${escapeHtml(json)}" onclick="copyToClipboard('${jsQuote(json)}')"><code>${escapeHtml(json)}</code></td>`;
            }

            const display = String(value);
            return `<td title="${escapeHtml(display)}" onclick="copyToClipboard('${jsQuote(display)}')">${escapeHtml(display)}</td>`;
        }

        function copyGridResult(gridId) {
            const grid = window["__grid_" + gridId];
            if (!grid || !grid.rows.length) return;
            const lines = [grid.columns.join("\t")];
            grid.rows.forEach(function(row) {
                lines.push(grid.columns.map(function(c) { return formatCellValue(row[c]); }).join("\t"));
            });
            copyToClipboard(lines.join("\n"));
        }

        function exportGridCsv(gridId) {
            const grid = window["__grid_" + gridId];
            if (!grid || !grid.rows.length) { showCopyToast("Nothing to export."); return; }
            const csvRows = [grid.columns.map(csvEscape).join(",")];
            grid.rows.forEach(function(row) {
                csvRows.push(grid.columns.map(function(c) { return csvEscape(formatCellValue(row[c])); }).join(","));
            });
            downloadTextFile("query_result.csv", csvRows.join("\n"));
        }


        // ------------------------------------------------------------
        // QUERY HISTORY (localStorage) — with favorites/pins
        // ------------------------------------------------------------

        function loadSqlHistoryFromStorage() {
            try {
                const raw = localStorage.getItem(SQL_HISTORY_KEY);
                sqlHistory = raw ? JSON.parse(raw) : [];
            } catch { sqlHistory = []; }
        }

        function persistSqlHistory() {
            try { localStorage.setItem(SQL_HISTORY_KEY, JSON.stringify(sqlHistory)); } catch { /* storage may be unavailable */ }
            updateSqlHistoryBadge();
        }

        function updateSqlHistoryBadge() {
            $("#sqlHistoryCountBadge").text(sqlHistory.length);
        }

        function addSqlHistoryEntry(sql, success, elapsedMs, note) {
            sqlHistory.unshift({
                sql,
                success,
                elapsedMs,
                note,
                favorite: false,
                at: new Date().toISOString()
            });
            if (sqlHistory.length > SQL_HISTORY_LIMIT) sqlHistory = sqlHistory.slice(0, SQL_HISTORY_LIMIT);
            persistSqlHistory();
            if ($("#sqlTabHistoryBtn").hasClass("active")) renderSqlHistoryPane();
        }

        function renderSqlHistoryPane() {

            if (!sqlHistory.length) {
                $("#sqlPaneHistory").html(`
                            <div class="sql-empty-state">
                                <i class="bi bi-clock-history d-block mb-2"></i>
                                No query history yet — queries you run or save will show up here.
                            </div>
                        `);
                return;
            }

            const sorted = sqlHistory.map(function(item, index) { return { item, index }; })
                .sort(function(a, b) { return (b.item.favorite ? 1 : 0) - (a.item.favorite ? 1 : 0); });

            let html = `<div class="d-flex justify-content-end p-2">
                                    <button class="btn btn-sm btn-outline-danger" onclick="clearSqlHistory()">
                                        <i class="bi bi-trash me-1"></i>Clear History
                                    </button>
                                </div>`;

            sorted.forEach(function(entry) {
                const item = entry.item;
                const index = entry.index;
                const when = new Date(item.at).toLocaleString();
                const icon = item.success ? '<i class="bi bi-check-circle text-success me-1"></i>' : '<i class="bi bi-x-circle text-danger me-1"></i>';
                const starClass = item.favorite ? "bi-star-fill text-warning" : "bi-star text-muted";

                html += `
                            <div class="sql-history-item">
                                <div class="d-flex justify-content-between align-items-start gap-2">
                                    <div class="flex-grow-1" style="cursor:pointer;" onclick="loadHistoryEntry(${index})">
                                        <div class="d-flex justify-content-between">
                                            <span class="small text-muted">${icon}${when}</span>
                                            <span class="small text-muted">${item.elapsedMs} ms — ${escapeHtml(item.note || "")}</span>
                                        </div>
                                        <span class="hist-sql">${escapeHtml(item.sql)}</span>
                                    </div>
                                    <button class="btn btn-sm btn-link p-0" onclick="toggleHistoryFavorite(${index}); event.stopPropagation();" title="Pin to top">
                                        <i class="bi ${starClass}"></i>
                                    </button>
                                </div>
                            </div>
                        `;
            });

            $("#sqlPaneHistory").html(html);
        }

        function toggleHistoryFavorite(index) {
            if (!sqlHistory[index]) return;
            sqlHistory[index].favorite = !sqlHistory[index].favorite;
            persistSqlHistory();
            renderSqlHistoryPane();
        }

        function loadHistoryEntry(index) {
            const item = sqlHistory[index];
            if (item && sqlEditor) {
                sqlEditor.setValue(item.sql);
                switchSqlTab("results");
                showCopyToast("Query loaded into editor.");
            }
        }

        function clearSqlHistory() {
            sqlHistory = [];
            persistSqlHistory();
            renderSqlHistoryPane();
        }

        function saveCurrentQuery() {
            if (!sqlEditor) return;
            const sql = sqlEditor.getValue().trim();
            if (!sql) { showCopyToast("Nothing to save."); return; }
            addSqlHistoryEntry(sql, true, 0, "saved");
            sqlHistory[0].favorite = true;
            persistSqlHistory();
            showCopyToast("Query pinned in History.");
        }



        // ============================================================
        // UI HELPERS
        // ============================================================

        function showLoading() {
            $("#contentArea").html(`
                        <div class="text-center py-5">
                            <div class="spinner-border text-primary"></div>
                            <div class="text-muted small mt-2">Loading...</div>
                        </div>
                    `);
        }

        function showEmpty(icon, message) {
            $("#contentArea").html(`
                        <div class="empty-state">
                            <i class="bi ${icon} d-block mb-3"></i>
                            <div>${escapeHtml(message)}</div>
                        </div>
                    `);
        }

        function showError(message) {
            $("#contentArea").html(`
                        <div class="alert alert-danger">
                            <i class="bi bi-exclamation-circle me-1"></i>${escapeHtml(message)}
                        </div>
                    `);
        }

        // A small floating toast, used for copy confirmations and other
        // quick one-line feedback that doesn't belong in an alert box.
        function showCopyToast(message) {

            let container = document.getElementById("dbToastContainer");

            if (!container) {
                container = document.createElement("div");
                container.id = "dbToastContainer";
                container.className = "db-toast-container";
                document.body.appendChild(container);
            }

            const toast = document.createElement("div");
            toast.className = "db-toast";
            toast.innerHTML = `<i class="bi bi-check2-circle me-2"></i>${escapeHtml(message)}`;
            container.appendChild(toast);

            requestAnimationFrame(function() { toast.classList.add("show"); });

            setTimeout(function() {
                toast.classList.remove("show");
                setTimeout(function() { toast.remove(); }, 200);
            }, 2200);
        }

        // Back-compat alias — older calls in this file use showToast().
        function showToast(message) { showCopyToast(message); }

        function copyToClipboard(text) {
            if (text === "" || text === null || text === undefined) return;

            if (navigator.clipboard && navigator.clipboard.writeText) {
                navigator.clipboard.writeText(text)
                    .then(function() { showCopyToast("Copied to clipboard."); })
                    .catch(function() { fallbackCopy(text); });
            } else {
                fallbackCopy(text);
                showCopyToast("Copied to clipboard.");
            }
        }

        function fallbackCopy(text) {
            const el = document.createElement("textarea");
            el.value = text;
            el.style.position = "fixed";
            el.style.opacity = "0";
            document.body.appendChild(el);
            el.select();
            try { document.execCommand("copy"); } catch { /* no-op */ }
            document.body.removeChild(el);
        }

        function formatNumber(value) { return Number(value || 0).toLocaleString(); }

        function formatCellValue(value) {
            if (value === null || value === undefined) return "";
            if (typeof value === "boolean") return value ? "true" : "false";
            if (typeof value === "object") {
                try { return JSON.stringify(value); } catch { return String(value); }
            }
            return String(value);
        }

        function capitalize(value) {
            if (!value) return "";
            return value.charAt(0).toUpperCase() + value.slice(1);
        }

        function escapeHtml(value) {
            if (value === null || value === undefined) return "";
            return String(value)
                .replace(/&/g, "&amp;")
                .replace(/</g, "&lt;")
                .replace(/>/g, "&gt;")
                .replace(/"/g, "&quot;")
                .replace(/'/g, "&#039;");
        }

        function jsQuote(value) {
            return String(value)
                .replace(/\\/g, "\\\\")
                .replace(/'/g, "\\'")
                .replace(/"/g, '\\"');
        }

    </script>

}
