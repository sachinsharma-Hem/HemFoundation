@{
    ViewData["Title"] = "Menu Management";
    Layout = "~/Views/Shared/Layouts/_AdminLayout.cshtml";
}

<div class="container-fluid py-3">
    <div class="card border-0 shadow-sm rounded-4 bg-white p-4 mb-4">
        <div class="d-flex flex-wrap align-items-center justify-content-between gap-3">
            <div>
                <h3 class="fw-bold text-dark mb-1"><i class="bi bi-list-ul text-success me-2"></i> Menu Management</h3>
                <p class="text-muted small m-0">Create, edit, organize and manage navigation menus and submenus dynamically.</p>
            </div>
            <div>
                <button type="button" class="btn btn-success rounded-pill px-4 py-2 fw-semibold shadow-sm d-flex align-items-center gap-2" onclick="openAddModal()">
                    <i class="bi bi-plus-circle fs-5"></i>
                    <span>Add New Menu</span>
                </button>
            </div>
        </div>
    </div>

    <div class="card border-0 shadow-sm rounded-4 bg-white p-4">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0" id="menuTable">
                <thead class="table-light text-secondary small text-uppercase">
                    <tr>
                        <th style="width: 60px;">Order</th>
                        <th>Menu Name</th>
                        <th>Hierarchy / Type</th>
                        <th>Route / Controller</th>
                        <th>Icon</th>
                        <th>Status</th>
                        <th class="text-end" style="width: 160px;">Actions</th>
                    </tr>
                </thead>
                <tbody id="menuTableBody">
                    <tr>
                        <td colspan="7" class="text-center py-5 text-muted">
                            <div class="spinner-border text-success mb-2" role="status"></div>
                            <p class="small m-0">Loading menus from database...</p>
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>
</div>

<div class="modal fade" id="menuModal" tabindex="-1" aria-labelledby="menuModalLabel" aria-hidden="true" data-bs-backdrop="static">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content border-0 shadow-lg rounded-4 overflow-hidden">

            <div class="modal-header bg-light border-bottom px-4 py-3">
                <h5 class="fw-bold text-dark m-0 d-flex align-items-center gap-2" id="menuModalLabel">
                    <i class="bi bi-folder-plus text-success fs-4"></i>
                    <span id="modalTitleText">Add New Menu</span>
                </h5>
                <button type="button" class="btn-close shadow-none" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>

            <form id="menuForm" class="needs-validation" novalidate>
                <div class="modal-body p-4">
                    <input type="hidden" id="menuId" value="0" />

                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label small fw-bold text-secondary">Parent Menu (Optional)</label>
                            <select class="form-select rounded-3 shadow-none border" id="parentId">
                                <option value="0">-- None (This is a Parent Menu) --</option>
                            </select>
                            <div class="form-text small">Select a parent if this is a submenu.</div>
                        </div>

                        <div class="col-md-6">
                            <label class="form-label small fw-bold text-secondary">Menu Name <span class="text-danger">*</span></label>
                            <input type="text" class="form-control rounded-3 shadow-none border" id="menuName" placeholder="e.g. User Management" required />
                        </div>

                        <div class="col-md-4">
                            <label class="form-label small fw-bold text-secondary">Controller</label>
                            <input type="text" class="form-control rounded-3 shadow-none border" id="controllerName" placeholder="e.g. User" />
                        </div>

                        <div class="col-md-4">
                            <label class="form-label small fw-bold text-secondary">Action</label>
                            <input type="text" class="form-control rounded-3 shadow-none border" id="actionName" placeholder="e.g. Index" />
                        </div>

                        <div class="col-md-4">
                            <label class="form-label small fw-bold text-secondary">Custom Route URL</label>
                            <input type="text" class="form-control rounded-3 shadow-none border" id="routeUrl" placeholder="e.g. /admin/users" />
                        </div>

                        <div class="col-md-6">
                            <label class="form-label small fw-bold text-secondary">Icon Class (Bootstrap Icons)</label>
                            <div class="input-group">
                                <span class="input-group-text bg-light border" id="iconPreview"><i class="bi bi-folder"></i></span>
                                <input type="text" class="form-control rounded-end-3 shadow-none border" id="menuIcon" placeholder="bi bi-people" value="bi bi-folder" />
                            </div>
                            <div class="form-text small"><a href="https://icons.getbootstrap.com/" target="_blank" class="text-success text-decoration-none">Browse icons <i class="bi bi-box-arrow-up-right"></i></a></div>
                        </div>

                        <div class="col-md-6">
                            <label class="form-label small fw-bold text-secondary">Display Order</label>
                            <input type="number" class="form-control rounded-3 shadow-none border" id="displayOrder" value="1" min="1" required />
                        </div>

                        <div class="col-12 mt-4 d-flex gap-4 p-3 bg-light rounded-3 border">
                            <div class="form-check form-switch m-0">
                                <input class="form-check-input cursor-pointer shadow-none" type="checkbox" role="switch" id="isActive" checked>
                                <label class="form-check-label small fw-bold text-dark cursor-pointer" for="isActive">Is Active</label>
                            </div>
                            <div class="form-check form-switch m-0">
                                <input class="form-check-input cursor-pointer shadow-none" type="checkbox" role="switch" id="isVisible" checked>
                                <label class="form-check-label small fw-bold text-dark cursor-pointer" for="isVisible">Is Visible in Sidebar</label>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="modal-footer bg-light border-top px-4 py-3">
                    <button type="button" class="btn btn-outline-secondary rounded-pill px-4 fw-semibold" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-success rounded-pill px-5 fw-bold shadow-sm" id="btnSaveMenu">
                        <i class="bi bi-check2-circle me-1"></i> Save Menu
                    </button>
                </div>
            </form>

        </div>
    </div>
</div>

@section Scripts {
    <script>
        let allMenusList = [];

        $(document).ready(function () {
            loadMenus();

            // Live Icon Preview in Modal
            $('#menuIcon').on('input', function () {
                let iconClass = $(this).val() || 'bi bi-folder';
                $('#iconPreview').html(`<i class="${iconClass}"></i>`);
            });

            // Handle Form Submit (Save / Update)
            $('#menuForm').on('submit', function (e) {
                e.preventDefault();
                saveMenu();
            });
        });

        // =========================================================================
        // 1. LOAD ALL MENUS FROM API
        // =========================================================================
        function loadMenus() {
            $.ajax({
                url: '/api/menu/list',
                type: 'GET',
                success: function (response) {
                    if (response.success) {
                        allMenusList = response.data;
                        renderMenuTable(allMenusList);
                        populateParentDropdown(allMenusList);
                    }
                },
                error: function () {
                    $('#menuTableBody').html(`<tr><td colspan="7" class="text-center py-4 text-danger"><i class="bi bi-exclamation-triangle-fill me-2"></i> Failed to load menus from server.</td></tr>`);
                }
            });
        }

        // =========================================================================
        // 2. RENDER TABLE WITH PARENT-CHILD HIERARCHY
        // =========================================================================
        function renderMenuTable(menus) {
            if (menus.length === 0) {
                $('#menuTableBody').html(`<tr><td colspan="7" class="text-center py-4 text-muted">No menus found. Click 'Add New Menu' to create one.</td></tr>`);
                return;
            }

            let html = '';
            const parents = menus.filter(m => m.parentId === null || m.parentId === 0);

            parents.forEach(parent => {
                // Render Parent Row
                html += generateRowHtml(parent, false);

                // Render Submenus under this Parent
                const submenus = menus.filter(m => m.parentId === parent.id);
                submenus.forEach(sub => {
                    html += generateRowHtml(sub, true, parent.menuName);
                });
            });

            $('#menuTableBody').html(html);
        }

        function generateRowHtml(menu, isSubmenu, parentName = '') {
            let badgeType = isSubmenu
                ? `<span class="badge bg-light text-secondary border fw-normal"><i class="bi bi-arrow-return-right me-1"></i> Submenu of <b>${parentName}</b></span>`
                : `<span class="badge bg-primary-subtle text-primary fw-semibold"><i class="bi bi-folder-fill me-1"></i> Parent Module</span>`;

            let statusBadge = menu.isActive
                ? `<span class="badge bg-success-subtle text-success px-3 py-1 rounded-pill small">Active</span>`
                : `<span class="badge bg-danger-subtle text-danger px-3 py-1 rounded-pill small">Inactive</span>`;

            let routeText = menu.routeUrl || `/${menu.controller || '-'}/${menu.action || '-'}`;
            let indentStyle = isSubmenu ? 'ps-5' : 'fw-bold text-dark';

            return `
                        <tr>
                            <td class="fw-bold text-muted">${menu.displayOrder}</td>
                            <td class="${indentStyle}">
                                <i class="${menu.icon || 'bi bi-folder'} text-success me-2 fs-6"></i>
                                <span>${menu.menuName}</span>
                            </td>
                            <td>${badgeType}</td>
                            <td><code class="text-secondary bg-light px-2 py-1 rounded small">${routeText}</code></td>
                            <td><i class="${menu.icon} fs-5 text-dark"></i></td>
                            <td>${statusBadge}</td>
                            <td class="text-end">
                                <button class="btn btn-sm btn-outline-primary rounded-pill px-3 me-1 shadow-none" onclick="openEditModal(${menu.id})">
                                    <i class="bi bi-pencil-square"></i> Edit
                                </button>
                                <button class="btn btn-sm btn-outline-danger rounded-pill px-3 shadow-none" onclick="deleteMenu(${menu.id}, '${menu.menuName}')">
                                    <i class="bi bi-trash"></i>
                                </button>
                            </td>
                        </tr>
                    `;
        }

        // =========================================================================
        // 3. POPULATE PARENT DROPDOWN
        // =========================================================================
        function populateParentDropdown(menus) {
            const parents = menus.filter(m => m.parentId === null || m.parentId === 0);
            let options = `<option value="0">-- None (This is a Parent Menu) --</option>`;

            parents.forEach(p => {
                options += `<option value="${p.id}">${p.menuName}</option>`;
            });

            $('#parentId').html(options);
        }

        // =========================================================================
        // 4. OPEN ADD MODAL
        // =========================================================================
        function openAddModal() {
            $('#menuForm')[0].reset();
            $('#menuId').val('0');
            $('#parentId').val('0').prop('disabled', false);
            $('#iconPreview').html('<i class="bi bi-folder"></i>');
            $('#modalTitleText').text('Add New Menu');
            $('#menuModal').modal('show');
        }

        // =========================================================================
        // 5. OPEN EDIT MODAL (FETCH SINGLE)
        // =========================================================================
        function openEditModal(id) {
            $.ajax({
                url: `/api/menu/${id}`,
                type: 'GET',
                success: function (response) {
                    if (response.success) {
                        const m = response.data;
                        $('#menuId').val(m.id);
                        $('#parentId').val(m.parentId || 0);

                        // Prevent setting itself as parent
                        $('#parentId option').prop('disabled', false);
                        $(`#parentId option[value='${m.id}']`).prop('disabled', true);

                        $('#menuName').val(m.menuName);
                        $('#controllerName').val(m.controller);
                        $('#actionName').val(m.action);
                        $('#routeUrl').val(m.routeUrl);
                        $('#menuIcon').val(m.icon || 'bi bi-folder');
                        $('#iconPreview').html(`<i class="${m.icon || 'bi bi-folder'}"></i>`);
                        $('#displayOrder').val(m.displayOrder);
                        $('#isActive').prop('checked', m.isActive);
                        $('#isVisible').prop('checked', m.isVisible);

                        $('#modalTitleText').text('Edit Menu: ' + m.menuName);
                        $('#menuModal').modal('show');
                    }
                },
                error: function () {
                    showToast('Failed to fetch menu details.', 'danger');
                }
            });
        }

        // =========================================================================
        // 6. SAVE OR UPDATE MENU VIA AJAX
        // =========================================================================
        function saveMenu() {
            const $btn = $('#btnSaveMenu');
            const originalHtml = $btn.html();
            $btn.prop('disabled', true).html(`<span class="spinner-border spinner-border-sm me-2"></span>Saving...`);

            const payload = {
                id: parseInt($('#menuId').val()),
                parentId: parseInt($('#parentId').val()) === 0 ? null : parseInt($('#parentId').val()),
                menuName: $('#menuName').val().trim(),
                controller: $('#controllerName').val().trim() || null,
                action: $('#actionName').val().trim() || null,
                routeUrl: $('#routeUrl').val().trim() || null,
                icon: $('#menuIcon').val().trim() || 'bi bi-folder',
                displayOrder: parseInt($('#displayOrder').val()) || 1,
                isActive: $('#isActive').is(':checked'),
                isVisible: $('#isVisible').is(':checked'),
                portalType: 1
            };

            if (!payload.menuName) {
                showToast('Please enter a Menu Name.', 'danger');
                $btn.prop('disabled', false).html(originalHtml);
                return;
            }

            $.ajax({
                url: '/api/menu/save',
                type: 'POST',
                contentType: 'application/json',
                data: JSON.stringify(payload),
                success: function (response) {
                    $btn.prop('disabled', false).html(originalHtml);
                    if (response.success) {
                        $('#menuModal').modal('hide');
                        showToast(response.message, 'success');
                        loadMenus(); // Reload Table without refreshing page!
                    }
                },
                error: function (xhr) {
                    $btn.prop('disabled', false).html(originalHtml);
                    showToast(xhr.responseJSON?.message || 'Error saving menu.', 'danger');
                }
            });
        }

        // =========================================================================
        // 7. DELETE MENU VIA AJAX WITH SWEETALERT CONFIRMATION
        // =========================================================================
        function deleteMenu(id, name) {
            Swal.fire({
                title: 'Are you sure?',
                text: `You want to delete "${name}"? This action cannot be undone.`,
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#dc3545',
                cancelButtonColor: '#6c757d',
                confirmButtonText: 'Yes, delete it!'
            }).then((result) => {
                if (result.isConfirmed) {
                    $.ajax({
                        url: `/api/menu/delete/${id}`,
                        type: 'DELETE',
                        success: function (response) {
                            if (response.success) {
                                showToast(response.message, 'success');
                                loadMenus(); // Reload Table instantly
                            }
                        },
                        error: function (xhr) {
                            showToast(xhr.responseJSON?.message || 'Failed to delete menu.', 'danger');
                        }
                    });
                }
            });
        }

        // Universal Toast Helper
        function showToast(message, type = 'success') {
            $('#liveToast').removeClass('bg-success bg-danger').addClass(`bg-${type}`);
            let icon = type === 'success' ? 'bi-check-circle-fill' : 'bi-exclamation-triangle-fill';
            $('#toastMessage').html(`<i class="bi ${icon} me-2"></i> ${message}`);
            const toast = new bootstrap.Toast(document.getElementById('liveToast'));
            toast.show();
        }
    </script>
}