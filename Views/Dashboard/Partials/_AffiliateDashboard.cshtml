<!-- PREMIUM CARD STYLES & GRADIENTS -->
<style>
    .premium-card {
        border-radius: 14px;
        border: none;
        color: #fff;
        padding: 20px;
        position: relative;
        overflow: hidden;
        transition: transform 0.3s ease, box-shadow 0.3s ease;
        height: 100%;
    }

        .premium-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 12px 25px rgba(0,0,0,0.15);
        }

        .premium-card .icon-circle {
            width: 55px;
            height: 55px;
            background-color: #fff;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.6rem;
            flex-shrink: 0;
        }

        .premium-card .stat-label {
            font-size: 1.1rem;
            font-weight: 700;
            line-height: 1.2;
        }

        .premium-card .divider {
            border-top: 1px solid rgba(255, 255, 255, 0.25);
            margin: 12px 0 10px 0;
        }

        .premium-card .btn-more {
            background-color: #fff;
            border-radius: 50px;
            padding: 5px 18px;
            font-weight: 700;
            font-size: 0.8rem;
            text-decoration: none;
            display: inline-block;
            transition: background-color 0.2s;
        }

    .cursor-pointer {
        cursor: pointer;
    }

    .bg-blue {
        background: linear-gradient(135deg, #00c6ff, #0072ff);
    }

        .bg-blue .icon-circle, .bg-blue .btn-more {
            color: #0072ff;
        }

    .bg-green {
        background: linear-gradient(135deg, #28c76f, #059669);
    }

        .bg-green .icon-circle, .bg-green .btn-more {
            color: #059669;
        }

    .bg-orange {
        background: linear-gradient(135deg, #ff9f43, #f57c00);
    }

        .bg-orange .icon-circle, .bg-orange .btn-more {
            color: #f57c00;
        }

    .bg-teal {
        background: linear-gradient(135deg, #00cfe8, #009688);
    }

        .bg-teal .icon-circle, .bg-teal .btn-more {
            color: #009688;
        }

    .bg-purple {
        background: linear-gradient(135deg, #9722ff, #6610f2);
    }

        .bg-purple .icon-circle, .bg-purple .btn-more {
            color: #6610f2;
        }

    .bg-pink {
        background: linear-gradient(135deg, #ff7eb3, #e83e8c);
    }

        .bg-pink .icon-circle, .bg-pink .btn-more {
            color: #e83e8c;
        }

    .bg-yellow {
        background: linear-gradient(135deg, #f6d365, #fd7e14);
    }

        .bg-yellow .icon-circle, .bg-yellow .btn-more {
            color: #fd7e14;
        }

    .bg-cyan {
        background: linear-gradient(135deg, #4facfe, #00f2fe);
    }

        .bg-cyan .icon-circle, .bg-cyan .btn-more {
            color: #008b8b;
        }
</style>

<script>
    document.addEventListener("DOMContentLoaded", function() {
        const hours = new Date().getHours();
        let greeting = "Good Evening";
        if (hours < 12) greeting = "Good Morning";
        else if (hours < 17) greeting = "Good Afternoon";

        const greetingEl = document.getElementById("dynamicGreeting");
        if (greetingEl) {
            greetingEl.innerHTML = `<b>${greeting}!</b> Welcome back! Track your Workspace real-time.`;
        }

        function getAuthToken() {
            return localStorage.getItem("jwt_token") || sessionStorage.getItem("jwt_token") || "";
        }

        window.apiRequest = async function(url, options = {}) {
            const token = getAuthToken();
            const headers = { "Authorization": "Bearer " + token };
            if (!(options.body instanceof FormData)) {
                headers["Content-Type"] = "application/json";
            }
            const response = await fetch(url, { ...options, headers: { ...headers, ...(options.headers || {}) } });
            let data = null;
            try { data = await response.json(); } catch { data = null; }
            if (!response.ok) { throw { status: response.status, data: data }; }
            return data;
        };

        window.checkHubVisibility = async function() {
            try {
                const res = await apiRequest("/api/affiliate-attendance/status");
                const hubGrid = document.getElementById("affiliate-hub-grid");
                const hubWarning = document.getElementById("affiliate-hub-warning");
                const backBtn = document.getElementById('btnBackToAffDashboard');

                if (res.success && res.isCheckedIn === true) {
                    if (hubGrid) hubGrid.style.display = "flex";
                    if (hubWarning) hubWarning.style.display = "none";
                } else {
                    if (hubGrid) hubGrid.style.display = "none";
                    if (hubWarning) hubWarning.style.display = "block";
                    if (backBtn) backBtn.classList.add('d-none');
                }
            } catch (e) {
                console.error("Hub visibility error:", e);
                const hubGrid = document.getElementById("affiliate-hub-grid");
                const hubWarning = document.getElementById("affiliate-hub-warning");
                if (hubGrid) hubGrid.style.display = "none";
                if (hubWarning) hubWarning.style.display = "block";
            }
        };

        checkHubVisibility();

        setInterval(checkHubVisibility, 10000);

        const cards = document.querySelectorAll('.affiliate-card, .load-module-btn');
        const grid = document.getElementById('affiliate-hub-grid');
        const container = document.getElementById('affiliate-dynamic-container');
        const backBtn = document.getElementById('btnBackToAffDashboard');

        cards.forEach(card => {
            card.addEventListener('click', function() {
                let moduleName = this.getAttribute('data-module');
                $(grid).fadeOut(200, function() {
                    backBtn.classList.remove('d-none');
                    $.get('/Affiliate/LoadModule/' + moduleName, function(htmlResponse) {
                        $(container).html(htmlResponse).hide().fadeIn(300);
                    }).fail(function() {
                        $(container).html(`<div class="card shadow-sm rounded-4 bg-white p-4 text-center text-muted border" style="border: 1px solid #d9dfe5 !important;"><h4>${moduleName.toUpperCase()} Module</h4><p>Module content under construction.</p></div>`).hide().fadeIn(300);
                    });
                });
            });
        });

        if (backBtn) {
            backBtn.addEventListener('click', function() {
                $(container).fadeOut(200, function() {
                    $(this).html('');
                    backBtn.classList.add('d-none');
                    $(grid).fadeIn(300);
                });
            });
        }

        const svCards = document.querySelectorAll('.single-view-card');
        const svGrid = document.getElementById('single-view-grid');
        const svContainer = document.getElementById('single-view-dynamic-container');
        const svBackBtn = document.getElementById('btnBackToSingleView');

        svCards.forEach(card => {
            card.addEventListener('click', function() {
                let moduleName = this.getAttribute('data-module');
                $(svGrid).fadeOut(200, function() {
                    svBackBtn.classList.remove('d-none');
                    $.get('/Affiliate/LoadModule/' + moduleName, function(htmlResponse) {
                        $(svContainer).html(htmlResponse).hide().fadeIn(300);
                    }).fail(function() {
                        $(svContainer).html(`<div class="card shadow-sm rounded-4 bg-white p-4 text-center text-muted border" style="border: 1px solid #d9dfe5 !important;"><h4>${moduleName.toUpperCase()} View</h4><p>Module content under construction.</p></div>`).hide().fadeIn(300);
                    });
                });
            });
        });

        if (svBackBtn) {
            svBackBtn.addEventListener('click', function() {
                $(svContainer).fadeOut(200, function() {
                    $(this).html('');
                    svBackBtn.classList.add('d-none');
                    $(svGrid).fadeIn(300);
                });
            });
        }
    });
</script>