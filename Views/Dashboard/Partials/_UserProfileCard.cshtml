    @using Microsoft.AspNetCore.Http

    @{
        // Time-based greeting logic
        var currentHour = DateTime.Now.Hour;
        string greeting = currentHour < 12
            ? "Good Morning"
            : currentHour < 17
                ? "Good Afternoon"
                : "Good Evening";
    }

    <div class="row mb-4">
        <div class="col-12">
            <div class="card border-0 shadow-sm rounded-4 bg-white p-4 position-relative overflow-hidden" style="border: 1px solid rgba(0, 0, 0, 0.06) !important;">
                <div class="row align-items-center g-4">

                    <!-- Left Side: User Profile Summary -->
                    <div class="col-lg-4 border-end-lg border-light">
                        <div class="d-flex align-items-center gap-3">
                            <div id="userAvatar" class="bg-success-subtle text-success rounded-circle d-flex align-items-center justify-content-center fw-bold fs-3 flex-shrink-0 shadow-sm" style="width: 65px; height: 65px;">
                                U
                            </div>
                            <div class="overflow-hidden">
                                <h5 id="userNameDisplay" class="fw-bold text-dark m-0 text-truncate">Loading...</h5>
                                <span id="userRoleBadge" class="badge bg-success-subtle text-success mt-1 px-2.5 py-1 rounded-pill small fw-semibold">Role: User</span>
                            </div>
                        </div>

                        <div class="mt-3 pt-3 border-top border-light d-flex flex-column gap-2 small text-muted">
                            <div class="text-truncate">
                                <i class="bi bi-envelope-at me-2 text-success"></i> <strong>Email:</strong> <span id="userEmailDisplay">N/A</span>
                            </div>
                            <div class="text-truncate">
                                <i class="bi bi-phone me-2 text-success"></i> <strong>Mobile:</strong> <span id="userMobileDisplay">N/A</span>
                            </div>
                           
                        </div>
                    </div>

                    <!-- Right Side: Time-based Greeting & Welcome Banner -->
                    <div class="col-lg-8">
                        <div class="p-4 rounded-4 text-white position-relative overflow-hidden" style="background: linear-gradient(135deg, #198754 0%, #20c997 100%);">
                            <!-- Decorative Watermark Icon -->
                            <div class="position-absolute top-50 end-0 translate-middle-y opacity-10 pe-none me-3" style="font-size: 6rem;">
                                <i class="bi bi-sun-fill"></i>
                            </div>

                            <div class="position-relative z-1">
                                <div class="d-flex align-items-center gap-2 mb-2">
                                    <span class="badge bg-white text-success px-3 py-1 rounded-pill fw-semibold small shadow-sm">
                                        <i class="bi bi-calendar-event me-1"></i> @DateTime.Now.ToString("dd MMM yyyy")
                                    </span>
                                    <span id="portalBadge" class="badge bg-light text-dark px-3 py-1 rounded-pill fw-semibold small shadow-sm">
                                        <i class="bi bi-person-badge me-1"></i> Portal
                                    </span>
                                </div>

                                <h3 class="fw-bold mb-1 text-white">
                                    <span id="greetingText">@greeting</span>, <span id="userGreetingName">User</span>! 👋
                                </h3>

                                <p class="mb-0 text-white-50 small" style="max-width: 90%;">
                                    Welcome back to your dashboard. Manage your modules, track evaluations, and handle activities smoothly from here.
                                </p>
                            </div>
                        </div>
                    </div>

                </div>
            </div>
        </div>
    </div>

    <script>
        document.addEventListener("DOMContentLoaded", function() {
            const userSessionData = localStorage.getItem('user_session') || sessionStorage.getItem('user_session');
            const userRoleData = localStorage.getItem('user_role') || sessionStorage.getItem('user_role') || 'User';

            if (userSessionData) {
                try {
                    const user = JSON.parse(userSessionData);

                    // Aapke database/API wale fields ke hisaab se mapping (lowercase & camelCase dono handle kiye hain)
                    const firstName = user.firstname || user.firstName || user.FirstName || 'Valued';
                    const lastName = user.lastname || user.lastName || user.LastName || 'Partner';
                    const fullName = `${firstName} ${lastName}`;
                    const email = user.emailid || user.email || user.Email || 'N/A';
                    const mobile = user.mobileno || user.mobileNo || user.MobileNo || 'N/A';

                    // Role formatting (Jaise 'Teacher_Portal' ko 'Teacher' banana)
                    let displayRole = userRoleData.includes('_') ? userRoleData.split('_').pop() : userRoleData;

                    // DOM Elements update karna
                    document.getElementById('userNameDisplay').innerText = fullName;
                    document.getElementById('userGreetingName').innerText = firstName;
                    document.getElementById('userEmailDisplay').innerText = email;

                    const mobileEl = document.getElementById('userMobileDisplay');
                    if (mobileEl) mobileEl.innerText = mobile;

                    document.getElementById('userAvatar').innerText = firstName.charAt(0).toUpperCase();
                    document.getElementById('userRoleBadge').innerText = `Role: ${displayRole}`;
                    document.getElementById('portalBadge').innerHTML = `<i class="bi bi-person-badge me-1"></i> ${displayRole} Portal`;

                } catch (e) {
                    console.error("Error parsing user session data:", e);
                }
            }
        });
    </script>