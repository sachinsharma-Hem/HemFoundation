<!-- =============================================================
     DETAILS MODAL (server-side pagination, search, export)
     ============================================================= -->
<div class="modal fade" id="dashboardDetailsModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-fullscreen">
        <div class="modal-content rounded-4 border-0 shadow-lg">

            <div class="modal-header border-bottom px-4 py-3 flex-wrap gap-3">
                <div>
                    <h5 class="fw-bold text-dark mb-1" id="modalTitle">Records List</h5>
                    <small class="text-muted" id="modalSubtitle">Loading records...</small>
                </div>

                <div class="d-flex align-items-center gap-3 ms-auto flex-wrap">
                    <div class="input-group input-group-sm" style="width: 250px;">
                        <span class="input-group-text bg-light border-end-0"><i class="bi bi-search text-muted"></i></span>
                        <input type="text" id="modalTableSearch" class="form-control border-start-0 shadow-none" placeholder="Search database...">
                        <button class="btn btn-outline-secondary border-start-0" type="button" id="btnClearSearch" aria-label="Clear search">
                            <i class="bi bi-x"></i>
                        </button>
                    </div>

                    <select id="modalPageSize" class="form-select form-select-sm shadow-none" style="width: 110px;" aria-label="Rows per page">
                        <option value="25">25 rows</option>
                        <option value="50">50 rows</option>
                        <option value="100" selected>100 rows</option>
                        <option value="250">250 rows</option>
                        <option value="500">500 rows</option>
                        <option value="1000">1000 rows</option>
                        <option value="10000">10000 rows</option>
                    </select>

                    <button type="button" class="btn btn-sm btn-success shadow-sm" id="btnExportModalData">
                        <i class="bi bi-file-earmark-excel me-1"></i> Export Excel
                    </button>
                </div>

                <button type="button" class="btn-close shadow-none" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>

            <div class="modal-body p-4">
                <div class="table-responsive border rounded-3 modal-table-wrapper">
                    <table class="table table-hover align-middle mb-0" id="modalTable">
                        <thead class="table-light"></thead>
                        <tbody></tbody>
                    </table>
                </div>
            </div>

            <div class="modal-footer border-top px-4 py-3 justify-content-between align-items-center bg-light rounded-bottom-4">
                <div class="text-muted small" id="paginationInfo">Showing 0 to 0 of 0 entries</div>
                <nav aria-label="Modal Pagination">
                    <ul class="pagination pagination-sm mb-0" id="modalPagination"></ul>
                </nav>
            </div>

        </div>
    </div>
</div>


<!-- =============================================================
     ASSOCIATED SCHOOLS DETAILS MODAL
     (not wired to a card right now; open with openAssociatedSchoolsModal())
     ============================================================= -->
<div class="modal fade" id="associatedSchoolsModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-fullscreen-sm-down" style="max-width: 98vw !important;">
        <div class="modal-content rounded-4 border-0 shadow-lg bg-white" style="border-top: 5px solid #198754 !important;">

            <div class="modal-header border-bottom px-4 py-3 align-items-center">
                <div class="d-flex align-items-center">
                    <div class="bg-success-subtle text-success p-3 rounded-4 me-3 fs-4 d-flex align-items-center justify-content-center"
                         style="width: 52px; height: 52px;">
                        <i class="bi bi-building-check"></i>
                    </div>
                    <div>
                        <h4 class="fw-bold text-dark mb-1">Associated Schools Directory</h4>
                        <p class="text-muted small mb-0">Complete details of schools currently mapped under your referral network.</p>
                    </div>
                </div>
                <button type="button" class="btn-close shadow-none fs-5" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>

            <div class="modal-body p-3 overflow-hidden">

                <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
                    <div class="d-flex align-items-center gap-2">
                        <span class="badge bg-success-subtle text-success px-3 py-2 rounded-pill">
                            <i class="bi bi-buildings me-1"></i> Associated Schools
                        </span>
                        <span class="badge bg-light text-dark border px-3 py-2 rounded-pill">
                            Total: <strong id="associatedSchoolsTotalCount">0</strong>
                        </span>
                    </div>

                    <div class="d-flex align-items-center gap-2">
                        <small class="text-muted d-none d-lg-inline">
                            <i class="bi bi-arrows-expand me-1"></i>
                            Use the horizontal scrollbar below to view all columns
                        </small>
                        <button type="button" id="btnExportAssociatedSchools"
                                class="btn btn-success btn-sm rounded-pill px-3 shadow-sm">
                            <i class="bi bi-file-earmark-excel me-1"></i> Export Excel
                        </button>
                    </div>
                </div>

                <div class="associated-schools-table-wrapper">
                    <table class="table table-hover table-bordered align-middle mb-0 bg-white" id="associatedSchoolsDetailsTable">
                        <thead class="table-light text-uppercase small">
                            <tr>
                                <th>School ID</th>
                                <th>Institute Type</th>
                                <th>School Name</th>
                                <th>Institute Active</th>
                                <th>Referral Code</th>
                                <th>First Name</th>
                                <th>Last Name</th>
                                <th>Mobile No.</th>
                                <th>Email ID</th>
                                <th>Address</th>
                                <th>Address 2</th>
                                <th>City</th>
                                <th>Pincode</th>
                                <th>User Active</th>
                                <th>Created Date</th>
                                <th>Modified Date</th>
                                <th class="text-center">Associated Students</th>
                                <th class="text-center">Active Students</th>
                                <th class="text-center">Total Teachers</th>
                                <th class="text-center">Active Teachers</th>
                            </tr>
                        </thead>
                        <tbody id="associatedSchoolsTableBody">
                            <tr>
                                <td colspan="20" class="text-center py-5">
                                    <div class="spinner-border text-success spinner-border-sm me-2" role="status"></div>
                                    <span class="text-muted fw-semibold">Loading associated schools...</span>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>

            </div>

            <div class="modal-footer border-top px-4 py-3 d-flex justify-content-between align-items-center">
                <div class="text-muted small">
                    <i class="bi bi-info-circle me-1"></i>
                    Showing complete school information from active system records.
                </div>
                <button type="button" class="px-4 btn btn-secondary btn-sm rounded-pill shadow-none" data-bs-dismiss="modal">
                    Close
                </button>
            </div>

        </div>
    </div>
</div>


<!-- =============================================================
     GLOBAL LOADER
     ============================================================= -->
<div id="globalLoader" class="global-loader-overlay" style="display: none;">
    <div class="text-center">
        <div class="spinner-border text-primary shadow-lg" style="width: 3.5rem; height: 3.5rem;" role="status">
            <span class="visually-hidden">Loading...</span>
        </div>
        <div class="fw-bold text-dark mt-3 fs-5" id="globalLoaderText">Generating Report, Please Wait...</div>
    </div>
</div>


<!-- =============================================================
     SCRIPT (single block, jQuery-safe)
     ============================================================= -->
<script>
(function () {
    "use strict";

    /* ---------- jQuery-safe bootstrap ----------
       Partial ke andar script jQuery se pehle chal sakti hai (jQuery _Layout
       me body ke end me load hota hai), isliye jQuery aane tak wait karte hain. */
    function whenReady(fn) {
        function waitForJq(tries) {
            if (window.jQuery) { window.jQuery(fn); return; }
            if (tries <= 0) { console.error("jQuery not loaded on Dashboard."); return; }
            setTimeout(function () { waitForJq(tries - 1); }, 50);
        }
        if (document.readyState === "loading") {
            document.addEventListener("DOMContentLoaded", function () { waitForJq(100); });
        } else {
            waitForJq(100);
        }
    }

    window.goToPlanPage = function(status) {
        let fromDate = document.getElementById("activityFromDate")?.value || "";
        let toDate = document.getElementById("activityToDate")?.value || "";

        let url = '/VolunteerPlan/plan?';
        let params = new URLSearchParams();

        if (status) params.append('status', status);
        if (fromDate) params.append('fromDate', fromDate);
        if (toDate) params.append('toDate', toDate);

        window.location.href = url + params.toString();
    };
    /* ---------- Config / helpers ---------- */
    const AFFILIATE_ID = '@affiliateId';
    const XLSX_MIME = "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet";

    function getAuthToken() {
        return localStorage.getItem("jwt_token") || sessionStorage.getItem("jwt_token") || "";
    }

    function escapeHtml(value) {
        if (value === null || value === undefined) return "";
        return String(value)
            .replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;")
            .replace(/"/g, "&quot;").replace(/'/g, "&#39;");
    }

    function formatColumnName(key) {
        if (!key) return "";
        const s = String(key).replace(/([a-z])([A-Z])/g, "$1 $2").replace(/[_-]/g, " ");
        return s.charAt(0).toUpperCase() + s.slice(1);
    }

    function formatDate(value) {
        if (!value) return "-";
        const d = new Date(value);
        if (isNaN(d.getTime())) return escapeHtml(value);
        return d.toLocaleDateString("en-IN", { day: "2-digit", month: "short", year: "numeric" });
    }

    function getStatusBadge(value) {
        const active = value === true || value === 1 || value === "1" ||
                       value === "true" || value === "True";
        return active
            ? '<span class="badge bg-success-subtle text-success school-status-badge">Active</span>'
            : '<span class="badge bg-secondary-subtle text-secondary school-status-badge">Inactive</span>';
    }

    function pick(obj, keys, fallback) {
        for (const k of keys) {
            if (obj[k] !== undefined && obj[k] !== null) return obj[k];
        }
        return fallback;
    }

    function showGlobalLoader(msg) {
        document.getElementById("globalLoaderText").textContent = msg || "Please Wait...";
        document.getElementById("globalLoader").style.display = "flex";
    }
    function hideGlobalLoader() {
        document.getElementById("globalLoader").style.display = "none";
    }
    window.showGlobalLoader = showGlobalLoader;
    window.hideGlobalLoader = hideGlobalLoader;

    function authHeaders() {
        const t = getAuthToken();
        const h = { "Accept": "application/json" };
        if (t) h["Authorization"] = "Bearer " + t;
        return h;
    }

    function setText(id, value) {
        const el = document.getElementById(id);
        if (el) el.textContent = (value === null || value === undefined) ? 0 : value;
    }

    /* ---------- Reusable Excel download (fetch + blob) ---------- */
    async function downloadExcel(opts) {
        const token = getAuthToken();
        if (!token) { alert("Login session expired. Please login again."); return; }

        const btn = opts.button;
        const originalHtml = btn ? btn.innerHTML : "";

        try {
            showGlobalLoader(opts.loaderText || "Generating Report, Please Wait...");
            if (btn) {
                btn.disabled = true;
                btn.innerHTML = '<span class="spinner-border spinner-border-sm me-1" role="status"></span> Generating...';
            }

            const response = await fetch(opts.url, {
                method: opts.method || "GET",
                headers: Object.assign(
                    { "Authorization": "Bearer " + token },
                    opts.body ? { "Content-Type": "application/json; charset=utf-8" } : {}
                ),
                body: opts.body ? JSON.stringify(opts.body) : undefined,
                credentials: "same-origin",
                cache: "no-store"
            });

            if (!response.ok) throw new Error("HTTP " + response.status);

            const blob = new Blob([await response.arrayBuffer()], { type: XLSX_MIME });

            let filename = opts.filename || "Report.xlsx";
            const cd = response.headers.get("Content-Disposition");
            if (cd) {
                const m = cd.match(/filename\*?=(?:UTF-8''|")?([^;"']+)/i);
                if (m && m[1]) {
                    try { filename = decodeURIComponent(m[1].replace(/"/g, "")); } catch (e) { /* keep default */ }
                }
            }

            const url = URL.createObjectURL(blob);
            const a = document.createElement("a");
            a.href = url;
            a.download = filename;
            document.body.appendChild(a);
            a.click();
            setTimeout(function () { URL.revokeObjectURL(url); a.remove(); }, 100);
        } catch (err) {
            console.error((opts.loaderText || "Export") + " error:", err);
            alert(opts.errorText || "Error downloading report.");
        } finally {
            hideGlobalLoader();
            if (btn) { btn.disabled = false; btn.innerHTML = originalHtml; }
        }
    }

    function guardAffiliate() {
        if (!AFFILIATE_ID || AFFILIATE_ID === "0") {
            alert("Logged-in user ID not found.");
            return false;
        }
        return true;
    }

    /* ---------- Report exports ---------- */
    function exportActiveStudentsReport(filterVal, title, btn) {
        if (!guardAffiliate()) return;
        filterVal = filterVal || "A";
        downloadExcel({
            url: "/api/Report/affiliate-active-students?AffiliateID=" +
                 encodeURIComponent(AFFILIATE_ID) + "&filter=" + encodeURIComponent(filterVal),
            filename: filterVal === "F" ? "FocusedActiveStudentsReport.xlsx" : "ActiveStudentsReport.xlsx",
            loaderText: "Generating " + (title || "Active Students") + " Report...",
            errorText: "Error downloading active students report.",
            button: btn
        });
    }

    function exportCreativityReport(filterVal, title, btn) {
        if (!guardAffiliate()) return;
        downloadExcel({
            url: "/api/Report/creativity-combined-report?AffiliateID=" +
                 encodeURIComponent(AFFILIATE_ID) + "&filter=" + encodeURIComponent(filterVal),
            filename: "AffiliateSchoolCreativityCombinedReport_" + (filterVal === "F" ? "Focused" : "All") + ".xlsx",
            loaderText: "Generating " + title + " Report...",
            button: btn
        });
    }

    function exportPblReport(endpoint, filterVal, title, btn) {
        if (!guardAffiliate()) return;
        downloadExcel({
            url: endpoint + "?AffiliateID=" + encodeURIComponent(AFFILIATE_ID) +
                 "&filter=" + encodeURIComponent(filterVal),
            filename: title.replace(/\s+/g, "") + "_" + (filterVal === "F" ? "Focused" : "All") + ".xlsx",
            loaderText: "Generating " + title + " Report...",
            button: btn
        });
    }

    window.exportSingleInstituteReport = function (instituteId, btn) {
        if (!instituteId || Number(instituteId) <= 0) { alert("Invalid Institute ID."); return; }
        downloadExcel({
            url: "/api/Report/export-institute-summary",
            method: "POST",
            body: { instituteIDstr: String(instituteId) },
            filename: "Institute_" + instituteId + "_PerformanceReport.xlsx",
            loaderText: "Generating Institute Performance Report...",
            errorText: "Error downloading institute report.",
            button: btn
        });
    };

    function exportAssociatedSchoolsExcel(btn) {
        downloadExcel({
            url: "/api/affiliate-dashboard/export-associated-schools",
            filename: "AssociatedSchoolsReport.xlsx",
            loaderText: "Generating Associated Schools Report...",
            errorText: "Error downloading associated schools report.",
            button: btn
        });
    }

    /* ---------- Summary counts ---------- */
    async function loadSummaryCounts() {
        try {
            const response = await fetch("/api/volunteer/dashboard-summary-counts", {
                method: "GET", headers: authHeaders(), credentials: "same-origin", cache: "no-store"
            });
            if (!response.ok) throw new Error("HTTP " + response.status);

            const json = await response.json();
            if (!json || !json.success || !json.data) return;
            const d = json.data;

            setText("lblTotalAssociatedSchool", d.totalinstitute);
            setText("lblTotalStudentCount", d.totalStudents);
            setText("lblActiveStudentCount", d.activeStudents);
            setText("lblTotalTeacherCount", d.totalTeachers);
            setText("lblActiveTeacherCount", d.activeTeachers);
            setText("lblTotalSelProjectCount", d.totalSelProjects);
            setText("lblFamilyProjectCount", d.familyProjects);
            setText("lblIndividualProjectCount", d.individualProjects);
            setText("lblGroupPblCount", d.groupPbl);
        } catch (error) {
            console.error("Failed to load dashboard summary counts:", error);
        }
    }

    /* ---------- Activity counts ---------- */
    const ACTIVITY_IDS = {
        lblVisitPlanCount: "visitPlan",
        lblVisitedCount: "visited",
        lblVisitPendingCount: "visitPending",
        lblActivityUpdatedCount: "activityUpdated",
        lblActivityPendingCount: "activityPending"
    };

    function setActivityCounts(data) {
        data = data || {};
        Object.keys(ACTIVITY_IDS).forEach(function (id) {
            setText(id, data[ACTIVITY_IDS[id]]);
        });
    }

    function showActivityLoading() {
        Object.keys(ACTIVITY_IDS).forEach(function (id) {
            const el = document.getElementById(id);
            if (el) el.innerHTML = '<span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>';
        });
    }

    async function loadVolunteerActivityCounts() {
        showActivityLoading();
        try {
            const params = new URLSearchParams();
            const from = document.getElementById("activityFromDate");
            const to = document.getElementById("activityToDate");
            if (from && from.value) params.append("fromDate", from.value);
            if (to && to.value) params.append("toDate", to.value);

            const qs = params.toString();
            const url = "/api/volunteer-plan/dashboard-counts" + (qs ? "?" + qs : "");

            const response = await fetch(url, {
                method: "GET", headers: authHeaders(), credentials: "same-origin", cache: "no-store"
            });
            if (!response.ok) throw new Error("Dashboard API returned " + response.status);

            const result = await response.json();
            if (!result || !result.success || !result.data) {
                setActivityCounts({});
                return;
            }
            setActivityCounts(result.data);
        } catch (error) {
            console.error("Unable to load volunteer activity counts:", error);
            setActivityCounts({});
        }
    }

    function initializeActivityDateFilter() {
        const from = document.getElementById("activityFromDate");
        const to = document.getElementById("activityToDate");
        const searchBtn = document.getElementById("btnActivityDateSearch");
        if (!searchBtn) return;

        searchBtn.addEventListener("click", function () {
            if (from && to && from.value && to.value && from.value > to.value) {
                alert("From date cannot be greater than To date.");
                return;
            }
            loadVolunteerActivityCounts();
        });

        [from, to].forEach(function (el) {
            if (!el) return;
            el.addEventListener("keydown", function (e) {
                if (e.key === "Enter") searchBtn.click();
            });
        });
    }

    /* ---------- Associated Schools modal ---------- */
    window.openAssociatedSchoolsModal = function () {
        const el = document.getElementById("associatedSchoolsModal");
        if (!el) return;
        bootstrap.Modal.getOrCreateInstance(el).show();
        loadAssociatedSchoolsDetails();
    };

    async function loadAssociatedSchoolsDetails() {
        const tbody = document.getElementById("associatedSchoolsTableBody");
        if (!tbody) return;

        tbody.innerHTML = '<tr><td colspan="20" class="text-center py-5">' +
            '<span class="spinner-border spinner-border-sm text-success me-2"></span>' +
            '<span class="text-muted fw-semibold">Loading associated schools...</span></td></tr>';

        try {
            const response = await fetch("/api/affiliate-dashboard/associated-schools-details", {
                method: "GET", headers: authHeaders(), credentials: "same-origin", cache: "no-store"
            });
            if (!response.ok) throw new Error("HTTP " + response.status);

            const result = await response.json();
            if (!result || result.success === false) {
                throw new Error((result && result.message) || "Unable to load associated schools.");
            }

            const data = Array.isArray(result.data) ? result.data : [];
            document.getElementById("associatedSchoolsTotalCount").textContent = data.length;

            if (data.length === 0) {
                tbody.innerHTML = '<tr><td colspan="20" class="text-center py-5 text-muted">' +
                    '<i class="bi bi-inbox fs-1 d-block mb-2"></i>' +
                    '<div class="fw-semibold">No associated schools found.</div></td></tr>';
                return;
            }

            const badge = function (cls, v) {
                return '<span class="badge bg-' + cls + '-subtle text-' + cls +
                       ' school-count-badge">' + (Number(v) || 0) + '</span>';
            };

            tbody.innerHTML = data.map(function (s) {
                const email = pick(s, ["emailID", "EmailID", "email", "Email"], "-");
                return "<tr>" +
                    "<td>" + escapeHtml(pick(s, ["schoolID", "SchoolID", "instituteID", "InstituteID", "instituteId"], "-")) + "</td>" +
                    "<td>" + escapeHtml(pick(s, ["instituteType", "InstituteType"], "-")) + "</td>" +
                    '<td><div class="fw-semibold">' + escapeHtml(pick(s, ["schoolName", "SchoolName", "name", "Name"], "-")) + "</div></td>" +
                    "<td>" + getStatusBadge(pick(s, ["instituteActive", "InstituteActive"])) + "</td>" +
                    "<td>" + escapeHtml(pick(s, ["referralCode", "ReferralCode"], "-")) + "</td>" +
                    "<td>" + escapeHtml(pick(s, ["firstName", "FirstName"], "-")) + "</td>" +
                    "<td>" + escapeHtml(pick(s, ["lastName", "LastName"], "-")) + "</td>" +
                    "<td>" + escapeHtml(pick(s, ["mobileNo", "MobileNo", "mobile", "Mobile"], "-")) + "</td>" +
                    '<td><span class="school-url" title="' + escapeHtml(email) + '">' + escapeHtml(email) + "</span></td>" +
                    "<td>" + escapeHtml(pick(s, ["address", "Address"], "-")) + "</td>" +
                    "<td>" + escapeHtml(pick(s, ["address2", "Address2"], "-")) + "</td>" +
                    "<td>" + escapeHtml(pick(s, ["city", "City"], "-")) + "</td>" +
                    "<td>" + escapeHtml(pick(s, ["pincode", "Pincode"], "-")) + "</td>" +
                    "<td>" + getStatusBadge(pick(s, ["userActive", "UserActive"])) + "</td>" +
                    "<td>" + formatDate(pick(s, ["createdDate", "CreatedDate"])) + "</td>" +
                    "<td>" + formatDate(pick(s, ["modifiedDate", "ModifiedDate"])) + "</td>" +
                    '<td class="text-center">' + badge("primary", pick(s, ["associatedStudents", "AssociatedStudents", "totalStudents", "TotalStudents"], 0)) + "</td>" +
                    '<td class="text-center">' + badge("success", pick(s, ["activeStudents", "ActiveStudents"], 0)) + "</td>" +
                    '<td class="text-center">' + badge("info", pick(s, ["totalTeachers", "TotalTeachers"], 0)) + "</td>" +
                    '<td class="text-center">' + badge("danger", pick(s, ["activeTeachers", "ActiveTeachers"], 0)) + "</td>" +
                    "</tr>";
            }).join("");
        } catch (error) {
            console.error("Associated schools details error:", error);
            document.getElementById("associatedSchoolsTotalCount").textContent = "0";
            tbody.innerHTML = '<tr><td colspan="20" class="text-center py-5 text-danger">' +
                '<i class="bi bi-exclamation-triangle fs-2 d-block mb-2"></i>' +
                '<div class="fw-semibold">Failed to load associated schools.</div>' +
                "<small>Please try again.</small></td></tr>";
        }
    }

    /* ---------- Paged details modal ---------- */
    let currentCategory = "";
    let currentType = "";
    let currentPage = 1;
    let totalPages = 1;
    let currentRows = [];
    let sortState = { key: null, asc: true };
    let searchTimeout = null;

    const TITLE_MAP = {
        "total-schools": "Associated Schools",
        "total-students": "Total Students",
        "active-students": "Active Students",
        "total-teachers": "Total Teachers",
        "active-teachers": "Active Teachers",
        "sel-projects": "Total SEL Projects",
        "family-projects": "Family Projects",
        "individual-projects": "Individual Projects",
        "group-pbl": "Group PBL"
    };

    function showModalLoader() {
        $("#modalTable thead").html("");
        $("#modalTable tbody").html(
            '<tr><td colspan="100%" class="text-center"><div class="modal-loader">' +
            '<div class="spinner-border text-primary" role="status"><span class="visually-hidden">Loading...</span></div>' +
            '<div class="text-muted small mt-3">Fetching records from server...</div></div></td></tr>'
        );
    }

    window.openDetailsModal = function (category, type) {
        if (!window.jQuery) { console.error("jQuery not loaded yet."); return; }

        currentCategory = category;
        currentType = type;
        currentPage = 1;
        sortState = { key: null, asc: true };
        $("#modalTableSearch").val("");

        const categoryTitle = category === "performance" ? "Performance Report" : "Focused Report";
        $("#modalTitle").text(categoryTitle + " - " + (TITLE_MAP[type] || "Details"));

        showModalLoader();
        bootstrap.Modal.getOrCreateInstance(document.getElementById("dashboardDetailsModal")).show();
        loadModalDataPaged();
    };

    function loadModalDataPaged() {
        const pageSize = parseInt($("#modalPageSize").val(), 10) || 100;
        const searchTerm = $("#modalTableSearch").val().trim();

        $.ajax({
            url: "/api/admin/overall-details-paged",
            type: "GET",
            data: {
                category: currentCategory,
                type: currentType,
                page: currentPage,
                pageSize: pageSize,
                search: searchTerm,
                affiliateid: AFFILIATE_ID
            },
            headers: { "Authorization": "Bearer " + getAuthToken() },
            success: function (res) {
                if (!res || !res.success || !res.data || res.data.length === 0) {
                    currentRows = [];
                    $("#modalTable thead").html("");
                    $("#modalTable tbody").html(
                        '<tr><td colspan="100%" class="text-center py-5"><div class="text-muted">' +
                        '<i class="bi bi-inbox fs-1 d-block mb-2"></i>' +
                        '<div class="fw-semibold">No records found</div>' +
                        "<small>No matching data available for your search criteria.</small></div></td></tr>"
                    );
                    $("#modalSubtitle").text("0 records");
                    $("#paginationInfo").text("Showing 0 entries");
                    $("#modalPagination").html("");
                    return;
                }

                totalPages = res.totalPages || 1;
                currentRows = res.data;
                renderTableHeaders(currentRows[0]);
                renderTableRows(currentRows);
                renderPagination(res.page, totalPages, res.totalRecords, pageSize);
            },
            error: function (xhr) {
                console.error("Paged API error:", xhr);
                $("#modalTable tbody").html(
                    '<tr><td colspan="100%" class="text-center py-4 text-danger">Failed to load records from server.</td></tr>'
                );
            }
        });
    }

    function renderTableHeaders(sampleRow) {
        const keys = Object.keys(sampleRow);
        let html = "<tr>";
        keys.forEach(function (key) {
            html += '<th class="sortable-th" style="cursor:pointer;" data-key="' + escapeHtml(key) + '">' +
                    escapeHtml(formatColumnName(key)) +
                    ' <i class="bi bi-arrow-down-up text-muted small ms-1"></i></th>';
        });
        if (currentType === "total-schools") html += "<th>Action</th>";
        html += "</tr>";
        $("#modalTable thead").html(html);
    }

    function renderTableRows(rows) {
        const keys = Object.keys(rows[0]);
        let html = "";

        rows.forEach(function (row) {
            html += "<tr>";
            keys.forEach(function (key) {
                let v = row[key];
                if (v === null || v === undefined || v === "") v = "-";
                html += "<td>" + escapeHtml(v) + "</td>";
            });

            if (currentType === "total-schools") {
                const instId = row.instituteId || row.InstituteID || row.id || row.ID || row.instituteID || 0;
                html += '<td><button type="button" class="btn btn-sm btn-outline-primary btn-export-institute" data-id="' +
                        escapeHtml(instId) + '"><i class="bi bi-file-earmark-excel me-1"></i> Export</button></td>';
            }
            html += "</tr>";
        });

        $("#modalTable tbody").html(html);
    }

    function sortModalRows(key) {
        if (!currentRows.length) return;
        sortState.asc = sortState.key === key ? !sortState.asc : true;
        sortState.key = key;

        const dir = sortState.asc ? 1 : -1;
        currentRows.sort(function (a, b) {
            const A = a[key], B = b[key];
            const nA = parseFloat(A), nB = parseFloat(B);
            if (!isNaN(nA) && !isNaN(nB) &&
                String(nA) === String(A).trim() && String(nB) === String(B).trim()) {
                return (nA - nB) * dir;
            }
            return String(A === null || A === undefined ? "" : A)
                .localeCompare(String(B === null || B === undefined ? "" : B)) * dir;
        });
        renderTableRows(currentRows);
    }

    function renderPagination(page, totalP, totalRec, pageSize) {
        const start = totalRec === 0 ? 0 : ((page - 1) * pageSize) + 1;
        const end = Math.min(page * pageSize, totalRec);

        $("#modalSubtitle").text(totalRec + " total records");
        $("#paginationInfo").text("Showing " + start + " to " + end + " of " + totalRec + " entries");

        const item = function (label, target, disabled, active) {
            return '<li class="page-item ' + (disabled ? "disabled" : "") + " " + (active ? "active" : "") + '">' +
                   '<a class="page-link" href="javascript:void(0)" data-page="' + target + '">' + label + "</a></li>";
        };

        let html = item("Prev", page - 1, page <= 1, false);

        const maxVisible = 5;
        let startPage = Math.max(1, page - Math.floor(maxVisible / 2));
        let endPage = Math.min(totalP, startPage + maxVisible - 1);
        startPage = Math.max(1, endPage - maxVisible + 1);

        for (let i = startPage; i <= endPage; i++) {
            html += item(i, i, false, i === page);
        }
        html += item("Next", page + 1, page >= totalP, false);

        $("#modalPagination").html(html);
    }

    function changePage(target) {
        if (target < 1 || target > totalPages) return;
        currentPage = target;
        showModalLoader();
        loadModalDataPaged();
    }

    /* ---------- Init ---------- */
    whenReady(function () {

        /* Summary + activity */
        loadSummaryCounts();
        initializeActivityDateFilter();
        loadVolunteerActivityCounts();

        /* Card export buttons */
        const bind = function (selector, handler) {
            $(selector).off("click.dashboard").on("click.dashboard", function (e) {
                e.preventDefault();
                e.stopPropagation();
                handler(this);
            });
        };

        bind("#btn_ExportAdminStudentsReport", function (b) { exportActiveStudentsReport("A", "Active Students", b); });
        bind("#btn_ExportPerfSelSubmissions",  function (b) { exportCreativityReport("A", "Performance SEL Submissions", b); });
        bind("#btnOpenGroupPbl",               function (b) { exportCreativityReport("A", "Performance Group Projects", b); });
        bind("#btn_ExportPerfFamilyPbl",       function (b) { exportPblReport("/api/Report/affiliate-individual-project", "A", "Performance Family PBL", b); });
        bind("#btn_ExportPerfIndividualPbl",   function (b) { exportPblReport("/api/Report/affiliate-teacher-individual-project", "A", "Performance Individual PBL", b); });
        bind("#btnExportAssociatedSchools",    function (b) { exportAssociatedSchoolsExcel(b); });

        /* Modal: sorting, pagination, per-institute export (delegated) */
        $("#modalTable thead").on("click", ".sortable-th", function () {
            sortModalRows($(this).data("key"));
        });

        $("#modalPagination").on("click", "a.page-link", function (e) {
            e.preventDefault();
            if ($(this).parent().hasClass("disabled")) return;
            changePage(parseInt($(this).data("page"), 10));
        });

        $("#modalTable tbody").on("click", ".btn-export-institute", function () {
            window.exportSingleInstituteReport($(this).data("id"), this);
        });

        /* Modal: search / clear / page size */
        $("#modalTableSearch").on("keyup", function () {
            clearTimeout(searchTimeout);
            searchTimeout = setTimeout(function () {
                currentPage = 1;
                showModalLoader();
                loadModalDataPaged();
            }, 400);
        });

        $("#btnClearSearch").on("click", function () {
            $("#modalTableSearch").val("");
            currentPage = 1;
            showModalLoader();
            loadModalDataPaged();
        });

        $("#modalPageSize").on("change", function () {
            currentPage = 1;
            showModalLoader();
            loadModalDataPaged();
        });

        /* Modal: export filtered data (JWT header ke saath) */
        $("#btnExportModalData").on("click", function () {
            const searchTerm = $("#modalTableSearch").val().trim();
            downloadExcel({
                url: "/api/admin/export-details-excel?category=" + encodeURIComponent(currentCategory) +
                     "&type=" + encodeURIComponent(currentType) +
                     "&search=" + encodeURIComponent(searchTerm) +
                     "&affiliateid=" + encodeURIComponent(AFFILIATE_ID),
                filename: currentCategory + "_" + currentType + "_Export.xlsx",
                loaderText: "Generating Excel Export for Filtered Records...",
                button: this
            });
        });
    });
})();
</script>
