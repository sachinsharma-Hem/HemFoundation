<partial name="~/Views/Dashboard/Partials/_UserProfileCard.cshtml" />

@using Microsoft.AspNetCore.Http
@{
    var affiliateId = Context.Session.GetInt32("UserID") ?? 0;
}

<!-- =============================================================
     STYLES
     ============================================================= -->
<style>
    .cursor-pointer { cursor: pointer; }

    /* ---------- Associated schools table ---------- */
    .associated-schools-table-wrapper {
        width: 100%;
        max-width: 100%;
        height: 550px;
        max-height: 550px;
        overflow-x: auto !important;
        overflow-y: auto !important;
        display: block;
        border: 1px solid #dee2e6;
        border-radius: 10px;
        background: #ffffff;
        position: relative;
        -webkit-overflow-scrolling: touch;
        scrollbar-width: auto;
        scrollbar-color: #adb5bd #f1f3f5;
    }

    #associatedSchoolsDetailsTable {
        width: max-content !important;
        min-width: 2600px !important;
        margin: 0 !important;
        table-layout: auto !important;
    }

    #associatedSchoolsDetailsTable th,
    #associatedSchoolsDetailsTable td { vertical-align: middle; }

    #associatedSchoolsDetailsTable thead th {
        position: sticky;
        top: 0;
        z-index: 20;
        background-color: #f8f9fa !important;
        color: #495057;
        font-size: 12px;
        font-weight: 700;
        white-space: nowrap;
        padding: 12px 10px;
        border-bottom: 2px solid #dee2e6;
    }

    #associatedSchoolsDetailsTable tbody td {
        font-size: 13px;
        padding: 10px;
        white-space: nowrap;
    }

    /* School Name = 3rd column */
    #associatedSchoolsDetailsTable th:nth-child(3),
    #associatedSchoolsDetailsTable td:nth-child(3) { min-width: 190px; max-width: 220px; }
    #associatedSchoolsDetailsTable td:nth-child(3) { white-space: normal; word-break: break-word; }

    /* Email = 9th column */
    #associatedSchoolsDetailsTable th:nth-child(9),
    #associatedSchoolsDetailsTable td:nth-child(9) { min-width: 230px; }

    /* Address, Address 2 = 10th, 11th column */
    #associatedSchoolsDetailsTable th:nth-child(10),
    #associatedSchoolsDetailsTable td:nth-child(10),
    #associatedSchoolsDetailsTable th:nth-child(11),
    #associatedSchoolsDetailsTable td:nth-child(11) { min-width: 220px; max-width: 320px; }
    #associatedSchoolsDetailsTable td:nth-child(10),
    #associatedSchoolsDetailsTable td:nth-child(11) { white-space: normal; word-break: break-word; }

    /* Count columns = 17 to 20 */
    #associatedSchoolsDetailsTable th:nth-child(n+17),
    #associatedSchoolsDetailsTable td:nth-child(n+17) { min-width: 135px; text-align: center; }

    .school-url {
        display: inline-block;
        max-width: 220px;
        overflow: hidden;
        text-overflow: ellipsis;
        vertical-align: middle;
        white-space: nowrap;
    }
    .school-status-badge { min-width: 65px; display: inline-block; text-align: center; }
    .school-count-badge  { min-width: 55px; display: inline-block; text-align: center; }

    .associated-schools-table-wrapper::-webkit-scrollbar { width: 11px; height: 12px; }
    .associated-schools-table-wrapper::-webkit-scrollbar-track { background: #f1f3f5; border-radius: 10px; }
    .associated-schools-table-wrapper::-webkit-scrollbar-thumb {
        background: #adb5bd; border-radius: 10px; border: 2px solid #f1f3f5;
    }
    .associated-schools-table-wrapper::-webkit-scrollbar-thumb:hover { background: #6c757d; }

    /* ---------- Global loader ---------- */
    .global-loader-overlay {
        position: fixed;
        top: 0; left: 0;
        width: 100vw; height: 100vh;
        background: rgba(255, 255, 255, 0.85);
        backdrop-filter: blur(4px);
        z-index: 99999;
        display: flex;
        justify-content: center;
        align-items: center;
        flex-direction: column;
        transition: opacity 0.2s ease-in-out;
    }

    /* ---------- Details modal ---------- */
    .modal-loader { padding: 3rem 0; }
    #modalTable thead th { white-space: nowrap; user-select: none; }
    #modalTable tbody td { white-space: nowrap; vertical-align: middle; }
    .modal-table-wrapper { max-height: calc(100vh - 260px); overflow: auto; }
    .modal-table-wrapper thead th {
        position: sticky;
        top: 0;
        z-index: 5;
        background: #f8f9fa !important;
    }

    /* ---------- Page layout ---------- */
    .dash-page { max-width: 1500px; margin: 0 auto; padding: 4px 0 24px; }

    .dash-header {
        display: flex; align-items: center; justify-content: space-between;
        flex-wrap: wrap; gap: 12px; margin-bottom: 20px;
    }
    .dash-header h3 { margin: 0; font-weight: 800; color: #14532d; }
    .dash-header p  { margin: 2px 0 0; color: #6b7280; font-size: 0.875rem; }

    .dash-section {
        background: #ffffff;
        border: 1px solid #d9dfe5;
        border-radius: 16px;
        padding: 24px;
        margin-bottom: 24px;
        box-shadow: 0 1px 3px rgba(16, 24, 40, 0.05);
    }
    .dash-section__head {
        display: flex; align-items: center; justify-content: space-between;
        flex-wrap: wrap; gap: 12px;
        padding-bottom: 16px; margin-bottom: 20px;
        border-bottom: 1px solid #eef0f3;
    }
    .dash-section__title { margin: 0; font-size: 1.15rem; font-weight: 700; color: #198754; }
    .dash-section__title i { margin-right: 8px; }
    .dash-section__desc  { margin: 2px 0 0; font-size: 0.8rem; color: #6b7280; }

    .dash-subtitle {
        font-size: 0.72rem; font-weight: 700; letter-spacing: 0.08em;
        text-transform: uppercase; color: #6b7280; margin: 0 0 12px;
    }
    .dash-subtitle.spaced { margin-top: 28px; }

    .dash-note {
        text-align: center; padding: 12px; margin-top: 20px;
        border: 1px dashed #d9dfe5; border-radius: 10px;
        background: #f8f9fa; color: #6b7280; font-size: 0.8rem;
    }

    /* ---------- Gradient card (used by ALL cards) ---------- */
    .stat-grid {
        display: grid;
        gap: 20px;
        grid-template-columns: repeat(auto-fit, minmax(235px, 1fr));
    }

    .premium-card {
        border-radius: 12px;
        border: none;
        color: #fff;
        padding: 20px;
        position: relative;
        overflow: hidden;
        transition: transform 0.3s, box-shadow 0.3s;
        height: 100%;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
    }
    .premium-card:hover { transform: translateY(-5px); box-shadow: 0 12px 25px rgba(0,0,0,0.15); }

    .premium-card .icon-circle {
        width: 65px; height: 65px;
        background-color: #fff;
        border-radius: 50%;
        display: flex; align-items: center; justify-content: center;
        font-size: 2rem;
        flex-shrink: 0;
    }
    .premium-card .stat-number { font-size: 2.2rem; font-weight: 800; line-height: 1.1; margin-bottom: 2px; }
    .premium-card .stat-label  { font-size: 0.95rem; font-weight: 600; opacity: 0.9; text-transform: capitalize; }
    .premium-card .divider     { border-top: 1px solid rgba(255,255,255,0.3); margin: 18px 0 15px 0; }
    .premium-card .btn-more {
        background-color: #fff;
        border-radius: 50px;
        padding: 6px 20px;
        font-weight: 700;
        font-size: 0.85rem;
        text-decoration: none;
        display: inline-block;
        transition: background-color 0.2s;
    }
    .premium-card .btn-more:hover:not(:disabled) { background-color: #f1f1f1; }
    .premium-card .btn-more:disabled { opacity: 0.75; cursor: not-allowed; }

    .bg-blue   { background: linear-gradient(135deg, #00c6ff, #0072ff); }
    .bg-blue .icon-circle,   .bg-blue .btn-more   { color: #0072ff; }
    .bg-green  { background: linear-gradient(135deg, #28c76f, #059669); }
    .bg-green .icon-circle,  .bg-green .btn-more  { color: #059669; }
    .bg-orange { background: linear-gradient(135deg, #ff9f43, #f57c00); }
    .bg-orange .icon-circle, .bg-orange .btn-more { color: #f57c00; }
    .bg-teal   { background: linear-gradient(135deg, #00cfe8, #009688); }
    .bg-teal .icon-circle,   .bg-teal .btn-more   { color: #009688; }
    .bg-purple { background: linear-gradient(135deg, #9722ff, #6610f2); }
    .bg-purple .icon-circle, .bg-purple .btn-more { color: #6610f2; }
    .bg-pink   { background: linear-gradient(135deg, #ff7eb3, #e83e8c); }
    .bg-pink .icon-circle,   .bg-pink .btn-more   { color: #e83e8c; }
    .bg-indigo { background: linear-gradient(135deg, #818cf8, #4f46e5); }
    .bg-indigo .icon-circle, .bg-indigo .btn-more { color: #4f46e5; }
    .bg-yellow { background: linear-gradient(135deg, #f6d365, #fd7e14); }
    .bg-yellow .icon-circle, .bg-yellow .btn-more { color: #fd7e14; }
    .bg-cyan   { background: linear-gradient(135deg, #4facfe, #00f2fe); }
    .bg-cyan .icon-circle,   .bg-cyan .btn-more   { color: #008b8b; }
    .bg-red    { background: linear-gradient(135deg, #ff416c, #ff4b2b); }
    .bg-red .icon-circle,    .bg-red .btn-more    { color: #ff4b2b; }
</style>

<!-- =============================================================
