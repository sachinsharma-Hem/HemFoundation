<!-- =============================================================
     JAVASCRIPT

     IMPORTANT:
     No jQuery is used here.
     Therefore "$ is not defined" issue nahi aayega.
============================================================= -->

<script>

(function () {

    "use strict";


    // =========================================================
    // GET JWT TOKEN
    // =========================================================

    function getAuthToken() {

        return localStorage.getItem("jwt_token")
            || sessionStorage.getItem("jwt_token")
            || "";

    }


    // =========================================================
    // HTML ENCODE
    // =========================================================

    function escapeHtml(value) {

        if (value === null || value === undefined) {
            return "";
        }

        var div = document.createElement("div");

        div.textContent = String(value);

        return div.innerHTML;

    }


    // =========================================================
    // SET COUNT
    // =========================================================

    function setSchoolCount(count) {

    var finalCount = Number.isFinite(Number(count))
        ? Number(count)
        : 0;


    // Assigned Schools quick action card
    var assignedCountElement =
        document.getElementById("lblAssignedSchoolCount");

    if (assignedCountElement) {

        assignedCountElement.textContent = finalCount;

    }


    // Active School top dashboard card
    var activeSchoolCountElement =
        document.getElementById("lblActiveSchoolCount");

    if (activeSchoolCountElement) {

        activeSchoolCountElement.textContent = finalCount;

    }


    // Modal footer count
    var modalCount =
        document.getElementById("modalAssignedSchoolCount");

    if (modalCount) {

        modalCount.textContent = finalCount;

    }

}


    // =========================================================
    // COUNT LOADING
    // =========================================================

    function showCountLoading() {

        var countElement =
            document.getElementById("lblAssignedSchoolCount");

        if (!countElement) {
            return;
        }

        countElement.innerHTML = `
            <span class="spinner-border spinner-border-sm text-primary"
                  role="status"
                  aria-hidden="true">
            </span>
        `;

    }


    // =========================================================
    // FETCH ASSIGNED SCHOOLS
    // =========================================================

    async function fetchAssignedSchools() {

        var token = getAuthToken();

        var headers = {
            "Accept": "application/json"
        };


        if (token) {

            headers["Authorization"] =
                "Bearer " + token;

        }


        try {

            var response = await fetch(
                "/api/volunteer/my-assigned-schools",
                {
                    method: "GET",
                    headers: headers,
                    credentials: "same-origin",
                    cache: "no-store"
                }
            );


            if (!response.ok) {

                console.error(
                    "Assigned schools API failed:",
                    response.status,
                    response.statusText
                );

                throw new Error(
                    "API returned " + response.status
                );

            }


            var result =
                await response.json();


            if (
                result &&
                result.success &&
                Array.isArray(result.data)
            ) {

                return result.data;

            }


            return [];

        }
        catch (error) {

            console.error(
                "Unable to load assigned schools:",
                error
            );

            return null;

        }

    }


    // =========================================================
    // LOAD COUNT ON DASHBOARD
    // =========================================================

    async function loadVolunteerAssignedSchoolCount() {

        showCountLoading();


        var schools =
            await fetchAssignedSchools();


        if (schools === null) {

            setSchoolCount(0);

            return;

        }


        setSchoolCount(schools.length);

    }


    // =========================================================
    // FORMAT DATE
    // =========================================================

    function formatAssignedDate(dateValue) {

        if (!dateValue) {

            return "-";

        }


        var date =
            new Date(dateValue);


        if (isNaN(date.getTime())) {

            return "-";

        }


        return date.toLocaleDateString(
            "en-IN",
            {
                day: "2-digit",
                month: "short",
                year: "numeric"
            }
        );

    }


    // =========================================================
    // RENDER SCHOOL TABLE
    // =========================================================

    function renderAssignedSchools(schools) {

        var tableBody =
            document.getElementById(
                "tblAssignedSchoolsList"
            );


        if (!tableBody) {
            return;
        }


        if (
            !schools ||
            schools.length === 0
        ) {

            tableBody.innerHTML = `

                <tr>

                    <td colspan="4"
                        class="text-center py-5 text-muted">

                        <i class="bi bi-building fs-1 d-block mb-3"></i>

                        <div class="fw-semibold">
                            No schools assigned
                        </div>

                        <small>
                            No school is currently assigned to you.
                        </small>

                    </td>

                </tr>

            `;

            return;

        }


        var rows = "";


        schools.forEach(function (school, index) {

            var schoolName =
                school.name || "-";


            var instituteId =
                school.instituteID
                ?? school.InstituteID
                ?? "-";


            var assignedDate =
                formatAssignedDate(
                    school.assignedDate
                    ?? school.AssignedDate
                );


            var assignedBy =
                school.assignedBy
                ?? school.AssignedBy
                ?? "-";


            rows += `

                <tr>

                    <td class="fw-bold text-muted">
                        ${index + 1}
                    </td>


                    <td>

                        <div class="school-name">
                            ${escapeHtml(schoolName)}
                        </div>

                        <div class="school-id">
                            School ID:
                            ${escapeHtml(instituteId)}
                        </div>

                    </td>


                    <td>

                        <span class="badge bg-primary-subtle text-primary rounded-pill px-3 py-2">

                            ${escapeHtml(assignedDate)}

                        </span>

                    </td>


                    <td>

                        <span class="fw-medium text-dark">

                            ${escapeHtml(assignedBy)}

                        </span>

                    </td>

                </tr>

            `;

        });


        tableBody.innerHTML = rows;

    }


    // =========================================================
    // OPEN ASSIGNED SCHOOLS MODAL
    // =========================================================

    async function openAssignedSchoolsModal() {

        var modalElement =
            document.getElementById(
                "volunteerSchoolsModal"
            );


        if (!modalElement) {

            console.error(
                "volunteerSchoolsModal not found."
            );

            return;

        }


        var tableBody =
            document.getElementById(
                "tblAssignedSchoolsList"
            );


        if (tableBody) {

            tableBody.innerHTML = `

                <tr>

                    <td colspan="4"
                        class="text-center py-5 text-muted">

                        <span class="spinner-border spinner-border-sm me-2">
                        </span>

                        Loading assigned schools...

                    </td>

                </tr>

            `;

        }


        // Bootstrap 5 modal
        var modal =
            bootstrap.Modal.getOrCreateInstance(
                modalElement
            );


        modal.show();


        // API call
        var schools =
            await fetchAssignedSchools();


        if (schools === null) {

            if (tableBody) {

                tableBody.innerHTML = `

                    <tr>

                        <td colspan="4"
                            class="text-center py-5 text-danger">

                            <i class="bi bi-exclamation-circle fs-3 d-block mb-2"></i>

                            Failed to load assigned schools.

                        </td>

                    </tr>

                `;

            }

            return;

        }


        // Count update
        setSchoolCount(schools.length);


        // Table render
        renderAssignedSchools(schools);

    }


    // =========================================================
    // BUTTON EVENT
    // =========================================================

    function initializeAssignedSchools() {

        var button =
            document.getElementById(
                "btnOpenAssignedSchools"
            );


        if (button) {

            button.addEventListener(
                "click",
                openAssignedSchoolsModal
            );

        }


        // Dashboard open hote hi count load
        loadVolunteerAssignedSchoolCount();

    }


    // =========================================================
    // INITIALIZE
    // =========================================================

    if (document.readyState === "loading") {

        document.addEventListener(
            "DOMContentLoaded",
            initializeAssignedSchools
        );

    }
    else {

        initializeAssignedSchools();

    }


})();

</script>