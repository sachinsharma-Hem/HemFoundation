<div class="card border-0 shadow-sm rounded-4 overflow-hidden mb-4" id="ehCard">
    <div class="card-header bg-white border-bottom px-3 px-md-4 py-3">
        <div class="d-flex flex-wrap justify-content-between align-items-center gap-2">
            <div class="d-flex align-items-center gap-3">
                <span class="bg-primary-subtle text-primary rounded-3 p-2 lh-1 fs-5"><i class="bi bi-clock-history"></i></span>
                <div>
                    <h6 class="fw-bold mb-0" style="color: rgb(52 96 214 / 94%);">Evaluated Project History</h6>
                    <small class="text-muted">History of projects evaluated for your school</small>
                </div>
            </div>
            <div class="d-flex align-items-center gap-2 flex-wrap">
                <!-- Universal Search Filter -->
                <input type="text" id="universalSearch" class="form-control form-control-sm rounded-pill px-3" placeholder="Search anything..." onkeyup="applyFilters()" style="width: 220px;" />

                <button type="button" class="btn btn-sm btn-outline-primary rounded-pill px-3 fw-semibold shadow-sm" onclick="toggleChartView()">
                    <i class="bi bi-bar-chart-fill me-1" id="chartBtnIcon"></i> <span id="chartBtnText">View Graph</span>
                </button>
                <span class="badge rounded-pill px-3 py-2 text-white" style="background-color: rgb(52 96 214 / 94%);">School Evaluations</span>
            </div>
        </div>
    </div>

    <div class="card-body p-3 p-md-4">
        <div id="chartSection" class="d-none mb-3">
            <div class="row g-3">
                <div class="col-12 col-lg-4">
                    <div class="border rounded-3 p-3 h-100 bg-light">
                        <h6 class="fw-bold small mb-1"><i class="bi bi-pie-chart me-1 text-primary"></i>Status Summary</h6>
                        <div id="statusBars"></div>
                    </div>
                </div>
                <div class="col-12 col-lg-8">
                    <div class="border rounded-3 p-3 h-100 bg-light">
                        <h6 class="fw-bold small mb-1"><i class="bi bi-bar-chart-line me-1 text-primary"></i>Marks per Project</h6>
                        <p class="text-muted small mb-2" id="chartHint">Latest evaluated projects (old → new).</p>
                        <div style="height: 240px;"><canvas id="evaluationBarChart"></canvas></div>
                    </div>
                </div>
            </div>
        </div>

        <div class="table-responsive rounded-3 border">
            <table class="table table-hover table-sm align-middle mb-0 small" id="schoolEvaluatedTable">
                <thead class="table-light" id="tableHeaderContainer">
                    <!-- Dynamic Headers with Sorting & Filters will load here -->
                </thead>
                <tbody></tbody>
            </table>
        </div>

        <!-- Modal -->
        <div class="modal fade" id="projectDetailModal" tabindex="-1" aria-hidden="true">
            <div class="modal-dialog modal-dialog-centered modal-lg">
                <div class="modal-content border-0 shadow-lg rounded-4 overflow-hidden">
                    <div class="modal-header bg-primary text-white px-4 py-3">
                        <h5 class="modal-title fw-bold fs-6">
                            <i class="bi bi-journal-check me-2"></i>Evaluated Project Details & Media
                        </h5>
                        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <div class="modal-body p-4 bg-light" id="modalProjectContent"></div>
                </div>
            </div>
        </div>

        <!-- Pagination -->
        <div class="d-flex flex-column flex-md-row justify-content-between align-items-center gap-2 mt-3">
            <div class="text-muted small" id="schoolPaginationInfo">Showing 0 to 0 of 0 entries</div>
            <nav aria-label="School Evaluations Pagination">
                <ul class="pagination pagination-sm flex-wrap justify-content-center mb-0" id="schoolPaginationNav"></ul>
            </nav>
        </div>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>
<script>
    let schoolAllData = [];
    let filteredData = [];
    let schoolCurrentPage = 1;
    let schoolPageSize = 5;
    let myEvaluationChart = null;
    let isChartVisible = false;
    const CHART_MAX_BARS = 10;

    let currentSortColumn = -1;
    let sortAscending = true;

    const projectTypeMap = {
        "individual-projects": "Individual Project",
        "group-pbl": "Group Project",
        "family-projects": "Family Project",
        "sel-projects": "SEL Project"
    };

    const projectTypeStyles = {
        "individual-projects": { text: "Individual Project", badge: "bg-success-subtle text-success border border-success-subtle" },
        "family-projects": { text: "Family Project", badge: "bg-warning-subtle text-warning-emphasis border border-warning-subtle" },
        "group-pbl": { text: "Group Project", badge: "bg-primary-subtle text-primary border border-primary-subtle" },
        "sel-projects": { text: "SEL Project", badge: "bg-info-subtle text-info border border-info-subtle" }
    };

    const getProjectTypeStyle = (rawType) => {
        const k = (rawType || "").toLowerCase().trim();
        return projectTypeStyles[k] || { text: rawType || "-", badge: "bg-light text-dark border" };
    };

    const statusMap = {
        green: { text: "Green", hex: "#10b981", badge: "bg-success-subtle text-success-emphasis", dot: "text-success", style: "" },
        blue: { text: "Blue", hex: "#3b82f6", badge: "bg-primary-subtle text-primary-emphasis", dot: "text-primary", style: "" },
        yellow: { text: "Yellow", hex: "#eab308", badge: "bg-warning-subtle text-warning-emphasis", dot: "text-warning", style: "" },
        orange: { text: "Orange", hex: "#f97316", badge: "", dot: "", style: "background:#fed7aa;color:#92400e;" },
        red: { text: "Red", hex: "#ef4444", badge: "bg-danger-subtle text-danger-emphasis", dot: "text-danger", style: "" },
        pending: { text: "Pending", hex: "#9ca3af", badge: "bg-secondary-subtle text-secondary-emphasis", dot: "text-secondary", style: "" }
    };

    const statusKey = (s) => {
        const k = (s || "pending").toString().trim().toLowerCase();
        return statusMap[k] ? k : "pending";
    };

    function escapeHtml(text) {
        if (text === null || text === undefined) return "";
        return String(text).replace(/[&<>"']/g, c => ({
            "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;"
        }[c]));
    }

    function statusBadge(status) {
        const s = statusMap[statusKey(status)];
        return `<span class="badge rounded-pill ${s.badge} d-inline-flex align-items-center gap-2 fw-semibold" style="${s.style}">
                        <span class="spinner-grow ${s.dot}" style="width:.5rem;height:.5rem;" aria-hidden="true"></span>${s.text}
                    </span>`;
    }

    function loadHistory() {
        let apiEndpoint = window.evaluationApiUrl || "/api/project-evaluations/school-history";

        fetch(apiEndpoint)
            .then(res => res.json())
            .then(res => {
                schoolAllData = (res.success && res.data) ? res.data : [];
                filteredData = [...schoolAllData];
                schoolCurrentPage = 1;
                renderTableHeaders();
                renderTable();
                if (isChartVisible) renderGraph();
            })
            .catch(err => {
                console.error("Error loading evaluation history:", err);
            });
    }

    function toggleChartView() {
        isChartVisible = !isChartVisible;
        const section = document.getElementById("chartSection");
        const btnText = document.getElementById("chartBtnText");
        const btnIcon = document.getElementById("chartBtnIcon");

        if (isChartVisible) {
            section.classList.remove("d-none");
            section.animate([{ opacity: 0, transform: "translateY(10px)" }, { opacity: 1, transform: "none" }],
                { duration: 350, easing: "ease-out" });
            btnText.textContent = "Hide Graph";
            btnIcon.className = "bi bi-x-lg me-1";
            renderGraph();
        } else {
            section.classList.add("d-none");
            btnText.textContent = "View Graph";
            btnIcon.className = "bi bi-bar-chart-fill me-1";
        }
    }

    function renderGraph() {
        renderStatusBars();
        renderMarksChart();
    }

    function renderStatusBars() {
        const box = document.getElementById("statusBars");
        const total = filteredData.length;

        if (!total) {
            box.innerHTML = `<div class="text-muted small text-center py-4">Data Not Available</div>`;
            return;
        }

        const counts = {};
        filteredData.forEach(d => { const k = statusKey(d.statusColor); counts[k] = (counts[k] || 0) + 1; });

        box.innerHTML = Object.keys(statusMap).filter(k => counts[k]).map(k => {
            const s = statusMap[k];
            const pct = Math.round((counts[k] / total) * 100);
            return `<div class="mb-3">
                            <div class="d-flex justify-content-between align-items-center small mb-1">
                                <span class="fw-semibold d-inline-flex align-items-center gap-2">
                                    <span class="rounded-circle d-inline-block" style="width:10px;height:10px;background:${s.hex};"></span>${s.text}
                                </span>
                                <span class="text-muted">${counts[k]} project${counts[k] > 1 ? "s" : ""} <span class="fw-semibold text-dark">(${pct}%)</span></span>
                            </div>
                            <div class="progress" style="height:8px;">
                                <div class="progress-bar rounded-pill" role="progressbar" style="width:0%;background:${s.hex};" data-w="${pct}"></div>
                            </div>
                        </div>`;
        }).join("") + `<div class="border-top pt-2 small text-muted">Total <span class="fw-bold text-dark">${total}</span> evaluations</div>`;

        setTimeout(() => box.querySelectorAll(".progress-bar").forEach(b => b.style.width = b.dataset.w + "%"), 60);
    }

    function renderMarksChart() {
        const canvas = document.getElementById("evaluationBarChart");
        if (myEvaluationChart) { myEvaluationChart.destroy(); myEvaluationChart = null; }
        if (!filteredData.length) return;

        const allMarks = filteredData.map(d => Number(d.marks) || 0);
        const avg = allMarks.reduce((a, b) => a + b, 0) / allMarks.length;

        const sorted = [...filteredData].sort((a, b) => new Date(a.evaluatedDate || 0) - new Date(b.evaluatedDate || 0));
        const items = sorted.slice(-CHART_MAX_BARS);

        document.getElementById("chartHint").textContent =
            (filteredData.length > CHART_MAX_BARS ? `Latest ${CHART_MAX_BARS} evaluated projects` : "All evaluated projects") +
            " (old → new).";

        const fmtDate = (d) => d ? new Date(d).toLocaleDateString("en-US", { year: "numeric", month: "short", day: "2-digit" }) : "-";

        myEvaluationChart = new Chart(canvas.getContext("2d"), {
            data: {
                labels: items.map(d => "#" + d.projectID),
                datasets: [
                    {
                        type: "bar",
                        label: "Marks",
                        data: items.map(d => Number(d.marks) || 0),
                        backgroundColor: items.map(d => statusMap[statusKey(d.statusColor)].hex + "cc"),
                        borderColor: items.map(d => statusMap[statusKey(d.statusColor)].hex),
                        borderWidth: 1,
                        borderRadius: 8,
                        maxBarThickness: 46
                    },
                    {
                        type: "line",
                        label: `Average (${avg.toFixed(1)})`,
                        data: items.map(() => avg),
                        borderColor: "#64748b",
                        borderDash: [6, 6],
                        borderWidth: 2,
                        pointRadius: 0,
                        pointHoverRadius: 0
                    }
                ]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                animation: { duration: 800, easing: "easeOutQuart" },
                plugins: {
                    legend: { position: "top", align: "end", labels: { usePointStyle: true, boxWidth: 8, filter: (i) => i.datasetIndex === 1 } },
                    tooltip: {
                        callbacks: {
                            title: (ctx) => "Project " + ctx[0].label,
                            label: (ctx) => ctx.datasetIndex === 0 ? ` Marks: ${ctx.parsed.y}` : ` ${ctx.dataset.label}`
                        }
                    }
                },
                scales: {
                    x: { grid: { display: false }, title: { display: true, text: "Project Number", color: "#64748b", font: { size: 11 } } },
                    y: { beginAtZero: true, grace: "10%", title: { display: true, text: "Marks", color: "#64748b", font: { size: 11 } } }
                }
            }
        });
    }

    const columnsConfig = [
        { label: "Sr", sortable: false, filterKey: null },
        { label: "Project Number", sortable: true, filterKey: "projectID" },
        { label: "Project Type", sortable: true, filterKey: "projectType" },
        { label: "Standard", sortable: true, filterKey: "standard" },
        { label: "Course / Title", sortable: true, filterKey: "courseName" },
        { label: "Student Name / Team", sortable: true, filterKey: "studentName" },
        { label: "School Name", sortable: true, filterKey: "schoolName" },
        { label: "PBL", sortable: false, filterKey: null },
        { label: "Status", sortable: true, filterKey: "statusColor" },
        { label: "Media", sortable: false, filterKey: null },
        { label: "Evaluate Remarks", sortable: true, filterKey: "description" },
        { label: "Evaluated Date", sortable: true, filterKey: "evaluatedDate" }
    ];

    function renderTableHeaders() {
        const thead = document.getElementById("tableHeaderContainer");
        if (!thead) return;

        let headerRow = "<tr>";
        columnsConfig.forEach((col, idx) => {
            let sortIcon = "";
            if (col.sortable) {
                if (currentSortColumn === idx) {
                    sortIcon = `<span class="ms-1">${sortAscending ? '▲' : '▼'}</span>`;
                } else {
                    sortIcon = `<span class="ms-1 text-muted" style="font-size:10px;">↕</span>`;
                }
            }
            let clickAttr = col.sortable ? `onclick="sortColumn(${idx})"` : "";
            let cursorStyle = col.sortable ? "cursor:pointer;" : "";
            headerRow += `<th ${clickAttr} style="${cursorStyle} white-space:nowrap;">${col.label}${sortIcon}</th>`;
        });
        headerRow += "</tr>";

        // Column-wise Filter Inputs Row
        let filterRow = "<tr class='bg-light'>";
        columnsConfig.forEach((col, idx) => {
            if (col.filterKey) {
                filterRow += `<th><input type="text" class="form-control form-control-sm col-filter" data-key="${col.filterKey}" placeholder="Filter..." onkeyup="applyFilters()" style="font-size: 11px; padding: 2px 5px;" /></th>`;
            } else {
                filterRow += `<th></th>`;
            }
        });
        filterRow += "</tr>";

        thead.innerHTML = headerRow + filterRow;
    }

    function sortColumn(columnIndex) {
        if (currentSortColumn === columnIndex) {
            sortAscending = !sortAscending;
        } else {
            currentSortColumn = columnIndex;
            sortAscending = true;
        }

        const key = columnsConfig[columnIndex].filterKey;
        if (!key) return;

        filteredData.sort((a, b) => {
            let valA = a[key] || "";
            let valB = b[key] || "";

            if (!isNaN(valA) && !isNaN(valB)) {
                valA = Number(valA);
                valB = Number(valB);
            } else {
                valA = String(valA).toLowerCase();
                valB = String(valB).toLowerCase();
            }

            if (valA < valB) return sortAscending ? -1 : 1;
            if (valA > valB) return sortAscending ? 1 : -1;
            return 0;
        });

        renderTableHeaders();
        renderTable();
    }

    function applyFilters() {
        const universalTerm = (document.getElementById("universalSearch").value || "").toLowerCase().trim();
        const colFilters = document.querySelectorAll(".col-filter");

        filteredData = schoolAllData.filter(item => {
            // Universal Search Match
            if (universalTerm) {
                const matchUni = Object.values(item).some(val =>
                    String(val || "").toLowerCase().includes(universalTerm)
                );
                if (!matchUni) return false;
            }

            // Column-wise Filters Match
            for (let input of colFilters) {
                const key = input.getAttribute("data-key");
                const val = input.value.toLowerCase().trim();
                if (val) {
                    const itemVal = String(item[key] || "").toLowerCase();
                    if (!itemVal.includes(val)) return false;
                }
            }
            return true;
        });

        schoolCurrentPage = 1;
        renderTable();
        if (isChartVisible) renderGraph();
    }

    function renderTable() {
        const tbody = document.querySelector("#schoolEvaluatedTable tbody");
        if (!tbody) return;

        if (filteredData.length === 0) {
            tbody.innerHTML = `<tr><td colspan="12" class="text-center text-muted py-5">
                    <i class="bi bi-inbox fs-1 d-block mb-2"></i>
                    <div class="fw-semibold">No evaluation history found</div>
                    <small>Try adjusting your search or filters.</small></td></tr>`;
            document.getElementById("schoolPaginationInfo").textContent = "Showing 0 entries";
            document.getElementById("schoolPaginationNav").innerHTML = "";
            return;
        }

        let total = filteredData.length;
        let totalPages = Math.ceil(total / schoolPageSize);
        if (schoolCurrentPage > totalPages) schoolCurrentPage = totalPages;

        let start = (schoolCurrentPage - 1) * schoolPageSize;
        let end = Math.min(start + schoolPageSize, total);

        tbody.innerHTML = filteredData.slice(start, end).map((item, i) => {
            const ptStyle = getProjectTypeStyle(item.projectType);
            const type = projectTypeMap[(item.projectType || "").toLowerCase()] || item.projectType || "-";
            const date = item.evaluatedDate
                ? new Date(item.evaluatedDate).toLocaleDateString("en-US", { year: "numeric", month: "short", day: "2-digit" })
                : "-";
            const desc = item.description || "-";
            const studentName = item.studentName || "Group / Team Project";
            const schoolName = item.schoolName || "-";
            const standard = item.standard || "-";
            const courseTitle = item.courseName || "-";

            let pblHtml = item.evaluationFileUrl
                ? `<a href="${item.evaluationFileUrl}" target="_blank" class="btn btn-sm btn-outline-primary px-2 py-1"><i class="bi bi-file-earmark-pdf me-1"></i>PBL</a>`
                : '<span class="text-muted">-</span>';

            let mediaHtml = '';
            if (item.imageActivity) {
                mediaHtml += `<a href="${item.imageActivity}" target="_blank" class="btn btn-sm btn-outline-info me-1 mb-1"><i class="bi bi-image me-1"></i> Image</a>`;
            }
            if (item.videoActivity) {
                mediaHtml += `<a href="${item.videoActivity}" target="_blank" class="btn btn-sm btn-outline-success me-1 mb-1"><i class="bi bi-play-circle me-1"></i> Video</a>`;
            }
            if (!mediaHtml) mediaHtml = '<span class="text-muted">No Media</span>';

            return `<tr>
                    <td class="ps-3 text-muted fw-semibold d-none d-md-table-cell">${start + i + 1}</td>
                    <td class="ps-3 ps-md-0">
                        <a href="javascript:void(0)" class="fw-bold text-primary text-decoration-underline" onclick='openProjectDetailModal(${JSON.stringify(item)})'>#${escapeHtml(item.projectID)}</a>
                    </td>
                    <td class="d-none d-md-table-cell">
                        <span class="badge rounded-pill ${ptStyle.badge}">${escapeHtml(type)}</span>
                    </td>
                    <td>${escapeHtml(standard)}</td>
                    <td>${escapeHtml(courseTitle)}</td>
                    <td class="fw-semibold text-dark">${escapeHtml(studentName)}</td>
                    <td><span class="text-muted">${escapeHtml(schoolName)}</span></td>
                    <td>${pblHtml}</td>
                    <td>${statusBadge(item.statusColor)}</td>
                    <td>${mediaHtml}</td>
                    <td><span class="text-muted text-truncate d-block" style="max-width:150px;" title="${escapeHtml(desc)}">${escapeHtml(desc)}</span></td>
                    <td class="d-none d-lg-table-cell pe-3 text-muted text-nowrap"><i class="bi bi-calendar3 me-1"></i>${date}</td>
                </tr>`;
        }).join("");

        document.getElementById("schoolPaginationInfo").textContent = `Showing ${start + 1} to ${end} of ${total} entries`;
        renderPagination(totalPages);
    }

    function openProjectDetailModal(item) {
        const ptStyle = getProjectTypeStyle(item.projectType);
        const type = projectTypeMap[(item.projectType || "").toLowerCase()] || item.projectType || "-";
        let content = `
                <div class="row g-3">
                    <div class="col-md-6">
                        <div class="p-3 bg-white rounded-3 border h-100">
                            <h6 class="text-primary fw-bold mb-3"><i class="bi bi-info-circle me-1"></i> Project Overview</h6>
                            <p class="mb-2"><strong>Project ID:</strong> <span class="badge bg-light text-dark border">#${item.projectID}</span></p>
                            <p class="mb-2"><strong>Project Type:</strong> <span class="badge rounded-pill ${ptStyle.badge}">${type}</span></p>
                            <p class="mb-2"><strong>Standard:</strong> ${item.standard || '-'}</p>
                            <p class="mb-2"><strong>Course / Title:</strong> ${item.courseName || '-'}</p>
                            <p class="mb-2"><strong>Student / Team:</strong> ${item.studentName || '-'}</p>
                            <p class="mb-0"><strong>School:</strong> ${item.schoolName || '-'}</p>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="p-3 bg-white rounded-3 border h-100">
                            <h6 class="text-success fw-bold mb-3"><i class="bi bi-clipboard-check me-1"></i> Evaluation Details</h6>
                            <p class="mb-2"><strong>Status:</strong> ${statusBadge(item.statusColor)}</p>
                            <p class="mb-2"><strong>Marks Awarded:</strong> <span class="badge bg-success text-white">${item.marks || 0} Marks</span></p>
                            <p class="mb-2"><strong>Evaluated Date:</strong> ${item.evaluatedDate ? new Date(item.evaluatedDate).toLocaleDateString() : '-'}</p>
                            <div class="mt-2">
                                <strong>Evaluation Remarks:</strong>
                                <div class="p-2 bg-light rounded border mt-1 text-dark small" style="min-height: 50px;">
                                    ${escapeHtml(item.description || "No remarks provided.")}
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="col-12">
                        <div class="p-3 bg-white rounded-3 border">
                            <h6 class="text-secondary fw-bold mb-2"><i class="bi bi-folder2-open me-1"></i> Attached Media & Documents</h6>
                            <div class="d-flex flex-wrap gap-2 mt-2">
                                ${item.evaluationFileUrl ? `<a href="${item.evaluationFileUrl}" target="_blank" class="btn btn-sm btn-outline-primary"><i class="bi bi-file-earmark-pdf me-1"></i> View PBL File</a>` : ''}
                                ${item.imageActivity ? `<a href="${item.imageActivity}" target="_blank" class="btn btn-sm btn-outline-info"><i class="bi bi-image me-1"></i> View Activity Image</a>` : ''}
                                ${item.videoActivity ? `<a href="${item.videoActivity}" target="_blank" class="btn btn-sm btn-outline-success"><i class="bi bi-play-circle me-1"></i> View Activity Video</a>` : ''}
                                ${!item.evaluationFileUrl && !item.imageActivity && !item.videoActivity ? '<span class="text-muted small">No media files available for this project.</span>' : ''}
                            </div>
                        </div>
                    </div>
                </div>
            `;
        document.getElementById("modalProjectContent").innerHTML = content;
        var modal = new bootstrap.Modal(document.getElementById('projectDetailModal'));
        modal.show();
    }

    function renderPagination(totalPages) {
        const cur = schoolCurrentPage;
        const pages = [];
        for (let i = 1; i <= totalPages; i++) {
            if (i === 1 || i === totalPages || Math.abs(i - cur) <= 1) pages.push(i);
            else if (pages[pages.length - 1] !== "...") pages.push("...");
        }

        let h = `<li class="page-item ${cur === 1 ? "disabled" : ""}"><a class="page-link" href="#" data-page="${cur - 1}">Prev</a></li>`;
        pages.forEach(p => {
            h += p === "..."
                ? `<li class="page-item disabled"><span class="page-link">…</span></li>`
                : `<li class="page-item ${p === cur ? "active" : ""}"><a class="page-link" href="#" data-page="${p}">${p}</a></li>`;
        });
        h += `<li class="page-item ${cur === totalPages ? "disabled" : ""}"><a class="page-link" href="#" data-page="${cur + 1}">Next</a></li>`;
        const nav = document.getElementById("schoolPaginationNav");
        if (nav) nav.innerHTML = h;
    }

    document.addEventListener("click", function (e) {
        const navClick = e.target.closest("#schoolPaginationNav a[data-page]");
        if (navClick) {
            e.preventDefault();
            const page = parseInt(navClick.getAttribute("data-page"), 10);
            const totalPages = Math.ceil(filteredData.length / schoolPageSize);
            if (page < 1 || page > totalPages || page === schoolCurrentPage) return;
            schoolCurrentPage = page;
            renderTable();
        }
    });

    document.addEventListener("DOMContentLoaded", function () {
        loadHistory();
    });
</script>

