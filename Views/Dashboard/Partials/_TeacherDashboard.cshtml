<partial name="~/Views/Dashboard/Partials/_UserProfileCard.cshtml" />

<div class="container-fluid py-2">
    <!-- Top Stats Overview Section -->
    <div class="row g-4 mb-4">
        <!-- Students Metric Card -->
        <div class="col-xl-3 col-sm-6">
            <div class="card border-0 shadow-sm rounded-4 p-4 h-100 transition-hover bg-white position-relative overflow-hidden">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <span class="text-muted small fw-semibold text-uppercase tracking-wider">Total Students</span>
                        <h2 class="fw-bold text-dark mt-2 mb-0">@ViewBag.TotalStudentsCount</h2>
                        <span class="badge bg-success-subtle text-success rounded-pill mt-2 px-2 py-1" style="font-size: 0.75rem;">
                            <i class="bi bi-arrow-up-short"></i>Register Students
                        </span>
                    </div>
                    <div class="rounded-4 d-flex align-items-center justify-content-center text-white shadow-sm" style="width: 55px; height: 55px; background: linear-gradient(135deg, #0d6efd, #0b5ed7);">
                        <i class="bi bi-mortarboard-fill fs-4"></i>
                    </div>
                </div>
            </div>
        </div>
        <!-- Practicals Metric Card -->
        <div class="col-xl-3 col-sm-6">
            <div class="card border-0 shadow-sm rounded-4 p-4 h-100 transition-hover bg-white position-relative overflow-hidden">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <span class="text-muted small fw-semibold text-uppercase tracking-wider">Active Students</span>
                        <h2 class="fw-bold text-dark mt-2 mb-0"> @ViewBag.ActiveStudentsCount </h2>
                        <span class="badge bg-success-subtle text-success rounded-pill mt-2 px-2 py-1" style="font-size: 0.75rem;">
                            <i class="bi bi-check-circle"></i>  Active Batch
                        </span>
                    </div>
                    <div class="rounded-4 d-flex align-items-center justify-content-center text-white shadow-sm" style="width: 55px; height: 55px; background: linear-gradient(135deg, #10b981, #059669);">
                        <i class="bi bi-laptop fs-4"></i>
                    </div>
                </div>
            </div>
        </div>

        <!-- MCQs Metric Card -->
        <div class="col-xl-3 col-sm-6">
            <div class="card border-0 shadow-sm rounded-4 p-4 h-100 transition-hover bg-white position-relative overflow-hidden">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <span class="text-muted small fw-semibold text-uppercase tracking-wider"> MCQs Completed</span>
                        <h2 class="fw-bold text-dark mt-2 mb-0">@ViewBag.McqCount</h2>
                        <span class="badge bg-purple-subtle text-purple rounded-pill mt-2 px-2 py-1" style="font-size: 0.75rem; background-color: #f3e8ff; color: #7c3aed;">
                            <i class="bi bi-journal-check"></i> Assessments
                        </span>
                    </div>
                    <div class="rounded-4 d-flex align-items-center justify-content-center text-white shadow-sm" style="width: 55px; height: 55px; background: linear-gradient(135deg, #8b5cf6, #7c3aed);">
                        <i class="bi bi-journal-richtext fs-4"></i>
                    </div>
                </div>
            </div>
        </div>

       
        <!-- Certificates Metric Card -->
        <div class="col-xl-3 col-sm-6">
            <div class="card border-0 shadow-sm rounded-4 p-4 h-100 transition-hover bg-white position-relative overflow-hidden">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <span class="text-muted small fw-semibold text-uppercase tracking-wider">Certified Students</span>
                        <h2 class="fw-bold text-dark mt-2 mb-0">@ViewBag.CertifiedStudentsCount</h2>
                        <span class="badge bg-danger-subtle text-danger rounded-pill mt-2 px-2 py-1" style="font-size: 0.75rem;">
                            <i class="bi bi-award"></i> Completed
                        </span>
                    </div>
                    <div class="rounded-4 d-flex align-items-center justify-content-center text-white shadow-sm" style="width: 55px; height: 55px; background: linear-gradient(135deg, #ef4444, #dc2626);">
                        <i class="bi bi-award-fill fs-4"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Quick Actions Section Heading -->
    <div class="d-flex align-items-center justify-content-between mb-3 mt-4">
        <div>
            <h4 class="fw-bold text-dark m-0"><i class="bi bi-lightning-charge-fill text-warning me-2"></i> Quick Actions</h4>
            <p class="text-muted small m-0">Access your teaching modules, live classes, and reports instantly.</p>
        </div>
    </div>

    <!-- Interactive Quick Action Cards Grid -->
    <div class="row g-4">
        <!-- 1. Webinar Videos -->
        <div class="col-xl-4 col-md-6">
            <div class="card border-0 shadow-sm rounded-4 p-4 h-100 transition-card bg-white position-relative">
                <div class="d-flex align-items-start justify-content-between mb-3">
                    <div class="rounded-4 d-flex align-items-center justify-content-center text-white shadow-sm" style="width: 55px; height: 55px; background: linear-gradient(135deg, #6366f1, #4f46e5);">
                        <i class="bi bi-camera-video-fill fs-4"></i>
                    </div>
                    <span class="badge bg-indigo-subtle text-indigo rounded-pill px-3 py-1 fw-medium" style="background-color: #e0e7ff; color: #4f46e5; font-size: 0.75rem;">Video Hub</span>
                </div>
                <h5 class="fw-bold text-dark mb-1">Webinar Videos</h5>
                <p class="text-muted small mb-4">HEM - Virtues Webinar recordings and training sessions.</p>
                <div class="mt-auto">
                    <a href="https://www.youtube.com/playlist?list=PL_cukav0qxOc0bimn8rG0m_3mL4KYjJf1" target="_blank" class="btn btn-outline-primary btn-sm rounded-pill px-4 fw-semibold w-100 d-flex align-items-center justify-content-center gap-2">
                        <span>Open Hub</span> <i class="bi bi-arrow-right"></i>
                    </a>
                </div>
            </div>
        </div>

        <!-- 2. MCQ -->
        <div class="col-xl-4 col-md-6">
            <div class="card border-0 shadow-sm rounded-4 p-4 h-100 transition-card bg-white position-relative">
                <div class="d-flex align-items-start justify-content-between mb-3">
                    <div class="rounded-4 d-flex align-items-center justify-content-center text-white shadow-sm" style="width: 55px; height: 55px; background: linear-gradient(135deg, #10b981, #059669);">
                        <i class="bi bi-ui-checks-grid fs-4"></i>
                    </div>
                    <span class="badge bg-success-subtle text-success rounded-pill px-3 py-1 fw-medium" style="font-size: 0.75rem;">Assessments</span>
                </div>
                <h5 class="fw-bold text-dark mb-1">MCQ Manager</h5>
                <p class="text-muted small mb-4">Create and manage multiple choice questions for evaluations.</p>
                <div class="mt-auto">
                   <button type="button" class="btn btn-outline-success btn-sm rounded-pill px-4 fw-semibold w-100 d-flex align-items-center justify-content-center gap-2" onclick="location.href='/Teacher/McqHub'">
    <span>Open Manager</span> <i class="bi bi-arrow-right"></i>
</button>
                </div>
            </div>
        </div>

        <!-- 3. PBL Reports -->
        <div class="col-xl-4 col-md-6">
            <div class="card border-0 shadow-sm rounded-4 p-4 h-100 transition-card bg-white position-relative">
                <div class="d-flex align-items-start justify-content-between mb-3">
                    <div class="rounded-4 d-flex align-items-center justify-content-center text-white shadow-sm" style="width: 55px; height: 55px; background: linear-gradient(135deg, #ef4444, #dc2626);">
                        <i class="bi bi-file-earmark-pdf-fill fs-4"></i>
                    </div>
                    <span class="badge bg-danger-subtle text-danger rounded-pill px-3 py-1 fw-medium" style="font-size: 0.75rem;">Reports</span>
                </div>
                <h5 class="fw-bold text-dark mb-1">PBL Reports</h5>
                <p class="text-muted small mb-4">Generate and download comprehensive performance reports.</p>
                <div class="mt-auto">
                    <a href="/api/report/pbl-report-teacher" target="_blank" class="btn btn-outline-danger btn-sm rounded-pill px-4 fw-semibold w-100 d-flex align-items-center justify-content-center gap-2">
                        <span>PBL Report</span> <i class="bi bi-download"></i>
                    </a>
                </div>
            </div>
        </div>

        <!-- 4. Certificate Student -->
        <div class="col-xl-4 col-md-6">
            <div class="card border-0 shadow-sm rounded-4 p-4 h-100 transition-card bg-white position-relative">
                <div class="d-flex align-items-start justify-content-between mb-3">
                    <div class="rounded-4 d-flex align-items-center justify-content-center text-white shadow-sm" style="width: 55px; height: 55px; background: linear-gradient(135deg, #f59e0b, #d97706);">
                        <i class="bi bi-file-earmark-text-fill fs-4"></i>
                    </div>
                    <span class="badge bg-warning-subtle text-warning rounded-pill px-3 py-1 fw-medium" style="font-size: 0.75rem;">Resources</span>
                </div>
                <h5 class="fw-bold text-dark mb-1">Certified Students</h5>
                <p class="text-muted small mb-4">Upload notes, assignments, and study handouts for students.</p>
                <div class="mt-auto">
                    <a href="/api/report/certified-students-report" target="_blank" class="btn btn-outline-warning btn-sm rounded-pill px-4 fw-semibold w-100 d-flex align-items-center justify-content-center gap-2 text-dark">
                        <span>Download</span> <i class="bi bi-arrow-right"></i>
                    </a>
                </div>
            </div>
        </div>

        <!-- 5. Google Meet -->
        <div class="col-xl-4 col-md-6">
            <div class="card border-0 shadow-sm rounded-4 p-4 h-100 transition-card bg-white position-relative">
                <div class="d-flex align-items-start justify-content-between mb-3">
                    <div class="rounded-4 d-flex align-items-center justify-content-center text-white shadow-sm" style="width: 55px; height: 55px; background: linear-gradient(135deg, #0ea5e9, #0284c7);">
                        <i class="bi bi-camera-video fs-4"></i>
                    </div>
                    <span class="badge bg-info-subtle text-info rounded-pill px-3 py-1 fw-medium" style="font-size: 0.75rem;">Live Class</span>
                </div>
                <h5 class="fw-bold text-dark mb-1">Google Meet</h5>
                <p class="text-muted small mb-4">Start or join your online classes and virtual meetings instantly.</p>
                <div class="mt-auto">
                    <a href="https://meet.google.com" target="_blank" class="btn btn-outline-info btn-sm rounded-pill px-4 fw-semibold w-100 d-flex align-items-center justify-content-center gap-2">
                        <span>Launch Meet</span> <i class="bi bi-box-arrow-up-right"></i>
                    </a>
                </div>
            </div>
        </div>

        <!-- 6. Teacher Handout -->
        <div class="col-xl-4 col-md-6">
            <div class="card border-0 shadow-sm rounded-4 p-4 h-100 transition-card bg-white position-relative">
                <div class="d-flex align-items-start justify-content-between mb-3">
                    <div class="rounded-4 d-flex align-items-center justify-content-center text-white shadow-sm" style="width: 55px; height: 55px; background: linear-gradient(135deg, #64748b, #475569);">
                        <i class="bi bi-journal-bookmark-fill fs-4"></i>
                    </div>
                    <span class="badge bg-secondary-subtle text-secondary rounded-pill px-3 py-1 fw-medium" style="font-size: 0.75rem;">Manuals</span>
                </div>
                <h5 class="fw-bold text-dark mb-1">Teacher Handout</h5>
                <p class="text-muted small mb-4">Access official teaching materials, syllabus, and guide resources.</p>
                <div class="mt-auto">
                    <a href="/Values/Display" class="btn btn-outline-secondary btn-sm rounded-pill px-4 fw-semibold w-100 d-flex align-items-center justify-content-center gap-2">
                        <span>View Guide</span> <i class="bi bi-book"></i>
                    </a>
                </div>
            </div>
        </div>
    </div>
    <div class="card border shadow-sm rounded-4 bg-white p-4 mt-3">
        <script>
                    window.evaluationApiUrl = "/api/project-evaluations/teacher-history";
        </script>
        <partial name="~/Views/Dashboard/Partials/_EvaluationCard.cshtml" />
    </div>
</div>

<!-- Custom CSS for Hover Transitions & Smooth Effects -->
<style>
    .transition-hover {
        transition: all 0.3s ease-in-out;
    }
    .transition-hover:hover {
        transform: translateY(-5px);
        box-shadow: 0 .5rem 1.5rem rgba(0,0,0,.08) !important;
    }
    .transition-card {
        transition: all 0.3s ease-in-out;
        border: 1px solid rgba(0,0,0,0.03) !important;
    }
    .transition-card:hover {
        transform: translateY(-6px);
        box-shadow: 0 1rem 2rem rgba(0,0,0,0.06) !important;
        border-color: rgba(13, 110, 253, 0.2) !important;
    }
</style>