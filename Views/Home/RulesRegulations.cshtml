@{
    ViewData["Title"] = "Rules & Regulations";
}

<section class="py-5 bg-light">
    <div class="container">
        <!-- Welcome Card -->
        <div class="card border-0 shadow-sm mb-4">
            <div class="card-body p-4 p-md-5">
                <div class="row align-items-center">
                    <div class="col-md-2 text-center mb-3 mb-md-0">
                        <i class="fas fa-handshake fa-4x text-primary"></i>
                    </div>
                    <div class="col-md-10">
                        <h3 class="font-weight-bold mb-3">Welcome to the Academic World of Values</h3>
                        <p class="text-muted mb-0">
                            <strong>HEM Virtues</strong> welcomes you to an inspiring platform dedicated to nurturing human values among students. Teachers play a vital role in shaping future generations and HEMA Foundation proudly recognizes your contribution towards creating responsible citizens.
                        </p>
                    </div>
                </div>
            </div>
        </div>

        <!-- Statistics -->
        <div class="row mb-4">
            <div class="col-lg-3 col-md-6 mb-3">
                <div class="card border-0 shadow-sm text-center h-100">
                    <div class="card-body">
                        <i class="fas fa-heart fa-2x text-danger mb-3"></i>
                        <h2 class="font-weight-bold mb-1">50</h2>
                        <p class="text-muted mb-0">Core Values</p>
                    </div>
                </div>
            </div>
            <div class="col-lg-3 col-md-6 mb-3">
                <div class="card border-0 shadow-sm text-center h-100">
                    <div class="card-body">
                        <i class="fas fa-star fa-2x text-warning mb-3"></i>
                        <h2 class="font-weight-bold mb-1">4000</h2>
                        <p class="text-muted mb-0">Maximum Marks</p>
                    </div>
                </div>
            </div>
            <div class="col-lg-3 col-md-6 mb-3">
                <div class="card border-0 shadow-sm text-center h-100">
                    <div class="card-body">
                        <i class="fas fa-gift fa-2x text-success mb-3"></i>
                        <h2 class="font-weight-bold mb-1">400</h2>
                        <p class="text-muted mb-0">Bonus Marks</p>
                    </div>
                </div>
            </div>
            <div class="col-lg-3 col-md-6 mb-3">
                <div class="card border-0 shadow-sm text-center h-100">
                    <div class="card-body">
                        <i class="fas fa-award fa-2x text-primary mb-3"></i>
                        <h2 class="font-weight-bold mb-1">5</h2>
                        <p class="text-muted mb-0">Award Levels</p>
                    </div>
                </div>
            </div>
        </div>

        <!-- Accordion -->
        <div class="accordion" id="rulesAccordion">
            <!-- General Guidelines -->
            <div class="accordion-item mb-3">
                <h2 class="accordion-header" id="headingGeneral">
                    <button class="accordion-button" type="button" data-bs-toggle="collapse" data-bs-target="#generalRules">
                        <i class="fas fa-info-circle text-primary me-2"></i> General Guidelines
                    </button>
                </h2>
                <div id="generalRules" class="accordion-collapse collapse show" data-bs-parent="#rulesAccordion">
                    <div class="accordion-body">
                        <div class="row">
                            <div class="col-md-6">
                                <ul class="list-unstyled mb-0">
                                    <li class="mb-3">
                                        <i class="fas fa-school text-primary me-2"></i> Teachers from any authorized school can register and participate in the <strong>HEM Virtues</strong> program.
                                    </li>
                                    <li class="mb-3">
                                        <i class="fas fa-user-plus text-success me-2"></i> Registration is simple and can be completed through the <strong>Teacher Onboarding</strong> portal.
                                    </li>
                                </ul>
                            </div>
                            <div class="col-md-6">
                                <ul class="list-unstyled mb-0">
                                    <li class="mb-3">
                                        <i class="fas fa-tachometer-alt text-warning me-2"></i> After successful registration, every teacher receives a personalized dashboard to manage activities and monitor progress.
                                    </li>
                                    <li>
                                        <i class="fas fa-chart-line text-info me-2"></i> The dashboard provides real-time updates, participation tracking, performance insights, and overall contribution statistics.
                                    </li>
                                </ul>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- NEP -->
            <div class="accordion-item mb-3">
                <h2 class="accordion-header" id="headingNEP">
                    <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#nepRules">
                        <i class="fas fa-graduation-cap text-success me-2"></i> NEP Based Grade Wise Value Evaluation
                    </button>
                </h2>
                <div id="nepRules" class="accordion-collapse collapse" data-bs-parent="#rulesAccordion">
                    <div class="accordion-body">
                        <div class="row">
                            <div class="col-md-6">
                                <ul class="list-unstyled mb-0">
                                    <li class="mb-3">
                                        <i class="fas fa-book-open text-success me-2"></i> The HEM Virtues portal covers <strong>50 foundational human values</strong> organized into <strong>four structured categories</strong> in alignment with the objectives of <strong>NEP 2020</strong>.
                                    </li>
                                    <li class="mb-3">
                                        <i class="fas fa-video text-danger me-2"></i> Every value includes engaging <strong>instructional video lessons</strong> along with downloadable <strong>PDF learning resources</strong> to support classroom and self-paced learning.
                                    </li>
                                    <li class="mb-3">
                                        <i class="fas fa-question-circle text-primary me-2"></i> Each topic concludes with a <strong>5-question MCQ assessment</strong> designed to evaluate students' understanding of the concepts presented in the video lessons.
                                    </li>
                                    <li>
                                        <i class="fas fa-star text-warning me-2"></i> Every value carries a total weightage of <strong>80 marks</strong>, combining knowledge-based assessments with practical value-oriented activities.
                                    </li>
                                </ul>
                            </div>
                            <div class="col-md-6">
                                <ul class="list-unstyled mb-0">
                                    <li class="mb-3">
                                        <i class="fas fa-award text-warning me-2"></i> Successful completion of all <strong>50 values</strong> enables students to achieve a maximum cumulative score of <strong>4,000 marks</strong>.
                                    </li>
                                    <li class="mb-3">
                                        <i class="fas fa-gift text-success me-2"></i> Students earn an additional <strong>400 Bonus Marks</strong> upon successfully completing each set of five core values within a learning module.
                                    </li>
                                    <li class="mb-3">
                                        <i class="fas fa-medal text-info me-2"></i> Based on their overall performance, students are recognized with achievement levels including <strong>Platinum, Diamond, Gold, Silver,</strong> and <strong>Bronze</strong>.
                                    </li>
                                    <li>
                                        <i class="fas fa-trophy text-danger me-2"></i> Outstanding performers from participating schools are honoured by the <strong>HEMA Foundation</strong> during the prestigious annual <strong>Hemostav Ceremony</strong>.
                                    </li>
                                </ul>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Task -->
            <div class="accordion-item">
                <h2 class="accordion-header" id="headingTask">
                    <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#taskRules">
                        <i class="fas fa-tasks text-info me-2"></i> Task Evaluation Guidelines
                    </button>
                </h2>
                <div id="taskRules" class="accordion-collapse collapse" data-bs-parent="#rulesAccordion">
                    <div class="accordion-body">
                        <div class="row">
                            <div class="col-md-6">
                                <ul class="list-unstyled mb-0">
                                    <li class="mb-3">
                                        <i class="fas fa-tasks text-primary me-2"></i> Each core value is structured into <strong>12 engaging learning activities</strong>, including Accelerated Learning exercises and Moral Story based assignments to strengthen practical understanding.
                                    </li>
                                    <li class="mb-3">
                                        <i class="fas fa-users text-success me-2"></i> Students actively participate in value-based activities that encourage experiential learning, teamwork, creativity, and responsible behaviour.
                                    </li>
                                </ul>
                            </div>
                            <div class="col-md-6">
                                <ul class="list-unstyled mb-0">
                                    <li class="mb-3">
                                        <i class="fas fa-chalkboard-teacher text-warning me-2"></i> Teachers evaluate each activity using the assessment criteria and guidelines provided for every task, ensuring fair and consistent evaluation.
                                    </li>
                                    <li class="mb-3">
                                        <i class="fas fa-certificate text-info me-2"></i> Students who successfully achieve the required milestones receive secure, co-branded <strong>Digital E-Certificates</strong> issued through the HEM Virtues platform.
                                    </li>
                                    <li>
                                        <i class="fas fa-check-circle text-danger me-2"></i> To qualify for certification, students must correctly answer at least <strong>3 out of 5 MCQs</strong> for each value and complete a minimum of <strong>50% of the assigned practical activities</strong>.
                                    </li>
                                </ul>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>