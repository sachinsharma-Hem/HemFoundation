@using Microsoft.Extensions.Configuration
@using System

@inject IConfiguration Configuration

@{
    ViewData["Title"] = "Manage Bulk Upload Reports";
    Layout = "~/Views/Shared/Layouts/_AdminLayout.cshtml";

    int? valueItemId = null;

    if (ViewBag.ValueItemId != null)
    {
        int parsedValue;

        if (int.TryParse(ViewBag.ValueItemId.ToString(), out parsedValue))
        {
            valueItemId = parsedValue;
        }
    }

    string fileUploadApiUrl =
        Configuration["FileSettings:InHouseUploadUrl"] ?? "";

    string fileBaseUrl = "";

    if (Uri.TryCreate(
        fileUploadApiUrl,
        UriKind.Absolute,
        out Uri? fileUri))
    {
        fileBaseUrl =
            $"{fileUri.Scheme}://{fileUri.Authority}";
    }
}
<div class="container-fluid py-4">
    <div class="card border-0 shadow-sm rounded-4 bg-white p-4">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h4 class="fw-bold text-dark m-0">
                <i class="bi bi-file-earmark-spreadsheet-fill text-primary me-2"></i> Manage Bulk Uploads
            </h4>
            <button class="btn btn-light btn-sm rounded-pill fw-bold border shadow-sm" onclick="loadBulkLogs()">
                <i class="bi bi-arrow-clockwise me-1"></i> Refresh
            </button>
        </div>

        <!-- SEARCH / FILTER BAR & PAGE SIZE -->
        <div class="row g-3 mb-3 align-items-center">
            <div class="col-md-4">
                <input type="text" class="form-control rounded-pill bg-light border-0 px-3 shadow-none" id="searchSchool" placeholder="Filter by School Name..." onkeyup="resetPaginationAndFilter()" />
            </div>
            <div class="col-md-3">
                <select class="form-select rounded-pill bg-light border-0 px-3 shadow-none" id="filterType" onchange="resetPaginationAndFilter()">
                    <option value="">All Types (Student/Teacher)</option>
                    <option value="student">Student</option>
                    <option value="teacher">Teacher</option>
                    <option value="volunteer">Volunteer</option>
                </select>
            </div>
            <div class="col-md-3">
                <select class="form-select rounded-pill bg-light border-0 px-3 shadow-none" id="filterStatus" onchange="resetPaginationAndFilter()">
                    <option value="">All Statuses</option>
                    <option value="Completed">Completed</option>
                    <option value="In Progress">In Progress</option>
                    <option value="Failed">Failed</option>
                </select>
            </div>
            <div class="col-md-2 text-md-end">
                <select class="form-select rounded-pill bg-light border-0 px-2 shadow-none d-inline-block w-auto" id="pageSize" onchange="resetPaginationAndFilter()">
                    <option value="10">10 per page</option>
                    <option value="25" selected>25 per page</option>
                    <option value="50">50 per page</option>
                    <option value="100">100 per page</option>
                </select>
            </div>
        </div>

        <!-- TABLE WITH SERIAL NUMBER -->
        <div class="table-responsive">
            <table class="table table-hover align-middle border rounded-3 overflow-hidden" id="bulkLogsTable">
                <thead class="table-light">
                    <tr>
                        <th class="text-secondary small fw-bold text-uppercase" style="width: 60px;">S.No.</th>
                        <th class="text-secondary small fw-bold text-uppercase">School Name</th>
                        <th class="text-secondary small fw-bold text-uppercase">Type</th>
                        <th class="text-secondary small fw-bold text-uppercase">File Name</th>
                        <th class="text-secondary small fw-bold text-uppercase">Upload Date</th>
                        <th class="text-secondary small fw-bold text-uppercase">Status</th>
                        <th class="text-secondary small fw-bold text-uppercase text-center">Action</th>
                    </tr>
                </thead>
                <tbody>
                    <tr><td colspan="7" class="text-center text-muted py-4">Loading reports...</td></tr>
                </tbody>
            </table>
        </div>

        <!-- PAGINATION CONTROLS FOOTER -->
        <div class="d-flex justify-content-between align-items-center mt-3 px-2">
            <div class="small text-muted" id="paginationInfo">Showing 0 to 0 of 0 entries</div>
            <nav aria-label="Page navigation">
                <ul class="pagination pagination-sm mb-0 rounded-pill" id="paginationControls">
                    <!-- Dynamic Pagination Buttons -->
                </ul>
            </nav>
        </div>
    </div>
</div>

<!-- ================= INTELLIGENT PREVIEW & MAP MODAL ================= -->
<div class="modal fade" id="previewModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-xl">
        <div class="modal-content rounded-4 border-0 shadow-lg p-4">
            <div class="modal-header border-bottom-0 pb-0">
                <h5 class="fw-bold text-dark"><i class="bi bi-robot text-success me-2"></i> Smart Excel Column Detection & Preview</h5>
                <button type="button" class="btn-close shadow-none" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <p class="text-muted small mb-3">System has automatically mapped your columns. Review the preview below before starting registration.</p>
                <input type="hidden" id="previewLogId" />
                <input type="hidden" id="previewFilePath" />

                <div class="table-responsive border rounded-3 mb-4" style="max-height: 350px;">
                    <table class="table table-striped table-sm mb-0" id="previewTable">
                        <thead class="table-light"></thead>
                        <tbody></tbody>
                    </table>
                </div>

                <!-- Progress & Timer Bar -->
                <div id="importProgressContainer" class="d-none mb-3">
                    <div class="d-flex justify-content-between small fw-bold mb-1 text-success">
                        <span>Processing data in background...</span>
                        <span id="timerCounter">0s elapsed</span>
                    </div>
                    <div class="progress rounded-pill" style="height: 10px;">
                        <div class="progress-bar progress-bar-striped progress-bar-animated bg-success w-100"></div>
                    </div>
                </div>

                <div class="d-flex justify-content-end gap-2">
                    <button type="button" class="btn btn-light rounded-pill px-4" data-bs-dismiss="modal">Cancel</button>
                    <button type="button" class="btn btn-success rounded-pill px-4 fw-bold shadow-sm" id="btnConfirmImport" onclick="startFastImport()">
                        <i class="bi bi-play-circle me-1"></i> Agree & Start Registration
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="successPopupModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content rounded-4 border-0 shadow-lg p-4 text-center">
            <div class="mb-3">
                <i class="bi bi-check-circle-fill text-success display-4"></i>
            </div>
            <h5 class="fw-bold text-dark mb-2">Operation Summary</h5>
            <p class="text-muted mb-4" id="successPopupMessage">Operation completed successfully.</p>
            <button type="button" class="btn btn-success w-100 rounded-pill fw-bold py-2" data-bs-dismiss="modal">OK</button>
        </div>
    </div>
</div>

@section Scripts {
    <script>
      

        const fileBaseUrl = '@Html.Raw(fileBaseUrl)';

        function getFileUrl(filePath) {

            if (!filePath) {
                return '#';
            }

            if (
                filePath.startsWith('http://') ||
                filePath.startsWith('https://')
            ) {
                return filePath;
            }

            let cleanPath =
                filePath.replace(/^\/+/, '');

            return fileBaseUrl.replace(/\/+$/, '') +
                '/' +
                cleanPath;
        }
        function getDownloadUrl(filePath) {

            if (!filePath) {
                return '#';
            }

            return '/api/admin/download-bulk-file?filePath='
                + encodeURIComponent(filePath);
        }
        let allLogsData = [];
        let currentPage = 1;

        $(document).ready(function() {
            loadBulkLogs();
        });

        function loadBulkLogs() {
            $('#bulkLogsTable tbody').html('<tr><td colspan="7" class="text-center text-muted py-4"><span class="spinner-border spinner-border-sm me-2"></span> Loading...</td></tr>');

            $.get('/api/admin/bulk-logs', function(res) {
                if (res.success) {
                    allLogsData = res.data;
                    filterAndRenderTable();
                }
            }).fail(function() {
                $('#bulkLogsTable tbody').html('<tr><td colspan="7" class="text-center text-danger py-4">Error loading data.</td></tr>');
            });
        }

        function resetPaginationAndFilter() {
            currentPage = 1;
            filterAndRenderTable();
        }

        function filterAndRenderTable() {
            let search = $('#searchSchool').val().toLowerCase();
            let type = $('#filterType').val().toLowerCase();
            let status = $('#filterStatus').val().toLowerCase();

            let filtered = allLogsData.filter(log => {
                let matchSchool = log.schoolName.toLowerCase().includes(search);
                let matchType = type === "" || log.uploadType.toLowerCase().includes(type);
                let matchStatus = status === "" || log.status.toLowerCase().includes(status);
                return matchSchool && matchType && matchStatus;
            });

            renderPagedTable(filtered);
        }

        function renderPagedTable(data) {
            let pageSize = parseInt($('#pageSize').val()) || 25;
            let totalRecords = data.length;
            let totalPages = Math.ceil(totalRecords / pageSize) || 1;

            if (currentPage > totalPages) currentPage = totalPages;
            if (currentPage < 1) currentPage = 1;

            let startIndex = (currentPage - 1) * pageSize;
            let endIndex = startIndex + pageSize;
            let pagedData = data.slice(startIndex, endIndex);

            let rows = '';
            if (pagedData.length === 0) {
                rows = '<tr><td colspan="7" class="text-center text-muted py-4">No bulk uploads found.</td></tr>';
            } else {
                pagedData.forEach((log, index) => {
                    let serialNo = startIndex + index + 1;
                    let badgeClass = getStatusBadgeClass(log.status);
                    let dateStr = new Date(log.uploadedDate).toLocaleString();

                    rows += `
                        <tr>
                            <td class="fw-bold text-muted">${serialNo}</td>
                            <td class="fw-semibold text-dark">${log.schoolName}</td>
                            <td><span class="badge bg-light text-dark border">${log.uploadType}</span></td>
                            <td>
                                               <a href="${getDownloadUrl(log.filePath)}"
           class="text-decoration-none text-success fw-semibold"
           title="Download Excel">
            <i class="bi bi-file-earmark-excel text-success me-1"></i>
            ${log.fileName}
        </a>
                            </td>
                            <td class="small text-muted">${dateStr}</td>
                            <td><span class="badge ${badgeClass} px-2 py-1">${log.status}</span></td>
                            <td class="text-center">
                                <div class="btn-group shadow-sm">
                                                 <a href="${getDownloadUrl(log.filePath)}" target="_blank"
           class="btn btn-sm btn-light border-end"
           title="Download Excel">
            <i class="bi bi-download text-primary"></i>
        </a>
                                    <button type="button" class="btn btn-sm btn-light border-end" title="Smart Upload & Preview" onclick="openSmartPreview(${log.logID})">
                                        <i class="bi bi-magic text-success"></i>
                                    </button>
                                    <button type="button" class="btn btn-sm btn-light text-danger" title="Delete Record" onclick="deleteBulkLog(${log.logID})">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </div>
                            </td>
                        </tr>
                    `;
                });
            }
            $('#bulkLogsTable tbody').html(rows);

            let startDisplay = totalRecords > 0 ? startIndex + 1 : 0;
            let endDisplay = Math.min(endIndex, totalRecords);
            $('#paginationInfo').text(`Showing ${startDisplay} to ${endDisplay} of ${totalRecords} entries`);

            let paginationHtml = '';
            paginationHtml += `<li class="page-item ${currentPage === 1 ? 'disabled' : ''}">
                <a class="page-link" href="#" onclick="changePage(${currentPage - 1}); return false;">Prev</a>
            </li>`;

            for (let p = 1; p <= totalPages; p++) {
                if (p === 1 || p === totalPages || (p >= currentPage - 1 && p <= currentPage + 1)) {
                    paginationHtml += `<li class="page-item ${p === currentPage ? 'active' : ''}">
                        <a class="page-link" href="#" onclick="changePage(${p}); return false;">${p}</a>
                    </li>`;
                } else if (p === currentPage - 2 || p === currentPage + 2) {
                    paginationHtml += `<li class="page-item disabled"><span class="page-link">...</span></li>`;
                }
            }

            paginationHtml += `<li class="page-item ${currentPage === totalPages || totalPages === 0 ? 'disabled' : ''}">
                <a class="page-link" href="#" onclick="changePage(${currentPage + 1}); return false;">Next</a>
            </li>`;

            $('#paginationControls').html(paginationHtml);
        }

        function changePage(page) {
            currentPage = page;
            filterAndRenderTable();
        }

        function openSmartPreview(logId) {
            let input = $('<input type="file" accept=".xlsx, .xls" />');
            input.click();
            input.on('change', function(e) {
                let file = e.target.files[0];
                if (!file) return;

                let formData = new FormData();
                formData.append('logId', logId);
                formData.append('excelFile', file);

                showSuccessPopup("Analyzing excel columns intelligently...");
                $('#successPopupModal').modal('hide');

                $.ajax({
                    url: '/api/admin/preview-excel',
                    type: 'POST',
                    data: formData,
                    processData: false,
                    contentType: false,
                   success: function(res) {
        if (res.success) {
            $('#previewLogId').val(logId);
            $('#previewFilePath').val(res.filePath);

            let thead = '<tr>';
            res.columns.forEach(c => {
                let mappedField = res.columnMapping[c] || 'Unmapped';
                thead += `<th>${c}<br><small class="text-success fw-normal" style="font-size: 10px;">➔ ${mappedField}</small></th>`;
            });
            thead += '</tr>';
            $('#previewTable thead').html(thead);

            let tbody = '';
            res.previewData.forEach(row => {
                tbody += '<tr>';
                res.columns.forEach(c => tbody += `<td>${row[c] || '<span class="text-muted fst-italic">null</span>'}</td>`);
                tbody += '</tr>';
            });
            $('#previewTable tbody').html(tbody);

            $('#importProgressContainer').addClass('d-none');
            $('#btnConfirmImport').prop('disabled', false);
            $('#previewModal').modal('show');
        } else {
            alert(res.message);
        }
                    },
                    error: function(xhr) {
                        alert(xhr.responseJSON?.message || "Failed to preview excel.");
                    }
                });
            });
        }

        let timerInterval;
        let secondsElapsed = 0;

        function startFastImport() {
            let logId = $('#previewLogId').val();
            let filePath = $('#previewFilePath').val();

            $('#importProgressContainer').removeClass('d-none');
            $('#btnConfirmImport').prop('disabled', true);

            secondsElapsed = 0;
            clearInterval(timerInterval);
            timerInterval = setInterval(() => {
                secondsElapsed++;
                $('#timerCounter').text(secondsElapsed + 's elapsed');
            }, 1000);

            $.post('/api/admin/process-mapped-excel', { logId: logId, filePath: filePath }, function(res) {
                clearInterval(timerInterval);
                if (res.success) {
                    $('#previewModal').modal('hide');
                    showSuccessPopup(res.message);
                    loadBulkLogs();
                } else {
                    alert(res.message);
                    $('#btnConfirmImport').prop('disabled', false);
                }
            }).fail(function(xhr) {
                clearInterval(timerInterval);
                alert(xhr.responseJSON?.message || "Failed to process import.");
                $('#btnConfirmImport').prop('disabled', false);
            });
        }

        function deleteBulkLog(id) {
            if (confirm("Are you sure you want to delete this upload log?")) {
                $.ajax({
                    url: `/api/admin/delete-bulk-log/${id}`,
                    type: 'DELETE',
                    success: function(res) {
                        if (res.success) {
                            showSuccessPopup(res.message);
                            loadBulkLogs();
                        } else {
                            alert(res.message);
                        }
                    },
                    error: function() {
                        alert("Failed to delete record.");
                    }
                });
            }
        }

        function showSuccessPopup(message) {
            $('#successPopupMessage').text(message);
            $('#successPopupModal').modal('show');
        }

        function getStatusBadgeClass(status) {
            status = status ? status.toLowerCase() : "";
            if (status.includes("success") || status === "completed") return "bg-success-subtle text-success border border-success-subtle";
            if (status.includes("progress")) return "bg-warning-subtle text-warning border border-warning-subtle";
            if (status.includes("fail") || status.includes("reject")) return "bg-danger-subtle text-danger border border-danger-subtle";
            return "bg-secondary-subtle text-secondary border border-secondary-subtle";
        }
    </script>
}