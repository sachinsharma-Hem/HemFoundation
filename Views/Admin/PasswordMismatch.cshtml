
@{
    ViewData["Title"] = "Password Mismatch Manager";
    Layout = "~/Views/Shared/Layouts/_AdminLayout.cshtml";
}

<div class="container-fluid py-4">

    <!-- ========================================================= -->
    <!-- HEADER -->
    <!-- ========================================================= -->

    <div class="d-flex flex-wrap align-items-center justify-content-between mb-4">

        <div>
            <h3 class="fw-bold text-dark mb-1">
                <i class="bi bi-shield-lock text-primary me-2"></i>
                Password Mismatch Manager
            </h3>

            <p class="text-muted mb-0">
                Identify users whose stored password does not match
                their ASP.NET Identity password hash.
            </p>
        </div>

        <div class="mt-3 mt-md-0">

            <button type="button"
                    class="btn btn-outline-primary"
                    id="btnRefresh">

                <i class="bi bi-arrow-clockwise me-1"></i>
                Check Again

            </button>

            <button type="button"
                    class="btn btn-danger ms-2"
                    id="btnFixSelected"
                    disabled>

                <i class="bi bi-shield-check me-1"></i>
                Fix Selected

                <span class="badge bg-white text-danger ms-1"
                      id="fixSelectedBadge"
                      style="display:none;">
                    0
                </span>

            </button>

        </div>

    </div>


    <!-- ========================================================= -->
    <!-- SECURITY WARNING -->
    <!-- ========================================================= -->

    <div class="alert alert-warning border-0 shadow-sm">

        <div class="d-flex">

            <div class="me-3">
                <i class="bi bi-exclamation-triangle-fill fs-4"></i>
            </div>

            <div>

                <strong>Security Notice</strong>

                <div class="small mt-1">

                    Passwords are checked on the server and are never
                    displayed on this page.

                    Only users whose password verification fails are
                    shown below.

                </div>

            </div>

        </div>

    </div>


    <!-- ========================================================= -->
    <!-- STATISTICS -->
    <!-- ========================================================= -->

    <div class="row g-3 mb-4">

        <!-- Mismatch -->
        <div class="col-md-4">

            <div class="card border-0 shadow-sm h-100">

                <div class="card-body">

                    <div class="d-flex align-items-center">

                        <div class="rounded-circle bg-primary-subtle p-3 me-3">

                            <i class="bi bi-people text-primary fs-4"></i>

                        </div>

                        <div>

                            <div class="text-muted small">
                                Mismatch Users
                            </div>

                            <h3 class="fw-bold mb-0"
                                id="mismatchCount">
                                0
                            </h3>

                        </div>

                    </div>

                </div>

            </div>

        </div>


        <!-- Selected -->
        <div class="col-md-4">

            <div class="card border-0 shadow-sm h-100">

                <div class="card-body">

                    <div class="d-flex align-items-center">

                        <div class="rounded-circle bg-danger-subtle p-3 me-3">

                            <i class="bi bi-check2-square text-danger fs-4"></i>

                        </div>

                        <div>

                            <div class="text-muted small">
                                Selected
                            </div>

                            <h3 class="fw-bold mb-0"
                                id="selectedCount">
                                0
                            </h3>

                        </div>

                    </div>

                </div>

            </div>

        </div>


        <!-- Last Checked -->
        <div class="col-md-4">

            <div class="card border-0 shadow-sm h-100">

                <div class="card-body">

                    <div class="d-flex align-items-center">

                        <div class="rounded-circle bg-success-subtle p-3 me-3">

                            <i class="bi bi-clock-history text-success fs-4"></i>

                        </div>

                        <div>

                            <div class="text-muted small">
                                Last Checked
                            </div>

                            <h6 class="fw-bold mb-0"
                                id="lastChecked">
                                -
                            </h6>

                        </div>

                    </div>

                </div>

            </div>

        </div>

    </div>


    <!-- ========================================================= -->
    <!-- MAIN CARD -->
    <!-- ========================================================= -->

    <div class="card border-0 shadow-sm">

        <!-- Card Header -->
        <div class="card-header bg-white border-0 py-3">

            <div class="d-flex flex-wrap align-items-center justify-content-between">

                <div>

                    <h5 class="fw-bold mb-1">
                        Mismatched Users
                    </h5>

                    <small class="text-muted">
                        Select users whose ASP.NET Identity password hash
                        needs to be regenerated.
                    </small>

                </div>


                <div class="mt-2 mt-md-0">

                    <button type="button"
                            class="btn btn-sm btn-outline-secondary"
                            id="btnSelectAll">

                        <i class="bi bi-check2-all me-1"></i>
                        Select Page

                    </button>


                    <button type="button"
                            class="btn btn-sm btn-outline-secondary"
                            id="btnClearAll">

                        <i class="bi bi-x-circle me-1"></i>
                        Clear Page

                    </button>

                </div>

            </div>

        </div>


        <!-- ===================================================== -->
        <!-- TABLE -->
        <!-- ===================================================== -->

        <div class="card-body p-0">

            <div class="table-responsive">

                <table class="table table-hover align-middle mb-0">

                    <thead class="table-light">

                        <tr>

                            <th style="width:50px;"
                                class="text-center">

                                <input type="checkbox"
                                       class="form-check-input"
                                       id="selectAllCheckbox">

                            </th>

                            <th>User</th>

                            <th>Email</th>

                            <th>User ID</th>

                            <th>Status</th>

                        </tr>

                    </thead>


                    <tbody id="usersTableBody">

                        <tr>

                            <td colspan="5"
                                class="text-center py-5">

                                <div class="spinner-border text-primary">
                                </div>

                                <div class="text-muted mt-2">
                                    Checking password hashes...
                                </div>

                            </td>

                        </tr>

                    </tbody>

                </table>

            </div>


            <!-- ================================================= -->
            <!-- PAGINATION -->
            <!-- ================================================= -->

            <div class="d-flex flex-wrap justify-content-between
                align-items-center px-3 py-3 border-top">

                <!-- Left -->
                <div class="d-flex flex-wrap align-items-center gap-3 mb-2 mb-md-0">

                    <div class="text-muted small"
                         id="paginationInfo">

                        Showing 0 users

                    </div>


                    <!-- Users Per Page -->
                    <div class="d-flex align-items-center gap-2">

                        <label for="pageSizeSelect"
                               class="small text-muted mb-0">

                            Users per page:

                        </label>

                        <select id="pageSizeSelect"
                                class="form-select form-select-sm"
                                style="width:100px;">

                            <option value="25">
                                25
                            </option>

                            <option value="50"
                                    selected>
                                50
                            </option>

                            <option value="100">
                                100
                            </option>

                            <option value="200">
                                200
                            </option>

                            <option value="500">
                                500
                            </option>
                            <option value="1000">
                                1000
                            </option>
                            <option value="5000">
                                5000
                            </option>
                            <option value="10000">
                                10000
                            </option>
                            <option value="50000">
                                50000
                            </option>
                            <option value="100000">
                                100000

                            </option>
                            <option value="500000">
                                500000

                            </option>
                        </select>

                    </div>

                </div>


                <!-- Right -->
                <div class="d-flex align-items-center gap-2">

                    <button type="button"
                            class="btn btn-sm btn-outline-secondary"
                            id="btnPrevious"
                            disabled>

                        <i class="bi bi-chevron-left"></i>

                        Previous

                    </button>


                    <span class="small fw-semibold px-2"
                          id="pageNumber">

                        Page 1

                    </span>


                    <button type="button"
                            class="btn btn-sm btn-outline-secondary"
                            id="btnNext"
                            disabled>

                        Next

                        <i class="bi bi-chevron-right"></i>

                    </button>

                </div>

            </div>

        </div>

    </div>

</div>


<!-- ============================================================= -->
<!-- CONFIRMATION MODAL -->
<!-- ============================================================= -->

<div class="modal fade"
     id="fixPasswordModal"
     tabindex="-1"
     aria-hidden="true">

    <div class="modal-dialog modal-dialog-centered">

        <div class="modal-content border-0 shadow">

            <div class="modal-header">

                <h5 class="modal-title fw-bold">

                    <i class="bi bi-shield-exclamation text-danger me-2"></i>

                    Confirm Password Update

                </h5>

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="modal">
                </button>

            </div>


            <div class="modal-body">

                <div class="text-center py-2">

                    <div class="mb-3">

                        <i class="bi bi-key-fill text-danger"
                           style="font-size:48px;">
                        </i>

                    </div>


                    <h5 class="fw-bold">
                        Fix selected passwords?
                    </h5>


                    <p class="text-muted mb-2">

                        You have selected

                        <strong id="modalSelectedCount">
                            0
                        </strong>

                        user(s).

                    </p>


                    <p class="small text-muted">

                        The existing password from the User table
                        will be re-hashed using ASP.NET Identity and
                        saved to

                        <code>AspNetUsers.PasswordHash</code>.

                    </p>

                </div>

            </div>


            <div class="modal-footer">

                <button type="button"
                        class="btn btn-light"
                        data-bs-dismiss="modal">

                    Cancel

                </button>


                <button type="button"
                        class="btn btn-danger"
                        id="btnConfirmFix">

                    <i class="bi bi-shield-check me-1"></i>

                    Fix Passwords

                </button>

            </div>

        </div>

    </div>

</div>


<!-- ============================================================= -->
<!-- RESULT MODAL -->
<!-- ============================================================= -->

<div class="modal fade"
     id="resultModal"
     tabindex="-1"
     aria-hidden="true">

    <div class="modal-dialog modal-lg modal-dialog-centered">

        <div class="modal-content border-0 shadow">

            <div class="modal-header">

                <h5 class="modal-title fw-bold">

                    <i class="bi bi-clipboard-check text-primary me-2"></i>

                    Password Update Result

                </h5>

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="modal">
                </button>

            </div>


            <div class="modal-body">

                <div id="resultSummary"
                     class="mb-3">
                </div>


                <div class="table-responsive">

                    <table class="table table-sm table-hover">

                        <thead class="table-light">

                            <tr>

                                <th>User</th>

                                <th>User ID</th>

                                <th>Status</th>

                                <th>Message</th>

                            </tr>

                        </thead>


                        <tbody id="resultTableBody">
                        </tbody>

                    </table>

                </div>

            </div>


            <div class="modal-footer">

                <button type="button"
                        class="btn btn-primary"
                        data-bs-dismiss="modal">

                    Close

                </button>

            </div>

        </div>

    </div>

</div>


@section Scripts {

    <script>

        /*
         * ============================================================
         * GLOBAL VARIABLES
         * ============================================================
         */

        let mismatchUsers = [];

        /*
         * Contains selected users from ALL pages.
         */
        let selectedUserIds = new Set();


        /*
         * Pagination
         */

        let currentPage = 1;

        let pageSize = 50;

        let hasNextPage = false;

        let totalMismatchCount = 0;


        /*
         * Bootstrap modals
         */

        let fixPasswordModal;

        let resultModal;


        /*
         * ============================================================
         * PAGE LOAD
         * ============================================================
         */

        document.addEventListener("DOMContentLoaded", function() {

            /*
             * Bootstrap modals
             */

            fixPasswordModal =
                new bootstrap.Modal(
                    document.getElementById("fixPasswordModal")
                );


            resultModal =
                new bootstrap.Modal(
                    document.getElementById("resultModal")
                );


            /*
             * Initial load
             */

            loadMismatchUsers(1);


            /*
             * ========================================================
             * REFRESH
             * ========================================================
             */

            document.getElementById("btnRefresh")
                .addEventListener("click", function() {

                    currentPage = 1;

                    selectedUserIds.clear();

                    updateSelectedUI();

                    loadMismatchUsers(1);

                });


            /*
             * ========================================================
             * PAGE SIZE CHANGE
             * ========================================================
             */

            document.getElementById("pageSizeSelect")
                .addEventListener("change", function() {

                    const newPageSize =
                        parseInt(this.value, 10);


                    if (!newPageSize ||
                        newPageSize <= 0) {

                        return;

                    }


                    /*
                     * Change page size.
                     */

                    pageSize = newPageSize;


                    /*
                     * Go back to first page.
                     *
                     * IMPORTANT:
                     * Selected users are NOT cleared.
                     */

                    currentPage = 1;


                    loadMismatchUsers(1);

                });


            /*
             * ========================================================
             * SELECT CURRENT PAGE
             * ========================================================
             */

            document.getElementById("btnSelectAll")
                .addEventListener("click", function() {

                    mismatchUsers.forEach(function(user) {

                        if (user.userId) {

                            selectedUserIds.add(
                                String(user.userId)
                            );

                        }

                    });


                    renderTable();

                });


            /*
             * ========================================================
             * CLEAR CURRENT PAGE
             * ========================================================
             */

            document.getElementById("btnClearAll")
                .addEventListener("click", function() {

                    mismatchUsers.forEach(function(user) {

                        if (user.userId) {

                            selectedUserIds.delete(
                                String(user.userId)
                            );

                        }

                    });


                    renderTable();

                });


            /*
             * ========================================================
             * MASTER CHECKBOX
             * ========================================================
             *
             * Selects / deselects ONLY the current page.
             */

            document.getElementById("selectAllCheckbox")
                .addEventListener("change", function() {

                    const checked = this.checked;


                    mismatchUsers.forEach(function(user) {

                        const userId =
                            String(user.userId);


                        if (checked) {

                            selectedUserIds.add(userId);

                        }
                        else {

                            selectedUserIds.delete(userId);

                        }

                    });


                    renderTable();

                });


            /*
             * ========================================================
             * PREVIOUS PAGE
             * ========================================================
             */

            document.getElementById("btnPrevious")
                .addEventListener("click", function() {

                    if (currentPage > 1) {

                        loadMismatchUsers(
                            currentPage - 1
                        );

                    }

                });


            /*
             * ========================================================
             * NEXT PAGE
             * ========================================================
             */

            document.getElementById("btnNext")
                .addEventListener("click", function() {

                    if (hasNextPage) {

                        loadMismatchUsers(
                            currentPage + 1
                        );

                    }

                });


            /*
             * ========================================================
             * FIX SELECTED
             * ========================================================
             */

            document.getElementById("btnFixSelected")
                .addEventListener("click", function() {

                    if (selectedUserIds.size === 0) {

                        return;

                    }


                    document.getElementById(
                        "modalSelectedCount"
                    ).innerText =
                        selectedUserIds.size;


                    fixPasswordModal.show();

                });


            /*
             * ========================================================
             * CONFIRM FIX
             * ========================================================
             */

            document.getElementById("btnConfirmFix")
                .addEventListener("click", function() {

                    fixSelectedPasswords();

                });


            /*
             * ============================================================
             * LOAD USERS
             * ============================================================
             */

            async function loadMismatchUsers(page) {

                currentPage = page;


                const tbody =
                    document.getElementById(
                        "usersTableBody"
                    );


                /*
                 * Loading UI
                 */

                tbody.innerHTML = `
                        <tr>

                            <td colspan="5"
                                class="text-center py-5">

                                <div class="spinner-border text-primary">
                                </div>

                                <div class="text-muted mt-2">

                                    Checking password hashes...

                                </div>

                            </td>

                        </tr>
                    `;


                /*
                 * Disable controls during loading.
                 */

                document.getElementById(
                    "btnPrevious"
                ).disabled = true;


                document.getElementById(
                    "btnNext"
                ).disabled = true;


                document.getElementById(
                    "pageSizeSelect"
                ).disabled = true;


                document.getElementById(
                    "btnSelectAll"
                ).disabled = true;


                document.getElementById(
                    "btnClearAll"
                ).disabled = true;


                try {

                    /*
                     * =================================================
                     * API URL
                     * =================================================
                     */

                    const url =
                        `/api/admin/password-mismatch/users` +
                        `?page=${currentPage}` +
                        `&pageSize=${pageSize}`;


                    const response =
                        await fetch(
                            url,
                            {
                                method: "GET",

                                headers: {
                                    "Accept": "application/json"
                                }
                            }
                        );


                    /*
                     * Handle HTTP errors.
                     */

                    if (!response.ok) {

                        let errorMessage =
                            "Unable to load users.";

                        try {

                            const errorResult =
                                await response.json();

                            errorMessage =
                                errorResult.message ||
                                errorMessage;

                        }
                        catch {

                            // Ignore JSON parsing error.

                        }


                        throw new Error(errorMessage);

                    }


                    /*
                     * Parse JSON.
                     */

                    const result =
                        await response.json();


                    /*
                     * Handle API failure.
                     */

                    if (!result.success) {

                        throw new Error(
                            result.message ||
                            "Unable to load users."
                        );

                    }


                    /*
                     * =================================================
                     * STORE CURRENT PAGE
                     * =================================================
                     */

                    mismatchUsers =
                        result.data || [];


                    /*
                     * =================================================
                     * TOTAL COUNT
                     * =================================================
                     *
                     * Preferred:
                     *
                     * result.totalCount
                     *
                     * Fallback:
                     *
                     * Current page count.
                     */

                    totalMismatchCount =
                        result.totalCount ??
                        result.total ??
                        mismatchUsers.length;


                    /*
                     * Update mismatch statistic.
                     */

                    document.getElementById(
                        "mismatchCount"
                    ).innerText =
                        totalMismatchCount;


                    /*
                     * Last checked.
                     */

                    document.getElementById(
                        "lastChecked"
                    ).innerText =
                        new Date().toLocaleString();


                    /*
                     * =================================================
                     * DETERMINE NEXT PAGE
                     * =================================================
                     *
                     * If backend returns hasNextPage, use it.
                     *
                     * Otherwise fallback to:
                     *
                     * current page count == page size
                     */

                    if (typeof result.hasNextPage === "boolean") {

                        hasNextPage =
                            result.hasNextPage;

                    }
                    else {

                        hasNextPage =
                            mismatchUsers.length === pageSize;

                    }


                    /*
                     * Render table.
                     */

                    renderTable();


                    /*
                     * Update pagination.
                     */

                    updatePagination();

                }
                catch (error) {

                    /*
                     * Error UI.
                     */

                    tbody.innerHTML = `
                            <tr>

                                <td colspan="5"
                                    class="text-center py-5 text-danger">

                                    <i class="bi bi-exclamation-triangle fs-3">
                                    </i>

                                    <div class="mt-2 fw-semibold">

                                        ${escapeHtml(
                        error.message ||
                        "Something went wrong."
                    )}

                                    </div>

                                </td>

                            </tr>
                        `;


                    mismatchUsers = [];

                    hasNextPage = false;

                    totalMismatchCount = 0;


                    document.getElementById(
                        "mismatchCount"
                    ).innerText = "0";


                    updatePagination();

                }
                finally {

                    /*
                     * Re-enable controls.
                     */

                    document.getElementById(
                        "pageSizeSelect"
                    ).disabled = false;


                    document.getElementById(
                        "btnSelectAll"
                    ).disabled =
                        mismatchUsers.length === 0;


                    document.getElementById(
                        "btnClearAll"
                    ).disabled =
                        mismatchUsers.length === 0;

                }

            }


            /*
             * ============================================================
             * RENDER TABLE
             * ============================================================
             */

            function renderTable() {

                const tbody =
                    document.getElementById(
                        "usersTableBody"
                    );


                /*
                 * Update selected count.
                 */

                updateSelectedUI();


                /*
                 * =================================================
                 * MASTER CHECKBOX STATE
                 * =================================================
                 */

                const selectAllCheckbox =
                    document.getElementById(
                        "selectAllCheckbox"
                    );


                const allCurrentPageSelected =
                    mismatchUsers.length > 0 &&
                    mismatchUsers.every(function(user) {

                        return selectedUserIds.has(
                            String(user.userId)
                        );

                    });


                selectAllCheckbox.checked =
                    allCurrentPageSelected;


                /*
                 * Determine if some but not all are selected.
                 */

                const someCurrentPageSelected =
                    mismatchUsers.some(function(user) {

                        return selectedUserIds.has(
                            String(user.userId)
                        );

                    });


                selectAllCheckbox.indeterminate =
                    someCurrentPageSelected &&
                    !allCurrentPageSelected;


                /*
                 * =================================================
                 * EMPTY PAGE
                 * =================================================
                 */

                if (mismatchUsers.length === 0) {

                    tbody.innerHTML = `
                            <tr>

                                <td colspan="5"
                                    class="text-center py-5">

                                    <div class="mb-2">

                                        <i class="bi bi-check-circle-fill text-success"
                                           style="font-size:45px;">
                                        </i>

                                    </div>

                                    <h5 class="fw-bold">

                                        No Password Mismatch Found

                                    </h5>

                                    <div class="text-muted">

                                        No mismatched users were found
                                        on this page.

                                    </div>

                                </td>

                            </tr>
                        `;

                    return;

                }


                /*
                 * =================================================
                 * BUILD ROWS
                 * =================================================
                 */

                tbody.innerHTML =
                    mismatchUsers.map(function(user) {

                        const userId =
                            String(user.userId || "");


                        const checked =
                            selectedUserIds.has(userId)
                                ? "checked"
                                : "";


                        return `
                                <tr>

                                    <!-- Checkbox -->
                                    <td class="text-center">

                                        <input type="checkbox"
                                               class="form-check-input user-checkbox"
                                               data-user-id="${escapeHtml(userId)}"
                                               ${checked}>

                                    </td>


                                    <!-- User -->
                                    <td>

                                        <div class="fw-semibold">

                                            ${escapeHtml(
                            user.userName || "-"
                        )}

                                        </div>

                                    </td>


                                    <!-- Email -->
                                    <td>

                                        ${escapeHtml(
                            user.email || "-"
                        )}

                                    </td>


                                    <!-- User ID -->
                                    <td>

                                        <code>

                                            ${escapeHtml(userId)}

                                        </code>

                                    </td>


                                    <!-- Status -->
                                    <td>

                                        <span class="badge text-bg-danger">

                                            <i class="bi bi-x-circle me-1"></i>

                                            Password Mismatch

                                        </span>

                                    </td>

                                </tr>
                            `;

                    }).join("");


                /*
                 * =================================================
                 * CHECKBOX EVENTS
                 * =================================================
                 */

                document.querySelectorAll(
                    ".user-checkbox"
                ).forEach(function(checkbox) {

                    checkbox.addEventListener(
                        "change",
                        function() {

                            const userId =
                                String(
                                    this.dataset.userId
                                );


                            if (this.checked) {

                                selectedUserIds.add(
                                    userId
                                );

                            }
                            else {

                                selectedUserIds.delete(
                                    userId
                                );

                            }


                            renderTable();

                        }
                    );

                });

            }


            /*
             * ============================================================
             * SELECTED UI
             * ============================================================
             */

            function updateSelectedUI() {

                const selectedCount =
                    selectedUserIds.size;


                /*
                 * Statistic.
                 */

                document.getElementById(
                    "selectedCount"
                ).innerText =
                    selectedCount;


                /*
                 * Fix button.
                 */

                const fixButton =
                    document.getElementById(
                        "btnFixSelected"
                    );


                fixButton.disabled =
                    selectedCount === 0;


                /*
                 * Badge.
                 */

                const badge =
                    document.getElementById(
                        "fixSelectedBadge"
                    );


                if (selectedCount > 0) {

                    badge.innerText =
                        selectedCount;

                    badge.style.display =
                        "inline-block";

                }
                else {

                    badge.style.display =
                        "none";

                }

            }


            /*
             * ============================================================
             * PAGINATION
             * ============================================================
             */

            function updatePagination() {

                const previousButton =
                    document.getElementById(
                        "btnPrevious"
                    );


                const nextButton =
                    document.getElementById(
                        "btnNext"
                    );


                const pageNumber =
                    document.getElementById(
                        "pageNumber"
                    );


                const paginationInfo =
                    document.getElementById(
                        "paginationInfo"
                    );


                /*
                 * Previous.
                 */

                previousButton.disabled =
                    currentPage <= 1;


                /*
                 * Next.
                 */

                nextButton.disabled =
                    !hasNextPage;


                /*
                 * Page number.
                 */

                pageNumber.innerText =
                    `Page ${currentPage}`;


                /*
                 * No users.
                 */

                if (mismatchUsers.length === 0) {

                    paginationInfo.innerText =
                        "No users found";

                    return;

                }


                /*
                 * Calculate current range.
                 */

                const start =
                    ((currentPage - 1) * pageSize) + 1;


                let end =
                    ((currentPage - 1) * pageSize) +
                    mismatchUsers.length;


                /*
                 * If total count is available,
                 * don't show a number larger than total.
                 */

                if (totalMismatchCount > 0) {

                    end =
                        Math.min(
                            end,
                            totalMismatchCount
                        );

                }


                /*
                 * Show:
                 *
                 * Showing 1 - 50 of 1234
                 */

                if (totalMismatchCount > 0) {

                    paginationInfo.innerText =
                        `Showing ${start} - ${end} of ${totalMismatchCount}`;

                }
                else {

                    paginationInfo.innerText =
                        `Showing ${start} - ${end}`;

                }

            }


            /*
             * ============================================================
             * FIX SELECTED PASSWORDS
             * ============================================================
             */

            async function fixSelectedPasswords() {

                const userIds =
                    Array.from(
                        selectedUserIds
                    );


                if (userIds.length === 0) {

                    return;

                }


                const confirmButton =
                    document.getElementById(
                        "btnConfirmFix"
                    );


                /*
                 * Disable button.
                 */

                confirmButton.disabled = true;


                confirmButton.innerHTML = `
                        <span class="spinner-border spinner-border-sm me-1">
                        </span>

                        Updating...
                    `;


                try {

                    /*
                     * =================================================
                     * API CALL
                     * =================================================
                     */

                    const response =
                        await fetch(
                            "/api/admin/password-mismatch/fix",
                            {
                                method: "POST",

                                headers: {
                                    "Content-Type":
                                        "application/json",

                                    "Accept":
                                        "application/json"
                                },

                                body: JSON.stringify({
                                    userIds: userIds
                                })
                            }
                        );


                    /*
                     * Parse response.
                     */

                    let result;

                    try {

                        result =
                            await response.json();

                    }
                    catch {

                        throw new Error(
                            "Invalid server response."
                        );

                    }


                    /*
                     * Handle API error.
                     */

                    if (!response.ok ||
                        !result.success) {

                        throw new Error(
                            result.message ||
                            "Unable to update passwords."
                        );

                    }


                    /*
                     * Close confirmation modal.
                     */

                    fixPasswordModal.hide();


                    /*
                     * Clear selections.
                     */

                    selectedUserIds.clear();

                    updateSelectedUI();


                    /*
                     * Show result.
                     */

                    showResults(
                        result.results || []
                    );


                    /*
                     * Refresh current page.
                     *
                     * Fixed users should disappear
                     * from mismatch list.
                     */

                    await loadMismatchUsers(
                        currentPage
                    );

                }
                catch (error) {

                    alert(
                        error.message ||
                        "Something went wrong."
                    );

                }
                finally {

                    confirmButton.disabled = false;


                    confirmButton.innerHTML = `
                            <i class="bi bi-shield-check me-1"></i>

                            Fix Passwords
                        `;

                }

            }


            /*
             * ============================================================
             * RESULT MODAL
             * ============================================================
             */

            function showResults(results) {

                const tbody =
                    document.getElementById(
                        "resultTableBody"
                    );


                let successCount = 0;

                let failureCount = 0;


                /*
                 * No result.
                 */

                if (!results ||
                    results.length === 0) {

                    tbody.innerHTML = `
                            <tr>

                                <td colspan="4"
                                    class="text-center text-muted py-4">

                                    No result returned.

                                </td>

                            </tr>
                        `;

                }
                else {

                    /*
                     * Build results.
                     */

                    tbody.innerHTML =
                        results.map(function(item) {

                            if (item.success) {

                                successCount++;

                            }
                            else {

                                failureCount++;

                            }


                            return `
                                    <tr>

                                        <td>

                                            ${escapeHtml(
                                item.userName || "-"
                            )}

                                        </td>


                                        <td>

                                            <code>

                                                ${escapeHtml(
                                item.userId || "-"
                            )}

                                            </code>

                                        </td>


                                        <td>

                                            ${item.success

                                    ?

                                    `<span class="badge text-bg-success">

                                                    <i class="bi bi-check-circle me-1"></i>

                                                    Success

                                                </span>`

                                    :

                                    `<span class="badge text-bg-danger">

                                                    <i class="bi bi-x-circle me-1"></i>

                                                    Failed

                                                </span>`
                                }

                                        </td>


                                        <td>

                                            ${escapeHtml(
                                    item.message || "-"
                                )}

                                        </td>

                                    </tr>
                                `;

                        }).join("");

                }


                /*
                 * =================================================
                 * SUMMARY
                 * =================================================
                 */

                document.getElementById(
                    "resultSummary"
                ).innerHTML = `

                        <div class="alert ${failureCount === 0
                        ? "alert-success"
                        : "alert-warning"
                    } mb-0">

                            <div class="d-flex align-items-center">

                                <i class="bi ${failureCount === 0
                        ? "bi-check-circle-fill"
                        : "bi-exclamation-triangle-fill"
                    } fs-4 me-2"></i>


                                <div>

                                    <strong>
                                        Password update completed
                                    </strong>

                                    <div class="small mt-1">

                                        <strong>
                                            ${successCount}
                                        </strong>
                                        successful

                                        &nbsp; | &nbsp;

                                        <strong>
                                            ${failureCount}
                                        </strong>
                                        failed

                                    </div>

                                </div>

                            </div>

                        </div>
                    `;


                /*
                 * Show modal.
                 */

                resultModal.show();

            }


            /*
             * ============================================================
             * HTML ENCODING
             * ============================================================
             */

            function escapeHtml(value) {

                if (value === null ||
                    value === undefined) {

                    return "";

                }


                return String(value)

                    .replaceAll("&", "&amp;")

                    .replaceAll("<", "&lt;")

                    .replaceAll(">", "&gt;")

                    .replaceAll('"', "&quot;")

                    .replaceAll("'", "&#039;");

            }

        });

    </script>

}

