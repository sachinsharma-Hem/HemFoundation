@{
    ViewData["Title"] = "Password Mismatch Manager";
    Layout = "~/Views/Shared/Layouts/_AdminLayout.cshtml";
}

<div class="container-fluid py-4">

    <!-- Header -->
    <div class="d-flex flex-wrap align-items-center justify-content-between mb-4">

        <div>
            <h3 class="fw-bold text-dark mb-1">
                <i class="bi bi-shield-lock text-primary me-2"></i>
                Password Mismatch Manager
            </h3>

            <p class="text-muted mb-0">
                Identify users whose stored password does not match
                their ASP.NET Identity password hash.
            </p>
        </div>

        <div class="mt-3 mt-md-0">
            <button type="button"
                    class="btn btn-outline-primary"
                    id="btnRefresh">
                <i class="bi bi-arrow-clockwise me-1"></i>
                Check Again
            </button>

            <button type="button"
                    class="btn btn-danger ms-2"
                    id="btnFixSelected"
                    disabled>
                <i class="bi bi-shield-check me-1"></i>
                Fix Selected
            </button>
        </div>

    </div>


    <!-- Warning -->
    <div class="alert alert-warning border-0 shadow-sm">

        <div class="d-flex">

            <div class="me-3">
                <i class="bi bi-exclamation-triangle-fill fs-4"></i>
            </div>

            <div>
                <strong>Security Notice</strong>

                <div class="small mt-1">
                    Passwords are checked on the server and are never
                    displayed in this page.
                    Only users whose password verification fails are
                    shown below.
                </div>
            </div>

        </div>

    </div>


    <!-- Statistics -->
    <div class="row g-3 mb-4">

        <div class="col-md-4">

            <div class="card border-0 shadow-sm h-100">

                <div class="card-body">

                    <div class="d-flex align-items-center">

                        <div class="rounded-circle bg-primary-subtle
                            p-3 me-3">
                            <i class="bi bi-people text-primary fs-4"></i>
                        </div>

                        <div>
                            <div class="text-muted small">
                                Mismatch Users
                            </div>

                            <h3 class="fw-bold mb-0"
                                id="mismatchCount">
                                0
                            </h3>
                        </div>

                    </div>

                </div>

            </div>

        </div>


        <div class="col-md-4">

            <div class="card border-0 shadow-sm h-100">

                <div class="card-body">

                    <div class="d-flex align-items-center">

                        <div class="rounded-circle bg-danger-subtle
                            p-3 me-3">
                            <i class="bi bi-x-circle text-danger fs-4"></i>
                        </div>

                        <div>
                            <div class="text-muted small">
                                Selected
                            </div>

                            <h3 class="fw-bold mb-0"
                                id="selectedCount">
                                0
                            </h3>
                        </div>

                    </div>

                </div>

            </div>

        </div>


        <div class="col-md-4">

            <div class="card border-0 shadow-sm h-100">

                <div class="card-body">

                    <div class="d-flex align-items-center">

                        <div class="rounded-circle bg-success-subtle
                            p-3 me-3">
                            <i class="bi bi-check-circle text-success fs-4"></i>
                        </div>

                        <div>
                            <div class="text-muted small">
                                Last Checked
                            </div>

                            <h6 class="fw-bold mb-0"
                                id="lastChecked">
                                -
                            </h6>
                        </div>

                    </div>

                </div>

            </div>

        </div>

    </div>


    <!-- Main Card -->
    <div class="card border-0 shadow-sm">

        <div class="card-header bg-white border-0 py-3">

            <div class="d-flex flex-wrap
                align-items-center
                justify-content-between">

                <div>
                    <h5 class="fw-bold mb-1">
                        Mismatched Users
                    </h5>

                    <small class="text-muted">
                        Select the users for whom you want to regenerate
                        the ASP.NET Identity password hash.
                    </small>
                </div>

                <div class="mt-2 mt-md-0">

                    <button type="button"
                            class="btn btn-sm btn-outline-secondary"
                            id="btnSelectAll">
                        Select All
                    </button>

                    <button type="button"
                            class="btn btn-sm btn-outline-secondary"
                            id="btnClearAll">
                        Clear
                    </button>

                </div>

            </div>

        </div>


        <div class="card-body p-0">

            <div class="table-responsive">

                <table class="table table-hover align-middle mb-0">

                    <thead class="table-light">

                        <tr>

                            <th style="width:50px;"
                                class="text-center">

                                <input type="checkbox"
                                       class="form-check-input"
                                       id="selectAllCheckbox">

                            </th>

                            <th>User</th>

                            <th>Email</th>

                            <th>User ID</th>

                            <th>Status</th>

                        </tr>

                    </thead>

                    <tbody id="usersTableBody">

                        <tr>
                            <td colspan="5"
                                class="text-center py-5">

                                <div class="spinner-border text-primary">
                                </div>

                                <div class="text-muted mt-2">
                                    Checking password hashes...
                                </div>

                            </td>
                        </tr>

                    </tbody>

                </table>

            </div>

        </div>

    </div>

</div>


<!-- Confirmation Modal -->
<div class="modal fade"
     id="fixPasswordModal"
     tabindex="-1"
     aria-hidden="true">

    <div class="modal-dialog modal-dialog-centered">

        <div class="modal-content border-0 shadow">

            <div class="modal-header">

                <h5 class="modal-title fw-bold">

                    <i class="bi bi-shield-exclamation
                    text-danger me-2"></i>

                    Confirm Password Update

                </h5>

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="modal">
                </button>

            </div>

            <div class="modal-body">

                <div class="text-center py-2">

                    <div class="mb-3">

                        <i class="bi bi-key-fill
                            text-danger"
                           style="font-size:48px;">
                        </i>

                    </div>

                    <h5 class="fw-bold">
                        Fix selected passwords?
                    </h5>

                    <p class="text-muted mb-2">

                        You have selected

                        <strong id="modalSelectedCount">
                            0
                        </strong>

                        user(s).

                    </p>

                    <p class="small text-muted">

                        The existing password from the User table
                        will be re-hashed using ASP.NET Identity and
                        saved to <code>AspNetUsers.PasswordHash</code>.

                    </p>

                </div>

            </div>

            <div class="modal-footer">

                <button type="button"
                        class="btn btn-light"
                        data-bs-dismiss="modal">
                    Cancel
                </button>

                <button type="button"
                        class="btn btn-danger"
                        id="btnConfirmFix">

                    <i class="bi bi-shield-check me-1"></i>

                    Fix Passwords

                </button>

            </div>

        </div>

    </div>

</div>


<!-- Result Modal -->
<div class="modal fade"
     id="resultModal"
     tabindex="-1"
     aria-hidden="true">

    <div class="modal-dialog modal-lg modal-dialog-centered">

        <div class="modal-content border-0 shadow">

            <div class="modal-header">

                <h5 class="modal-title fw-bold">
                    Password Update Result
                </h5>

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="modal">
                </button>

            </div>

            <div class="modal-body">

                <div id="resultSummary"
                     class="mb-3">
                </div>

                <div class="table-responsive">

                    <table class="table table-sm">

                        <thead>

                            <tr>
                                <th>User</th>
                                <th>User ID</th>
                                <th>Status</th>
                                <th>Message</th>
                            </tr>

                        </thead>

                        <tbody id="resultTableBody">
                        </tbody>

                    </table>

                </div>

            </div>

            <div class="modal-footer">

                <button type="button"
                        class="btn btn-primary"
                        data-bs-dismiss="modal">
                    Close
                </button>

            </div>

        </div>

    </div>

</div>


@section Scripts {

    <script>

        let mismatchUsers = [];

        let selectedUserIds = new Set();

        let fixPasswordModal;
        let resultModal;


        document.addEventListener("DOMContentLoaded", function() {

            fixPasswordModal =
                new bootstrap.Modal(
                    document.getElementById("fixPasswordModal")
                );

            resultModal =
                new bootstrap.Modal(
                    document.getElementById("resultModal")
                );

            loadMismatchUsers();


            document.getElementById("btnRefresh")
                .addEventListener("click", function() {

                    selectedUserIds.clear();

                    loadMismatchUsers();

                });


            document.getElementById("btnSelectAll")
                .addEventListener("click", function() {

                    mismatchUsers.forEach(function(user) {

                        selectedUserIds.add(
                            user.userId
                        );

                    });

                    renderTable();

                });


            document.getElementById("btnClearAll")
                .addEventListener("click", function() {

                    selectedUserIds.clear();

                    renderTable();

                });


            document.getElementById("selectAllCheckbox")
                .addEventListener("change", function() {

                    if (this.checked) {

                        mismatchUsers.forEach(function(user) {

                            selectedUserIds.add(
                                user.userId
                            );

                        });

                    }
                    else {

                        selectedUserIds.clear();

                    }

                    renderTable();

                });


            document.getElementById("btnFixSelected")
                .addEventListener("click", function() {

                    if (selectedUserIds.size === 0)
                        return;

                    document.getElementById(
                        "modalSelectedCount"
                    ).innerText =
                        selectedUserIds.size;

                    fixPasswordModal.show();

                });


            document.getElementById("btnConfirmFix")
                .addEventListener("click", function() {

                    fixSelectedPasswords();

                });

        });


        async function loadMismatchUsers() {

            const tbody =
                document.getElementById("usersTableBody");

            tbody.innerHTML = `
                    <tr>
                        <td colspan="5"
                            class="text-center py-5">

                            <div class="spinner-border text-primary"></div>

                            <div class="text-muted mt-2">
                                Checking password hashes...
                            </div>

                        </td>
                    </tr>
                `;


            try {

                const response =
                    await fetch(
                        "/api/admin/password-mismatch/users",
                        {
                            method: "GET",
                            headers: {
                                "Accept": "application/json"
                            }
                        }
                    );


                if (!response.ok) {

                    throw new Error(
                        "Unable to load users."
                    );

                }


                const result =
                    await response.json();


                if (!result.success) {

                    throw new Error(
                        result.message ||
                        "Unable to load users."
                    );

                }


                mismatchUsers =
                    result.data || [];


                selectedUserIds.clear();


                document.getElementById(
                    "mismatchCount"
                ).innerText =
                    mismatchUsers.length;


                document.getElementById(
                    "lastChecked"
                ).innerText =
                    new Date().toLocaleString();


                renderTable();

            }
            catch (error) {

                tbody.innerHTML = `
                        <tr>
                            <td colspan="5"
                                class="text-center py-5 text-danger">

                                <i class="bi bi-exclamation-triangle fs-3"></i>

                                <div class="mt-2">
                                    ${escapeHtml(error.message)}
                                </div>

                            </td>
                        </tr>
                    `;

            }

        }


        function renderTable() {

            const tbody =
                document.getElementById("usersTableBody");


            document.getElementById(
                "selectedCount"
            ).innerText =
                selectedUserIds.size;


            const selectAllCheckbox =
                document.getElementById(
                    "selectAllCheckbox"
                );


            selectAllCheckbox.checked =
                mismatchUsers.length > 0 &&
                selectedUserIds.size ===
                mismatchUsers.length;


            document.getElementById(
                "btnFixSelected"
            ).disabled =
                selectedUserIds.size === 0;


            if (mismatchUsers.length === 0) {

                tbody.innerHTML = `
                        <tr>

                            <td colspan="5"
                                class="text-center py-5">

                                <div class="mb-2">

                                    <i class="bi bi-check-circle-fill
                                              text-success"
                                       style="font-size:45px;">
                                    </i>

                                </div>

                                <h5 class="fw-bold">
                                    No Password Mismatch Found
                                </h5>

                                <div class="text-muted">
                                    All checked users have a valid
                                    ASP.NET Identity password hash.
                                </div>

                            </td>

                        </tr>
                    `;

                return;

            }


            tbody.innerHTML =
                mismatchUsers.map(function(user) {

                    const checked =
                        selectedUserIds.has(
                            user.userId
                        )
                            ? "checked"
                            : "";


                    return `
                            <tr>

                                <td class="text-center">

                                    <input type="checkbox"
                                           class="form-check-input user-checkbox"
                                           data-user-id="${escapeHtml(user.userId)}"
                                           ${checked}>

                                </td>


                                <td>

                                    <div class="fw-semibold">

                                        ${escapeHtml(
                        user.userName ||
                        "-"
                    )}

                                    </div>

                                </td>


                                <td>

                                    ${escapeHtml(
                        user.email ||
                        "-"
                    )}

                                </td>


                                <td>

                                    <code>
                                        ${escapeHtml(
                        user.userId
                    )}
                                    </code>

                                </td>


                                <td>

                                    <span class="badge
                                                 text-bg-danger">

                                        <i class="bi bi-x-circle me-1"></i>

                                        Password Mismatch

                                    </span>

                                </td>

                            </tr>
                        `;

                }).join("");


            document.querySelectorAll(
                ".user-checkbox"
            ).forEach(function(checkbox) {

                checkbox.addEventListener(
                    "change",
                    function() {

                        const userId =
                            this.dataset.userId;


                        if (this.checked) {

                            selectedUserIds.add(
                                userId
                            );

                        }
                        else {

                            selectedUserIds.delete(
                                userId
                            );

                        }


                        renderTable();

                    }
                );

            });

        }


        async function fixSelectedPasswords() {

            const userIds =
                Array.from(
                    selectedUserIds
                );


            if (userIds.length === 0)
                return;


            const confirmButton =
                document.getElementById(
                    "btnConfirmFix"
                );


            confirmButton.disabled = true;

            confirmButton.innerHTML = `
                    <span class="spinner-border spinner-border-sm me-1"></span>
                    Updating...
                `;


            try {

                const response =
                    await fetch(
                        "/api/admin/password-mismatch/fix",
                        {
                            method: "POST",

                            headers: {
                                "Content-Type":
                                    "application/json",

                                "Accept":
                                    "application/json"
                            },

                            body: JSON.stringify({
                                userIds: userIds
                            })
                        }
                    );


                const result =
                    await response.json();


                if (!response.ok ||
                    !result.success) {

                    throw new Error(
                        result.message ||
                        "Unable to update passwords."
                    );

                }


                fixPasswordModal.hide();


                showResults(
                    result.results || []
                );


                selectedUserIds.clear();


                await loadMismatchUsers();

            }
            catch (error) {

                alert(
                    error.message ||
                    "Something went wrong."
                );

            }
            finally {

                confirmButton.disabled = false;

                confirmButton.innerHTML = `
                        <i class="bi bi-shield-check me-1"></i>
                        Fix Passwords
                    `;

            }

        }


        function showResults(results) {

            const tbody =
                document.getElementById(
                    "resultTableBody"
                );


            let successCount = 0;
            let failureCount = 0;


            tbody.innerHTML =
                results.map(function(item) {

                    if (item.success)
                        successCount++;
                    else
                        failureCount++;


                    return `
                            <tr>

                                <td>
                                    ${escapeHtml(
                        item.userName ||
                        "-"
                    )}
                                </td>

                                <td>
                                    <code>
                                        ${escapeHtml(
                        item.userId
                    )}
                                    </code>
                                </td>

                                <td>

                                    ${item.success

                            ?

                            `<span class="badge text-bg-success">
                                            Success
                                        </span>`

                            :

                            `<span class="badge text-bg-danger">
                                            Failed
                                        </span>`
                        }

                                </td>

                                <td>
                                    ${escapeHtml(
                            item.message
                        )}
                                </td>

                            </tr>
                        `;

                }).join("");


            document.getElementById(
                "resultSummary"
            ).innerHTML = `

                    <div class="alert ${failureCount === 0
                    ? "alert-success"
                    : "alert-warning"
                }">

                        <strong>
                            ${successCount}
                        </strong>
                        successful

                        &nbsp; | &nbsp;

                        <strong>
                            ${failureCount}
                        </strong>
                        failed

                    </div>
                `;


            resultModal.show();

        }


        function escapeHtml(value) {

            if (value === null ||
                value === undefined)
                return "";


            return String(value)
                .replaceAll("&", "&amp;")
                .replaceAll("<", "&lt;")
                .replaceAll(">", "&gt;")
                .replaceAll('"', "&quot;")
                .replaceAll("'", "&#039;");

        }

    </script>

}