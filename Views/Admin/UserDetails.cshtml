@{
    ViewData["Title"] = "User Details";
    Layout = "~/Views/Shared/Layouts/_AdminLayout.cshtml";

}

<div class="container-fluid py-3">

    <!-- HEADER -->
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-3">
        <div>
            <h4 class="mb-1">
                <i class="bi bi-people-fill me-2"></i>
                User Details
            </h4>
            <small class="text-muted">
                User-wise role and profile information
            </small>
        </div>

        <div class="dropdown">
            <button class="btn btn-success dropdown-toggle"
                    data-bs-toggle="dropdown">
                <i class="bi bi-download me-1"></i>
                Export
            </button>

            <ul class="dropdown-menu dropdown-menu-end">
                <li>
                    <button class="dropdown-item"
                            onclick="exportData('csv')">
                        <i class="bi bi-filetype-csv me-2"></i>
                        Export CSV
                    </button>
                </li>
                <li>
                    <button class="dropdown-item"
                            onclick="exportData('excel')">
                        <i class="bi bi-file-earmark-excel me-2"></i>
                        Export Excel
                    </button>
                </li>
            </ul>
        </div>
    </div>


    <div id="roleCards"
         class="row g-3 mb-3">
    </div>


    <div class="card border-0 shadow-sm mb-3">
        <div class="card-body">

            <div class="row g-2 align-items-center">

                <div class="col-md-6">
                    <div class="input-group">
                        <span class="input-group-text">
                            <i class="bi bi-search"></i>
                        </span>

                        <input type="text"
                               id="searchInput"
                               class="form-control"
                               placeholder="Search name, username, email, mobile..." />

                        <button class="btn btn-outline-secondary"
                                onclick="clearSearch()">
                            Clear
                        </button>
                    </div>
                </div>

                <div class="col-md-3">
                    <select id="pageSize"
                            class="form-select"
                            onchange="loadUsers(1)">
                        <option value="25">25 rows</option>
                        <option value="50" selected>50 rows</option>
                        <option value="100">100 rows</option>
                        <option value="200">200 rows</option>
                    </select>
                </div>

                <div class="col-md-3 text-md-end">
                    <span id="recordInfo"
                          class="text-muted small"></span>
                </div>

            </div>

        </div>
    </div>


    <!-- TABLE -->
    <div class="card border-0 shadow-sm">

        <div class="card-header bg-white d-flex justify-content-between">
            <strong id="selectedRole">
                Select a role
            </strong>

            <span id="tableStatus"
                  class="text-muted small">
            </span>
        </div>

        <div class="table-responsive"
             style="max-height:65vh;">

            <table class="table table-sm table-hover table-bordered mb-0"
                   id="userTable">

                <thead class="table-light"
                       id="tableHead">
                </thead>

                <tbody id="tableBody">
                </tbody>

            </table>

        </div>

        <!-- PAGINATION -->
        <div class="card-footer bg-white">

            <div class="d-flex justify-content-between align-items-center">

                <small id="paginationInfo"
                       class="text-muted">
                </small>

                <div id="pagination"
                     class="btn-group">
                </div>

            </div>

        </div>

    </div>

</div>


<!-- SMALL LOADING OVERLAY -->
<div id="loadingOverlay"
     style="
    display:none;
    position:fixed;
    inset:0;
    background:rgba(255,255,255,.35);
    z-index:9999;
    align-items:center;
    justify-content:center;
    ">

    <div class="bg-white shadow rounded px-3 py-2">
        <span class="spinner-border spinner-border-sm me-2"></span>
        Loading...
    </div>

</div>


<style>

    .role-card {
        cursor: pointer;
        transition: all .15s ease;
    }

    .role-card:hover {
        transform: translateY(-2px);
        box-shadow: 0 .25rem .75rem rgba(0,0,0,.10) !important;
    }

    .role-card.active {
        border: 2px solid #0d6efd !important;
    }

    .role-count {
        font-size: 1.6rem;
        font-weight: 700;
    }

    #userTable {
        white-space: nowrap;
        font-size: 12px;
    }

    #userTable th {
        position: sticky;
        top: 0;
        z-index: 2;
        white-space: nowrap;
    }

</style>


<script>

    let selectedRole = null;
    let currentPage = 1;
    let totalPages = 1;

    let searchTimer = null;


    document.addEventListener("DOMContentLoaded", function () {

        loadRoles();

        document
            .getElementById("searchInput")
            .addEventListener("input", function () {

                clearTimeout(searchTimer);

                searchTimer = setTimeout(() => {
                    loadUsers(1);
                }, 300);

            });

    });


    // =========================================================
    // LOAD ROLE CARDS
    // =========================================================

    async function loadRoles() {

        try {

            const response = await fetch(
                "/api/UserDetails/Roles"
            );

            if (!response.ok)
                throw new Error("Unable to load roles");

            const roles = await response.json();

            const container =
                document.getElementById("roleCards");

            container.innerHTML = "";

            roles.forEach(role => {

                const col =
                    document.createElement("div");

                col.className =
                    "col-xl-2 col-lg-3 col-md-4 col-sm-6";

                col.innerHTML = `

                    <div class="card border-0 shadow-sm role-card h-100"
                         data-role="${escapeHtml(role.roleName)}"
                         onclick="selectRole('${escapeJs(role.roleName)}', this)">

                        <div class="card-body">

                            <div class="d-flex justify-content-between">

                                <div>
                                    <div class="text-muted small">
                                        ${escapeHtml(role.roleName)}
                                    </div>

                                    <div class="role-count">
                                        ${Number(role.totalUsers).toLocaleString()}
                                    </div>

                                    <div class="text-muted small">
                                        Users
                                    </div>
                                </div>

                                <div class="text-primary fs-3">
                                    <i class="bi bi-person-badge"></i>
                                </div>

                            </div>

                        </div>

                    </div>
                `;

                container.appendChild(col);

            });

            if (roles.length > 0) {

                const firstCard =
                    container.querySelector(".role-card");

                selectRole(
                    roles[0].roleName,
                    firstCard
                );
            }

        }
        catch (error) {

            console.error(error);

            document.getElementById("roleCards").innerHTML = `
                <div class="col-12">
                    <div class="alert alert-danger">
                        Unable to load role information.
                    </div>
                </div>
            `;

        }

    }


    // =========================================================
    // SELECT ROLE
    // =========================================================

    function selectRole(role, element) {

        selectedRole = role;

        document
            .querySelectorAll(".role-card")
            .forEach(x => x.classList.remove("active"));

        if (element)
            element.classList.add("active");

        document.getElementById("selectedRole")
            .innerHTML =
            `<i class="bi bi-person-badge me-1"></i>
             ${escapeHtml(role)}`;

        loadUsers(1);
    }


    // =========================================================
    // LOAD USERS
    // =========================================================

    async function loadUsers(page) {

        if (!selectedRole)
            return;

        currentPage = page;

        const pageSize =
            document.getElementById("pageSize").value;

        const search =
            document.getElementById("searchInput").value.trim();

        const params = new URLSearchParams();

        params.append("role", selectedRole);
        params.append("page", page);
        params.append("pageSize", pageSize);

        if (search)
            params.append("search", search);


        showLoading(true);

        try {

            const response = await fetch(
                `/api/UserDetails/List?${params.toString()}`
            );

            if (!response.ok)
                throw new Error("Unable to load users");

            const result = await response.json();

            totalPages = result.totalPages;

            renderTable(result.data);

            renderPagination(
                result.page,
                result.totalPages,
                result.totalRecords
            );

            document.getElementById("recordInfo")
                .innerText =
                `${Number(result.totalRecords).toLocaleString()} records`;

            document.getElementById("tableStatus")
                .innerText =
                `${result.totalRecords.toLocaleString()} users`;

        }
        catch (error) {

            console.error(error);

            document.getElementById("tableBody").innerHTML = `
                <tr>
                    <td colspan="100"
                        class="text-center text-danger py-4">
                        Unable to load user data.
                    </td>
                </tr>
            `;

        }
        finally {

            showLoading(false);

        }

    }


    // =========================================================
    // TABLE
    // =========================================================

    function renderTable(rows) {

        const head =
            document.getElementById("tableHead");

        const body =
            document.getElementById("tableBody");

        head.innerHTML = "";
        body.innerHTML = "";

        if (!rows || rows.length === 0) {

            body.innerHTML = `
                <tr>
                    <td colspan="100"
                        class="text-center text-muted py-5">
                        No records found.
                    </td>
                </tr>
            `;

            return;
        }

        const columns =
            Object.keys(rows[0]);

        const trHead =
            document.createElement("tr");

        columns.forEach(column => {

            const th =
                document.createElement("th");

            th.innerText =
                formatColumnName(column);

            trHead.appendChild(th);

        });

        head.appendChild(trHead);


        rows.forEach(row => {

            const tr =
                document.createElement("tr");

            columns.forEach(column => {

                const td =
                    document.createElement("td");

                td.innerText =
                    formatValue(row[column]);

                tr.appendChild(td);

            });

            body.appendChild(tr);

        });

    }


    // =========================================================
    // PAGINATION
    // =========================================================

    function renderPagination(
        page,
        totalPages,
        totalRecords
    ) {

        const container =
            document.getElementById("pagination");

        container.innerHTML = "";

        if (totalPages <= 1) {

            document.getElementById("paginationInfo")
                .innerText =
                `Showing ${totalRecords.toLocaleString()} records`;

            return;
        }

        const prev =
            createPageButton(
                "‹",
                page <= 1,
                () => loadUsers(page - 1)
            );

        container.appendChild(prev);


        const start =
            Math.max(1, page - 2);

        const end =
            Math.min(totalPages, page + 2);

        for (let i = start; i <= end; i++) {

            const button =
                createPageButton(
                    i,
                    false,
                    () => loadUsers(i)
                );

            if (i === page)
                button.classList.add("active");

            container.appendChild(button);
        }


        const next =
            createPageButton(
                "›",
                page >= totalPages,
                () => loadUsers(page + 1)
            );

        container.appendChild(next);


        document.getElementById("paginationInfo")
            .innerText =
            `Page ${page} of ${totalPages}`;
    }


    function createPageButton(
        text,
        disabled,
        click
    ) {

        const button =
            document.createElement("button");

        button.className =
            "btn btn-sm btn-outline-secondary";

        button.innerText = text;

        button.disabled = disabled;

        button.onclick = click;

        return button;
    }


    // =========================================================
    // EXPORT
    // =========================================================

    function exportData(format) {

        if (!selectedRole)
            return;

        const search =
            document.getElementById("searchInput")
                .value
                .trim();

        const params =
            new URLSearchParams();

        params.append("role", selectedRole);
        params.append("format", format);

        if (search)
            params.append("search", search);

        window.location.href =
            `/api/UserDetails/Export?${params.toString()}`;
    }


    // =========================================================
    // SEARCH
    // =========================================================

    function clearSearch() {

        document.getElementById("searchInput")
            .value = "";

        loadUsers(1);
    }


    // =========================================================
    // HELPERS
    // =========================================================

    function formatColumnName(name) {

        return name
            .replace(/([a-z])([A-Z])/g, "$1 $2")
            .replace(/_/g, " ")
            .replace(/\b\w/g, x => x.toUpperCase());

    }


    function formatValue(value) {

        if (value === null ||
            value === undefined)
            return "";

        if (typeof value === "boolean")
            return value ? "Yes" : "No";

        return value;
    }


    function escapeHtml(value) {

        if (!value)
            return "";

        return value
            .replace(/&/g, "&amp;")
            .replace(/</g, "&lt;")
            .replace(/>/g, "&gt;")
            .replace(/"/g, "&quot;")
            .replace(/'/g, "&#039;");
    }


    function escapeJs(value) {

        return value
            .replace(/\\/g, "\\\\")
            .replace(/'/g, "\\'");
    }


    function showLoading(show) {

        document.getElementById("loadingOverlay")
            .style.display =
            show ? "flex" : "none";
    }

</script>