@{
    ViewData["Title"] = "Admin Dashboard";
    Layout = "~/Views/Shared/Layouts/_AdminLayout.cshtml";
}

<div class="container-fluid py-4">
    <!-- Welcome Header -->
    <div class="row mb-4">
        <div class="col-12">
            <div class="card border-0 shadow-sm rounded-4 bg-white p-4">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <h2 class="fw-bold text-dark mb-1">Dashboard Overview 🚀</h2>
                        <p class="text-muted m-0">Welcome back, <span id="adminUserName" class="text-success fw-semibold">Admin</span>!</p>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Metrics Cards Grid -->
    <div class="row g-3 mb-4">
        <div class="col-xl-3 col-lg-4 col-sm-6">
            <div class="card text-white bg-info border-0 shadow-sm h-100 rounded-4 cursor-pointer" onclick="openDetailsModal('total-students')">
                <div class="card-body p-4">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h2 class="fw-bold mb-1" id="dash_totalStudents">0</h2>
                            <p class="card-text small mb-0">Total Students</p>
                        </div>
                        <i class="bi bi-people-fill fs-1 opacity-50"></i>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-xl-3 col-lg-4 col-sm-6">
            <div class="card text-white bg-success border-0 shadow-sm h-100 rounded-4 cursor-pointer" onclick="openDetailsModal('active-students')">
                <div class="card-body p-4">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h2 class="fw-bold mb-1" id="dash_activeStudents">0</h2>
                            <p class="card-text small mb-0">Active Students</p>
                        </div>
                        <i class="bi bi-person-check-fill fs-1 opacity-50"></i>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-xl-3 col-lg-4 col-sm-6">
            <div class="card text-dark bg-warning border-0 shadow-sm h-100 rounded-4 cursor-pointer" onclick="openDetailsModal('total-teachers')">
                <div class="card-body p-4">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h2 class="fw-bold mb-1" id="dash_totalTeachers">0</h2>
                            <p class="card-text small mb-0">Total Teachers</p>
                        </div>
                        <i class="bi bi-person-badge-fill fs-1 opacity-50"></i>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-xl-3 col-lg-4 col-sm-6">
            <div class="card text-white bg-success border-0 shadow-sm h-100 rounded-4 cursor-pointer" onclick="openDetailsModal('active-teachers')">
                <div class="card-body p-4">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h2 class="fw-bold mb-1" id="dash_activeTeachers">0</h2>
                            <p class="card-text small mb-0">Active Teachers</p>
                        </div>
                        <i class="bi bi-award-fill fs-1 opacity-50"></i>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-xl-3 col-lg-4 col-sm-6">
            <div class="card text-white bg-primary border-0 shadow-sm h-100 rounded-4 cursor-pointer" onclick="openDetailsModal('sel-projects')">
                <div class="card-body p-4">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h2 class="fw-bold mb-1" id="dash_totalSelProjects">0</h2>
                            <p class="card-text small mb-0">Total SEL Projects</p>
                        </div>
                        <i class="bi bi-journal-richtext fs-1 opacity-50"></i>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-xl-3 col-lg-4 col-sm-6">
            <div class="card text-white bg-dark border-0 shadow-sm h-100 rounded-4 cursor-pointer" onclick="openDetailsModal('family-projects')">
                <div class="card-body p-4">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h2 class="fw-bold mb-1" id="dash_familyProjects">0</h2>
                            <p class="card-text small mb-0">Family Projects</p>
                        </div>
                        <i class="bi bi-house-heart-fill fs-1 opacity-50"></i>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-xl-3 col-lg-4 col-sm-6">
            <div class="card text-dark bg-light border border-secondary-subtle shadow-sm h-100 rounded-4 cursor-pointer" onclick="openDetailsModal('individual-projects')">
                <div class="card-body p-4">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h2 class="fw-bold mb-1 text-dark" id="dash_individualProjects">0</h2>
                            <p class="card-text small mb-0 text-muted">Individual Projects</p>
                        </div>
                        <i class="bi bi-person-fill fs-1 opacity-50 text-muted"></i>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-xl-3 col-lg-4 col-sm-6">
            <div class="card text-white bg-secondary border-0 shadow-sm h-100 rounded-4 cursor-pointer" onclick="openDetailsModal('group-pbl')">
                <div class="card-body p-4">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h2 class="fw-bold mb-1" id="dash_groupPbl">0</h2>
                            <p class="card-text small mb-0">Group PBL</p>
                        </div>
                        <i class="bi bi-people-fill fs-1 opacity-50"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Info Banner -->
    <div class="row">
        <div class="col-12">
            <div class="card border-0 shadow-sm rounded-4 bg-white p-4">
                <h4 class="fw-bold text-dark mb-3">JWT & RBAC Active Control Center</h4>
                <div class="alert alert-success border-0 rounded-4 shadow-sm p-4">
                    <h5 class="fw-bold text-success mb-1"><i class="bi bi-shield-check-fill me-2"></i> Universal Sidebar Active!</h5>
                    <p class="mb-0 text-secondary small">Menus are now handled globally inside the layout, supporting parent-child hierarchy across all pages.</p>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Details Modal -->
<div class="modal fade" id="dashboardDetailsModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-xl">
        <div class="modal-content rounded-4 border-0 shadow-lg p-3">
            <div class="modal-header border-bottom-0 pb-0">
                <h5 class="fw-bold text-dark" id="modalTitle">Records List</h5>
                <button type="button" class="btn-close shadow-none" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div class="table-responsive border rounded-3" style="max-height: 400px;">
                    <table class="table table-hover align-middle mb-0" id="modalTable">
                        <thead class="table-light"></thead>
                        <tbody></tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function() {
            const userSession = JSON.parse(localStorage.getItem('user_session'));
            if (userSession) {
                $('#adminUserName').text(userSession.fullName || userSession.email);
            }

            loadAdminDashboardCounts();
        });

        function getAuthToken() {
            return localStorage.getItem('jwt_token') || sessionStorage.getItem('jwt_token') || '';
        }

        function loadAdminDashboardCounts() {
            $.ajax({
                url: '/api/admin/overall-dashboard-counts',
                type: 'GET',
                headers: { 'Authorization': 'Bearer ' + getAuthToken() },
                success: function(res) {
                    if (res.success && res.data) {
                        let d = res.data;
                        $('#dash_totalStudents').text(d.totalStudents || 0);
                        $('#dash_activeStudents').text(d.activeStudents || 0);
                        $('#dash_totalTeachers').text(d.totalTeachers || 0);
                        $('#dash_activeTeachers').text(d.activeTeachers || 0);
                        $('#dash_totalSelProjects').text(d.totalSelProjects || 0);
                        $('#dash_familyProjects').text(d.familyProjects || 0);
                        $('#dash_individualProjects').text(d.individualProjects || 0);
                        $('#dash_groupPbl').text(d.groupPbl || 0);
                    }
                }
            });
        }

        function openDetailsModal(type) {
            $('#modalTitle').text(type.replace('-', ' ').toUpperCase());
            $('#modalTable thead').html('<tr><th>Loading...</th></tr>');
            $('#modalTable tbody').html('<tr><td class="text-center py-3"><div class="spinner-border spinner-border-sm"></div></td></tr>');
            $('#dashboardDetailsModal').modal('show');

            $.ajax({
                url: `/api/affiliate-dashboard/details-list/${type}`,
                type: 'GET',
                headers: { 'Authorization': 'Bearer ' + getAuthToken() },
                success: function(res) {
                    if (res.success && res.data && res.data.length > 0) {
                        let keys = Object.keys(res.data[0]);
                        let thead = '<tr>';
                        keys.forEach(k => thead += `<th>${k}</th>`);
                        thead += '</tr>';
                        $('#modalTable thead').html(thead);

                        let tbody = '';
                        res.data.forEach(row => {
                            tbody += '<tr>';
                            keys.forEach(k => tbody += `<td>${row[k] !== null ? row[k] : ''}</td>`);
                            tbody += '</tr>';
                        });
                        $('#modalTable tbody').html(tbody);
                    } else {
                        $('#modalTable thead').html('');
                        $('#modalTable tbody').html('<tr><td class="text-center py-4 text-muted">No records found.</td></tr>');
                    }
                },
                error: function() {
                    $('#modalTable tbody').html('<tr><td class="text-center py-4 text-danger">Failed to load details.</td></tr>');
                }
            });
        }
    </script>
}