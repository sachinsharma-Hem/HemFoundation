<!-- STYLES -->
<!-- ========================================================= -->

<style>

    .dashboard-card {
        border: 0;
        border-radius: 18px;
        min-height: 145px;
        cursor: pointer;
        box-shadow: 0 4px 15px rgba(0, 0, 0, 0.06);
        transition: all 0.2s ease;
        color: #fff;
    }

        .dashboard-card:hover {
            transform: translateY(-4px);
            box-shadow: 0 10px 25px rgba(0, 0, 0, 0.12);
        }

        .dashboard-card:active {
            transform: translateY(-1px);
        }


    /* ================= PERFORMANCE COLORS ================= */

    .card-performance-primary {
        background: linear-gradient(135deg, #4f46e5, #6366f1);
    }

    .card-performance-info {
        background: linear-gradient(135deg, #0891b2, #06b6d4);
    }

    .card-performance-success {
        background: linear-gradient(135deg, #059669, #10b981);
    }

    .card-performance-warning {
        background: linear-gradient(135deg, #d97706, #f59e0b);
    }

    .card-performance-dark {
        background: linear-gradient(135deg, #343a40, #495057);
    }

    .card-performance-light {
        background: linear-gradient(135deg, #f1f5f9, #e2e8f0);
        color: #212529;
        border: 1px solid #dee2e6;
    }

    .card-performance-secondary {
        background: linear-gradient(135deg, #64748b, #475569);
    }


    /* ================= FOCUSED COLORS ================= */

    .card-focused-primary {
        background: linear-gradient(135deg, #2563eb, #3b82f6);
    }

    .card-focused-info {
        background: linear-gradient(135deg, #0284c7, #0ea5e9);
    }

    .card-focused-success {
        background: linear-gradient(135deg, #15803d, #22c55e);
    }

    .card-focused-warning {
        background: linear-gradient(135deg, #b45309, #f59e0b);
    }

    .card-focused-dark {
        background: linear-gradient(135deg, #1f2937, #374151);
    }

    .card-focused-light {
        background: linear-gradient(135deg, #f8fafc, #e2e8f0);
        color: #212529;
        border: 1px solid #dee2e6;
    }

    .card-focused-secondary {
        background: linear-gradient(135deg, #475569, #64748b);
    }


    /* ================= MODAL ================= */

    .modal-table-wrapper {
        max-height: 480px;
        overflow: auto;
    }

    #modalTable {
        min-width: 700px;
    }

        #modalTable thead th {
            position: sticky;
            top: 0;
            z-index: 5;
            white-space: nowrap;
            font-size: 13px;
            font-weight: 600;
            background: #f8f9fa;
        }

        #modalTable tbody td {
            font-size: 13px;
            white-space: nowrap;
            vertical-align: middle;
        }


    /* ================= LOADING ================= */

    .dashboard-loading {
        opacity: 0.6;
        pointer-events: none;
    }

    .modal-loader {
        padding: 45px 20px;
    }

        .modal-loader .spinner-border {
            width: 2rem;
            height: 2rem;
        }

    .disabled-card {
        opacity: 0.7;
        pointer-events: none;
    }

    /* ================= GLOBAL LOADER OVERLAY ================= */
    .global-loader-overlay {
        position: fixed;
        top: 0;
        left: 0;
        width: 100vw;
        height: 100vh;
        background: rgba(255, 255, 255, 0.85);
        backdrop-filter: blur(4px);
        z-index: 99999;
        display: flex;
        justify-content: center;
        align-items: center;
        flex-direction: column;
        transition: opacity 0.2s ease-in-out;
    }

</style>


@section Scripts {

    <script>

        /* =========================================================
            GLOBAL LOADER HELPERS
        ========================================================= */
        function showGlobalLoader(message = "Processing your request, please wait...") {
            $("#globalLoaderText").text(message);
            $("#globalLoader").fadeIn(150);
        }

        function hideGlobalLoader() {
            $("#globalLoader").fadeOut(150);
        }

        /* =========================================================
            PAGE LOAD
        ========================================================= */

        $(document).ready(function() {

            const userSession =
                JSON.parse(localStorage.getItem('user_session'));

            if (userSession) {

                $('#adminUserName').text(
                    userSession.fullName ||
                    userSession.email ||
                    'Admin'
                );
            }

            loadAdminDashboardCounts();

        });


        /* =========================================================
            AUTH TOKEN
        ========================================================= */

        function getAuthToken() {

            return localStorage.getItem('jwt_token') ||
                sessionStorage.getItem('jwt_token') ||
                '';
        }

        function loadAdminDashboardCounts() {

            $.ajax({

                url: '/api/admin/overall-dashboard-counts',

                type: 'GET',

                headers: {
                    'Authorization':
                        'Bearer ' + getAuthToken()
                },

                success: function(res) {

                    if (!res || !res.success || !res.data) {

                        console.error(
                            'Invalid dashboard response:',
                            res
                        );

                        return;
                    }

                    const performance =
                        res.data.performance || {};

                    const focused =
                        res.data.focused || {};


                    $('#p_totalSchools').text(
                        performance.schoolCount ?? 0
                    );

                    $('#p_totalStudents').text(
                        performance.totalStudents ?? 0
                    );

                    $('#p_activeStudents').text(
                        performance.activeStudents ?? 0
                    );

                    $('#p_totalTeachers').text(
                        performance.totalTeachers ?? 0
                    );

                    $('#p_activeTeachers').text(
                        performance.activeTeachers ?? 0
                    );

                    $('#p_totalSelProjects').text(
                        performance.totalSelProjects ?? 0
                    );

                    $('#p_familyProjects').text(
                        performance.familyProjects ?? 0
                    );

                    $('#p_individualProjects').text(
                        performance.individualProjects ?? 0
                    );

                    $('#p_groupPbl').text(
                        performance.groupPbl ?? 0
                    );

                    $('#f_totalSchools').text(
                        focused.schoolCount ?? 0
                    );

                    $('#f_totalStudents').text(
                        focused.totalStudents ?? 0
                    );

                    $('#f_activeStudents').text(
                        focused.activeStudents ?? 0
                    );

                    $('#f_totalTeachers').text(
                        focused.totalTeachers ?? 0
                    );

                    $('#f_activeTeachers').text(
                        focused.activeTeachers ?? 0
                    );

                    $('#f_totalSelProjects').text(
                        focused.totalSelProjects ?? 0
                    );

                    $('#f_familyProjects').text(
                        focused.familyProjects ?? 0
                    );

                    $('#f_individualProjects').text(
                        focused.individualProjects ?? 0
                    );

                    $('#f_groupPbl').text(
                        focused.groupPbl ?? 0
                    );

                },

                error: function(xhr) {

                    console.error(
                        'Dashboard count API error:',
                        xhr
                    );

                }

            });

        }
        
            // Global variable to store raw fetched data for filtering and sorting
        let currentCategory = '';
        let currentType = '';
        let currentPage = 1;
        let totalPages = 1;
        let searchTimeout = null;

        function openDetailsModal(category, type) {
            currentCategory = category;
            currentType = type;
            currentPage = 1;
            $('#modalTableSearch').val('');

            const titleMap = {
                'total-schools': 'Associated Schools',
                'total-students': 'Total Students',
                'active-students': 'Active Students',
                'total-teachers': 'Total Teachers',
                'active-teachers': 'Active Teachers',
                'sel-projects': 'Total SEL Projects',
                'family-projects': 'Family Projects',
                'individual-projects': 'Individual Projects',
                'group-pbl': 'Group PBL'
            };

            const categoryTitle = category === 'performance' ? 'Performance Report' : 'Focused Report';
            $('#modalTitle').text(categoryTitle + ' - ' + (titleMap[type] || 'Details'));

            showModalLoader();
            $('#dashboardDetailsModal').modal('show');
            loadModalDataPaged();
        }

        function showModalLoader() {
            $('#modalTable thead').html('');
            $('#modalTable tbody').html(`
                    <tr>
                        <td colspan="100%" class="text-center">
                            <div class="modal-loader">
                                <div class="spinner-border text-primary" role="status">
                                    <span class="visually-hidden">Loading...</span>
                                </div>
                                <div class="text-muted small mt-3">Fetching records from server...</div>
                            </div>
                        </td>
                    </tr>
                `);
        }

        function loadModalDataPaged() {
            let pageSize = parseInt($('#modalPageSize').val()) || 100;
            let searchTerm = $('#modalTableSearch').val().trim();

            $.ajax({
                url: `/api/admin/overall-details-paged`,
                type: 'GET',
                data: {
                    category: currentCategory,
                    type: currentType,
                    page: currentPage,
                    pageSize: pageSize,
                    search: searchTerm
                },
                headers: {
                    'Authorization': 'Bearer ' + getAuthToken()
                },
                success: function(res) {
                    if (!res || !res.success || !res.data || res.data.length === 0) {
                        $('#modalTable thead').html('');
                        $('#modalTable tbody').html(`
                                <tr>
                                    <td colspan="100%" class="text-center py-5">
                                        <div class="text-muted">
                                            <i class="bi bi-inbox fs-1 d-block mb-2"></i>
                                            <div class="fw-semibold">No records found</div>
                                            <small>No matching data available for your search criteria.</small>
                                        </div>
                                    </td>
                                </tr>
                            `);
                        $('#modalSubtitle').text('0 records');
                        $('#paginationInfo').text('Showing 0 entries');
                        $('#modalPagination').html('');
                        return;
                    }

                    totalPages = res.totalPages || 1;
                    renderTableHeaders(res.data[0]);
                    renderTableRows(res.data);
                    renderPagination(res.page, res.totalPages, res.totalRecords);
                },
                error: function(xhr) {
                    console.error('Paged API error:', xhr);
                    $('#modalTable tbody').html(`<tr><td colspan="100%" class="text-center py-4 text-danger">Failed to load records from server.</td></tr>`);
                }
            });
        }

        // Render headers with click-to-sort capability
        function renderTableHeaders(sampleRow) {
            if (!sampleRow) return;
            const keys = Object.keys(sampleRow);
            let thead = '<tr>';
            keys.forEach(key => {
                thead += `<th style="cursor: pointer;" onclick="sortModalTable('${key}')">
                                ${formatColumnName(key)} <i class="bi bi-arrow-down-up text-muted small ms-1"></i>
                              </th>`;
            });
            if (currentType === 'total-schools') {
                thead += `<th>Action</th>`;
            }
            thead += '</tr>';
            $('#modalTable thead').html(thead);
        }

        // Client-side sorting toggle for the currently loaded page items
        let sortDirection = {};
        function sortModalTable(key) {
            sortDirection[key] = !sortDirection[key];
            let asc = sortDirection[key];

            // Assuming current page data is stored globally or can be sorted from current rows
            // Let's sort the active rendered table rows directly or maintain a global dataset array.
            let $rows = $('#modalTable tbody tr').toArray();

            // Find column index
            let colIndex = -1;
            $('#modalTable th').each(function(index) {
                if ($(this).text().trim().toLowerCase().includes(formatColumnName(key).toLowerCase())) {
                    colIndex = index;
                }
            });

            if (colIndex === -1) return;

            $rows.sort((a, b) => {
                let valA = $(a).children('td').eq(colIndex).text().trim();
                let valB = $(b).children('td').eq(colIndex).text().trim();

                let numA = parseFloat(valA);
                let numB = parseFloat(valB);

                if (!isNaN(numA) && !isNaN(numB)) {
                    return asc ? numA - numB : numB - numA;
                }
                return asc ? valA.localeCompare(valB) : valB.localeCompare(valA);
            });

            $('#modalTable tbody').empty().append($rows);
        }

        function renderTableRows(data) {
            const keys = Object.keys(data[0]);
            let tbody = '';

            data.forEach(row => {
                tbody += '<tr>';
                keys.forEach(key => {
                    let value = row[key];
                    if (value === null || value === undefined || value === '') value = '-';
                    tbody += `<td>${escapeHtml(value)}</td>`;
                });

                if (currentType === 'total-schools') {
                    let instId = row.instituteId || row.InstituteID || row.id || row.ID || row.instituteID||0;
                    tbody += `<td>
                                    <button type="button" class="btn btn-sm btn-outline-primary" onclick="exportSingleInstituteReport(${instId}, this)">
                                        <i class="bi bi-file-earmark-excel me-1"></i> Export
                                    </button>
                                  </td>`;
                }
                tbody += '</tr>';
            });

            $('#modalTable tbody').html(tbody);
        }

        function renderPagination(page, totalP, totalRec) {
            let startEntry = ((page - 1) * parseInt($('#modalPageSize').val())) + 1;
            let endEntry = Math.min(page * parseInt($('#modalPageSize').val()), totalRec);

            $('#modalSubtitle').text(`${totalRec} total records`);
            $('#paginationInfo').text(`Showing ${startEntry} to ${endEntry} of ${totalRec} entries`);

            let paginationHtml = '';

            // Previous Button
            paginationHtml += `<li class="page-item ${page === 1 ? 'disabled' : ''}">
                                        <a class="page-link" href="#" onclick="changePage(${page - 1})">Prev</a>
                                   </li>`;

            // Page Number Windows
            let maxVisiblePages = 5;
            let startPage = Math.max(1, page - Math.floor(maxVisiblePages / 2));
            let endPage = Math.min(totalP, startPage + maxVisiblePages - 1);

            if (endPage - startPage + 1 < maxVisiblePages) {
                startPage = Math.max(1, endPage - maxVisiblePages + 1);
            }

            for (let i = startPage; i <= endPage; i++) {
                paginationHtml += `<li class="page-item ${i === page ? 'active' : ''}">
                                            <a class="page-link" href="#" onclick="changePage(${i})">${i}</a>
                                       </li>`;
            }

            // Next Button
            paginationHtml += `<li class="page-item ${page === totalP ? 'disabled' : ''}">
                                        <a class="page-link" href="#" onclick="changePage(${page + 1})">Next</a>
                                   </li>`;

            $('#modalPagination').html(paginationHtml);
        }

        function changePage(targetPage) {
            if (targetPage < 1 || targetPage > totalPages) return;
            currentPage = targetPage;
            showModalLoader();
            loadModalDataPaged();
        }

        // Debounced Server-Side Search Input
        $('#modalTableSearch').on('keyup', function() {
            clearTimeout(searchTimeout);
            searchTimeout = setTimeout(() => {
                currentPage = 1;
                showModalLoader();
                loadModalDataPaged();
            }, 400); // 400ms delay to prevent excessive queries while typing
        });

        $('#btnClearSearch').on('click', function() {
            $('#modalTableSearch').val('');
            currentPage = 1;
            showModalLoader();
            loadModalDataPaged();
        });

        $('#modalPageSize').on('change', function() {
            currentPage = 1;
            showModalLoader();
            loadModalDataPaged();
        });

        // Server-side full data export handler
        $('#btnExportModalData').on('click', function() {
            let searchTerm = $('#modalTableSearch').val().trim();
            let exportUrl = `/api/admin/export-details-excel?category=${currentCategory}&type=${currentType}&search=${encodeURIComponent(searchTerm)}`;

            showGlobalLoader("Generating Excel Export for Filtered Records...");

            // Trigger file download via temporary anchor
            var $anchor = $('<a />').attr({
                'href': exportUrl,
                'download': `${currentCategory}_${currentType}_Export.xlsx`
            }).appendTo('body');

            $anchor[0].click();
            setTimeout(() => {
                $anchor.remove();
                hideGlobalLoader();
            }, 1500);
        });
        function exportSingleInstituteReport(instituteId, buttonElement) {
            if (!instituteId || instituteId <= 0) {
                alert("Invalid Institute ID.");
                return;
            }

            var $btn = $(buttonElement);
            var originalHtml = $btn.html();

            $.ajax({
                type: "POST",
                url: '/api/Report/export-institute-summary',
                data: JSON.stringify({ instituteIDstr: instituteId.toString() }),
                contentType: "application/json; charset=utf-8",
                xhrFields: {
                    responseType: 'blob'
                },
                beforeSend: function() {
                    showGlobalLoader("Generating Institute Performance Report...");
                    $btn.prop('disabled', true).html('<span class="spinner-border spinner-border-sm me-1" role="status" aria-hidden="true"></span> Exporting...');
                },
                success: function(data) {
                    var blob = new Blob([data], { type: 'application/vnd.openxmlformats-officedocument.spreadsheetml.sheet' });
                    var url = window.URL.createObjectURL(blob);
                    var $anchor = $('<a />').attr({
                        'href': url,
                        'download': `Institute_${instituteId}_PerformanceReport.xlsx`
                    }).appendTo('body');

                    $anchor[0].click();

                    setTimeout(function() {
                        window.URL.revokeObjectURL(url);
                        $anchor.remove();
                    }, 100);
                },
                error: function(xhr, status, error) {
                    alert("Error downloading institute report: " + error);
                },
                complete: function() {
                    hideGlobalLoader();
                    $btn.prop('disabled', false).html(originalHtml);
                }
            });
        }

        function formatColumnName(key) {

            if (!key) {
                return '';
            }

            let result = key
                .replace(/([a-z])([A-Z])/g, '$1 $2')
                .replace(/_/g, ' ')
                .replace(/-/g, ' ');

            result =
                result.charAt(0).toUpperCase() +
                result.slice(1);

            return result;

        }

        function escapeHtml(value) {

            return $('<div>')
                .text(value)
                .html();

        }

    </script>

