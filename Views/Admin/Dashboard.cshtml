<!-- DETAILS MODAL WITH SERVER-SIDE PAGINATION & SEARCH -->
<!-- ========================================================= -->

<div class="modal fade"
     id="dashboardDetailsModal"
     tabindex="-1"
     aria-hidden="true">

    <div class="modal-dialog modal-dialog-centered modal-xl">

        <div class="modal-content rounded-4 border-0 shadow-lg">

            <!-- MODAL HEADER -->
            <div class="modal-header border-bottom px-4 py-3 flex-wrap gap-3">

                <div>
                    <h5 class="fw-bold text-dark mb-1" id="modalTitle">
                        Records List
                    </h5>
                    <small class="text-muted" id="modalSubtitle">
                        Loading records...
                    </small>
                </div>

                <!-- SEARCH & CONTROLS TOOLBAR -->
                <div class="d-flex align-items-center gap-3 ms-auto flex-wrap">
                    <!-- Server-Side Search Bar -->
                    <div class="input-group input-group-sm" style="width: 250px;">
                        <span class="input-group-text bg-light border-end-0"><i class="bi bi-search text-muted"></i></span>
                        <input type="text" id="modalTableSearch" class="form-control border-start-0 shadow-none" placeholder="Search database...">
                        <button class="btn btn-outline-secondary border-start-0" type="button" id="btnClearSearch"><i class="bi bi-x"></i></button>
                    </div>

                    <!-- Page Size Selector -->
                    <select id="modalPageSize" class="form-select form-select-sm shadow-none" style="width: 100px;">
                        <option value="25">25 rows</option>
                        <option value="50">50 rows</option>
                        <option value="100" selected>100 rows</option>
                        <option value="250">250 rows</option>
                         <option value="250">250 rows</option>
                        <option value="500">500 rows</option>
                        <option value="1000">1000 rows</option>
                        <option value="10000">10000 rows</option>
                    </select>

                    <!-- Export Button -->
                    <button type="button" class="btn btn-sm btn-success shadow-sm" id="btnExportModalData">
                        <i class="bi bi-file-earmark-excel me-1"></i> Export Excel
                    </button>
                </div>

                <button type="button" class="btn-close shadow-none" data-bs-dismiss="modal"></button>

            </div>

            <!-- MODAL BODY -->
            <div class="modal-body p-4">

                <div class="table-responsive border rounded-3 modal-table-wrapper" style="max-height: 420px;">
                    <table class="table table-hover align-middle mb-0" id="modalTable">
                        <thead class="table-light"></thead>
                        <tbody></tbody>
                    </table>
                </div>

            </div>

            <!-- MODAL FOOTER WITH PAGINATION -->
            <div class="modal-footer border-top px-4 py-3 justify-content-between align-items-center bg-light rounded-bottom-4">
                <div class="text-muted small" id="paginationInfo">
                    Showing 0 to 0 of 0 entries
                </div>

                <nav aria-label="Modal Pagination">
                    <ul class="pagination pagination-sm mb-0" id="modalPagination">
                        <!-- Dynamically injected pagination buttons -->
                    </ul>
                </nav>
            </div>

        </div>

    </div>

</div>
<!-- ========================================================= -->
<!-- GLOBAL PAGE LOADER OVERLAY -->
<!-- ========================================================= -->
<div id="globalLoader" class="global-loader-overlay" style="display: none;">
    <div class="text-center">
        <div class="spinner-border text-primary shadow-lg" style="width: 3.5rem; height: 3.5rem;" role="status">
            <span class="visually-hidden">Loading...</span>
        </div>
        <div class="fw-bold text-dark mt-3 fs-5" id="globalLoaderText">Generating Report, Please Wait...</div>
    </div>
</div>


