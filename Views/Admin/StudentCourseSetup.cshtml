@{
    ViewData["Title"] = "Student Course Master Setup";
    Layout = "~/Views/Shared/Layouts/_AdminLayout.cshtml"; 
}

<div class="container-fluid py-4">
    <h4 class="fw-bolder text-dark mb-4"><i class="bi bi-journal-album text-primary me-2"></i> Student Syllabus Setup</h4>

    <ul class="nav nav-tabs fw-bold" id="courseSetupTabs">
        <li class="nav-item"><a class="nav-link active" data-bs-toggle="tab" href="#tabMaster">1. Course & Week Master</a></li>
        <li class="nav-item"><a class="nav-link text-muted" data-bs-toggle="tab" href="#tabContent">2. Module Content Setup</a></li>
    </ul>

    <div class="tab-content border border-top-0 bg-white p-4 rounded-bottom shadow-sm">
        
        <!-- ==========================================
             TAB 1: COURSE & WEEK MASTER
        =========================================== -->
        <div class="tab-pane fade show active" id="tabMaster">
            <div class="row g-4">
                <!-- Left Side: Add Course Form -->
                <div class="col-md-4 border-end">
                    <h6 class="fw-bold text-muted mb-3">Filter by Standard</h6>
                    <select id="ddlStandardFilter" class="form-select shadow-none mb-4" onchange="filterChanged()">
                        <option value="">-- Select Standard --</option>
                    </select>

                    <h6 class="fw-bold text-muted mb-3 border-top pt-3">Add / Edit Course</h6>
                    <form id="frmAddCourse">
                        <input type="hidden" id="hdnStandardId" name="StandardId" />
                        <input type="hidden" id="hdnCourseId" name="Id" value="0" />
                        
                        <input type="text" id="txtCourseName" name="CourseName" class="form-control mb-2 shadow-none" placeholder="Course Name (e.g. Dutifulness)" required>
                        <input type="number" id="txtCoursePoints" name="TotalPoints" class="form-control mb-2 shadow-none" placeholder="Total Points" required>
                        <input type="number" id="txtCourseOrder" name="DisplayOrder" class="form-control mb-3 shadow-none" placeholder="Order (1, 2, 3..)" required>
                        
                        <div class="d-flex gap-2">
                            <button type="submit" class="btn btn-primary w-100 fw-bold rounded-pill">Save Course</button>
                            <button type="button" class="btn btn-light border fw-bold rounded-pill d-none" id="btnCancelEdit" onclick="cancelCourseEdit()">Cancel</button>
                        </div>
                    </form>
                </div>

                <!-- Right Side: Course List -->
                <div class="col-md-8">
                    <h6 class="fw-bold text-muted mb-3">Courses & Modules Roster</h6>
                    <div id="courseContainer">
                        <div class="text-center py-5 text-muted">
                            <i class="bi bi-arrow-left-circle fs-1"></i>
                            <p>Select a standard to load syllabus.</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- ==========================================
             TAB 2: MODULE CONTENT SETUP
        =========================================== -->
        <div class="tab-pane fade" id="tabContent">
            <div class="row g-4">
                
                <!-- Left: Content Upload Form -->
                <div class="col-md-5 border-end">
                    <h6 class="fw-bold text-dark mb-3"><i class="bi bi-cloud-upload-fill text-primary me-2"></i> Upload Content</h6>
                    <form id="frmAddContent">
                        <div class="mb-2">
                            <label class="small fw-bold">1. Select Standard</label>
                            <select id="ddlContentStandard" class="form-select shadow-none" onchange="loadContentCourses()"><option value="">-- Standard --</option></select>
                        </div>
                        <div class="mb-2">
                            <label class="small fw-bold">2. Select Course</label>
                            <select id="ddlContentCourse" class="form-select shadow-none" onchange="loadContentModules()" required><option value="">-- Course --</option></select>
                        </div>
                        <div class="mb-3">
                            <label class="small fw-bold">3. Select Week/Module</label>
                            <!-- ONCHANGE ADDED: Dropdown select karte hi list aayegi -->
                            <select id="ddlContentModule" name="ModuleId" class="form-select shadow-none" onchange="loadAdminContentList()" required><option value="">-- Week --</option></select>
                        </div>

                        <div class="border-top pt-3 mb-2">
                            <label class="small fw-bold">Tab Category</label>
                            <select name="TabCategory" id="ddlTabCategory" class="form-select shadow-none" required onchange="toggleContentFields()">
                                <option value="">-- Select Tab --</option>
                                <option value="LearningPath">Learning Path</option>
                                <option value="Labs">Practical Labs</option>
                                <option value="Videos">Videos & Documents</option>
                                <option value="Assessments">Assessments</option>
                            </select>
                        </div>

                        <!-- NEW FIELDS ADDED HERE -->
                        <div class="mb-2">
                            <label class="small fw-bold">Section Heading</label>
                            <input type="text" name="SectionHeading" class="form-control shadow-none" placeholder="e.g. BELIEFS SURVEY MCQ" required>
                        </div>
                        
                        <div class="row g-2 mb-2">
                            <div class="col-6">
                                <label class="small fw-bold">Card Tag</label>
                                <input type="text" name="CardTag" class="form-control shadow-none" placeholder="e.g. PRESURVEY">
                            </div>
                            <div class="col-6">
                                <label class="small fw-bold">Points / Score</label>
                                <input type="number" name="Points" class="form-control shadow-none" value="0">
                            </div>
                        </div>

                        <div class="row g-2 mb-2">
                            <div class="col-8">
                                <label class="small fw-bold">Card Title (Footer Text)</label>
                                <input type="text" name="Title" class="form-control shadow-none" placeholder="e.g. Beliefs Survey MCQ" required>
                            </div>
                            <div class="col-4">
                                <label class="small fw-bold">Display Order</label>
                                <input type="number" name="DisplayOrder" class="form-control shadow-none" value="1" required>
                            </div>
                        </div>

                        <div class="mb-2">
                            <label class="small fw-bold text-primary">Card Thumbnail (Image)</label>
                            <input type="file" name="ThumbnailFile" class="form-control shadow-none" accept="image/*" required>
                        </div>

                        <!-- Dynamic Fields -->
                        <div class="mb-2 d-none" id="divVideoUrl">
                            <label class="small fw-bold text-danger">Video URL (YouTube/External)</label>
                            <input type="url" name="VideoUrl" class="form-control shadow-none" placeholder="https://...">
                        </div>
                        <div class="mb-3 d-none" id="divResourceFile">
                            <label class="small fw-bold text-success">Resource Upload (PDF for Labs)</label>
                            <input type="file" name="ResourceFile" class="form-control shadow-none" accept=".pdf,.ppt,.pptx">
                        </div>

                        <button type="submit" class="btn btn-primary w-100 fw-bold rounded-pill shadow-sm py-2">Save Content to Selected Tab</button>
                    </form>
                </div>
                
                <!-- Right: Added Content List -->
                <div class="col-md-7">
                    <h6 class="fw-bold text-muted mb-3">Uploaded Content List</h6>
                    <div id="adminContentListContainer" class="p-3 bg-light rounded-3" style="min-height: 400px; border: 1px dashed #dee2e6;">
                        <div class="text-center py-5 text-muted"><p>Select a Week to view its contents.</p></div>
                    </div>
                </div>

            </div>
        </div>

    </div>
</div>

<!-- ==========================================
     MODAL: ADD MODULE / WEEK
=========================================== -->
<!-- ==========================================
     MODAL: ADD / EDIT MODULE (WEEK)
=========================================== -->
<div class="modal fade" id="modalAddModule" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content rounded-4 border-0 shadow-lg">
            <div class="modal-header border-0 pb-0">
                <h5 class="fw-bold text-dark"><i class="bi bi-calendar-check text-primary me-2"></i>Add / Edit Week</h5>
                <button type="button" class="btn-close shadow-none" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body p-4">
                <form id="frmAddModule">
                    <!-- HIDDEN IDs FOR EDITING -->
                    <input type="hidden" id="hdnModuleId" name="Id" value="0">
                    <input type="hidden" id="modalCourseId" name="CourseId">
                    
                    <label class="small fw-bold text-muted mb-1">Module Name</label>
                    <input type="text" name="ModuleName" id="txtModuleName" class="form-control mb-3 shadow-none" placeholder="e.g. Week 1" required>
                    
                    <label class="small fw-bold text-muted mb-1">Unlock Date</label>
                    <input type="date" name="UnlockDate" id="txtModuleDate" class="form-control mb-3 shadow-none" required>
                    
                    <div class="row">
                        <div class="col-6">
                            <label class="small fw-bold text-muted mb-1">Points</label>
                            <input type="number" name="Points" id="txtModulePoints" class="form-control mb-4 shadow-none" placeholder="e.g. 5" required>
                        </div>
                        <div class="col-6">
                            <label class="small fw-bold text-muted mb-1">Display Order</label>
                            <input type="number" name="DisplayOrder" id="txtModuleOrder" class="form-control mb-4 shadow-none" placeholder="e.g. 1" required>
                        </div>
                    </div>
                    
                    <button type="submit" class="btn btn-success w-100 fw-bold rounded-pill shadow-sm">Save Week</button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function() {
            // 1. Load Standards for both dropdowns
            $.get('/api/studentcourse/standards', function(res) {
                if(res.success) {
                    res.data.forEach(s => {
                        $('#ddlStandardFilter').append(`<option value="${s.id}">${s.standardName}</option>`);
                        $('#ddlContentStandard').append(`<option value="${s.id}">${s.standardName}</option>`);
                    });
                    
                    let savedStd = localStorage.getItem('selectedSetupStandard');
                    if (savedStd) {
                        $('#ddlStandardFilter').val(savedStd);
                        loadCourses(); 
                    }
                }
            });

            // 2. Submit Course Form
            $('#frmAddCourse').on('submit', function(e) {
                e.preventDefault();
                let stdId = $('#ddlStandardFilter').val();
                if(!stdId) { alert("Select standard first."); return; }
                $('#hdnStandardId').val(stdId);
                
                let isEdit = $('#hdnCourseId').val() != "0";
                let url = isEdit ? '/api/studentcourse/update-course' : '/api/studentcourse/add-course';

                $.ajax({ url: url, type: 'POST', data: new FormData(this), processData: false, contentType: false,
                    success: function() { 
                        alert("Course saved successfully!"); 
                        cancelCourseEdit();
                        loadCourses(); 
                    }
                });
            });

            // 3. Submit Module (Week) Form (Supports both Add & Edit)
            $('#frmAddModule').on('submit', function(e) {
                e.preventDefault();
                let isEdit = $('#hdnModuleId').val() != "0";
                let url = isEdit ? '/api/studentcourse/update-module' : '/api/studentcourse/add-module';

                $.ajax({ url: url, type: 'POST', data: new FormData(this), processData: false, contentType: false,
                    success: function() { 
                        alert("Week/Module saved successfully!"); 
                        $('#modalAddModule').modal('hide'); 
                        loadCourses(); 
                    }
                });
            });

            // 4. Submit Content Form (Tabs)
            $('#frmAddContent').on('submit', function(e) {
                e.preventDefault();
                let $btn = $(this).find('button[type="submit"]');
                $btn.prop('disabled', true).text('Uploading...');
                
                $.ajax({ url: '/api/studentcourse/add-content', type: 'POST', data: new FormData(this), processData: false, contentType: false,
                    success: function(res) { 
                        alert(res.message); 
                        $('#frmAddContent').find('input[type="text"], input[type="file"], input[type="url"], input[type="number"]').val('');
                        $('input[name="Points"]').val(0);
                        $('input[name="DisplayOrder"]').val(1);
                        toggleContentFields();
                        loadAdminContentList(); 
                    },
                    complete: function() { $btn.prop('disabled', false).text('Save Content to Selected Tab'); }
                });
            });
        });

        // ==========================================
        // COURSE & WEEK MASTER FUNCTIONS
        // ==========================================
        function filterChanged() {
            let stdId = $('#ddlStandardFilter').val();
            if (stdId) {
                localStorage.setItem('selectedSetupStandard', stdId);
                loadCourses();
            } else {
                localStorage.removeItem('selectedSetupStandard');
                $('#courseContainer').html('<div class="text-center py-5 text-muted">Select a standard to load syllabus.</div>');
            }
        }

        function loadCourses() {
            let stdId = $('#ddlStandardFilter').val();
            if(!stdId) return;
            $.get('/api/studentcourse/course-list/' + stdId, function(res) {
                let html = '';
                res.data.forEach(c => {
                    html += `<div class="card shadow-sm border-0 bg-light mb-3">
                        <div class="card-body d-flex justify-content-between align-items-center">
                            <h6 class="fw-bold m-0 text-primary">${c.courseName} <span class="badge bg-warning text-dark ms-2">${c.totalPoints} Pts</span></h6>
                            <div>
                                <button class="btn btn-sm btn-light border text-primary me-1" onclick="editCourse(${c.id}, '${c.courseName.replace(/'/g, "\\'")}', ${c.totalPoints}, ${c.displayOrder})" title="Edit Course"><i class="bi bi-pencil-fill"></i></button>
                                <button class="btn btn-sm btn-danger me-1" onclick="deleteCourse(${c.id})" title="Delete Course"><i class="bi bi-trash-fill"></i></button>
                                <button class="btn btn-sm btn-dark fw-bold rounded-pill px-3" onclick="openModuleModal(${c.id})">+ Add Week</button>
                            </div>
                        </div>
                        <ul class="list-group list-group-flush border-top">`;
                    
                    c.modules.forEach(m => {
                        let uDateObj = new Date(m.unlockDate);
                        let uDate = uDateObj.toLocaleDateString();
                        let rawDate = uDateObj.toISOString().split('T')[0];

                        html += `<li class="list-group-item bg-transparent d-flex justify-content-between align-items-center small">
                            <span><i class="bi bi-clock-history text-muted me-2"></i> <span class="fw-bold text-dark">${m.moduleName}</span> (Unlocks: ${uDate})</span>
                            <div>
                                <span class="badge bg-secondary me-3">${m.points} Pts</span>
                                <button class="btn btn-sm text-primary border-0 p-0 me-2" onclick="editModule(${m.id}, '${m.moduleName.replace(/'/g, "\\'")}', '${rawDate}', ${m.points}, ${m.displayOrder}, ${c.id})" title="Edit Week"><i class="bi bi-pencil-fill"></i></button>
                                <button class="btn btn-sm text-danger border-0 p-0" onclick="deleteModule(${m.id})" title="Delete Week"><i class="bi bi-trash-fill"></i></button>
                            </div>
                        </li>`;
                    });
                    
                    if(c.modules.length === 0) {
                        html += `<li class="list-group-item bg-transparent text-muted small py-3 text-center">No weeks added yet. Click "+ Add Week" to start.</li>`;
                    }
                    html += `</ul></div>`;
                });
                $('#courseContainer').html(html || '<div class="text-muted text-center py-4">No courses setup yet.</div>');
            });
        }

        function deleteCourse(id) {
            if(confirm("Are you sure you want to delete this course and all its weeks?")) {
                $.ajax({ url: '/api/studentcourse/delete-course/' + id, type: 'DELETE', 
                    success: function(res) { loadCourses(); }
                });
            }
        }

        function deleteModule(id) {
            if(confirm("Are you sure you want to delete this week?")) {
                $.ajax({ url: '/api/studentcourse/delete-module/' + id, type: 'DELETE', 
                    success: function(res) { loadCourses(); }
                });
            }
        }

        function editCourse(id, name, pts, order) {
            $('#hdnCourseId').val(id);
            $('#txtCourseName').val(name);
            $('#txtCoursePoints').val(pts);
            $('#txtCourseOrder').val(order);
            $('#btnCancelEdit').removeClass('d-none');
            $('#txtCourseName').focus();
        }

        function cancelCourseEdit() {
            $('#frmAddCourse')[0].reset();
            $('#hdnCourseId').val("0");
            $('#btnCancelEdit').addClass('d-none');
        }

        function openModuleModal(courseId) {
            $('#hdnModuleId').val("0"); // Reset for Add mode
            $('#modalCourseId').val(courseId);
            $('#frmAddModule')[0].reset();
            $('#modalAddModule').modal('show');
        }

        function editModule(id, name, date, points, order, courseId) {
            $('#hdnModuleId').val(id); // Set ID for Edit mode
            $('#modalCourseId').val(courseId);
            $('#txtModuleName').val(name);
            $('#txtModuleDate').val(date);
            $('#txtModulePoints').val(points);
            $('#txtModuleOrder').val(order);
            $('#modalAddModule').modal('show');
        }

        // ==========================================
        // CONTENT SETUP TAB FUNCTIONS
        // ==========================================
        function loadContentCourses() {
            let stdId = $('#ddlContentStandard').val();
            $('#ddlContentCourse').html('<option value="">-- Course --</option>');
            $('#ddlContentModule').html('<option value="">-- Week --</option>');
            $('#adminContentListContainer').html('<div class="text-center py-5 text-muted"><p>Select a Week to view contents.</p></div>');
            if(!stdId) return;
            $.get('/api/studentcourse/get-courses/' + stdId, function(res) {
                if(res.success) res.data.forEach(c => $('#ddlContentCourse').append(`<option value="${c.id}">${c.courseName}</option>`));
            });
        }

        function loadContentModules() {
            let courseId = $('#ddlContentCourse').val();
            $('#ddlContentModule').html('<option value="">-- Week --</option>');
            $('#adminContentListContainer').html('<div class="text-center py-5 text-muted"><p>Select a Week to view contents.</p></div>');
            if(!courseId) return;
            $.get('/api/studentcourse/get-modules/' + courseId, function(res) {
                if(res.success) res.data.forEach(m => $('#ddlContentModule').append(`<option value="${m.id}">${m.moduleName}</option>`));
            });
        }

        function toggleContentFields() {
            let tab = $('#ddlTabCategory').val();
            $('#divVideoUrl').addClass('d-none');
            $('#divResourceFile').addClass('d-none');
            
            if(tab === 'Videos') $('#divVideoUrl').removeClass('d-none');
            if(tab === 'Labs') $('#divResourceFile').removeClass('d-none');
        }

        function loadAdminContentList() {
            let moduleId = $('#ddlContentModule').val();
            if(!moduleId) {
                $('#adminContentListContainer').html('<div class="text-center py-5 text-muted"><p>Select a Week to view contents.</p></div>');
                return;
            }

            $('#adminContentListContainer').html('<div class="text-center py-5"><div class="spinner-border text-primary"></div></div>');

            $.get('/api/studentcourse/admin-content-list/' + moduleId, function(res) {
                let html = '';
                if(res.success && res.data.length > 0) {
                    res.data.forEach(item => {
                        html += `
                        <div class="card shadow-sm border-0 mb-3 rounded-3">
                            <div class="card-body p-3">
                                <div class="d-flex justify-content-between align-items-start mb-2">
                                    <span class="badge bg-dark text-uppercase">${item.tabCategory}</span>
                                    <button class="btn btn-sm btn-outline-danger border-0 p-1" onclick="deleteContentItem(${item.id})"><i class="bi bi-trash-fill"></i></button>
                                </div>
                                <div class="d-flex align-items-center gap-3 mt-2">
                                    <img src="${item.thumbnailUrl}" style="width: 70px; height: 50px; object-fit: cover; border-radius: 6px; border: 1px solid #ddd;" alt="Thumbnail">
                                    <div>
                                        <h6 class="m-0 fw-bold text-dark lh-sm">${item.title}</h6>
                                        <small class="text-muted d-block mt-1">Section: <b>${item.sectionHeading || 'N/A'}</b> | Tag: <b>${item.cardTag || 'N/A'}</b> | ${item.points} Pts</small>
                                    </div>
                                </div>
                            </div>
                        </div>`;
                    });
                } else {
                    html = '<div class="alert alert-info small text-center mt-4">No content found for this week. Add using the form on the left.</div>';
                }
                $('#adminContentListContainer').html(html);
            });
        }

        function deleteContentItem(id) {
            if(confirm('Are you sure you want to delete this content item?')) {
                $.ajax({ url: '/api/studentcourse/delete-content/' + id, type: 'DELETE',
                    success: function(res) { loadAdminContentList(); }
                });
            }
        }
    </script>
}