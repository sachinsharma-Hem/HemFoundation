@{
    ViewData["Title"] = "Plan Visit & Activities";
    Layout = "~/Views/Shared/Layouts/_TeacherLayout.cshtml";
}

@section Styles {
    <style>
        /* Fix z-index for Select2 inside Bootstrap modal */
        .select2-container {
            z-index: 1056 !important;
            width: 100% !important;
        }
    </style>
}

<div class="container-fluid py-4">
    <div class="d-flex align-items-center justify-content-between mb-4 flex-wrap gap-3">
        <div>
            <h3 class="fw-bold text-dark m-0"><i class="bi bi-calendar-check text-primary me-2"></i> Visit Plan & Other Activities</h3>
            <p class="text-muted small m-0">Schedule visits to your assigned schools or log other field activities.</p>
        </div>

        <!-- Filter & Action Bar -->
        <div class="d-flex align-items-center gap-2 flex-wrap">
            <input type="date" id="filterFromDate" class="form-control form-control-sm shadow-none" style="width: 140px;" title="From Date">
            <input type="date" id="filterToDate" class="form-control form-control-sm shadow-none" style="width: 140px;" title="To Date">
            <select id="filterStatus" class="form-select form-select-sm shadow-none" style="width: 130px;">
                <option value="">All Status</option>
                <option value="Pending">Pending</option>
                <option value="Completed">Completed</option>
                <option value="Cancelled">Cancelled</option>
            </select>
            <button class="btn btn-success btn-sm rounded-pill px-3 fw-semibold shadow-sm" onclick="loadPlans()">
                <i class="bi bi-search me-1"></i> Filter
            </button>
            <button class="btn btn-outline-secondary btn-sm rounded-pill px-3 fw-semibold shadow-sm" onclick="resetFilters()">
                <i class="bi bi-arrow-counterclockwise"></i>
            </button>
            <button class="btn btn-warning btn-sm rounded-pill px-3 fw-semibold shadow-sm text-dark" onclick="exportToExcel()">
                <i class="bi bi-file-earmark-excel-fill me-1"></i> Export Excel
            </button>
            <button class="btn btn-primary btn-sm rounded-pill px-3 fw-semibold shadow-sm" onclick="openPlanModal()">
                <i class="bi bi-plus-lg me-1"></i> Schedule New Visit
            </button>
        </div>
    </div>

    <div class="card border-0 shadow-sm rounded-4 bg-white p-4">
        <div class="table-responsive">
            <table class="table table-hover align-middle small">
                <thead class="table-light text-muted">
                    <tr>
                        <th>Type</th>
                        <th>School / Location Name</th>
                        <th>Schedule Date</th>
                        <th>Purpose</th>
                        <th class="text-center">Locations (Plan / Report)</th>
                        <th>Status</th>
                        <th class="text-center">Action</th>
                    </tr>
                </thead>
                <tbody id="planTableBody">
                    <tr><td colspan="7" class="text-center py-5"><div class="spinner-border spinner-border-sm"></div> Loading...</td></tr>
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- ================= MODAL: SCHEDULE VISIT / ACTIVITY ================= -->
<div class="modal fade" id="planModal" tabindex="-1" aria-hidden="true" data-bs-backdrop="static" data-bs-keyboard="false">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content rounded-4 border-0 shadow-lg p-4 bg-white">
            <div class="modal-header border-bottom pb-3">
                <h5 class="fw-bold text-dark m-0">Schedule Visit Plan</h5>
                <button type="button" class="btn-close shadow-none" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body py-3">
                <form id="frmPlan">
                    <input type="hidden" id="txtLat">
                    <input type="hidden" id="txtLng">

                    <div class="mb-3 form-check bg-light p-3 rounded-3 border">
                        <input type="checkbox" class="form-check-input" id="chkOtherActivity" onchange="toggleActivityType()">
                        <label class="form-check-label fw-bold text-dark ms-2" for="chkOtherActivity">
                            Is this an "Other Activity" (School not in assigned list)?
                        </label>
                    </div>

                    <div class="row g-3">
                        <div class="col-12" id="divSchoolDropdown">
                            <label class="form-label small fw-bold">Select Assigned School <span class="text-danger">*</span></label>
                            <select id="ddlSchool" class="form-select rounded-3 shadow-none" style="width: 100%;">
                                <option value="">-- Choose School --</option>
                            </select>
                        </div>

                        <div id="divOtherActivityFields" class="row g-3 d-none">
                            <div class="col-md-6">
                                <label class="form-label small fw-bold">School / Organization Name <span class="text-danger">*</span></label>
                                <input type="text" id="txtSchoolName" class="form-control rounded-3 shadow-none">
                            </div>
                            <div class="col-md-6">
                                <label class="form-label small fw-bold">Pincode <span class="text-danger">*</span></label>
                                <input type="text" id="txtPincode" class="form-control rounded-3 shadow-none" maxlength="6" placeholder="Enter 6-digit pincode">
                            </div>
                            <div class="col-12">
                                <label class="form-label small fw-bold">Address <span class="text-danger">*</span></label>
                                <input type="text" id="txtAddress" class="form-control rounded-3 shadow-none">
                            </div>
                            <div class="col-md-6">
                                <label class="form-label small fw-bold">City <span class="text-danger">*</span></label>
                                <input type="text" id="txtCity" class="form-control rounded-3 shadow-none bg-light" readonly>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label small fw-bold">State <span class="text-danger">*</span></label>
                                <input type="text" id="txtState" class="form-control rounded-3 shadow-none bg-light" readonly>
                            </div>
                        </div>

                        <div class="col-md-6">
                            <label class="form-label small fw-bold">Schedule Date & Time <span class="text-danger">*</span></label>
                            <input type="datetime-local" id="txtScheduleDate" class="form-control rounded-3 shadow-none" required>
                        </div>
                        <div class="col-12">
                            <label class="form-label small fw-bold">Purpose / Visit Reason <span class="text-danger">*</span></label>
                            <textarea id="txtPurpose" class="form-control rounded-3 shadow-none" rows="3" required></textarea>
                        </div>
                    </div>
                    <button type="submit" class="btn btn-primary w-100 rounded-pill fw-bold shadow-sm mt-4">Save Plan</button>
                </form>
            </div>
        </div>
    </div>
</div>

<!-- ================= MODAL: UPDATE PROGRESS / COMPLETE VISIT ================= -->
<div class="modal fade" id="updateModal" tabindex="-1" aria-hidden="true" data-bs-backdrop="static" data-bs-keyboard="false">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content rounded-4 border-0 shadow-lg p-4 bg-white">
            <div class="modal-header border-bottom pb-3">
                <h5 class="fw-bold text-dark m-0">Update Visit Progress</h5>
                <button type="button" class="btn-close shadow-none" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body py-3">
                <form id="frmUpdate">
                    <input type="hidden" id="updatePlanId">
                    <input type="hidden" id="updateLat">
                    <input type="hidden" id="updateLng">

                    <div class="mb-3">
                        <label class="form-label small fw-bold">Status <span class="text-danger">*</span></label>
                        <select id="updateStatus" class="form-select rounded-3 shadow-none" required>
                            <option value="Pending">Pending</option>
                            <option value="Completed">Completed</option>
                            <option value="Cancelled">Cancelled</option>
                        </select>
                    </div>

                    <div class="mb-3">
                        <label class="form-label small fw-bold">Actual Visit Date & Time <span class="text-danger">*</span></label>
                        <input type="datetime-local" id="updateVisitDate" class="form-control rounded-3 shadow-none" required>
                    </div>

                    <div class="mb-3">
                        <label class="form-label small fw-bold">Remarks / Notes <span class="text-danger">*</span></label>
                        <textarea id="updateRemarks" class="form-control rounded-3 shadow-none" rows="3" required></textarea>
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-bold">Upload Photo / Open Camera <span class="text-danger">*</span></label>
                        <input type="file" id="updateImage" class="form-control rounded-3 shadow-none" accept="image/*" capture="environment">
                        <small class="text-muted">Photo proof is mandatory for completion.</small>
                    </div>
                    <button type="submit" class="btn btn-success w-100 rounded-pill fw-bold shadow-sm mt-3">Update Status</button>
                </form>
            </div>
        </div>
    </div>
</div>

<!-- Lightbox Modal -->
<div class="modal fade" id="photoModal" tabindex="-1" aria-hidden="true" data-bs-backdrop="static" data-bs-keyboard="false">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 rounded-4 overflow-hidden shadow">
            <div class="modal-header border-0 pb-0">
                <h5 class="fw-bold m-0">Visit Photo Proof</h5>
                <button type="button" class="btn-close shadow-none" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body text-center p-4">
                <img id="modalVisitImg" src="" alt="Visit Photo" class="img-fluid rounded-3 shadow-sm" style="max-height: 400px;" />
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>
        $(function() {
            $('#ddlSchool').select2({
                theme: 'bootstrap-5',
                dropdownParent: $('#planModal'),
                placeholder: '-- Choose School --',
                allowClear: true
            });

            const urlParams = new URLSearchParams(window.location.search);
            if (urlParams.has('status')) {
                $('#filterStatus').val(urlParams.get('status'));
            }
            if (urlParams.has('fromDate')) {
                $('#filterFromDate').val(urlParams.get('fromDate'));
            }
            if (urlParams.has('toDate')) {
                $('#filterToDate').val(urlParams.get('toDate'));
            }

            loadPlans();
            loadAssignedSchoolsDropdown();
            setMinDateTime();
            setupPincodeLookup();
        });

        function exportToExcel() {
            let fromDate = $('#filterFromDate').val();
            let toDate = $('#filterToDate').val();
            let status = $('#filterStatus').val();

            let queryParams = new URLSearchParams();
            if (fromDate) queryParams.append('fromDate', fromDate);
            if (toDate) queryParams.append('toDate', toDate);
            if (status) queryParams.append('status', status);

            let url = '/api/volunteer-plan/export-excel' + (queryParams.toString() ? '?' + queryParams.toString() : '');
            window.location.href = url;
        }

        function setMinDateTime() {
            let now = new Date();
            now.setMinutes(now.getMinutes() - now.getTimezoneOffset());
            let minDateTime = now.toISOString().slice(0, 16);
            $('#txtScheduleDate').attr('min', minDateTime);
        }

        function setupPincodeLookup() {
            $('#txtPincode').on('input blur', function() {
                let pin = $(this).val().replace(/\D/g, '').slice(0, 6);
                $(this).val(pin);

                if (pin.length === 6) {
                    $.get(`https://api.postalpincode.in/pincode/${pin}`, function(data) {
                        if (data && data[0].Status === "Success") {
                            let po = data[0].PostOffice[0];
                            $('#txtCity').val(po.District || po.Region || '');
                            $('#txtState').val(po.State || '');
                        } else {
                            $('#txtCity').val('');
                            $('#txtState').val('');
                        }
                    });
                } else {
                    $('#txtCity').val('');
                    $('#txtState').val('');
                }
            });
        }

        function getCurrentLocation() {
            return new Promise((resolve, reject) => {
                if (navigator.geolocation) {
                    navigator.geolocation.getCurrentPosition(
                        function(position) {
                            resolve({
                                lat: position.coords.latitude,
                                lng: position.coords.longitude
                            });
                        },
                        function(error) {
                            reject(error);
                        },
                        { timeout: 10000, enableHighAccuracy: true }
                    );
                } else {
                    reject(new Error("Geolocation is not supported by this browser."));
                }
            });
        }

        function loadAssignedSchoolsDropdown() {
            $.ajax({
                url: '/api/volunteer-plan/assigned-schools',
                type: 'GET',
                success: function(res) {
                    if (res.success) {
                        let html = '<option value="">-- Choose School --</option>';
                        res.data.forEach(s => html += `<option value="${s.instituteID}">${s.name}</option>`);
                        $('#ddlSchool').html(html).trigger('change');
                    }
                }
            });
        }

        function loadPlans() {
            let fromDate = $('#filterFromDate').val();
            let toDate = $('#filterToDate').val();
            let status = $('#filterStatus').val();

            let queryParams = new URLSearchParams();
            if (fromDate) queryParams.append('fromDate', fromDate);
            if (toDate) queryParams.append('toDate', toDate);
            if (status) queryParams.append('status', status);

            let url = '/api/volunteer-plan/list' + (queryParams.toString() ? '?' + queryParams.toString() : '');

            $('#planTableBody').html('<tr><td colspan="7" class="text-center py-5"><div class="spinner-border spinner-border-sm"></div> Loading...</td></tr>');

            $.ajax({
                url: url,
                type: 'GET',
                success: function(res) {
                    if (res.success && res.data.length > 0) {
                        let html = '';
                        res.data.forEach(p => {
                            let typeBadge = p.isOtherActivity ? '<span class="badge bg-warning-subtle text-warning">Other Activity</span>' : '<span class="badge bg-primary-subtle text-primary">School Visit</span>';

                            let statusLower = (p.status || '').toLowerCase();
                            let statusBadge = statusLower === 'completed' ? 'bg-success-subtle text-success' : (statusLower === 'cancelled' ? 'bg-danger-subtle text-danger' : 'bg-warning-subtle text-warning');

                            let planLocBtn = (p.planLatitude && p.planLongitude)
                                ? `<a href="https://www.google.com/maps?q=${p.planLatitude},${p.planLongitude}" target="_blank" class="btn btn-outline-primary btn-sm rounded-circle p-1 shadow-none me-2" title="View Plan Location"><i class="bi bi-map-fill"></i></a>`
                                : `<span class="text-muted me-2">-</span>`;

                            let reportLocBtn = (p.reportLatitude && p.reportLongitude)
                                ? `<a href="https://www.google.com/maps?q=${p.reportLatitude},${p.reportLongitude}" target="_blank" class="btn btn-outline-success btn-sm rounded-circle p-1 shadow-none" title="View Report Location"><i class="bi bi-geo-alt-fill"></i></a>`
                                : `<span class="text-muted">-</span>`;

                            let photoIcon = p.imagePath
                                ? `<button class="btn btn-outline-secondary btn-sm rounded-circle p-1 shadow-none ms-2" onclick="viewPhoto('${p.imagePath}')" title="View Uploaded Photo"><i class="bi bi-image-fill text-info"></i></button>`
                                : `<span class="text-muted ms-2" title="No Photo">-</span>`;

                            let visitDateStr = p.visitDate ? new Date(p.visitDate).toLocaleString('en-GB') : '<span class="text-muted">Not Visited</span>';

                            let actionBtn = (statusLower === 'completed' || statusLower === 'cancelled')
                                ? `<span class="badge bg-light text-muted border px-2 py-1"><i class="bi bi-lock-fill me-1"></i> Locked (${p.status})</span>`
                                : `<button class="btn btn-sm btn-light border text-primary shadow-none" onclick="openUpdateModal(${p.id})"><i class="bi bi-pencil-square me-1"></i> Update</button>`;

                            html += `<tr>
                                        <td>${typeBadge}</td>
                                        <td><b>${p.schoolName || 'N/A'}</b></td>
                                        <td>
                                            <div><b>Plan:</b> ${new Date(p.scheduleDate).toLocaleString('en-GB')}</div>
                                            <div class="text-muted small"><b>Visit:</b> ${visitDateStr}</div>
                                        </td>
                                        <td>${p.purpose}</td>
                                        <td class="text-center">
                                            <div class="d-flex align-items-center justify-content-center gap-1">
                                                <span><b>Plan:</b> ${planLocBtn}</span>
                                                <span><b>Rep:</b> ${reportLocBtn}</span>
                                                <span><b>Pic:</b> ${photoIcon}</span>
                                            </div>
                                        </td>
                                        <td><span class="badge ${statusBadge}">${p.status}</span></td>
                                        <td class="text-center">${actionBtn}</td>
                                    </tr>`;
                        });
                        $('#planTableBody').html(html);
                    } else {
                        $('#planTableBody').html('<tr><td colspan="7" class="text-center py-5 text-muted">No visit plans found for selected filters.</td></tr>');
                    }
                }
            });
        }

        function resetFilters() {
            $('#filterFromDate').val('');
            $('#filterToDate').val('');
            $('#filterStatus').val('');
            window.history.replaceState({}, document.title, window.location.pathname);
            loadPlans();
        }

        function viewPhoto(path) {
            $('#modalVisitImg').attr('src', path);
            $('#photoModal').modal('show');
        }

        function openUpdateModal(id) {
            $('#updatePlanId').val(id);
            $('#frmUpdate')[0].reset();

            let now = new Date();
            now.setMinutes(now.getMinutes() - now.getTimezoneOffset());
            let currentDateTime = now.toISOString().slice(0, 16);

            $('#updateVisitDate').attr('min', currentDateTime);
            $('#updateVisitDate').removeAttr('max'); 
            $('#updateVisitDate').val(currentDateTime); 

            $('#updateModal').modal('show');
        }

        $('#frmUpdate').on('submit', async function(e) {
            e.preventDefault();

            let lat = '', lng = '';
            try {
                let coords = await getCurrentLocation();
                lat = coords.lat;
                lng = coords.lng;
            } catch (err) {
                Swal.fire({
                    icon: 'warning',
                    title: 'Location Permission Required',
                    html: 'Location access is blocked or denied. Please click the <b>Lock/Settings icon</b> in your browser address bar, enable location permission, and try again.',
                    confirmButtonColor: '#198754'
                });
                return;
            }

            let formData = new FormData();
            formData.append('id', $('#updatePlanId').val());
            formData.append('status', $('#updateStatus').val());
            formData.append('visitDate', $('#updateVisitDate').val());
            formData.append('remarks', $('#updateRemarks').val());
            formData.append('latitude', lat);
            formData.append('longitude', lng);

            let fileInput = $('#updateImage')[0].files[0];
            if (fileInput) {
                formData.append('visitImage', fileInput);
            } else if ($('#updateStatus').val() === 'Completed') {
                Swal.fire({ icon: 'warning', title: 'Required', text: 'Please upload a photo proof to submit.', confirmButtonColor: '#198754' });
                return;
            }

            $.ajax({
                url: '/api/volunteer-plan/update-progress',
                type: 'POST',
                data: formData,
                contentType: false,
                processData: false,
                success: function(res) {
                    if (res.success) {
                        $('#updateModal').modal('hide');
                        loadPlans();
                        Swal.fire({ icon: 'success', title: 'Updated', text: res.message || 'Progress updated successfully!', timer: 1500, showConfirmButton: false });
                    } else {
                        Swal.fire({ icon: 'error', title: 'Error', text: res.message, confirmButtonColor: '#dc3545' });
                    }
                },
                error: function(xhr) {
                    Swal.fire({ icon: 'error', title: 'Error', text: xhr.responseJSON?.message || "Error updating progress.", confirmButtonColor: '#dc3545' });
                }
            });
        });

        function openPlanModal() {
            $('#frmPlan')[0].reset();
            $('#ddlSchool').val('').trigger('change');
            $('#chkOtherActivity').prop('checked', false);
            toggleActivityType();
            setMinDateTime();

            $('#planModal').modal('show');
        }

        function toggleActivityType() {
            if ($('#chkOtherActivity').is(':checked')) {
                $('#divSchoolDropdown').addClass('d-none');
                $('#ddlSchool').removeAttr('required');
                $('#divOtherActivityFields').removeClass('d-none');
                $('#txtSchoolName, #txtAddress, #txtPincode, #txtCity, #txtState').attr('required', 'required');
            } else {
                $('#divOtherActivityFields').addClass('d-none');
                $('#txtSchoolName, #txtAddress, #txtPincode, #txtCity, #txtState').removeAttr('required');
                $('#divSchoolDropdown').removeClass('d-none');
                $('#ddlSchool').attr('required', 'required');
            }
        }

        $('#frmPlan').on('submit', async function(e) {
            e.preventDefault();

            let isOther = $('#chkOtherActivity').is(':checked');
            let pincodeVal = $('#txtPincode').val().trim();

            if (isOther && (!/^\d{6}$/.test(pincodeVal))) {
                Swal.fire({ icon: 'warning', title: 'Invalid Pincode', text: 'Please enter a valid 6-digit numeric pincode.', confirmButtonColor: '#dc3545' });
                return;
            }

            let lat = '', lng = '';
            try {
                let coords = await getCurrentLocation();
                lat = coords.lat;
                lng = coords.lng;
            } catch (err) {
                Swal.fire({
                    icon: 'warning',
                    title: 'Location Permission Required',
                    html: 'Location access is blocked or denied. Please click the <b>Lock/Settings icon</b> in your browser address bar, enable location permission, and try again.',
                    confirmButtonColor: '#198754'
                });
                return;
            }

            let payload = {
                IsOtherActivity: isOther,
                InstituteId: isOther ? null : (parseInt($('#ddlSchool').val()) || null),
                SchoolName: isOther ? $('#txtSchoolName').val() : null,
                Address: isOther ? $('#txtAddress').val() : null,
                Pincode: isOther ? pincodeVal : null,
                City: isOther ? $('#txtCity').val() : null,
                State: isOther ? $('#txtState').val() : null,
                ScheduleDate: $('#txtScheduleDate').val(),
                Purpose: $('#txtPurpose').val(),
                PlanLatitude: lat,
                PlanLongitude: lng
            };

            $.ajax({
                url: '/api/volunteer-plan/save',
                type: 'POST',
                contentType: 'application/json',
                data: JSON.stringify(payload),
                success: function(res) {
                    if (res.success) {
                        $('#planModal').modal('hide');
                        loadPlans();
                        Swal.fire({ icon: 'success', title: 'Success', text: 'Visit plan scheduled successfully!', timer: 1500, showConfirmButton: false });
                    } else {
                        Swal.fire({ icon: 'error', title: 'Error', text: res.message, confirmButtonColor: '#dc3545' });
                    }
                }
            });
        });
    </script>
}