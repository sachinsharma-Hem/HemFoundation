        function switchWorkspaceSubTab(btnElement, targetFilterKeyword) {
            $('.workspace-tab-link').removeClass('tab-active');
            $(btnElement).addClass('tab-active');
            renderFilteredDeckCards(targetFilterKeyword);
        }

        function renderFilteredDeckCards(filterKeyword) {
            var gridContainer = $('#tabbedDeckGrid');
            if (!activeCourseDataCache) return;
            var rawRows = activeCourseDataCache.sqlRawRows || activeCourseDataCache.SqlRawRows;
            if (!rawRows) return;

            var html = '';
            var matchCount = 0;
            var renderedTopics = {};
            var currentFilter = filterKeyword.toLowerCase().trim();
            var currentParentCourseId = activeCourseDataCache.courseID || activeCourseDataCache.CourseID || 0;
            var lastSurveyOrMcqPassed = true;

            $.each(rawRows, function(idx, row) {
                if (!row) return;

                var activityType = determineActivityType(row, activeWeekGlobalIndex);
                var pracCode = row.practicalCode || row.PracticalCode || '';
                var codeVal = pracCode.toString().trim().toUpperCase();
                var subNameVal = row.subTopicName || row.SubTopicName || '';
                var subName = subNameVal.toString().toLowerCase();

                var isTruePracticalGame = (codeVal !== '' && codeVal !== '0' && codeVal !== 'NULL') ? true : false;
                var isPureStudyPdf = subName.includes('pdf');
                if (isPureStudyPdf) {
                    isTruePracticalGame = false;
                    activityType = 'pdf';
                }

                var topicIdVal = row.topicID || row.TopicID || 0;
                var parentTopicIdVal = row.parentTopicID || row.ParentTopicID || 0;
                var trainerExVal = row.trainerExercise || row.TrainerExercise;
                var trainerVidVal = row.trainerVideo || row.TrainerVideo;
                var noOfQVal = row.noOfQuestion !== undefined ? row.noOfQuestion : (row.NoOfQuestion || 0);

                var isParentCategoryRowOnly = (topicIdVal && (!parentTopicIdVal || parentTopicIdVal === 0 || parentTopicIdVal === '0' || parentTopicIdVal === 999999) && !isTruePracticalGame && !isPureStudyPdf && !trainerExVal && !trainerVidVal && noOfQVal === 0) ? true : false;
                if (isParentCategoryRowOnly) return;

                var isMatch = false;
                if (currentFilter === 'learning') {
                    if (!isTruePracticalGame) isMatch = true;
                } else if (currentFilter === 'practical') {
                    if (isTruePracticalGame) isMatch = true;
                } else if (currentFilter === 'video') {
                    if (!isTruePracticalGame && (activityType === 'video' || activityType === 'pdf')) isMatch = true;
                } else if (currentFilter === 'quiz') {
                    if (!isTruePracticalGame && (activityType === 'mcq' || activityType === 'presurvey' || activityType === 'postsurvey')) isMatch = true;
                }

                if (!isMatch) return;
                matchCount++;

                var isAssessmentItem = (activityType === 'mcq' || activityType === 'presurvey' || activityType === 'postsurvey');
                var ismcq = (activityType === 'mcq');
                var isItemLockedByProgression = false;
                var lockMessage = "Please complete the previous task first.";
                var statusIcon = '';
                var isAttemptedVal = row.isAttempted !== undefined ? row.isAttempted : row.IsAttempted;

                if (isAssessmentItem) {
                    if (!lastSurveyOrMcqPassed) {
                        isItemLockedByProgression = true;
                    }
                    lastSurveyOrMcqPassed = (isAttemptedVal === true);
                }

                if (isAttemptedVal === true) {
                    isItemLockedByProgression = true;
                    lockMessage = "This task has already been completed.";
                    statusIcon = '<i class="fa fa-check-circle" style="font-size: 40px; color: #10b981;"></i>';
                } else if (isItemLockedByProgression && isAssessmentItem) {
                    statusIcon = '<i class="fa fa-lock" style="font-size: 40px; color: #64748b;"></i>';
                }

                var topicNameVal = row.topicName || row.TopicName || 'Core Learning Path Content';
                var categoryGroupKey = isTruePracticalGame ? 'PRACTICAL_LABS_GAMES_GROUP' : topicNameVal;
                if (!renderedTopics[categoryGroupKey]) {
                    var headerLabelText = isTruePracticalGame ? 'Interactive Game & Practical Labs' : categoryGroupKey;
                    html += '<div class="section-path-divider"><i class="fa fa-tags text-muted"></i>&nbsp;&nbsp;' + headerLabelText + '</div>';
                    renderedTopics[categoryGroupKey] = true;
                }

                var courseNameVal = activeCourseDataCache.courseName || activeCourseDataCache.CourseName;
                var launchUrl = getLaunchUrl(row, activityType, courseNameVal, currentParentCourseId);
                var imgUrl = 'https://images.unsplash.com/photo-1516321318423-f06f85e504b3?q=80&w=600';

                if (activityType === 'video' && trainerVidVal && trainerVidVal !== 'NULL') {
                    imgUrl = getYouTubeThumbnail(trainerVidVal);
                } else if (trainerExVal && trainerExVal.trim() !== '' && trainerExVal !== 'NULL') {
                    imgUrl = trainerExVal.replace(/^~\//, 'https://www.hemvirtues.in/');
                }

                var typeBadge = isTruePracticalGame ? 'Practical Lab' : activityType;
                var currentScoreObtained = row.itemScore !== undefined ? row.itemScore : (row.ItemScore || 0);

                var cardActionHandlerString = '';
                var cardClassModifiers = 'clickable-card';
                if (isTruePracticalGame) {
                    cardClassModifiers = '';
                } else if (isItemLockedByProgression) {
                    cardClassModifiers = (isAttemptedVal === true) ? 'completed-card' : 'micro-locked-card';
                }

                var isUploadGame = (pracCode === 'G_E_011');
                var isfamilyUploadGame = (pracCode === 'G_E_010');
                var safeName = (subNameVal || 'Upload Task').replace(/'/g, "\\'");
                var practicalIdVal = row.practicalID || row.PracticalID || 0;

                if (isUploadGame) {
                    if (isStudent) {
                        cardActionHandlerString = isItemLockedByProgression
                            ? 'onclick="Swal.fire({title: \'' + (isAttemptedVal === true ? "Completed" : "Locked") + '\', text: \'' + lockMessage + '\', icon: \'' + (isAttemptedVal === true ? "success" : "info") + '\', confirmButtonColor: \'#0284c7\'});"'
                            : 'onclick="openUploadModal(\'' + practicalIdVal + '\', \'' + safeName + '\', \'' + (courseNameVal || '').replace(/'/g, "\\'") + '\')"';
                    } else {
                        cardActionHandlerString = 'onclick="Swal.fire(\'Message\',\'Read-only access\',\'info\')"';
                    }
                } else if (isfamilyUploadGame) {
                    if (isStudent) {
                        cardActionHandlerString = isItemLockedByProgression
                            ? 'onclick="Swal.fire({title: \'' + (isAttemptedVal === true ? "Completed" : "Locked") + '\', text: \'' + lockMessage + '\', icon: \'' + (isAttemptedVal === true ? "success" : "info") + '\', confirmButtonColor: \'#0284c7\'});"'
                            : 'onclick="openFamilyUploadModal(\'' + practicalIdVal + '\', \'' + safeName + '\', \'' + (courseNameVal || '').replace(/'/g, "\\'") + '\')"';
                    } else {
                        cardActionHandlerString = 'onclick="Swal.fire(\'Message\',\'Read-only access\',\'info\')"';
                    }
                } else if (isItemLockedByProgression) {
                    cardActionHandlerString = `onclick="Swal.fire({title: '${isAttemptedVal === true ? "Completed" : "Locked"}', text: '${lockMessage}', icon: '${isAttemptedVal === true ? "success" : "info"}', confirmButtonColor: '#0284c7'});"`;
                } else {
                    cardActionHandlerString = `onclick="evaluateAndExecuteLaunch('${activityType}', '${launchUrl}', '${safeName}')"`;
                }

                var statusOverlay = statusIcon !== ''
                    ? `<div style="position: absolute; top: 0; left: 0; width: 100%; height: 100%; display: flex; align-items: center; justify-content: center; background: rgba(255, 255, 255, 0.4); z-index: 10;">${statusIcon}</div>`
                    : '';

                var scoreBadgeHtml = '';
                if (activityType === 'video' || activityType === 'presurvey' || activityType === 'postsurvey' || activityType === 'pdf') {
                    scoreBadgeHtml = ``;
                } else if (isTruePracticalGame) {
                    scoreBadgeHtml = `<span class="lrn-score-badge bg-warning text-dark border border-warning"><i class="fa fa-database mr-1"></i>Score : ${currentScoreObtained} Pts</span>`;
                } else {
                    scoreBadgeHtml = `<span class="lrn-score-badge bg-info text-white border border-info"><i class="fa fa-star mr-1"></i>${currentScoreObtained} Pts</span>`;
                }

                html += `<div class="activity-card animate__animated animate__fadeInUp ${cardClassModifiers}" ${cardActionHandlerString} style="animation-duration:0.3s;">
                           <div class="lrn-card-media">
                               ${statusOverlay}
                               <span class="lrn-type-badge">${typeBadge}</span>
                               ${scoreBadgeHtml}
                               ${activityType == "video" ? `<div class="lrn-play-btn shadow-lg"><i class="fa fa-play"></i></div>` : ""}
                               <img class="img-fluid lrn-card-img" src="${imgUrl}" onerror="this.onerror=null;this.src='https://images.unsplash.com/photo-1516321318423-f06f85e504b3?q=80&w=600';">
                           </div>
                           <div class="activity-card-body">
                               <h4 class="activity-card-title">${subNameVal || 'Module Assignment Task'}</h4>
                           </div>`;

                var resVal = row.resources || row.Resources;
                if (isTruePracticalGame) {
                    html += '<div class="activity-card-footer">';
                    if (resVal && resVal.trim() !== '' && resVal !== 'NULL') {
                        var cleanRes = resVal.replace(/^~\//, 'https://www.hemvirtues.in/');
                        html += '<a href="' + cleanRes + '" download class="btn btn-action-pill btn-pill-secondary" target="blank" onclick="event.stopPropagation()"><i class="fa fa-download"></i> Resources</a>';
                    }
                    if (trainerVidVal && trainerVidVal.trim() !== '' && trainerVidVal !== 'NULL') {
                        var tutorialCleanUrl = trainerVidVal.replace(/^~\//, 'https://www.hemvirtues.in/');
                        html += '<button type="button" class="btn btn-action-pill btn-pill-secondary" onclick="event.stopPropagation();openMediaModal(\'' + tutorialCleanUrl + '\', \'Tutorial\')"><i class="fa fa-video-camera"></i> Tutorial</button>';
                    }
                    if (isAttemptedVal === true) {
                        html += '<a class="btn btn-action-pill btn-pill-primary">Completed</a>';
                    } else if (pracCode === 'G_E_011') {
                        if (isStudent) {
                            html += `<button type="button" onclick="openUploadModal(${practicalIdVal}, '${safeName}','${courseNameVal}')" class="btn btn-action-pill btn-pill-primary" style="background:var(--amber-500) !important;"><i class="fa fa-upload"></i> Upload Task</button>`;
                        } else {
                            html += `<span class="text-muted small"><em>Read-only access</em></span>`;
                        }
                    } else if (pracCode === 'G_E_010') {
                        if (isStudent) {
                            html += `<button type="button" onclick="openFamilyUploadModal(${practicalIdVal}, '${safeName}','${courseNameVal}')" class="btn btn-action-pill btn-pill-primary" style="background:var(--amber-500) !important;"><i class="fa fa-upload"></i> Upload Task</button>`;
                        } else {
                            html += `<span class="text-muted small"><em>Read-only access</em></span>`;
                        }
                    } else {
                        if (isStudent) {
                            html += '<a href="' + launchUrl + '" class="btn btn-action-pill btn-pill-primary">Start Game</a>';
                        } else {
                            html += `<span class="text-muted small"><em>Read-only access</em></span>`;
                        }
                    }
                    html += '</div>';
                }

                if (ismcq) {
                    html += '<div class="activity-card-footer">';
                    if (isAttemptedVal === true) {
                        var quizIdVal = row.quizID || row.QuizID || 0;
                        var langIdVal = row.languageID || row.LanguageID || 1;
                        var examIdVal = row.examinationID || row.ExaminationID || 0;
                        html += `<a href="/Exam/Index?QuizId=${quizIdVal}&TopicID=${topicIdVal}&LevelID=1&LanguageID=${langIdVal}&IsInstituteQuiz=false&IsAttempt=true&ExamID=${examIdVal}" class="btn btn-action-pill btn-pill-info" onclick="event.stopPropagation()"><i class="fa fa-eye"></i> Preview MCQ</a>`;
                    } else {
                        html += `<button type="button" class="btn btn-action-pill btn-pill-primary" onclick="evaluateAndExecuteLaunch('${activityType}', '${launchUrl}', '${safeName}')"><i class="fa fa-play"></i> Start Assessment</button>`;
                    }
                    html += '</div>';
                }
                html += '</div>';
            });

            if (matchCount === 0) {
                html = '<div class="text-center text-muted" style="padding:60px 20px; width:100%; grid-column: 1 / -1;"><i class="fa fa-folder-open-o" style="font-size:44px; color:#cbd5e1; margin-bottom:10px; display:block;"></i>No distinct active card items populated under this section.</div>';
            }

            gridContainer.html(html);
