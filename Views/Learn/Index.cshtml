                            var displayMarks = c.courseMarks || c.CourseMarks || 0;
                            var courseIdVal = c.courseID || c.CourseID;
                            var courseNameVal = c.courseName || c.CourseName;

                            var serializedCourseStr = escape(JSON.stringify(c));

                            // If this fetched course matches our last active course, update the fresh JSON storage!
                            if (savedCourseId && parseInt(courseIdVal) === parseInt(savedCourseId)) {
                                savedCourseJson = serializedCourseStr;
                                localStorage.setItem('last_active_course_json', serializedCourseStr);
                            }

                            html += '<a href="javascript:void(0);" class="week-nav-card ' + isLocked + ' week-trigger-' + courseIdVal + '" ' +
                                'onclick="activateWorkspaceStage(' + courseIdVal + ', ' + mcId + ', ' + globalWeekIndex + ', \'' + serializedCourseStr + '\')">' +
                                '<div class="indicator-dot dot-' + statusClass + '"></div>' +
                                '<div style="flex-grow:1; display:flex; justify-content:space-between; align-items:center; padding-right:8px;">' +
                                '<span style="font-size:13px; font-weight:600; color:var(--slate-800);">' + courseNameVal + '</span>' +
                                '<span class="score-badge" style="font-size:10px;"><i class="fa fa-star text-warning"></i> ' + displayMarks + ' Mks</span>' +
                                '</div>' +
                                '<div>' + lockIcon + '</div>' +
                                '</a>';
                        });
                    } else {
                        html = '<div class="p-sm text-center text-muted small">No weeks loaded.</div>';
                    }
                    targetContainer.html(html);
                   // var savedCourseId = localStorage.getItem('last_active_course_id');
                    var savedMcId = localStorage.getItem('last_active_mc_id');
                    var savedWeekIndex = localStorage.getItem('last_active_week_index');
                   /// var savedCourseJson = localStorage.getItem('last_active_course_json');

                    if (savedCourseId && savedMcId && savedCourseJson && parseInt(savedMcId) === parseInt(mcId)) {
                        // Check if this container contains the saved course
                        if ($('#sidebar-weeks-container-' + mcId + ' .week-trigger-' + savedCourseId).length > 0) {
                            // Expand the parent accordion collapse section
                            $('#collapse-mc-' + mcId).show();
                            // Trigger activation smoothly after a short DOM tick
                            setTimeout(function() {
                                activateWorkspaceStage(parseInt(savedCourseId), parseInt(savedMcId), parseInt(savedWeekIndex || 1), savedCourseJson);
                            }, 50);
                        }
                    }
                }
            });
        }

