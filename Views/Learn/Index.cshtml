        function getYouTubeThumbnail(url) {
            var fallback = "";
            if (!url) return fallback;
            var match = url.match(/(?:youtu\.be\/|youtube\.com\/(?:.*[?&]v=|embed\/|v\/))([^"&?\/\s]{11})/);
            if (!match) return fallback;
            return "https://i.ytimg.com/vi/" + match[1] + "/hqdefault.jpg";
        }

        function evaluateAndExecuteLaunch(type, url, title) {
            if (type === 'postsurvey') {
                var gamesIncomplete = false;
                var lowMcqScores = false;
                var rawRows = activeCourseDataCache.sqlRawRows || activeCourseDataCache.SqlRawRows;

                if (rawRows) {
                    $.each(rawRows, function(i, r) {
                        var subName = r.subTopicName || r.SubTopicName || '';
                        var name = subName.toLowerCase();
                        var pracCode = r.practicalCode || r.PracticalCode || '';
                        var codeVal = pracCode.toString().trim().toUpperCase();
                        var isGame = (codeVal !== '' && codeVal !== '0' && codeVal !== 'NULL');
                        var itemScr = r.itemScore !== undefined ? r.itemScore : (r.ItemScore || 0);

                        if (isGame && itemScr === 0) {
                            gamesIncomplete = true;
                        }
                        if (!isGame && name.includes('mcq') && !name.includes('survey') && itemScr < 3) {
                            lowMcqScores = true;
                        }
                    });
                }

                if (lowMcqScores || gamesIncomplete) {
                    Swal.fire({
                        title: 'Survey Locked!',
                        html: '<div style="text-align:left; font-size:14px; line-height:1.6;"><p>To proceed with the Post Value Survey, you must first clear all previous week requirements:</p><ul><li>All Practical Labs & Interactive Games must be completed.</li><li>You must achieve a minimum score of 3 Marks or more on every weekly MCQ task.</li></ul></div>',
                        icon: 'warning',
                        confirmButtonColor: '#0284c7'
                    });
                    return;
                }
            }

            if (!isStudent && type !== 'mcq') {
                Swal.fire({
                    title: 'Access Restricted',
                    text: 'You are viewing in read-only mode. Only MCQ assessments are viewable.',
                    icon: 'info'
                });
                return;
            }

            if (type === 'video' || type === 'pdf') {
                openMediaModal(url, title);
            } else {
                window.location.href = url;
            }
        }

        function determineActivityType(row, weekIndex) {
            var pracCode = row.practicalCode || row.PracticalCode || '';
            var codeVal = pracCode.toString().trim().toUpperCase();
            var subNameVal = row.subTopicName || row.SubTopicName || '';
            var subName = subNameVal.toString().toLowerCase();

            if (codeVal !== '' && codeVal !== '0' && codeVal !== 'NULL' && !subName.includes('pdf')) return 'practical';

            if (subName.includes('pre value survey') || subName.includes('pre - value') || subName.includes('pre-survey') || subName.includes('belief') || subName.includes('behav')) return 'presurvey';
            if (subName.includes('post value survey') || subName.includes('post-survey') || subName.includes('post - value')) return 'postsurvey';
            
            var noOfQ = row.noOfQuestion !== undefined ? row.noOfQuestion : (row.NoOfQuestion || 0);
            if (noOfQ > 0 || subName.includes('mcq')) return 'mcq';
            
            var trainerVid = row.trainerVideo || row.TrainerVideo;
            if (trainerVid && trainerVid.trim() !== '') return 'video';
            
            if (subName.includes('pdf')) return 'pdf';
            return 'general';
        }

        function getLaunchUrl(row, type, courseName, fallbackCourseId) {
            var quizId = row.quizID || row.QuizID || 0;
            var topicId = row.topicID || row.TopicID || 0;
            var langId = row.languageID || row.LanguageID || 1;
            var practicalId = row.practicalID || row.PracticalID || 0;
            var courseId = row.courseID || row.CourseID || fallbackCourseId || 0;
            var encodedCourseName = encodeURIComponent(courseName || '');
            var pracCode = row.practicalCode || row.PracticalCode || '';
            var codeVal = pracCode.toString().trim().toUpperCase();

            if (codeVal !== '' && codeVal !== '0' && codeVal !== 'NULL') {
                switch (codeVal) {
                    case 'G_E_01': return '/Anubhuti/AnubhutiIndex?CourseID=' + courseId + '&PractID=' + practicalId;
                    case 'G_E_02': return '/Anubhuti/SecondIndex?CourseID=' + courseId + '&PractID=' + practicalId;
                    case 'G_E_06': return '/Anubhuti/ThirdIndex?CourseID=' + courseId + '&PractID=' + practicalId;
                    case 'S_E_03': return '/Scramble?CourseID=' + courseId + '&PractID=' + practicalId;
                    case 'G_E_04': return '/Game24?CourseID=' + courseId + '&PractID=' + practicalId + '&Coursename=' + encodedCourseName;
                    case 'F_E_08': return '/Futoshiki?CourseID=' + courseId + '&PractID=' + practicalId + '&Coursename=' + encodedCourseName;
                    case 'W_E_07': return '/WordGame?CourseID=' + courseId + '&PractID=' + practicalId;
                    case 'K_E_10': return '/KenKen/KenKenIndex?CourseID=' + courseId + '&PractID=' + practicalId + '&Coursename=' + encodedCourseName;
                    case 'P_E_09': return '/Puzzle/PuzzleIndex?CourseID=' + courseId + '&PractID=' + practicalId;
                    case 'G_E_010': return 'MODAL_FAMILYUPLOAD';
                    case 'G_E_011': return 'MODAL_UPLOAD';
                    case 'G_E_10': return '/HEProject/Creativity?CourseID=' + courseId + '&PractID=' + practicalId;
                    default: return '/Anubhuti/Upload?CourseID=' + courseId + '&PractID=' + practicalId;
                }
            }

            var trainerVid = row.trainerVideo || row.TrainerVideo;
            var trainerRes = row.trainerResource || row.TrainerResource;
            var trainerEx = row.trainerExercise || row.TrainerExercise;

            if (type === 'video' && trainerVid) return trainerVid.replace(/^~\//, 'https://www.hemvirtues.in/');
            if (type === 'pdf' && trainerRes) return trainerRes.replace(/^~\//, 'https://www.hemvirtues.in/');
            if (type === 'practical' && trainerEx) return trainerEx.replace(/^~\//, 'https://www.hemvirtues.in/');

            if (type === 'presurvey' || type === 'postsurvey') return '/Exam/Survey?CourseID=' + courseId + '&TopicID=' + topicId + '&LanguageID=' + langId;
            if (type === 'mcq') return '/Exam/Index?QuizId=' + quizId + '&TopicID=' + topicId + '&LevelID=1&LanguageID=' + langId + '&IsInstituteQuiz=false&IsAttempt=false&ExamID=0';
            return '/' + topicId;
        }

        function openMediaModal(url, title) {
            var cleanUrl = formatEmbedUrl(url);
            var $frame = $('#activityFrame');

            if (cleanUrl.toLowerCase().includes('.pdf')) {
                cleanUrl = 'https://docs.google.com/gview?url=' + encodeURIComponent(cleanUrl) + '&embedded=true';
                $frame.removeAttr('allow referrerpolicy');
            } else {
                $frame.attr({
                    'allow': 'accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share',
                    'referrerpolicy': 'strict-origin-when-cross-origin',
                    'allowfullscreen': 'true'
                });
            }

            $frame.attr('src', cleanUrl);
            $('#activityModal').modal('show');
        }

        function formatEmbedUrl(url) {
            if (!url) return '';
            if (url.includes('youtu.be/')) {
                var videoId = url.split('youtu.be/')[1].split('?')[0];
                return 'https://www.youtube.com/embed/' + videoId + '?autoplay=1';
            }
            if (url.includes('watch?v=')) {
                var videoId = url.split('v=')[1].split('&')[0];
                return 'https://www.youtube.com/embed/' + videoId + '?autoplay=1';
            }
            if (url.includes('youtube.com/embed/') && !url.includes('autoplay')) {
                return url + (url.includes('?') ? '&' : '?') + 'autoplay=1';
            }
            return url;
        }

        function openUploadModal(practId, taskName, courseName) {
            $('#modalPractID').val(practId);
