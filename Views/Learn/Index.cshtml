        function loadSidebarWeeks(mcId, globalWeekIndex) {
            var targetContainer = $('#sidebar-weeks-container-' + mcId);

            $.ajax({
                url: '/Learn/GetCourses',
                type: 'GET',
                data: { mainCourseId: mcId },
                success: function(courses) {
                    var html = '';
                    var savedCourseId = localStorage.getItem('last_active_course_id');
                    var savedCourseJson = null;
                    if (courses && courses.length > 0) {
                        $.each(courses, function(i, c) {
                            var statusValue = c.status || c.Status || 'Start';
                            var statusClass = statusValue.replace(" ", "").replace("-", "").toLowerCase();
                            var isLocked = (c.isLocked !== undefined ? c.isLocked : c.IsLocked) ? 'locked-track' : '';
