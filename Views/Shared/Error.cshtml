@model ErrorViewModel
@{
    ViewData["Title"] = "Something went wrong";
}

<style>
    .error-wrapper {
        min-height: 70vh;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 2.5rem 1rem;
        background: radial-gradient(circle at 50% 20%, #f8fafc 0%, #eef2f6 100%);
    }

    .error-card {
        background: #ffffff;
        max-width: 580px;
        width: 100%;
        border-radius: 20px;
        box-shadow: 0 12px 35px rgba(0, 0, 0, 0.06), 0 2px 8px rgba(0, 0, 0, 0.04);
        padding: 3rem 2.5rem;
        text-align: center;
        border: 1px solid rgba(226, 232, 240, 0.8);
    }

    .error-icon-box {
        width: 76px;
        height: 76px;
        margin: 0 auto 1.5rem auto;
        background-color: #fee2e2;
        color: #ef4444;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .error-title {
        font-size: 1.85rem;
        font-weight: 700;
        color: #1e293b;
        margin-bottom: 0.75rem;
    }

    .error-desc {
        font-size: 1.05rem;
        color: #64748b;
        line-height: 1.6;
        margin-bottom: 2rem;
    }

    .error-meta {
        background-color: #f8fafc;
        border: 1px dashed #cbd5e1;
        border-radius: 10px;
        padding: 0.75rem 1rem;
        font-size: 0.85rem;
        color: #64748b;
        margin-bottom: 2rem;
        word-break: break-all;
    }

        .error-meta code {
            color: #475569;
            font-weight: 600;
            background: #f1f5f9;
            padding: 2px 6px;
            border-radius: 4px;
        }

    .error-actions {
        display: flex;
        gap: 1rem;
        justify-content: center;
        flex-wrap: wrap;
    }

    .btn-custom {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        padding: 0.75rem 1.6rem;
        border-radius: 10px;
        font-weight: 600;
        text-decoration: none;
        transition: all 0.2s ease-in-out;
        font-size: 0.95rem;
    }

    .btn-primary-custom {
        background-color: #5d2e8c; /* Matches your brand color */
        color: #ffffff;
        box-shadow: 0 4px 14px rgba(93, 46, 140, 0.35);
    }

        .btn-primary-custom:hover {
            background-color: #49226e;
            color: #ffffff;
            transform: translateY(-1px);
        }

    .btn-secondary-custom {
        background-color: #f1f5f9;
        color: #475569;
    }

        .btn-secondary-custom:hover {
            background-color: #e2e8f0;
            color: #1e293b;
        }
</style>

<div class="error-wrapper">
    <div class="error-card">
        <!-- Warning Icon -->
        <div class="error-icon-box">
            <svg width="38" height="38" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="12" cy="12" r="10"></circle>
                <line x1="12" y1="8" x2="12" y2="12"></line>
                <line x1="12" y1="16" x2="12.01" y2="16"></line>
            </svg>
        </div>

        <h1 class="error-title">Oops! Something went wrong</h1>
        <p class="error-desc">
            We encountered an unexpected issue while loading this page. Our team has been notified, and we're already working to fix it.
        </p>

        @if (Model?.ShowRequestId ?? false)
        {
            <div class="error-meta">
                Support Reference ID: <code>@Model.RequestId</code>
            </div>
        }

        <div class="error-actions">
            <a href="/" class="btn-custom btn-primary-custom">Return to Homepage</a>
            <a href="javascript:location.reload();" class="btn-custom btn-secondary-custom">Try Again</a>
        </div>
    </div>
</div>