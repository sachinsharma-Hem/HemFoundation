<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#5b3fd6" />
    <title>@ViewData["Title"] - HEM Sampark</title>
    <link rel="icon" href="~/favicon.ico" />
    <link rel="stylesheet" href="~/lib/bootstrap/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/lib/bootstrap-icons/font/bootstrap-icons.min.css" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/hem-sampark.css" asp-append-version="true" />
</head>
<body>
    <div class="hs-app">
        <header class="hs-top">
            <div class="hs-top-in">
                <a class="hs-brand" href="/HemSampark/SamparkDashboard" aria-label="HEM Sampark home">
                    <img src="~/images/homepage/Hem Sampark.png" alt="" />
                    <span>
                        <span class="hs-brand-name">HEM Sampark</span>
                        <span class="hs-brand-tag">Values for a Brighter Tomorrow</span>
                    </span>
                </a>
                <div class="hs-user">
                    <span class="hs-avatar" id="hsAvatar" aria-hidden="true"><i class="bi bi-person-fill"></i></span>
                    <span class="hs-user-name" id="hsUserName"></span>
                    <button type="button" class="hs-logout" id="hsLogout" aria-label="Log out">
                        <i class="bi bi-box-arrow-right"></i><span>Log Out</span>
                    </button>
                </div>
            </div>
            @await RenderSectionAsync("Nav", required: false)
        </header>

        <main class="hs-main">
            @RenderBody()
        </main>

        <footer class="hs-foot">
            <b>HEM Sampark</b> · Read. Think. Feel. Act. Every day.
        </footer>
    </div>

    <script src="~/lib/jquery/jquery.min.js"></script>
    <script src="~/lib/bootstrap/js/bootstrap.bundle.min.js"></script>
    <script>
        function performCleanupAndRedirect() {
            localStorage.removeItem("jwtToken");
            window.location.href = '/';
        }

        function logoutAdmin() {
            $.ajax({ url: '/api/auth/logout', type: 'POST' }).always(performCleanupAndRedirect);
        }

        document.getElementById('hsLogout').addEventListener('click', logoutAdmin);
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
