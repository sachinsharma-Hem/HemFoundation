<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - HEM Sampark</title>
    <!-- Bootstrap 5 & Icons CDN -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css">
</head>
<body class="bg-light">

    <!-- Custom Top Header Bar with Logout Button -->
    <div class="container-fluid bg-white shadow-sm py-2 px-4 mb-3">
        <div class="d-flex align-items-center justify-content-between">
            <div class="d-flex align-items-center gap-3">
                <h4 class="fw-bold m-0" style="color: #29266f;">HEM Sampark</h4>
                <span class="badge bg-success-subtle text-success px-3 py-2 rounded-pill fw-semibold d-none d-md-inline-block">Values for a Brighter Tomorrow</span>
            </div>

            <div class="d-flex align-items-center gap-3">
                <div class="text-end d-none d-sm-block">
                    <h6 class="fw-bold m-0 text-dark">Aarav Sharma</h6>
                </div>

                <!-- Logout Button -->
                <button type="button" onclick="logoutAdmin()" class="btn btn-outline-danger btn-sm rounded-pill py-2 px-3 d-flex align-items-center gap-2">
                    <i class="bi bi-box-arrow-right fs-5"></i>
                    <span>Log Out</span>
                </button>
            </div>
        </div>
    </div>

    <!-- Main Body Content Render -->
    <div class="container-fluid px-3 px-md-4">
        @RenderBody()
    </div>

    <!-- jQuery CDN (Added to fix $.ajax error) -->
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

    <script>
            function performCleanupAndRedirect() {
                // Local storage ya session clear karke login page ya home par redirect karein
                localStorage.removeItem("jwtToken");
                window.location.href = '/';
            }

            function logoutAdmin() {
                $.ajax({
                    url: '/api/auth/logout',
                    type: 'POST',
                    success: function() {
                        performCleanupAndRedirect();
                    },
                    error: function() {
                        performCleanupAndRedirect();
                    }
                });
            }
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>