<style>
    .hv-manual-drawer {
        width: 100% !important;
        max-width: 950px !important;
    }

    .hv-drawer-header {
        background: linear-gradient(135deg, #1e1b4b 0%, #311854 100%) !important;
    }

    .hv-video-hero {
        background: linear-gradient(135deg, #311854 0%, #581c87 100%) !important;
    }

    .hv-hero-badge {
        background: rgba(255, 255, 255, 0.12) !important;
        color: #ffc107 !important;
        border: 1px solid rgba(255, 255, 255, 0.2);
    }

    .hv-stat-card, .hv-help-card, .hv-video-card, .hv-feature-card {
        transition: transform 0.3s ease, box-shadow 0.3s ease;
    }

        .hv-stat-card:hover, .hv-help-card:hover, .hv-video-card:hover, .hv-feature-card:hover {
            transform: translateY(-4px);
            box-shadow: 0 10px 25px rgba(0,0,0,0.06) !important;
        }

    .hv-play-btn-circle {
        transition: transform 0.3s ease, background-color 0.3s ease;
    }

    .hv-video-card:hover .hv-play-btn-circle {
        transform: scale(1.15);
        background-color: #ffc107 !important;
        color: #000 !important;
    }
</style>

<script>
    document.addEventListener("DOMContentLoaded", function () {
        const videoModalEl = document.getElementById('hemVideoModal2');
        const videoContainerEl = document.getElementById('hemVideoContainer');
        let videoModalObj = null;

        if (videoModalEl && typeof bootstrap !== 'undefined') {
            videoModalObj = new bootstrap.Modal(videoModalEl);
        }

        // Har card ke unique data-video-url ko target karna
        document.querySelectorAll('.open-video-modal').forEach(trigger => {
            trigger.addEventListener('click', function () {
                const targetUrl = this.getAttribute('data-video-url');
                if (targetUrl && videoContainerEl) {
                    // Usi specific video ka iframe modal ke andar inject karna
                    videoContainerEl.innerHTML = `<iframe src="${targetUrl}" class="w-100 h-100 border-0" allow="autoplay; encrypted-media" allowfullscreen></iframe>`;
                    if (videoModalObj) {
                        videoModalObj.show();
                    }
                }
            });
        });

        // Jab modal close ho toh video stop karne ke liye iframe clear kar dena
        if (videoModalEl) {
            videoModalEl.addEventListener('hidden.bs.modal', function () {
                if (videoContainerEl) {
                    videoContainerEl.innerHTML = '';
                }
            });
        }
    });
</script>