<section class="py-5 bg-white overflow-hidden">
    <div class="container-fluid py-3">

        <!-- Main White Banner Card -->
        <div class="hem-vid-wrapper bg-white rounded-5 p-3 p-md-4 p-xl-5 border shadow-sm">
            <div class="row align-items-center g-4 g-lg-5">

                <!-- Left: Video Thumbnail with Pulse Play Button -->
                <div class="col-12 col-lg-5 hem-vid-col">
                    <div class="hem-vid-thumb position-relative rounded-4 overflow-hidden shadow-sm" data-bs-toggle="modal" data-bs-target="#hemVideoModal" style="cursor: pointer;">
                        <img src="~/images/homepage/ytthumb.png" alt="Hem Virtues in Action" class="img-fluid w-100 hem-vid-img">

                        <!-- Pulsing Play Button Overlay -->
                        <div class="hem-play-btn position-absolute top-50 start-50 translate-middle d-flex align-items-center justify-content-center">
                            <div class="hem-pulse-ring"></div>
                            <div class="hem-play-circle bg-white shadow-lg d-flex align-items-center justify-content-center">
                                <i class="bi bi-play-fill fs-2" style="color: #0F172A; margin-left: 3px;"></i>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Right: Text Content -->
                <div class="col-12 col-lg-7 hem-vid-col">
                    <div class="hem-vid-content pe-lg-4 text-center text-lg-start">
                        <h2 class="fw-bold hem-vid-title mb-3">Experience Hem Virtues in Action</h2>
                        <p class="text-secondary mb-4 hem-vid-desc">
