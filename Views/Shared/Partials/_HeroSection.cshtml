<!-- JavaScript to handle click and populate modal dynamically -->
<script>
    document.addEventListener("DOMContentLoaded", function() {
        const cards = document.querySelectorAll(".why-card-trigger");
        const modalTitle = document.getElementById("whyModalTitle");
        const modalDesc = document.getElementById("whyModalDesc");

        cards.forEach(card => {
            card.addEventListener("click", function() {
                const title = this.getAttribute("data-title");
                const desc = this.getAttribute("data-desc");

                modalTitle.textContent = title;
                modalDesc.textContent = desc;

                // Open Bootstrap Modal
                const myModal = new bootstrap.Modal(document.getElementById('whyChooseModal'));
                myModal.show();
            });
        });
    });
</script>