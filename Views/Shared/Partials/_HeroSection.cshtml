@model HemFoundation.Models.HemHomeModel

<section class="hero-section">
    <!-- Desktop Right Image -->
    <div class="hero-image">
        <img src="~/images/homepage/student-hero.jpeg" alt="Student Hero">
    </div>

    <!-- Mobile Special Image (home21.png) - Ye sirf mobile screen pe dikhegi -->
    <div class="hero-mobile-img-wrap">
        <img src="~/images/homepage/home21.png" alt="Hem Virtues Mobile Banner">
    </div>

    <!-- Left White Content -->
    <div class="hero-content">
        <div class="hero-inner">
            <h1><span>NEP 2020 & SEL Based</span></h1>
            <h2>Digital Value Education Program</h2>
            <h3>One Value. One Month. Lifelong Character.</h3>

            <div class="hero-line"></div>

            <p>
                <strong>HemVirtues</strong> is a comprehensive,
                research-based program that nurtures
                <b>human values</b>, life skills and
                <b>social-emotional learning</b> in students from
                <b>Grades 3 to 12.</b>
            </p>

            <div class="hero-buttons">
                <a href="javascript:void(0);" class="btn-register" data-bs-toggle="modal" data-bs-target="#modalRegister">
                    <i class="bi bi-stars"></i> Register Now
                </a>
                <a href="javascript:void(0);" class="btn-white" data-bs-toggle="offcanvas" data-bs-target="#userManualDrawer">
                    <i class="bi bi-play-circle-fill"></i> User Manual
                </a>
                <a href="javascript:void(0);" class="btn-white" data-bs-toggle="modal" data-bs-target="#brochureModal">
                    <i class="bi bi-book-fill"></i> Read More
                </a>
            </div>
        </div>
    </div>

    <!-- Desktop Floating Values (Mobile pe hide rahengi) -->
    <div class="value-card card1">
        <i class="bi bi-award-fill"></i> Respect
    </div>
    <div class="value-card card2">
        <i class="bi bi-heart-fill"></i> Empathy
    </div>
    <div class="value-card card3">
        <i class="bi bi-people-fill"></i> Responsibility
    </div>
    <div class="value-card card4">
        <i class="bi bi-shield-check"></i> Honesty
    </div>
    <div class="value-card card5">
        <i class="bi bi-heart-pulse-fill"></i> Compassion
    </div>
</section>

<section class="py-4 py-lg-5 bg-light">
    <div class="container-fluid">
        <!-- Main White Card -->
        <style>
                    /* Modern Glassmorphism Effect (React/Vite Style) */
                    .hem-glass-panel {
                        background: rgba(255, 255, 255, 0.65); /* Semi-transparent white */
                        backdrop-filter: blur(12px);
                        -webkit-backdrop-filter: blur(12px);
                        border: 1px solid rgba(255, 255, 255, 0.8);
                        box-shadow: 0 8px 32px 0 rgba(31, 38, 135, 0.07);
                    }

                    /* Optional: Adding a soft modern glow to icons for that premium look */
                    .hem-imp-icon {
                        width: 50px;
                        height: 50px;
                        border-radius: 12px;
                    }

                    .hem-imp-tricolor {
                        background: linear-gradient(135deg, #ff993320, #ffffff20, #13880820);
                        color: #138808;
                    }

                    .hem-imp-purple {
                        background: rgba(111, 66, 193, 0.1);
                        color: #6f42c1;
                    }

                    .hem-imp-blue {
                        background: rgba(13, 110, 253, 0.1);
                        color: #0d6efd;
                    }

                    .hem-imp-green {
                        background: rgba(25, 135, 84, 0.1);
                        color: #198754;
                    }
        </style>

        <div class="hem-glass-panel rounded-4 p-3 p-md-4">
            <div class="row g-4 align-items-center">

                <!-- Box 1: Title & Icon -->
                <div class="col-12 col-sm-6 col-lg-3 hem-imp-item hem-imp-border-end">
                    <div class="d-flex align-items-center gap-3 p-2">
                        <div class="hem-imp-icon hem-imp-tricolor d-flex align-items-center justify-content-center flex-shrink-0">
                            <i class="bi bi-stars fs-4"></i> <!-- Changed to stars for an 'Impact' feel -->
                        </div>
                        <div>
                            <h2 class="m-0 fw-bold fs-4" style="color: #1A5235;">Our Impact</h2>
                            <p class="m-0 text-secondary small fw-medium">Creating a Better Tomorrow</p>
                        </div>
                    </div>
                </div>

                <!-- Box 2: Students Benefited -->
                <div class="col-12 col-sm-6 col-lg-3 hem-imp-item hem-imp-border-end">
                    <div class="d-flex align-items-center gap-3 p-2">
                        <div class="hem-imp-icon hem-imp-purple d-flex align-items-center justify-content-center flex-shrink-0">
                            <i class="bi bi-mortarboard-fill fs-4"></i>
                        </div>
                        <div>
                            <h3 class="m-0 fw-bold fs-3 text-dark hem-counter" data-target="@Model.StudentCounts">0</h3>
                            <span class="text-muted small fw-medium">Students Benefited</span>
                        </div>
                    </div>
                </div>

                <!-- Box 3: Teachers Trained -->
                <div class="col-12 col-sm-6 col-lg-3 hem-imp-item hem-imp-border-end">
                    <div class="d-flex align-items-center gap-3 p-2">
                        <div class="hem-imp-icon hem-imp-blue d-flex align-items-center justify-content-center flex-shrink-0">
                            <i class="bi bi-person-video3 fs-4"></i> <!-- Updated to look more like a trainer/teacher -->
                        </div>
                        <div>
                            <h3 class="m-0 fw-bold fs-3 text-dark hem-counter" data-target="@Model.TeacherCounts">0</h3>
                            <span class="text-muted small fw-medium">Teachers Trained</span>
                        </div>
                    </div>
                </div>

                <!-- Box 4: Schools Associated -->
                <div class="col-12 col-sm-6 col-lg-3 hem-imp-item">
                    <div class="d-flex align-items-center gap-3 p-2">
                        <div class="hem-imp-icon hem-imp-green d-flex align-items-center justify-content-center flex-shrink-0">
                            <i class="bi bi-buildings-fill fs-4"></i> <!-- Updated to buildings-fill to look like an institution/campus -->
                        </div>
                        <div>
                            <h3 class="m-0 fw-bold fs-3 text-dark hem-counter" data-target="@Model.SchoolCounts">0</h3>
                            <span class="text-muted small fw-medium">Schools Associated</span>
                        </div>
                    </div>
                </div>

            </div>
        </div>
    </div>
</section>

<section class="py-5 bg-light">
    <div class="container-fluid px-lg-5">

        <!-- Section Header -->
        <div class="text-center mb-5">
            <h2 class="fw-bold hem-why-title">Why Schools Choose Hem Virtues?</h2>
            <div class="hem-why-line mx-auto"></div>
            <p class="text-muted small mt-2">Click on any card to explore how Hem Foundation empowers students.</p>
        </div>

        <!-- 6 Cards Grid (Added data attributes & pointer cursor) -->
        <div class="row g-4 justify-content-center">

            <!-- Card 1: Character Building -->
            <div class="col-12 col-sm-6 col-md-4 col-xl-2">
                <div class="hem-why-card hem-card-green bg-white rounded-4 p-4 text-center d-flex flex-column align-items-center h-100 shadow-sm why-card-trigger"
                     style="cursor: pointer;"
                     data-title="Character Building & Value Education"
                     data-desc="Develop honesty, kindness, respect, empathy, discipline, and responsibility through meaningful stories and value-based learning experiences that encourage positive attitudes and responsible behaviour.">
                    <div class="hem-why-icon hem-icon-green mb-3">
                        <i class="bi bi-heart-fill"></i>
                    </div>
                    <h4 class="fw-bold fs-6 text-dark mb-2">Character Building</h4>
                    <p class="text-secondary small m-0">Builds strong values and positive attitude.</p>
                </div>
            </div>

            <!-- Card 2: Digital Learning -->
            <div class="col-12 col-sm-6 col-md-4 col-xl-2">
                <div class="hem-why-card hem-card-blue bg-white rounded-4 p-4 text-center d-flex flex-column align-items-center h-100 shadow-sm why-card-trigger"
                     style="cursor: pointer;"
                     data-title="Engaging Digital Learning"
                     data-desc="Make value education interactive and enjoyable with short films, stories, quizzes, MCQs, games, and digital activities that help students connect values with real-life situations.">
                    <div class="hem-why-icon hem-icon-blue mb-3">
                        <i class="bi bi-display"></i>
                    </div>
                    <h4 class="fw-bold fs-6 text-dark mb-2">Digital Learning</h4>
                    <p class="text-secondary small m-0">Interactive, engaging and easy to use.</p>
                </div>
            </div>

            <!-- Card 3: Project-Based Learning -->
            <div class="col-12 col-sm-6 col-md-4 col-xl-2">
                <div class="hem-why-card hem-card-purple bg-white rounded-4 p-4 text-center d-flex flex-column align-items-center h-100 shadow-sm why-card-trigger"
                     style="cursor: pointer;"
                     data-title="Project-Based Learning (PBL)"
                     data-desc="Encourage students to put values into practice through individual, family, and group projects that develop critical thinking, creativity, teamwork, problem-solving, and social responsibility.">
                    <div class="hem-why-icon hem-icon-purple mb-3">
                        <i class="bi bi-clipboard-check-fill"></i>
                    </div>
                    <h4 class="fw-bold fs-6 text-dark mb-2">Project-Based Learning</h4>
                    <p class="text-secondary small m-0">Activity based learning for real-life impact.</p>
                </div>
            </div>

            <!-- Card 4: Teacher Ready Resources -->
            <div class="col-12 col-sm-6 col-md-4 col-xl-2">
                <div class="hem-why-card hem-card-orange bg-white rounded-4 p-4 text-center d-flex flex-column align-items-center h-100 shadow-sm why-card-trigger"
                     style="cursor: pointer;"
                     data-title="Ready-to-Use Teacher Resources"
                     data-desc="Support educators with structured lesson content, teacher guidebooks, student activity books, value-integrated resources, and daily assembly modules to make classroom implementation easier.">
                    <div class="hem-why-icon hem-icon-orange mb-3">
                        <i class="bi bi-easel-fill"></i>
                    </div>
                    <h4 class="fw-bold fs-6 text-dark mb-2">Ready-to-Use Teacher Resources</h4>
                    <p class="text-secondary small m-0">Lesson plans, PPTs, worksheets & more.</p>
                </div>
            </div>

            <!-- Card 5: Parent Engagement -->
            <div class="col-12 col-sm-6 col-md-4 col-xl-2">
                <div class="hem-why-card hem-card-green bg-white rounded-4 p-4 text-center d-flex flex-column align-items-center h-100 shadow-sm why-card-trigger"
                     style="cursor: pointer;"
                     data-title="Parent & Family Engagement"
                     data-desc="Extend value education beyond the classroom by involving families in meaningful activities and projects that encourage children to practise positive values at home and in their communities.">
                    <div class="hem-why-icon hem-icon-green mb-3">
                        <i class="bi bi-people-fill"></i>
                    </div>
                    <h4 class="fw-bold fs-6 text-dark mb-2">Parent & Family Engagement</h4>
                    <p class="text-secondary small m-0">Involve parents in the value journey.</p>
                </div>
            </div>

            <!-- Card 6: Performance Insights -->
            <div class="col-12 col-sm-6 col-md-4 col-xl-2">
                <div class="hem-why-card hem-card-blue bg-white rounded-4 p-4 text-center d-flex flex-column align-items-center h-100 shadow-sm why-card-trigger"
                     style="cursor: pointer;"
                     data-title="Progress Tracking & Performance Insights"
                     data-desc="Help schools and teachers review student participation and learning progress through assessments, progress reviews, and available performance reports, supporting a more structured approach to value education.">
                    <div class="hem-why-icon hem-icon-blue mb-3">
                        <i class="bi bi-graph-up-arrow"></i>
                    </div>
                    <h4 class="fw-bold fs-6 text-dark mb-2">Performance Insights</h4>
                    <p class="text-secondary small m-0">Track progress with insightful reports.</p>
                </div>
            </div>

        </div>

    </div>
</section>

<section class="py-5 bg-white overflow-hidden">
    <div class="container-fluid py-3">

        <!-- Section Header -->
        <div class="text-center mb-5 hem-how-header">
            <h2 class="fw-bold hem-how-title m-0">How It Works?</h2>
            <div class="hem-how-line mx-auto mt-2"></div>
        </div>

        <!-- Steps Workflow Grid (flex-lg-nowrap se desktop pe kabhi wrap nahi hoga) -->
        <div class="row g-3 g-xl-4 align-items-center justify-content-center flex-lg-nowrap">

            <!-- STEP 1 -->
            <div class="col-12 col-sm-6 col-lg hem-how-step-col">
                <div class="hem-how-step d-flex align-items-center gap-3 p-2">
                    <div class="hem-how-badge hem-bg-green text-white fw-bold d-flex align-items-center justify-content-center flex-shrink-0">
                        1
                    </div>
                    <div>
                        <h4 class="fw-bold fs-6 text-dark m-0 hem-step-title">Register Your School</h4>
                        <p class="text-secondary small m-0 mt-1">Simple onboarding process</p>
                    </div>
                </div>
            </div>

            <!-- ARROW 1 -->
            <div class="d-none d-lg-flex col-auto px-0 hem-how-arrow text-dark">
                <i class="bi bi-arrow-right fs-4"></i>
            </div>

            <!-- STEP 2 -->
            <div class="col-12 col-sm-6 col-lg hem-how-step-col">
                <div class="hem-how-step d-flex align-items-center gap-3 p-2">
                    <div class="hem-how-badge hem-bg-blue text-white fw-bold d-flex align-items-center justify-content-center flex-shrink-0">
                        2
                    </div>
                    <div>
                        <h4 class="fw-bold fs-6 text-dark m-0 hem-step-title">Teacher Training</h4>
                        <p class="text-secondary small m-0 mt-1">Online training & orientation</p>
                    </div>
                </div>
            </div>

            <!-- ARROW 2 -->
            <div class="d-none d-lg-flex col-auto px-0 hem-how-arrow text-dark">
                <i class="bi bi-arrow-right fs-4"></i>
            </div>

            <!-- STEP 3 -->
            <div class="col-12 col-sm-6 col-lg hem-how-step-col">
                <div class="hem-how-step d-flex align-items-center gap-3 p-2">
                    <div class="hem-how-badge hem-bg-purple text-white fw-bold d-flex align-items-center justify-content-center flex-shrink-0">
                        3
                    </div>
                    <div>
                        <h4 class="fw-bold fs-6 text-dark m-0 hem-step-title">Monthly Value Activities</h4>
                        <p class="text-secondary small m-0 mt-1">Grade-wise activities, stories & projects</p>
                    </div>
                </div>
            </div>

            <!-- ARROW 3 -->
            <div class="d-none d-lg-flex col-auto px-0 hem-how-arrow text-dark">
                <i class="bi bi-arrow-right fs-4"></i>
            </div>

            <!-- STEP 4 -->
            <div class="col-12 col-sm-6 col-lg hem-how-step-col">
                <div class="hem-how-step d-flex align-items-center gap-3 p-2">
                    <div class="hem-how-badge hem-bg-orange text-white fw-bold d-flex align-items-center justify-content-center flex-shrink-0">
                        4
                    </div>
                    <div>
                        <h4 class="fw-bold fs-6 text-dark m-0 hem-step-title">Student Assessment & Reports</h4>
                        <p class="text-secondary small m-0 mt-1">Measure, monitor & celebrate growth</p>
                    </div>
                </div>
            </div>

        </div>

    </div>
</section>

