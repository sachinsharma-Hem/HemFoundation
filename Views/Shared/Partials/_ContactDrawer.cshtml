@* Views/Shared/Partials/_ContactDrawer.cshtml *@
<div class="offcanvas offcanvas-end shadow-lg" tabindex="-1" id="contactDrawer" aria-labelledby="contactDrawerLabel" style="width: 420px; border-top-left-radius: 20px; border-bottom-left-radius: 20px;">

    <!-- Header -->
    <div class="offcanvas-header text-white px-4 py-3" style="background: linear-gradient(135deg, #4b2c73, #311b5e);">
        <h5 class="offcanvas-title fw-bold d-flex align-items-center" id="contactDrawerLabel">
            <i class="bi bi-headset me-2 text-warning fs-4"></i> Get in Touch
        </h5>
        <button type="button" class="btn-close btn-close-white shadow-none" data-bs-dismiss="offcanvas" aria-label="Close"></button>
    </div>

    <!-- Body -->
    <div class="offcanvas-body p-0 bg-light">

        <!-- Organization Info Card -->
        <div class="p-4 bg-white border-bottom shadow-sm">
            <h5 class="fw-bold mb-2" style="color: #4b2c73;">HEMA Foundation</h5>
            <p class="text-muted small mb-3" style="line-height: 1.6;">
                <i class="bi bi-geo-alt-fill text-danger me-2 fs-5"></i>
                Ram Ratna House, Oasis Complex, Pandurang Budhkar Marg, Worli, Mumbai, Maharashtra 400013
            </p>

            <!-- Quick Action Buttons -->
            <div class="d-flex gap-2">
                <a href="tel:+917228001342" class="btn btn-sm btn-outline-success flex-fill rounded-pill fw-semibold py-2">
                    <i class="bi bi-telephone-fill me-1"></i> Call Us
                </a>
                <a href="mailto:admin@hemafoundation.org" class="btn btn-sm btn-outline-primary flex-fill rounded-pill fw-semibold py-2">
                    <i class="bi bi-envelope-fill me-1"></i> Mail Us
                </a>
            </div>
        </div>

        <!-- Interactive Google Map Section -->
        <div class="p-3 bg-white border-bottom">
            <div class="d-flex justify-content-between align-items-center mb-2 px-1">
                <span class="fw-bold text-dark small text-uppercase tracking-wider">
                    <i class="bi bi-map-fill text-primary me-1"></i> Location Map
                </span>
                <a href="https://www.google.com/maps/dir/?api=1&destination=19.004618822546863,72.82675180808754"
                   target="_blank"
                   class="btn btn-sm btn-danger rounded-pill px-3 py-1 fw-bold shadow-sm text-white text-decoration-none"
                   style="font-size: 12px; transition: transform 0.2s;">
                    <i class="bi bi-cursor-fill me-1"></i> Get Directions
                </a>
            </div>

            <!-- Responsive Embedded Map -->
            <div class="map-container rounded-4 overflow-hidden border shadow-sm position-relative" style="height: 180px;">
                <iframe src="https://maps.google.com/maps?q=19.004618822546863,72.82675180808754&z=15&output=embed"
                        width="100%"
                        height="100%"
                        style="border:0;"
                        allowfullscreen=""
                        loading="lazy"
                        referrerpolicy="no-referrer-when-downgrade">
                </iframe>
            </div>
        </div>

        <!-- Contact Details List -->
        <div class="p-4">
            <h6 class="text-uppercase fw-bold text-muted mb-3" style="font-size: 11px; letter-spacing: 1px;">Communication Channels</h6>

            <ul class="list-unstyled mb-0 d-flex flex-column gap-3">

                <!-- Phone Item -->
                <li class="d-flex align-items-center p-3 bg-white rounded-3 shadow-xs border">
                    <div class="icon-box bg-success bg-opacity-10 text-success rounded-circle d-flex align-items-center justify-content-center me-3" style="width: 45px; height: 45px; min-width: 45px; font-size: 18px;">
                        <i class="bi bi-telephone-fill"></i>
                    </div>
                    <div>
                        <span class="text-muted d-block" style="font-size: 11px;">Helpline Number</span>
                        <a href="tel:+917228001342" class="text-dark fw-bold text-decoration-none" style="font-size: 14px;">+91 7228001342</a>
                    </div>
                </li>

                <!-- Email Item -->
                <li class="d-flex align-items-center p-3 bg-white rounded-3 shadow-xs border">
                    <div class="icon-box bg-primary bg-opacity-10 text-primary rounded-circle d-flex align-items-center justify-content-center me-3" style="width: 45px; height: 45px; min-width: 45px; font-size: 18px;">
                        <i class="bi bi-envelope-fill"></i>
                    </div>
                    <div>
                        <span class="text-muted d-block" style="font-size: 11px;">Official E-Mail</span>
                        <a href="mailto:admin@hemafoundation.org" class="text-dark fw-bold text-decoration-none" style="font-size: 13px;">admin@hemafoundation.org</a>
                    </div>
                </li>

                <!-- Website Item -->
                <li class="d-flex align-items-center p-3 bg-white rounded-3 shadow-xs border">
                    <div class="icon-box bg-info bg-opacity-10 text-info rounded-circle d-flex align-items-center justify-content-center me-3" style="width: 45px; height: 45px; min-width: 45px; font-size: 18px;">
                        <i class="bi bi-globe"></i>
                    </div>
                    <div>
                        <span class="text-muted d-block" style="font-size: 11px;">Official E-Portal</span>
                        <a href="https://www.hemvirtues.com" target="_blank" class="text-primary fw-bold text-decoration-none" style="font-size: 14px;">www.hemvirtues.com</a>
                    </div>
                </li>

            </ul>
        </div>

    </div>
</div>

<style>
    .shadow-xs {
        box-shadow: 0 2px 6px rgba(0,0,0,0.02);
    }

    .offcanvas {
        transition: transform 0.35s cubic-bezier(0.16, 1, 0.3, 1);
    }

    .btn-danger:hover {
        transform: scale(1.03);
    }
</style>