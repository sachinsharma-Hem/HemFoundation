@model HemFoundation.Models.Entities.CapacityViewModel

@{
    int categoryId = Model?.Id ?? 0;
    string categoryName = Model?.Name ?? "Cognitive Capacity";
    string categoryDesc = Model?.Description ?? "Manage evaluations and interactive modules for this capacity.";
    string categoryImg = !string.IsNullOrEmpty(Model?.ImageUrl) ? Model.ImageUrl : "/images/default-course.png";
}

<div class="cognitive-wrapper py-2" data-category-id="@categoryId">

    <!-- Capacity Header Card -->
    <div class="card border-0 shadow-sm rounded-4 bg-white p-4 mb-4 animate-fade-in" style="border: 1px solid rgba(0, 0, 0, 0.06) !important;">
        <div class="row align-items-center">
            <div class="col-md-2 text-center mb-3 mb-md-0">
                <div class="p-2 bg-light rounded-4 border d-inline-block d-flex align-items-center justify-content-center" style="width: 105px; height: 105px; margin: 0 auto;">
                    <img src="@categoryImg" class="img-fluid rounded-2 w-100 h-100 object-fit-contain" alt="@categoryName">
                </div>
            </div>
            <div class="col-md-7 text-center text-md-start">
                <span class="badge bg-success-subtle text-success px-3 py-1 rounded-pill mb-1 fw-semibold" style="font-size: 0.75rem;"><i class="bi bi-star-fill me-1"></i> Capacity Module</span>
                <h3 class="fw-bold text-dark mb-1">@categoryName</h3>
                <p class="text-muted small mb-0 lh-sm" style="max-width: 600px;">@categoryDesc</p>
            </div>
            <div class="col-md-3 text-center text-md-end mt-3 mt-md-0">
                <div class="d-inline-flex gap-3 bg-light px-3 py-2 rounded-4 border">
                    <div><span class="d-block text-muted" style="font-size: 0.7rem;">Topics</span><h5 class="fw-bold text-success m-0" id="cogTopicsCount">@ViewBag.TopicsCount</h5></div>
                    <div class="vr my-1"></div>
                    <div><span class="d-block text-muted" style="font-size: 0.7rem;">Sub-Topics</span><h5 class="fw-bold text-primary m-0" id="cogSubTopicsCount">@ViewBag.SubTopicsCount</h5></div>
                </div>
            </div>
        </div>
    </div>

    <div class="d-flex flex-column flex-md-row align-items-md-center justify-content-between mb-3 px-1 gap-1">
        <h5 class="fw-bold text-dark m-0"><i class="bi bi-collection-play me-2 text-success"></i> Learning Modules & Assessments</h5>
        <span class="text-muted small">Select a module to proceed</span>
    </div>

    <!-- Sub-Topics Container -->
    <div class="row g-3" id="cogSubTopicsContainer">
        <div class="col-12 text-center py-5 text-muted">
            <div class="spinner-border text-success spinner-border-sm me-2" role="status"></div> Loading learning modules...
        </div>
    </div>
</div>

<!-- Video Modal -->
<div class="modal fade" id="cogVideoModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content rounded-4 border-0 shadow-lg bg-white">
            <div class="modal-header border-bottom px-4 py-3">
                <h6 class="fw-bold text-dark m-0 d-flex align-items-center"><i class="bi bi-play-btn-fill text-danger me-2 fs-5"></i> <span id="cogVideoTitle">Video Learning Session</span></h6>
                <button type="button" class="btn-close shadow-none" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-4 text-center">
                <div class="ratio ratio-16x9 rounded-4 overflow-hidden shadow bg-black">
                    <iframe id="cogVideoIframe" src="" allowfullscreen allow="autoplay"></iframe>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Quiz Modal -->
<div class="modal fade" id="cogQuizModal" tabindex="-1" aria-hidden="true" data-bs-backdrop="static">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content rounded-4 border-0 shadow-lg p-4 bg-white">
            <div class="d-flex justify-content-between align-items-center mb-3 border-bottom pb-2">
                <h6 class="fw-bold text-success m-0 d-flex align-items-center"><i class="bi bi-ui-checks me-2"></i> <span id="cogQuizTitle">Assessment Quiz</span></h6>
                <button type="button" class="btn-close shadow-none" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div id="cogQuizBody"></div>
        </div>
    </div>
</div>

<!-- JavaScript Logic -->
<script>
    $(document).ready(function() {
        let catId = $('.cognitive-wrapper').data('category-id');
        let cogQuestions = [];
        let cogQIndex = 0;
        let cogActiveSubId = null;
        let resolvedCourseRegId = catId;
        let questionTimer = null;
        let secondsElapsed = 0;

        function getAuthToken() {
            return localStorage.getItem('jwt_token') || sessionStorage.getItem('jwt_token') || '';
        }

        // Fetch Sub-Topics via API
        $.ajax({
            url: `/api/teacher-capacity/details/${catId}`,
            type: 'GET',
            headers: { 'Authorization': 'Bearer ' + getAuthToken() },
            success: function(res) {
                if (res.success) {
                    resolvedCourseRegId = res.courseRegId;
                    $('#cogTopicsCount').text(res.counts.topicsCount);
                    $('#cogSubTopicsCount').text(res.counts.subTopicsCount);

                    let html = '';
                    res.subTopics.forEach((st) => {
                        let isVideo = st.videoLink && st.numberOfQuestions === 0;
                        let badge = isVideo ? `<span class="badge bg-info-subtle text-info border px-2 py-1 rounded-pill" style="font-size:0.7rem;"><i class="bi bi-play-circle-fill me-1"></i> Video</span>` : `<span class="badge bg-warning-subtle text-warning border px-2 py-1 rounded-pill" style="font-size:0.7rem;"><i class="bi bi-question-circle-fill me-1"></i> ${st.numberOfQuestions} Qs</span>`;

                        let imgSrc = st.mcqThumbnail || '/images/default-course.png';

                        html += `
                                <div class="col-xl-4 col-md-6">
                                    <div class="card border-0 shadow-sm rounded-4 bg-white h-100 overflow-hidden d-flex flex-column cursor-pointer light-card" onclick="openCogModule(${st.id}, '${st.videoLink || ''}', ${st.numberOfQuestions}, '${st.subTopicName}')">
                                        <div class="position-relative w-100 bg-light border-bottom d-flex align-items-center justify-content-center" style="height:140px;">
                                            <img src="${imgSrc}" alt="${st.subTopicName}" class="img-fluid w-100 h-100 object-fit-cover" />
                                            <div class="position-absolute top-0 end-0 m-2">${badge}</div>
                                        </div>
                                        <div class="card-body p-3 d-flex flex-column justify-content-between">
                                            <h6 class="fw-bold text-dark mb-2 text-truncate">${st.subTopicName}</h6>
                                            <div class="d-flex align-items-center justify-content-between pt-2 border-top small">
                                                <span class="text-muted" style="font-size:0.75rem;"><i class="bi bi-journal-text me-1"></i> Interactive</span>
                                                <span class="text-success fw-bold">
                                                    ${isVideo ? 'Watch <i class="bi bi-arrow-right-short align-middle"></i>' : 'Start <i class="bi bi-arrow-right-short align-middle"></i>'}
                                                </span>
                                            </div>
                                        </div>
                                    </div>
                                </div>`;
                    });
                    $('#cogSubTopicsContainer').html(html || '<div class="col-12 text-center text-muted py-4">No sub-topics found for this capacity.</div>');
                }
            }
        });

        window.openCogModule = function(subTopicId, videoLink, qCount, title) {
            if (videoLink && qCount === 0) {
                let embedUrl = videoLink.includes('watch?v=') ? videoLink.replace('watch?v=', 'embed/') : videoLink;
                $('#cogVideoTitle').text(title);
                $('#cogVideoIframe').attr('src', embedUrl);
                new bootstrap.Modal(document.getElementById('cogVideoModal')).show();
            } else {
                cogActiveSubId = subTopicId;
                $.ajax({
                    url: `/api/teacher-capacity/subtopic-questions/${subTopicId}`,
                    type: 'GET',
                    headers: { 'Authorization': 'Bearer ' + getAuthToken() },
                    success: function(res) {
                        $('#cogQuizTitle').text(res.subTopicTitle || title);

                        if (res.allCompleted) {
                            fetchAndShowSummary(subTopicId);
                        } else if (res.success && res.questions.length > 0) {
                            cogQuestions = res.questions;
                            cogQIndex = 0;
                            renderCogQuestion();
                            new bootstrap.Modal(document.getElementById('cogQuizModal')).show();
                        } else {
                            $('#cogQuizBody').html('<div class="text-center py-3 text-muted small">No questions configured for this sub-topic yet.</div>');
                            new bootstrap.Modal(document.getElementById('cogQuizModal')).show();
                        }
                    }
                });
            }
        };

        function startTimer() {
            secondsElapsed = 0;
            $('#qTimer').text(secondsElapsed);
            clearInterval(questionTimer);
            questionTimer = setInterval(() => {
                secondsElapsed++;
                $('#qTimer').text(secondsElapsed);
            }, 1000);
        }

        function renderCogQuestion() {
            startTimer();
            let q = cogQuestions[cogQIndex];
            let html = `
                        <div class="mb-3">
                            <div class="d-flex justify-content-between align-items-center mb-1">
                                <span class="badge bg-success-subtle text-success px-2 py-1 rounded-pill" style="font-size:0.75rem;">Question ${cogQIndex + 1} of ${cogQuestions.length}</span>
                                <span class="badge bg-light text-secondary border px-2 py-1 rounded-pill" style="font-size:0.75rem;"><i class="bi bi-stopwatch me-1"></i> <span id="qTimer">0</span>s</span>
                            </div>
                            <h6 class="fw-bold text-dark lh-sm">${q.question}</h6>
                        </div>
                        <div class="list-group mb-3 gap-2">
                            <label class="list-group-item rounded-3 border py-2 px-3 cursor-pointer d-flex align-items-center gap-2 option-label"><input class="form-check-input m-0" type="radio" name="quizOpt" value="A" onchange="saveAndNextQuestion(${q.id})"> <span class="small text-dark fw-medium"><b>A.</b> ${q.optionA}</span></label>
                            <label class="list-group-item rounded-3 border py-2 px-3 cursor-pointer d-flex align-items-center gap-2 option-label"><input class="form-check-input m-0" type="radio" name="quizOpt" value="B" onchange="saveAndNextQuestion(${q.id})"> <span class="small text-dark fw-medium"><b>B.</b> ${q.optionB}</span></label>
                            ${q.optionC ? `<label class="list-group-item rounded-3 border py-2 px-3 cursor-pointer d-flex align-items-center gap-2 option-label"><input class="form-check-input m-0" type="radio" name="quizOpt" value="C" onchange="saveAndNextQuestion(${q.id})"> <span class="small text-dark fw-medium"><b>C.</b> ${q.optionC}</span></label>` : ''}
                            ${q.optionD ? `<label class="list-group-item rounded-3 border py-2 px-3 cursor-pointer d-flex align-items-center gap-2 option-label"><input class="form-check-input m-0" type="radio" name="quizOpt" value="D" onchange="saveAndNextQuestion(${q.id})"> <span class="small text-dark fw-medium"><b>D.</b> ${q.optionD}</span></label>` : ''}
                        </div>
                    `;
            $('#cogQuizBody').html(html);
        }

        window.saveAndNextQuestion = function(questionId) {
            clearInterval(questionTimer);
            let selectedOpt = $('input[name="quizOpt"]:checked').val();
            if (!selectedOpt) return;

            let payload = {
                courseRegistrationId: resolvedCourseRegId,
                courseSubTopicId: cogActiveSubId,
                courseMcqQuestionId: questionId,
                selectedOption: selectedOpt,
                timeSpentSeconds: secondsElapsed
            };

            $.ajax({
                url: '/api/teacher-capacity/submit-answer',
                type: 'POST',
                contentType: 'application/json',
                headers: { 'Authorization': 'Bearer ' + getAuthToken() },
                data: JSON.stringify(payload),
                success: function(res) {
                    if (res.success) {
                        cogQIndex++;
                        if (cogQIndex >= cogQuestions.length) {
                            fetchAndShowSummary(cogActiveSubId);
                        } else {
                            setTimeout(renderCogQuestion, 300);
                        }
                    }
                },
                error: function(xhr) {
                    alert(xhr.responseJSON?.message || 'Error saving answer.');
                }
            });
        };

        function fetchAndShowSummary(subTopicId) {
            $.ajax({
                url: `/api/teacher-capacity/quiz-summary/${subTopicId}`,
                type: 'GET',
                headers: { 'Authorization': 'Bearer ' + getAuthToken() },
                success: function(res) {
                    if (res.success) {
                        let total = res.totalAttempted;
                        let correct = res.correctCount;
                        let wrong = res.wrongCount;
                        let accuracy = total > 0 ? Math.round((correct / total) * 100) : 0;

                        $('#cogQuizBody').html(`
                                    <div class="text-center py-3">
                                        <div class="mb-2"><i class="bi bi-award-fill text-success fs-1"></i></div>
                                        <h5 class="fw-bold text-dark mb-1">Assessment Summary & Report</h5>
                                        <p class="text-muted small mb-3">Here is your performance breakdown for this module.</p>

                                        <div class="row g-2 mb-3 text-start">
                                            <div class="col-6"><div class="p-2 bg-light rounded-3 border"><span class="d-block text-muted" style="font-size:0.7rem;">Total Attempted</span><h6 class="fw-bold m-0">${total} Questions</h6></div></div>
                                            <div class="col-6"><div class="p-2 bg-light rounded-3 border"><span class="d-block text-muted" style="font-size:0.7rem;">Time Spent</span><h6 class="fw-bold m-0">${res.totalTimeSpent} Seconds</h6></div></div>
                                            <div class="col-6"><div class="p-2 bg-success-subtle rounded-3 border border-success"><span class="d-block text-success" style="font-size:0.7rem;">Correct Answers</span><h6 class="fw-bold text-success m-0">${correct} Correct</h6></div></div>
                                            <div class="col-6"><div class="p-2 bg-danger-subtle rounded-3 border border-danger"><span class="d-block text-danger" style="font-size:0.7rem;">Incorrect Answers</span><h6 class="fw-bold text-danger m-0">${wrong} Incorrect</h6></div></div>
                                        </div>

                                        <div class="mb-3 text-start">
                                            <div class="d-flex justify-content-between small fw-bold mb-1"><span>Accuracy Rate</span><span>${accuracy}%</span></div>
                                            <div class="progress rounded-pill" style="height: 10px;">
                                                <div class="progress-bar bg-success" role="progressbar" style="width: ${accuracy}%;" aria-valuenow="${accuracy}" aria-valuemin="0" aria-valuemax="100"></div>
                                            </div>
                                        </div>

                                        <button class="btn btn-success btn-sm rounded-pill px-4 fw-bold shadow-sm w-100" data-bs-dismiss="modal">Finish & Close</button>
                                    </div>
                                `);
                        if (!$('#cogQuizModal').hasClass('show')) {
                            new bootstrap.Modal(document.getElementById('cogQuizModal')).show();
                        }
                    }
                }
            });
        }

        $('#cogVideoModal').on('hidden.bs.modal', function() {
            $('#cogVideoIframe').attr('src', '');
        });
    });
</script>

<style>
    .light-card {
        transition: all 0.25s ease-in-out;
        border: 1px solid rgba(0, 0, 0, 0.08) !important;
    }

        .light-card:hover {
            transform: translateY(-4px);
            box-shadow: 0 .5rem 1rem rgba(0, 0, 0, 0.07) !important;
            border-color: rgba(25, 135, 84, 0.3) !important;
        }

    .cursor-pointer {
        cursor: pointer;
    }

    .option-label:hover {
        background-color: #f8fafc;
        border-color: #198754 !important;
    }
</style>