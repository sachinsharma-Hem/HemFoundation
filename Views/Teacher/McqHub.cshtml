@model IEnumerable<HemFoundation.DTOs.TeacherQuizHubDto>

@{
    ViewData["Title"] = "MCQ Capacities Hub";
    Layout = "~/Views/Shared/Layouts/_TeacherLayout.cshtml";
}

<div class="container-fluid py-4">

    <!-- Header -->
    <div class="d-flex align-items-center justify-content-between mb-4">
        <div>
            <h3 class="fw-bold text-dark m-0">
                <i class="bi bi-ui-checks-grid text-success me-2"></i>
                MCQ Capacities Manager
            </h3>

            <p class="text-muted small m-0">
                Select a capacity below to manage and create evaluation questions instantly.
            </p>
        </div>

        <button id="btnBackToHub"
                class="btn btn-outline-secondary btn-sm rounded-pill px-3 d-none">
            <i class="bi bi-arrow-left me-1"></i>
            Back to Capacities
        </button>
    </div>


    <!-- Capacity Cards -->
    <div id="capacity-grid" class="row g-4">

        @if (Model != null && Model.Any())
        {
            var sortedModel = Model
                .OrderBy(x => x.ordernumberid ?? int.MaxValue)
                .ToList();

            foreach (var item in sortedModel)
            {
                <div class="col-xl-4 col-md-6 capacity-card"
                     data-id="@item.id"
                     data-quiz-id="@item.quizid">

                    <div class="card border-0 shadow-sm rounded-4 h-100 glow-card bg-white overflow-hidden d-flex flex-column">

                        <!-- Image -->
                        <div class="position-relative w-100 bg-white p-3 border-bottom d-flex align-items-center justify-content-center"
                             style="height:190px;">

                            @if (!string.IsNullOrWhiteSpace(item.imageurl))
                            {
                                <img src="@item.imageurl"
                                     alt="@item.name"
                                     class="img-fluid w-100 h-100 object-fit-contain rounded-2"
                                     loading="lazy"
                                     onerror="this.style.display='none'; this.nextElementSibling.classList.remove('d-none');" />

                                <!-- Fallback -->
                                <div class="image-fallback d-none flex-column align-items-center justify-content-center w-100 h-100 text-secondary">
                                    <i class="bi bi-image fs-1"></i>
                                    <small class="mt-2 text-muted">Image unavailable</small>
                                </div>
                            }
                            else
                            {
                                <div class="d-flex flex-column align-items-center justify-content-center w-100 h-100 text-secondary">
                                    <i class="bi bi-image fs-1"></i>
                                    <small class="mt-2 text-muted">
                                        No Image
                                    </small>
                                </div>
                            }


                            <!-- Lock Status -->
                            <div class="position-absolute top-0 end-0 m-3">

                                @if (item.islocked)
                                {
                                    <span class="badge bg-danger text-white shadow-sm px-2 py-1 rounded-pill">
                                        <i class="bi bi-lock-fill me-1"></i>
                                        Locked
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-success text-white shadow-sm px-2 py-1 rounded-pill">
                                        <i class="bi bi-unlock-fill me-1"></i>
                                        Unlocked
                                    </span>
                                }

                            </div>

                        </div>


                        <!-- Card Content -->
                        <div class="card-body p-4 text-center d-flex flex-column justify-content-center mt-auto">

                            <h5 class="fw-bold text-dark mb-2">
                                @(string.IsNullOrWhiteSpace(item.name)
                                    ? item.quizname
                                    : item.name)
                            </h5>

                            @if (!string.IsNullOrWhiteSpace(item.quizname))
                            {
                                <div class="small fw-semibold text-success mb-2">
                                    <i class="bi bi-patch-question me-1"></i>
                                    @item.quizname
                                </div>
                            }

                            <p class="text-muted small mb-0"
                               style="display:-webkit-box;
                                -webkit-line-clamp:2;
                                -webkit-box-orient:vertical;
                                overflow:hidden;">

                                @(string.IsNullOrWhiteSpace(item.description)
                                    ? "Manage evaluations and questions for this capacity."
                                    : item.description)

                            </p>

                        </div>

                    </div>

                </div>
            }
        }
        else
        {
            <!-- Empty State -->
            <div class="col-12 text-center py-5 text-muted">

                <i class="bi bi-folder-x fs-1 d-block mb-2"></i>

                <p class="mb-1 fw-semibold">
                    No active capacities found.
                </p>

                <small>
                    Please configure them from the Admin Setup Master.
                </small>

            </div>
        }

    </div>


    <!-- AJAX Content -->
    <div id="dynamic-capacity-container" class="mt-3"></div>

</div>


<style>

    .glow-card {
        transition: transform 0.3s cubic-bezier(0.165, 0.84, 0.44, 1), box-shadow 0.3s ease, border-color 0.3s ease;
        border: 1px solid rgba(0, 0, 0, 0.05) !important;
    }

        .glow-card:hover {
            transform: translateY(-6px);
            box-shadow: 0 1rem 2.5rem rgba(25, 135, 84, 0.18) !important;
            border-color: rgba(25, 135, 84, 0.4) !important;
        }

    .cursor-pointer {
        cursor: pointer;
    }

    .capacity-card {
        cursor: pointer;
    }

        .capacity-card:active .glow-card {
            transform: scale(0.99);
        }

    .image-fallback {
        position: absolute;
        inset: 0;
    }

</style>


@section Scripts {

    <script>

        $(document).ready(function() {

            /*
             * ============================================
             * CAPACITY CARD CLICK
             * ============================================
             */

            $('.capacity-card').on('click', function() {

                let capacityId = $(this).data('id');

                if (!capacityId) {
                    console.error('Capacity ID not found.');
                    return;
                }

                // Hide cards
                $('#capacity-grid').fadeOut(200, function() {

                    // Show back button
                    $('#btnBackToHub').removeClass('d-none');

                    // Loading indicator
                    $('#dynamic-capacity-container')
                        .html(`
                                    <div class="text-center py-5">
                                        <div class="spinner-border text-success" role="status"></div>
                                        <div class="mt-3 text-muted">
                                            Loading capacity...
                                        </div>
                                    </div>
                                `)
                        .hide()
                        .fadeIn(200);

                    /*
                     * Load capacity content
                     */
                    $.get(
                        '/Teacher/LoadCapacity/' + capacityId,
                        function(htmlResponse) {

                            $('#dynamic-capacity-container')
                                .hide()
                                .html(htmlResponse)
                                .fadeIn(300);

                        }
                    )
                        .fail(function(xhr) {

                            console.error(
                                'LoadCapacity failed:',
                                xhr.status,
                                xhr.responseText
                            );

                            $('#dynamic-capacity-container')
                                .html(`
                                        <div class="alert alert-danger rounded-4">
                                            <i class="bi bi-exclamation-triangle me-2"></i>
                                            Failed to load module content.
                                        </div>
                                    `);

                            $('#capacity-grid').fadeIn(200);

                            $('#btnBackToHub').addClass('d-none');

                        });

                });

            });


            /*
             * ============================================
             * BACK TO CAPACITIES
             * ============================================
             */

            $('#btnBackToHub').on('click', function() {

                $('#dynamic-capacity-container').fadeOut(200, function() {

                    $(this).html('');

                    $('#btnBackToHub').addClass('d-none');

                    $('#capacity-grid').fadeIn(300);

                });

            });

        });

    </script>

}