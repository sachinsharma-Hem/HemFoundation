@model IEnumerable<HemFoundation.Models.Entities.WebinarMcqCategory>

@{
    ViewData["Title"] = "MCQ Capacities Hub";
    Layout = "~/Views/Shared/Layouts/_TeacherLayout.cshtml";
}

<div class="container-fluid py-4">
    <div class="d-flex align-items-center justify-content-between mb-4">
        <div>
            <h3 class="fw-bold text-dark m-0"><i class="bi bi-ui-checks-grid text-success me-2"></i> MCQ Capacities Manager</h3>
            <p class="text-muted small m-0">Select a capacity below to manage and create evaluation questions instantly.</p>
        </div>
        <button id="btnBackToHub" class="btn btn-outline-secondary btn-sm rounded-pill px-3 d-none">
            <i class="bi bi-arrow-left me-1"></i> Back to Capacities
        </button>
    </div>

    <!-- Dynamic Modern Cards Grid with Glow & Full Uncropped Image -->
    <div id="capacity-grid" class="row g-4">
        @if (Model != null && Model.Any())
        {
            var sortedModel = Model.OrderBy(x => x.OrderNumber != null ? x.OrderNumber.DisplayOrder : int.MaxValue);

            foreach (var item in sortedModel)
            {
                string imgPath = item.ImageUrl;

                <div class="col-xl-4 col-md-6 capacity-card" data-id="@item.Id">
                    <div class="card border-0 shadow-sm rounded-4 h-100 glow-card bg-white overflow-hidden d-flex flex-column cursor-pointer">
                        
                        <!-- Image Container -->
                        <div class="position-relative w-100 bg-white p-3 border-bottom d-flex align-items-center justify-content-center" style="height:190px;">
                            @if (!string.IsNullOrWhiteSpace(imgPath))
                            {
                                <img src="@imgPath" alt="@item.Name" class="img-fluid w-100 h-100 object-fit-contain rounded-2" />
                            }
                            else
                            {
                                <div class="d-flex flex-column align-items-center justify-content-center w-100 h-100 text-secondary">
                                    <i class="bi bi-image fs-1"></i>
                                    <small class="mt-2 text-muted">No Image</small>
                                </div>
                            }

                            <div class="position-absolute top-0 end-0 m-3">
                                @if (item.IsLocked)
                                {
                                    <span class="badge bg-danger text-white shadow-sm px-2 py-1 rounded-pill">
                                        <i class="bi bi-lock-fill me-1"></i> Locked
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-success text-white shadow-sm px-2 py-1 rounded-pill">
                                        <i class="bi bi-unlock-fill me-1"></i> Unlocked
                                    </span>
                                }
                            </div>
                        </div>

                        <!-- Content Section: Name & Description -->
                        <div class="card-body p-4 text-center d-flex flex-column justify-content-center mt-auto">
                            <h5 class="fw-bold text-dark mb-2">@item.Name</h5>
                            <p class="text-muted small mb-0" style="display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;">
                                @(item.Description ?? "Manage evaluations and questions for this category.")
                            </p>
                        </div>

                    </div>
                </div>
            }
        }
        else
        {
            <div class="col-12 text-center py-5 text-muted">
                <i class="bi bi-folder-x fs-1 d-block mb-2"></i>
                <p>No active capacities found. Please configure them from the Admin Setup Master.</p>
            </div>
        }
    </div>

    <!-- Dynamic AJAX Content Injection Area -->
    <div id="dynamic-capacity-container" class="mt-3"></div>
</div>

<style>
    .glow-card {
        transition: all 0.3s cubic-bezier(0.165, 0.84, 0.44, 1);
        border: 1px solid rgba(0, 0, 0, 0.05) !important;
    }
    .glow-card:hover {
        transform: translateY(-6px);
        box-shadow: 0 1rem 2.5rem rgba(25, 135, 84, 0.18) !important;
        border-color: rgba(25, 135, 84, 0.4) !important;
    }
    .cursor-pointer {
        cursor: pointer;
    }
</style>

@section Scripts {
    <script>
        $(document).ready(function () {
            $('.capacity-card').on('click', function () {
                let capacityId = $(this).data('id');
                
                $('#capacity-grid').fadeOut(200, function () {
                    $('#btnBackToHub').removeClass('d-none');
                    
                    $.get('/Teacher/LoadCapacity/' + capacityId, function (htmlResponse) {
                        $('#dynamic-capacity-container').html(htmlResponse).hide().fadeIn(300);
                    }).fail(function () {
                        alert('Failed to load module content.');
                        $('#capacity-grid').fadeIn(200);
                        $('#btnBackToHub').addClass('d-none');
                    });
                });
            });

            $('#btnBackToHub').on('click', function () {
                $('#dynamic-capacity-container').fadeOut(200, function () {
                    $(this).html('');
                    $('#btnBackToHub').addClass('d-none');
                    $('#capacity-grid').fadeIn(300);
                });
            });
        });
    </script>
}