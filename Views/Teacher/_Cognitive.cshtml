@model HemFoundation.Models.Entities.CapacityViewModel

@{
    int categoryId = Model?.Id ?? 0; // Yeh aapka CourseID hoga
    string categoryName = Model?.Name ?? "Cognitive Capacity";
    string categoryDesc = Model?.Description ?? "Manage evaluations and interactive modules for this capacity.";
    
    // Nayi default image URL set ki gayi hai
    string defaultImgUrl = "https://encrypted-tbn0.gstatic.com/images?q=tbn:ANd9GcQrU6HHZMnwIS6q7a3lvXOC_b1i94FbOj9bVpLGcSt-9g&s=10";
    string categoryImg = !string.IsNullOrEmpty(Model?.ImageUrl) ? Model.ImageUrl : defaultImgUrl;
    
    int? quizId = Model?.QuizId;
    string quizName = Model?.QuizName ?? "";
}

<div class="cognitive-wrapper py-2" data-category-id="@categoryId">

    <!-- Capacity Header Card -->
    <div class="card border-0 shadow-sm rounded-4 bg-white p-4 mb-4 animate-fade-in" style="border: 1px solid rgba(0, 0, 0, 0.06) !important;">
        <div class="row align-items-center">
            <div class="col-md-2 text-center mb-3 mb-md-0">
                <div class="p-2 bg-light rounded-4 border d-inline-block d-flex align-items-center justify-content-center overflow-hidden" style="width: 105px; height: 105px; margin: 0 auto;">
                    <!-- Added onerror here to fix the broken header image in screenshot -->
                    <img src="@categoryImg" class="w-100 h-100 rounded-2" style="object-fit: cover; object-position: center;" alt="@categoryName" onerror="this.onerror=null; this.src='@defaultImgUrl';">
                </div>
            </div>
            <div class="col-md-7 text-center text-md-start">
                <span class="badge bg-success-subtle text-success px-3 py-1 rounded-pill mb-1 fw-semibold" style="font-size: 0.75rem;"><i class="bi bi-star-fill me-1"></i> Capacity Module</span>
                <h3 class="fw-bold text-dark mb-1">@categoryName</h3>
                <p class="text-muted small mb-0 lh-sm" style="max-width: 600px;">@categoryDesc</p>
            </div>
            <div class="col-md-3 text-center text-md-end mt-3 mt-md-0">
                <div class="d-inline-flex gap-3 bg-light px-3 py-2 rounded-4 border">
                    <div><span class="d-block text-muted" style="font-size: 0.7rem;">Topics</span><h5 class="fw-bold text-success m-0" id="cogTopicsCount">@ViewBag.TopicsCount</h5></div>
                    <div class="vr my-1"></div>
                    <div><span class="d-block text-muted" style="font-size: 0.7rem;">Sub-Topics</span><h5 class="fw-bold text-primary m-0" id="cogSubTopicsCount">@ViewBag.SubTopicsCount</h5></div>
                </div>
            </div>
        </div>
    </div>

    <div class="d-flex flex-column flex-md-row align-items-md-center justify-content-between mb-3 px-1 gap-1">
        <h5 class="fw-bold text-dark m-0"><i class="bi bi-collection-play me-2 text-success"></i> Learning Modules & Assessments</h5>
        <span class="text-muted small">Select a module to proceed</span>
    </div>

    <!-- Sub-Topics Container -->
    <div class="row g-3" id="cogSubTopicsContainer">
        <div class="col-12 text-center py-5 text-muted">
            <div class="spinner-border text-success spinner-border-sm me-2" role="status"></div> Loading learning modules...
        </div>
    </div>
</div>

<!-- Video Modal -->
<div class="modal fade" id="cogVideoModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content rounded-4 border-0 shadow-lg bg-white">
            <div class="modal-header border-bottom px-4 py-3">
                <h6 class="fw-bold text-dark m-0 d-flex align-items-center"><i class="bi bi-play-btn-fill text-danger me-2 fs-5"></i> <span id="cogVideoTitle">Video Learning Session</span></h6>
                <button type="button" class="btn-close shadow-none" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-4 text-center">
                <div class="ratio ratio-16x9 rounded-4 overflow-hidden shadow bg-black">
                    <iframe id="cogVideoIframe" src="" allowfullscreen allow="autoplay"></iframe>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Hidden values for MCQ Redirect -->
<input type="hidden" id="quizId" value="@(quizId ?? 0)" />

<!-- JavaScript Logic -->
<script>
    $(document).ready(function() {
        let catId = $('.cognitive-wrapper').data('category-id');
        let fallbackImg = 'https://encrypted-tbn0.gstatic.com/images?q=tbn:ANd9GcQrU6HHZMnwIS6q7a3lvXOC_b1i94FbOj9bVpLGcSt-9g&s=10';

        function getAuthToken() {
            return localStorage.getItem('jwt_token') || sessionStorage.getItem('jwt_token') || '';
        }

        // YouTube video link se thumbnail URL extract karne ka function
        function getYouTubeThumbnail(url) {
            if (!url) return null;
            let videoId = null;
            if (url.includes('youtube.com/watch?v=')) {
                videoId = url.split('v=')[1].split('&')[0];
            } else if (url.includes('youtu.be/')) {
                videoId = url.split('youtu.be/')[1].split('?')[0];
            } else if (url.includes('youtube.com/embed/')) {
                videoId = url.split('embed/')[1].split('?')[0];
            }
            
            if (videoId) {
                return `https://img.youtube.com/vi/${videoId}/hqdefault.jpg`; 
            }
            return null;
        }

        // Fetch Sub-Topics via API
        $.ajax({
            url: `/api/teacher-capacity/details/${catId}`,
            type: 'GET',
            headers: { 'Authorization': 'Bearer ' + getAuthToken() },
            success: function(res) {
                if (res.success) {
                    $('#cogTopicsCount').text(res.counts.topicsCount);
                    $('#cogSubTopicsCount').text(res.counts.subTopicsCount);

                    let html = '';
                    let html2='';
                    res.subTopics.forEach((st) => {
                        let isVideo = st.videoLink && st.videoLink.trim() !== '' && st.videoLink !== 'null';
                        let badge = isVideo ? `<span class="badge bg-info text-white border px-2 py-1 rounded-pill shadow-sm" style="font-size:0.7rem; backdrop-filter: blur(4px); background-color: rgba(13, 202, 240, 0.85) !important;"><i class="bi bi-play-circle-fill me-1"></i> Video</span>` : `<span class="badge bg-warning text-dark border px-2 py-1 rounded-pill shadow-sm" style="font-size:0.7rem; backdrop-filter: blur(4px); background-color: rgba(255, 193, 7, 0.85) !important;"><i class="bi bi-question-circle-fill me-1"></i> ${st.numberOfQuestions} Qs</span>`;
                        debugger
                        let ytThumb = isVideo ? getYouTubeThumbnail(st.videoLink) : null;

                        let rawImg = st.mcqThumbnail && st.mcqThumbnail.trim() !== '' ? st.mcqThumbnail : fallbackImg;

                        // Strip the '~' character if it exists so it becomes a valid path starting with '/'
                        let cleanPath = rawImg ? rawImg.replace('~', '') : '';

                        // Your domain
                        let domain = "https://www.hemvirtues.in";

                        // If it's a YouTube video thumbnail, use it directly without concatenating the domain. Otherwise, prepend the domain.
                        let imgSrc = ytThumb ? ytThumb : (cleanPath ? domain + cleanPath : fallbackImg);
                        //let imgSrc = ytThumb || (st.mcqThumbnail && st.mcqThumbnail.trim() !== '' ? st.mcqThumbnail : fallbackImg);

                        // Play Button Overlay Logic
                        let playOverlay = isVideo ? `
                            <div class="position-absolute top-50 start-50 translate-middle play-icon-wrapper">
                                <i class="bi bi-play-circle-fill text-white opacity-75" style="font-size: 3.5rem; filter: drop-shadow(0px 4px 6px rgba(0,0,0,0.6));"></i>
                            </div>` : '';

                        html2 += `
        <div class="col-xl-4 col-md-6">
            <div class="card border-0 shadow-sm rounded-4 bg-white h-100 overflow-hidden d-flex flex-column cursor-pointer light-card module-card" onclick="openCogModule(${st.id}, '${st.videoLink || ''}', '${st.subTopicName}', ${st.languageId}, ${st.examinationId})">
                <!-- Image Container height set to 180px with contain to prevent cutting -->
                <div class="position-relative w-100 bg-dark border-bottom overflow-hidden d-flex align-items-center justify-content-center" style="height:180px;">
                    <img src="${imgSrc}" alt="${st.subTopicName}" class="w-100 h-100" style="object-fit: contain; object-position: center; opacity: ${isVideo ? '0.85' : '1'};" onerror="this.onerror=null; this.src='${fallbackImg}';" />
                    ${playOverlay}
                    <div class="position-absolute top-0 end-0 m-2">${badge}</div>
                </div>
                <div class="card-body p-3 d-flex flex-column justify-content-between">
                    <h6 class="fw-bold text-dark mb-2 text-truncate">${st.subTopicName}</h6>
                    <div class="d-flex align-items-center justify-content-between pt-2 border-top small">
                        <span class="text-muted" style="font-size:0.75rem;"><i class="bi bi-journal-text me-1"></i> Interactive</span>
                        <span class="text-success fw-bold">
                            ${isVideo ? 'Watch <i class="bi bi-arrow-right-short align-middle"></i>' : 'Start Exam <i class="bi bi-arrow-right-short align-middle"></i>'}
                        </span>
                    </div>
                </div>
            </div>
        </div>`;

        html += `<div class="col-xl-4 col-md-6">    
    <div class="card border-0 shadow-sm rounded-4 bg-white h-100 overflow-hidden d-flex flex-column cursor-pointer light-card module-card" onclick="openCogModule(${st.id}, '${st.videoLink || ''}', '${st.subTopicName}', ${st.languageId}, ${st.examinationId})">        
        <!-- Image Container height set to 180px with contain to prevent cutting -->        
        <div class="position-relative w-100 bg-dark border-bottom overflow-hidden d-flex align-items-center justify-content-center" style="height:180px;">            
            <img src="${imgSrc}" alt="${st.subTopicName}" class="w-100 h-100" style="object-fit: contain; object-position: center; opacity: ${isVideo ? '0.85' : '1'};" onerror="this.onerror=null; this.src='${fallbackImg}';" />            
            ${playOverlay}            
            <div class="position-absolute top-0 end-0 m-2">${badge}</div>        
        </div>        
        <div class="card-body p-3 d-flex flex-column justify-content-between">            
            <h6 class="fw-bold text-dark mb-2 text-truncate">${st.subTopicName}</h6>            
            <div class="d-flex align-items-center justify-content-between pt-2 border-top small">                
                <span class="text-muted" style="font-size:0.75rem;"><i class="bi bi-journal-text me-1"></i> Interactive</span>                
                <span class="${st.examinationId && st.examinationId !== 0 ? 'text-primary' : 'text-success'} fw-bold">                    
                    ${isVideo ? 'Watch <i class="bi bi-arrow-right-short align-middle"></i>' : (st.examinationId && st.examinationId !== 0 ? 'Preview Exam <i class="bi bi-eye align-middle"></i>' : 'Start Exam <i class="bi bi-arrow-right-short align-middle"></i>')}                
                </span>            
            </div>        
        </div>    
    </div>
</div>`;
                    });
                    $('#cogSubTopicsContainer').html(html || '<div class="col-12 text-center text-muted py-4">No sub-topics found for this capacity.</div>');
                }
            },
            error: function() {
                $('#cogSubTopicsContainer').html('<div class="col-12 text-center text-danger py-4">Failed to load modules. Please try again.</div>');
            }
        });

        // Universal Click Handler for Sub-Topics
        window.openCogModule = function(subTopicId, videoLink, title, languageId, examinationId) {
            if (videoLink && videoLink.trim() !== '' && videoLink !== 'null') {
                let embedUrl = videoLink.includes('watch?v=') ? videoLink.replace('watch?v=', 'embed/') : videoLink;
                $('#cogVideoTitle').text(title);
                $('#cogVideoIframe').attr('src', embedUrl);
                new bootstrap.Modal(document.getElementById('cogVideoModal')).show();
            } 
            else {
                let quizIdVal = $('#quizId').val() || 0;
                let topicIdVal = subTopicId;
                let langIdVal = languageId || 1;
                let examIdVal = examinationId||0;
                let isAttemptVal = examIdVal !== 0;
                let redirectUrl = `/Exam/Index?QuizId=${quizIdVal}&TopicID=${topicIdVal}&LevelID=1&LanguageID=${langIdVal}&IsInstituteQuiz=false&IsAttempt=${isAttemptVal}&ExamID=${examIdVal}`;
                window.location.href = redirectUrl;
            }
        };

        // Reset iframe on close
        $('#cogVideoModal').on('hidden.bs.modal', function() {
            $('#cogVideoIframe').attr('src', '');
        });
    });
</script>

<style>
    .light-card { transition: all 0.25s ease-in-out; border: 1px solid rgba(0, 0, 0, 0.08) !important; }
    .light-card:hover { transform: translateY(-4px); box-shadow: 0 .5rem 1rem rgba(0, 0, 0, 0.07) !important; border-color: rgba(25, 135, 84, 0.3) !important; }
    .cursor-pointer { cursor: pointer; }
    
    /* Play button hover effect */
    .module-card .play-icon-wrapper i {
        transition: transform 0.3s ease, opacity 0.3s ease;
    }
    .module-card:hover .play-icon-wrapper i {
        transform: scale(1.15);
        opacity: 1 !important;
        color: #fff !important;
    }
</style>