    var textbox = '';
    function txt_click(clicked_id) {
        $('#' + clicked_id).attr('readonly', 'readonly');
        textbox = clicked_id;
    }

    function display(val) {
        let GetValues = document.getElementById(val).innerHTML;
        if (textbox != null && textbox != '') {
            var C = document.getElementById(textbox).value;
            var CL = document.getElementById(textbox).value.length;
            if (C == "" && CL == 0) {
                document.getElementById(textbox).value = GetValues;
                document.getElementById(textbox).blur();
                textbox = '';
            }
        } else {
            if (typeof Swal !== 'undefined' && typeof Swal.fire === 'function') {
                Swal.fire({ title: "Oops!", text: "Please select a grid box first.", icon: "warning" });
            } else {
                alert("Oops! Please select a grid box first.");
            }
        }
    }

    function erase() {
        if (textbox != null && textbox != '') {
            document.getElementById(textbox).value = '';
        }
    }
