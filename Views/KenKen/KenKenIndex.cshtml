<script type="text/javascript">
    var txtArray = [];
    var size = '';
    var lineArray = [];
    var GetPractID = @ViewBag.PracticleID;
    var DataMaster = [];
    var DataTarget = [];
    var DataCage = [];
    var DataSolution = [];

    var SetDataMaster = [];
    var SetDataTarget = [];
    var SetDataCage = [];
    var SetDataSolution = [];
    var NP = 0;
    var GlobalKMID;
    var CourseID;

    $(document).ready(function() {
        var GetCID = $("#CourseID").val();
        document.onkeydown = function(e) {
            return false;
        }

        $.ajax({
            url: '/KenKen/GetKenKenDetails',
            type: "POST",
            data: { CID: GetCID },
            success: function(response) {
                if (response && response.length >= 5) {
                    if (response[4] == "OK") {
                        DataMaster.push(response[0]);
                        DataTarget.push(JSON.parse(response[2]));
                        DataCage.push(response[3]);
                        DataSolution.push(response[1]);

                        var arr = JSON.parse(DataMaster[0]);
                        arr.forEach(function(elementObject) {
                            var keys = Object.keys(elementObject);
                            keys.forEach(function(key) {
                                if (key == "KMID" || key == "kmid") {
                                    var xp = elementObject[key];
                                    CheckSetTKenKen(xp);
                                }
                            })
                        });
                        const KenMFirst = SetDataMaster.find(element => element);
                        const KemTargetFirst = SetDataTarget.find(element => element);
                        const KemCagetFirst = SetDataCage.find(element => element);

                        generateElement(KenMFirst, KemTargetFirst, KemCagetFirst);
                    }
                }
                else {
                    if (typeof Swal !== 'undefined' && typeof Swal.fire === 'function') {
                        Swal.fire({ title: "Congrats!", text: "You have Completed all levels.......", icon: "success" });
                    } else {
                        alert("Congrats! You have Completed all levels.......");
                    }
                    setTimeout(function() {
                        window.location = '/learn/index';
                    }, 5000);
                }
            },
            error: function() {
                alert('Something went wrong');
            }
        });
    });

    function buildKeypad(gridSize) {
        var container = document.getElementById('keypadContainer');
        container.innerHTML = '';
        var limit = parseInt(gridSize) || 3;
        for (var k = 1; k <= limit; k++) {
            var btn = document.createElement('button');
            btn.className = 'btn btn-primary nobtn mx-1';
            btn.id = 'btn_No' + k;
            btn.type = 'button';
            btn.innerHTML = k;
            btn.onclick = (function(num) {
                return function() {
                    display('btn_No' + num);
                };
            })(k);
            container.appendChild(btn);
        }
    }

    function prevItem() {
        if (NP === 0) {
            NP = SetDataMaster.length;
        }
        NP = NP - 1;
        if (NP == 0) {
            $('#btn_Prev').attr('disabled', 'disabled');
            $('#btn_Next').removeAttr('disabled');
        } else {
            $('#btn_Prev').removeAttr('disabled');
        }
        return [SetDataMaster[NP], SetDataTarget[NP], SetDataCage[NP]];
    }

    function nextItem() {
        NP = NP + 1;
        NP = NP % SetDataMaster.length;
        if (NP == 0) {
            $('#btn_Next').attr('disabled', 'disabled');
            $('#btn_Prev').removeAttr('disabled');
        } else {
            $('#btn_Next').removeAttr('disabled');
        }
        return [SetDataMaster[NP], SetDataTarget[NP], SetDataCage[NP]];
    }

    function btn_Prev() {
        for (var k = 1; k <= 25; k++) {
            let el = document.getElementById('txt3' + k);
            if (el) el.value = "";
            let el4 = document.getElementById('txt4' + k);
            if (el4) el4.value = "";
            let el5 = document.getElementById('txt5' + k);
            if (el5) el5.value = "";
        }
        let [a1, b2, c3] = prevItem();
        generateElement(a1, b2, c3);
    }

    function btn_Next() {
        for (var k = 1; k <= 25; k++) {
            let el = document.getElementById('txt3' + k);
            if (el) el.value = "";
            let el4 = document.getElementById('txt4' + k);
            if (el4) el4.value = "";
            let el5 = document.getElementById('txt5' + k);
            if (el5) el5.value = "";
        }
        let [a, b, c] = nextItem();
        generateElement(a, b, c);
    }

    function CheckSetTKenKen(KMID) {
        var Retrive1 = JSON.parse(DataMaster[0]).filter((x) => (x.KMID == KMID || x.kmid == KMID));
        SetDataMaster.push(Retrive1);

        var Retrive2 = DataTarget[0].filter((x) => (x.KMID == KMID || x.kmid == KMID));
        SetDataTarget.push(Retrive2);

        var Retrive3 = JSON.parse(DataCage[0]).filter((x) => (x.KMID == KMID || x.kmid == KMID));
        SetDataCage.push(Retrive3);
    }

    function createTextBox(sz) {
        txtArray = [];
        for (var i = 1; i <= sz; i++) {
            for (var j = 1; j <= sz; j++) {
                var txtIds = {
                    targetid: 'T_R' + i + '_C' + j,
                }
                txtArray.push(txtIds);
            }
        }
    }

    function fillLineArray() {
        lineArray = [];
        if (size == 3) {
            var tlineType = 'target';
            lineArray.push({ LineType: tlineType, Column1: $("#txt31").val(), Column2: $("#txt32").val(), Column3: $("#txt33").val() });
            lineArray.push({ LineType: tlineType, Column1: $("#txt34").val(), Column2: $("#txt35").val(), Column3: $("#txt36").val() });
            lineArray.push({ LineType: tlineType, Column1: $("#txt37").val(), Column2: $("#txt38").val(), Column3: $("#txt39").val() });
        }
        else if (size == 4) {
            var tlineType = 'target';
            lineArray.push({ LineType: tlineType, Column1: $("#txt41").val(), Column2: $("#txt42").val(), Column3: $("#txt43").val(), Column4: $("#txt44").val() });
            lineArray.push({ LineType: tlineType, Column1: $("#txt45").val(), Column2: $("#txt46").val(), Column3: $("#txt47").val(), Column4: $("#txt48").val() });
            lineArray.push({ LineType: tlineType, Column1: $("#txt49").val(), Column2: $("#txt410").val(), Column3: $("#txt411").val(), Column4: $("#txt412").val() });
