    function generateElement(KenMaster, TargetData, CageData) {
        $('#btn_Check').removeClass('disabled').css('pointer-events', 'auto');

        if (KenMaster != null && TargetData != null && CageData != null) {
            SetDataSolution.length = 0;
            var masterObj = KenMaster[0];
            var kmidVal = masterObj["KMID"] !== undefined ? masterObj["KMID"] : masterObj["kmid"];
            var boxsize = masterObj["Size"] !== undefined ? masterObj["Size"] : masterObj["size"];

            var Retrive4 = JSON.parse(DataSolution[0]).filter((x) => (x.KMID == kmidVal || x.kmid == kmidVal));
            SetDataSolution.push(Retrive4);

            GlobalKMID = kmidVal;
            CourseID = masterObj["CourseID"] !== undefined ? masterObj["CourseID"] : masterObj["courseid"];

            size = boxsize || document.getElementById("Size").value;
            buildKeypad(size);

            if (boxsize == '3') {
                $('#three').removeClass("d-none");
                $('#four').addClass("d-none");
                $('#five').addClass("d-none");
            } else if (boxsize == '4') {
                $('#three').addClass("d-none");
                $('#four').removeClass("d-none");
                $('#five').addClass("d-none");
            } else if (boxsize == '5') {
                $('#three').addClass("d-none");
                $('#four').addClass("d-none");
                $('#five').removeClass("d-none");
            }

            createTextBox(size);

            var processedTargets = [];
            for (var i = 0; i < TargetData.length; i++) {
                var arrTarget = TargetData[i];
                for (let key in arrTarget) {
                    if (key.toLowerCase() != "ktid" && key.toLowerCase() != "kmid") {
                        var E1 = arrTarget[key];
                        if (E1 != 0) {
                            processedTargets.push(E1);
                        }
                    }
                }
            }
            var count = 1;
            for (var i = 0; i < processedTargets.length; i++) {
                let lbl = document.getElementById("lbl" + boxsize + count);
                if (lbl) lbl.innerHTML = processedTargets[i];
                count++;
            }

            var processedCages = [];
            for (var i = 0; i < CageData.length; i++) {
                var arrCage = CageData[i];
                for (let key in arrCage) {
                    if (key.toLowerCase() != "kcid" && key.toLowerCase() != "ktid" && key.toLowerCase() != "kmid") {
                        var E1 = arrCage[key];
                        if (E1 != 0) {
                            processedCages.push(E1);
                        }
                    }
                }
            }

            txtArray.forEach(function(item, i) {
                var CT = 1;
                for (var idx = 0; idx < processedCages.length; idx++) {
                    var v = document.getElementById("txt" + boxsize + CT);
                    if (!v) continue;

                    var bgColors = {
                        'A': '#daeef3', 'B': '#d6e3bc', 'C': '#fde9d9', 'D': '#f2dbdb',
                        'E': '#FFFFE0', 'F': '#ffe0b3', 'G': '#ffcce6', 'H': '#ccccff',
                        'I': '#efb8b8', 'J': '#ffa64d', 'K': '#ff9999', 'L': '#ecffb3', 'M': '#FFDAB9'
                    };

                    if (bgColors[processedCages[idx]]) {
                        v.style.backgroundColor = bgColors[processedCages[idx]];
                        CT++;
                    }
                }
            });
        }
    }

    function SaveDataRecord() {
        fillLineArray();
        var IsChecked = true;

        for (var i = 0; i < lineArray.length; i++) {
            if (size == 3) {
                var C1 = lineArray[i]['Column1'];
                var C2 = lineArray[i]['Column2'];
                var C3 = lineArray[i]['Column3'];

                var Sol1 = SetDataSolution[0][i]['S1'] !== undefined ? SetDataSolution[0][i]['S1'] : SetDataSolution[0][i]['s1'];
                var Sol2 = SetDataSolution[0][i]['S2'] !== undefined ? SetDataSolution[0][i]['S2'] : SetDataSolution[0][i]['s2'];
                var Sol3 = SetDataSolution[0][i]['S3'] !== undefined ? SetDataSolution[0][i]['S3'] : SetDataSolution[0][i]['s3'];

                if (parseInt(C1) != parseInt(Sol1) || parseInt(C2) != parseInt(Sol2) || parseInt(C3) != parseInt(Sol3)) {
                    IsChecked = false;
                    break;
                }
            }
            if (size == 4) {
                var C1 = lineArray[i]['Column1'];
                var C2 = lineArray[i]['Column2'];
                var C3 = lineArray[i]['Column3'];
                var C4 = lineArray[i]['Column4'];

                var Sol1 = SetDataSolution[0][i]['S1'] !== undefined ? SetDataSolution[0][i]['S1'] : SetDataSolution[0][i]['s1'];
                var Sol2 = SetDataSolution[0][i]['S2'] !== undefined ? SetDataSolution[0][i]['S2'] : SetDataSolution[0][i]['s2'];
                var Sol3 = SetDataSolution[0][i]['S3'] !== undefined ? SetDataSolution[0][i]['S3'] : SetDataSolution[0][i]['s3'];
                var Sol4 = SetDataSolution[0][i]['S4'] !== undefined ? SetDataSolution[0][i]['S4'] : SetDataSolution[0][i]['s4'];

                if (parseInt(C1) != parseInt(Sol1) || parseInt(C2) != parseInt(Sol2) || parseInt(C3) != parseInt(Sol3) || parseInt(C4) != parseInt(Sol4)) {
                    IsChecked = false;
                    break;
                }
            }
            if (size == 5) {
                var C1 = lineArray[i]['Column1'];
                var C2 = lineArray[i]['Column2'];
                var C3 = lineArray[i]['Column3'];
                var C4 = lineArray[i]['Column4'];
                var C5 = lineArray[i]['Column5'];

                var Sol1 = SetDataSolution[0][i]['S1'] !== undefined ? SetDataSolution[0][i]['S1'] : SetDataSolution[0][i]['s1'];
                var Sol2 = SetDataSolution[0][i]['S2'] !== undefined ? SetDataSolution[0][i]['S2'] : SetDataSolution[0][i]['s2'];
                var Sol3 = SetDataSolution[0][i]['S3'] !== undefined ? SetDataSolution[0][i]['S3'] : SetDataSolution[0][i]['s3'];
                var Sol4 = SetDataSolution[0][i]['S4'] !== undefined ? SetDataSolution[0][i]['S4'] : SetDataSolution[0][i]['s4'];
                var Sol5 = SetDataSolution[0][i]['S5'] !== undefined ? SetDataSolution[0][i]['S5'] : SetDataSolution[0][i]['s5'];

                if (parseInt(C1) != parseInt(Sol1) || parseInt(C2) != parseInt(Sol2) || parseInt(C3) != parseInt(Sol3) || parseInt(C4) != parseInt(Sol4) || parseInt(C5) != parseInt(Sol5)) {
                    IsChecked = false;
                    break;
                }
            }
        }

        let $checkBtn = $('#btn_Check');
        if (IsChecked) {
            $checkBtn.addClass('disabled').css('pointer-events', 'none');

            if (typeof Swal !== 'undefined' && typeof Swal.fire === 'function') {
                Swal.fire({
                    title: "Congrats!",
                    text: "Valid Solution!!! Saving record...",
                    icon: "success",
                    timer: 2500,
                    showConfirmButton: false
                });
            } else {
                alert("Congrats! Valid Solution!!! Saving record...");
            }

            setTimeout(function() {
                SaveData();
            }, 3000);
        } else {
            if (typeof Swal !== 'undefined' && typeof Swal.fire === 'function') {
                Swal.fire({
                    title: "Oops!",
                    text: "Invalid Solution..",
                    icon: "error"
                });
            } else {
                alert("Oops! Invalid Solution..");
            }

            setTimeout(function() {
                reset();
            }, 3000);
        }
    }

    function reset() {
        location.reload();
    }

    function SaveData() {
        let $checkBtn = $('#btn_Check');
        $.ajax({
            url: '/KenKen/SaveKenKenData',
            type: "POST",
            data: { KMID: GlobalKMID, CourseID: CourseID, PractID: GetPractID },
            success: function(data) {
                if (data[0] === "OK") {
                    // If saving was successful
                    if (typeof Swal !== 'undefined' && typeof Swal.fire === 'function') {
                        Swal.fire({
                            title: "Success!",
                            text: "Record saved successfully..",
                            icon: "success",
                            timer: 2000,
                            showConfirmButton: false
                        }).then(() => {
                            location.reload();
                        });
                    } else {
                        alert("Record saved successfully..");
                        location.reload();
                    }
                }
                else if (data[0] === "RNOTOk") {
                    // If all games are completed
                    if (typeof Swal !== 'undefined' && typeof Swal.fire === 'function') {
                        Swal.fire({
                            title: "Fantastic Job!",
                            text: "You have completed all games....",
                            icon: "success",
                            timer: 2000,
                            showConfirmButton: false
                        }).then(() => {
                            window.location.href = '/learn/index';
                        });
                    } else {
                        alert("You have completed all games....");
                        window.location.href = '/learn/index';
                    }
                }
                else {
                    Swal.fire({
                        title: "Info!",
                        text: data[1],
                        icon: "info"
                    });

                }
            },
            error: function() {
                $checkBtn.removeClass('disabled').css('pointer-events', 'auto');
            }
        });
    }

