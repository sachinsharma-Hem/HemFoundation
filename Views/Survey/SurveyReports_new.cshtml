@{
    ViewBag.Title = "Survey Reports";
    Layout = "~/Views/Shared/Layouts/_AdminLayout.cshtml";

    var courses = ViewBag.CourseList as IEnumerable<SelectListItem> ?? Enumerable.Empty<SelectListItem>();
    var selectedCourseId = ViewBag.CourseID?.ToString() ?? string.Empty;
}

@* @section head
{ *@
    <link rel="stylesheet" href="https://cdn.datatables.net/2.1.7/css/dataTables.bootstrap5.css" />
    <link rel="stylesheet" href="https://cdn.datatables.net/buttons/3.1.2/css/buttons.bootstrap5.css" />
    <link rel="stylesheet" href="https://cdn.datatables.net/responsive/3.0.3/css/responsive.bootstrap5.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/sweetalert2@11/dist/sweetalert2.min.css" />

    <style>
        #teacherTable thead th {
            background-color: #007bff;
            color: #fff;
            text-align: center;
        }

        #teacherTable tfoot th {
            background-color: #f8f9fa;
            color: #212529;
        }

        #loaderOverlay {
            position: fixed;
            inset: 0;
            background: rgba(0, 0, 0, .5);
            z-index: 9999;
            display: none;
            align-items: center;
            justify-content: center;
        }

            #loaderOverlay.is-visible {
                display: flex;
            }

            #loaderOverlay .spinner-border {
                width: 3rem;
                height: 3rem;
            }
    </style>
@* }
 *@
<div id="loaderOverlay" aria-hidden="true">
    <div class="spinner-border text-light" role="status">
        <span class="visually-hidden">Loading...</span>
    </div>
</div>

<div class="row">
    <div class="col-12">
        <div class="card p-3 mb-3">
            <div class="row mb-3">
                <div class="col-md-4">
                    <label for="CoursesDDL" class="form-label">Select Courses:</label>
                    <select class="form-select" id="CoursesDDL" name="CoursesDDL">
                        <option value="0">Please select the Courses</option>
                        @foreach (var c in courses)
                        {
                            <option value="@c.Value" selected="@(c.Value == selectedCourseId)">@c.Text</option>
                        }
                    </select>
                </div>
            </div>

            <div class="table-responsive">
                <h5>Survey Reports</h5>
                <table id="teacherTable" class="table table-striped table-bordered w-100">
                    <thead>
                        <tr>
                            <th>UserID</th>
                            <th>QuestionNumber</th>
                            <th>FirstName</th>
                            <th>LastName</th>
                            <th>Gender</th>
                            <th>Standard</th>
                            <th>Division</th>
                            <th>InstituteName</th>
                            <th>MobileNo</th>
                            <th>CourseName</th>
                            <th>TopicName</th>
                            <th>Questions</th>
                            <th>Option1</th>
                            <th>Option2</th>
                            <th>Option3</th>
                            <th>Option4</th>
                            <th>Option5</th>
                            <th>UserSelectedAnswer</th>
                            <th>Points</th>
                            <th>TotalPoints</th>
                        </tr>
                    </thead>
                </table>
            </div>
        </div>
    </div>
</div>

@section Scripts
{
    <script src="https://cdn.datatables.net/2.1.7/js/dataTables.js"></script>
    <script src="https://cdn.datatables.net/2.1.7/js/dataTables.bootstrap5.js"></script>
    <script src="https://cdn.datatables.net/buttons/3.1.2/js/dataTables.buttons.js"></script>
    <script src="https://cdn.datatables.net/buttons/3.1.2/js/buttons.bootstrap5.js"></script>
    <script src="https://cdn.datatables.net/responsive/3.0.3/js/dataTables.responsive.js"></script>
    <script src="https://cdn.datatables.net/responsive/3.0.3/js/responsive.bootstrap5.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jszip/3.10.1/jszip.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/pdfmake/0.2.7/pdfmake.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/pdfmake/0.2.7/vfs_fonts.js"></script>
    <script src="https://cdn.datatables.net/buttons/3.1.2/js/buttons.html5.min.js"></script>
    <script src="https://cdn.datatables.net/buttons/3.1.2/js/buttons.print.min.js"></script>
    <script src="https://cdn.datatables.net/buttons/3.1.2/js/buttons.colVis.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <script>
        $(function () {
            const $loader = $("#loaderOverlay");
            const dataUrl = '@Url.Action("GetSurveyData", "Survey")';
            let table = null;
            let currentCourseId = "";
            let currentCourseName = "";   // new
            const text = (d) => (d === null || d === undefined || d === "") ? "N/A" : d;
            const num = (d) => (d === null || d === undefined || d === "") ? "0" : d;

            const columns = [
                { data: "userID", render: num },
                { data: "questionNumber", render: num },
                { data: "firstName", render: text },
                { data: "lastName", render: text },
                { data: "gender", render: text },
                { data: "standard", render: text },
                { data: "division", render: text },
                { data: "instituteName", render: text },
                { data: "mobileNo", render: text },
                { data: "courseName", render: text },
                { data: "topicName", render: text },
                { data: "questions", render: text },
                { data: "option1", render: text },
                { data: "option2", render: text },
                { data: "option3", render: text },
                { data: "option4", render: text },
                { data: "option5", render: text },
                { data: "userSelectedAnswer", render: text },
                { data: "points", render: num },
                { data: "totalPoints", render: num }
            ];
            // Removes characters not allowed in file names and falls back if empty
            function exportFileName() {
                const name = (currentCourseName || "Survey_Report")
                    .replace(/[\\/:*?"<>|]+/g, "_")
                    .replace(/\s+/g, " ")
                    .trim();
                return name || "Survey_Report";
            }
            function initTable(rows) {
                table = $("#teacherTable").DataTable({
                    data: rows,
                    paging: true,
                    scrollX: true,
                    layout: {
                        topStart: {
                            buttons: [
                                {
                                    extend: "excel",
                                    text: "Export to Excel",
                                    title: () => currentCourseName,
                                    filename: () => exportFileName(),
                                    exportOptions: { columns: ":visible" }
                                },
                                "copy", "csv", "pdf", "colvis", "print"
                            ]
                        }
                    },
                    columns: columns
                });
            }

            $("#CoursesDDL").on("change", function () {
                currentCourseId = $(this).val();
                
                currentCourseName = $(this).find("option:selected").text().trim();
                if (!currentCourseId || currentCourseId === "0") {
                    if (table) table.clear().draw();
                    return;
                }

                $loader.addClass("is-visible");

                $.ajax({
                    url: dataUrl,
                    type: "GET",
                    dataType: "json",
                    data: { courseId: currentCourseId }
                })
                    .done(function (rows) {
                        rows = rows || [];
                        if (table) {
                            table.clear().rows.add(rows).draw();
                        } else {
                            initTable(rows);
                        }
                    })
                    .fail(function (xhr, status, error) {
                        console.error("AJAX Error:", status, error, xhr.responseText);
                        Swal.fire({
                            icon: "error",
                            title: "Error",
                            text: "Failed to fetch survey data. Please try again."
                        });
                    })
                    .always(function () {
                        $loader.removeClass("is-visible");
                    });
            });
        });
    </script>
}