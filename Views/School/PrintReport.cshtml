<body>


    <div class="report-body">


        @* =========================================================
           NORMAL BROWSER VIEW ONLY
           ========================================================= *@

        @if (!isPdf)
        {
            <div class="container-fluid no-print"
                 style="margin-bottom:20px;">

                <div class="alert alert-info
                    d-flex
                    flex-column
                    flex-md-row
                    justify-content-between
                    align-items-center">

                    <span>

                        <strong>
                            Institute Dashboard
                        </strong>

                    </span>


                    @{
                        string instituteId =
                            Context.Request.Query["instituteId"].ToString();
                    }


                    <a href="@Url.Action(
                                                                  "PrintInstituteReport",
                                                                  "Report",
                                                                  new { instituteId = instituteId }
                                                              )"
                       class="btn btn-primary">

                        <i class="fa fa-file-pdf-o"></i>

                        Download PDF

                    </a>

                </div>

            </div>
        }


        @* =========================================================
           INSTITUTE HEADER
           ========================================================= *@

        <div class="container-fluid keep-together">

            <div class="header-section">


                @* =================================================
                   LOGO
                   ================================================= *@

                @if (System.IO.File.Exists(logoPath))
                {
                    string base64Image =
                        Convert.ToBase64String(
                            System.IO.File.ReadAllBytes(logoPath)
                        );

                    <img src="data:image/png;base64,@base64Image"
                         style="height:80px;"
                         class="img-report" />
                }


                <h3 style="margin:0;">

                    @Model?.Header?.InstituteName

                </h3>


                <p class="text-muted"
                   style="margin:0;">

                    @Model?.Header?.Address

                    |

                    @Model?.Header?.City

                    -

                    @Model?.Header?.Pincode

                </p>

            </div>


            @* =====================================================
               STUDENT + TEACHER CHARTS
               ===================================================== *@

            <div class="row"
                 style="@pdfRowStyle">


                @* =================================================
                   STUDENT COUNT
                   ================================================= *@

                <div class="@chartColumnClass"
                     style="@pdfColStyle">

                    <div class="card card-report no-split">

                        <div class="card-header text-center">

                            Student's Count

                        </div>


                        <div class="card-body">

                            @{
                                string sLabels =
                                    "'Total','Active','Inactive'";

                                string sData =
                                    "0,0,0";


                                if (Model?.studentStats != null)
                                {
                                    sData =
                                        $"{Model.studentStats.TotalStudents}," +
                                        $"{Model.studentStats.ActiveStudents}," +
                                        $"{Model.studentStats.InactiveStudents}";
                                }
                            }


                            <div class="chart-container">

                                <img src="@GetChartImage(
                                                                                            sLabels,
                                                                                            sData,
                                                                                            "Students"
                                                                                        )"
                                     class="img-report"
                                     style="max-height:230px;" />

                            </div>

                        </div>

                    </div>

                </div>


                @* =================================================
                   TEACHER COUNT
                   ================================================= *@

                <div class="@chartColumnClass"
                     style="@pdfColStyle">

                    <div class="card card-report no-split">

                        <div class="card-header text-center">

                            Teacher's Count

                        </div>


                        <div class="card-body">

                            @{
                                string tLabels =
                                    "'Total','Active','Inactive'";

                                string tData =
                                    "0,0,0";


                                if (Model?.teacherStats != null)
                                {
                                    tData =
                                        $"{Model.teacherStats.TotalTeacher}," +
                                        $"{Model.teacherStats.ActiveTeacher}," +
                                        $"{Model.teacherStats.InActiveTeacher}";
                                }
                            }


                            <div class="chart-container">

                                <img src="@GetChartImage(
                                                                                            tLabels,
                                                                                            tData,
                                                                                            "Teachers"
                                                                                        )"
                                     class="img-report"
                                     style="max-height:230px;" />

                            </div>

                        </div>

                    </div>

                </div>

            </div>

        </div>


        @* =========================================================
           STANDARD WISE SUMMARY
           ========================================================= *@

        <div class="container-fluid keep-together">

            <h4 class="text-center mb-3">

                Standard Wise Summary

            </h4>


            @* =====================================================
               STANDARD CHART

               IMPORTANT:
               Full width container is used here.
               No col-6.
               ===================================================== *@

            <div class="card card-report no-split">

                <div class="card-body">

                    @{
                        var labelList =
                            new List<string>();

                        var dataList =
                            new List<string>();


                        if (Model?.standardSummaries != null)
                        {
                            foreach (var item in Model.standardSummaries)
                            {
                                string standard =
                                    (item.Standard ?? "")
                                    .Replace("'", "\\'");


                                labelList.Add(
                                    "'" + standard + "'"
                                );


                                dataList.Add(
                                    item.TotalStudents.ToString(
                                        System.Globalization.CultureInfo.InvariantCulture
                                    )
                                );
                            }
                        }


                        string stdLabels =
                            string.Join(",", labelList);


                        string stdData =
                            string.Join(",", dataList);
                    }


                    @if (!string.IsNullOrWhiteSpace(stdLabels))
                    {
                        <div class="chart-container-full">

                            <img src="@GetChartImage(
                                                                                    stdLabels,
                                                                                    stdData,
                                                                                    "Count"
                                                                                )"
                                 class="chart-img-centered"
                                 style="max-height:300px;" />

                        </div>
                    }

                </div>

            </div>


            @* =====================================================
               STANDARD TABLE
               ===================================================== *@

            <div class="card card-report no-split">

                <div class="card-body p-0">

                    <div class="table-responsive">

                        <table class="table table-striped table-bordered mb-0">

                            <thead>

                                <tr>

                                    <th>
                                        Standard
                                    </th>

                                    <th>
                                        Total
                                    </th>

                                    <th>
                                        Active
                                    </th>

                                    <th>
                                        Inactive
                                    </th>

                                </tr>

                            </thead>


                            <tbody>

                                @if (Model?.standardSummaries != null)
                                {
                                    foreach (var item in Model.standardSummaries)
                                    {
                                        <tr>

                                            <td>
                                                @item.Standard
                                            </td>

                                            <td>
                                                @item.TotalStudents
                                            </td>

                                            <td>
                                                @item.ActiveStudents
                                            </td>

                                            <td>
                                                @item.InactiveStudents
                                            </td>

                                        </tr>
                                    }
                                }

                            </tbody>

                        </table>

                    </div>

                </div>

            </div>

        </div>


        @* =========================================================
           PROJECT WISE SUMMARY
           ========================================================= *@

        <div class="container-fluid keep-together">

            <h4 class="text-center mb-3">

                Project Wise Summary

            </h4>


            @* =====================================================
               PROJECT CHART

               IMPORTANT:
               Full width container is used here.
               No col-6.
               ===================================================== *@

            <div class="card card-report no-split">

                <div class="card-body">

                    @{
                        var pLabels =
                            new List<string>();

                        var indData =
                            new List<string>();

                        var famData =
                            new List<string>();

                        var grpData =
                            new List<string>();


                        if (Model?.ProjectSummaries != null)
                        {
                            foreach (var item in Model.ProjectSummaries)
                            {
                                string standard =
                                    (item.Standard ?? "")
                                    .Replace("'", "\\'");


                                pLabels.Add(
                                    "'" + standard + "'"
                                );


                                indData.Add(
                                    item.IndividualPBLCompleted.ToString(
                                        System.Globalization.CultureInfo.InvariantCulture
                                    )
                                );


                                famData.Add(
                                    item.FamilyPBLCompleted.ToString(
                                        System.Globalization.CultureInfo.InvariantCulture
                                    )
                                );


                                grpData.Add(
                                    item.GroupPBLCompleted.ToString(
                                        System.Globalization.CultureInfo.InvariantCulture
                                    )
                                );
                            }
                        }


                        string projLabels =
                            string.Join(",", pLabels);


                        string projInd =
                            string.Join(",", indData);


                        string projFam =
                            string.Join(",", famData);


                        string projGrp =
                            string.Join(",", grpData);
                    }


                    @if (!string.IsNullOrWhiteSpace(projLabels))
                    {
                        <div class="chart-container-full">

                            <img src="@GetProjectChartImage(
                                                                                    projLabels,
                                                                                    projInd,
                                                                                    projGrp,
                                                                                    projFam
                                                                                )"
                                 class="chart-img-centered"
                                 style="max-height:300px;" />

                        </div>
                    }

                </div>

            </div>


            @* =====================================================
               PROJECT TABLE
               ===================================================== *@

            <div class="card card-report no-split">

                <div class="card-body p-0">

                    <div class="table-responsive">

                        <table class="table table-bordered mb-0">

                            <thead>

                                <tr>

                                    <th>
                                        Standard
                                    </th>

                                    <th>
                                        Total Students
                                    </th>

                                    <th>
                                        Individual PBL
                                    </th>

                                    <th>
                                        Family PBL
                                    </th>

                                    <th>
                                        Group PBL
                                    </th>

                                </tr>

                            </thead>


                            <tbody>

                                @if (Model?.ProjectSummaries != null)
                                {
                                    foreach (var group in Model.ProjectSummaries)
                                    {
                                        <tr>

                                            <td>
                                                @group.Standard
                                            </td>

                                            <td>
                                                @group.TotalStudents
                                            </td>

                                            <td>
                                                @group.IndividualPBLCompleted
                                            </td>

                                            <td>
                                                @group.FamilyPBLCompleted
                                            </td>

                                            <td>
                                                @group.GroupPBLCompleted
                                            </td>

                                        </tr>
                                    }
                                }

                            </tbody>

                        </table>

                    </div>

                </div>

            </div>

        </div>


        @* =========================================================
           PAGE BREAK
           ========================================================= *@

        <div class="container-fluid page-break">


            @* =====================================================
               TOP 10 PERFORMERS
               ===================================================== *@

            <div class="card card-report no-split">

                <div class="card-header">

                    Top 10 Performers (Institute Level)

                </div>


                <div class="card-body p-0">

                    <div class="table-responsive">

                        <table class="table table-sm table-bordered mb-0">

                            <thead class="thead-light">

                                <tr>

                                    <th style="width:50px;">
                                        Rank
                                    </th>

                                    <th>
                                        Student Name
                                    </th>

                                    <th>
                                        Standard
                                    </th>

                                    <th>
                                        Points
                                    </th>

                                </tr>

                            </thead>


                            <tbody>

                                @if (Model?.top10Performer != null)
                                {
                                    foreach (var student in Model.top10Performer)
                                    {
                                        <tr>

                                            <td>
                                                @student.InstRank
                                            </td>

                                            <td>
                                                @student.Student_Name
                                            </td>

                                            <td>
                                                @student.Standard
                                            </td>

                                            <td>
                                                @student.TotalPoints
                                            </td>

                                        </tr>
                                    }
                                }

                            </tbody>

                        </table>

                    </div>

                </div>

            </div>


            @* =====================================================
               STANDARD WISE TOP 3
               ===================================================== *@

            <div class="card card-report no-split">

                <div class="card-header">

                    Standard Wise Top 3 Performers

                </div>


                <div class="card-body p-0">

                    <div class="table-responsive">

                        <table class="table table-sm table-bordered mb-0">

                            <thead class="thead-light">

                                <tr>

                                    <th style="width:50px;">
                                        Rank
                                    </th>

                                    <th>
                                        Student Name
                                    </th>

                                    <th>
                                        Points
                                    </th>

                                </tr>

                            </thead>


                            <tbody>

                                @{
                                    var safePerformers =
                                        Model?.Top3StdPerformers
                                        ?? new List<HemFoundation.DTOs.TopStd3Performer>();
                                }


                                @foreach (var group in safePerformers.GroupBy(x => x.Standard))
                                {
                                    <tr class="group-header"
                                        style="background-color:#eee;">

                                        <td colspan="3">

                                            <strong>
                                                Standard: @group.Key
                                            </strong>

                                        </td>

                                    </tr>


                                    foreach (var student in group)
                                    {
                                        <tr>

                                            <td>
                                                @student.StdRank
                                            </td>

                                            <td>
                                                @student.Student_Name
                                            </td>

                                            <td>
                                                @student.TotalPoints
                                            </td>

                                        </tr>
                                    }
                                }

                            </tbody>

                        </table>

                    </div>

                </div>

            </div>

        </div>


        @* =========================================================
           TEACHER DETAILS
           ========================================================= *@

        <div class="container-fluid">

            <div class="card card-report no-split">

                <div class="card-header">

                    Certified Teacher Details

                </div>


                <div class="card-body p-0">

                    <div class="table-responsive">

                        <table class="table table-sm table-bordered mb-0">

                            <thead class="thead-light">

                                <tr>

                                    <th style="width:25%;">
                                        Teacher Name
                                    </th>

                                    <th style="width:15%;">
                                        Stats
                                    </th>

                                    <th style="width:10%;">
                                        Marks
                                    </th>

                                    <th style="width:50%;">
                                        Course Details
                                    </th>

                                </tr>

                            </thead>


                            <tbody>

                                @if (Model?.teacherCourseSummary != null)
                                {
                                    foreach (var teacher in Model.teacherCourseSummary)
                                    {
                                        <tr>

                                            <td>

                                                <strong>
                                                    @teacher.Teacher_Name
                                                </strong>

                                            </td>


                                            <td>

                                                <span class="text-success">
                                                    @teacher.NoOFCourseCompleted
                                                </span>

                                                |

                                                <span class="text-danger">
                                                    @teacher.NoofCoursePending
                                                </span>

                                            </td>


                                            <td>

                                                @teacher.TotalObtainedMarks

                                            </td>


                                            <td>

                                                @if (!string.IsNullOrEmpty(
                                                    teacher.CourseCompleted)
                                                    && teacher.CourseCompleted != "0")
                                                {
                                                    <div class="course-list">

                                                        <strong class="text-success">
                                                            Comp:
                                                        </strong>

                                                        @teacher.CourseCompleted

                                                    </div>
                                                }


                                                @if (!string.IsNullOrEmpty(
                                                    teacher.CoursePending)
                                                    && teacher.CoursePending != "0")
                                                {
                                                    <div class="course-list">

                                                        <strong class="text-danger">
                                                            Pend:
                                                        </strong>

                                                        @teacher.CoursePending

                                                    </div>
                                                }

                                            </td>

                                        </tr>
                                    }
                                }

                            </tbody>

                        </table>

                    </div>

                </div>

            </div>


            @* =====================================================
               CERTIFIED STUDENT DETAILS
               ===================================================== *@

            @if (Model?.studentsCertifiedStats != null
                && Model.studentsCertifiedStats.Count > 0)
            {

                <div class="card card-report no-split"
                     style="margin-top:20px;">

                    <div class="card-header">

                        Certified Student Details

                    </div>


                    <div class="card-body p-0">

                        <div class="table-responsive">

                            <table class="table table-sm table-bordered mb-0">

                                <thead class="thead-light">

                                    <tr>

                                        <th style="width:25%;">
                                            Student Name
                                        </th>

                                        <th style="width:15%;">
                                            Standard
                                        </th>

                                        <th style="width:10%;">
                                            Marks
                                        </th>

                                        <th style="width:50%;">
                                            Course Details
                                        </th>

                                    </tr>

                                </thead>


                                <tbody>

                                    @foreach (var student in Model.studentsCertifiedStats)
                                    {
                                        <tr>

                                            <td>

                                                <strong>
                                                    @student.Student_Name
                                                </strong>

                                            </td>


                                            <td>

                                                @student.Standard_

                                            </td>


                                            <td>

                                                @student.MarksObtain

                                            </td>


                                            <td>

                                                @if (!string.IsNullOrEmpty(
                                                    student.Courses_Completed)
                                                    && student.Courses_Completed != "0")
                                                {
                                                    <div class="course-list">

                                                        <strong class="text-success">
                                                            Comp:
                                                        </strong>

                                                        @student.Courses_Completed

                                                    </div>
                                                }

                                            </td>

                                        </tr>
                                    }

                                </tbody>

                            </table>

                        </div>

                    </div>

                </div>

            }

        </div>

    </div>


</body>

</html>