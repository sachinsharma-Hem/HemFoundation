            }


            /* =====================================================
                       DISPLAY
                       ===================================================== */

            .d-block {
                display: block !important;
            }


            /* =====================================================
                       CARD
                       ===================================================== */

            .card {
                position: relative;
                display: flex;
                flex-direction: column;
                min-width: 0;
                word-wrap: break-word;
                background-color: #fff;
                background-clip: border-box;
