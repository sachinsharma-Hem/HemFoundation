@model HemFoundation.DTOs.SchoolReportViewModel

@inject Microsoft.AspNetCore.Hosting.IWebHostEnvironment Environment

@{
    // =========================================================
    // PDF / NORMAL VIEW MODE
    // =========================================================

    bool isPdf = ViewData["IsPdf"] is bool value && value;

    Layout = isPdf
        ? null
        : "~/Views/Shared/Layouts/_TeacherLayout.cshtml";


    // =========================================================
    // RESPONSIVE / PDF COLUMN LOGIC
    // =========================================================

    string chartColumnClass = isPdf
        ? "col-6"
        : "col-12 col-md-6";

    string pdfRowStyle = isPdf
        ? "width:100%; display:block; overflow:hidden;"
        : "";

    string pdfColStyle = isPdf
        ? "width:50%; float:left; padding:5px;"
        : "";


    // =========================================================
    // LOGO PATH
    // =========================================================

    string logoPath = System.IO.Path.Combine(
        Environment.WebRootPath,
        "Content",
        "img",
        "hema-logo.png"
    );
}


@functions {

    // =========================================================
    // HELPER 1
    // SIMPLE BAR CHART
    // =========================================================

    public string GetChartImage(
        string labels,
        string data,
        string title)
    {
        string chartConfig =
            "{" +
                "type:'bar'," +

                "data:{" +

                    "labels:[" + labels + "]," +

                    "datasets:[{" +

                        "label:'" + title + "'," +

                        "data:[" + data + "]," +

                        "backgroundColor:[" +
                            "'#007bff'," +
                            "'#28a745'," +
                            "'#dc3545'," +
                            "'#17a2b8'," +
                            "'#ffc107'," +
                            "'#6c757d'" +
                        "]" +

                    "}]" +

                "}," +

                "options:{" +

                    "plugins:{" +

                        "datalabels:{" +
                            "anchor:'end'," +
                            "align:'top'," +
                            "color:'black'," +

                            "font:{" +
                                "weight:'bold'," +
                                "size:10" +
                            "}" +

                        "}" +

                    "}," +

                    "legend:{" +
                        "display:false" +
                    "}," +

                    "scales:{" +

                        "yAxes:[{" +

                            "ticks:{" +
                                "beginAtZero:true" +
                            "}" +

                        "}]" +

                    "}" +

                "}" +

            "}";


        return "https://quickchart.io/chart?width=500&height=300&c="
            + Uri.EscapeDataString(chartConfig);
    }


    // =========================================================
    // HELPER 2
    // PROJECT GROUPED BAR CHART
    // =========================================================

    public string GetProjectChartImage(
        string labels,
        string data1,
        string data2,
        string data3)
    {
        string chartConfig =
            "{" +

                "type:'bar'," +

                "data:{" +

                    "labels:[" + labels + "]," +

                    "datasets:[" +

                        "{" +
                            "label:'Individual PBL'," +
                            "data:[" + data1 + "]," +
                            "backgroundColor:'#28a745'" +
                        "}," +

                        "{" +
                            "label:'Family PBL'," +
                            "data:[" + data3 + "]," +
                            "backgroundColor:'#5E5C5C'" +
                        "}," +

                        "{" +
                            "label:'Group PBL'," +
                            "data:[" + data2 + "]," +
                            "backgroundColor:'#007bff'" +
                        "}" +

                    "]" +

                "}," +

                "options:{" +

                    "plugins:{" +

                        "datalabels:{" +
                            "display:true," +
                            "color:'white'," +

                            "font:{" +
                                "weight:'bold'" +
                            "}" +

                        "}" +

                    "}," +

                    "legend:{" +
                        "display:true" +
                    "}," +

                    "scales:{" +

                        "yAxes:[{" +

                            "ticks:{" +
                                "beginAtZero:true" +
                            "}" +

                        "}]" +

                    "}" +

                "}" +

            "}";


        return "https://quickchart.io/chart?width=500&height=300&c="
            + Uri.EscapeDataString(chartConfig);
    }
}


<!DOCTYPE html>

<html>

<head>

    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>Institute Report</title>


    @* =========================================================
       NORMAL BROWSER MODE
       LOAD BOOTSTRAP / SITE CSS
       ========================================================= *@

    @if (!isPdf)
    {
        <link rel="stylesheet"
              href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

        <link rel="stylesheet"
              href="~/css/site.css" />
    }


    <style>

            /* =====================================================
                       GLOBAL
                       ===================================================== */

            * {
                box-sizing: border-box;
            }


            html,
            body {
                margin: 0;
                padding: 0;
                width: 100%;
