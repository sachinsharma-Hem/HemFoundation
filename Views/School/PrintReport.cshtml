            /* =====================================================
                       TABLE
                       ===================================================== */

            .table-responsive {
                width: 100%;
                overflow: visible;
            }


            table {
                width: 100%;
                margin-bottom: 1rem;
                color: #212529;
                border-collapse: collapse !important;
                border-spacing: 0;
            }


            th,
            td {
                padding: 0.5rem;
                vertical-align: top;
                border-top: 1px solid #dee2e6;
                text-align: left;
            }


            thead th {
                vertical-align: bottom;
                border-bottom: 2px solid #dee2e6;
