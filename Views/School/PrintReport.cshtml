                       TABLE STRIPED
                       ===================================================== */

            .table-striped tbody tr:nth-of-type(odd) {
                background-color: rgba(0, 0, 0, 0.03);
            }


            /* =====================================================
                       TABLE SMALL
                       ===================================================== */

            .table-sm th,
            .table-sm td {
                padding: 0.3rem;
            }


            /* =====================================================
                       TABLE HEADER
                       ===================================================== */

            .thead-light th {
                color: #495057;
                background-color: #e9ecef;
                border-color: #dee2e6;
            }


            /* =====================================================
                       IMAGE
                       ===================================================== */

            .img-report {
                max-width: 100%;
                height: auto;
            }


            /* =====================================================
                       HEADER
                       ===================================================== */

            .header-section {
                text-align: center;
                margin-bottom: 20px;
                border-bottom: 2px solid #007bff;
                padding-bottom: 10px;
            }


            /* =====================================================
                       COURSE LIST
                       ===================================================== */

            .course-list {
                font-size: 10px;
                color: #555;
                margin-top: 4px;
            }


            /* =====================================================
                       PAGE BREAK
                       ===================================================== */

            .page-break {
                page-break-after: always;
                display: block;
                clear: both;
            }


            .no-split {
                page-break-inside: avoid !important;
                margin-bottom: 20px;
            }


            .keep-together {
                page-break-inside: avoid;
                margin-bottom: 30px;
                display: block;
            }


            /* =====================================================
                       HEADINGS
                       ===================================================== */

            h4 {
                display: block;
                font-size: 18px;
                font-weight: 500;
                margin-top: 0;
                margin-bottom: 1rem;
                line-height: 1.2;
            }


            /* =====================================================
                       NORMAL BROWSER DOWNLOAD BUTTON
                       ===================================================== */

            .no-print {
                display: block;
            }

    </style>


