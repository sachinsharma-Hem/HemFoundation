<script type="text/javascript">

    $(document).ready(function() {
        $("#standard").change(function() {
            var standard = $(this).val();

            if (standard !== "") {
                $.ajax({
                    type: "POST",
                    url: "/School/GetMainCourses",
                    data: { Standard: standard },
                    success: function(response) {
                        var dropdown = $("#MainCourseID");
                        dropdown.empty();
                        dropdown.append('<option value="">----Select Course----</option>');

                        $.each(response, function(index, item) {
                            dropdown.append('<option value="' + item.id + '">' + item.name + '</option>');
                        });
                    }
                });
            } else {
                $("#MainCourseID").empty().append('<option value="">----Select Course----</option>');
            }
        });
    });
</script>

<script>
    function getVal() {
        debugger;
        var selectedCourse = document.getElementById("MainCourseID").value;

        // Perform AJAX request
        $.ajax({
            url: '@Url.Action("GetStatus", "School")',
            type: 'GET',
            data: { course: selectedCourse },
            success: function(data) {
                // Update status fields with the received data
                $('#idgroupselectionstatus').val(data.groupSelectionStatus);
                $('#idimageuploadstatus').val(data.imageUploadStatus);
                $('#idvideouploadstatus').val(data.videoUploadStatus);
                $('#idprojectexplanationstatus').val(data.projectexplanationstatus);

            },
            error: function() {
                alert("Error fetching status.");
            }
        });
    }

</script>
<script>
    function Export() {
        $.ajax({
            type: "POST",
            url: '@Url.Action("ExportSubmissionStatus", "School")',
            xhrFields: {
                responseType: 'blob' // Essential for receiving binary files over AJAX
            },
            success: function(response) {
                var blob = new Blob([response], { type: "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet" });
                var url = window.URL.createObjectURL(blob);
                var $anchor = $('<a />').attr({
                    'href': url,
                    'download': 'SubmissionStatusReport.xlsx'
                }).appendTo('body');

                $anchor[0].click();

                setTimeout(function() {
                    window.URL.revokeObjectURL(url);
                    $anchor.remove();
                }, 100);
            },
            error: function(err) {
                console.error('Error exporting data:', err);
                alert('Failed to export submission status report.');
            }
        });
    }
</script>

