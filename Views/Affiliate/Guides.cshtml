@{
    ViewData["Title"] = "Training & PBL Guides";
    Layout = "~/Views/Shared/Layouts/_TeacherLayout.cshtml"; 
}

<div class="container-fluid py-4">
    <div class="custom-page-header mb-4 p-4 rounded-4 shadow-sm text-white position-relative overflow-hidden">
        <div class="header-decoration position-absolute opacity-25">
            <i class="bi bi-play-btn-fill" style="font-size: 15rem; top: -50px; right: -20px; position: absolute;"></i>
        </div>
        <div class="position-relative z-1">
            <h2 class="fw-bolder mb-1"><i class="bi bi-book-half me-2 fs-2"></i> Training & PBL Resource Center</h2>
            <p class="mb-0 opacity-75 small fs-6">Access official demo videos, presentations, and Project-Based Learning (PBL) materials.</p>
        </div>
    </div>

    <ul class="nav nav-pills nav-fill gap-2 p-2 rounded-pill mb-4 shadow-sm glass-nav-pills" role="tablist">
        <li class="nav-item">
            <button class="nav-link active rounded-pill fw-bold py-2 fs-5" data-bs-toggle="tab" data-bs-target="#tabDemo" type="button">
                <i class="bi bi-camera-video me-2"></i> Demo Materials
            </button>
        </li>
        <li class="nav-item">
            <button class="nav-link rounded-pill fw-bold py-2 fs-5" data-bs-toggle="tab" data-bs-target="#tabPBL" type="button">
                <i class="bi bi-diagram-3 me-2"></i> PBL Materials
            </button>
        </li>
    </ul>

    <div class="tab-content">
        <div class="tab-pane fade show active" id="tabDemo">
            <div id="demoContainer">
                <div class="text-center py-5"><div class="spinner-border text-primary" role="status"></div><p class="mt-2 text-muted fw-bold">Loading Demo Materials...</p></div>
            </div>
        </div>

        <div class="tab-pane fade" id="tabPBL">
            <div id="pblContainer">
                <div class="text-center py-5"><div class="spinner-border text-success" role="status"></div><p class="mt-2 text-muted fw-bold">Loading PBL Materials...</p></div>
            </div>
        </div>
    </div>
</div>

<!-- LOCAL VIDEO PLAYER MODAL -->
<div class="modal fade" id="videoModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content rounded-4 border-0 shadow-lg bg-dark text-white">
            <div class="modal-header border-bottom-0 pb-0">
                <h5 class="fw-bold mb-0" id="videoModalTitle">Video Title</h5>
                <button type="button" class="btn-close btn-close-white shadow-none" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body p-4 text-center">
                <video id="guideVideoPlayer" controls class="w-100 rounded-3 shadow" style="max-height: 500px; background: #000;">
                    <source src="" type="video/mp4">
                    Your browser does not support the video tag.
                </video>
            </div>
        </div>
    </div>
</div>

<style>
    .custom-page-header { background: linear-gradient(135deg, #0d6efd 0%, #0dcaf0 100%); }
    .glass-nav-pills { background: rgba(240, 242, 245, 0.8); backdrop-filter: blur(10px); border: 1px solid rgba(0,0,0,0.05); }
    .glass-nav-pills .nav-link { color: #6c757d; transition: all 0.3s; }
    .glass-nav-pills .nav-link.active { background: #0d6efd; color: #fff !important; box-shadow: 0 4px 10px rgba(13, 110, 253, 0.3); }
    
    .resource-card { transition: all 0.3s cubic-bezier(0.165, 0.84, 0.44, 1); border: 1px solid #dee2e6; border-radius: 1rem; }
    .resource-card:hover { transform: translateY(-5px); box-shadow: 0 10px 20px rgba(0,0,0,0.1) !important; border-color: #0d6efd; }
    .icon-box { width: 60px; height: 60px; display: flex; align-items: center; justify-content: center; border-radius: 1rem; font-size: 1.8rem; }
</style>

@section Scripts {
    <script>
        $(document).ready(function () {
            loadGuides();

            $('#videoModal').on('hidden.bs.modal', function () {
                let player = document.getElementById('guideVideoPlayer');
                player.pause();
                player.src = "";
            });
        });

        function loadGuides() {
            $.get('/api/guide/list', function (res) {
                if (res.success) {
                    let demoGuides = res.data.filter(g => g.mainCategory === 'Demo');
                    let pblGuides = res.data.filter(g => g.mainCategory === 'PBL');

                    renderSections('#demoContainer', groupByCategory(demoGuides), 'primary');
                    renderSections('#pblContainer', groupByCategory(pblGuides), 'success');
                }
            });
        }

        function groupByCategory(dataArray) {
            let grouped = {};
            dataArray.forEach(item => {
                if (!grouped[item.subCategory]) grouped[item.subCategory] = [];
                grouped[item.subCategory].push(item);
            });
            return grouped;
        }

        function renderSections(containerId, groupedData, themeColor) {
            let html = '';
            
            if (Object.keys(groupedData).length === 0) {
                $(containerId).html(`<div class="text-center py-5 text-muted"><i class="bi bi-inbox fs-1"></i><h5 class="fw-bold mt-2">No resources available</h5></div>`);
                return;
            }

            for (const [subCategory, items] of Object.entries(groupedData)) {
                html += `<div class="mb-5">
                            <h4 class="fw-bolder text-${themeColor} mb-3 border-bottom border-${themeColor} pb-2 d-inline-block border-3">
                                ${subCategory}
                            </h4>
                            <div class="row row-cols-1 row-cols-md-2 row-cols-xl-3 g-4 mt-1">`;
                
                items.forEach(item => {
                    let isVideoType = item.fileType === 'Video' || item.fileType === 'VideoLink';
                    let iconBg = isVideoType ? `bg-${themeColor}-subtle text-${themeColor}` : 'bg-danger-subtle text-danger';
                    let iconClass = isVideoType ? 'bi-play-circle-fill' : (item.fileUrl.includes('.ppt') ? 'bi-file-earmark-slides-fill' : 'bi-file-earmark-pdf-fill');
                    
                    let actionBtn = '';
                    // Dynamic button rendering based on FileType
                    if (item.fileType === 'Video') {
                        actionBtn = `<button class="btn btn-${themeColor} w-100 rounded-pill fw-bold shadow-sm" onclick="playVideo('${item.title}', '${item.fileUrl}')"><i class="bi bi-play-fill me-1"></i> Watch Locally</button>`;
                    } else if (item.fileType === 'VideoLink') {
                        // Agar YouTube link ya url hai toh naye tab me open karega
                        actionBtn = `<a href="${item.fileUrl}" target="_blank" class="btn btn-outline-${themeColor} border-2 w-100 rounded-pill fw-bold shadow-sm"><i class="bi bi-youtube me-1 text-danger"></i> Watch Externally</a>`;
                    } else {
                        actionBtn = `<a href="${item.fileUrl}" target="_blank" class="btn btn-danger w-100 rounded-pill fw-bold shadow-sm"><i class="bi bi-download me-1"></i> Download / View</a>`;
                    }

                    html += `
                        <div class="col">
                            <div class="card resource-card h-100 bg-white p-3">
                                <div class="d-flex align-items-center mb-3">
                                    <div class="icon-box ${iconBg} me-3 shadow-sm">
                                        <i class="bi ${iconClass}"></i>
                                    </div>
                                    <div>
                                        <h6 class="fw-bolder text-dark mb-1 text-break">${item.title}</h6>
                                        <span class="badge bg-light text-secondary border">${item.fileType}</span>
                                    </div>
                                </div>
                                <div class="mt-auto pt-2">
                                    ${actionBtn}
                                </div>
                            </div>
                        </div>`;
                });

                html += `</div></div>`;
            }
            $(containerId).html(html);
        }

        // Open Video Modal dynamically (Only for local video files)
        function playVideo(title, url) {
            $('#videoModalTitle').text(title);
            let player = document.getElementById('guideVideoPlayer');
            player.src = url;
            $('#videoModal').modal('show');
            player.play();
        }
    </script>
}