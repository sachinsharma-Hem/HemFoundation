@{
    ViewData["Title"] = "Coordinator Incentive Dashboard";
    Layout = "~/Views/Shared/Layouts/_TeacherLayout.cshtml";
}

<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.3/dist/chart.umd.min.js"></script>
<link href="~/css/insentive.css" rel="stylesheet" />
<link href="~/css/affiliate-incentive.css" rel="stylesheet" asp-append-version="true" />

<style>
    .coordinator-dashboard {
        position: relative;
    }

    .ai-loader {
        position: absolute;
        inset: 0;
        z-index: 50;
        display: flex;
        justify-content: center;
        align-items: flex-start;
        padding-top: 140px;
        background: rgba(255, 255, 255, .72);
        -webkit-backdrop-filter: blur(3px);
        backdrop-filter: blur(3px);
        opacity: 0;
        visibility: hidden;
        pointer-events: none;
        transition: opacity .25s ease, visibility .25s ease;
    }

        .ai-loader.is-active {
            opacity: 1;
            visibility: visible;
            pointer-events: all;
        }

    .ai-loader-card {
        position: sticky;
        top: 30vh;
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 16px;
        padding: 28px 40px;
        border-radius: 20px;
        background: #fff;
        box-shadow: 0 18px 48px rgba(16, 24, 40, .16);
    }

    .ai-spinner {
        position: relative;
        width: 64px;
        height: 64px;
    }

        .ai-spinner::before, .ai-spinner::after {
            content: "";
            position: absolute;
            inset: 0;
            border-radius: 50%;
        }

        .ai-spinner::before {
            border: 5px solid #e6f5ef;
        }

        .ai-spinner::after {
            border: 5px solid transparent;
            border-top-color: #10b981;
            border-right-color: #3b82f6;
            animation: aiSpin .9s cubic-bezier(.5, .1, .5, .9) infinite;
        }

    .ai-spinner-dot {
        position: absolute;
        inset: 22px;
        border-radius: 50%;
        background: linear-gradient(135deg, #10b981, #3b82f6);
        animation: aiPulse 1.4s ease-in-out infinite;
    }
    @@keyframes aiSpin {
        to {
            transform: rotate(360deg);
        }
    }
    @@keyframes aiPulse {
        0%, 100% {
            transform: scale(.7);
            opacity: .6;
        }

        50% {
            transform: scale(1);
            opacity: 1;
        }
    }
</style>

<div class="coordinator-dashboard">
    <div class="dashboard-header">
        <div class="header-left">
            <div class="dashboard-eyebrow"><span class="live-dot"></span> COORDINATOR PERFORMANCE</div>
            <h1>Incentive Dashboard</h1>
            <p>Track your students, schools, projects and monthly incentive performance.</p>
        </div>
        <div class="header-right">
            <button type="button" class="period-btn">
                <i class="bi bi-calendar3"></i> <span id="headerMonthLabel">Loading...</span>
            </button>
            <div class="total-incentive-box">
                <div class="total-icon"><i class="bi bi-wallet2"></i></div>
                <div class="total-info">
                    <span>Total Incentive</span>
                    <strong id="headerTotalIncentive">₹0</strong>
                </div>
                <div class="growth-badge"><i class="bi bi-arrow-up"></i> <span id="headerGrowthPercentage">0%</span></div>
            </div>
        </div>
    </div>

    <!-- Lifetime summary: filled from /api/affiliate-incentive/my -->
    <div class="afi">
        <div id="afiError" class="afi-error" hidden>
            <span><i class="bi bi-exclamation-triangle me-1"></i> <span id="afiErrorText"></span></span>
            <button type="button" class="afi-btn afi-btn-sm" id="afiRetry"><i class="bi bi-arrow-clockwise"></i> Try again</button>
        </div>

        <div class="afi-summary">
            <div class="afi-stat is-hero">
                <div class="afi-stat-top">
                    <span class="afi-stat-icon"><i class="bi bi-trophy-fill"></i></span>
                    <span class="afi-stat-label">Total Incentive Earned Till Date</span>
                </div>
                <div class="afi-stat-value" id="afiLifetime"><span class="afi-skeleton"></span></div>
                <div class="afi-stat-sub" id="afiLifetimeSub">All months added together</div>
            </div>
            <div class="afi-stat is-green">
                <div class="afi-stat-top">
                    <span class="afi-stat-icon"><i class="bi bi-calendar-check"></i></span>
                    <span class="afi-stat-label">Current Month <span id="afiCurrentLabel"></span></span>
                </div>
                <div class="afi-stat-value" id="afiCurrent"><span class="afi-skeleton"></span></div>
                <div class="afi-stat-sub" id="afiCurrentSub">&nbsp;</div>
            </div>
            <div class="afi-stat">
                <div class="afi-stat-top">
                    <span class="afi-stat-icon"><i class="bi bi-calendar-minus"></i></span>
                    <span class="afi-stat-label">Previous Month <span id="afiPreviousLabel"></span></span>
                </div>
                <div class="afi-stat-value" id="afiPrevious"><span class="afi-skeleton"></span></div>
                <div class="afi-stat-sub">Closed month</div>
            </div>
            <div class="afi-stat is-purple">
                <div class="afi-stat-top">
                    <span class="afi-stat-icon"><i class="bi bi-graph-up-arrow"></i></span>
                    <span class="afi-stat-label">This Year <span id="afiYearLabel"></span></span>
                </div>
                <div class="afi-stat-value" id="afiYear"><span class="afi-skeleton"></span></div>
                <div class="afi-stat-sub" id="afiBest">&nbsp;</div>
            </div>
        </div>
    </div>

    <!-- 1. Top KPI Grid mein Evaluated Projects ka naya card add karein -->
    <div class="kpi-grid" style="grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));">
        <div class="kpi-card kpi-blue">
            <div class="kpi-card-top">
                <div class="kpi-icon"><i class="bi bi-people-fill"></i></div>
                <span class="kpi-change"><i class="bi bi-arrow-up"></i> Active</span>
            </div>
            <div class="kpi-title">Eligible Active Students</div>
            <div class="kpi-number"><span class="counter" id="lblActiveStudents">0</span></div>
            <div class="kpi-bottom"><span>Rate: ₹5 / student</span><strong id="lblStudentIncentive">₹0</strong></div>
            <div class="kpi-progress"><span style="width:72%;"></span></div>
        </div>

        <div class="kpi-card kpi-green">
            <div class="kpi-card-top">
                <div class="kpi-icon"><i class="bi bi-building"></i></div>
                <span class="kpi-change"><i class="bi bi-arrow-up"></i> Active</span>
            </div>
            <div class="kpi-title">Fully Active Schools</div>
            <div class="kpi-number"><span class="counter" id="lblActiveSchools">0</span></div>
            <div class="kpi-bottom"><span>Rate: ₹100 / school</span><strong id="lblSchoolIncentive">₹0</strong></div>
            <div class="kpi-progress"><span style="width:5%;"></span></div>
        </div>

        <div class="kpi-card kpi-emerald">
            <div class="kpi-card-top">
                <div class="kpi-icon"><i class="bi bi-person-badge-fill"></i></div>
                <span class="kpi-change"><i class="bi bi-arrow-up"></i> Active</span>
            </div>
            <div class="kpi-title">Active Teachers</div>
            <div class="kpi-number"><span class="counter" id="lblActiveTeachers">0</span></div>
            <div class="kpi-bottom"><span>Rate: ₹2 / teacher</span><strong id="lblTeacherIncentive">₹0</strong></div>
            <div class="kpi-progress"><span style="width:66%;"></span></div>
        </div>

        <div class="kpi-card" style="background: #e0f2fe; color: #0369a1;">
            <div class="kpi-card-top">
                <div class="kpi-icon" style="background: #bae6fd; color: #0284c7;"><i class="bi bi-award-fill"></i></div>
                <span class="kpi-change" style="color: #0369a1;"><i class="bi bi-arrow-up"></i> Certified</span>
            </div>
            <div class="kpi-title" style="color: #0369a1;">Value Certifications</div>
            <div class="kpi-number"><span class="counter" id="lblTotalCertificates">0</span></div>
            <div class="kpi-bottom"><span style="color: #0369a1;">Rate: ₹10 / cert</span><strong id="lblCertificateIncentive" style="color: #0369a1;">₹0</strong></div>
            <div class="kpi-progress"><span style="width:85%; background: #0284c7;"></span></div>
        </div>

        <div class="kpi-card" style="background: #fdf2f8; color: #db2777;">
            <div class="kpi-card-top">
                <div class="kpi-icon" style="background: #fce7f3; color: #ec4899;"><i class="bi bi-journal-check"></i></div>
                <span class="kpi-change" style="color: #db2777;"><i class="bi bi-star-fill"></i> Projects</span>
            </div>
            <div class="kpi-title" style="color: #db2777;">Evaluated Projects</div>
            <div class="kpi-number"><span class="counter" id="lblTotalEvaluatedProjects">0</span></div>
            <div class="kpi-bottom"><span style="color: #db2777;">Dynamic Rates</span><strong id="lblProjectIncentive" style="color: #db2777;">₹0</strong></div>
            <div class="kpi-progress"><span style="width:90%; background: #ec4899;"></span></div>
        </div>

        <div class="kpi-card kpi-orange">
            <div class="kpi-card-top">
                <div class="kpi-icon"><i class="bi bi-wallet-fill"></i></div>
                <span class="kpi-change neutral"><i class="bi bi-dash"></i> Total</span>
            </div>
            <div class="kpi-title">Calculated Incentive</div>
            <div class="kpi-number"><strong id="lblSummaryTotal" style="font-size: 1.8rem;">₹0</strong></div>
            <div class="kpi-bottom"><span>Status</span><strong>Verified</strong></div>
            <div class="kpi-progress"><span style="width:100%;"></span></div>
        </div>
    </div>
    <div class="dashboard-card monthly-report">
        <div class="report-header">
            <div>
                <div class="report-label"><i class="bi bi-bar-chart-line-fill"></i> PERFORMANCE REPORT</div>
                <h2>Monthly Incentive Report</h2>
                <p>Compare current and previous month performance.</p>
            </div>
            <div class="month-selector">
                <label><i class="bi bi-calendar3"></i> Select Month</label>
                <select id="reportMonth"></select>
            </div>
        </div>

        <!-- Comparison Summary -->
        <div class="report-comparison">
            <div class="comparison-left">
                <span class="comparison-title">Incentive Earned</span>
                <div class="comparison-money">
                    <div class="old-money">
                        <small id="previousMonthLabel">Previous Month</small>
                        <strong id="previousIncentive">₹0</strong>
                    </div>
                    <div class="comparison-arrow"><i class="bi bi-arrow-right"></i></div>
                    <div class="new-money">
                        <small id="selectedMonthLabel">Current Month</small>
                        <strong id="currentIncentive">₹0</strong>
                    </div>
                </div>
            </div>
            <div class="comparison-result">
                <div class="result-icon" id="comparisonIcon"><i class="bi bi-arrow-up"></i></div>
                <div>
                    <strong id="incentiveDifference">+₹0</strong>
                    <span id="incentivePercentage">0% increase</span>
                </div>
            </div>
        </div>

        <!-- History & Calculation Subgrid -->
        <div class="report-content-grid">
            <div class="report-panel">
                <div class="panel-header">
                    <div>
                        <strong>Incentive Breakdown</strong>
                        <span>Calculation based on active logs & certificates</span>
                    </div>
                    <div class="six-month-total">
                        <span>Total Calculation</span>
                        <strong id="calcPanelTotal">₹0</strong>
                    </div>
                </div>
                <!-- 2. Incentive Breakdown List mein Evaluated Projects ka row add karein -->
                <div class="calculation-list" style="margin-top: 15px;">
                    <div class="calculation-item">
                        <div><strong>Active Students</strong><small id="subTextStudents">0 × ₹5</small></div>
                        <b id="calcStudents">₹0</b>
                    </div>
                    <div class="calculation-item">
                        <div><strong>Active Schools</strong><small id="subTextSchools">0 × ₹100</small></div>
                        <b id="calcSchools">₹0</b>
                    </div>
                    <div class="calculation-item">
                        <div><strong>Active Teachers</strong><small id="subTextTeachers">0 × ₹2</small></div>
                        <b id="calcTeachers">₹0</b>
                    </div>
                    <div class="calculation-item">
                        <div><strong>Value Certifications</strong><small id="subTextCertificates">0 × ₹10</small></div>
                        <b id="calcCertificates">₹0</b>
                    </div>
                    <div class="calculation-item">
                        <div><strong>Evaluated Projects</strong><small id="subTextProjects">Green(5), Orange(3), Blue(2), Yellow(1)</small></div>
                        <b id="calcProjects">₹0</b>
                    </div>
                </div>
                <div class="calculation-total">
                    <span>Total Incentive</span>
                    <strong id="calculationTotal">₹0</strong>
                </div>
            </div>

            <div class="report-panel">
                <div class="panel-header">
                    <div>
                        <strong>Project Completion Overview</strong>
                        <span>Green vs Orange Projects</span>
                    </div>
                    <div class="calculation-header-icon"><i class="bi bi-bar-chart-fill"></i></div>
                </div>
                <div style="position: relative; height: 230px; width: 100%; margin-top: 15px;">
                    <canvas id="projectCompletionChart"></canvas>
                </div>
            </div>
        </div>
    </div>

    <!-- Month-wise incentive history -->
    <div class="afi">
        <div class="afi-panel" id="afiHistoryPanel">
            <div class="afi-panel-head">
                <div>
                    <h2 class="afi-panel-title"><i class="bi bi-table"></i> Month-wise Incentive</h2>
                    <p class="afi-panel-sub">How much you earned in each month. Click View to see that month's full breakdown above.</p>
                </div>
                <div class="afi-filters">
                    <div class="afi-field">
                        <label for="afiFilterYear">Year</label>
                        <select id="afiFilterYear" class="afi-input"><option value="">All years</option></select>
                    </div>
                    <div class="afi-field">
                        <label for="afiFilterMonth">Month</label>
                        <select id="afiFilterMonth" class="afi-input">
                            <option value="">All months</option>
                            <option value="1">January</option><option value="2">February</option><option value="3">March</option>
                            <option value="4">April</option><option value="5">May</option><option value="6">June</option>
                            <option value="7">July</option><option value="8">August</option><option value="9">September</option>
                            <option value="10">October</option><option value="11">November</option><option value="12">December</option>
                        </select>
                    </div>
                </div>
            </div>

            <div class="afi-table-wrap">
                <table class="afi-table">
                    <thead>
                        <tr>
                            <th>Month</th>
                            <th>Eligible activity</th>
                            <th class="is-num">Incentive earned</th>
                            <th>Status</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody id="afiHistoryRows">
                        <tr><td colspan="5"><div class="afi-empty"><span class="afi-skeleton" style="width:160px"></span></div></td></tr>
                    </tbody>
                </table>
            </div>
            <div class="afi-pager"><span id="afiHistoryTotal"></span></div>
        </div>
    </div>
</div>
<script>
    // One request (/api/affiliate-incentive/my) feeds the whole page: the
    // lifetime summary, the selected month's breakdown and the month-wise
    // table. All amounts come from the server; nothing is calculated here.
    document.addEventListener("DOMContentLoaded", function () {

        function getAuthToken() {
            return localStorage.getItem("jwt_token") || sessionStorage.getItem("jwt_token") || "";
        }

        function safeNumber(value) {
            const n = Number(value);
            return Number.isFinite(n) ? n : 0;
        }

        function formatCurrency(value) {
            return "₹" + safeNumber(value).toLocaleString("en-IN");
        }

        function formatNumber(value) {
            return safeNumber(value).toLocaleString("en-IN");
        }

        function safeSetText(id, value) {
            const element = document.getElementById(id);
            if (element) element.textContent = value;
        }

        function esc(value) {
            return String(value == null ? "" : value).replace(/[&<>"']/g, function (c) {
                return { "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" }[c];
            });
        }

        const monthSelect = document.getElementById("reportMonth");
        const yearFilter = document.getElementById("afiFilterYear");
        const monthFilter = document.getElementById("afiFilterMonth");
        if (!monthSelect) return;

        let months = [];        // newest first, as sent by the server
        let chartInstance = null;

        function drawProjectChart(counts) {
            const canvas = document.getElementById("projectCompletionChart");
            if (!canvas || typeof Chart === "undefined") return;

            const values = [counts.green, counts.orange, counts.blue, counts.yellow, counts.red].map(safeNumber);

            if (!chartInstance) {
                chartInstance = new Chart(canvas, {
                    type: "bar",
                    data: {
                        labels: ["Green", "Orange", "Blue", "Yellow", "Red"],
                        datasets: [{
                            data: values,
                            backgroundColor: ["#10b981", "#f59e0b", "#3b82f6", "#eab308", "#ef4444"],
                            borderRadius: 6,
                            barThickness: 30
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        plugins: { legend: { display: false } },
                        scales: { y: { beginAtZero: true, ticks: { precision: 0 } } }
                    }
                });
            } else {
                chartInstance.data.datasets[0].data = values;
                chartInstance.update();
            }
        }

        // ---- Selected month: the existing breakdown section ----
        function renderMonth(key) {
            const index = months.findIndex(m => m.key === key);
            if (index < 0) return;

            const m = months[index];
            const previous = months[index + 1] || null;          // list is newest first
            const previousDate = new Date(m.year, m.month - 2, 1);
            const previousLabel = previous
                ? previous.label
                : previousDate.toLocaleString("en-IN", { month: "long", year: "numeric" });

            const currentTotal = safeNumber(m.totalIncentive);
            const previousTotal = previous ? safeNumber(previous.totalIncentive) : 0;
            const c = m.projectCounts || {};

            safeSetText("headerMonthLabel", m.label);
            safeSetText("selectedMonthLabel", m.label);
            safeSetText("previousMonthLabel", previousLabel);

            safeSetText("lblTotalEvaluatedProjects", formatNumber(m.evaluatedProjects));
            safeSetText("lblProjectIncentive", formatCurrency(m.projectIncentive));
            safeSetText("subTextProjects", `G:${safeNumber(c.green)}, O:${safeNumber(c.orange)}, B:${safeNumber(c.blue)}, Y:${safeNumber(c.yellow)}`);
            safeSetText("calcProjects", formatCurrency(m.projectIncentive));

            safeSetText("headerTotalIncentive", formatCurrency(currentTotal));
            safeSetText("lblActiveStudents", formatNumber(m.activeStudents));
            safeSetText("lblStudentIncentive", formatCurrency(m.studentIncentive));
            safeSetText("subTextStudents", `${safeNumber(m.activeStudents)} × ₹5`);
            safeSetText("calcStudents", formatCurrency(m.studentIncentive));

            safeSetText("lblActiveSchools", formatNumber(m.activeSchools));
            safeSetText("lblSchoolIncentive", formatCurrency(m.schoolIncentive));
            safeSetText("subTextSchools", `${safeNumber(m.activeSchools)} × ₹100`);
            safeSetText("calcSchools", formatCurrency(m.schoolIncentive));

            safeSetText("lblActiveTeachers", formatNumber(m.activeTeachers));
            safeSetText("lblTeacherIncentive", formatCurrency(m.teacherIncentive));
            safeSetText("subTextTeachers", `${safeNumber(m.activeTeachers)} × ₹2`);
            safeSetText("calcTeachers", formatCurrency(m.teacherIncentive));

            safeSetText("lblTotalCertificates", formatNumber(m.totalCertificates));
            safeSetText("lblCertificateIncentive", formatCurrency(m.certificateIncentive));
            safeSetText("subTextCertificates", `${safeNumber(m.totalCertificates)} × ₹10`);
            safeSetText("calcCertificates", formatCurrency(m.certificateIncentive));

            safeSetText("lblSummaryTotal", formatCurrency(currentTotal));
            safeSetText("currentIncentive", formatCurrency(currentTotal));
            safeSetText("calculationTotal", formatCurrency(currentTotal));
            safeSetText("calcPanelTotal", formatCurrency(currentTotal));
            safeSetText("previousIncentive", formatCurrency(previousTotal));

            drawProjectChart(c);

            const difference = currentTotal - previousTotal;
            let percentage = 0;
            if (previousTotal > 0) percentage = (Math.abs(difference) / previousTotal * 100).toFixed(1);
            else if (currentTotal > 0) percentage = "100";

            const icon = document.getElementById("comparisonIcon");

            if (difference > 0) {
                safeSetText("incentiveDifference", "+" + formatCurrency(difference));
                safeSetText("incentivePercentage", `${percentage}% increase`);
                safeSetText("headerGrowthPercentage", `${percentage}%`);
                if (icon) icon.innerHTML = '<i class="bi bi-arrow-up"></i>';
            } else if (difference < 0) {
                safeSetText("incentiveDifference", "-" + formatCurrency(Math.abs(difference)));
                safeSetText("incentivePercentage", `${percentage}% decrease`);
                safeSetText("headerGrowthPercentage", `-${percentage}%`);
                if (icon) icon.innerHTML = '<i class="bi bi-arrow-down"></i>';
            } else {
                safeSetText("incentiveDifference", "₹0");
                safeSetText("incentivePercentage", "0% change");
                safeSetText("headerGrowthPercentage", "0%");
                if (icon) icon.innerHTML = '<i class="bi bi-dash"></i>';
            }

            document.querySelectorAll("#afiHistoryRows tr").forEach(function (row) {
                row.classList.toggle("is-selected", row.getAttribute("data-key") === key);
            });
        }

        // ---- Lifetime summary cards ----
        function renderSummary(s) {
            safeSetText("afiLifetime", formatCurrency(s.lifetimeIncentive));
            safeSetText("afiLifetimeSub", s.firstMonthLabel
                ? `Across ${s.monthsCounted} month${s.monthsCounted === 1 ? "" : "s"}, since ${s.firstMonthLabel}`
                : "All months added together");

            safeSetText("afiCurrentLabel", `(${s.currentMonthLabel})`);
            safeSetText("afiCurrent", formatCurrency(s.currentMonthIncentive));
            safeSetText("afiPreviousLabel", `(${s.previousMonthLabel})`);
            safeSetText("afiPrevious", formatCurrency(s.previousMonthIncentive));
            safeSetText("afiYearLabel", `(${s.thisYear})`);
            safeSetText("afiYear", formatCurrency(s.thisYearIncentive));
            safeSetText("afiBest", s.bestMonthLabel
                ? `Best month: ${s.bestMonthLabel} (${formatCurrency(s.bestMonthIncentive)})`
                : "No incentive earned yet");

            const diff = safeNumber(s.currentMonthIncentive) - safeNumber(s.previousMonthIncentive);
            const sub = document.getElementById("afiCurrentSub");
            if (sub) {
                sub.innerHTML = diff === 0
                    ? "Same as last month so far"
                    : `<span class="${diff > 0 ? "afi-up" : "afi-down"}">${diff > 0 ? "+" : "-"}${formatCurrency(Math.abs(diff))}</span> vs last month, month in progress`;
            }
        }

        // ---- Month-wise table ----
        function renderHistory() {
            const year = yearFilter.value ? Number(yearFilter.value) : 0;
            const month = monthFilter.value ? Number(monthFilter.value) : 0;
            const rows = months.filter(m => (!year || m.year === year) && (!month || m.month === month));
            const body = document.getElementById("afiHistoryRows");

            if (!rows.length) {
                body.innerHTML = '<tr><td colspan="5"><div class="afi-empty"><i class="bi bi-inbox"></i>No months match this filter.</div></td></tr>';
                safeSetText("afiHistoryTotal", "");
                return;
            }

            body.innerHTML = rows.map(function (m) {
                return `<tr data-key="${esc(m.key)}"${m.key === monthSelect.value ? ' class="is-selected"' : ""}>
                    <td data-label="Month"><span class="afi-name">${esc(m.label)}</span></td>
                    <td data-label="Eligible activity" class="is-block"><div class="afi-chips">
                        <span class="afi-chip">Students <b>${formatNumber(m.activeStudents)}</b></span>
                        <span class="afi-chip">Schools <b>${formatNumber(m.activeSchools)}</b></span>
                        <span class="afi-chip">Teachers <b>${formatNumber(m.activeTeachers)}</b></span>
                        <span class="afi-chip">Certificates <b>${formatNumber(m.totalCertificates)}</b></span>
                        <span class="afi-chip">Projects <b>${formatNumber(m.evaluatedProjects)}</b></span>
                    </div></td>
                    <td data-label="Incentive earned" class="is-num"><span class="afi-money">${formatCurrency(m.totalIncentive)}</span></td>
                    <td data-label="Status"><span class="afi-badge ${m.isCurrent ? "afi-badge-progress" : "afi-badge-closed"}">${esc(m.status)}</span></td>
                    <td class="is-action is-num"><button type="button" class="afi-btn afi-btn-sm" data-view="${esc(m.key)}"><i class="bi bi-eye"></i> View</button></td>
                </tr>`;
            }).join("");

            const total = rows.reduce((sum, m) => sum + safeNumber(m.totalIncentive), 0);
            safeSetText("afiHistoryTotal", `${rows.length} month${rows.length === 1 ? "" : "s"} shown · Total ${formatCurrency(total)}`);
        }

        function showError(message) {
            const box = document.getElementById("afiError");
            if (!box) return;
            safeSetText("afiErrorText", message || "");
            box.hidden = !message;
        }

        let loading = false;

        async function load() {
            if (loading) return;       // never send the same request twice
            loading = true;
            showError("");

            try {
                const headers = { "Accept": "application/json" };
                const token = getAuthToken();
                if (token) headers["Authorization"] = "Bearer " + token;

                const response = await fetch("/api/affiliate-incentive/my", {
                    headers: headers, credentials: "same-origin", cache: "no-store"
                });

                if (response.status === 401) { window.location.replace("/"); return; }

                const json = await response.json().catch(() => null);
                if (!response.ok || !json || json.success !== true) {
                    throw new Error((json && json.message) || "Your incentive details could not be loaded.");
                }

                months = Array.isArray(json.months) ? json.months : [];

                monthSelect.innerHTML = months.map(m => `<option value="${esc(m.key)}">${esc(m.label)}</option>`).join("");

                const years = Array.from(new Set(months.map(m => m.year)));
                yearFilter.innerHTML = '<option value="">All years</option>' +
                    years.map(y => `<option value="${y}">${y}</option>`).join("");

                renderSummary(json.summary || {});
                renderHistory();
                if (months.length) renderMonth(monthSelect.value);
            } catch (error) {
                console.error("Failed to load incentive dashboard:", error);
                showError(error.message || "Your incentive details could not be loaded.");
                ["afiLifetime", "afiCurrent", "afiPrevious", "afiYear"].forEach(id => safeSetText(id, "—"));
                safeSetText("headerMonthLabel", "Not available");
                document.getElementById("afiHistoryRows").innerHTML =
                    '<tr><td colspan="5"><div class="afi-empty"><i class="bi bi-exclamation-circle"></i>Could not load your month-wise incentive.</div></td></tr>';
            } finally {
                loading = false;
            }
        }

        monthSelect.addEventListener("change", function () { renderMonth(monthSelect.value); });
        yearFilter.addEventListener("change", renderHistory);
        monthFilter.addEventListener("change", renderHistory);

        document.getElementById("afiHistoryRows").addEventListener("click", function (e) {
            const button = e.target.closest("[data-view]");
            if (!button) return;

            monthSelect.value = button.getAttribute("data-view");
            renderMonth(monthSelect.value);

            const report = document.querySelector(".monthly-report");
            if (report) report.scrollIntoView({ behavior: "smooth", block: "start" });
        });

        const retry = document.getElementById("afiRetry");
        if (retry) retry.addEventListener("click", load);

        load();
    });
</script>
