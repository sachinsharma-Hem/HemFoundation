@{
    ViewData["Title"] = "Coordinator Incentive Dashboard";
    Layout = "~/Views/Shared/Layouts/_TeacherLayout.cshtml";
}

<div class="container-fluid py-4 animate-fade-in">
    <!-- Top Header & Total Incentive Banner -->
    <div class="row align-items-center mb-4">
        <div class="col-md-6">
            <h3 class="fw-bold text-dark m-0">
                <i class="bi bi-award-fill text-success me-2"></i> Coordinator Incentive Dashboard
            </h3>
            <p class="text-muted small m-0">Performance tracking and static calculation overview.</p>
        </div>
        <div class="col-md-6 text-md-end mt-3 mt-md-0">
            <div class="glass-incentive-badge d-inline-flex align-items-center px-4 py-2 rounded-pill shadow-sm">
                <span class="text-white-50 small me-2 text-uppercase fw-semibold">Total Incentive</span>
                <span class="fs-4 fw-bold text-white">₹10,960</span>
            </div>
        </div>
    </div>

    <!-- Row 1: Overview & Focus Schools Progress -->
    <div class="row g-4 mb-4">
        <!-- Student Status Overview Card -->
        <div class="col-xl-6">
            <div class="glass-card p-4 rounded-4 h-100 shadow-sm border-0">
                <h6 class="fw-bold text-dark mb-3">Student Status Overview</h6>
                <div class="row align-items-center">
                    <div class="col-sm-5 text-center my-2">
                        <div class="pie-chart-box mx-auto">
                            <div class="pie-center"></div>
                        </div>
                    </div>
                    <div class="col-sm-7">
                        <div class="d-flex align-items-center mb-2">
                            <span class="legend-dot bg-primary me-2"></span>
                            <div class="small fw-semibold text-secondary">Active Students</div>
                            <div class="ms-auto fw-bold text-dark">700</div>
                        </div>
                        <div class="d-flex align-items-center">
                            <span class="legend-dot bg-warning me-2"></span>
                            <div class="small fw-semibold text-secondary">Value Completed</div>
                            <div class="ms-auto fw-bold text-dark">400</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Focus Schools Progress Card -->
        <div class="col-xl-6">
            <div class="glass-card p-4 rounded-4 h-100 shadow-sm border-0 d-flex flex-column justify-content-between">
                <div>
                    <h6 class="fw-bold text-dark mb-2">Focus Schools Progress</h6>
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <span class="fw-bold text-success fs-5">3 / 60</span>
                        <span class="small fw-semibold text-muted">Schools 100% Active</span>
                    </div>
                    <div class="progress rounded-pill mb-2" style="height: 12px; background: rgba(0,0,0,0.05);">
                        <div class="progress-bar bg-success rounded-pill" role="progressbar" style="width: 5%;" aria-valuenow="5" aria-valuemin="0" aria-valuemax="100"></div>
                    </div>
                </div>
                <div class="text-end">
                    <span class="badge bg-success-subtle text-success px-3 py-1 rounded-pill small fw-semibold">5% Fully Active</span>
                </div>
            </div>
        </div>
    </div>

    <!-- Row 2: Calculation Breakdown Boxes -->
    <div class="row g-3 mb-4">
        <div class="col-xl-3 col-md-6">
            <div class="glass-card p-3 rounded-3 text-center shadow-sm">
                <span class="d-block small text-muted fw-semibold mb-1">Eligible Active Students</span>
                <span class="fs-6 fw-bold text-dark">700 × ₹7,000</span>
            </div>
        </div>
        <div class="col-xl-3 col-md-6">
            <div class="glass-card p-3 rounded-3 text-center shadow-sm">
                <span class="d-block small text-muted fw-semibold mb-1">100% Active Schools</span>
                <span class="fs-6 fw-bold text-dark">3 × ₹7,0</span>
            </div>
        </div>
        <div class="col-xl-3 col-md-6">
            <div class="glass-card p-3 rounded-3 text-center shadow-sm">
                <span class="d-block small text-muted fw-semibold mb-1">Green Projects</span>
                <span class="fs-6 fw-bold text-success">200 × ₹2,400</span>
            </div>
        </div>
        <div class="col-xl-3 col-md-6">
            <div class="glass-card p-3 rounded-3 text-center shadow-sm">
                <span class="d-block small text-muted fw-semibold mb-1">Orange Projects</span>
                <span class="fs-6 fw-bold text-warning">300 × ₹1,300</span>
            </div>
        </div>
    </div>

    <!-- Row 3: Charts / Graphs Section -->
    <div class="row g-4">
        <!-- Teacher Values Completed Chart -->
        <div class="col-xl-6">
            <div class="glass-card p-4 rounded-4 shadow-sm border-0">
                <h6 class="fw-bold text-dark mb-3">Teacher Values Completed</h6>
                <div class="chart-container d-flex align-items-end justify-content-around pt-4 pb-2 border-bottom" style="height: 200px;">
                    <div class="bar-group text-center">
                        <div class="bar bg-primary rounded-top" style="height: 110px; width: 35px;"></div>
                        <small class="text-muted mt-2 d-block">200</small>
                    </div>
                    <div class="bar-group text-center">
                        <div class="bar bg-primary rounded-top" style="height: 160px; width: 35px;"></div>
                        <small class="text-muted mt-2 d-block">300</small>
                    </div>
                    <div class="bar-group text-center">
                        <div class="bar bg-primary rounded-top" style="height: 90px; width: 35px;"></div>
                        <small class="text-muted mt-2 d-block">150</small>
                    </div>
                    <div class="bar-group text-center">
                        <div class="bar bg-primary rounded-top" style="height: 140px; width: 35px;"></div>
                        <small class="text-muted mt-2 d-block">250</small>
                    </div>
                </div>
            </div>
        </div>

        <!-- Project Completion Chart -->
        <div class="col-xl-6">
            <div class="glass-card p-4 rounded-4 shadow-sm border-0">
                <h6 class="fw-bold text-dark mb-3">Project Completion</h6>
                <div class="chart-container d-flex align-items-end justify-content-around pt-4 pb-2 border-bottom" style="height: 200px;">
                    <div class="bar-group text-center">
                        <div class="bar bg-success rounded-top" style="height: 70px; width: 45px;"></div>
                        <small class="text-muted mt-2 d-block">Green 200</small>
                    </div>
                    <div class="bar-group text-center">
                        <div class="bar bg-warning rounded-top" style="height: 170px; width: 45px;"></div>
                        <small class="text-muted mt-2 d-block">Orange 300</small>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Glassmorphism Styling -->
<style>
    .glass-card {
        background: rgba(255, 255, 255, 0.85);
        backdrop-filter: blur(12px);
        -webkit-backdrop-filter: blur(12px);
        border: 1px solid rgba(217, 223, 229, 0.8) !important;
        box-shadow: 0 8px 32px 0 rgba(31, 38, 135, 0.05);
        transition: transform 0.3s ease, box-shadow 0.3s ease;
    }

        .glass-card:hover {
            transform: translateY(-2px);
            box-shadow: 0 12px 40px 0 rgba(31, 38, 135, 0.08);
        }

    .glass-incentive-badge {
        background: linear-gradient(135deg, #10b981 0%, #059669 100%);
        box-shadow: 0 4px 15px rgba(16, 185, 129, 0.3);
    }

    .legend-dot {
        width: 12px;
        height: 12px;
        border-radius: 50%;
        display: inline-block;
    }

    .pie-chart-box {
        width: 110px;
        height: 110px;
        border-radius: 50%;
        background: conic-gradient(#3b82f6 0deg 250deg, #f59e0b 250deg 360deg);
        position: relative;
        display: flex;
        align-items: center;
        justify-content: center;
        box-shadow: inset 0 2px 5px rgba(0,0,0,0.1);
    }

    .pie-center {
        width: 65px;
        height: 65px;
        background: #ffffff;
        border-radius: 50%;
    }

    .bar {
        transition: height 0.5s ease;
    }

        .bar:hover {
            opacity: 0.85;
        }
</style>