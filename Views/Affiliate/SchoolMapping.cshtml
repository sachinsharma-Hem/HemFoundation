@{
    ViewData["Title"] = "Affiliate School Mapping";
    Layout = "~/Views/Shared/Layouts/_AdminLayout.cshtml";
}

<div class="container-fluid py-4">
    <div class="d-flex align-items-center justify-content-between mb-4">
        <div>
            <h3 class="fw-bold text-dark m-0"><i class="bi bi-diagram-3-fill text-primary me-2"></i> Affiliate School Mapping</h3>
            <p class="text-muted small m-0">Assign or transfer multiple schools to an affiliate and track mapping lifecycle history.</p>
        </div>
    </div>

    <div class="card border-0 shadow-sm rounded-4 bg-white p-4 mb-4" style="border: 1px solid #d9dfe5 !important;">
        <div class="row align-items-center">
            <div class="col-md-6">
                <label class="form-label text-dark fw-bold mb-1"><i class="bi bi-person-bounding-box me-1 text-primary"></i> Select Affiliate</label>
                <select id="ddlAffiliate" class="form-select rounded-3 shadow-none border-secondary-subtle" onchange="onAffiliateChanged()">
                    <option value="">-- Choose Affiliate --</option>
                </select>
            </div>
            <div class="col-md-6 mt-3 mt-md-0">
                <div class="p-3 bg-light rounded-3 border d-flex align-items-center justify-content-between">
                    <div>
                        <small class="text-muted d-block">Selected Affiliate Status</small>
                        <span id="selectedAffiliateName" class="fw-bold text-dark">No Affiliate Selected</span>
                    </div>
                    <span id="assignedSchoolsBadge" class="badge bg-primary-subtle text-primary border border-primary-subtle px-3 py-2 rounded-pill">0 Schools Mapped</span>
                </div>
            </div>
        </div>
    </div>

    <div id="mappingSection" class="d-none">
        
        <div class="card border-0 shadow-sm rounded-4 bg-white p-4 mb-4" style="border: 1px solid #d9dfe5 !important;">
            <div class="d-flex align-items-center justify-content-between mb-3">
                <h5 class="fw-bold text-dark m-0"><i class="bi bi-arrow-left-right text-success me-2"></i> Bulk School Assignment Tool</h5>
                <span class="text-muted small"><i class="bi bi-info-circle me-1"></i> Left box shows schools available for mapping/transfer.</span>
            </div>
            
            <div class="row g-3 align-items-center">
                <div class="col-md-5">
                    <div class="d-flex justify-content-between align-items-center mb-1">
                        <label class="form-label small fw-semibold text-muted mb-0">Available / Other Schools</label>
                        <span class="badge bg-secondary-subtle text-secondary" id="cntAvailable">0</span>
                    </div>
                    <input type="text" id="searchAvailable" class="form-control form-control-sm mb-2 shadow-none" placeholder="🔍 Search in available list..." onkeyup="filterList('lstAvailable', this.value)">
                    <select id="lstAvailable" class="form-select form-select-sm rounded-3 shadow-none" multiple style="height: 230px;">
                    </select>
                </div>

                <div class="col-md-2 text-center d-flex flex-column gap-2 justify-content-center">
                    <button class="btn btn-outline-primary btn-sm rounded-3 fw-bold py-2 shadow-sm" onclick="moveSelected('lstAvailable', 'lstToAssign')" title="Move Right">
                        Add <i class="bi bi-chevron-right ms-1"></i>
                    </button>
                    <button class="btn btn-outline-secondary btn-sm rounded-3 fw-bold py-2 shadow-sm" onclick="moveSelected('lstToAssign', 'lstAvailable')" title="Move Left">
                        <i class="bi bi-chevron-left me-1"></i> Remove
                    </button>
                </div>

                <div class="col-md-5">
                    <div class="d-flex justify-content-between align-items-center mb-1">
                        <label class="form-label small fw-semibold text-success mb-0">Schools To Be Assigned / Retained</label>
                        <span class="badge bg-success-subtle text-success" id="cntToAssign">0</span>
                    </div>
                    <input type="text" id="searchToAssign" class="form-control form-control-sm mb-2 shadow-none" placeholder="🔍 Search in queued list..." onkeyup="filterList('lstToAssign', this.value)">
                    <select id="lstToAssign" class="form-select form-select-sm rounded-3 shadow-none border-success" multiple style="height: 230px;">
                    </select>
                </div>
            </div>

            <div class="text-end mt-3 border-top pt-3">
                <button class="btn btn-success rounded-pill px-4 fw-bold shadow-sm" onclick="saveMappingChanges()">
                    <i class="bi bi-check2-circle me-1"></i> Confirm & Save Mapping Changes
                </button>
            </div>
        </div>

        <div class="card border-0 shadow-sm rounded-4 bg-white p-4" style="border: 1px solid #d9dfe5 !important;">
            <div class="d-flex align-items-center justify-content-between mb-3">
                <h5 class="fw-bold text-dark m-0"><i class="bi bi-building-check text-primary me-2"></i> Currently Assigned Schools</h5>
            </div>

            <div class="table-responsive">
                <table class="table table-hover align-middle small">
                    <thead class="table-light">
                        <tr>
                            <th>Institute ID</th>
                            <th>School Name</th>
                            <th>City / Location</th>
                            <th>Contact Mobile</th>
                            <th class="text-center">Lifecycle History</th>
                        </tr>
                    </thead>
                    <tbody id="tblAssignedBody">
                        <tr><td colspan="5" class="text-center text-muted py-4">No schools assigned to this affiliate yet.</td></tr>
                    </tbody>
                </table>
            </div>
        </div>

    </div>
</div>

<div class="modal fade" id="schoolHistoryModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-md">
        <div class="modal-content rounded-4 border-0 shadow-lg p-3 bg-white">
            <div class="modal-header border-bottom pb-3">
                <div>
                    <h5 class="fw-bold text-dark m-0"><i class="bi bi-diagram-2-fill text-success me-2"></i> Mapping Lifecycle Tree</h5>
                    <small class="text-muted" id="modalSchoolTitle">School Name</small>
                </div>
                <button type="button" class="btn-close shadow-none" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body py-4">
                <div class="timeline-tree position-relative ps-4" id="timelineContainer">
                    <div class="text-center text-muted py-3"><div class="spinner-border spinner-border-sm"></div> Loading lifecycle tree...</div>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .timeline-tree::before {
        content: '';
        position: absolute;
        left: 12px;
        top: 5px;
        bottom: 5px;
        width: 3px;
        background: #e9ecef;
        border-radius: 2px;
    }
    .timeline-item {
        position: relative;
        margin-bottom: 24px;
    }
    .timeline-item:last-child {
        margin-bottom: 0;
    }
    .timeline-badge {
        position: absolute;
        left: -28px;
        top: 2px;
        width: 18px;
        height: 18px;
        border-radius: 50%;
        background: #0d6efd;
        border: 3px solid #fff;
        box-shadow: 0 0 0 2px rgba(13, 110, 253, 0.2);
    }
    .timeline-badge.current {
        background: #198754;
        box-shadow: 0 0 0 3px rgba(25, 135, 84, 0.25);
    }
</style>

<script>
    document.addEventListener("DOMContentLoaded", function () {
        loadAffiliatesDropdown();
    });

    function getAuthToken() {
        return localStorage.getItem('jwt_token') || sessionStorage.getItem('jwt_token') || '';
    }

    function formatDateDDMMYYYY(dateString) {
        if (!dateString) return '-';
        let d = new Date(dateString);
        return `${String(d.getDate()).padStart(2, '0')}/${String(d.getMonth() + 1).padStart(2, '0')}/${d.getFullYear()} ${d.toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' })}`;
    }

    // 1. Populate Affiliates Dropdown
    function loadAffiliatesDropdown() {
        $.ajax({
            url: '/api/affiliate-school-mapping/affiliates-list',
            type: 'GET',
            headers: { 'Authorization': 'Bearer ' + getAuthToken() },
            success: function (res) {
                if (res.success && res.data) {
                    let html = '<option value="">-- Choose Affiliate --</option>';
                    res.data.forEach(a => {
                        html += `<option value="${a.id}">${a.name}</option>`;
                    });
                    $('#ddlAffiliate').html(html);
                }
            }
        });
    }

    // 2. Load Mapping Data when Affiliate Selected
    function onAffiliateChanged() {
        let affId = $('#ddlAffiliate').val();
        let affName = $('#ddlAffiliate option:selected').text();

        if (!affId) {
            $('#mappingSection').addClass('d-none');
            $('#selectedAffiliateName').text('No Affiliate Selected');
            $('#assignedSchoolsBadge').text('0 Schools Mapped');
            return;
        }

        $('#selectedAffiliateName').text(affName);
        $('#mappingSection').removeClass('d-none');
        fetchMappingData(affId);
    }

    function fetchMappingData(affId) {
        $.ajax({
            url: `/api/affiliate-school-mapping/get-mapping-data/${affId}`,
            type: 'GET',
            headers: { 'Authorization': 'Bearer ' + getAuthToken() },
            success: function (res) {
                if (res.success) {
                    // Populate Available Box (Left) - Removed .data
                    let availOpts = '';
                    res.availableSchools.forEach(s => {
                        availOpts += `<option value="${s.instituteID}">${s.name} (${s.city || 'N/A'})</option>`;
                    });
                    $('#lstAvailable').html(availOpts);

                    // Populate Queued Box (Right) with currently assigned schools - Removed .data
                    let queuedOpts = '';
                    res.assignedSchools.forEach(s => {
                        queuedOpts += `<option value="${s.instituteID}">${s.name} (${s.city || 'N/A'})</option>`;
                    });
                    $('#lstToAssign').html(queuedOpts);

                    updateCounts();

                    // Update Assigned Count Badge - Removed .data
                    $('#assignedSchoolsBadge').text(`${res.assignedSchools.length} Schools Mapped`);

                    // Populate Assigned Schools Table - Removed .data
                    if (res.assignedSchools.length > 0) {
                        let rows = '';
                        res.assignedSchools.forEach(s => {
                            rows += `<tr>
                                <td><span class="badge bg-light text-dark border">#${s.instituteID}</span></td>
                                <td class="fw-bold text-dark">${s.name}</td>
                                <td>${s.city || '-'}, ${s.state || ''}</td>
                                <td>${s.mobileNo || '-'}</td>
                                <td class="text-center">
                                    <button class="btn btn-outline-success btn-sm rounded-pill px-3 shadow-none" onclick="viewSchoolHistory(${s.instituteID})">
                                        <i class="bi bi-diagram-2 me-1"></i> View Lifecycle Tree
                                    </button>
                                </td>
                            </tr>`;
                        });
                        $('#tblAssignedBody').html(rows);
                    } else {
                        $('#tblAssignedBody').html('<tr><td colspan="5" class="text-center text-muted py-4">No schools assigned to this affiliate yet.</td></tr>');
                    }
                }
            }
        });
    }

    // Dual Box Item Movement
    function moveSelected(fromId, toId) {
        $(`#${fromId} option:selected`).each(function () {
            $(this).appendTo(`#${toId}`);
        });
        updateCounts();
    }

    function updateCounts() {
        $('#cntAvailable').text($('#lstAvailable option').length);
        $('#cntToAssign').text($('#lstToAssign option').length);
    }

    function filterList(selectId, searchText) {
        let val = searchText.toLowerCase();
        $(`#${selectId} option`).each(function () {
            let text = $(this).text().toLowerCase();
            $(this).toggle(text.indexOf(val) > -1);
        });
    }

    // Save Assignments & Updates
    function saveMappingChanges() {
        let affId = $('#ddlAffiliate').val();
        let selectedSchoolIDs = [];

        $('#lstToAssign option').each(function () {
            selectedSchoolIDs.push(parseInt($(this).val()));
        });

        $.ajax({
            url: '/api/affiliate-school-mapping/assign-schools',
            type: 'POST',
            contentType: 'application/json',
            headers: { 'Authorization': 'Bearer ' + getAuthToken() },
            data: JSON.stringify({ affiliateId: parseInt(affId), instituteIDs: selectedSchoolIDs }),
            success: function (res) {
                if (res.success) {
                    alert(res.message);
                    fetchMappingData(affId);
                }
            },
            error: function (err) {
                alert(err.responseJSON?.message || 'Failed to update mapping.');
            }
        });
    }

    // View Mapping Tree History
    function viewSchoolHistory(instituteId) {
        $('#schoolHistoryModal').modal('show');
        $('#timelineContainer').html('<div class="text-center text-muted py-3"><div class="spinner-border spinner-border-sm"></div> Loading...</div>');

        $.ajax({
            url: `/api/affiliate-school-mapping/school-history/${instituteId}`,
            type: 'GET',
            headers: { 'Authorization': 'Bearer ' + getAuthToken() },
            success: function (res) {
                if (res.success) {
                    $('#modalSchoolTitle').text(`${res.schoolName} (${res.schoolCity || 'N/A'})`);

                    if (res.historyTree && res.historyTree.length > 0) {
                        let html = '';
                        res.historyTree.forEach((item, index) => {
                            let badgeClass = index === 0 ? 'current' : '';
                            let isLatestBadge = index === 0 ? '<span class="badge bg-success ms-2">Current Active</span>' : '';

                            html += `<div class="timeline-item">
                                <div class="timeline-badge ${badgeClass}"></div>
                                <div class="p-3 bg-light rounded-3 border">
                                    <div class="d-flex justify-content-between align-items-center mb-1">
                                        <span class="fw-bold text-dark">${item.newAffiliateName}</span>
                                        ${isLatestBadge}
                                    </div>
                                    <p class="text-muted extra-small m-0">Transferred from: <b>${item.previousAffiliateName || 'Unassigned'}</b></p>
                                    <small class="text-muted d-block mt-2" style="font-size: 0.72rem;">
                                        <i class="bi bi-clock me-1"></i> ${formatDateDDMMYYYY(item.assignedDate)} | By: ${item.assignedBy}
                                    </small>
                                </div>
                            </div>`;
                        });
                        $('#timelineContainer').html(html);
                    } else {
                        $('#timelineContainer').html('<div class="text-center text-muted py-3">No transfer history recorded for this school yet.</div>');
                    }
                }
            }
        });
    }
</script>