<!-- =============================================================
     ASSOCIATED SCHOOLS JAVASCRIPT
     ============================================================= -->

<script>

(function () {

    "use strict";


    function getAuthToken() {

        return localStorage.getItem("jwt_token") ||
               sessionStorage.getItem("jwt_token") ||
               "";

    }


    function escapeHtml(value) {

        if (value === null || value === undefined) {
            return "";
        }

        var div = document.createElement("div");

        div.textContent = String(value);

        return div.innerHTML;

    }


    function displayValue(value) {

        if (value === null ||
            value === undefined ||
            value === "") {

            return '<span class="text-muted">-</span>';

        }

        return escapeHtml(value);

    }


    function formatDate(value) {

        if (!value) {
            return "-";
        }

        try {

            var date = new Date(value);

            if (isNaN(date.getTime())) {
                return escapeHtml(value);
            }

            return date.toLocaleString("en-IN", {
                day: "2-digit",
                month: "short",
                year: "numeric",
                hour: "2-digit",
                minute: "2-digit"
            });

        }
        catch (error) {

            return escapeHtml(value);

        }

    }


    function formatBoolean(value) {

        if (value === true ||
            value === "true" ||
            value === "True" ||
            value === 1 ||
            value === "1") {

            return `
                <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill px-3 school-status-badge">
                    <i class="bi bi-check-circle me-1"></i>
                    Yes
                </span>
            `;

        }


        if (value === false ||
            value === "false" ||
            value === "False" ||
            value === 0 ||
            value === "0") {

            return `
                <span class="badge bg-danger-subtle text-danger border border-danger-subtle rounded-pill px-3 school-status-badge">
                    <i class="bi bi-x-circle me-1"></i>
                    No
                </span>
            `;

        }


        return `
            <span class="text-muted">-</span>
        `;

    }


    function formatCount(value) {

        if (value === null ||
            value === undefined ||
            value === "") {

            value = 0;

        }

        return `
            <span class="badge bg-primary-subtle text-primary border border-primary-subtle rounded-pill px-3 school-count-badge">
                ${escapeHtml(value)}
            </span>
        `;

    }


    function formatUrl(value, label) {

        if (!value) {
            return '<span class="text-muted">-</span>';
        }

        var safeUrl = escapeHtml(value);

        return `
            <a href="${safeUrl}"
               target="_blank"
               rel="noopener noreferrer"
               class="text-primary text-decoration-none school-url"
               title="${safeUrl}">

                <i class="bi bi-box-arrow-up-right me-1"></i>
                ${escapeHtml(label || value)}

            </a>
        `;

    }


    window.openAssociatedSchoolsModal = function () {

        var modalEl =
            document.getElementById("associatedSchoolsModal");


        if (!modalEl) {
            console.error("associatedSchoolsModal not found.");
            return;
        }


        var modal =
            bootstrap.Modal.getOrCreateInstance(modalEl);

        modal.show();


        var tbody =
            $("#associatedSchoolsTableBody");


        tbody.html(`
            <tr>
                <td colspan="27" class="text-center py-5">

                    <div class="spinner-border text-success spinner-border-sm me-2"
                         role="status">
                    </div>

                    <span class="text-muted fw-semibold">
                        Loading associated schools...
                    </span>

                </td>
            </tr>
        `);


        $("#associatedSchoolsTotalCount").text("0");


        var token = getAuthToken();


        $.ajax({

            url: "/api/affiliate-dashboard/associated-schools-details",

            type: "GET",

            headers: {
                "Authorization":
                    token ? "Bearer " + token : ""
            },

            cache: false,


            success: function (res) {

                console.log(
                    "Associated Schools Response:",
                    res
                );


                if (!res || !res.success) {

                    tbody.html(`
                        <tr>
                            <td colspan="27"
                                class="text-center text-danger py-5">

                                <i class="bi bi-exclamation-triangle me-2"></i>

                                ${
                                    escapeHtml(
                                        res && res.message
                                            ? res.message
                                            : "Failed to load associated school details."
                                    )
                                }

                            </td>
                        </tr>
                    `);

                    return;

                }


                var schools =
                    Array.isArray(res.data)
                        ? res.data
                        : [];


                $("#associatedSchoolsTotalCount")
                    .text(schools.length);


                if (schools.length === 0) {

                    tbody.html(`
                        <tr>
                            <td colspan="27"
                                class="text-center text-muted py-5">

                                <i class="bi bi-building-x fs-4 d-block mb-2"></i>

                                No associated schools found.

                            </td>
                        </tr>
                    `);

                    return;

                }


                var html = "";


                schools.forEach(function (s) {

                    html += `
                        <tr>

                            <!-- 1 School ID -->
                            <td>
                                <span class="badge bg-light text-dark border">
