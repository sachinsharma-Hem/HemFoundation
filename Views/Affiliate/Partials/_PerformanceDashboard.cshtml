<!-- =============================================================
     CONSOLIDATED DASHBOARD JAVASCRIPT
     ============================================================= -->
<script>
    const affiliateId = '@affiliateId';

    console.log("Affiliate ID from Session:", affiliateId);
</script>
<script>
(function () {
    "use strict";

    /* ============================================================
       COMMON HELPERS
       ============================================================ */

    window.getAuthToken = function () {
        return localStorage.getItem("jwt_token") ||
               sessionStorage.getItem("jwt_token") ||
               "";
    };

    window.escapeHtml = function (value) {
        if (value === null || value === undefined) {
            return "";
        }

        return $("<div>")
            .text(String(value))
            .html();
    };

    window.formatColumnName = function (key) {
        if (!key) {
            return "";
        }

        let result = String(key)
            .replace(/([a-z])([A-Z])/g, "$1 $2")
            .replace(/_/g, " ")
            .replace(/-/g, " ");

        return result.charAt(0).toUpperCase() + result.slice(1);
    };

    window.formatDate = function (value) {
        if (!value) {
            return "-";
        }

        const date = new Date(value);

        if (isNaN(date.getTime())) {
            return escapeHtml(value);
        }

        return date.toLocaleDateString("en-IN", {
            day: "2-digit",
            month: "short",
            year: "numeric"
        });
    };

    window.getStatusBadge = function (value) {
        const active =
            value === true ||
            value === 1 ||
            value === "1" ||
            value === "true" ||
            value === "True";

        return active
            ? '<span class="badge bg-success-subtle text-success school-status-badge">Active</span>'
            : '<span class="badge bg-secondary-subtle text-secondary school-status-badge">Inactive</span>';
    };

    window.showGlobalLoader = window.showGlobalLoader || function (message) {
        $("#globalLoaderText").text(message || "Please Wait...");
        $("#globalLoader").stop(true, true).fadeIn(150);
    };

    window.hideGlobalLoader = window.hideGlobalLoader || function () {
        $("#globalLoader").stop(true, true).fadeOut(150);
    };


    /* ============================================================
       DASHBOARD SUMMARY
       ============================================================ */

    async function loadSummaryCounts() {
        try {
            const token = getAuthToken();

            const response = await fetch(
                "/api/affiliate-dashboard/dashboard-summary-counts",
                {
                    method: "GET",
                    headers: {
                        "Accept": "application/json",
                        "Authorization": token ? "Bearer " + token : ""
                    },
                    credentials: "same-origin",
                    cache: "no-store"
                }
            );

            if (!response.ok) {
                throw new Error("HTTP " + response.status);
            }

            const json = await response.json();

            if (!json || !json.success || !json.data) {
                return;
            }

            const data = json.data;

            $("#lblTotalAssociatedSchool").text(data.totalinstitute ?? 0);
            $("#lblTotalStudentCount").text(data.totalStudents ?? 0);
            $("#lblActiveStudentCount").text(data.activeStudents ?? 0);
            $("#lblTotalTeacherCount").text(data.totalTeachers ?? 0);
            $("#lblActiveTeacherCount").text(data.activeTeachers ?? 0);
            $("#lblTotalSelProjectCount").text(data.totalSelProjects ?? 0);
            $("#lblFamilyProjectCount").text(data.familyProjects ?? 0);
            $("#lblIndividualProjectCount").text(data.individualProjects ?? 0);
            $("#lblGroupPblCount").text(data.groupPbl ?? 0);

        } catch (error) {
            console.error("Failed to load dashboard summary counts:", error);
        }
    }


    /* ============================================================
       ASSOCIATED SCHOOLS
       ============================================================ */

    async function fetchAssignedSchools() {
        try {
            const token = getAuthToken();

            const response = await fetch(
                "/api/affiliate-dashboard/my-assigned-schools",
                {
                    method: "GET",
                    headers: {
                        "Accept": "application/json",
                        "Authorization": token ? "Bearer " + token : ""
                    },
                    credentials: "same-origin",
                    cache: "no-store"
                }
            );

            if (!response.ok) {
                throw new Error("HTTP " + response.status);
            }

