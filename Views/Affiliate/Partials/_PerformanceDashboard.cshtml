    /* ============================================================
       ASSOCIATED SCHOOLS EXCEL EXPORT
       ============================================================ */

    function exportAssociatedSchoolsExcel($button) {

        const token =
            getAuthToken();

        if (!token) {

            alert(
                "Login session expired. Please login again."
            );

            return;
        }

        const originalHtml =
            $button.html();

        $.ajax({

            type: "GET",

            url:
                "/api/affiliate-dashboard/export-associated-schools",

            headers: {
                "Authorization":
                    "Bearer " + token
            },

            xhrFields: {
                responseType: "blob"
            },

            beforeSend: function () {

                showGlobalLoader(
                    "Generating Associated Schools Report..."
                );

                $button
                    .prop("disabled", true)
                    .html(`
                        <span
                            class="spinner-border spinner-border-sm me-1">
                        </span>
                        Exporting...
                    `);
            },

            success: function (data, status, xhr) {

                const blob =
                    new Blob(
                        [data],
                        {
                            type:
                                "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet"
                        }
                    );

                const url =
                    window.URL.createObjectURL(blob);

                let filename =
                    "AssociatedSchoolsReport.xlsx";

                const disposition =
                    xhr.getResponseHeader(
                        "Content-Disposition"
                    );

                if (disposition) {

                    const match =
                        disposition.match(
                            /filename\*?=(?:UTF-8''|")?([^;"']+)/i
                        );

                    if (match && match[1]) {
                        filename =
                            decodeURIComponent(
                                match[1]
                                    .replace(/"/g, "")
                            );
                    }
                }

                const anchor =
                    $("<a />")
                        .attr({
                            href: url,
                            download: filename
                        })
                        .appendTo("body");

                anchor[0].click();

                setTimeout(function () {

                    window.URL.revokeObjectURL(url);
                    anchor.remove();

                }, 100);
            },

            error: function (xhr, status, error) {

                console.error(
                    "Associated schools export error:",
                    xhr.responseText || error
                );

                alert(
                    "Error downloading associated schools report."
                );
            },

            complete: function () {

                hideGlobalLoader();

                $button
                    .prop("disabled", false)
                    .html(originalHtml);
            }
        });
    }

