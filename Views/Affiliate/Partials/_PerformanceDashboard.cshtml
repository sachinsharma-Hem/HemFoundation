@using Microsoft.AspNetCore.Http
@{
    var affiliateId = Context.Session.GetInt32("UserID") ?? 0;
}
<div class="card shadow-sm rounded-4 bg-white p-4 animate-fade-in" style="border: 1px solid #d9dfe5 !important;">
    <!-- Header Section -->
    <div class="d-flex align-items-center justify-content-between mb-4 pb-3 border-bottom">
        <div>
            <h4 class="fw-bold text-success mb-1"><i class="bi bi-speedometer2 me-2"></i>Performance Dashboard</h4>
            <p class="text-muted small m-0">Real-time statistics, school data, and user activity overview.</p>
        </div>
    </div>

    <!-- Stats Grid System (9 Cards) -->
    <div class="row g-3 mb-4">

        <!-- Card 1: Associated School (Primary Blue) -->
        <div class="col-xl-3 col-lg-4 col-md-6"  onclick="openDetailsModal('performance','total-schools')">
            <div class="card text-white bg-primary border-0 shadow-sm h-100 rounded-3 overflow-hidden cursor-pointer" >
                <div class="card-body p-3 d-flex flex-column justify-content-between">
                    <div>
                        <h2 class="fw-bold mb-1" id="lblTotalAssociatedSchool">0</h2>
                        <p class="card-text small mb-2">Associated School</p>
                    </div>
                    <div>
                        <button type="button" id="btnOpenassociatedSchools" onclick="event.stopPropagation(); openAssociatedSchoolsModal();" class="btn btn-sm btn-light text-primary fw-bold py-0 px-2 rounded-pill" style="font-size: 0.75rem;">More Info <i class="bi bi-arrow-right"></i></button>
                    </div>
                </div>
            </div>
        </div>

        <!-- Card 2: Associated Student (Success Green) -->
        <div class="col-xl-3 col-lg-4 col-md-6">
            <div class="card text-white bg-success border-0 shadow-sm h-100 rounded-3 overflow-hidden">
                <div class="card-body p-3 d-flex flex-column justify-content-between">
                    <div>
                        <h2 class="fw-bold mb-1" id="lblTotalStudentCount">0</h2>
                        <p class="card-text small mb-2">Associated Student</p>
                    </div>
                    <div>
                        <button type="button" id="btnOpenTotalStudentss" onclick="event.stopPropagation(); openDetailsModal('performance','total-students')" class="btn btn-sm btn-light text-success fw-bold py-0 px-2 rounded-pill" style="font-size: 0.75rem;">More Info <i class="bi bi-arrow-right"></i></button>
                    </div>
                </div>
            </div>
        </div>

        <!-- Card 3: Active Student (Warning Yellow) -->
        <div class="col-xl-3 col-lg-4 col-md-6">
            <div class="card text-dark bg-warning border-0 shadow-sm h-100 rounded-3 overflow-hidden">
                <div class="card-body p-3 d-flex flex-column justify-content-between">
                    <div>
                        <h2 class="fw-bold mb-1" id="lblActiveStudentCount">0</h2>
                        <p class="card-text small mb-2">Active Student</p>
                    </div>
                    <div>
                        <button type="button" id="btn_ExportAdminStudentsReport" onclick="event.stopPropagation();"  class="btn btn-sm btn-dark text-warning fw-bold py-0 px-2 rounded-pill" style="font-size: 0.75rem;">More Info <i class="bi bi-arrow-right"></i></button>
                    </div>
                </div>
            </div>
        </div>

        <!-- Card 4: Associated Teacher (Info Cyan) -->
        <div class="col-xl-3 col-lg-4 col-md-6">
            <div class="card text-white bg-info border-0 shadow-sm h-100 rounded-3 overflow-hidden">
                <div class="card-body p-3 d-flex flex-column justify-content-between">
                    <div>
                        <h2 class="fw-bold mb-1" id="lblTotalTeacherCount">0</h2>
                        <p class="card-text small mb-2">Associated Teacher</p>
                    </div>
                    <div>
                        <button type="button" id="btnOpenTotalTeacherss" onclick="event.stopPropagation(); openDetailsModal('performance','total-teachers')" class="btn btn-sm btn-light text-info fw-bold py-0 px-2 rounded-pill" style="font-size: 0.75rem;">More Info <i class="bi bi-arrow-right"></i></button>
                    </div>
                </div>
            </div>
        </div>

        <!-- Card 5: Active Teacher (Danger Red) -->
        <div class="col-xl-3 col-lg-4 col-md-6">
            <div class="card text-white bg-danger border-0 shadow-sm h-100 rounded-3 overflow-hidden">
                <div class="card-body p-3 d-flex flex-column justify-content-between">
                    <div>
                        <h2 class="fw-bold mb-1" id="lblActiveTeacherCount">0</h2>
                        <p class="card-text small mb-2">Active Teacher</p>
                    </div>
                    <div>
                        <button type="button" id="btnOpenActiveTeacherss" onclick="event.stopPropagation(); openDetailsModal('performance','active-teachers')" class="btn btn-sm btn-light text-danger fw-bold py-0 px-2 rounded-pill" style="font-size: 0.75rem;">More Info <i class="bi bi-arrow-right"></i></button>
                    </div>
                </div>
            </div>
        </div>

        <!-- Card 6: No. Of SEL Submission School (Secondary Gray) -->
        <div class="col-xl-3 col-lg-4 col-md-6">
            <div class="card text-white bg-secondary border-0 shadow-sm h-100 rounded-3 overflow-hidden">
                <div class="card-body p-3 d-flex flex-column justify-content-between">
                    <div>
                        <h2 class="fw-bold mb-1" id="lblTotalSelProjectCount">0</h2>
                        <p class="card-text small mb-2">No. Of SEL Submission School</p>
                    </div>
                    <div>
                        <button type="button" id="btn_ExportPerfSelSubmissions" class="btn btn-sm btn-light text-secondary fw-bold py-0 px-2 rounded-pill" style="font-size: 0.75rem;">More Info <i class="bi bi-arrow-right"></i></button>
                    </div>
                </div>
            </div>
        </div>

        <!-- Card 7: No. Of Group Project Submission (Dark) -->
        <div class="col-xl-3 col-lg-4 col-md-6">
            <div class="card text-white bg-dark border-0 shadow-sm h-100 rounded-3 overflow-hidden">
                <div class="card-body p-3 d-flex flex-column justify-content-between">
                    <div>
                        <h2 class="fw-bold mb-1" id="lblGroupPblCount">0</h2>
                        <p class="card-text small mb-2">No. Of Group Project Submission</p>
                    </div>
                    <div>
                        <button type="button" id="btnOpenGroupPbl" class="btn btn-sm btn-light text-dark fw-bold py-0 px-2 rounded-pill" style="font-size: 0.75rem;">More Info <i class="bi bi-arrow-right"></i></button>
                    </div>
                </div>
            </div>
        </div>

        <!-- Card 8: No. Of Family Project Submission (Indigo/Custom Gradient or Dark Subtly Styled) -->
        <div class="col-xl-3 col-lg-4 col-md-6">
            <div class="card text-white border-0 shadow-sm h-100 rounded-3 overflow-hidden" style="background-color: #6610f2 !important;">
                <div class="card-body p-3 d-flex flex-column justify-content-between">
                    <div>
                        <h2 class="fw-bold mb-1" id="lblFamilyProjectCount">0</h2>
                        <p class="card-text small mb-2">No. Of Family Project Submission</p>
                    </div>
                    <div>
                        <button type="button" id="btn_ExportPerfFamilyPbl" class="btn btn-sm btn-light fw-bold py-0 px-2 rounded-pill" style="font-size: 0.75rem; color: #6610f2 !important;">More Info <i class="bi bi-arrow-right"></i></button>
                    </div>
                </div>
            </div>
        </div>

        <!-- Card 9: No. Of Individual Project Submission (Light Bordered) -->
        <div class="col-xl-3 col-lg-4 col-md-6">
            <div class="card text-dark bg-light border border-secondary-subtle shadow-sm h-100 rounded-3 overflow-hidden">
                <div class="card-body p-3 d-flex flex-column justify-content-between">
                    <div>
                        <h2 class="fw-bold mb-1 text-dark" id="lblIndividualProjectCount">0</h2>
                        <p class="card-text small mb-2 text-muted">No. Of Individual Project Submission</p>
                    </div>
                    <div>
                        <button type="button" id="btn_ExportPerfIndividualPbl" class="btn btn-sm btn-dark text-white fw-bold py-0 px-2 rounded-pill" style="font-size: 0.75rem;">More Info <i class="bi bi-arrow-right"></i></button>
                    </div>
                </div>
            </div>
        </div>

    </div>

    <!-- Footer Note -->
    <div class="text-center py-3 text-muted border rounded-3 bg-light-subtle small">
        <i class="bi bi-info-circle me-1"></i> All metrics update automatically based on system live records.
    </div>

