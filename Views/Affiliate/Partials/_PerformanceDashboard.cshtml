    window.exportSingleInstituteReport =
        function (instituteId, buttonElement) {

            if (!instituteId || Number(instituteId) <= 0) {

                alert("Invalid Institute ID.");
                return;
            }

            const $button =
                $(buttonElement);

            const originalHtml =
                $button.html();

            const token =
                getAuthToken();

            if (!token) {
                alert(
                    "Login session expired. Please login again."
                );
                return;
            }

            $.ajax({

                type: "POST",

                url:
                    "/api/Report/export-institute-summary",

                data:
                    JSON.stringify({
                        instituteIDstr:
                            String(instituteId)
                    }),

                contentType:
                    "application/json; charset=utf-8",

                headers: {
                    "Authorization":
                        "Bearer " + token
                },

                xhrFields: {
                    responseType: "blob"
                },

                beforeSend: function () {

                    showGlobalLoader(
                        "Generating Institute Performance Report..."
                    );

                    $button
                        .prop("disabled", true)
                        .html(`
                            <span
                                class="spinner-border spinner-border-sm me-1"
                                role="status">
                            </span>
                            Exporting...
                        `);
                },

                success: function (data) {

                    const blob =
                        new Blob(
                            [data],
                            {
                                type:
                                    "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet"
                            }
                        );

                    const url =
                        window.URL.createObjectURL(blob);

                    const anchor =
                        $("<a />")
                            .attr({
                                href: url,
                                download:
                                    `Institute_${instituteId}_PerformanceReport.xlsx`
                            })
                            .appendTo("body");

                    anchor[0].click();

                    setTimeout(function () {

                        window.URL.revokeObjectURL(url);
                        anchor.remove();

                    }, 100);
                },

                error: function (xhr, status, error) {

                    console.error(
                        "Institute report export error:",
                        xhr.responseText || error
                    );

                    alert(
                        "Error downloading institute report."
                    );
                },

                complete: function () {

                    hideGlobalLoader();

                    $button
                        .prop("disabled", false)
                        .html(originalHtml);
                }
            });
        };


