    if (!affiliateId || affiliateId === "0") {
        alert("Logged-in user ID not found.");
        return;
    }

    // Validate token
    if (!token) {
        alert("Login session expired. Please login again.");
        return;
    }

    // Default filter
    filterVal = filterVal || "A";

    // Save original button HTML
    const originalHtml = $button.html();

    $.ajax({
        type: "GET",

        url:
            `/api/Report/affiliate-active-students` +
            `?AffiliateID=${encodeURIComponent(affiliateId)}` +
            `&filter=${encodeURIComponent(filterVal)}`,

        headers: {
            "Authorization": "Bearer " + token
        },

        xhrFields: {
            responseType: "blob"
        },

        beforeSend: function () {

            showGlobalLoader(
                `Generating ${reportTitle || "Active Students"} Report...`
            );

            $button
                .prop("disabled", true)
                .addClass("disabled")
                .html(`
                    <span
                        class="spinner-border spinner-border-sm me-1"
                        role="status"
                        aria-hidden="true">
                    </span>
                    Generating...
                `);
        },

        success: function (data) {

            const blob = new Blob(
                [data],
                {
                    type:
                        "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet"
                }
            );

            const url =
                window.URL.createObjectURL(blob);

            const filename =
                filterVal === "F"
                    ? "FocusedActiveStudentsReport.xlsx"
                    : "ActiveStudentsReport.xlsx";

            const $anchor = $("<a />")
                .attr({
                    href: url,
                    download: filename
                })
                .appendTo("body");

            $anchor[0].click();

            setTimeout(function () {

                window.URL.revokeObjectURL(url);
                $anchor.remove();

            }, 100);
        },

        error: function (xhr, status, error) {

            console.error(
                "Active Students Report Error:",
                xhr.responseText || error
            );

            alert(
                "Error downloading active students report."
            );
        },

        complete: function () {

            hideGlobalLoader();

            $button
                .prop("disabled", false)
                .removeClass("disabled")
                .html(originalHtml);
        }
    });
}

