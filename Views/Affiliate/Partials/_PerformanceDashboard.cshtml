<style>
    .cursor-pointer { cursor: pointer; }
    /* Timeline styles required for the modal */
    .timeline-tree::before { content: ''; position: absolute; left: 12px; top: 5px; bottom: 5px; width: 3px; background: #e9ecef; border-radius: 2px; }
    .timeline-item { position: relative; margin-bottom: 24px; }
    .timeline-item:last-child { margin-bottom: 0; }
    .timeline-badge { position: absolute; left: -28px; top: 2px; width: 18px; height: 18px; border-radius: 50%; background: #0d6efd; border: 3px solid #fff; box-shadow: 0 0 0 2px rgba(13, 110, 253, 0.2); }
    .timeline-badge.current { background: #198754; box-shadow: 0 0 0 3px rgba(25, 135, 84, 0.25); }
</style>

<script>
    // Note: Since this is a partial view loaded dynamically, we don't use document.addEventListener("DOMContentLoaded")
    // as it might have already fired. We execute the init function immediately.
    
    $(function() {
        initPerformanceDashboard();
    });

    function initPerformanceDashboard() {
        $.ajax({
            // 👉 CORRECTED URL: Naye ApiController ka route
            url: '/api/affiliate-dashboard/stats', 
            type: 'GET',
            headers: { 'Authorization': 'Bearer ' + (localStorage.getItem('jwt_token') || sessionStorage.getItem('jwt_token') || '') },
            success: function(res) {
                if(res.success) {
                    $('#dashStatus').text('Status: Active');
                    $('#cntAssociatedSchools').text(res.data.associatedSchools);
                    $('#cntAssociatedStudents').text(res.data.associatedStudents);
                    $('#cntActiveStudents').text(res.data.activeStudents);
                    $('#cntAssociatedTeachers').text(res.data.associatedTeachers);
                    $('#cntNewSchools').text(res.data.newSchools);
                    // Update other IDs accordingly
                }
            },
            error: function() {
                $('#dashStatus').text('Error loading stats').removeClass('text-danger bg-danger-subtle').addClass('text-muted bg-light');
                $('.card h2').text('-');
            }
        });
    }

    function openAssociatedSchoolsModal() {
        $('#associatedSchoolsModal').modal('show');
        $('#associatedSchoolsTableBody').html('<tr><td colspan="5" class="text-center py-4"><div class="spinner-border spinner-border-sm"></div> Loading...</td></tr>');

        $.ajax({
            url: '/api/affiliate-dashboard/associated-schools-details',
            type: 'GET',
            headers: { 'Authorization': 'Bearer ' + (localStorage.getItem('jwt_token') || sessionStorage.getItem('jwt_token') || '') },
            success: function(res) {
                if (res.success) {
                    if (res.data && res.data.length > 0) {
                        let html = '';
                        res.data.forEach(s => {
                            html += `<tr>
                                <td><span class="badge bg-light text-dark border">#${s.instituteID}</span></td>
                                <td class="fw-bold text-dark">${s.name || '-'}</td>
                                <td>${s.city || '-'}</td>
                                <td>${s.mobileNo || '-'}</td>
                                <td class="text-center">
                                    <button class="btn btn-outline-success btn-sm rounded-pill px-3 shadow-none" onclick="viewPerfSchoolHistory(${s.instituteID})">
                                        <i class="bi bi-diagram-2 me-1"></i> View
                                    </button>
                                </td>
                            </tr>`;
                        });
                        $('#associatedSchoolsTableBody').html(html);
                    } else {
                        $('#associatedSchoolsTableBody').html('<tr><td colspan="5" class="text-center text-muted py-4">No associated schools found.</td></tr>');
                    }
                }
            },
            error: function(xhr) {
                $('#associatedSchoolsTableBody').html('<tr><td colspan="5" class="text-center text-danger py-4">Failed to load school details.</td></tr>');
            }
        });
    }

    // Reuse the history view logic specifically for this dashboard
    function viewPerfSchoolHistory(instituteId) {
        $('#perfSchoolHistoryModal').modal('show');
        $('#perfTimelineContainer').html('<div class="text-center text-muted py-3"><div class="spinner-border spinner-border-sm"></div> Loading...</div>');

        $.ajax({
            // 👉 Yeh bilkul SAHI hai! Kyunki History wala endpoint abhi bhi purane (mapping) controller mein hi hai.
            url: `/api/affiliate-school-mapping/school-history/${instituteId}`,
            type: 'GET',
            headers: { 'Authorization': 'Bearer ' + (localStorage.getItem('jwt_token') || sessionStorage.getItem('jwt_token') || '') },
            success: function (res) {
                if (res.success) {
                    $('#perfModalSchoolTitle').text(`${res.schoolName} (${res.schoolCity || 'N/A'})`);

                    if (res.historyTree && res.historyTree.length > 0) {
                        let html = '';
                        res.historyTree.forEach((item, index) => {
                            let badgeClass = index === 0 ? 'current' : '';
                            let d = new Date(item.assignedDate);
                            let dateStr = `${String(d.getDate()).padStart(2, '0')}/${String(d.getMonth() + 1).padStart(2, '0')}/${d.getFullYear()} ${d.toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' })}`;
                            
                            html += `<div class="timeline-item">
                                <div class="timeline-badge ${badgeClass}"></div>
                                <div class="p-3 bg-light rounded-3 border">
                                    <span class="fw-bold text-dark">${item.newAffiliateName}</span>
                                    <p class="text-muted extra-small m-0">Transferred from: <b>${item.previousAffiliateName || 'Unassigned'}</b></p>
                                    <small class="text-muted d-block mt-2"><i class="bi bi-clock me-1"></i> ${dateStr} | By: ${item.assignedBy}</small>
                                </div>
                            </div>`;
                        });
                        $('#perfTimelineContainer').html(html);
                    } else {
                        $('#perfTimelineContainer').html('<div class="text-center text-muted py-3">No history recorded.</div>');
                    }
                }
            }
        });
    }
</script> *@