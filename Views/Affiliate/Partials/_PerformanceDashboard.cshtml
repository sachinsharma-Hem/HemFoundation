<!-- =============================================================
     JAVASCRIPT LOGIC
============================================================= -->
<script>
    (function() {
        "use strict";

        function getAuthToken() {
            return localStorage.getItem("jwt_token") || sessionStorage.getItem("jwt_token") || "";
        }

        function escapeHtml(value) {
            if (value === null || value === undefined) return "";
            var div = document.createElement("div");
            div.textContent = String(value);
            return div.innerHTML;
        }

        // 1. Load Dashboard Stats (Card 1 Count & others)
        async function initPerformanceDashboard() {
            try {
                var token = getAuthToken();
                var response = await fetch("/api/affiliate-dashboard/stats", {
                    method: "GET",
                    headers: {
                        "Accept": "application/json",
                        "Authorization": token ? "Bearer " + token : ""
                    },
                    credentials: "same-origin",
                    cache: "no-store"
                });

                if (!response.ok) {
                    $('#dashStatus').text('Error loading stats').removeClass('text-success bg-success-subtl border-success-subtle').addClass('text-muted bg-light');
                    return;
                }

                var res = await response.json();
                if (res.success && res.data) {
                    $('#dashStatus').text('Status: Active');
                    // Associated School count update
                    $('#cntAssociatedSchools').text(res.data.associatedSchools || 0);
                }
            } catch (err) {
                console.error("Failed to load dashboard stats", err);
                $('#dashStatus').text('Error loading stats');
            }
        }

        // 2. Open Associated Schools Modal and Fetch Table Data
        window.openAssociatedSchoolsModal = function() {
            var modalEl = document.getElementById("associatedSchoolsModal");
            if (modalEl) bootstrap.Modal.getOrCreateInstance(modalEl).show();

            $('#associatedSchoolsTableBody').html('<tr><td colspan="4" class="text-center py-4"><div class="spinner-border spinner-border-sm text-success"></div> Loading...</td></tr>');

            var token = getAuthToken();
            $.ajax({
                url: '/api/affiliate-dashboard/associated-schools-details',
                type: 'GET',
                headers: { 'Authorization': token ? 'Bearer ' + token : '' },
                success: function(res) {
                    if (res.success) {
                        if (res.data && res.data.length > 0) {
                            let html = '';
                            res.data.forEach(s => {
                                html += `<tr>
                                        <td class="px-3"><span class="badge bg-light text-dark border">#${escapeHtml(s.instituteID || '-')}</span></td>
                                        <td class="px-3 fw-bold text-dark">${escapeHtml(s.name || '-')}</td>
                                        <td class="px-3">${escapeHtml(s.city || '-')}</td>
                                        <td class="px-3">${escapeHtml(s.mobileNo || '-')}</td>
                                    </tr>`;
                            });
                            $('#associatedSchoolsTableBody').html(html);
                        } else {
                            $('#associatedSchoolsTableBody').html('<tr><td colspan="4" class="text-center text-muted py-4">No associated schools found.</td></tr>');
                        }
                    }
                },
                error: function() {
                    $('#associatedSchoolsTableBody').html('<tr><td colspan="4" class="text-center text-danger py-4">Failed to load school details.</td></tr>');
                }
            });
        }

        // Bind Click Event to Card 1 and its button
        var btnSchools = document.getElementById("btnOpenassociatedSchools");
        if (btnSchools) {
            btnSchools.addEventListener("click", (e) => {
                e.stopPropagation();
                openAssociatedSchoolsModal();
            });
        }

        // Initial Call
        initPerformanceDashboard();

    })();
</script>
<!-- =============================================================
     JAVASCRIPT LOGIC (Connected to your API endpoints)
============================================================= -->
<script>
    // Namespace ya Self-Executing function taaki partial view load hone par script turant execute ho
    (function() {
        "use strict";

        function getAuthToken() {
            return localStorage.getItem("jwt_token") || sessionStorage.getItem("jwt_token") || "";
        }

        function escapeHtml(value) {
            if (value === null || value === undefined) return "";
            var div = document.createElement("div");
            div.textContent = String(value);
            return div.innerHTML;
        }

        async function fetchAssignedSchools() {
            try {
                var token = getAuthToken();
                var response = await fetch("/api/affiliate-dashboard/my-assigned-schools", { // Ensure yeh route sahi ho
                    method: "GET",
                    headers: {
                        "Accept": "application/json",
                        "Authorization": token ? "Bearer " + token : ""
                    },
                    credentials: "same-origin",
                    cache: "no-store"
                });

                if (!response.ok) {
                    console.error("API Error Status:", response.status);
                    return [];
                }

                var result = await response.json();
                return (result && result.success && Array.isArray(result.data)) ? result.data : [];
            } catch (error) {
                console.error("Fetch error:", error);
                return [];
            }
        }

        async function loadVolunteerAssignedSchoolCount() {
            var schools = await fetchAssignedSchools();
            var count = schools ? schools.length : 0;

            var schoolCountEl = document.getElementById("lblActiveSchoolCount");
            var modalCountEl = document.getElementById("modalAssignedSchoolCount");

            if (schoolCountEl) schoolCountEl.textContent = count;
            if (modalCountEl) modalCountEl.textContent = count;

            var tableBody = document.getElementById("tblAssignedSchoolsList");
            if (tableBody) {
                if (count === 0) {
                    tableBody.innerHTML = `<tr><td colspan="4" class="text-center py-4 text-muted">No schools assigned.</td></tr>`;
                    return;
                }
                let rows = "";
                schools.forEach((school, index) => {
                    rows += `<tr>
                                <td class="fw-bold text-muted">${index + 1}</td>
                                <td><div class="fw-semibold text-dark">${escapeHtml(school.name || "-")}</div><small class="text-muted">ID: ${escapeHtml(school.instituteID || school.InstituteID || "-")}</small></td>
                                <td><span class="badge bg-primary-subtle text-primary rounded-pill px-3">${escapeHtml(school.assignedDate ? new Date(school.assignedDate).toLocaleDateString() : "-")}</span></td>
                                <td>${escapeHtml(school.assignedBy || "-")}</td>
                            </tr>`;
                });
                tableBody.innerHTML = rows;
            }
        }

        async function loadSummaryCounts() {
            try {
                var token = getAuthToken();
                const res = await fetch("/api/affiliate-dashboard/dashboard-summary-counts", {
                    method: "GET",
                    headers: {
                        "Accept": "application/json",
                        "Authorization": token ? "Bearer " + token : ""
                    },
                    credentials: "same-origin",
                    cache: "no-store"
                });
                const json = await res.json();
                if (json.success && json.data) {
                    document.getElementById("lblTotalStudentCount").textContent = json.data.totalStudents || 0;
                    document.getElementById("lblActiveStudentCount").textContent = json.data.activeStudents || 0;
                    document.getElementById("lblTotalTeacherCount").textContent = json.data.totalTeachers || 0;
                    document.getElementById("lblActiveTeacherCount").textContent = json.data.activeTeachers || 0;
                    document.getElementById("lblTotalSelProjectCount").textContent = json.data.totalSelProjects || 0;
                    document.getElementById("lblFamilyProjectCount").textContent = json.data.familyProjects || 0;
                    document.getElementById("lblIndividualProjectCount").textContent = json.data.individualProjects || 0;
                    document.getElementById("lblGroupPblCount").textContent = json.data.groupPbl || 0;
                }
            } catch (err) {
                console.error("Failed to load summary counts", err);
            }
        }

        // Event Listeners binding
        var btnSchools = document.getElementById("btnOpenAssignedSchools");
        if (btnSchools) {
            btnSchools.addEventListener("click", () => {
                var modalEl = document.getElementById("volunteerSchoolsModal");
                if (modalEl) bootstrap.Modal.getOrCreateInstance(modalEl).show();
            });
        }

        // Initial calls inside partial view
        loadVolunteerAssignedSchoolCount();
        loadSummaryCounts();

    })();
</script>
