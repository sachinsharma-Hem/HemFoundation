         window.loadModalDataPaged=function() {
              const affiliateId = '@affiliateId';
            let pageSize = parseInt($('#modalPageSize').val()) || 100;
            let searchTerm = $('#modalTableSearch').val().trim();

            $.ajax({
                url: `/api/admin/overall-details-paged`,
                type: 'GET',
                data: {
                    category: currentCategory,
                    type: currentType,
                    page: currentPage,
                    pageSize: pageSize,
                    search: searchTerm,
                    affiliateid:affiliateId
                },
                headers: {
                    'Authorization': 'Bearer ' + getAuthToken()
                },
                success: function(res) {
                    if (!res || !res.success || !res.data || res.data.length === 0) {
                        $('#modalTable thead').html('');
                        $('#modalTable tbody').html(`
                                <tr>
                                    <td colspan="100%" class="text-center py-5">
                                        <div class="text-muted">
                                            <i class="bi bi-inbox fs-1 d-block mb-2"></i>
                                            <div class="fw-semibold">No records found</div>
                                            <small>No matching data available for your search criteria.</small>
                                        </div>
                                    </td>
                                </tr>
                            `);
                        $('#modalSubtitle').text('0 records');
                        $('#paginationInfo').text('Showing 0 entries');
                        $('#modalPagination').html('');
                        return;
                    }

                    totalPages = res.totalPages || 1;
                    renderTableHeaders(res.data[0]);
                    renderTableRows(res.data);
                    renderPagination(res.page, res.totalPages, res.totalRecords);
                },
                error: function(xhr) {
                    console.error('Paged API error:', xhr);
                    $('#modalTable tbody').html(`<tr><td colspan="100%" class="text-center py-4 text-danger">Failed to load records from server.</td></tr>`);
                }
            });
        }

        // Render headers with click-to-sort capability
         window.renderTableHeaders=function (sampleRow) {
            if (!sampleRow) return;
            const keys = Object.keys(sampleRow);
            let thead = '<tr>';
            keys.forEach(key => {
                thead += `<th style="cursor: pointer;" onclick="sortModalTable('${key}')">
                                ${formatColumnName(key)} <i class="bi bi-arrow-down-up text-muted small ms-1"></i>
                              </th>`;
            });
            if (currentType === 'total-schools') {
                thead += `<th>Action</th>`;
            }
            thead += '</tr>';
            $('#modalTable thead').html(thead);
        }

        // Client-side sorting toggle for the currently loaded page items
        let sortDirection = {};
         window.sortModalTable=function (key) {
            sortDirection[key] = !sortDirection[key];
            let asc = sortDirection[key];

            // Assuming current page data is stored globally or can be sorted from current rows
            // Let's sort the active rendered table rows directly or maintain a global dataset array.
            let $rows = $('#modalTable tbody tr').toArray();

            // Find column index
            let colIndex = -1;
            $('#modalTable th').each(function(index) {
                if ($(this).text().trim().toLowerCase().includes(formatColumnName(key).toLowerCase())) {
                    colIndex = index;
                }
            });

            if (colIndex === -1) return;

            $rows.sort((a, b) => {
                let valA = $(a).children('td').eq(colIndex).text().trim();
                let valB = $(b).children('td').eq(colIndex).text().trim();

                let numA = parseFloat(valA);
                let numB = parseFloat(valB);

                if (!isNaN(numA) && !isNaN(numB)) {
                    return asc ? numA - numB : numB - numA;
                }
                return asc ? valA.localeCompare(valB) : valB.localeCompare(valA);
            });

            $('#modalTable tbody').empty().append($rows);
        }

         window.renderTableRows=function(data) {
            const keys = Object.keys(data[0]);
            let tbody = '';

            data.forEach(row => {
                tbody += '<tr>';
                keys.forEach(key => {
                    let value = row[key];
                    if (value === null || value === undefined || value === '') value = '-';
                    tbody += `<td>${escapeHtml(value)}</td>`;
                });

                if (currentType === 'total-schools') {
                    let instId = row.instituteId || row.InstituteID || row.id || row.ID || row.instituteID||0;
                    tbody += `<td>
                                    <button type="button" class="btn btn-sm btn-outline-primary" onclick="exportSingleInstituteReport(${instId}, this)">
                                        <i class="bi bi-file-earmark-excel me-1"></i> Export
                                    </button>
                                  </td>`;
                }
                tbody += '</tr>';
            });

            $('#modalTable tbody').html(tbody);
        }

         window.renderPagination=function (page, totalP, totalRec) {
            let startEntry = ((page - 1) * parseInt($('#modalPageSize').val())) + 1;
            let endEntry = Math.min(page * parseInt($('#modalPageSize').val()), totalRec);

            $('#modalSubtitle').text(`${totalRec} total records`);
            $('#paginationInfo').text(`Showing ${startEntry} to ${endEntry} of ${totalRec} entries`);

            let paginationHtml = '';

            // Previous Button
            paginationHtml += `<li class="page-item ${page === 1 ? 'disabled' : ''}">
                                        <a class="page-link" href="#" onclick="changePage(${page - 1})">Prev</a>
                                   </li>`;

            // Page Number Windows
            let maxVisiblePages = 5;
            let startPage = Math.max(1, page - Math.floor(maxVisiblePages / 2));
            let endPage = Math.min(totalP, startPage + maxVisiblePages - 1);

            if (endPage - startPage + 1 < maxVisiblePages) {
                startPage = Math.max(1, endPage - maxVisiblePages + 1);
            }

            for (let i = startPage; i <= endPage; i++) {
                paginationHtml += `<li class="page-item ${i === page ? 'active' : ''}">
                                            <a class="page-link" href="#" onclick="changePage(${i})">${i}</a>
                                       </li>`;
            }

            // Next Button
            paginationHtml += `<li class="page-item ${page === totalP ? 'disabled' : ''}">
                                        <a class="page-link" href="#" onclick="changePage(${page + 1})">Next</a>
                                   </li>`;

            $('#modalPagination').html(paginationHtml);
        }

         window.changePage=function (targetPage) {
            if (targetPage < 1 || targetPage > totalPages) return;
            currentPage = targetPage;
            showModalLoader();
            loadModalDataPaged();
        }

        // Debounced Server-Side Search Input
        $('#modalTableSearch').on('keyup', function() {
            clearTimeout(searchTimeout);
            searchTimeout = setTimeout(() => {
                currentPage = 1;
                showModalLoader();
                loadModalDataPaged();
            }, 400); // 400ms delay to prevent excessive queries while typing
        });

        $('#btnClearSearch').on('click', function() {
            $('#modalTableSearch').val('');
            currentPage = 1;
            showModalLoader();
            loadModalDataPaged();
        });

        $('#modalPageSize').on('change', function() {
            currentPage = 1;
            showModalLoader();
            loadModalDataPaged();
        });

        // Server-side full data export handler
        $('#btnExportModalData').on('click', function() {
            let searchTerm = $('#modalTableSearch').val().trim();
            let exportUrl = `/api/admin/export-details-excel?category=${currentCategory}&type=${currentType}&search=${encodeURIComponent(searchTerm)}&affiliateid=${affiliateId}`;

            showGlobalLoader("Generating Excel Export for Filtered Records...");

            // Trigger file download via temporary anchor
            var $anchor = $('<a />').attr({
                'href': exportUrl,
