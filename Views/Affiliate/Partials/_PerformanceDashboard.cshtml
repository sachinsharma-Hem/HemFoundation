                            href: url,
                            download: filename
                        })
                        .appendTo("body");

                anchor[0].click();

                setTimeout(function () {

                    window.URL.revokeObjectURL(url);
                    anchor.remove();

                }, 100);
            },

            error: function (xhr, status, error) {

                console.error(
                    reportTitle + " export error:",
                    xhr.responseText || error
                );

                alert(
                    "Error downloading report."
                );
            },

            complete: function () {

                hideGlobalLoader();

                $button
                    .prop("disabled", false)
                    .html(originalHtml);
            }
        });
    }


