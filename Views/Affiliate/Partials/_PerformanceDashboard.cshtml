    function getAffiliateIdFromToken() {

        const token =
            getAuthToken();

        if (!token) {
            return 0;
        }

        try {

            const parts =
                token.split(".");

            if (parts.length < 2) {
                return 0;
            }

            const base64 =
                parts[1]
                    .replace(/-/g, "+")
                    .replace(/_/g, "/");

            const payload =
                JSON.parse(atob(base64));

            return (
                payload.nameid ||
                payload[
                    "http://schemas.xmlsoap.org/ws/2005/05/identity/claims/nameidentifier"
                ] ||
                payload.sub ||
                0
            );

        } catch (error) {

            console.error(
                "Unable to read affiliate ID:",
                error
            );

            return 0;
        }
    }


