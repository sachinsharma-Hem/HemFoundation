@using Microsoft.AspNetCore.Http
@{
    var affiliateId = Context.Session.GetInt32("UserID") ?? 0;
}
<div class="card shadow-sm rounded-4 bg-white p-4 animate-fade-in" style="border: 1px solid #d9dfe5 !important;">
    <!-- Header Section -->
    <div class="d-flex align-items-center justify-content-between mb-4 pb-3 border-bottom">
        <div>
            <h4 class="fw-bold text-success mb-1"><i class="bi bi-speedometer2 me-2"></i>Performance Dashboard</h4>
            <p class="text-muted small m-0">Real-time statistics, school data, and user activity overview.</p>
        </div>
    </div>

    <!-- Stats Grid System (9 Cards) -->
    <div class="row g-3 mb-4">

        <!-- Card 1: Associated School (Primary Blue) -->
        <div class="col-xl-3 col-lg-4 col-md-6"  >
            <div class="card text-white bg-primary border-0 shadow-sm h-100 rounded-3 overflow-hidden cursor-pointer" >
                <div class="card-body p-3 d-flex flex-column justify-content-between">
                    <div>
                        <h2 class="fw-bold mb-1" id="lblTotalAssociatedSchool">0</h2>
                        <p class="card-text small mb-2">Associated School</p>
                    </div>
                    <div>
                        <button type="button" id="btnOpenassociatedSchools" onclick="event.stopPropagation(); openDetailsModal('performance','total-schools');" class="btn btn-sm btn-light text-primary fw-bold py-0 px-2 rounded-pill" style="font-size: 0.75rem;">More Info <i class="bi bi-arrow-right"></i></button>
                    </div>
                </div>
            </div>
        </div>

        <!-- Card 2: Associated Student (Success Green) -->
        <div class="col-xl-3 col-lg-4 col-md-6">
            <div class="card text-white bg-success border-0 shadow-sm h-100 rounded-3 overflow-hidden">
                <div class="card-body p-3 d-flex flex-column justify-content-between">
                    <div>
                        <h2 class="fw-bold mb-1" id="lblTotalStudentCount">0</h2>
                        <p class="card-text small mb-2">Associated Student</p>
                    </div>
                    <div>
                        <button type="button" id="btnOpenTotalStudentss" onclick="event.stopPropagation(); openDetailsModal('performance','total-students')" class="btn btn-sm btn-light text-success fw-bold py-0 px-2 rounded-pill" style="font-size: 0.75rem;">More Info <i class="bi bi-arrow-right"></i></button>
                    </div>
                </div>
            </div>
        </div>

        <!-- Card 3: Active Student (Warning Yellow) -->
        <div class="col-xl-3 col-lg-4 col-md-6">
            <div class="card text-dark bg-warning border-0 shadow-sm h-100 rounded-3 overflow-hidden">
                <div class="card-body p-3 d-flex flex-column justify-content-between">
                    <div>
                        <h2 class="fw-bold mb-1" id="lblActiveStudentCount">0</h2>
                        <p class="card-text small mb-2">Active Student</p>
                    </div>
                    <div>
                        <button type="button" id="btn_ExportAdminStudentsReport" onclick="event.stopPropagation();"  class="btn btn-sm btn-dark text-warning fw-bold py-0 px-2 rounded-pill" style="font-size: 0.75rem;">More Info <i class="bi bi-arrow-right"></i></button>
                    </div>
                </div>
            </div>
        </div>

        <!-- Card 4: Associated Teacher (Info Cyan) -->
        <div class="col-xl-3 col-lg-4 col-md-6">
            <div class="card text-white bg-info border-0 shadow-sm h-100 rounded-3 overflow-hidden">
                <div class="card-body p-3 d-flex flex-column justify-content-between">
                    <div>
                        <h2 class="fw-bold mb-1" id="lblTotalTeacherCount">0</h2>
                        <p class="card-text small mb-2">Associated Teacher</p>
                    </div>
                    <div>
                        <button type="button" id="btnOpenTotalTeacherss" onclick="event.stopPropagation(); openDetailsModal('performance','total-teachers')" class="btn btn-sm btn-light text-info fw-bold py-0 px-2 rounded-pill" style="font-size: 0.75rem;">More Info <i class="bi bi-arrow-right"></i></button>
                    </div>
                </div>
            </div>
        </div>

        <!-- Card 5: Active Teacher (Danger Red) -->
        <div class="col-xl-3 col-lg-4 col-md-6">
            <div class="card text-white bg-danger border-0 shadow-sm h-100 rounded-3 overflow-hidden">
                <div class="card-body p-3 d-flex flex-column justify-content-between">
                    <div>
                        <h2 class="fw-bold mb-1" id="lblActiveTeacherCount">0</h2>
                        <p class="card-text small mb-2">Active Teacher</p>
                    </div>
                    <div>
                        <button type="button" id="btnOpenActiveTeacherss" onclick="event.stopPropagation(); openDetailsModal('performance','active-teachers')" class="btn btn-sm btn-light text-danger fw-bold py-0 px-2 rounded-pill" style="font-size: 0.75rem;">More Info <i class="bi bi-arrow-right"></i></button>
                    </div>
                </div>
            </div>
        </div>

        <!-- Card 6: No. Of SEL Submission School (Secondary Gray) -->
        <div class="col-xl-3 col-lg-4 col-md-6">
            <div class="card text-white bg-secondary border-0 shadow-sm h-100 rounded-3 overflow-hidden">
                <div class="card-body p-3 d-flex flex-column justify-content-between">
                    <div>
                        <h2 class="fw-bold mb-1" id="lblTotalSelProjectCount">0</h2>
                        <p class="card-text small mb-2">No. Of SEL Submission School</p>
                    </div>
                    <div>
                        <button type="button" id="btn_ExportPerfSelSubmissions" class="btn btn-sm btn-light text-secondary fw-bold py-0 px-2 rounded-pill" style="font-size: 0.75rem;">More Info <i class="bi bi-arrow-right"></i></button>
                    </div>
                </div>
            </div>
        </div>

        <!-- Card 7: No. Of Group Project Submission (Dark) -->
        <div class="col-xl-3 col-lg-4 col-md-6">
            <div class="card text-white bg-dark border-0 shadow-sm h-100 rounded-3 overflow-hidden">
                <div class="card-body p-3 d-flex flex-column justify-content-between">
                    <div>
                        <h2 class="fw-bold mb-1" id="lblGroupPblCount">0</h2>
                        <p class="card-text small mb-2">No. Of Group Project Submission</p>
                    </div>
                    <div>
                        <button type="button" id="btnOpenGroupPbl" class="btn btn-sm btn-light text-dark fw-bold py-0 px-2 rounded-pill" style="font-size: 0.75rem;">More Info <i class="bi bi-arrow-right"></i></button>
                    </div>
                </div>
            </div>
        </div>

        <!-- Card 8: No. Of Family Project Submission (Indigo/Custom Gradient or Dark Subtly Styled) -->
        <div class="col-xl-3 col-lg-4 col-md-6">
            <div class="card text-white border-0 shadow-sm h-100 rounded-3 overflow-hidden" style="background-color: #6610f2 !important;">
                <div class="card-body p-3 d-flex flex-column justify-content-between">
                    <div>
                        <h2 class="fw-bold mb-1" id="lblFamilyProjectCount">0</h2>
                        <p class="card-text small mb-2">No. Of Family Project Submission</p>
                    </div>
                    <div>
                        <button type="button" id="btn_ExportPerfFamilyPbl" class="btn btn-sm btn-light fw-bold py-0 px-2 rounded-pill" style="font-size: 0.75rem; color: #6610f2 !important;">More Info <i class="bi bi-arrow-right"></i></button>
                    </div>
                </div>
            </div>
        </div>

        <!-- Card 9: No. Of Individual Project Submission (Light Bordered) -->
        <div class="col-xl-3 col-lg-4 col-md-6">
            <div class="card text-dark bg-light border border-secondary-subtle shadow-sm h-100 rounded-3 overflow-hidden">
                <div class="card-body p-3 d-flex flex-column justify-content-between">
                    <div>
                        <h2 class="fw-bold mb-1 text-dark" id="lblIndividualProjectCount">0</h2>
                        <p class="card-text small mb-2 text-muted">No. Of Individual Project Submission</p>
                    </div>
                    <div>
                        <button type="button" id="btn_ExportPerfIndividualPbl" class="btn btn-sm btn-dark text-white fw-bold py-0 px-2 rounded-pill" style="font-size: 0.75rem;">More Info <i class="bi bi-arrow-right"></i></button>
                    </div>
                </div>
            </div>
        </div>

    </div>

    <!-- Footer Note -->
    <div class="text-center py-3 text-muted border rounded-3 bg-light-subtle small">
        <i class="bi bi-info-circle me-1"></i> All metrics update automatically based on system live records.
    </div>

<!-- =============================================================
     ASSIGNED SCHOOLS MODAL (For Card 1)
============================================================= -->
<div class="modal fade" id="volunteerSchoolsModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content rounded-4 border-0 shadow-lg bg-white">
            <div class="modal-header border-bottom px-4 py-3">
                <h5 class="fw-bold text-dark m-0"><i class="bi bi-building text-primary me-2"></i> My Assigned Schools</h5>
                <button type="button" class="btn-close shadow-none" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-4">
                <div class="table-responsive">
                    <table class="table table-hover align-middle small mb-0">
                        <thead class="table-light text-muted">
                            <tr><th style="width:60px;">#</th><th>School</th><th>Assigned Date</th><th>Assigned By</th></tr>
                        </thead>
                        <tbody id="tblAssignedSchoolsList">
                            <tr><td colspan="4" class="text-center py-4 text-muted"><span class="spinner-border spinner-border-sm me-2"></span> Loading schools...</td></tr>
                        </tbody>
                    </table>
                </div>
            </div>
            <div class="modal-footer border-top px-4 py-3">
                <span class="text-muted small me-auto">Total Assigned: <strong id="modalAssignedSchoolCount">0</strong></span>
                <button type="button" class="btn btn-secondary btn-sm rounded-pill px-4" data-bs-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>

<!-- =============================================================
     REUSABLE GENERIC DETAIL MODAL (For Cards 2 to 9)
============================================================= -->
<div class="modal fade" id="genericDetailModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-xl">
        <div class="modal-content rounded-4 border-0 shadow-lg bg-white">
            <div class="modal-header border-bottom px-4 py-3">
                <div>
                    <h5 class="fw-bold text-dark m-0" id="genericModalTitle">
                        <i class="bi bi-list-task text-primary me-2"></i> Details List
                    </h5>
                    <small class="text-muted" id="genericModalSubtitle">Records associated with your assigned scope</small>
                </div>
                <button type="button" class="btn-close shadow-none" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-4">
                <div class="table-responsive" style="max-height: 450px; overflow-y: auto;">
                    <table class="table table-hover align-middle small mb-0">
                        <thead class="table-light text-muted sticky-top" id="genericTableHead">
                            <tr><th>#</th><th>Details</th></tr>
                        </thead>
                        <tbody id="genericTableBody">
                            <tr><td colspan="5" class="text-center py-5 text-muted"><span class="spinner-border spinner-border-sm me-2"></span> Loading...</td></tr>
                        </tbody>
                    </table>
                </div>
            </div>
            <div class="modal-footer border-top px-4 py-3">
                <span class="text-muted small me-auto">Total Records: <strong id="genericModalCount">0</strong></span>
                <button type="button" class="btn btn-secondary btn-sm rounded-pill px-4" data-bs-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>
<!-- DETAILS MODAL WITH SERVER-SIDE PAGINATION & SEARCH -->
<!-- ========================================================= -->

<div class="modal fade"
     id="dashboardDetailsModal"
     tabindex="-1"
     aria-hidden="true">

    <div class="modal-dialog modal-fullscreen">

        <div class="modal-content rounded-4 border-0 shadow-lg">

            <!-- MODAL HEADER -->
            <div class="modal-header border-bottom px-4 py-3 flex-wrap gap-3">

                <div>
                    <h5 class="fw-bold text-dark mb-1" id="modalTitle">
                        Records List
                    </h5>
                    <small class="text-muted" id="modalSubtitle">
                        Loading records...
                    </small>
                </div>

                <!-- SEARCH & CONTROLS TOOLBAR -->
                <div class="d-flex align-items-center gap-3 ms-auto flex-wrap">
                    <!-- Server-Side Search Bar -->
                    <div class="input-group input-group-sm" style="width: 250px;">
                        <span class="input-group-text bg-light border-end-0"><i class="bi bi-search text-muted"></i></span>
                        <input type="text" id="modalTableSearch" class="form-control border-start-0 shadow-none" placeholder="Search database...">
                        <button class="btn btn-outline-secondary border-start-0" type="button" id="btnClearSearch"><i class="bi bi-x"></i></button>
                    </div>

                    <!-- Page Size Selector -->
                    <select id="modalPageSize" class="form-select form-select-sm shadow-none" style="width: 100px;">
                        <option value="25">25 rows</option>
                        <option value="50">50 rows</option>
                        <option value="100" selected>100 rows</option>
                        <option value="250">250 rows</option>
                         <option value="250">250 rows</option>
                        <option value="500">500 rows</option>
                        <option value="1000">1000 rows</option>
                        <option value="10000">10000 rows</option>
                    </select>

                    <!-- Export Button -->
                    <button type="button" class="btn btn-sm btn-success shadow-sm" id="btnExportModalData">
                        <i class="bi bi-file-earmark-excel me-1"></i> Export Excel
                    </button>
                </div>

                <button type="button" class="btn-close shadow-none" data-bs-dismiss="modal"></button>

            </div>

            <!-- MODAL BODY -->
            <div class="modal-body p-4">

                    <div class="table-responsive border rounded-3 modal-table-wrapper" style="max-height:auto; height: fit-content;">
                    <table class="table table-hover align-middle mb-0" id="modalTable">
                        <thead class="table-light"></thead>
                        <tbody></tbody>
                    </table>
                </div>

            </div>

            <!-- MODAL FOOTER WITH PAGINATION -->
            <div class="modal-footer border-top px-4 py-3 justify-content-between align-items-center bg-light rounded-bottom-4">
                <div class="text-muted small" id="paginationInfo">
                    Showing 0 to 0 of 0 entries
                </div>

                <nav aria-label="Modal Pagination">
                    <ul class="pagination pagination-sm mb-0" id="modalPagination">
                        <!-- Dynamically injected pagination buttons -->
                    </ul>
                </nav>
            </div>

        </div>

    </div>

</div>
<!-- ========================================================= -->
<!-- =============================================================
     ASSOCIATED SCHOOLS DETAILS MODAL
     ============================================================= -->

<div class="modal fade"
     id="associatedSchoolsModal"
     tabindex="-1"
     aria-hidden="true">

    <div class="modal-dialog modal-dialog-centered modal-fullscreen-sm-down"
         style="max-width: 98vw !important;">

        <div class="modal-content rounded-4 border-0 shadow-lg bg-white"
             style="border-top: 5px solid #198754 !important;">

            <!-- HEADER -->
            <div class="modal-header border-bottom px-4 py-3 align-items-center">

                <div class="d-flex align-items-center">

                    <div class="bg-success-subtle text-success p-3 rounded-4 me-3 fs-4 d-flex align-items-center justify-content-center"
                         style="width: 52px; height: 52px;">
                        <i class="bi bi-building-check"></i>
                    </div>

                    <div>
                        <h4 class="fw-bold text-dark mb-1">
                            Associated Schools Directory
                        </h4>

                        <p class="text-muted small mb-0">
                            Complete details of schools currently mapped under your referral network.
                        </p>
                    </div>

                </div>

                <button type="button"
                        class="btn-close shadow-none fs-5"
                        data-bs-dismiss="modal"
                        aria-label="Close">
                </button>

            </div>

            <!-- BODY -->
            <div class="modal-body p-3 overflow-hidden">

                <!-- INFORMATION BAR -->
                <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">

    <div class="d-flex align-items-center gap-2">

        <span class="badge bg-success-subtle text-success px-3 py-2 rounded-pill">
            <i class="bi bi-buildings me-1"></i>
            Associated Schools
        </span>

        <span class="badge bg-light text-dark border px-3 py-2 rounded-pill">
            Total:
            <strong id="associatedSchoolsTotalCount">0</strong>
        </span>

    </div>

    <div class="d-flex align-items-center gap-2">

        <small class="text-muted d-none d-lg-inline">
            <i class="bi bi-arrows-expand me-1"></i>
            Use the horizontal scrollbar below to view all columns
        </small>

        <button type="button"
                id="btnExportAssociatedSchools"
                class="btn btn-success btn-sm rounded-pill px-3 shadow-sm">

            <i class="bi bi-file-earmark-excel me-1"></i>
            Export Excel

        </button>

    </div>

</div>

                <!-- TABLE SCROLL CONTAINER -->
                <div class="associated-schools-table-wrapper">

                    <table class="table table-hover table-bordered align-middle mb-0 bg-white"
                           id="associatedSchoolsDetailsTable">

                        <thead class="table-light text-uppercase small">

                            <tr>
                                <th>School ID</th>
                                <th>Institute Type</th>
                                <th>School Name</th>
                                <th>Institute Active</th>
                                <th>Referral Code</th>
                                <th>First Name</th>
                                <th>Last Name</th>
                                <th>Mobile No.</th>
                                <th>Email ID</th>
                                <th>Address</th>
                                <th>Address 2</th>
                                <th>City</th>
                                <th>Pincode</th>
                                <th>User Active</th>
                                <th>Created Date</th>
                                <th>Modified Date</th>
                                <th class="text-center">Associated Students</th>
                                <th class="text-center">Active Students</th>
                                <th class="text-center">Total Teachers</th>
                                <th class="text-center">Active Teachers</th>
                            </tr>

                        </thead>

                        <tbody id="associatedSchoolsTableBody">

                            <tr>
                                <td colspan="27" class="text-center py-5">
                                    <div class="spinner-border text-success spinner-border-sm me-2"
                                         role="status"></div>

                                    <span class="text-muted fw-semibold">
                                        Loading associated schools...
                                    </span>
                                </td>
                            </tr>

                        </tbody>

                    </table>

                </div>

            </div>

            <!-- FOOTER -->
            <div class="modal-footer border-top px-4 py-3 d-flex justify-content-between align-items-center">

                <div class="text-muted small">
                    <i class="bi bi-info-circle me-1"></i>
                    Showing complete school information from active system records.
                </div>

                <button type="button"
                        class="px-4 btn btn-secondary btn-sm rounded-pill shadow-none"
                        data-bs-dismiss="modal">
                    Close
                </button>

            </div>

        </div>
    </div>
</div>
<div id="globalLoader" class="global-loader-overlay" style="display: none;">
    <div class="text-center">
        <div class="spinner-border text-primary shadow-lg" style="width: 3.5rem; height: 3.5rem;" role="status">
            <span class="visually-hidden">Loading...</span>
        </div>
        <div class="fw-bold text-dark mt-3 fs-5" id="globalLoaderText">Generating Report, Please Wait...</div>
    </div>
</div>



<style>

    .cursor-pointer {
        cursor: pointer;
    }

    /* Main scroll area */
    .associated-schools-table-wrapper {
        width: 100%;
        max-width: 100%;
        height: 550px;
        max-height: 550px;

        overflow-x: auto !important;
        overflow-y: auto !important;

        display: block;

        border: 1px solid #dee2e6;
        border-radius: 10px;

        background: #ffffff;

        position: relative;

        -webkit-overflow-scrolling: touch;
    }

    /* Force table to be wider than modal so horizontal scrollbar appears */
    #associatedSchoolsDetailsTable {
        width: max-content !important;
        min-width: 3000px !important;

        margin: 0 !important;
        table-layout: auto !important;
    }

    #associatedSchoolsDetailsTable th,
    #associatedSchoolsDetailsTable td {
        vertical-align: middle;
    }

    /* Sticky header */
    #associatedSchoolsDetailsTable thead th {
        position: sticky;
        top: 0;
        z-index: 20;

        background-color: #f8f9fa !important;

        color: #495057;

        font-size: 12px;
        font-weight: 700;

        white-space: nowrap;

        padding: 12px 10px;

        border-bottom: 2px solid #dee2e6;
    }

    /* Normal cells */
    #associatedSchoolsDetailsTable tbody td {
        font-size: 13px;
        padding: 10px;
        white-space: nowrap;
    }

    /* School name */
    #associatedSchoolsDetailsTable th:nth-child(3),
    #associatedSchoolsDetailsTable td:nth-child(3) {
        min-width: 190px;
        max-width: 220px;
    }

    #associatedSchoolsDetailsTable td:nth-child(3) {
        white-space: normal;
        word-break: break-word;
    }

    /* Email */
    #associatedSchoolsDetailsTable th:nth-child(11),
    #associatedSchoolsDetailsTable td:nth-child(11) {
        min-width: 230px;
    }

    /* Address columns */
    #associatedSchoolsDetailsTable th:nth-child(12),
    #associatedSchoolsDetailsTable td:nth-child(12),
    #associatedSchoolsDetailsTable th:nth-child(13),
    #associatedSchoolsDetailsTable td:nth-child(13),
    #associatedSchoolsDetailsTable th:nth-child(14),
    #associatedSchoolsDetailsTable td:nth-child(14) {
        min-width: 220px;
        max-width: 320px;
    }

    #associatedSchoolsDetailsTable td:nth-child(12),
    #associatedSchoolsDetailsTable td:nth-child(13),
    #associatedSchoolsDetailsTable td:nth-child(14) {
        white-space: normal;
        word-break: break-word;
    }

    /* Counts */
    #associatedSchoolsDetailsTable th:nth-child(n+24),
    #associatedSchoolsDetailsTable td:nth-child(n+24) {
        min-width: 135px;
        text-align: center;
    }

    /* URL columns */
    .school-url {
        display: inline-block;
        max-width: 150px;
        overflow: hidden;
        text-overflow: ellipsis;
        vertical-align: middle;
        white-space: nowrap;
    }

    /* Status badges */
    .school-status-badge {
        min-width: 65px;
        display: inline-block;
        text-align: center;
    }

    /* Count badges */
    .school-count-badge {
        min-width: 55px;
        display: inline-block;
        text-align: center;
    }

    /* Horizontal scrollbar */
    .associated-schools-table-wrapper::-webkit-scrollbar {
        width: 11px;
        height: 12px;
    }

    .associated-schools-table-wrapper::-webkit-scrollbar-track {
        background: #f1f3f5;
        border-radius: 10px;
    }

    .associated-schools-table-wrapper::-webkit-scrollbar-thumb {
        background: #adb5bd;
        border-radius: 10px;
        border: 2px solid #f1f3f5;
    }

    .associated-schools-table-wrapper::-webkit-scrollbar-thumb:hover {
        background: #6c757d;
    }

    /* Firefox */
    .associated-schools-table-wrapper {
        scrollbar-width: auto;
        scrollbar-color: #adb5bd #f1f3f5;
    }
    
    /* ================= GLOBAL LOADER OVERLAY ================= */
    .global-loader-overlay {
        position: fixed;
        top: 0;
        left: 0;
        width: 100vw;
        height: 100vh;
        background: rgba(255, 255, 255, 0.85);
        backdrop-filter: blur(4px);
        z-index: 99999;
        display: flex;
        justify-content: center;
        align-items: center;
        flex-direction: column;
        transition: opacity 0.2s ease-in-out;
    }
</style>


<!-- =============================================================
     CONSOLIDATED DASHBOARD JAVASCRIPT
     ============================================================= -->
<script>
    const affiliateId = '@affiliateId';

    //console.log("Affiliate ID from Session:", affiliateId);
</script>
<script>
(function () {
    "use strict";

    /* ============================================================
       COMMON HELPERS
       ============================================================ */

    window.getAuthToken = function () {
        return localStorage.getItem("jwt_token") ||
               sessionStorage.getItem("jwt_token") ||
               "";
    };

    window.escapeHtml = function (value) {
        if (value === null || value === undefined) {
            return "";
        }

        return $("<div>")
            .text(String(value))
            .html();
    };

    window.formatColumnName = function (key) {
        if (!key) {
            return "";
        }

        let result = String(key)
            .replace(/([a-z])([A-Z])/g, "$1 $2")
            .replace(/_/g, " ")
            .replace(/-/g, " ");

        return result.charAt(0).toUpperCase() + result.slice(1);
    };

    window.formatDate = function (value) {
        if (!value) {
            return "-";
        }

        const date = new Date(value);

        if (isNaN(date.getTime())) {
            return escapeHtml(value);
        }

        return date.toLocaleDateString("en-IN", {
            day: "2-digit",
            month: "short",
            year: "numeric"
        });
    };

    window.getStatusBadge = function (value) {
        const active =
            value === true ||
            value === 1 ||
            value === "1" ||
            value === "true" ||
            value === "True";

        return active
            ? '<span class="badge bg-success-subtle text-success school-status-badge">Active</span>'
            : '<span class="badge bg-secondary-subtle text-secondary school-status-badge">Inactive</span>';
    };

