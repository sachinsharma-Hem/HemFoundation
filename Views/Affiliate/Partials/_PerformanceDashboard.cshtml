<div class="card shadow-sm rounded-4 bg-white p-4 animate-fade-in" style="border: 1px solid #d9dfe5 !important;">
    <div class="d-flex align-items-center justify-content-between mb-4 pb-3 border-bottom">
        <div>
            <h4 class="fw-bold text-danger mb-1"><i class="bi bi-speedometer2 me-2"></i> Performance Dashboard</h4>
            <p class="text-muted small m-0">Real-time statistics, school data, and user activity overview.</p>
        </div>
        <span class="badge bg-danger-subtle text-danger px-3 py-2 rounded-pill fw-semibold border border-danger-subtle" id="dashStatus">Loading...</span>
    </div>

    <div class="row g-3 mb-4">
        
        <div class="col-xl-3 col-lg-4 col-md-6">
            <div class="card text-white bg-info border-0 shadow-sm h-100 rounded-3 overflow-hidden cursor-pointer" onclick="openAssociatedSchoolsModal()">
                <div class="card-body p-3">
                    <h2 class="fw-bold mb-1" id="cntAssociatedSchools"><span class="spinner-border spinner-border-sm"></span></h2>
                    <p class="card-text small mb-0">Associated School</p>
                </div>
                <div class="card-footer text-white text-decoration-none bg-black bg-opacity-10 border-0 py-2 px-3 small d-flex align-items-center justify-content-between">
                    <span>Click for Details</span>
                    <i class="bi bi-arrow-right-circle"></i>
                </div>
            </div>
        </div>

        <div class="col-xl-3 col-lg-4 col-md-6">
            <div class="card text-white bg-success border-0 shadow-sm h-100 rounded-3 overflow-hidden">
                <div class="card-body p-3">
                    <h2 class="fw-bold mb-1" id="cntAssociatedStudents"><span class="spinner-border spinner-border-sm"></span></h2>
                    <p class="card-text small mb-0">Associated Student</p>
                </div>
                <a href="#" class="card-footer text-white text-decoration-none bg-black bg-opacity-10 border-0 py-2 px-3 small d-flex align-items-center justify-content-between">
                    <span>More Info</span>
                    <i class="bi bi-arrow-right-circle"></i>
                </a>
            </div>
        </div>

        <div class="col-xl-3 col-lg-4 col-md-6">
            <div class="card text-dark bg-warning border-0 shadow-sm h-100 rounded-3 overflow-hidden">
                <div class="card-body p-3">
                    <h2 class="fw-bold mb-1" id="cntActiveStudents"><span class="spinner-border spinner-border-sm"></span></h2>
                    <p class="card-text small mb-0">Active Student</p>
                </div>
                <a href="#" class="card-footer text-dark text-decoration-none bg-black bg-opacity-10 border-0 py-2 px-3 small d-flex align-items-center justify-content-between">
                    <span>More Info</span>
                    <i class="bi bi-arrow-right-circle"></i>
                </a>
            </div>
        </div>

        <div class="col-xl-3 col-lg-4 col-md-6">
            <div class="card text-white bg-success border-0 shadow-sm h-100 rounded-3 overflow-hidden">
                <div class="card-body p-3">
                    <h2 class="fw-bold mb-1" id="cntAssociatedTeachers"><span class="spinner-border spinner-border-sm"></span></h2>
                    <p class="card-text small mb-0">Associated Teacher</p>
                </div>
                <a href="#" class="card-footer text-white text-decoration-none bg-black bg-opacity-10 border-0 py-2 px-3 small d-flex align-items-center justify-content-between">
                    <span>More Info</span>
                    <i class="bi bi-arrow-right-circle"></i>
                </a>
            </div>
        </div>
        
        <div class="col-xl-3 col-lg-4 col-md-6">
            <div class="card text-white bg-primary border-0 shadow-sm h-100 rounded-3 overflow-hidden">
                <div class="card-body p-3">
                    <h2 class="fw-bold mb-1" id="cntNewSchools"><span class="spinner-border spinner-border-sm"></span></h2>
                    <p class="card-text small mb-0">No. Of New School</p>
                </div>
                <a href="#" class="card-footer text-white text-decoration-none bg-black bg-opacity-10 border-0 py-2 px-3 small d-flex align-items-center justify-content-between">
                    <span>More Info</span>
                    <i class="bi bi-arrow-right-circle"></i>
                </a>
            </div>
        </div>

    </div>

    <div class="text-center py-3 text-muted border rounded-3 bg-light-subtle small">
        <i class="bi bi-info-circle me-1"></i> All metrics update automatically based on system live records.
    </div>
</div>

<div class="modal fade" id="associatedSchoolsModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content rounded-4 border-0 shadow-lg p-3 bg-white">
            <div class="modal-header border-bottom pb-3">
                <div>
                    <h5 class="fw-bold text-dark m-0"><i class="bi bi-building-check text-primary me-2"></i> Associated Schools</h5>
                    <small class="text-muted">Schools currently mapped to you.</small>
                </div>
                <button type="button" class="btn-close shadow-none" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body py-4">
                <div class="table-responsive" style="max-height: 400px; overflow-y: auto;">
                    <table class="table table-hover align-middle small">
                        <thead class="table-light text-muted">
                            <tr>
                                <th>School ID</th>
                                <th>School Name</th>
                                <th>Location</th>
                                <th>Contact</th>
                                <th class="text-center">Action</th>
                            </tr>
                        </thead>
                        <tbody id="associatedSchoolsTableBody">
                            <tr><td colspan="5" class="text-center py-4"><div class="spinner-border spinner-border-sm"></div> Loading...</td></tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="perfSchoolHistoryModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-md">
        <div class="modal-content rounded-4 border-0 shadow-lg p-3 bg-white">
            <div class="modal-header border-bottom pb-3">
                <div>
                    <h5 class="fw-bold text-dark m-0"><i class="bi bi-diagram-2-fill text-success me-2"></i> Mapping Lifecycle Tree</h5>
                    <small class="text-muted" id="perfModalSchoolTitle">School Name</small>
                </div>
                <button type="button" class="btn-close shadow-none" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body py-4">
                <div class="timeline-tree position-relative ps-4" id="perfTimelineContainer">
                    <div class="text-center text-muted py-3"><div class="spinner-border spinner-border-sm"></div> Loading lifecycle tree...</div>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .cursor-pointer { cursor: pointer; }
    /* Timeline styles required for the modal */
    .timeline-tree::before { content: ''; position: absolute; left: 12px; top: 5px; bottom: 5px; width: 3px; background: #e9ecef; border-radius: 2px; }
    .timeline-item { position: relative; margin-bottom: 24px; }
    .timeline-item:last-child { margin-bottom: 0; }
    .timeline-badge { position: absolute; left: -28px; top: 2px; width: 18px; height: 18px; border-radius: 50%; background: #0d6efd; border: 3px solid #fff; box-shadow: 0 0 0 2px rgba(13, 110, 253, 0.2); }
    .timeline-badge.current { background: #198754; box-shadow: 0 0 0 3px rgba(25, 135, 84, 0.25); }
</style>

<script>
    // Note: Since this is a partial view loaded dynamically, we don't use document.addEventListener("DOMContentLoaded")
    // as it might have already fired. We execute the init function immediately.
    
    $(function() {
        initPerformanceDashboard();
    });

    function initPerformanceDashboard() {
        $.ajax({
            // 👉 CORRECTED URL: Naye ApiController ka route
            url: '/api/affiliate-dashboard/stats', 
            type: 'GET',
            headers: { 'Authorization': 'Bearer ' + (localStorage.getItem('jwt_token') || sessionStorage.getItem('jwt_token') || '') },
            success: function(res) {
                if(res.success) {
                    $('#dashStatus').text('Status: Active');
                    $('#cntAssociatedSchools').text(res.data.associatedSchools);
                    $('#cntAssociatedStudents').text(res.data.associatedStudents);
                    $('#cntActiveStudents').text(res.data.activeStudents);
                    $('#cntAssociatedTeachers').text(res.data.associatedTeachers);
                    $('#cntNewSchools').text(res.data.newSchools);
                    // Update other IDs accordingly
                }
            },
            error: function() {
                $('#dashStatus').text('Error loading stats').removeClass('text-danger bg-danger-subtle').addClass('text-muted bg-light');
                $('.card h2').text('-');
            }
        });
    }

    function openAssociatedSchoolsModal() {
        $('#associatedSchoolsModal').modal('show');
        $('#associatedSchoolsTableBody').html('<tr><td colspan="5" class="text-center py-4"><div class="spinner-border spinner-border-sm"></div> Loading...</td></tr>');

        $.ajax({
            // 👉 CORRECTED URL: Naye ApiController ka route
            url: '/api/affiliate-dashboard/associated-schools-details',
            type: 'GET',
            headers: { 'Authorization': 'Bearer ' + (localStorage.getItem('jwt_token') || sessionStorage.getItem('jwt_token') || '') },
            success: function(res) {
                if(res.success) {
                    if(res.data && res.data.length > 0) {
                        let html = '';
                        res.data.forEach(s => {
                            html += `<tr>
                                <td><span class="badge bg-light text-dark border">#${s.instituteID}</span></td>
                                <td class="fw-bold text-dark">${s.name}</td>
                                <td>${s.city || '-'}, ${s.state || ''}</td>
                                <td>${s.mobileNo || '-'}</td>
                                <td class="text-center">
                                    <button class="btn btn-outline-success btn-sm rounded-pill px-3 shadow-none" onclick="viewPerfSchoolHistory(${s.instituteID})">
                                        <i class="bi bi-diagram-2 me-1"></i> History
                                    </button>
                                </td>
                            </tr>`;
                        });
                        $('#associatedSchoolsTableBody').html(html);
                    } else {
                        $('#associatedSchoolsTableBody').html('<tr><td colspan="5" class="text-center text-muted py-4">No associated schools found.</td></tr>');
                    }
                }
            }
        });
    }

    // Reuse the history view logic specifically for this dashboard
    function viewPerfSchoolHistory(instituteId) {
        $('#perfSchoolHistoryModal').modal('show');
        $('#perfTimelineContainer').html('<div class="text-center text-muted py-3"><div class="spinner-border spinner-border-sm"></div> Loading...</div>');

        $.ajax({
            // 👉 Yeh bilkul SAHI hai! Kyunki History wala endpoint abhi bhi purane (mapping) controller mein hi hai.
            url: `/api/affiliate-school-mapping/school-history/${instituteId}`,
            type: 'GET',
            headers: { 'Authorization': 'Bearer ' + (localStorage.getItem('jwt_token') || sessionStorage.getItem('jwt_token') || '') },
            success: function (res) {
                if (res.success) {
                    $('#perfModalSchoolTitle').text(`${res.schoolName} (${res.schoolCity || 'N/A'})`);

                    if (res.historyTree && res.historyTree.length > 0) {
                        let html = '';
                        res.historyTree.forEach((item, index) => {
                            let badgeClass = index === 0 ? 'current' : '';
                            let d = new Date(item.assignedDate);
                            let dateStr = `${String(d.getDate()).padStart(2, '0')}/${String(d.getMonth() + 1).padStart(2, '0')}/${d.getFullYear()} ${d.toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' })}`;
                            
                            html += `<div class="timeline-item">
                                <div class="timeline-badge ${badgeClass}"></div>
                                <div class="p-3 bg-light rounded-3 border">
                                    <span class="fw-bold text-dark">${item.newAffiliateName}</span>
                                    <p class="text-muted extra-small m-0">Transferred from: <b>${item.previousAffiliateName || 'Unassigned'}</b></p>
                                    <small class="text-muted d-block mt-2"><i class="bi bi-clock me-1"></i> ${dateStr} | By: ${item.assignedBy}</small>
                                </div>
                            </div>`;
                        });
                        $('#perfTimelineContainer').html(html);
                    } else {
                        $('#perfTimelineContainer').html('<div class="text-center text-muted py-3">No history recorded.</div>');
                    }
                }
            }
        });
    }
</script>