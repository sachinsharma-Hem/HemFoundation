<div class="card shadow-sm rounded-4 bg-white p-4 animate-fade-in" style="border: 1px solid #d9dfe5 !important;">
    <div class="d-flex flex-wrap align-items-center justify-content-between mb-4 pb-3 border-bottom gap-3">
        <div>
            <h4 class="fw-bold text-danger mb-1"><i class="bi bi-calendar-check me-2"></i> Activity Dashboard</h4>
            <p class="text-muted small m-0">Track site visits, schedules, and real-time activity updates.</p>
        </div>
        
        <div class="d-flex align-items-center gap-3">
            <div class="d-flex align-items-center gap-2">
                <label class="small fw-semibold text-muted m-0">From:</label>
                <input type="date" id="actFromDate" class="form-control form-control-sm rounded-3 shadow-none" onchange="loadActivityStats()">
            </div>
            <div class="d-flex align-items-center gap-2">
                <label class="small fw-semibold text-muted m-0">To:</label>
                <input type="date" id="actToDate" class="form-control form-control-sm rounded-3 shadow-none" onchange="loadActivityStats()">
            </div>
            <span class="badge bg-danger-subtle text-danger px-3 py-2 rounded-pill fw-semibold border border-danger-subtle" id="actStatus">Status: Active</span>
        </div>
    </div>

    <div class="row g-3 mb-4">
        
        <div class="col-xl-3 col-lg-4 col-md-6">
            <div class="card text-white bg-info border-0 shadow-sm h-100 rounded-3 overflow-hidden">
                <div class="card-body p-3">
                    <h2 class="fw-bold mb-1" id="cntVisitSchedule"><span class="spinner-border spinner-border-sm"></span></h2>
                    <p class="card-text small mb-0">Visit Schedule</p>
                </div>
                <a href="javascript:void(0)" onclick="$('.load-module-btn[data-module=\'planvisit\']').click();" class="card-footer text-white text-decoration-none bg-black bg-opacity-10 border-0 py-2 px-3 small d-flex align-items-center justify-content-between">
                    <span>More Info</span>
                    <i class="bi bi-arrow-right-circle"></i>
                </a>
            </div>
        </div>

        <div class="col-xl-3 col-lg-4 col-md-6">
            <div class="card text-white bg-success border-0 shadow-sm h-100 rounded-3 overflow-hidden">
                <div class="card-body p-3">
                    <h2 class="fw-bold mb-1" id="cntVisited"><span class="spinner-border spinner-border-sm"></span></h2>
                    <p class="card-text small mb-0">Visited</p>
                </div>
                <a href="javascript:void(0)" onclick="$('.load-module-btn[data-module=\'network\']').click();" class="card-footer text-white text-decoration-none bg-black bg-opacity-10 border-0 py-2 px-3 small d-flex align-items-center justify-content-between">
                    <span>More Info</span>
                    <i class="bi bi-arrow-right-circle"></i>
                </a>
            </div>
        </div>

        <div class="col-xl-3 col-lg-4 col-md-6">
            <div class="card text-dark bg-warning border-0 shadow-sm h-100 rounded-3 overflow-hidden">
                <div class="card-body p-3">
                    <h2 class="fw-bold mb-1" id="cntVisitPending"><span class="spinner-border spinner-border-sm"></span></h2>
                    <p class="card-text small mb-0">Visit Pending</p>
                </div>
                <a href="javascript:void(0)" onclick="$('.load-module-btn[data-module=\'planvisit\']').click();" class="card-footer text-dark text-decoration-none bg-black bg-opacity-10 border-0 py-2 px-3 small d-flex align-items-center justify-content-between">
                    <span>More Info</span>
                    <i class="bi bi-arrow-right-circle"></i>
                </a>
            </div>
        </div>

        <div class="col-xl-3 col-lg-4 col-md-6">
            <div class="card text-white bg-primary border-0 shadow-sm h-100 rounded-3 overflow-hidden">
                <div class="card-body p-3">
                    <h2 class="fw-bold mb-1" id="cntActivityUpdated"><span class="spinner-border spinner-border-sm"></span></h2>
                    <p class="card-text small mb-0">Activity Updated</p>
                </div>
                <a href="javascript:void(0)" onclick="$('.load-module-btn[data-module=\'network\']').click();" class="card-footer text-white text-decoration-none bg-black bg-opacity-10 border-0 py-2 px-3 small d-flex align-items-center justify-content-between">
                    <span>More Info</span>
                    <i class="bi bi-arrow-right-circle"></i>
                </a>
            </div>
        </div>

        <div class="col-xl-3 col-lg-4 col-md-6">
            <div class="card text-white bg-danger border-0 shadow-sm h-100 rounded-3 overflow-hidden">
                <div class="card-body p-3">
                    <h2 class="fw-bold mb-1" id="cntActivityPending"><span class="spinner-border spinner-border-sm"></span></h2>
                    <p class="card-text small mb-0">Activity Pending</p>
                </div>
                <a href="javascript:void(0)" onclick="$('.load-module-btn[data-module=\'network\']').click();" class="card-footer text-white text-decoration-none bg-black bg-opacity-10 border-0 py-2 px-3 small d-flex align-items-center justify-content-between">
                    <span>More Info</span>
                    <i class="bi bi-arrow-right-circle"></i>
                </a>
            </div>
        </div>

    </div>

    <div class="text-center py-3 text-muted border rounded-3 bg-light-subtle small">
        <i class="bi bi-info-circle me-1"></i> Data filters dynamically based on the selected date range.
    </div>
</div>

<script>
    $(function() {
        // Set default dates: 1st of current month to today
        let today = new Date();
        let firstDay = new Date(today.getFullYear(), today.getMonth(), 1).toISOString().split('T')[0];
        let todayStr = today.toISOString().split('T')[0];
        
        $('#actFromDate').val(firstDay);
        $('#actToDate').val(todayStr);

        loadActivityStats();
    });

    function loadActivityStats() {
        let fromDate = $('#actFromDate').val();
        let toDate = $('#actToDate').val();
        
        // Show spinners while loading
        $('#cntVisitSchedule, #cntVisited, #cntVisitPending, #cntActivityUpdated, #cntActivityPending').html('<span class="spinner-border spinner-border-sm"></span>');
        $('#actStatus').text('Updating...').removeClass('text-danger bg-danger-subtle').addClass('text-muted bg-light');

        $.ajax({
            url: `/api/affiliate-dashboard/activity-stats?fromDate=${fromDate}&toDate=${toDate}`,
            type: 'GET',
            headers: { 'Authorization': 'Bearer ' + (localStorage.getItem('jwt_token') || sessionStorage.getItem('jwt_token') || '') },
            success: function(res) {
                if(res.success) {
                    $('#cntVisitSchedule').text(res.data.visitSchedule);
                    $('#cntVisited').text(res.data.visited);
                    $('#cntVisitPending').text(res.data.visitPending);
                    $('#cntActivityUpdated').text(res.data.activityUpdated);
                    $('#cntActivityPending').text(res.data.activityPending);
                    
                    $('#actStatus').text('Status: Active').removeClass('text-muted bg-light').addClass('text-danger bg-danger-subtle');
                }
            },
            error: function() {
                $('#actStatus').text('Error').removeClass('text-danger bg-danger-subtle').addClass('text-muted bg-light');
                $('#cntVisitSchedule, #cntVisited, #cntVisitPending, #cntActivityUpdated, #cntActivityPending').text('-');
            }
        });
    }
</script>