<div class="card shadow-sm rounded-4 bg-white p-4 animate-fade-in" style="border: 1px solid #d9dfe5 !important;">
    <div class="d-flex flex-wrap align-items-center justify-content-between mb-4 pb-3 border-bottom gap-3">
        <div>
            <h4 class="fw-bold text-success mb-1"><i class="bi bi-calendar-check me-2"></i> Activity Dashboard</h4>
            <p class="text-muted small m-0">Track site visits, schedules, and real-time activity updates.</p>
        </div>
        
        <div class="d-flex align-items-center gap-3">
            <div class="d-flex align-items-center gap-2">
                <label class="small fw-semibold text-muted m-0">From:</label>
                <input type="date" id="actFromDate" class="form-control form-control-sm rounded-3 shadow-none" onchange="loadActivityStats()">
            </div>
            <div class="d-flex align-items-center gap-2">
                <label class="small fw-semibold text-muted m-0">To:</label>
                <input type="date" id="actToDate" class="form-control form-control-sm rounded-3 shadow-none" onchange="loadActivityStats()">
            </div>
        </div>
    </div>

    <div class="row g-3 mb-4">

        <!-- Visit Schedule -->
        <div class="col-xl-3 col-lg-4 col-md-6">
            <div class="card dashboard-stat-card stat-info border-0 shadow-sm h-100">
                <div class="card-body">
                    <div class="stat-icon">
                        <i class="bi bi-calendar2-check"></i>
                    </div>

                    <div class="stat-content">
                        <div class="stat-label">Visit Schedule</div>
                        <h2 class="stat-value" id="cntVisitSchedule">
                            <span class="spinner-border spinner-border-sm"></span>
                        </h2>
                    </div>
                </div>
            </div>
        </div>

        <!-- Visited -->
        <div class="col-xl-3 col-lg-4 col-md-6">
            <div class="card dashboard-stat-card stat-success border-0 shadow-sm h-100">
                <div class="card-body">
                    <div class="stat-icon">
                        <i class="bi bi-check-circle"></i>
                    </div>

                    <div class="stat-content">
                        <div class="stat-label">Visited</div>
                        <h2 class="stat-value" id="cntVisited">
                            <span class="spinner-border spinner-border-sm"></span>
                        </h2>
                    </div>
                </div>
            </div>
        </div>

        <!-- Visit Pending -->
        <div class="col-xl-3 col-lg-4 col-md-6">
            <div class="card dashboard-stat-card stat-warning border-0 shadow-sm h-100">
                <div class="card-body">
                    <div class="stat-icon">
                        <i class="bi bi-hourglass-split"></i>
                    </div>

                    <div class="stat-content">
                        <div class="stat-label">Visit Pending</div>
                        <h2 class="stat-value" id="cntVisitPending">
                            <span class="spinner-border spinner-border-sm"></span>
                        </h2>
                    </div>
                </div>
            </div>
        </div>

        <!-- Activity Updated -->
        <div class="col-xl-3 col-lg-4 col-md-6">
            <div class="card dashboard-stat-card stat-primary border-0 shadow-sm h-100">
                <div class="card-body">
                    <div class="stat-icon">
                        <i class="bi bi-clipboard-check"></i>
                    </div>

                    <div class="stat-content">
                        <div class="stat-label">Activity Updated</div>
                        <h2 class="stat-value" id="cntActivityUpdated">
                            <span class="spinner-border spinner-border-sm"></span>
                        </h2>
                    </div>
                </div>
            </div>
        </div>

        <!-- Activity Pending -->
        <div class="col-xl-3 col-lg-4 col-md-6">
            <div class="card dashboard-stat-card stat-danger border-0 shadow-sm h-100">
                <div class="card-body">
                    <div class="stat-icon">
                        <i class="bi bi-exclamation-circle"></i>
                    </div>

                    <div class="stat-content">
                        <div class="stat-label">Activity Pending</div>
                        <h2 class="stat-value" id="cntActivityPending">
                            <span class="spinner-border spinner-border-sm"></span>
                        </h2>
                    </div>
                </div>
            </div>
        </div>

    </div>

    <style>
            .dashboard-stat-card {
                position: relative;
                overflow: hidden;
                border-radius: 16px !important;
                min-height: 135px;
                transition: all 0.25s ease;
            }

                .dashboard-stat-card:hover {
                    transform: translateY(-4px);
                    box-shadow: 0 10px 25px rgba(0, 0, 0, 0.12) !important;
                }

                .dashboard-stat-card .card-body {
                    position: relative;
                    z-index: 2;
                    display: flex;
                    align-items: center;
                    gap: 16px;
                    padding: 22px;
                }

                /* Background decoration */
                .dashboard-stat-card::after {
                    content: "";
                    position: absolute;
                    width: 110px;
                    height: 110px;
                    border-radius: 50%;
                    right: -35px;
                    top: -35px;
                    background: rgba(255, 255, 255, 0.12);
                }

                .dashboard-stat-card::before {
                    content: "";
                    position: absolute;
                    width: 70px;
                    height: 70px;
                    border-radius: 50%;
                    right: 25px;
                    bottom: -35px;
                    background: rgba(255, 255, 255, 0.08);
                }

            /* Icon */
            .stat-icon {
                width: 58px;
                height: 58px;
                min-width: 58px;
                border-radius: 14px;
                display: flex;
                align-items: center;
                justify-content: center;
                font-size: 27px;
                background: rgba(255, 255, 255, 0.18);
                backdrop-filter: blur(4px);
            }

            .stat-content {
                min-width: 0;
            }

            .stat-label {
                font-size: 14px;
                font-weight: 500;
                margin-bottom: 5px;
                opacity: 0.9;
            }

            .stat-value {
                font-size: 30px;
                line-height: 1;
                font-weight: 700;
                margin: 0;
            }

            /* Colors */
            .stat-info {
                color: #fff;
                background: linear-gradient(135deg, #0dcaf0, #1597b8);
            }

            .stat-success {
                color: #fff;
                background: linear-gradient(135deg, #198754, #32a36f);
            }

            .stat-warning {
                color: #212529;
                background: linear-gradient(135deg, #ffc107, #e7a900);
            }

            .stat-primary {
                color: #fff;
                background: linear-gradient(135deg, #0d6efd, #315bb5);
            }

            .stat-danger {
                color: #fff;
                background: linear-gradient(135deg, #dc3545, #b92b3a);
            }

            /* Spinner */
            .stat-value .spinner-border {
                width: 20px;
                height: 20px;
                border-width: 2px;
            }

            /* Mobile */
            @@media (max-width: 575.98px) {
                .dashboard-stat-card .card-body {
                    padding: 18px;
                }

                .stat-icon {
                    width: 50px;
                    height: 50px;
                    min-width: 50px;
                    font-size: 23px;
                }

                .stat-value {
                    font-size: 26px;
                }
            }
    </style>

    <div class="text-center py-3 text-muted border rounded-3 bg-light-subtle small">
        <i class="bi bi-info-circle me-1"></i> Data filters dynamically based on the selected date range.
    </div>
</div>

<script>
    $(function() {
        // Set default dates: 1st of current month to today
        let today = new Date();
        let firstDay = new Date(today.getFullYear(), today.getMonth(), 1).toISOString().split('T')[0];
        let todayStr = today.toISOString().split('T')[0];
        
        $('#actFromDate').val(firstDay);
        $('#actToDate').val(todayStr);

        loadActivityStats();
    });

    function loadActivityStats() {
        let fromDate = $('#actFromDate').val();
        let toDate = $('#actToDate').val();
        
        // Show spinners while loading
        $('#cntVisitSchedule, #cntVisited, #cntVisitPending, #cntActivityUpdated, #cntActivityPending').html('<span class="spinner-border spinner-border-sm"></span>');
        $('#actStatus').text('Updating...').removeClass('text-danger bg-danger-subtle').addClass('text-muted bg-light');

        $.ajax({
            url: `/api/affiliate-dashboard/activity-stats?fromDate=${fromDate}&toDate=${toDate}`,
            type: 'GET',
            headers: { 'Authorization': 'Bearer ' + (localStorage.getItem('jwt_token') || sessionStorage.getItem('jwt_token') || '') },
            success: function(res) {
                if(res.success) {
                    $('#cntVisitSchedule').text(res.data.visitSchedule);
                    $('#cntVisited').text(res.data.visited);
                    $('#cntVisitPending').text(res.data.visitPending);
                    $('#cntActivityUpdated').text(res.data.activityUpdated);
                    $('#cntActivityPending').text(res.data.activityPending);
                    
                    $('#actStatus').text('Status: Active').removeClass('text-muted bg-light').addClass('text-danger bg-danger-subtle');
                }
            },
            error: function() {
                $('#actStatus').text('Error').removeClass('text-danger bg-danger-subtle').addClass('text-muted bg-light');
                $('#cntVisitSchedule, #cntVisited, #cntVisitPending, #cntActivityUpdated, #cntActivityPending').text('-');
            }
        });
    }
</script>