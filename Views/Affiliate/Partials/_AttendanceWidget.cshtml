<style>

    .extra-small {
        font-size: 0.7rem;
    }

    .flatpickr-calendar {
        z-index: 99999 !important;
    }

</style>



<script>

(function () {

    "use strict";


    /* =========================================================
       AUTH
    ========================================================= */

    function getAuthToken() {

        return localStorage.getItem("jwt_token")
            || sessionStorage.getItem("jwt_token")
            || "";

    }


    /* =========================================================
       API HELPER
    ========================================================= */

    async function apiRequest(url, options = {}) {

        const token = getAuthToken();

        const headers = {

            "Authorization": "Bearer " + token

        };


        if (options.body) {

            headers["Content-Type"] = "application/json";

        }


        const response = await fetch(url, {

            ...options,

            headers: {

                ...headers,

                ...(options.headers || {})

            }

        });


        let data = null;

        try {

            data = await response.json();

        } catch {

            data = null;

        }


        if (!response.ok) {

            throw {

                status: response.status,

                data: data

            };

        }


        return data;

    }



    /* =========================================================
       DATE HELPERS
    ========================================================= */

    function formatDateDDMMYYYY(dateString) {

        if (!dateString) return "-";


        const d = new Date(dateString);


        if (isNaN(d.getTime())) return "-";


        const day = String(d.getDate()).padStart(2, "0");

        const month = String(d.getMonth() + 1).padStart(2, "0");

        const year = d.getFullYear();


        return `${day}/${month}/${year}`;

    }


    function formatTime(dateString) {

        if (!dateString) return "-";


        const d = new Date(dateString);


        if (isNaN(d.getTime())) return "-";


        return d.toLocaleTimeString([], {

            hour: "2-digit",

            minute: "2-digit"

        });

    }


    /*
       Flatpickr DD/MM/YYYY ko API ke liye
       yyyy-MM-dd mein convert karega.
    */

    function convertDDMMYYYYToISO(value) {

        if (!value) return null;


        const parts = value.split("/");


        if (parts.length !== 3) return null;


        const day = parts[0];

        const month = parts[1];

        const year = parts[2];


        return `${year}-${month}-${day}`;

    }


    /* =========================================================
       LOCATION
    ========================================================= */

    function renderLocationBadge(locString) {

        if (!locString) {

            return '<span class="text-muted">-</span>';

        }


        const coordsMatch = locString.match(
            /(-?\d+(?:\.\d+)),\s*(-?\d+(?:\.\d+))/
        );


        if (coordsMatch) {

            const lat = coordsMatch[1];

            const lng = coordsMatch[2];

            const mapUrl =
                `https://www.google.com/maps?q=${encodeURIComponent(lat + "," + lng)}`;


            return `
                <a href="${mapUrl}"
                   target="_blank"
                   rel="noopener noreferrer"
                   class="btn btn-outline-danger btn-sm py-0 px-2 rounded-pill shadow-none"
                   style="font-size:0.72rem;">

                    <i class="bi bi-geo-alt-fill text-danger me-1"></i>

                    View Map

                </a>
            `;

        }


        return `
            <span class="badge bg-light text-dark border fw-normal"
                  style="font-size:0.72rem;">

                <i class="bi bi-geo-alt-fill text-danger me-1"></i>

                ${escapeHtml(locString)}

            </span>
        `;

    }


    function escapeHtml(value) {

        if (value === null || value === undefined) {

            return "";

        }


        return String(value)

            .replace(/&/g, "&amp;")

            .replace(/</g, "&lt;")

            .replace(/>/g, "&gt;")

            .replace(/"/g, "&quot;")

            .replace(/'/g, "&#039;");

    }



    /* =========================================================
       ATTENDANCE STATUS
    ========================================================= */

    let currentPunchState = false;


        async function fetchAttendanceStatus() {
            try {
                const res = await apiRequest("/api/affiliate-attendance/status");
                const btn = document.getElementById("btnPunchAction");
                if (!btn) return;

                btn.classList.remove("d-none");

                if (res.isCheckedIn) {
                    currentPunchState = true;
                    btn.disabled = false;
                    btn.classList.remove("btn-success", "btn-secondary");
                    btn.classList.add("btn-danger");
                    btn.innerHTML = `<i class="bi bi-stop-circle me-1"></i> Punch Out`;

                    const inTime = formatTime(res.todayRecord?.punchInTime);
                    const mapBadge = renderLocationBadge(res.todayRecord?.punchInLocation);

                    document.getElementById("attStatusText").innerHTML = `
                        <span class="text-success">
                            <i class="bi bi-dot fs-3 align-middle"></i> Status: Punched In
                        </span>
                    `;
                    document.getElementById("attSubText").innerHTML = `
                        Punched in today at <b>${inTime}</b> | In Location: ${mapBadge}
                    `;
                } else {
                    currentPunchState = false;
                    btn.disabled = false;
                    btn.classList.remove("btn-danger", "btn-secondary");
                    btn.classList.add("btn-success");

                    btn.innerHTML = `
                        <i class="bi bi-fingerprint me-1"></i> Punch In
                    `;

                    if (res.todayRecord && res.todayRecord.punchOutTime) {
                        const outTime = formatTime(res.todayRecord.punchOutTime);
                        document.getElementById("attStatusText").innerHTML = `
                            <span class="text-dark">Status: Ready to Punch In Again</span>
                        `;
                        document.getElementById("attSubText").innerHTML = `
                            Last punch out today at <b>${outTime}</b> | Total logged today: <b>${res.todayRecord.totalHoursWorked || 0} hrs</b>
                        `;
                    } else {
                        document.getElementById("attStatusText").innerHTML = `
                            <span class="text-dark">Status: Ready to Punch In</span>
                        `;
                        document.getElementById("attSubText").innerHTML = `
                            Click Punch In to start your shift.
                        `;
                    }
                }

                if (typeof window.checkHubVisibility === 'function') {
                    window.checkHubVisibility();
                }
            } catch (error) {
                console.error("Attendance status error:", error);
            }
        }

    async function togglePunch() {

        const actionType =
            currentPunchState ? "Out" : "In";


        const button =
            document.getElementById("btnPunchAction");


        button.disabled = true;


        const originalText =
            button.innerHTML;


        button.innerHTML = `
            <span class="spinner-border spinner-border-sm me-1"></span>
            Processing...
        `;


        if (navigator.geolocation) {

            navigator.geolocation.getCurrentPosition(

                function (position) {

                    const location =
                        `${position.coords.latitude.toFixed(6)}, ${position.coords.longitude.toFixed(6)}`;


                    sendPunchRequest(
                        actionType,
                        location
                    );

                },

                function () {

                    sendPunchRequest(
                        actionType,
                        "GPS Location Unavailable"
                    );

                },

                {
                    enableHighAccuracy: true,
                    timeout: 10000,
                    maximumAge: 0
                }

            );

        }

        else {

            sendPunchRequest(
                actionType,
                "Geolocation Not Supported"
            );

        }

    }


    async function sendPunchRequest(
        action,
        location
    ) {

        try {

            const res = await apiRequest(
                "/api/affiliate-attendance/punch",
                {
                    method: "POST",

                    body: JSON.stringify({

                        action: action,

                        location: location

                    })

                }
            );


            if (res.success) {

                await fetchAttendanceStatus();

                await loadAttendanceHistory();

            }

            else {

                alert(
                    res.message ||
                    "Error processing attendance."
                );

            }

        }

        catch (error) {

            console.error(error);


            alert(
                error.data?.message ||
                "Error processing attendance."
            );


            fetchAttendanceStatus();

        }

    }



    /* =========================================================
       ATTENDANCE HISTORY
    ========================================================= */

    async function loadAttendanceHistory() {

        const fromDate =
            document.getElementById("filterFromDate").value;


        const toDate =
            document.getElementById("filterToDate").value;


        const month =
            document.getElementById("filterMonth").value;


        const year =
            document.getElementById("filterYear").value;


        const params =
            new URLSearchParams();


        if (fromDate)
            params.append("fromDate", fromDate);


        if (toDate)
            params.append("toDate", toDate);


        if (month)
            params.append("month", month);


        if (year)
            params.append("year", year);


        const url =
            "/api/affiliate-attendance/history" +
            (params.toString()
                ? "?" + params.toString()
                : "");


        const tbody =
            document.getElementById(
                "attendanceTableBody"
            );


        try {

            const res =
                await apiRequest(url);


            if (
                res.success &&
                res.data &&
                res.data.length > 0
            ) {

                let rows = "";


                res.data.forEach(item => {

                    const dateFormatted =
                        formatDateDDMMYYYY(
                            item.attendanceDate
                        );


                    const inTime =
                        formatTime(
                            item.punchInTime
                        );


                    const outTime =
                        formatTime(
                            item.punchOutTime
                        );


                    const inLocBadge =
                        renderLocationBadge(
                            item.punchInLocation
                        );


                    const outLocBadge =
                        renderLocationBadge(
                            item.punchOutLocation
                        );


                    const badge =
                        item.status === "CheckedIn"

                            ? `
                                <span class="badge bg-success-subtle text-success border border-success-subtle">
                                    Active
                                </span>
                              `

                            : `
                                <span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle">
                                    Completed
                                    (${escapeHtml(item.punchOutMode || "User")})
                                </span>
                              `;


                    rows += `
                        <tr>

                            <td class="fw-semibold text-dark">
                                ${dateFormatted}
                            </td>


                            <td>

                                ${inTime}

                                <div class="mt-1">
                                    ${inLocBadge}
                                </div>

                            </td>


                            <td>

                                ${outTime}

                                <div class="mt-1">
                                    ${outLocBadge}
                                </div>

                            </td>


                            <td>
                                <b>
                                    ${item.totalHoursWorked || 0} hrs
                                </b>
                            </td>


                            <td>
                                ${badge}
                            </td>

                        </tr>
                    `;

                });


                tbody.innerHTML = rows;

            }

            else {

                tbody.innerHTML = `
                    <tr>

                        <td colspan="5"
                            class="text-center text-muted py-4">

                            <i class="bi bi-info-circle me-1"></i>

                            No attendance logs found for selected filter.

                        </td>

                    </tr>
                `;

            }

        }

        catch (error) {

            console.error(
                "Attendance history error:",
                error
            );


            tbody.innerHTML = `
                <tr>

                    <td colspan="5"
                        class="text-center text-danger py-4">

                        Unable to load attendance history.

                    </td>

                </tr>
            `;

        }

    }



    /* =========================================================
       RESET FILTER
    ========================================================= */

    function resetFilters() {

        document.getElementById("filterFromDate").value = "";

        document.getElementById("filterToDate").value = "";

        document.getElementById("filterMonth").value = "";

        document.getElementById("filterYear").value = "";


        loadAttendanceHistory();

    }



    /* =========================================================
       LEAVE HISTORY
    ========================================================= */

    async function loadLeaveHistory() {

        const tbody =
            document.getElementById(
                "leaveTableBody"
            );


        try {

            const res =
                await apiRequest(
                    "/api/affiliate-attendance/leave/history"
                );


            if (
                res.success &&
                res.data &&
                res.data.length > 0
            ) {

                let rows = "";


                res.data.forEach(item => {

                    const from =
                        formatDateDDMMYYYY(
                            item.fromDate
                        );


                    const to =
                        formatDateDDMMYYYY(
                            item.toDate
                        );


                    let statusBadge = "";


                    if (item.status === "Approved") {

                        statusBadge = `
                            <span class="badge bg-success-subtle text-success border border-success-subtle">
                                Approved
                            </span>
                        `;

                    }

                    else if (item.status === "Rejected") {

                        statusBadge = `
                            <span class="badge bg-danger-subtle text-danger border border-danger-subtle">
                                Rejected
                            </span>
                        `;

                    }

                    else {

                        statusBadge = `
                            <span class="badge bg-warning-subtle text-dark border border-warning-subtle">
                                Pending
                            </span>
                        `;

                    }


                    rows += `
                        <tr>

                            <td class="fw-semibold text-dark">
                                ${from}
                            </td>


                            <td class="fw-semibold text-dark">
                                ${to}
                            </td>


                            <td>
                                ${escapeHtml(item.reason)}
                            </td>


                            <td class="text-muted">
                                ${escapeHtml(item.adminRemarks || "N/A")}
                            </td>


                            <td>
                                ${statusBadge}
                            </td>

                        </tr>
                    `;

                });


                tbody.innerHTML = rows;

            }

            else {

                tbody.innerHTML = `
                    <tr>

                        <td colspan="5"
                            class="text-center text-muted py-4">

                            <i class="bi bi-info-circle me-1"></i>

                            No leave requests found.

                        </td>

                    </tr>
                `;

            }

        }

        catch (error) {

            console.error(
                "Leave history error:",
                error
            );


            tbody.innerHTML = `
                <tr>

                    <td colspan="5"
                        class="text-center text-danger py-4">

                        Unable to load leave requests.

                    </td>

                </tr>
            `;

        }

    }



    /* =========================================================
       FLATPICKR
    ========================================================= */

    let leaveFromPicker = null;

    let leaveToPicker = null;


    function initializeLeaveDatePickers() {

        const today = new Date();

        today.setHours(0, 0, 0, 0);


        leaveFromPicker =
            flatpickr("#txtLeaveFrom", {

                dateFormat: "d/m/Y",

                minDate: today,

                disableMobile: true,

                allowInput: false,

                onChange: function (selectedDates) {

                    if (
                        selectedDates &&
                        selectedDates.length > 0
                    ) {

                        const selectedDate =
                            selectedDates[0];


                        leaveToPicker.set(
                            "minDate",
                            selectedDate
                        );


                        const currentTo =
                            leaveToPicker.selectedDates[0];


                        if (
                            currentTo &&
                            currentTo < selectedDate
                        ) {

                            leaveToPicker.clear();

                        }

                    }

                }

            });


        leaveToPicker =
            flatpickr("#txtLeaveTo", {

                dateFormat: "d/m/Y",

                minDate: today,

                disableMobile: true,

                allowInput: false

            });

    }



    /* =========================================================
       OPEN / CLOSE LEAVE MODAL
    ========================================================= */

    function openApplyLeaveModal() {

        const historyElement =
            document.getElementById(
                "attendanceHistoryModal"
            );


        const leaveElement =
            document.getElementById(
                "applyLeaveModal"
            );


        const historyModal =
            bootstrap.Modal.getInstance(
                historyElement
            );


        if (historyModal) {

            historyModal.hide();

        }


        setTimeout(function () {

            const leaveModal =
                bootstrap.Modal.getOrCreateInstance(
                    leaveElement
                );


            leaveModal.show();

        }, 250);

    }



    function closeApplyLeaveModal() {

        const leaveElement =
            document.getElementById(
                "applyLeaveModal"
            );


        const leaveModal =
            bootstrap.Modal.getInstance(
                leaveElement
            );


        if (leaveModal) {

            leaveModal.hide();

        }


        setTimeout(function () {

            const historyElement =
                document.getElementById(
                    "attendanceHistoryModal"
                );


            const historyModal =
                bootstrap.Modal.getOrCreateInstance(
                    historyElement
                );


            historyModal.show();


            // Leave tab activate

            setTimeout(function () {

                const leaveTab =
                    document.getElementById(
                        "leave-tab"
                    );


                if (leaveTab) {

                    bootstrap.Tab
                        .getOrCreateInstance(
                            leaveTab
                        )
                        .show();

                }

            }, 100);

        }, 250);

    }



    /* =========================================================
       APPLY LEAVE
    ========================================================= */

    async function submitLeave(e) {

        e.preventDefault();


        const fromValue =
            document.getElementById(
                "txtLeaveFrom"
            ).value;


        const toValue =
            document.getElementById(
                "txtLeaveTo"
            ).value;


        const reason =
            document.getElementById(
                "txtLeaveReason"
            ).value.trim();


        if (!fromValue) {

            alert("Please select From Date.");

            return;

        }


        if (!toValue) {

            alert("Please select To Date.");

            return;

        }


        if (!reason) {

            alert("Please enter reason for leave.");

            return;

        }


        const fromISO =
            convertDDMMYYYYToISO(
                fromValue
            );


        const toISO =
            convertDDMMYYYYToISO(
                toValue
            );


        if (!fromISO || !toISO) {

            alert(
                "Invalid date selected."
            );

            return;

        }


        /*
          Client-side date validation
        */

        const fromDate =
            new Date(fromISO + "T00:00:00");


        const toDate =
            new Date(toISO + "T00:00:00");


        const today =
            new Date();


        today.setHours(0, 0, 0, 0);


        if (fromDate < today) {

            alert(
                "From Date cannot be before today."
            );

            return;

        }


        if (toDate < today) {

            alert(
                "To Date cannot be before today."
            );

            return;

        }


        if (toDate < fromDate) {

            alert(
                "To Date cannot be before From Date."
            );

            return;

        }


        const button =
            document.getElementById(
                "btnSubmitLeave"
            );


        button.disabled = true;


        button.innerHTML = `
            <span class="spinner-border spinner-border-sm me-1"></span>
            Submitting...
        `;


        try {

            const res =
                await apiRequest(
                    "/api/affiliate-attendance/leave/apply",
                    {

                        method: "POST",

                        body: JSON.stringify({

                            fromDate: fromISO,

                            toDate: toISO,

                            reason: reason

                        })

                    }
                );


            if (res.success) {

                alert(
                    res.message ||
                    "Leave application submitted successfully."
                );


                document
                    .getElementById(
                        "frmApplyLeave"
                    )
                    .reset();


                if (leaveFromPicker) {

                    leaveFromPicker.clear();

                }


                if (leaveToPicker) {

                    leaveToPicker.clear();

                }


                const leaveModalElement =
                    document.getElementById(
                        "applyLeaveModal"
                    );


                const leaveModal =
                    bootstrap.Modal.getInstance(
                        leaveModalElement
                    );


                if (leaveModal) {

                    leaveModal.hide();

                }


                await loadLeaveHistory();


                /*
                  History modal dobara open
                */

                setTimeout(function () {

                    const historyElement =
                        document.getElementById(
                            "attendanceHistoryModal"
                        );


                    const historyModal =
                        bootstrap.Modal.getOrCreateInstance(
                            historyElement
                        );


                    historyModal.show();


                    setTimeout(function () {

                        const leaveTab =
                            document.getElementById(
                                "leave-tab"
                            );


                        if (leaveTab) {

                            bootstrap.Tab
                                .getOrCreateInstance(
                                    leaveTab
                                )
                                .show();

                        }

                    }, 100);

                }, 250);

            }

            else {

                alert(
                    res.message ||
                    "Unable to submit leave request."
                );

            }

        }

        catch (error) {

            console.error(
                "Leave apply error:",
                error
            );


            console.error(
                "API response:",
                error.data
            );


            alert(
                error.data?.message ||
                "Error submitting leave application."
            );

        }

        finally {

            button.disabled = false;

            button.innerHTML =
                "Submit Leave Request";

        }

    }



    /* =========================================================
       INITIALIZE
    ========================================================= */

    document.addEventListener(
        "DOMContentLoaded",
        function () {

            /*
              IMPORTANT:
              Ab yahan jQuery ki koi dependency nahi hai.
            */

            fetchAttendanceStatus();

            loadAttendanceHistory();

            loadLeaveHistory();

            initializeLeaveDatePickers();

                // === YAHAN YE NEW CODE ADD KARDENA HAI ===
                document
                    .getElementById("attendanceHistoryModal")
                    .addEventListener("hidden.bs.modal", function() {
                        resetFilters();
                    });
                // ==========================================

            /* Punch */

            document
                .getElementById(
                    "btnPunchAction"
                )
                .addEventListener(
                    "click",
                    togglePunch
                );


            /* Attendance Records */

            document
                .getElementById(
                    "btnAttendanceRecords"
                )
                .addEventListener(
                    "click",
                    function () {

                        const modalElement =
                            document.getElementById(
                                "attendanceHistoryModal"
                            );


                        const modal =
                            bootstrap.Modal
                                .getOrCreateInstance(
                                    modalElement
                                );


                        modal.show();

                    }
                );


            /* Attendance Filter */

            document
                .getElementById(
                    "btnFilterAttendance"
                )
                .addEventListener(
                    "click",
                    loadAttendanceHistory
                );


            /* Reset */

            document
                .getElementById(
                    "btnResetFilters"
                )
                .addEventListener(
                    "click",
                    resetFilters
                );


            /* Open Leave */

            document
                .getElementById(
                    "btnOpenApplyLeave"
                )
                .addEventListener(
                    "click",
                    openApplyLeaveModal
                );


            /* Close Leave */

            document
                .getElementById(
                    "btnCloseLeaveModal"
                )
                .addEventListener(
                    "click",
                    closeApplyLeaveModal
                );


            /* Submit Leave */

            document
                .getElementById(
                    "frmApplyLeave"
                )
                .addEventListener(
                    "submit",
                    submitLeave
                );

        }
    );


})();

</script>