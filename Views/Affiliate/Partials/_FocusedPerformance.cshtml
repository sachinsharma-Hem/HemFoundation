        // Client-side sorting toggle for the currently loaded page items
        let sortDirection = {};
        window.sortModalTable = function(key) {
            sortDirection[key] = !sortDirection[key];
            let asc = sortDirection[key];

            // Assuming current page data is stored globally or can be sorted from current rows
            // Let's sort the active rendered table rows directly or maintain a global dataset array.
            let $rows = $('#genericTableBody tr').toArray();

            // Find column index
            let colIndex = -1;
            $('#genericDetailsTable th').each(function(index) {
                if ($(this).text().trim().toLowerCase().includes(formatColumnName(key).toLowerCase())) {
                    colIndex = index;
                }
            });

            if (colIndex === -1) return;

            $rows.sort((a, b) => {
                let valA = $(a).children('td').eq(colIndex).text().trim();
                let valB = $(b).children('td').eq(colIndex).text().trim();

                let numA = parseFloat(valA);
                let numB = parseFloat(valB);

                if (!isNaN(numA) && !isNaN(numB)) {
                    return asc ? numA - numB : numB - numA;
                }
                return asc ? valA.localeCompare(valB) : valB.localeCompare(valA);
            });

            $('#genericTableBody').empty().append($rows);
        }

        window.renderTableRows = function(data) {
            const keys = Object.keys(data[0]);
            let tbody = '';

            data.forEach(row => {
                tbody += '<tr>';
                keys.forEach(key => {
                    let value = row[key];
                    if (value === null || value === undefined || value === '') value = '-';
                    tbody += `<td>${escapeHtml(value)}</td>`;
                });

                if (currentType === 'total-schools') {
                    let instId = row.instituteId || row.InstituteID || row.id || row.ID || row.instituteID || 0;
                    tbody += `<td>
                                        <button type="button" class="btn btn-sm btn-outline-primary" onclick="exportSingleInstituteReport(${instId}, this)">
                                            <i class="bi bi-file-earmark-excel me-1"></i> Export
                                        </button>
                                      </td>`;
                }
                tbody += '</tr>';
            });

            $('#genericTableBody').html(tbody);
        }

        window.renderPagination = function(page, totalP, totalRec) {
            let startEntry = ((page - 1) * parseInt($('#modalPageSize').val())) + 1;
            let endEntry = Math.min(page * parseInt($('#modalPageSize').val()), totalRec);

            $('#genericModalSubtitle').text(`${totalRec} total records`);
            $('#paginationInfo').text(`Showing ${startEntry} to ${endEntry} of ${totalRec} entries`);

            let paginationHtml = '';

            // Previous Button
            paginationHtml += `<li class="page-item ${page === 1 ? 'disabled' : ''}">
                                            <a class="page-link" href="#" onclick="changePage(${page - 1}); return false;">Prev</a>
                                       </li>`;

            // Page Number Windows
            let maxVisiblePages = 5;
            let startPage = Math.max(1, page - Math.floor(maxVisiblePages / 2));
            let endPage = Math.min(totalP, startPage + maxVisiblePages - 1);

            if (endPage - startPage + 1 < maxVisiblePages) {
                startPage = Math.max(1, endPage - maxVisiblePages + 1);
            }

            for (let i = startPage; i <= endPage; i++) {
                paginationHtml += `<li class="page-item ${i === page ? 'active' : ''}">
                                                <a class="page-link" href="#" onclick="changePage(${i}); return false;">${i}</a>
                                           </li>`;
            }

            // Next Button
            paginationHtml += `<li class="page-item ${page === totalP ? 'disabled' : ''}">
                                            <a class="page-link" href="#" onclick="changePage(${page + 1}); return false;">Next</a>
                                       </li>`;

            $('#modalPagination').html(paginationHtml);
        }

