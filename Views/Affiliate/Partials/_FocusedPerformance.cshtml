@using Microsoft.AspNetCore.Http
@{
    var affiliateId = Context.Session.GetInt32("UserID") ?? 0;
}
<div class="card shadow-sm rounded-4 bg-white p-4 animate-fade-in" style="border: 1px solid #d9dfe5 !important;">
    <!-- Header Section -->
    <div class="d-flex align-items-center justify-content-between mb-4 pb-3 border-bottom">
        <div>
            <h4 class="fw-bold text-success mb-1"><i class="bi bi-speedometer2 me-2"></i> Focused Performance Dashboard</h4>
            <p class="text-muted small m-0"> Real-time statistics, school data, and user activity overview.</p>
        </div>
    </div>

    <!-- Stats Grid System (9 Cards) -->
    <div class="row g-3 mb-4">

        <!-- Card 1: Associated School (Primary Blue) -->
        <div class="col-xl-3 col-lg-4 col-md-6">
            <div class="card text-white bg-primary border-0 shadow-sm h-100 rounded-3 overflow-hidden cursor-pointer">
                <div class="card-body p-3 d-flex flex-column justify-content-between">
                    <div>
                        <h2 class="fw-bold mb-1" id="cntAssociatedSchools">0</h2>
                        <p class="card-text small mb-2">Associated School</p>
                    </div>
                    <div>
                        <button type="button"  onclick="event.stopPropagation(); openDetailsModal('focused','total-schools');" class="btn btn-sm btn-light text-primary fw-bold py-0 px-2 rounded-pill" style="font-size: 0.75rem;">More Info <i class="bi bi-arrow-right"></i></button>
                    </div>
                </div>
            </div>
        </div>

        <!-- Card 2: Associated Student -->
        <div class="col-xl-3 col-lg-4 col-md-6">
            <div class="card text-white bg-success border-0 shadow-sm h-100 rounded-3 overflow-hidden">
                <div class="card-body p-3 d-flex flex-column justify-content-between">
                    <div>
                        <h2 class="fw-bold mb-1" id="lblTotalStudentCount">0</h2>
                        <p class="card-text small mb-2">Associated Student</p>
                    </div>
                    <div>
                        <button type="button" id="btnOpenTotalStudentss" onclick="openDetailsModal('focused','total-students')" class="btn btn-sm btn-light text-success fw-bold py-0 px-2 rounded-pill" style="font-size: 0.75rem;">More Info <i class="bi bi-arrow-right"></i></button>
                    </div>
                </div>
            </div>
        </div>

        <!-- Card 3: Active Student -->
        <div class="col-xl-3 col-lg-4 col-md-6">
            <div class="card text-dark bg-warning border-0 shadow-sm h-100 rounded-3 overflow-hidden">
                <div class="card-body p-3 d-flex flex-column justify-content-between">
                    <div>
                        <h2 class="fw-bold mb-1" id="lblActiveStudentCount">0</h2>
                        <p class="card-text small mb-2">Active Student</p>
                    </div>
                    <div>
                        <button type="button" id="btn_ExportAdminFocusedStudentsReport" class="btn btn-sm btn-dark text-warning fw-bold py-0 px-2 rounded-pill" style="font-size: 0.75rem;">More Info <i class="bi bi-arrow-right"></i></button>
                    </div>
                </div>
            </div>
        </div>

        <!-- Card 4: Associated Teacher -->
        <div class="col-xl-3 col-lg-4 col-md-6">
            <div class="card text-white bg-success border-0 shadow-sm h-100 rounded-3 overflow-hidden">
                <div class="card-body p-3 d-flex flex-column justify-content-between">
                    <div>
                        <h2 class="fw-bold mb-1" id="lblTotalTeacherCount">0</h2>
                        <p class="card-text small mb-2">Associated Teacher</p>
                    </div>
                    <div>
                        <button type="button" id="btnOpenTotalTeacherss" onclick="openDetailsModal('focused','total-teachers')" class="btn btn-sm btn-light text-success fw-bold py-0 px-2 rounded-pill" style="font-size: 0.75rem;">More Info <i class="bi bi-arrow-right"></i></button>
                    </div>
                </div>
            </div>
        </div>

        <!-- Card 5: Active Teacher -->
        <div class="col-xl-3 col-lg-4 col-md-6">
            <div class="card text-white bg-success border-0 shadow-sm h-100 rounded-3 overflow-hidden">
                <div class="card-body p-3 d-flex flex-column justify-content-between">
                    <div>
                        <h2 class="fw-bold mb-1" id="lblActiveTeacherCount">0</h2>
                        <p class="card-text small mb-2">Active Teacher</p>
                    </div>
                    <div>
                        <button type="button" id="btnOpenActiveTeacherss" onclick="openDetailsModal('focused','active-teachers')" class="btn btn-sm btn-light text-success fw-bold py-0 px-2 rounded-pill" style="font-size: 0.75rem;">More Info <i class="bi bi-arrow-right"></i></button>
                    </div>
                </div>
            </div>
        </div>

        <!-- Card 6: No. Of SEL Submission School -->
        <div class="col-xl-3 col-lg-4 col-md-6">
            <div class="card text-white bg-primary border-0 shadow-sm h-100 rounded-3 overflow-hidden">
                <div class="card-body p-3 d-flex flex-column justify-content-between">
                    <div>
                        <h2 class="fw-bold mb-1" id="lblTotalSelProjectCount">0</h2>
                        <p class="card-text small mb-2">No. Of SEL Submission School</p>
                    </div>
                    <div>
                        <button type="button" id="btn_ExportFocusedSelSubmissions" class="btn btn-sm btn-light text-primary fw-bold py-0 px-2 rounded-pill" style="font-size: 0.75rem;">More Info <i class="bi bi-arrow-right"></i></button>
                    </div>
                </div>
            </div>
        </div>

        <!-- Card 7: No. Of Group Project Submission -->
        <div class="col-xl-3 col-lg-4 col-md-6">
            <div class="card text-white bg-secondary border-0 shadow-sm h-100 rounded-3 overflow-hidden">
                <div class="card-body p-3 d-flex flex-column justify-content-between">
                    <div>
                        <h2 class="fw-bold mb-1" id="lblGroupPblCount">0</h2>
                        <p class="card-text small mb-2">No. Of Group Project Submission</p>
                    </div>
                    <div>
                        <button type="button" id="btn_ExportFocusedGroupProjects" class="btn btn-sm btn-light text-secondary fw-bold py-0 px-2 rounded-pill" style="font-size: 0.75rem;">More Info <i class="bi bi-arrow-right"></i></button>
                    </div>
                </div>
            </div>
        </div>

        <!-- Card 8: No. Of Family Project Submission -->
        <div class="col-xl-3 col-lg-4 col-md-6">
            <div class="card text-white bg-dark border-0 shadow-sm h-100 rounded-3 overflow-hidden">
                <div class="card-body p-3 d-flex flex-column justify-content-between">
                    <div>
                        <h2 class="fw-bold mb-1" id="lblFamilyProjectCount">0</h2>
                        <p class="card-text small mb-2">No. Of Family Project Submission</p>
                    </div>
                    <div>
                        <button type="button" id="btn_ExportFocusedFamilyPbl" class="btn btn-sm btn-light text-dark fw-bold py-0 px-2 rounded-pill" style="font-size: 0.75rem;">More Info <i class="bi bi-arrow-right"></i></button>
                    </div>
                </div>
            </div>
        </div>

        <!-- Card 9: No. Of Individual Project Submission -->
        <div class="col-xl-3 col-lg-4 col-md-6">
            <div class="card text-dark bg-light border border-secondary-subtle shadow-sm h-100 rounded-3 overflow-hidden">
                <div class="card-body p-3 d-flex flex-column justify-content-between">
                    <div>
                        <h2 class="fw-bold mb-1 text-dark" id="lblIndividualProjectCount">0</h2>
                        <p class="card-text small mb-2 text-muted">No. Of Individual Project Submission</p>
                    </div>
                    <div>
                        <button type="button" id="btn_ExportFocusedIndividualPbl" class="btn btn-sm btn-dark text-white fw-bold py-0 px-2 rounded-pill" style="font-size: 0.75rem;">More Info <i class="bi bi-arrow-right"></i></button>
                    </div>
                </div>
            </div>
        </div>

    </div>

    <!-- Footer Note -->
    <div class="text-center py-3 text-muted border rounded-3 bg-light-subtle small">
        <i class="bi bi-info-circle me-1"></i> All metrics update automatically based on system live records.
    </div>
</div>

<!-- =============================================================
     ASSIGNED SCHOOLS MODAL (For Card 1)
============================================================= -->
<div class="modal fade" id="volunteerSchoolsModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content rounded-4 border-0 shadow-lg bg-white">
            <div class="modal-header border-bottom px-4 py-3">
                <h5 class="fw-bold text-dark m-0"><i class="bi bi-building text-primary me-2"></i> My Assigned Schools</h5>
                <button type="button" class="btn-close shadow-none" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-4">
                <div class="table-responsive">
                    <table class="table table-hover align-middle small mb-0">
                        <thead class="table-light text-muted">
                            <tr><th style="width:60px;">#</th><th>School</th><th>Assigned Date</th><th>Assigned By</th></tr>
                        </thead>
                        <tbody id="tblAssignedSchoolsList">
                            <tr><td colspan="4" class="text-center py-4 text-muted"><span class="spinner-border spinner-border-sm me-2"></span> Loading schools...</td></tr>
                        </tbody>
                    </table>
                </div>
            </div>
            <div class="modal-footer border-top px-4 py-3">
                <span class="text-muted small me-auto">Total Assigned: <strong id="modalAssignedSchoolCount">0</strong></span>
                <button type="button" class="btn btn-secondary btn-sm rounded-pill px-4" data-bs-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>

<!-- =============================================================
     REUSABLE GENERIC DETAIL MODAL (For Cards 2 to 9)
============================================================= -->
<div class="modal fade" id="genericDetailModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-fullscreen">
        <div class="modal-content rounded-4 border-0 shadow-lg bg-white">
            <div class="modal-header border-bottom px-4 py-3">
                <div>
                    <h5 class="fw-bold text-dark m-0" id="genericModalTitle">
                        <i class="bi bi-list-task text-primary me-2"></i> Details List
                    </h5>
                    <small class="text-muted" id="genericModalSubtitle">Records associated with your assigned scope</small>
                </div>
                <button type="button" class="btn-close shadow-none" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-3 d-flex flex-column">
                <div class="row g-2 align-items-center mb-3">
                    <div class="col-md-7">
                        <div class="input-group input-group-sm">
                            <span class="input-group-text bg-white"><i class="bi bi-search"></i></span>
                            <input type="text" id="modalTableSearch" class="form-control" placeholder="Search records...">
                            <button type="button" id="btnClearSearch" class="btn btn-outline-secondary">Clear</button>
                        </div>
                    </div>
                    <div class="col-md-2">
                        <select id="modalPageSize" class="form-select form-select-sm">
                            <option value="25">25</option>
                            <option value="50">50</option>
                            <option value="100" selected>100</option>
                            <option value="250">250</option>
                            <option value="500">500 rows</option>
                            <option value="1000">1000 rows</option>
                            <option value="10000">10000 rows</option>
                        </select>
                    </div>
                    <div class="col-md-3 text-md-end">
                        <button type="button" id="btnExportModalData" class="btn btn-sm btn-success">
                            <i class="bi bi-file-earmark-excel me-1"></i> Export Excel
                        </button>
                    </div>
                </div>

                <div class="table-responsive flex-grow-1" id="genericTableWrapper">
                    <table class="table table-hover align-middle small mb-0" id="genericDetailsTable">
                        <thead class="table-light text-muted sticky-top" id="genericTableHead">
                            <tr><th>#</th><th>Details</th></tr>
                        </thead>
                        <tbody id="genericTableBody">
                            <tr><td colspan="100%" class="text-center py-5 text-muted"><span class="spinner-border spinner-border-sm me-2"></span> Loading...</td></tr>
                        </tbody>
                    </table>
                </div>
            </div>
            <div class="modal-footer border-top px-4 py-3">
                <span class="text-muted small me-auto">
                    <span id="paginationInfo">Showing 0 entries</span>
                    &nbsp;|&nbsp; Total Records: <strong id="genericModalCount">0</strong>
                </span>
                <nav aria-label="Details pagination">
                    <ul class="pagination pagination-sm mb-0" id="modalPagination"></ul>
                </nav>
                <button type="button" class="btn btn-secondary btn-sm rounded-pill px-4" data-bs-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>
<!-- ========================================================= -->
<div id="globalLoader" class="global-loader-overlay" style="display: none;">
    <div class="text-center">
        <div class="spinner-border text-primary shadow-lg" style="width: 3.5rem; height: 3.5rem;" role="status">
            <span class="visually-hidden">Loading...</span>
        </div>
        <div class="fw-bold text-dark mt-3 fs-5" id="globalLoaderText">Generating Report, Please Wait...</div>
    </div>
</div>
<script>
    (function() {
        "use strict";

        function getAuthToken() {
            return localStorage.getItem("jwt_token") || sessionStorage.getItem("jwt_token") || "";
        }

        function escapeHtml(value) {
            if (value === null || value === undefined) return "";
            var div = document.createElement("div");
            div.textContent = String(value);
            return div.innerHTML;
        }

        async function fetchAssignedSchools() {
            try {
                var token = getAuthToken();
                var response = await fetch("/api/affiliate-dashboard/my-assigned-schools", {
                    method: "GET",
                    headers: {
                        "Accept": "application/json",
                        "Authorization": token ? "Bearer " + token : ""
                    },
                    credentials: "same-origin",
                    cache: "no-store"
                });

                if (!response.ok) {
                    console.error("API Error Status:", response.status);
                    return [];
                }

                var result = await response.json();
                return (result && result.success && Array.isArray(result.data)) ? result.data : [];
            } catch (error) {
                console.error("Fetch error:", error);
                return [];
            }
        }

        async function loadVolunteerAssignedSchoolCount() {
            var schools = await fetchAssignedSchools();
            var count = schools ? schools.length : 0;

            var schoolCountEl = document.getElementById("cntAssociatedSchools");
            var modalCountEl = document.getElementById("modalAssignedSchoolCount");

            if (schoolCountEl) schoolCountEl.textContent = count;
            if (modalCountEl) modalCountEl.textContent = count;

            var tableBody = document.getElementById("tblAssignedSchoolsList");
            if (tableBody) {
                if (count === 0) {
                    tableBody.innerHTML = `<tr><td colspan="4" class="text-center py-4 text-muted">No schools assigned.</td></tr>`;
                    return;
                }
                let rows = "";
                schools.forEach((school, index) => {
                    rows += `<tr>
                                <td class="fw-bold text-muted">${index + 1}</td>
                                <td><div class="fw-semibold text-dark">${escapeHtml(school.name || "-")}</div><small class="text-muted">ID: ${escapeHtml(school.instituteID || school.InstituteID || "-")}</small></td>
                                <td><span class="badge bg-primary-subtle text-primary rounded-pill px-3">${escapeHtml(school.assignedDate ? new Date(school.assignedDate).toLocaleDateString() : "-")}</span></td>
                                <td>${escapeHtml(school.assignedBy || "-")}</td>
                            </tr>`;
                });
                tableBody.innerHTML = rows;
            }
        }

        async function loadSummaryCounts() {
            try {
                var token = getAuthToken();
                const res = await fetch("/api/affiliate-dashboard/dashboard-focused_summary-counts", {
                    method: "GET",
                    headers: {
                        "Accept": "application/json",
                        "Authorization": token ? "Bearer " + token : ""
                    },
                    credentials: "same-origin",
                    cache: "no-store"
                });
                const json = await res.json();
                if (json.success && json.data) {
                    document.getElementById("cntAssociatedSchools").textContent = json.data.schoolcount || 0;
                    document.getElementById("lblTotalStudentCount").textContent = json.data.totalStudents || 0;
                    document.getElementById("lblActiveStudentCount").textContent = json.data.activeStudents || 0;
                    document.getElementById("lblTotalTeacherCount").textContent = json.data.totalTeachers || 0;
                    document.getElementById("lblActiveTeacherCount").textContent = json.data.activeTeachers || 0;
                    document.getElementById("lblTotalSelProjectCount").textContent = json.data.totalSelProjects || 0;
                    document.getElementById("lblFamilyProjectCount").textContent = json.data.familyProjects || 0;
                    document.getElementById("lblIndividualProjectCount").textContent = json.data.individualProjects || 0;
                    document.getElementById("lblGroupPblCount").textContent = json.data.groupPbl || 0;
                }
            } catch (err) {
                console.error("Failed to load summary counts", err);
            }
        }

        // Event Listeners binding
        var btnSchools = document.getElementById("btnOpenassociatedSchools");
        if (btnSchools) {
            btnSchools.addEventListener("click", function(e) {
                e.preventDefault();
                e.stopPropagation();
                if (typeof window.openAssociatedSchoolsModal === "function") {
                   // window.openAssociatedSchoolsModal();
                }
            });
        }

        // Initial calls inside partial view
        loadVolunteerAssignedSchoolCount();
        loadSummaryCounts();

    })();
</script>
<script>
    (function() {
        "use strict";

        function getAuthToken() {
            return localStorage.getItem("jwt_token") ||
                sessionStorage.getItem("jwt_token") ||
                "";
        }

        function escapeHtml(value) {
            if (value === null || value === undefined) return "";
            var div = document.createElement("div");
            div.textContent = String(value);
            return div.innerHTML;
        }

    
        let currentCategory = '';
        let currentType = '';
        let currentPage = 1;
        let totalPages = 1;
        let searchTimeout = null;

        window.openDetailsModal = function(category, type) {

            currentCategory = category || "";
            currentType = type || "";
            currentPage = 1;
            totalPages = 1;

            // Safely clear search.
            const searchElement = $('#genericDetailsTableSearch');

            if (searchElement.length) {
                searchElement.val('');
            }

            $('#genericModalCount').text('0');
            $('#paginationInfo').text('Showing 0 entries');
            $('#modalPagination').empty();

            const titleMap = {
                'total-schools': 'Associated Schools',
                'total-students': 'Total Students',
                'active-students': 'Active Students',
                'total-teachers': 'Total Teachers',
                'active-teachers': 'Active Teachers',
                'sel-projects': 'Total SEL Projects',
                'family-projects': 'Family Projects',
                'individual-projects': 'Individual Projects',
                'group-pbl': 'Group PBL'
            };

            const categoryTitle =
                category === 'performance'
                    ? 'Performance Report'
                    : 'Focused Report';

            $('#genericModalTitle').html(
                '<i class="bi bi-list-task text-primary me-2"></i>' +
                categoryTitle +
                ' - ' +
                (titleMap[type] || 'Details')
            );

            $('#genericModalSubtitle').text(
                'Records associated with your assigned scope'
            );

            showModalLoader();

            const modalElement =
                document.getElementById('genericDetailModal');

            if (!modalElement) {
                console.error(
                    'genericDetailModal element was not found.'
                );
                return;
            }

            if (
                typeof bootstrap === 'undefined' ||
                !bootstrap.Modal
            ) {
                console.error(
                    'Bootstrap Modal is not available.'
                );
                return;
            }

            const modal =
                bootstrap.Modal.getOrCreateInstance(modalElement);

            modal.show();

            loadModalDataPaged();
        };;

        function showModalLoader() {

            $('#genericTableHead').html('');

            $('#genericTableBody').html(`
            <tr>
                <td colspan="100%" class="text-center py-5">

                    <div class="modal-loader">

                        <div
                            class="spinner-border text-primary"
                            role="status">
                            <span class="visually-hidden">
                                Loading...
                            </span>
                        </div>

                        <div class="text-muted small mt-3">
                            Fetching records from server...
                        </div>

                    </div>

                </td>
            </tr>
        `);
        }

        window.loadModalDataPaged = function() {

            const affiliateId = '@affiliateId';

            // Safely read page size.
            const pageSizeElement = $('#modalPageSize');
            const pageSizeValue = pageSizeElement.length
                ? pageSizeElement.val()
                : 100;

            const pageSize = parseInt(pageSizeValue, 10) || 100;

            // Safely read search value.
            const searchElement = $('#genericDetailsTableSearch');

            let searchValue = "";

            if (searchElement.length) {
                const rawValue = searchElement.val();

                if (rawValue !== null && rawValue !== undefined) {
                    searchValue = String(rawValue);
                }
            }

            const searchTerm = searchValue.trim();

            const token = getAuthToken();

            console.log("Loading dashboard modal data:", {
                category: currentCategory,
                type: currentType,
                page: currentPage,
                pageSize: pageSize,
                search: searchTerm,
                affiliateId: affiliateId
            });

            $.ajax({
                url: '/api/admin/overall-details-paged',
                type: 'GET',

                data: {
                    category: currentCategory,
                    type: currentType,
                    page: currentPage,
                    pageSize: pageSize,
                    search: searchTerm,
                    affiliateid: affiliateId
                },

                headers: token
                    ? {
                        'Authorization': 'Bearer ' + token
                    }
                    : {},

                success: function(res) {

                    console.log("Dashboard modal response:", res);

                    if (
                        !res ||
                        !res.success ||
                        !Array.isArray(res.data) ||
                        res.data.length === 0
                    ) {

                        $('#genericTableHead').html(`
                        <tr>
                            <th>#</th>
                            <th>Details</th>
                        </tr>
                    `);

                        $('#genericTableBody').html(`
                        <tr>
                            <td colspan="100%" class="text-center py-5">
                                <div class="text-muted">
                                    <i class="bi bi-inbox fs-1 d-block mb-2"></i>

                                    <div class="fw-semibold">
                                        No records found
                                    </div>

                                    <small>
                                        No matching data available for your search criteria.
                                    </small>
                                </div>
                            </td>
                        </tr>
                    `);

                        $('#genericModalSubtitle').text('0 records');
                        $('#genericModalCount').text('0');
                        $('#paginationInfo').text('Showing 0 entries');
                        $('#modalPagination').empty();

                        totalPages = 1;

                        return;
                    }

                    totalPages = parseInt(res.totalPages, 10) || 1;

                    const responsePage =
                        parseInt(res.page, 10) || currentPage;

                    const totalRecords =
                        parseInt(res.totalRecords, 10) || res.data.length;

                    renderTableHeaders(res.data[0]);

                    renderTableRows(res.data);

                    renderPagination(
                        responsePage,
                        totalPages,
                        totalRecords
                    );

                    $('#genericModalCount').text(totalRecords);
                    $('#genericModalSubtitle').text(
                        `${totalRecords} total records`
                    );
                },

                error: function(xhr, status, error) {

                    console.error(
                        "Paged API error:",
                        xhr.responseText || error
                    );

                    $('#genericTableHead').html(`
                    <tr>
                        <th>#</th>
                        <th>Details</th>
                    </tr>
                `);

                    $('#genericTableBody').html(`
                    <tr>
                        <td colspan="100%" class="text-center py-5 text-danger">
                            <i class="bi bi-exclamation-triangle fs-2 d-block mb-2"></i>

                            <div class="fw-semibold">
                                Failed to load records
                            </div>

                            <small>
                                Please try again.
                            </small>
                        </td>
                    </tr>
                `);

                    $('#genericModalSubtitle').text(
                        'Unable to load records'
                    );

                    $('#genericModalCount').text('0');
                    $('#paginationInfo').text('Showing 0 entries');
                    $('#modalPagination').empty();

                    totalPages = 1;
                }
            });
        };
        window.formatColumnName = function (key) {
        if (!key) {
            return "";
        }

        let result = String(key)
            .replace(/([a-z])([A-Z])/g, "$1 $2")
            .replace(/_/g, " ")
            .replace(/-/g, " ");

        return result.charAt(0).toUpperCase() + result.slice(1);
    };
        // Render headers with click-to-sort capability
        window.renderTableHeaders = function(sampleRow) {
            if (!sampleRow) return;
            const keys = Object.keys(sampleRow);
            let thead = '<tr>';
            keys.forEach(key => {
                thead += `<th style="cursor: pointer;" onclick="sortModalTable('${key}')">
                                    ${formatColumnName(key)} <i class="bi bi-arrow-down-up text-muted small ms-1"></i>
                                  </th>`;
            });
