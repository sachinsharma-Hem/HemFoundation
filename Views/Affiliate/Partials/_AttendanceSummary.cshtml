<!-- Flatpickr CSS -->
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flatpickr/dist/flatpickr.min.css">
<!-- Flatpickr JS -->
<script src="https://cdn.jsdelivr.net/npm/flatpickr"></script>

<div class="card shadow-sm rounded-4 bg-white p-4 animate-fade-in" style="border: 1px solid #d9dfe5 !important;">

    <!-- ================= 1. ATTENDANCE & LEAVE SUMMARY SECTION ================= -->
    <div class="mb-3">
        <!-- Header & Date Filters with Button -->
        <div class="d-flex flex-wrap align-items-center justify-content-between mb-4 pb-3 border-bottom gap-3">
            <div>
                <h4 class="fw-bold text-danger mb-1"><i class="bi bi-calendar-range me-2"></i> My Attendance & Leave Summary</h4>
                <p class="text-muted small m-0">Monitor your attendance, approved leaves and absence within the selected date range.</p>
            </div>

            <div class="d-flex align-items-center gap-2 flex-wrap">
                <div class="d-flex align-items-center gap-1">
                    <label class="small fw-semibold text-muted m-0">From:</label>
                    <input type="text" id="myFilterFrom" class="form-control form-control-sm rounded-3 shadow-none bg-white" placeholder="DD/MM/YYYY" autocomplete="off" style="width: 120px;">
                </div>
                <div class="d-flex align-items-center gap-1">
                    <label class="small fw-semibold text-muted m-0">To:</label>
                    <input type="text" id="myFilterTo" class="form-control form-control-sm rounded-3 shadow-none bg-white" placeholder="DD/MM/YYYY" autocomplete="off" style="width: 120px;">
                </div>
                <!-- Filter Search Button -->
                <button type="button" id="btnApplyFilter" class="btn btn-primary btn-sm rounded-3 px-3 fw-semibold shadow-sm">
                    <i class="bi bi-search me-1"></i> Search
                </button>
            </div>
        </div>

        <!-- Quick Stat Highlights -->
        <div class="row g-3 mb-4">
            <div class="col-md-3">
                <div class="p-3 bg-light rounded-3 border border-secondary-subtle d-flex align-items-center justify-content-between h-100">
                    <div>
                        <span class="text-muted small d-block">Total Tracked Days</span>
                        <h3 class="fw-bold text-dark m-0" id="myStatTotalDays">0</h3>
                    </div>
                    <i class="bi bi-calendar-event fs-2 text-primary opacity-50"></i>
                </div>
            </div>
            <div class="col-md-3">
                <div class="p-3 bg-light rounded-3 border border-secondary-subtle d-flex align-items-center justify-content-between h-100">
                    <div>
                        <span class="text-muted small d-block">Days Visited</span>
                        <h3 class="fw-bold text-success m-0" id="myStatPresent">0</h3>
                    </div>
                    <i class="bi bi-check-circle fs-2 text-success opacity-50"></i>
                </div>
            </div>
            <div class="col-md-3">
                <div class="p-3 bg-light rounded-3 border border-secondary-subtle d-flex align-items-center justify-content-between h-100">
                    <div>
                        <span class="text-muted small d-block">Approved Leaves</span>
                        <h3 class="fw-bold text-warning m-0" id="myStatLeave">0</h3>
                    </div>
                    <i class="bi bi-calendar-minus fs-2 text-warning opacity-50"></i>
                </div>
            </div>
            <div class="col-md-3">
                <div class="p-3 bg-light rounded-3 border border-secondary-subtle d-flex align-items-center justify-content-between h-100">
                    <div>
                        <span class="text-muted small d-block">Days Absent</span>
                        <h3 class="fw-bold text-danger m-0" id="myStatAbsent">0</h3>
                    </div>
                    <i class="bi bi-x-circle fs-2 text-danger opacity-50"></i>
                </div>
            </div>
        </div>

        <!-- Attendance Data Table -->
        <div class="table-responsive border rounded-3 overflow-hidden shadow-sm">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-primary text-dark">
                    <tr>
                        <th class="py-3 px-3">Affiliate</th>
                        <th class="py-3 px-3">Total Days</th>
                        <th class="py-3 px-3">Days Visited</th>
                        <th class="py-3 px-3">Approved Leaves</th>
                        <th class="py-3 px-3">Days Absent</th>
                        <th class="py-3 px-3">User ID</th>
                    </tr>
                </thead>
                <tbody id="mySummaryTableBody">
                    <tr><td colspan="6" class="text-center py-4 text-muted"><div class="spinner-border spinner-border-sm me-2"></div> Loading your attendance data...</td></tr>
                </tbody>
            </table>
        </div>
    </div>
</div>

<style>
    .flatpickr-calendar {
        z-index: 99999 !important;
    }
</style>

<script>
    (function() {
        "use strict";

        function getAuthToken() {
            return localStorage.getItem("jwt_token") || sessionStorage.getItem("jwt_token") || "";
        }

        async function apiRequest(url, options = {}) {
            const token = getAuthToken();
            const headers = { "Authorization": "Bearer " + token };
            if (options.body) {
                headers["Content-Type"] = "application/json";
            }
            const response = await fetch(url, {
                ...options,
                headers: { ...headers, ...(options.headers || {}) }
            });
            let data = null;
            try { data = await response.json(); } catch { data = null; }
            if (!response.ok) {
                throw { status: response.status, data: data };
            }
            return data;
        }

        function convertDDMMYYYYToISO(value) {
            if (!value) return null;
            const parts = value.split("/");
            if (parts.length !== 3) return null;
            // parts[0] = Day, parts[1] = Month, parts[2] = Year
            return `${parts[2]}-${parts[1]}-${parts[0]}`;
        }

        let summaryFromPicker = null;
        let summaryToPicker = null;

        function initAttendanceSummaryModule() {
            // 1. Initialize Flatpickr calendars
            if (typeof flatpickr !== "undefined") {
                const today = new Date();
                today.setHours(0, 0, 0, 0);
                const firstDay = new Date(today.getFullYear(), today.getMonth(), 1);

                summaryFromPicker = flatpickr("#myFilterFrom", {
                    dateFormat: "d/m/Y",
                    defaultDate: firstDay,
                    maxDate: today,
                    disableMobile: true,
                    allowInput: false,
                    onChange: function(selectedDates) {
                        if (selectedDates && selectedDates.length > 0) {
                            const selectedDate = selectedDates[0];
                            summaryToPicker.set("minDate", selectedDate);

                            const currentTo = summaryToPicker.selectedDates[0];
                            if (currentTo && currentTo < selectedDate) {
                                summaryToPicker.setDate(selectedDate, true);
                            }
                        }
                    }
                });

                summaryToPicker = flatpickr("#myFilterTo", {
                    dateFormat: "d/m/Y",
                    defaultDate: today,
                    maxDate: today,
                    minDate: firstDay,
                    disableMobile: true,
                    allowInput: false
                });
            }

            // 2. Load initial data on page/module load
            loadMySummaryData();

            // 3. Search button click event
            const btnFilter = document.getElementById("btnApplyFilter");
            if (btnFilter) {
                btnFilter.onclick = function() {
                    loadMySummaryData();
                };
            }
        }

        window.loadMySummaryData = async function() {
            const fromVal = document.getElementById("myFilterFrom")?.value;
            const toVal = document.getElementById("myFilterTo")?.value;

            const today = new Date();
            const firstDay = new Date(today.getFullYear(), today.getMonth(), 1);

            // Fallback default dates (YYYY-MM-DD format)
            const defaultFromISO = firstDay.toISOString().split("T")[0];
            const defaultToISO = today.toISOString().split("T")[0];

            // DD/MM/YYYY ko strictly YYYY-MM-DD me convert karna
            const fromISO = convertDDMMYYYYToISO(fromVal) || defaultFromISO;
            const toISO = convertDDMMYYYYToISO(toVal) || defaultToISO;

            try {
                const res = await apiRequest(`/api/affiliate-attendance/my-summary?fromDate=${encodeURIComponent(fromISO)}&toDate=${encodeURIComponent(toISO)}`);

                if (res.success) {
                    document.getElementById("myStatTotalDays").textContent = res.totalDays ?? 0;
                    document.getElementById("myStatPresent").textContent = res.presentCount ?? 0;
                    document.getElementById("myStatLeave").textContent = res.leaveCount ?? 0;
                    document.getElementById("myStatAbsent").textContent = res.absentCount ?? 0;

                    const tableBody = document.getElementById("mySummaryTableBody");
                    tableBody.innerHTML = `
                        <tr>
                            <td class="px-3 fw-semibold text-primary">
                                <i class="bi bi-person-circle me-1"></i> ${escapeHtml(res.affiliateName || "N/A")}
                            </td>
                            <td class="px-3">${res.totalDays ?? 0}</td>
                            <td class="px-3">
                                <span class="badge bg-success-subtle text-success border border-success-subtle px-2 py-1">${res.presentCount ?? 0}</span>
                            </td>
                            <td class="px-3">
                                <span class="badge bg-warning-subtle text-dark border border-warning-subtle px-2 py-1">${res.leaveCount ?? 0}</span>
                            </td>
                            <td class="px-3">
                                <span class="badge bg-danger-subtle text-danger border border-danger-subtle px-2 py-1">${res.absentCount ?? 0}</span>
                            </td>
                            <td class="px-3 text-muted font-monospace small">${escapeHtml(res.affiliateCode || "-")}</td>
                        </tr>
                    `;
                } else {
                    document.getElementById("mySummaryTableBody").innerHTML = `
                        <tr><td colspan="6" class="text-center text-muted py-4">No summary data available for this range.</td></tr>
                    `;
                }
            } catch (error) {
                console.error("My summary load error:", error);
                document.getElementById("mySummaryTableBody").innerHTML = `
                    <tr>
                        <td colspan="6" class="text-center text-danger py-4">
                            <i class="bi bi-exclamation-triangle me-1"></i> Unable to load your attendance data.
                        </td>
                    </tr>
                `;
            }
        };

        function escapeHtml(value) {
            if (value === null || value === undefined) return "";
            return String(value)
                .replace(/&/g, "&amp;")
                .replace(/</g, "&lt;")
                .replace(/>/g, "&gt;")
                .replace(/"/g, "&quot;")
                .replace(/'/g, "&#039;");
        }

        // Yeh check ensure karega ki script chahe direct load ho ya AJAX partial ke zariye, chale zaroor
        if (document.readyState === "loading") {
            document.addEventListener("DOMContentLoaded", initAttendanceSummaryModule);
        } else {
            initAttendanceSummaryModule();
        }
    })();
</script>