<!-- Include Select2 CSS for searchable dropdown -->
<link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />
<link href="https://cdn.jsdelivr.net/npm/select2-bootstrap-5-theme@1.3.0/dist/select2-bootstrap-5-theme.min.css" rel="stylesheet" />

<div class="card border-0 shadow-sm rounded-4 bg-white p-4 animate-fade-in" style="border: 1px solid #d9dfe5 !important;">
    <div class="d-flex align-items-center justify-content-between mb-4 pb-3 border-bottom">
        <div>
            <h4 class="fw-bold text-success mb-1"><i class="bi bi-calendar-check me-2"></i> Plan Visit Module</h4>
            <p class="text-muted small m-0">Schedule and manage upcoming school and institution visits.</p>
        </div>
        <button class="btn btn-success btn-sm rounded-pill px-3 fw-semibold shadow-sm" onclick="openAddVisitModal()">
            <i class="bi bi-plus-lg me-1"></i> Add New Visit
        </button>
    </div>

    <div class="table-responsive">
        <table class="table table-hover align-middle small">
            <thead class="table-light text-muted">
                <tr>
                    <th>Scheduled Date</th>
                    <th>Assigned School</th>
                    <th>Purpose</th>
                    <th>Status</th>
                    <th class="text-center">Action / History</th>
                </tr>
            </thead>
            <tbody id="visitsTableBody">
                <tr><td colspan="5" class="text-center py-5 text-muted"><div class="spinner-border spinner-border-sm"></div> Loading visits...</td></tr>
            </tbody>
        </table>
    </div>
</div>

<!-- Add Visit Modal -->
<div class="modal fade" id="addVisitModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content rounded-4 border-0 shadow-lg p-3 bg-white">
            <div class="modal-header border-bottom pb-3">
                <h5 class="fw-bold text-dark m-0"><i class="bi bi-calendar-plus text-success me-2"></i> Schedule New Visit</h5>
                <button type="button" class="btn-close shadow-none" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body py-3">
                <form id="frmPlanVisit">
                    <div class="mb-3">
                        <label class="form-label small fw-bold text-muted">Select Assigned School <span class="text-danger">*</span></label>
                        <select id="ddlMySchools" class="form-select rounded-3 shadow-none" required>
                            <option value="">Loading schools...</option>
                        </select>
                        <small class="text-muted" style="font-size: 0.7rem;">Only schools assigned to you are listed here.</small>
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-bold text-muted">Schedule Date & Time <span class="text-danger">*</span></label>
                        <input type="datetime-local" id="txtScheduleDate" class="form-control rounded-3 shadow-none" required>
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-bold text-muted">Purpose of Visit <span class="text-danger">*</span></label>
                        <textarea id="txtPurpose" class="form-control rounded-3 shadow-none" rows="3" placeholder="E.g., Initial Meeting, Follow-up, Training..." required></textarea>
                    </div>
                    <button type="submit" class="btn btn-success w-100 rounded-pill fw-bold shadow-sm mt-2">Save Schedule</button>
                </form>
            </div>
        </div>
    </div>
</div>

<!-- Update Status Modal -->
<div class="modal fade" id="updateStatusModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-sm">
        <div class="modal-content rounded-4 border-0 shadow-lg p-3 bg-white">
            <div class="modal-header border-bottom pb-3">
                <h5 class="fw-bold text-dark m-0">Update Status</h5>
                <button type="button" class="btn-close shadow-none" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body py-3">
                <input type="hidden" id="hdnVisitId">
                <div class="mb-3">
                    <label class="form-label small fw-bold">New Status</label>
                    <select id="ddlStatus" class="form-select rounded-3 shadow-none">
                        <option value="Active">Mark as Active (In Progress)</option>
                        <option value="Cancelled">Mark as Cancelled</option>
                    </select>
                </div>
                <div class="mb-3">
                    <label class="form-label small fw-bold">Remarks (Optional)</label>
                    <textarea id="txtStatusRemarks" class="form-control rounded-3 shadow-none" rows="2" placeholder="Add notes or reason..."></textarea>
                </div>
                <button type="button" class="btn btn-primary w-100 rounded-pill fw-bold" onclick="saveStatusUpdate()">Update</button>
            </div>
        </div>
    </div>
</div>

<!-- Visit History Modal -->
<div class="modal fade" id="visitHistoryModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-md">
        <div class="modal-content rounded-4 border-0 shadow-lg p-3 bg-white">
            <div class="modal-header border-bottom pb-3">
                <div>
                    <h5 class="fw-bold text-dark m-0"><i class="bi bi-clock-history text-primary me-2"></i> Visit Lifecycle</h5>
                    <small class="text-muted" id="lblHistorySchoolName">School Name</small>
                </div>
                <button type="button" class="btn-close shadow-none" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body py-4">
                <div class="timeline-tree position-relative ps-4" id="visitTimelineContainer">
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    /* Timeline Tree CSS */
    .timeline-tree::before {
        content: '';
        position: absolute;
        left: 12px;
        top: 5px;
        bottom: 5px;
        width: 3px;
        background: #e9ecef;
        border-radius: 2px;
    }

    .timeline-item {
        position: relative;
        margin-bottom: 20px;
    }

        .timeline-item:last-child {
            margin-bottom: 0;
        }

    .timeline-badge {
        position: absolute;
        left: -28px;
        top: 2px;
        width: 18px;
        height: 18px;
        border-radius: 50%;
        background: #0d6efd;
        border: 3px solid #fff;
        box-shadow: 0 0 0 2px rgba(13, 110, 253, 0.2);
    }
</style>

<!-- Include Select2 JS and SweetAlert2 JS -->
<script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

<script>
    $(function() {
        loadMyVisits();
        loadAssignedSchools();
        setMinDateTime();

        // Initialize Select2 with Bootstrap 5 Theme inside modal
        $('#ddlMySchools').select2({
            theme: 'bootstrap-5',
            dropdownParent: $('#addVisitModal')
        });

        $('#frmPlanVisit').on('submit', function(e) {
            e.preventDefault();
            let model = {
                InstituteID: parseInt($('#ddlMySchools').val()),
                ScheduleDate: $('#txtScheduleDate').val(),
                Purpose: $('#txtPurpose').val()
            };

            $.ajax({
                url: '/api/plan-visit/create',
                type: 'POST',
                contentType: 'application/json',
                headers: { 'Authorization': 'Bearer ' + (localStorage.getItem('jwt_token') || sessionStorage.getItem('jwt_token') || '') },
                data: JSON.stringify(model),
                success: function(res) {
                    if (res.success) {
                        $('#addVisitModal').modal('hide');
                        $('#frmPlanVisit')[0].reset();
                        $('#ddlMySchools').val(null).trigger('change');
                        setMinDateTime();
                        loadMyVisits();

                        // Success Popup Alert
                        Swal.fire({
                            icon: 'success',
                            title: 'Saved Successfully!',
                            text: 'Your visit has been scheduled successfully.',
                            timer: 2000,
                            showConfirmButton: false
                        });
                    }
                }
            });
        });
    });

    // Function to restrict backdate selection in datetime-local input
    function setMinDateTime() {
        let now = new Date();
        now.setMinutes(now.getMinutes() - now.getTimezoneOffset());
        let formattedCurrentDate = now.toISOString().slice(0, 16);
        $('#txtScheduleDate').attr('min', formattedCurrentDate);
    }

    function getAuthToken() { return localStorage.getItem('jwt_token') || sessionStorage.getItem('jwt_token') || ''; }

    function getStatusBadge(status) {
        switch (status) {
            case 'Pending': return '<span class="badge bg-warning-subtle text-warning border border-warning-subtle px-2">Pending</span>';
            case 'Active': return '<span class="badge bg-primary-subtle text-primary border border-primary-subtle px-2">Active</span>';
            case 'Completed': return '<span class="badge bg-success-subtle text-success border border-success-subtle px-2">Completed</span>';
            case 'Cancelled': return '<span class="badge bg-danger-subtle text-danger border border-danger-subtle px-2">Cancelled</span>';
            default: return `<span class="badge bg-secondary">${status}</span>`;
        }
    }

    function loadAssignedSchools() {
        $.ajax({
            url: '/api/plan-visit/my-schools',
            type: 'GET',
            headers: { 'Authorization': 'Bearer ' + getAuthToken() },
            success: function(res) {
                if (res.success && res.data) {
                    let opts = '<option value="">-- Select Assigned School --</option>';
                    res.data.forEach(s => { opts += `<option value="${s.instituteID}">${s.name} (${s.city || 'N/A'})</option>`; });
                    $('#ddlMySchools').html(opts).trigger('change');
                }
            }
        });
    }

    function loadMyVisits() {
        $.ajax({
            url: '/api/plan-visit/list',
            type: 'GET',
            headers: { 'Authorization': 'Bearer ' + getAuthToken() },
            success: function(res) {
                if (res.success && res.data.length > 0) {
                    let html = '';
                    res.data.forEach(v => {
                        let d = new Date(v.scheduleDate);
                        let dateStr = `${String(d.getDate()).padStart(2, '0')}/${String(d.getMonth() + 1).padStart(2, '0')}/${d.getFullYear()} <br/> <small class="text-muted">${d.toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' })}</small>`;

                        let statusBtn = v.status !== 'Completed' && v.status !== 'Cancelled'
                            ? `<button class="btn btn-sm btn-light border px-2 shadow-none" onclick="openStatusModal(${v.id}, '${v.status}')" title="Change Status"><i class="bi bi-pencil-square text-primary"></i></button>`
                            : '';

                        html += `<tr>
                                        <td class="fw-semibold text-dark">${dateStr}</td>
                                        <td><b>${v.schoolName}</b><br><small class="text-muted">${v.schoolCity || ''}</small></td>
                                        <td>${v.purpose}</td>
                                        <td>${getStatusBadge(v.status)} ${statusBtn}</td>
                                        <td class="text-center">
                                            <button class="btn btn-outline-info btn-sm rounded-pill px-3 shadow-none" onclick="viewHistory(${v.instituteID})">
                                                <i class="bi bi-clock-history me-1"></i> Lifecycle
                                            </button>
                                        </td>
                                    </tr>`;
                    });
                    $('#visitsTableBody').html(html);
                } else {
                    $('#visitsTableBody').html('<tr><td colspan="5" class="text-center py-5 text-muted"><i class="bi bi-calendar-x fs-3 d-block mb-2"></i> No planned visits found. Create one!</td></tr>');
                }
            }
        });
    }

    function openAddVisitModal() {
        setMinDateTime();
        $('#addVisitModal').modal('show');
    }

    function openStatusModal(id, currentStatus) {
        $('#hdnVisitId').val(id);
        $('#ddlStatus').val(currentStatus == 'Pending' ? 'Active' : currentStatus);
        $('#txtStatusRemarks').val('');
        $('#updateStatusModal').modal('show');
    }

    function saveStatusUpdate() {
        let id = $('#hdnVisitId').val();
        let payload = {
            Status: $('#ddlStatus').val(),
            Remarks: $('#txtStatusRemarks').val()
        };

        $.ajax({
            url: `/api/plan-visit/update-status/${id}`,
            type: 'POST',
            contentType: 'application/json',
            headers: { 'Authorization': 'Bearer ' + getAuthToken() },
            data: JSON.stringify(payload),
            success: function(res) {
                if (res.success) {
                    $('#updateStatusModal').modal('hide');
                    loadMyVisits();

                    // Success Popup Alert for Status Update
                    Swal.fire({
                        icon: 'success',
                        title: 'Updated Successfully!',
                        text: 'Visit status has been updated.',
                        timer: 2000,
                        showConfirmButton: false
                    });
                }
            }
        });
    }

    function viewHistory(instituteId) {
        $('#visitHistoryModal').modal('show');
        $('#visitTimelineContainer').html('<div class="text-center text-muted py-3"><div class="spinner-border spinner-border-sm"></div></div>');

        $.ajax({
            url: `/api/plan-visit/school-history/${instituteId}`,
            type: 'GET',
            headers: { 'Authorization': 'Bearer ' + getAuthToken() },
            success: function(res) {
                if (res.success) {
                    $('#lblHistorySchoolName').text(res.schoolName);
                    if (res.data.length > 0) {
                        let html = '';
                        res.data.forEach((item, index) => {
                            let bColor = item.status == 'Completed' ? '#198754' : (item.status == 'Cancelled' ? '#dc3545' : '#0d6efd');
                            let d = new Date(item.scheduleDate);
                            let dStr = `${String(d.getDate()).padStart(2, '0')}/${String(d.getMonth() + 1).padStart(2, '0')}/${d.getFullYear()}`;

                            html += `<div class="timeline-item">
                                            <div class="timeline-badge" style="background: ${bColor}; border-color: white;"></div>
                                            <div class="p-3 bg-light rounded-3 border">
                                                <div class="d-flex justify-content-between">
                                                    <span class="fw-bold text-dark">${dStr}</span>
                                                    ${getStatusBadge(item.status)}
                                                </div>
                                                <p class="text-muted small m-0 mt-1"><b>Purpose:</b> ${item.purpose}</p>
                                                ${item.remarks ? `<p class="text-danger small m-0 mt-1"><b>Note:</b> ${item.remarks}</p>` : ''}
                                            </div>
                                        </div>`;
                        });
                        $('#visitTimelineContainer').html(html);
                    } else {
                        $('#visitTimelineContainer').html('<div class="text-center text-muted py-3">No history found.</div>');
                    }
                }
            }
        });
    }
</script>