@{
    ViewData["Title"] = "Affiliate Attendance Master";
    Layout = "~/Views/Shared/Layouts/_AdminLayout.cshtml";
}

<div class="container-fluid py-4">
    <div class="d-flex align-items-center justify-content-between mb-4">
        <div>
            <h3 class="fw-bold text-dark m-0"><i class="bi bi-person-badge text-primary me-2"></i> Affiliate Attendance</h3>
            <p class="text-muted small m-0">Monitor real-time punch-ins, absences, and total working hours of all affiliates.</p>
        </div>
    </div>

    <div class="card border-0 shadow-sm rounded-4 bg-white p-3 mb-4">
        <div class="row g-2 align-items-end">
            <div class="col-md-3">
                <label class="form-label text-muted small fw-semibold m-0">Select Affiliate</label>
                <select id="filterAffiliate" class="form-select form-select-sm rounded-3 shadow-none">
                    <option value="">All Affiliates (Overall)</option>
                    </select>
            </div>
            <div class="col-md-3">
                <label class="form-label text-muted small fw-semibold m-0">From Date</label>
                <input type="date" id="filterFromDate" class="form-control form-control-sm rounded-3 shadow-none">
            </div>
            <div class="col-md-3">
                <label class="form-label text-muted small fw-semibold m-0">To Date</label>
                <input type="date" id="filterToDate" class="form-control form-control-sm rounded-3 shadow-none">
            </div>
            <div class="col-md-3 d-flex gap-2">
                <button class="btn btn-primary btn-sm w-100 rounded-3 fw-semibold shadow-sm" onclick="loadAllData()">
                    <i class="bi bi-funnel me-1"></i> Search
                </button>
                <button class="btn btn-light btn-sm border rounded-3" onclick="resetFilters()">
                    <i class="bi bi-arrow-counterclockwise"></i>
                </button>
            </div>
        </div>
    </div>

    <div class="row g-4 mb-4" id="statsContainer">
        <div class="col-md-4">
            <div class="card border-0 shadow-sm rounded-4 bg-white p-4 h-100 border-start border-4 border-primary">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <p class="text-muted small fw-semibold mb-1">Total Affiliates</p>
                        <h3 class="fw-bold text-dark m-0" id="statTotal">0</h3>
                    </div>
                    <div class="bg-primary-subtle text-primary rounded-circle d-flex justify-content-center align-items-center" style="width: 50px; height: 50px;">
                        <i class="bi bi-people-fill fs-4"></i>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card border-0 shadow-sm rounded-4 bg-white p-4 h-100 border-start border-4 border-success">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <p class="text-muted small fw-semibold mb-1">Present (On End Date)</p>
                        <h3 class="fw-bold text-success m-0" id="statPresent">0</h3>
                    </div>
                    <div class="bg-success-subtle text-success rounded-circle d-flex justify-content-center align-items-center" style="width: 50px; height: 50px;">
                        <i class="bi bi-check-circle-fill fs-4"></i>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card border-0 shadow-sm rounded-4 bg-white p-4 h-100 border-start border-4 border-danger">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <p class="text-muted small fw-semibold mb-1">Absent (On End Date)</p>
                        <h3 class="fw-bold text-danger m-0" id="statAbsent">0</h3>
                    </div>
                    <div class="bg-danger-subtle text-danger rounded-circle d-flex justify-content-center align-items-center" style="width: 50px; height: 50px;">
                        <i class="bi bi-x-circle-fill fs-4"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="card border-0 shadow-sm rounded-4 bg-white overflow-hidden">
        <div class="card-header bg-white border-bottom pt-3 pb-0 px-4">
            <ul class="nav nav-tabs border-0" id="attendanceTabs" role="tablist">
                <li class="nav-item" role="presentation">
                    <button class="nav-link active fw-semibold text-dark border-0 border-bottom border-3 border-primary bg-transparent" id="summary-tab" data-bs-toggle="tab" data-bs-target="#summaryPane" type="button" role="tab">
                        <i class="bi bi-pie-chart-fill text-primary me-1"></i> Overall Summary
                    </button>
                </li>
                <li class="nav-item" role="presentation">
                    <button class="nav-link fw-semibold text-muted border-0 bg-transparent" id="logs-tab" data-bs-toggle="tab" data-bs-target="#logsPane" type="button" role="tab">
                        <i class="bi bi-list-columns-reverse text-secondary me-1"></i> Detailed Logs
                    </button>
                </li>
            </ul>
        </div>
        
        <div class="card-body p-0">
            <div class="tab-content" id="attendanceTabsContent">
                
                <div class="tab-pane fade show active p-4" id="summaryPane" role="tabpanel">
                    <div class="table-responsive">
                        <table class="table table-hover align-middle">
                            <thead class="table-light text-muted small">
                                <tr>
                                    <th>Affiliate Name</th>
                                    <th>Code</th>
                                    <th class="text-center">Days Present</th>
                                    <th class="text-center">Days Absent</th>
                                    <th class="text-center">Total Hours</th>
                                </tr>
                            </thead>
                            <tbody id="summaryTableBody">
                                <tr><td colspan="5" class="text-center py-4 text-muted">Loading summary...</td></tr>
                            </tbody>
                        </table>
                    </div>
                </div>

                <div class="tab-pane fade p-4" id="logsPane" role="tabpanel">
                    
                    <div id="individualSummaryBanner" class="d-none mb-4 p-3 bg-light rounded-4 border d-flex justify-content-between align-items-center">
                        <div>
                            <h5 class="fw-bold text-dark m-0 mb-1" id="indAffiliateName">User Name</h5>
                            <span class="badge bg-secondary-subtle text-secondary" id="indAffiliateCode">Code</span>
                        </div>
                        <div class="d-flex gap-3 text-center">
                            <div class="px-3 border-end">
                                <small class="text-muted d-block fw-semibold">Present</small>
                                <h4 class="fw-bold text-success m-0" id="indPresent">0</h4>
                            </div>
                            <div class="px-3 border-end">
                                <small class="text-muted d-block fw-semibold">Absent</small>
                                <h4 class="fw-bold text-danger m-0" id="indAbsent">0</h4>
                            </div>
                            <div class="px-3">
                                <small class="text-muted d-block fw-semibold">Total Hours</small>
                                <h4 class="fw-bold text-primary m-0" id="indHours">0.0</h4>
                            </div>
                        </div>
                    </div>

                    <div class="table-responsive">
                        <table class="table table-hover align-middle small">
                            <thead class="table-light text-muted">
                                <tr>
                                    <th>Date</th>
                                    <th>Affiliate</th>
                                    <th>Punch In</th>
                                    <th>Punch Out</th>
                                    <th>Status</th>
                                </tr>
                            </thead>
                            <tbody id="logsTableBody">
                                <tr><td colspan="5" class="text-center py-4 text-muted">Loading logs...</td></tr>
                            </tbody>
                        </table>
                    </div>
                </div>

            </div>
        </div>
    </div>
</div>

<script>
    document.addEventListener("DOMContentLoaded", function () {
        // Tab UI logic
        const tabs = document.querySelectorAll('#attendanceTabs .nav-link');
        tabs.forEach(tab => {
            tab.addEventListener('click', function() {
                tabs.forEach(t => {
                    t.classList.remove('border-bottom', 'border-3', 'border-primary', 'text-dark');
                    t.classList.add('text-muted');
                });
                this.classList.remove('text-muted');
                this.classList.add('border-bottom', 'border-3', 'border-primary', 'text-dark');
            });
        });

        // Set default filter dates to start of current month and today
        let today = new Date();
        let firstDay = new Date(today.getFullYear(), today.getMonth(), 1).toISOString().split('T')[0];
        let todayStr = today.toISOString().split('T')[0];
        
        $('#filterFromDate').val(firstDay);
        $('#filterToDate').val(todayStr);

        loadAffiliateDropdown();
        loadAllData();
    });

    function getAuthToken() { return localStorage.getItem('jwt_token') || sessionStorage.getItem('jwt_token') || ''; }

    function formatDateDDMMYYYY(dateString) {
        if (!dateString) return '-';
        let d = new Date(dateString);
        return `${String(d.getDate()).padStart(2, '0')}/${String(d.getMonth() + 1).padStart(2, '0')}/${d.getFullYear()}`;
    }

    function formatTime(dateString) {
        if (!dateString) return '-';
        return new Date(dateString).toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' });
    }

    function loadAffiliateDropdown() {

        $.ajax({
            url: `/api/affiliate-attendance/admin/affiliates-list`,
            type: 'GET',

            headers: {
                'Authorization': 'Bearer ' + getAuthToken()
            },

            success: function(res) {

                console.log("Affiliate Dropdown API Response:", res);

                if (res.success && Array.isArray(res.data)) {

                    let html =
                        '<option value="">All Affiliates (Overall)</option>';

                    res.data.forEach(a => {

                        html += `
                            <option value="${a.affiliateId}">
                                ${escapeHtml(a.affiliateName)}
                            </option>
                        `;
                    });

                    $('#filterAffiliate').html(html);

                } else {

                    $('#filterAffiliate').html(
                        '<option value="">No affiliates found</option>'
                    );
                }
            },

            error: function(xhr) {

                console.error(
                    "Affiliate dropdown error:",
                    xhr.status,
                    xhr.responseText
                );

                $('#filterAffiliate').html(
                    '<option value="">Failed to load affiliates</option>'
                );
            }
        });
    }
    function escapeHtml(value) {

        if (value === null || value === undefined) {
            return '';
        }

        return String(value)
            .replace(/&/g, '&amp;')
            .replace(/</g, '&lt;')
            .replace(/>/g, '&gt;')
            .replace(/"/g, '&quot;')
            .replace(/'/g, '&#039;');
    }

    function resetFilters() {
        $('#filterAffiliate').val('');
        let today = new Date();
        let firstDay = new Date(today.getFullYear(), today.getMonth(), 1).toISOString().split('T')[0];
        $('#filterFromDate').val(firstDay);
        $('#filterToDate').val(today.toISOString().split('T')[0]);
        loadAllData();
    }

    function loadAllData() {
        loadTodayStats();
        loadTableData();
    }

    function loadTodayStats() {
        let toDate = $('#filterToDate').val(); 
        $.ajax({
            url: `/api/affiliate-attendance/admin/dashboard-stats?filterDate=${toDate}`,
            type: 'GET',
            headers: { 'Authorization': 'Bearer ' + getAuthToken() },
            success: function (res) {
                if (res.success) {
                    $('#statTotal').text(res.totalAffiliates);
                    $('#statPresent').text(res.present);
                    $('#statAbsent').text(res.absent);
                }
            }
        });
    }

    function loadTableData() {
        let fromDate = $('#filterFromDate').val();
        let toDate = $('#filterToDate').val();
        let affId = $('#filterAffiliate').val();

        let url = `/api/affiliate-attendance/admin/logs?`;
        if (fromDate) url += `fromDate=${fromDate}&`;
        if (toDate) url += `toDate=${toDate}&`;
        if (affId) url += `affiliateId=${affId}`;

        $('#summaryTableBody').html('<tr><td colspan="5" class="text-center py-4 text-muted"><div class="spinner-border spinner-border-sm"></div> Loading...</td></tr>');
        $('#logsTableBody').html('<tr><td colspan="5" class="text-center py-4 text-muted"><div class="spinner-border spinner-border-sm"></div> Loading...</td></tr>');
        $('#individualSummaryBanner').addClass('d-none');

        $.ajax({
            url: url,
            type: 'GET',
            headers: { 'Authorization': 'Bearer ' + getAuthToken() },
            success: function (res) {
                if (res.success) {
                    
                    if (res.summary && res.summary.length > 0) {
                        let sumRows = res.summary.map(s => `
        <tr>
            <td class="fw-bold text-dark">${s.affiliateName}</td>
            <td>
                <span class="badge bg-light text-dark border">
                    ${s.userCode || 'N/A'}
                </span>
            </td>
            <td class="text-center">
                <span class="badge bg-success-subtle text-success px-3">
                    ${s.totalDaysPresent}
                </span>
            </td>
            <td class="text-center">
                <span class="badge bg-danger-subtle text-danger px-3">
                    ${s.totalDaysAbsent}
                </span>
            </td>
            <td class="text-center fw-bold text-primary">
                ${s.totalHours} Hrs
            </td>
        </tr>
    `).join('');

                        $('#summaryTableBody').html(sumRows);
                        $('#summaryTableBody').html(sumRows);

                        // If exactly 1 affiliate is selected, show Individual Banner
                        if (affId && res.summary.length === 1) {
                            let s = res.summary[0];
                            $('#indAffiliateName').text(s.affiliateName);
                            $('#indAffiliateCode').text(s.userCode || 'N/A');
                            $('#indPresent').text(s.totalDaysPresent);
                            $('#indAbsent').text(s.totalDaysAbsent);
                            $('#indHours').text(s.totalHours);
                            $('#individualSummaryBanner').removeClass('d-none');
                            
                            // Auto-switch to logs tab to view this user's details
                            $('#logs-tab').tab('show');
                        }

                    } else {
                        $('#summaryTableBody').html('<tr><td colspan="5" class="text-center py-4 text-muted">No data found. Note: If an affiliate never punched in, they won\'t appear here.</td></tr>');
                    }

                    // --- 2. Populate Detailed Logs Table ---
                    if (res.detailedLogs && res.detailedLogs.length > 0) {

                        let logRows = res.detailedLogs.map(l => {

                            // Punch In Location
                            let inMap = l.punchInLocation
                                ? `<a href="https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(l.punchInLocation)}"
                     target="_blank"
                     rel="noopener noreferrer"
                     class="text-decoration-none small text-danger">
                        <i class="bi bi-geo-alt-fill"></i> Map
                   </a>`
                                : '-';

                            // Punch Out Location
                            let outMap = l.punchOutLocation
                                ? `<a href="https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(l.punchOutLocation)}"
                     target="_blank"
                     rel="noopener noreferrer"
                     class="text-decoration-none small text-danger">
                        <i class="bi bi-geo-alt-fill"></i> Map
                   </a>`
                                : '-';

                            // Status Badge
                            let badge = l.status === 'CheckedIn'
                                ? '<span class="badge bg-success-subtle text-success border border-success-subtle">Active</span>'
                                : `<span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle">
                        Out (${l.punchOutMode || '-'})
                   </span>`;

                            return `<tr>
                <td class="fw-semibold text-dark">
                    ${formatDateDDMMYYYY(l.attendanceDate)}
                </td>

                <td>
                    <b>${l.affiliateName || ''}</b>
                    <br/>
                    <small class="text-muted">
                        ${l.userCode || ''}
                    </small>
                </td>

                <td>
                    ${formatTime(l.punchInTime)}
                    <div class="mt-1">
                        ${inMap}
                    </div>
                </td>

                <td>
                    ${formatTime(l.punchOutTime)}
                    <div class="mt-1">
                        ${outMap}
                    </div>
                </td>

                <td>
                    ${badge}
                    <br/>
                    <small class="text-muted">
                        ${l.totalHoursWorked || 0} hrs
                    </small>
                </td>
            </tr>`;

                        }).join('');

                        $('#logsTableBody').html(logRows);

                    } else {

                        $('#logsTableBody').html(`
            <tr>
                <td colspan="5" class="text-center py-4 text-muted">
                    No detailed logs found.
                </td>
            </tr>
        `);
                    }
                }
            }
        });
    }
</script>