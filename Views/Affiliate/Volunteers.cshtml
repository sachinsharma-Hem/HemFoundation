                        $('#bulkModal').modal('hide');
                        loadVolunteers();
                    } else {
                        alert(res.message || "Failed to save.");
                        resetBulkModal();
                    }
                },
                error: function(xhr) {
                    alert(xhr.responseJSON?.message || "Something went wrong while saving to database!");
                    resetBulkModal();
                }
            });
        }
    </script>
} *@

@section Scripts {
    <!-- Select2 CSS & JS for Searchable Dropdown -->
    <link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />
    <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>

    <style>
        /* Bootstrap 5 styling match for Select2 */
        .select2-container .select2-selection--single {
            height: 38px;
            border: 1px solid #dee2e6;
            border-radius: 0.5rem; /* Matches rounded-3 */
            padding: 4px 8px;
            box-shadow: none;
        }
        .select2-container--default .select2-selection--single .select2-selection__arrow {
            height: 36px;
            right: 8px;
        }
        .select2-container--default .select2-selection--single .select2-selection__rendered {
            line-height: 28px;
            color: #212529;
        }
        .select2-search__field {
            outline: none !important;
            border-radius: 4px !important;
        }
    </style>

    <script>
        let validPayload = [];
        let countdownInterval;

        $(function () {
            loadSchools();
            loadVolunteers();

            $('#bulkModal').on('hidden.bs.modal', function () {
                resetBulkModal();
            });
        });

        function getAuthToken() { return localStorage.getItem('jwt_token') || sessionStorage.getItem('jwt_token') || ''; }

        function loadSchools() {
            $.ajax({
                url: '/api/volunteer/assigned-schools',
                type: 'GET',
                headers: { 'Authorization': 'Bearer ' + getAuthToken() },
                success: function(res) {
                    if(res.success) {
                        let html = '<option value="">-- Choose School --</option>';
                        res.data.forEach(s => html += `<option value="${s.instituteID || s.id}">${s.name}</option>`);
                        $('.ddl-schools').html(html);

                        // ==========================================
                        // Initialize Select2 after data is loaded
                        // ==========================================
                        $('#ddlSchool').select2({
                            dropdownParent: $('#volModal'), // Important for modals
                            width: '100%',
                            placeholder: "-- Choose School --",
                            allowClear: true
                        });

                        $('#ddlBulkSchool').select2({
                            dropdownParent: $('#bulkModal'), // Important for modals
                            width: '100%',
                            placeholder: "-- Choose School --",
                            allowClear: true
                        });
                    }
                }
            });
        }

        function loadVolunteers() {
            $('#volTableBody').html('<tr><td colspan="5" class="text-center py-5"><div class="spinner-border spinner-border-sm"></div></td></tr>');
            $.ajax({
                url: '/api/volunteer/list',
                type: 'GET',
                headers: { 'Authorization': 'Bearer ' + getAuthToken() },
                success: function(res) {
                    if(res.success && res.data.length > 0) {
                        let html = '';
                        res.data.forEach(v => {
                            let badge = v.isActive ? '<span class="badge bg-success-subtle text-success">Active</span>' : '<span class="badge bg-secondary-subtle text-secondary">Inactive</span>';
                            
                            html += `<tr>
                                <td><b class="text-dark">${v.name}</b><br><small class="text-muted">Joined: ${new Date(v.createdDate).toLocaleDateString('en-GB')}</small></td>
                                <td><i class="bi bi-telephone text-muted"></i> ${v.mobileNo}<br><i class="bi bi-envelope text-muted"></i> <small>${v.email || 'N/A'}</small></td>
                                <td><b>${v.schoolName}</b></td>
                                <td>${badge}</td>
                                <td class="text-center">
                                    <button class="btn btn-sm btn-light border text-primary shadow-none me-1" onclick="editVol(${v.id}, '${v.name.split(' ')[0]}', '${v.name.split(' ').slice(1).join(' ')}', '${v.mobileNo}', '${v.email || ''}', ${v.instituteId})"><i class="bi bi-pencil-square"></i></button>
                                    <button class="btn btn-sm btn-light border text-danger shadow-none" onclick="deleteVol(${v.id})"><i class="bi bi-trash"></i></button>
                                </td>
                            </tr>`;
                        });
                        $('#volTableBody').html(html);
                    } else {
                        $('#volTableBody').html('<tr><td colspan="5" class="text-center py-5 text-muted">No volunteers registered yet.</td></tr>');
                    }
                }
            });
        }

        function openVolModal() {
            $('#hdnVolId').val('0');
            $('#frmVolunteer')[0].reset();
            
            // Reset Select2 value visually
            $('#ddlSchool').val('').trigger('change'); 

            $('#volModalTitle').text('Register Volunteer');
            $('#volModal').modal('show');
        }

        function editVol(id, fName, lName, mobile, email, instId) {
            $('#hdnVolId').val(id);
            $('#txtFName').val(fName);
            $('#txtLName').val(lName);
            $('#txtMobile').val(mobile);
            $('#txtEmail').val(email);
            
            // Set value and trigger change to update Select2 UI
            $('#ddlSchool').val(instId).trigger('change'); 

            $('#volModalTitle').text('Edit Volunteer');
            $('#volModal').modal('show');
        }

        $('#frmVolunteer').on('submit', function (e) {
            e.preventDefault();
            
            let mobile = $('#txtMobile').val();
            if (mobile.length !== 10) {
                alert("Mobile number must be exactly 10 digits.");
                return;
            }
            
            let payload = {
                Id: parseInt($('#hdnVolId').val()) || 0,
                FirstName: $('#txtFName').val(),
                LastName: $('#txtLName').val(),
                MobileNo: mobile,
                Email: $('#txtEmail').val(),
                InstituteId: parseInt($('#ddlSchool').val()) || 0
            };

            let $btn = $('#btnSaveVol');
            $btn.prop('disabled', true).text('Saving...');

            $.ajax({
                url: '/api/volunteer/register',
                type: 'POST',
                contentType: 'application/json',
                data: JSON.stringify(payload),
                headers: { 'Authorization': 'Bearer ' + getAuthToken() },
                success: function (res) {
                    if (res.success) {
                        $('#volModal').modal('hide');
                        loadVolunteers();
                    } else {
                        alert(res.message);
                    }
                },
                error: function (xhr) {
                    if (xhr.status === 400 && xhr.responseJSON && xhr.responseJSON.errors) {
                        let errs = Object.values(xhr.responseJSON.errors).flat().join('\n');
                        alert("Validation Error:\n" + errs);
                    } else {
                        alert(xhr.responseJSON?.message || "Error processing request!");
                    }
                },
                complete: function() { $btn.prop('disabled', false).text('Save Volunteer'); }
            });
        });

        function deleteVol(id) {
            if(confirm("Are you sure you want to delete this volunteer?")) {
                $.ajax({
                    url: '/api/volunteer/' + id,
                    type: 'DELETE',
                    headers: { 'Authorization': 'Bearer ' + getAuthToken() },
                    success: function() { loadVolunteers(); }
                });
            }
        }

        // ================= LIVE VALIDATION & 20 SEC COUNTDOWN =================
        function resetBulkModal() {
            clearInterval(countdownInterval);
            $('#frmBulkUpload')[0].reset();
            validPayload = [];
            
            // Reset Bulk Select2
            $('#ddlBulkSchool').val('').trigger('change');

            $('#stepProcessing, #stepErrors, #stepSuccess').addClass('d-none');
            $('#stepUpload').removeClass('d-none');
            $('#btnModalClose').prop('disabled', false);
        }

        $('#frmBulkUpload').on('submit', function(e) {
            e.preventDefault();
            
            $('#stepUpload').addClass('d-none');
            $('#stepProcessing').removeClass('d-none');
            $('#btnModalClose').prop('disabled', true); 

            $('#statusMessage').text("Reading Excel File...");
            $('#subStatusMessage').text("Parsing rows and headers...");

            setTimeout(() => {
                $('#statusMessage').text("Checking Mobile Numbers...");
                $('#subStatusMessage').text("Ensuring all numbers are exactly 10 digits...");
            }, 800);

            setTimeout(() => {
                $('#statusMessage').text("Verifying Email Formats...");
                $('#subStatusMessage').text("Validating email structures...");
            }, 1600);

            let formData = new FormData();
            formData.append('excelFile', $('#fileExcel')[0].files[0]);

            $.ajax({
                url: '/api/volunteer/validate-bulk',
                type: 'POST',
                data: formData,
                contentType: false,
                processData: false,
                headers: { 'Authorization': 'Bearer ' + getAuthToken() },
                success: function (res) {
                    $('#stepProcessing').addClass('d-none');
                    
                    if (res.hasErrors) {
                        let errHtml = '';
                        res.errors.forEach(e => errHtml += `<li>${e}</li>`);
                        $('#errorList').html(errHtml);
                        $('#stepErrors').removeClass('d-none');
                        $('#btnModalClose').prop('disabled', false);
                    } else {
                        validPayload = res.validData;
                        $('#validCount').text(validPayload.length);
                        $('#stepSuccess').removeClass('d-none');
                        startCountdown();
                    }
                },
                error: function() {
                    alert("Error processing file. Please try again.");
                    resetBulkModal();
                }
            });
        });

        function startCountdown() {
            let seconds = 20; 
            $('#countdownTimer').text(seconds);
            
            countdownInterval = setInterval(() => {
                seconds--;
                $('#countdownTimer').text(seconds);
                
                if(seconds <= 0) {
                    clearInterval(countdownInterval);
                    forceFinalUpload();
                }
            }, 1000);
        }

        function cancelUpload() {
            clearInterval(countdownInterval);
            resetBulkModal();
        }

        function forceFinalUpload() {
            clearInterval(countdownInterval);
            
            $('#stepSuccess').html(`
                <div class="py-5 text-center">
                    <div class="spinner-grow text-success" style="width: 3rem; height: 3rem;"></div>
                    <h5 class="fw-bold mt-3 text-dark">Saving to Database...</h5>
                    <p class="text-muted">Please do not close this window.</p>
                </div>
            `);

            let saveRequest = {
                InstituteId: parseInt($('#ddlBulkSchool').val()) || 0,
                ValidData: validPayload
            };

            $.ajax({
                url: '/api/volunteer/save-bulk',
                type: 'POST',
                contentType: 'application/json',
                headers: { 'Authorization': 'Bearer ' + getAuthToken() },
                data: JSON.stringify(saveRequest),
                success: function (res) {
                    if(res.success) {
                        alert(res.message);
                        $('#bulkModal').modal('hide');
                        loadVolunteers();
                    } else {
                        alert(res.message || "Failed to save.");
                        resetBulkModal();
                    }
                },
                error: function(xhr) {
                    alert(xhr.responseJSON?.message || "Something went wrong while saving to database!");
                    resetBulkModal();
                }
            });
        }
    </script>
}