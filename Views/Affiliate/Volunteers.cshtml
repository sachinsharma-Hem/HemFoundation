@{
    ViewData["Title"] = "Manage Volunteers";
    Layout = "~/Views/Shared/Layouts/_TeacherLayout.cshtml";
}
<partial name="Partials/_VolunteerStatsCards" />
<partial name="Partials/_AssignSchoolModal" />
<div class="container-fluid py-4">
    <div class="d-flex align-items-center justify-content-between mb-4">
    <div>
        <h3 class="fw-bold text-dark m-0"><i class="bi bi-people-fill text-primary me-2"></i> Volunteers</h3>
        <p class="text-muted small m-0">Register single volunteers or bulk upload via Excel to assign them to your schools.</p>
    </div>
    <div class="d-flex gap-2">
        <button class="btn btn-outline-primary btn-sm rounded-pill px-3 fw-semibold shadow-sm" onclick="openAssignSchoolModal()">
    <i class="bi bi-building-add me-1"></i> Volunteer School Assign
</button>
        <button class="btn btn-outline-success btn-sm rounded-pill px-3 fw-semibold shadow-sm" onclick="$('#bulkModal').modal('show')">
            <i class="bi bi-file-earmark-excel me-1"></i> Bulk Upload
        </button>
        <button class="btn btn-primary btn-sm rounded-pill px-3 fw-semibold shadow-sm" onclick="openVolModal()">
            <i class="bi bi-plus-lg me-1"></i> Add Volunteer
        </button>
    </div>
</div>

    <div class="card border-0 shadow-sm rounded-4 bg-white p-4">
        <div class="table-responsive">
            <table class="table table-hover align-middle small">
                <thead class="table-light text-muted">
                    <tr>
                        <th>Name</th>
                        <th>Contact Details</th>
                        <th>Associated School</th>
                        <th>Status</th>
                        <th class="text-center">Action</th>
                    </tr>
                </thead>
                <tbody id="volTableBody">
                    <tr><td colspan="5" class="text-center py-5"><div class="spinner-border spinner-border-sm"></div> Loading...</td></tr>
                </tbody>
            </table>
        </div>
    </div>
</div>

<div class="modal fade" id="volModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content rounded-4 border-0 shadow-lg p-3 bg-white">
            <div class="modal-header border-bottom pb-3">
                <h5 class="fw-bold text-dark m-0" id="volModalTitle">Register Volunteer</h5>
                <button type="button" class="btn-close shadow-none" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body py-3">
                <form id="frmVolunteer">
                    <input type="hidden" id="hdnVolId" value="0">
                    <div class="row g-3">
                        <div class="col-12">
                            <label class="form-label small fw-bold">Select Associated School <span class="text-danger">*</span></label>
                            <select id="ddlSchool" class="form-select rounded-3 shadow-none ddl-schools" required>
                                <option value="">Loading schools...</option>
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-bold">First Name <span class="text-danger">*</span></label>
                            <input type="text" id="txtFName" class="form-control rounded-3 shadow-none" required oninput="this.value = this.value.replace(/[^a-zA-Z\s]/g, '')">
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-bold">Last Name <span class="text-danger">*</span></label>
                            <input type="text" id="txtLName" class="form-control rounded-3 shadow-none" required oninput="this.value = this.value.replace(/[^a-zA-Z\s]/g, '')">
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-bold">Mobile Number <span class="text-danger">*</span></label>
                            <input type="text" id="txtMobile" class="form-control rounded-3 shadow-none" required minlength="10" maxlength="10" pattern="[0-9]{10}" oninput="this.value = this.value.replace(/[^0-9]/g, '')">
                        </div>
                        <div class="col-md-6">
    <label class="form-label small fw-bold">Email</label>
    <input type="email" id="txtEmail" class="form-control rounded-3 shadow-none" 
           placeholder="user@example.com"
           title="Please enter a valid email address">
</div>
                    </div>
                    <button type="submit" id="btnSaveVol" class="btn btn-primary w-100 rounded-pill fw-bold shadow-sm mt-4">Save Volunteer</button>
                </form>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="bulkModal" tabindex="-1" aria-hidden="true" data-bs-backdrop="static">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content rounded-4 border-0 shadow-lg p-3 bg-white">
            <div class="modal-header border-bottom pb-3">
                <h5 class="fw-bold text-success m-0"><i class="bi bi-file-earmark-excel me-2"></i> Bulk Upload Volunteers</h5>
                <button type="button" class="btn-close shadow-none" data-bs-dismiss="modal" id="btnModalClose"></button>
            </div>
            <div class="modal-body py-3">
                
                <div id="stepUpload">
                    <div class="d-flex justify-content-between align-items-center mb-3 alert alert-light border">
                        <span class="small text-muted">Use strictly our standard Excel format to avoid errors.</span>
                        <a href="/api/volunteer/download-sample" class="btn btn-sm btn-outline-success rounded-pill fw-bold" target="_blank">
                            <i class="bi bi-download"></i> Download Sample
                        </a>
                    </div>
                    <form id="frmBulkUpload">
                        <div class="mb-3">
                            <label class="form-label small fw-bold">Select School for these Volunteers <span class="text-danger">*</span></label>
                            <select id="ddlBulkSchool" class="form-select rounded-3 shadow-none ddl-schools" required>
                                <option value="">-- Choose School --</option>
                            </select>
                        </div>
                        <div class="mb-3">
                            <label class="form-label small fw-bold">Upload Excel File <span class="text-danger">*</span></label>
                            <input type="file" id="fileExcel" class="form-control rounded-3 shadow-none" accept=".xlsx" required>
                        </div>
                        <button type="submit" class="btn btn-primary w-100 rounded-pill fw-bold shadow-sm mt-3 py-2">
                            Verify & Check Data
                        </button>
                    </form>
                </div>

                <div id="stepProcessing" class="text-center py-5 d-none">
                    <div class="spinner-border text-primary mb-3" style="width: 3rem; height: 3rem;"></div>
                    <h5 class="fw-bold text-dark" id="statusMessage">Initializing validation...</h5>
                    <p class="text-muted small" id="subStatusMessage">Please wait while we check your file.</p>
                </div>

                <div id="stepErrors" class="d-none">
                    <div class="alert alert-danger rounded-4">
                        <h5 class="fw-bold"><i class="bi bi-exclamation-triangle-fill me-2"></i> Validation Failed!</h5>
                        <p class="small mb-2">We found some errors in your Excel file. Please fix them and upload again.</p>
                        <ul id="errorList" class="small mb-0 text-danger fw-semibold" style="max-height: 150px; overflow-y: auto;"></ul>
                    </div>
                    <button class="btn btn-outline-dark w-100 rounded-pill fw-bold mt-2" onclick="resetBulkModal()">
                        <i class="bi bi-arrow-left"></i> Go Back & Re-upload
                    </button>
                </div>

                <div id="stepSuccess" class="text-center py-4 d-none">
                    <i class="bi bi-check-circle-fill text-success" style="font-size: 4rem;"></i>
                    <h4 class="fw-bold text-success mt-3">100% Data Validated Successfully!</h4>
                    <p class="text-muted mb-4">No errors found. System is ready to save <b id="validCount">0</b> volunteers.</p>
                    
                    <div class="p-3 bg-light rounded-4 d-inline-block px-5 border mb-3">
                        <h5 class="m-0 fw-bold">Auto Saving in <span id="countdownTimer" class="text-primary fs-3">20</span> seconds...</h5>
                    </div>

                    <div class="mt-2">
                        <button class="btn btn-success rounded-pill px-5 fw-bold shadow-sm" onclick="forceFinalUpload()">Upload Now</button>
                        <button class="btn btn-light rounded-pill px-4 ms-2" onclick="cancelUpload()">Cancel</button>
                    </div>
                </div>

            </div>
        </div>
    </div>
</div>

