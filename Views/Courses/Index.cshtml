function initializeMcqEditors() {
    if (typeof tinymce === 'undefined') {
        console.error('TinyMCE is not loaded.');
        return;
    }

    ['mq_question', 'mq_answerDescription'].forEach(function (id) {
        if (tinymce.get(id)) return;

        tinymce.init({
            selector: `#${id}`,
            height: 250,
            menubar: false,
            plugins: 'lists link table code',
            toolbar: 'undo redo | bold italic underline | bullist numlist | link table | code',
            branding: false,
            promotion: false
        });
    });
}

function getMcqEditorValue1(id) {
    const editor = typeof tinymce !== 'undefined' ? tinymce.get(id) : null;
    return editor ? editor.getContent() : $(`#${id}`).val();
}
        function getMcqEditorValue(id) {
            const editor = typeof tinymce !== 'undefined' ? tinymce.get(id) : null;

            if (editor) {
                return editor.getContent({ format: 'text' }).trim();
            }

            return $(`#${id}`).val().trim();
        }
function setMcqEditorValue(id, value) {
    const editor = typeof tinymce !== 'undefined' ? tinymce.get(id) : null;

    if (editor) {
        editor.setContent(value || '');
    } else {
        $(`#${id}`).val(value || '');
    }
}
        function isEditorContentEmpty(html) {
            const text = $('<div>')
                .html(html || '')
                .text()
                .replace(/\u00a0/g, ' ')
                .trim();

            return text.length === 0;
        }
function renderMcqs() {
    const tbody = $('#mcqTableBody');
    const mcqs = dataCache.mcqs || [];

    tbody.empty();
    $('#mcqCount').text(mcqs.length);

    if (!mcqs.length) {
        tbody.html(`
            <tr>
                <td colspan="13" class="text-center text-muted py-4">
                    No MCQs added
                </td>
            </tr>
        `);
        return;
    }

    mcqs.forEach(function (x) {
        // Strip or safely parse answer description HTML for table display if needed
        const answerText = $('<div>')
            .html(x.answerDescription || '')
            .text();

        tbody.append(`
            <tr>
                <td>
                    <span class="badge bg-dark">${escapeHtml(x.id)}</span>
                </td>
                <td style="min-width:280px;white-space:normal;">
                    ${escapeHtml(x.questionName || '-')}
                </td>
                <td>${escapeHtml(x.topicName || '-')}</td>
                <td>${escapeHtml(x.subTopicName || '-')}</td>
                <td>${escapeHtml(formatMcqDate(x.createdDate))}</td>
                <td>${escapeHtml(x.createdBy ?? '-')}</td>
                <td>${escapeHtml(formatMcqDate(x.modifiedDate))}</td>
                <td>${escapeHtml(x.modifiedBy ?? '-')}</td>
                <td class="text-center">${escapeHtml(x.questionLevel ?? '-')}</td>
                <td>
                    <span class="badge bg-secondary">${escapeHtml(x.complexityLevel || '-')}</span>
                </td>
                <td>${escapeHtml(x.languageName || '-')}</td>
                <td style="min-width:240px;white-space:normal;">
                    ${escapeHtml(answerText || '-')}
                </td>
                <td class="text-end text-nowrap">
                    <button type="button"
                            class="btn btn-sm btn-outline-primary border-0"
                            onclick="editMcq(${Number(x.id)})"
                            title="Edit">
                        <i class="bi bi-pencil"></i>
                    </button>
                    <button type="button"
                            class="btn btn-sm btn-outline-danger border-0"
                            onclick="deleteRecord(
                                '/api/course-authoring/mcq/delete/${Number(x.id)}',
