@{
    ViewData["Title"] = "Manage Courses & Authoring";
    Layout = "~/Views/Shared/Layouts/_AdminLayout.cshtml";
}

<div class="container-fluid py-4">

    <!-- PAGE HEADER -->
    <div class="card border-0 shadow-sm rounded-4 bg-white p-4 mb-4">
        <h3 class="fw-bold text-dark mb-1">
            <i class="bi bi-journal-code text-success me-2"></i>
            Manage Courses & Curriculum Authoring
        </h3>

        <p class="text-muted small m-0">
            Search and select a course below to manage its Topics, Sub-Topics,
            MCQs, and Practical Labs sequentially.
        </p>
    </div>


    <!-- COURSE SEARCH -->
    <div class="card border-0 shadow-sm rounded-4 bg-white p-4 mb-4">

        <label class="form-label fw-bold small text-secondary">
            Search & Select Course
        </label>

        <div class="position-relative">

            <input type="text"
                   id="courseSearchInput"
                   class="form-control rounded-3 shadow-none"
                   placeholder="Type course name to search..."
                   autocomplete="off">

            <div id="searchResults"
                 class="list-group position-absolute w-100 shadow-lg rounded-3 mt-1 d-none"
                 style="z-index:1000; max-height:250px; overflow-y:auto;">
            </div>

        </div>
    </div>


    <!-- SELECTED COURSE -->
    <div class="card border-0 shadow-sm rounded-4 bg-white p-4 mb-4 d-none"
         id="selectedCourseCard">

        <div class="d-flex justify-content-between align-items-center border-bottom pb-3 mb-3">

            <h5 class="fw-bold text-success m-0"
                id="selectedCourseName">
                Course Name
            </h5>

            <button type="button"
                    class="btn btn-outline-danger btn-sm rounded-pill px-3"
                    onclick="clearSelectedCourse()">

                <i class="bi bi-x-lg me-1"></i>
                Change Course

            </button>

        </div>

        <div class="row g-3 small">

            <div class="col-md-3">
                <b>Description:</b>
                <span id="lblDesc" class="text-muted"></span>
            </div>

            <div class="col-md-3">
                <b>Age Group:</b>
                <span id="lblAge" class="text-muted"></span>
            </div>

            <div class="col-md-3">
                <b>Sessions:</b>
                <span id="lblSessions" class="text-muted"></span>
            </div>

            <div class="col-md-3">
                <b>Delivery Date:</b>
                <span id="lblDate" class="text-muted"></span>
            </div>

        </div>
    </div>


    <!-- AUTHORING -->
    <div id="authoringTabsWrapper"
         class="opacity-50 pointer-events-none">

        <!-- TABS -->
        <ul class="nav nav-pills mb-4 gap-2"
            id="authoringTabs"
            role="tablist">

            <li class="nav-item">
                <button class="nav-link active rounded-pill px-4 fw-semibold shadow-sm"
                        id="tab-topic"
                        data-bs-toggle="pill"
                        data-bs-target="#pane-topic"
                        type="button"
                        disabled>

                    <i class="bi bi-list-check me-2"></i>
                    1. Topics

                </button>
            </li>

            <li class="nav-item">
                <button class="nav-link rounded-pill px-4 fw-semibold shadow-sm text-dark bg-white border"
                        id="tab-subtopic"
                        data-bs-toggle="pill"
                        data-bs-target="#pane-subtopic"
                        type="button"
                        disabled>

                    <i class="bi bi-diagram-3 me-2"></i>
                    2. Sub-Topics

                </button>
            </li>

            <li class="nav-item">
                <button class="nav-link rounded-pill px-4 fw-semibold shadow-sm text-dark bg-white border"
                        id="tab-mcq"
                        data-bs-toggle="pill"
                        data-bs-target="#pane-mcq"
                        type="button"
                        disabled>

                    <i class="bi bi-ui-checks me-2"></i>
                    3. MCQ Questions

                </button>
            </li>

            <li class="nav-item">
                <button class="nav-link rounded-pill px-4 fw-semibold shadow-sm text-dark bg-white border"
                        id="tab-lab"
                        data-bs-toggle="pill"
                        data-bs-target="#pane-lab"
                        type="button"
                        disabled>

                    <i class="bi bi-laptop me-2"></i>
                    4. Practical Lab

                </button>
            </li>

        </ul>


        <div class="tab-content" id="authoringTabContent">


            <!-- ========================================================= -->
            <!-- TOPICS -->
            <!-- ========================================================= -->

            <div class="tab-pane fade show active"
                 id="pane-topic"
                 role="tabpanel">

                <!-- TOPIC FORM -->
                <div class="card border-0 shadow-sm rounded-4 bg-white p-4 mb-4">

                    <div class="d-flex justify-content-between align-items-center mb-3">

                        <div>
                            <h6 class="fw-bold text-success mb-1"
                                id="topicFormTitle">

                                <i class="bi bi-plus-circle me-1"></i>
                                Add Topic

                            </h6>

                            <small class="text-muted">
                                Create or update a main course topic
                            </small>
                        </div>

                        <button type="button"
                                class="btn btn-outline-secondary btn-sm rounded-pill"
                                onclick="resetTopicForm()">

                            <i class="bi bi-arrow-counterclockwise me-1"></i>
                            Reset

                        </button>

                    </div>


                    <!-- IMPORTANT:
                         enctype is required for file upload
                    -->
                    <form id="topicForm"
                          enctype="multipart/form-data">

                        <input type="hidden"
                               id="topicId"
                               name="id"
                               value="0">

                        <input type="hidden"
                               id="topicCourseId"
                               name="courseId"
                               value="0">


                        <div class="row g-3">

                            <!-- TOPIC NAME -->
                            <div class="col-md-6">

                                <label class="form-label small fw-semibold">
                                    Topic Name
                                    <span class="text-danger">*</span>
                                </label>

                                <input type="text"
                                       id="tp_name"
                                       name="topicName"
                                       class="form-control form-control-sm rounded-3 shadow-none"
                                       placeholder="Enter topic name"
                                       maxlength="500"
                                       required>

                            </div>


                            <!-- ORDER NO -->
                            <!-- THIS IS NOW AN INPUT, NOT DROPDOWN -->
                            <div class="col-md-3">

                                <label class="form-label small fw-semibold">
                                    Order No
                                    <span class="text-danger">*</span>
                                </label>

                                <input type="number"
                                       id="tp_order"
                                       name="orderNo"
                                       class="form-control form-control-sm rounded-3 shadow-none"
                                       placeholder="Enter order no"
                                       min="1"
                                       step="1"
                                       required>

                            </div>


                            <!-- LANGUAGE -->
                            <!-- POPULATED FROM LANGUAGE TABLE -->
                            <div class="col-md-3">

                                <label class="form-label small fw-semibold">
                                    Language
                                    <span class="text-danger">*</span>
                                </label>

                                <select id="tp_lang"
                                        name="languageID"
                                        class="form-select form-select-sm rounded-3 shadow-none"
                                        required>

                                    <option value="">
                                        Select Language
                                    </option>

                                </select>

                            </div>


                            <!-- DESCRIPTION -->
                            <div class="col-md-12">

                                <label class="form-label small fw-semibold">
                                    Description
                                </label>

                                <textarea id="tp_desc"
                                          name="description"
                                          class="form-control form-control-sm rounded-3 shadow-none"
                                          rows="3"
                                          maxlength="5000"
                                          placeholder="Enter topic description"></textarea>

                            </div>


                            <!-- RESOURCE FILE -->
                            <div class="col-md-6">

                                <label class="form-label small fw-semibold">
                                    Upload Resource File
                                </label>

                                <input type="file"
                                       id="tp_resourceFile"
                                       name="resourceFile"
                                       class="form-control form-control-sm rounded-3 shadow-none"
                                       accept=".pdf,.doc,.docx,.xls,.xlsx,.ppt,.pptx,.zip,.txt,.png,.jpg,.jpeg">

                                <div id="tp_resourceCurrent"
                                     class="mt-2">
                                </div>

                            </div>


                            <!-- EXERCISE FILE -->
                            <div class="col-md-6">

                                <label class="form-label small fw-semibold">
                                    Upload Exercise File
                                </label>

                                <input type="file"
                                       id="tp_exerciseFile"
                                       name="exerciseFile"
                                       class="form-control form-control-sm rounded-3 shadow-none"
                                       accept=".pdf,.doc,.docx,.xls,.xlsx,.ppt,.pptx,.zip,.txt,.png,.jpg,.jpeg">

                                <div id="tp_exerciseCurrent"
                                     class="mt-2">
                                </div>

                            </div>

                        </div>


                        <!-- BUTTONS -->
                        <div class="d-flex justify-content-end gap-2 mt-4">

                            <button type="button"
                                    class="btn btn-outline-secondary btn-sm rounded-pill px-4"
                                    onclick="resetTopicForm()">

                                Reset

                            </button>

                            <button type="submit"
                                    class="btn btn-success btn-sm rounded-pill px-4 fw-bold"
                                    id="btnSaveTopic">

                                <i class="bi bi-save me-1"></i>
                                Save Topic

                            </button>

                        </div>

                    </form>

                </div>


                <!-- TOPIC LIST -->
                <div class="card border-0 shadow-sm rounded-4 bg-white p-4">

                    <div class="d-flex justify-content-between align-items-center mb-3">

                        <h6 class="fw-bold text-dark mb-0">

                            <i class="bi bi-table me-2 text-primary"></i>
                            Topics List

                        </h6>

                        <span class="badge bg-primary rounded-pill"
                              id="topicCount">
                            0
                        </span>

                    </div>


                    <div class="table-responsive">

                        <table class="table table-hover table-bordered align-middle small">

                            <thead class="table-light">

                                <tr>

                                    <th style="width:80px;">
                                        Topic ID
                                    </th>

                                    <th style="min-width:220px;">
                                        Topic Name
                                    </th>

                                    <th style="width:110px;">
                                        Sub-Topics
                                    </th>

                                    <th style="width:100px;">
                                        Order No
                                    </th>

                                    <th style="width:140px;">
                                        Language
                                    </th>

                                    <th style="width:130px;">
                                        Resource File
                                    </th>

                                    <th style="width:130px;">
                                        Exercise File
                                    </th>

                                    <th style="min-width:300px;">
                                        Description
                                    </th>

                                    <th style="width:130px;"
                                        class="text-end">
                                        Actions
                                    </th>

                                </tr>

                            </thead>

                            <tbody id="topicTableBody">

                                <tr>

                                    <td colspan="9"
                                        class="text-center text-muted py-4">

                                        Select a course to load topics.

                                    </td>

                                </tr>

                            </tbody>

                        </table>

                    </div>

                </div>

            </div>


            <!-- ========================================================= -->
            <!-- SUB TOPICS -->
            <!-- ========================================================= -->

            <div class="tab-pane fade"
                 id="pane-subtopic"
                 role="tabpanel">

                <div class="card border-0 shadow-sm rounded-4 bg-white p-4 mb-4">

                    <h6 class="fw-bold text-success mb-3"
                        id="subTopicFormTitle">

                        <i class="bi bi-plus-circle me-1"></i>
                        Add Sub-Topic

                    </h6>

                    <form id="subTopicForm"
                          enctype="multipart/form-data">

                        <input type="hidden"
                               id="subTopicId"
                               value="0">

                        <div class="row g-3">

                            <div class="col-md-4">

                                <label class="form-label small fw-semibold">
                                    Select Topic
                                </label>

                                <select id="st_topic"
                                        name="courseTopicId"
                                        class="form-select form-select-sm rounded-3 shadow-none"
                                        required>

                                    <option value="">
                                        -- Select Topic --
                                    </option>

                                </select>

                            </div>

                            <div class="col-md-4">

                                <label class="form-label small fw-semibold">
                                    Sub-Topic Name
                                </label>

                                <input type="text"
                                       id="st_name"
                                       name="subTopicName"
                                       class="form-control form-control-sm rounded-3 shadow-none"
                                       required>

                            </div>

                            <div class="col-md-4">

                                <label class="form-label small fw-semibold">
                                    Order Number
                                </label>

                                <input type="number"
                                       id="st_order"
                                       name="displayOrderId"
                                       class="form-control form-control-sm rounded-3 shadow-none"
                                       min="1"
                                       step="1"
                                       required>

                            </div>

                            <div class="col-md-6">

                                <label class="form-label small fw-semibold">
                                    Video Link (YouTube/URL)
                                </label>

                                <input type="url"
                                       id="st_video"
                                       name="videoLink"
                                       class="form-control form-control-sm rounded-3 shadow-none">

                            </div>
                             <div class="col-md-3">

                                <label class="form-label small fw-semibold">
                                    Language
                                    <span class="text-danger">*</span>
                                </label>

                                <select id="st_lang"
                                        name="languageID"
                                        class="form-select form-select-sm rounded-3 shadow-none"
                                        required>

                                    <option value="">
                                        Select Language
                                    </option>

                                </select>

                            </div>
                            <div class="col-md-3">

                                <label class="form-label small fw-semibold">
                                    Number of Questions
                                </label>

                                <input type="number"
                                       id="st_qCount"
                                       name="numberOfQuestions"
                                       class="form-control form-control-sm rounded-3 shadow-none"
                                       value="0"
                                       min="0"
                                       required>

                            </div>

                            <div class="col-md-6">

                                <label class="form-label small fw-semibold">
                                    MCQ Thumbnail
                                </label>

                                <input type="file"
                                       id="st_mcqThumb"
                                       name="mcqThumbFile"
                                       class="form-control form-control-sm rounded-3 shadow-none"
                                       accept="image/*">

                            </div>

                            <div class="col-md-6">

                                <label class="form-label small fw-semibold">
                                    Video Thumbnail
                                </label>

                                <input type="file"
                                       id="st_videoThumb"
                                       name="videoThumbFile"
                                       class="form-control form-control-sm rounded-3 shadow-none"
                                       accept="image/*">

                            </div>

                        </div>

                        <div class="d-flex justify-content-end gap-2 mt-3">

                            <button type="submit"
                                    class="btn btn-success btn-sm rounded-pill px-4 fw-bold">

                                Save Sub-Topic

                            </button>

                        </div>

                    </form>

                </div>


                <div class="card border-0 shadow-sm rounded-4 bg-white p-4">

                    <h6 class="fw-bold text-dark mb-3">

                        <i class="bi bi-table me-2 text-primary"></i>
                        Sub-Topics List

                    </h6>

                    <div class="table-responsive">

                        <table class="table table-hover align-middle small">

                            <thead class="table-light">

                                <tr>
                                    <th>#</th>
                                    <th>Sub-Topic ID</th>
                                    <th>Topic</th>
                                    <th>Sub-Topic</th>
                                    <th>Order No</th>
                                    <th>Language</th>
                                    <th>Description</th>
                                    <th>Trainer Video</th>
                                         <th style="width:130px;">
                                        Resource File
                                    </th>

                                    <th style="width:130px;">
                                        Exercise File
                                    </th>

                                    <th>Questions</th>
                                    <th class="text-end">Actions</th>
                                </tr>

                            </thead>

                            <tbody id="subTopicTableBody">

                                <tr>
                                    <td colspan="5"
                                        class="text-center text-muted">
                                        No sub-topics added
                                    </td>
                                </tr>

                            </tbody>

                        </table>

                    </div>

                </div>

            </div>


            <!-- ========================================================= -->
            <!-- MCQ -->
            <!-- ========================================================= -->

            <div class="tab-pane fade" id="pane-mcq" role="tabpanel">

               <div class="card border-0 shadow-sm rounded-4 bg-white p-4 mb-4">
                    <h6 class="fw-bold text-success mb-3" id="mcqFormTitle">
                        <i class="bi bi-plus-circle me-1"></i>
                        Add MCQ Question
                    </h6>

                                <form id="mcqForm">
                                    <input type="hidden" id="mcqId" value="0">

                                    <div class="row g-3">
                                        <div class="col-md-4">
                                            <label class="form-label small fw-semibold">Topic</label>
                                            <select id="mq_topic" class="form-select form-select-sm" required>
                                                <option value="">-- Select Topic --</option>
                                            </select>
                                        </div>

                                        <div class="col-md-4">
                                            <label class="form-label small fw-semibold">Sub-Topic</label>
                                            <select id="mq_subTopic" class="form-select form-select-sm" required>
                                                <option value="">-- Select Sub-Topic --</option>
                                            </select>
                                        </div>

                                        <div class="col-md-4">
                                            <label class="form-label small fw-semibold">Complexity</label>
                                            <select id="mq_complexity" class="form-select form-select-sm" required>
                                                <option value="">-- Select Complexity --</option>
                                                <option value="Tough">Tough</option>
                                                <option value="Easy">Easy</option>
                                                <option value="Moderate">Moderate</option>
                                            </select>
                                        </div>

                                        <div class="col-md-4">
                                            <label class="form-label small fw-semibold">Language</label>
                                            <select id="mq_language" class="form-select form-select-sm" required>
                                                <option value="">-- Select Language --</option>
                                            </select>
                                        </div>

                                        <div class="col-md-4">
                                            <label class="form-label small fw-semibold">Editor Type</label>
                                            <select id="mq_editorType" class="form-select form-select-sm" disabled>
                                                <option value="HTML" selected>HTML</option>
                                            </select>
                                        </div>

                                        <div class="col-md-12">
                                            <label class="form-label small fw-semibold">Question</label>
                                            <textarea id="mq_question" class="form-control" rows="5" ></textarea>
                                        </div>

                                        <div class="col-md-6">
                                            <label class="form-label small fw-semibold">Option A</label>
                                            <div class="input-group">
                                                <span class="input-group-text">
                                                    <input type="radio" name="rightAns" value="A" checked>
                                                </span>
                                                <textarea id="mq_optA" class="form-control" rows="2" required></textarea>
                                            </div>
                                        </div>

                                        <div class="col-md-6">
                                            <label class="form-label small fw-semibold">Option B</label>
                                            <div class="input-group">
                                                <span class="input-group-text">
                                                    <input type="radio" name="rightAns" value="B">
                                                </span>
                                                <textarea id="mq_optB" class="form-control" rows="2" required></textarea>
                                            </div>
                                        </div>

                                        <div class="col-md-6">
                                            <label class="form-label small fw-semibold">Option C</label>
                                            <div class="input-group">
                                                <span class="input-group-text">
                                                    <input type="radio" name="rightAns" value="C">
                                                </span>
                                                <textarea id="mq_optC" class="form-control" rows="2"></textarea>
                                            </div>
                                        </div>

                                        <div class="col-md-6">
                                            <label class="form-label small fw-semibold">Option D</label>
                                            <div class="input-group">
                                                <span class="input-group-text">
                                                    <input type="radio" name="rightAns" value="D">
                                                </span>
                                                <textarea id="mq_optD" class="form-control" rows="2"></textarea>
                                            </div>
                                        </div>

                                        <div class="col-md-12">
                                            <label class="form-label small fw-semibold">Answer Description</label>
                                            <textarea id="mq_answerDescription" class="form-control" rows="5"></textarea>
                                        </div>
                                    </div>

                                    <div class="d-flex justify-content-end gap-2 mt-3">
                                        <button type="button" class="btn btn-outline-secondary btn-sm rounded-pill"
                                                onclick="resetMcqForm()">
                                            Reset
                                        </button>
                                        <button type="submit" id="btnSaveMcq"
                                                class="btn btn-success btn-sm rounded-pill px-4 fw-bold">
                                            Save MCQ
                                        </button>
                                    </div>
                                </form>
                        </div>

                <div class="card border-0 shadow-sm rounded-4 bg-white p-4">
                        <div class="d-flex justify-content-between align-items-center mb-3">
                            <h6 class="fw-bold text-dark mb-0">
                                <i class="bi bi-table me-2 text-primary"></i>
                                MCQ Questions List
                            </h6>
                            <span class="badge bg-primary rounded-pill" id="mcqCount">0</span>
                        </div>

                            <div class="table-responsive">
                                <table class="table table-hover table-bordered align-middle small">
                                    <thead class="table-light">
                                        <tr>
                                            <th>Question ID</th>
                                            <th style="min-width:280px">Question Name</th>
                                            <th>Topic</th>
                                            <th>Sub-Topic</th>
                                            <th>Created Date</th>
                                            <th>Created By</th>
                                            <th>Modified Date</th>
                                            <th>Modified By</th>
                                            <th>Question Level</th>
                                            <th>Complexity</th>
                                            <th>Language</th>
                                            <th style="min-width:240px">Answer Description</th>
                                            <th class="text-end">Actions</th>
                                        </tr>
                                    </thead>
                                    <tbody id="mcqTableBody">
                                        <tr>
                                            <td colspan="13" class="text-center text-muted py-4">
                                                No MCQs added
                                            </td>
                                        </tr>
                                    </tbody>
                                </table>
                            </div>
            </div>

            </div>
            <!-- ========================================================= -->
            <!-- PRACTICAL LAB -->
            <!-- ========================================================= -->

            <div class="tab-pane fade" id="pane-lab" role="tabpanel">

        <!-- PRACTICAL LAB FORM -->
        <div class="card border-0 shadow-sm rounded-4 bg-white p-4 mb-4">
            <h6 class="fw-bold text-success mb-3" id="labFormTitle">
                <i class="bi bi-plus-circle me-1"></i> Add Practical Lab
            </h6>

            <form id="labForm" enctype="multipart/form-data">
                <input type="hidden" id="labId" value="0">

                <div class="row g-3">
                    <div class="col-md-4">
                        <label class="form-label small fw-semibold">Title <span class="text-danger">*</span></label>
                        <input type="text" id="lb_title" name="title" class="form-control form-control-sm rounded-3 shadow-none" required>
                    </div>

                    <div class="col-md-4">
                        <label class="form-label small fw-semibold">Topic <span class="text-danger">*</span></label>
                        <select id="lb_topic" name="practicalTopicID" class="form-select form-select-sm rounded-3 shadow-none" required>
                            <option value="">-- Select Topic --</option>
                        </select>
                    </div>

                    <div class="col-md-4">
                        <label class="form-label small fw-semibold">Sub-Topic <span class="text-danger">*</span></label>
                        <select id="lb_subTopic" name="practicalSubtopicID" class="form-select form-select-sm rounded-3 shadow-none" required>
                            <option value="">-- Select Sub-Topic --</option>
                        </select>
                    </div>

                    <div class="col-md-3">
                        <label class="form-label small fw-semibold">Level <span class="text-danger">*</span></label>
                        <select id="lb_level" name="practicalLevel" class="form-select form-select-sm rounded-3 shadow-none" required>
                            <option value="">-- Select Level --</option>
                            <option value="1">Easy</option>
                            <option value="2">Moderate</option>
                            <option value="3">Tough</option>
                        </select>
                    </div>

                    <div class="col-md-3">
                        <label class="form-label small fw-semibold">Practical Standard</label>
                        <input type="text" id="lb_standard" name="practicalStandard" class="form-control form-control-sm rounded-3 shadow-none" placeholder="e.g. Standard 5">
                    </div>

                    <div class="col-md-3">
                        <label class="form-label small fw-semibold">Group</label>
                        <select id="lb_group" name="student_Group" class="form-select form-select-sm rounded-3 shadow-none">
                            <option value="">-- Select Group --</option>
                            <option value="All">All</option>
                            <option value="A">Group A</option>
                            <option value="B">Group B</option>
                            <option value="C">Group C</option>
                            <option value="D">Group D</option>
                        </select>
                    </div>

                    <div class="col-md-3">
                        <label class="form-label small fw-semibold">Practical Type</label>
                        <input type="text" id="lb_type" name="type" class="form-control form-control-sm rounded-3 shadow-none" placeholder="e.g. 0">
                    </div>

                    <div class="col-md-3">
                        <label class="form-label small fw-semibold">File Type</label>
                        <input type="text" id="lb_fileType" name="fileType" class="form-control form-control-sm rounded-3 shadow-none" placeholder="e.g. zip, pdf">
                    </div>

                    <div class="col-md-3">
                        <label class="form-label small fw-semibold">Order No <span class="text-danger">*</span></label>
                        <input type="number" id="lb_order" name="orderNo" class="form-control form-control-sm rounded-3 shadow-none" min="1" step="1" required>
                    </div>

                    <div class="col-md-3">
                        <label class="form-label small fw-semibold">Coins</label>
                        <input type="number" id="lb_coins" name="coins" class="form-control form-control-sm rounded-3 shadow-none" value="10" min="0">
                    </div>

                    <div class="col-md-3">
                        <label class="form-label small fw-semibold">Gems</label>
                        <input type="number" id="lb_gems" name="gems" class="form-control form-control-sm rounded-3 shadow-none" value="5" min="0">
                    </div>

                    <div class="col-md-12 d-flex align-items-center mt-2">
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" id="lb_isTask" name="isTask" value="true">
                            <label class="form-check-label small fw-semibold" for="lb_isTask">
                                Click here if task
                            </label>
                        </div>
                    </div>

                    <div class="col-md-6">
                        <label class="form-label small fw-semibold">Video Link</label>
                        <input type="url" id="lb_video" name="videoLink" class="form-control form-control-sm rounded-3 shadow-none" placeholder="https://...">
                    </div>

                    <div class="col-md-6">
                        <label class="form-label small fw-semibold">Thumbnail Image</label>
                        <input type="file" id="lb_thumb" name="thumbnailFile" class="form-control form-control-sm rounded-3 shadow-none" accept="image/*">
                        <div id="lb_thumbCurrent" class="mt-1"></div>
                    </div>

                    <div class="col-md-6">
                        <label class="form-label small fw-semibold">Resource File</label>
                        <input type="file" id="lb_res" name="resourceFile" class="form-control form-control-sm rounded-3 shadow-none">
                        <div id="lb_resCurrent" class="mt-1"></div>
                    </div>

                    <div class="col-md-12">
                        <label class="form-label small fw-semibold">Code</label>
                        <textarea id="lb_code" name="code" class="form-control form-control-sm rounded-3 shadow-none font-monospace" rows="3" placeholder="Enter source code or snippet..."></textarea>
                    </div>

                    <div class="col-md-12">
                        <label class="form-label small fw-semibold">Description</label>
                        <textarea id="lb_desc" name="description" class="form-control form-control-sm rounded-3 shadow-none" rows="3"></textarea>
                    </div>
                </div>

                <div class="d-flex justify-content-end gap-2 mt-4">
                    <button type="button" class="btn btn-outline-secondary btn-sm rounded-pill px-4" onclick="resetLabForm()">Reset</button>
                    <button type="submit" id="btnSaveLab" class="btn btn-success btn-sm rounded-pill px-4 fw-bold">
                        <i class="bi bi-save me-1"></i> Save Practical Lab
                    </button>
                </div>
            </form>
        </div>

        <!-- PRACTICAL LABS LIST -->
        <div class="card border-0 shadow-sm rounded-4 bg-white p-4">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h6 class="fw-bold text-dark mb-0">
                    <i class="bi bi-table me-2 text-primary"></i> Practical Labs List
                </h6>
                <span class="badge bg-primary rounded-pill" id="labCount">0</span>
            </div>

            <div class="table-responsive">
                <table class="table table-hover table-bordered align-middle small">
                    <thead class="table-light">
                        <tr>
                            <th>#</th>
                            <th>ID</th>
                            <th style="min-width:180px;">Title</th>
                            <th>Topic</th>
                            <th>Sub-Topic</th>
                            <th>Level</th>
                            <th>Standard</th>
                            <th>Group</th>
                            <th>Type</th>
                            <th>Order</th>
                            <th>Rewards</th>
                            <th>Task?</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>
                    <tbody id="labTableBody">
                        <tr>
                            <td colspan="13" class="text-center text-muted py-4">
                                No practical labs added
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>

    </div>

</div>

    </div>
</div>


<!-- TOAST -->
<div class="position-fixed bottom-0 end-0 p-3"
     style="z-index:1100;">

    <div id="liveToast"
         class="toast align-items-center text-white border-0 shadow-lg rounded-4"
         role="alert">

        <div class="d-flex">

            <div class="toast-body fw-semibold"
                 id="toastMessage">
            </div>

            <button type="button"
                    class="btn-close btn-close-white me-2 m-auto shadow-none"
                    data-bs-dismiss="toast">
            </button>

        </div>

    </div>

</div>


@section Scripts {
    <!-- Include TinyMCE Script (Replace YOUR_API_KEY with your key or use 'no-api-key' for testing) -->
<script src="https://cdn.jsdelivr.net/npm/tinymce@6/tinymce.min.js" referrerpolicy="origin"></script>
    <script>

        console.log("Course Authoring Script started");


        // =============================================================
        // GLOBAL VARIABLES
        // =============================================================

        let selectedCourseId = null;


        let dropCache = {

            topics: [],
            subTopics: [],
            orderNumbers: [],
            mcqLevels: [],
            standards: [],
            languages: []

        };


        let dataCache = {

            topics: [],
            subTopics: [],
            mcqs: [],
            labs: []

        };


        // =============================================================
        // DOCUMENT READY
        // =============================================================

        $(document).ready(function() {

            console.log("Course Authoring document loaded");


            // =========================================================
            // COURSE SEARCH
            // =========================================================

            $('#courseSearchInput').on('keyup', function() {

                let q = $(this).val().trim();


                if (q.length < 1) {

                    $('#searchResults')
                        .addClass('d-none')
                        .html('');

                    return;
                }


                $.ajax({

                    url:
                        `/api/course-authoring/search-courses?query=${encodeURIComponent(q)}`,

                    type: 'GET',

                    success: function(res) {

                        console.log(
                            "Course Search Response:",
                            res
                        );


                        if (
                            res &&
                            res.success &&
                            Array.isArray(res.data) &&
                            res.data.length > 0
                        ) {

                            let html = '';


                            res.data.forEach(function(c) {

                                let jsonData =
                                    JSON.stringify(c)
                                        .replace(/'/g, "&#39;");


                                html += `

                                        <button type="button"
                                                class="list-group-item list-group-item-action py-2 px-3 small course-result-item"
                                                data-course='${jsonData}'>

                                            <div class="fw-bold">
                                                ${escapeHtml(c.courseName || '')}
                                            </div>

                                            <div class="text-muted"
                                                 style="font-size:0.75rem;">

                                                Delivery:
                                                ${c.expectedDeliveryDate
                                        ? new Date(
                                            c.expectedDeliveryDate
                                        ).toLocaleDateString()
                                        : 'N/A'
                                    }

                                            </div>

                                        </button>

                                    `;

                            });


                            $('#searchResults')
                                .html(html)
                                .removeClass('d-none');


                            $('.course-result-item')
                                .off('click')
                                .on('click', function() {

                                    let course =
                                        JSON.parse(
                                            $(this).attr('data-course')
                                        );

                                    selectCourse(course);

                                });

                        }
                        else {

                            $('#searchResults')
                                .html(
                                    '<div class="p-2 small text-muted">No courses found</div>'
                                )
                                .removeClass('d-none');

                        }

                    },

                    error: function(xhr) {

                        console.error(
                            "Course Search Error:",
                            xhr
                        );


                        $('#searchResults')
                            .html(
                                '<div class="p-2 small text-danger">Error loading courses</div>'
                            )
                            .removeClass('d-none');

                    }

                });

            });

            initializeMcqEditors();
            // =========================================================
            // TOPIC FORM
            // =========================================================

            $('#topicForm').on('submit', async function(e) {

                e.preventDefault();


                if (!selectedCourseId) {

                    showToast(
                        'Please select a course first.',
                        'danger'
                    );

                    return;
                }


                let topicName =
                    $('#tp_name').val().trim();


                let orderNo =
                    $('#tp_order').val();


                let languageID =
                    $('#tp_lang').val();


                if (!topicName) {

                    showToast(
                        'Topic Name is required.',
                        'warning'
                    );

                    return;
                }


                if (!orderNo || Number(orderNo) <= 0) {

                    showToast(
                        'Please enter a valid Order No.',
                        'warning'
                    );

                    return;
                }


                if (!languageID) {

                    showToast(
                        'Please select Language.',
                        'warning'
                    );

                    return;
                }


                let form =
                    document.getElementById('topicForm');


                let formData =
                    new FormData(form);


                // Make sure course ID is always current
                formData.set(
                    'courseId',
                    selectedCourseId
                );


                let button =
                    $('#btnSaveTopic');


                let originalHtml =
                    button.html();


                button
                    .prop('disabled', true)
                    .html(`
                            <span class="spinner-border spinner-border-sm me-1"></span>
                            Saving...
                        `);


                try {

                    let response =
                        await fetch(
                            '/api/course-authoring/topic/save',
                            {
                                method: 'POST',
                                body: formData
                            }
                        );


                    let result =
                        await response.json();


                    console.log(
                        "Topic Save Response:",
                        result
                    );


                    if (
                        !response.ok ||
                        !result.success
                    ) {

                        throw new Error(
                            result.message ||
                            'Unable to save topic.'
                        );

                    }


                    showToast(
                        result.message ||
                        'Topic saved successfully!',
                        'success'
                    );


                    resetTopicForm();


                    await loadCourseData();

                }
                catch (error) {

                    console.error(
                        "Topic Save Error:",
                        error
                    );


                    showToast(
                        error.message ||
                        'Error saving topic.',
                        'danger'
                    );

                }
                finally {

                    button
                        .prop('disabled', false)
                        .html(originalHtml);

                }

            });


            // =========================================================
            // SUB TOPIC FORM
            // =========================================================

            $('#subTopicForm').on('submit', function(e) {

                e.preventDefault();


                if (!selectedCourseId) {

                    showToast(
                        'Please select a course first.',
                        'danger'
                    );

                    return;
                }


                let fd =
                    new FormData(this);


                fd.set(
                    'id',
                    $('#subTopicId').val() || '0'
                );


                fd.set(
                    'courseRegistrationId',
                    selectedCourseId
                );


                $.ajax({

                    url:
                        '/api/course-authoring/subtopic/save',

                    type: 'POST',

                    data: fd,

                    processData: false,

                    contentType: false,

                    success: function(res) {

                        if (res && res.success) {

                            $('#subTopicId').val('0');

                            $('#subTopicForm')[0].reset();

                            loadCourseData();

                            showToast(
                                'Sub-Topic saved successfully!',
                                'success'
                            );

                        }
                        else {

                            showToast(
                                res?.message ||
                                'Unable to save sub-topic.',
                                'danger'
                            );

                        }

                    },

                    error: function(xhr) {

                        console.error(
                            "Save SubTopic Error:",
                            xhr.responseText
                        );


                        showToast(
                            xhr.responseJSON?.message ||
                            'Error saving sub-topic.',
                            'danger'
                        );

                    }

                });

            });


            // =========================================================
            // MCQ FORM
            // =========================================================

          $('#mcqForm').on('submit', async function (e) {
                e.preventDefault();

                if (!selectedCourseId) {
                    showToast('Please select a course first.', 'danger');
                    return;
                }

                const correctOption = $('input[name="rightAns"]:checked').val();

                const payload = {
                    questionId: Number($('#mcqId').val()) || 0,
                    courseId: Number(selectedCourseId),
                    topicId: Number($('#mq_topic').val()),
                    subTopicId: Number($('#mq_subTopic').val()),
                    questionName: getMcqEditorValue('mq_question'),
                    questionType: 'HTML',
                    editorType: 'HTML',
                    complexityLevel: $('#mq_complexity').val(),
                    languageId: Number($('#mq_language').val()),
                    answerDescription: getMcqEditorValue('mq_answerDescription'),
                    options: [
                        { optionText: $('#mq_optA').val(), isAnswer: correctOption === 'A' },
                        { optionText: $('#mq_optB').val(), isAnswer: correctOption === 'B' },
                        { optionText: $('#mq_optC').val(), isAnswer: correctOption === 'C' },
                        { optionText: $('#mq_optD').val(), isAnswer: correctOption === 'D' }
                    ].filter(x => x.optionText.trim() !== '')
                };

                if (!payload.topicId) {
                    showToast('Please select a topic.', 'warning');
                    return;
                }

                if (!payload.subTopicId) {
                    showToast('Please select a sub-topic.', 'warning');
                    return;
                }

                if (!payload.languageId) {
                    showToast('Please select a language.', 'warning');
                    return;
                }

                if (!payload.complexityLevel) {
                    showToast('Please select the complexity.', 'warning');
                    return;
                }

                if (isEditorContentEmpty(payload.questionName)) {
                    showToast('Please enter the MCQ question.', 'warning');

                    const editor = tinymce.get('mq_question');
                    if (editor) {
                        editor.focus();
                    }

                    return;
                }

                if (!payload.options.length) {
                    showToast('Enter at least one option.', 'warning');
                    return;
                }

                if (!payload.options.some(x => x.isAnswer)) {
                    showToast('Select the correct answer.', 'warning');
                    return;
                }

                const button = $('#btnSaveMcq');
                const originalText = button.html();

                button.prop('disabled', true).text('Saving...');

                try {
                    const response = await fetch('/api/course-authoring/mcq/save', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify(payload)
                    });

                    const result = await response.json();

                    if (!response.ok || !result.success) {
                        throw new Error(result.message || 'Unable to save MCQ.');
                    }

                    showToast(result.message || 'MCQ saved successfully.', 'success');
                    resetMcqForm();
                    await loadCourseData();
                } catch (error) {
                    console.error('MCQ save error:', error);
                    showToast(error.message || 'Error saving MCQ.', 'danger');
                } finally {
                    button.prop('disabled', false).html(originalText);
                }
            });

            function resetMcqForm() {
                $('#mcqForm')[0].reset();
                $('#mcqId').val('0');

                $('#mq_editorType').val('HTML');
                $('#mq_subTopic').html('<option value="">-- Select Sub-Topic --</option>');

                $('input[name="rightAns"][value="A"]').prop('checked', true);

                setMcqEditorValue('mq_question', '');
                setMcqEditorValue('mq_answerDescription', '');

                $('#mcqFormTitle').html(
                    '<i class="bi bi-plus-circle me-1"></i> Add MCQ Question'
                );
                $('#btnSaveMcq').text('Save MCQ');
            }


            // =========================================================
            // LAB FORM
            // =========================================================

            $('#labForm').on('submit', function(e) {

                e.preventDefault();


                if (!selectedCourseId) {

                    showToast(
                        'Please select a course first.',
                        'danger'
                    );

                    return;
                }


                let fd =
                    new FormData(this);


                fd.set(
                    'id',
                    $('#labId').val() || '0'
                );


                fd.set(
                    'courseRegistrationId',
                    selectedCourseId
                );


                $.ajax({

                    url:
                        '/api/course-authoring/lab/save',

                    type: 'POST',

                    data: fd,

                    processData: false,

                    contentType: false,

                    success: function(res) {

                        if (res && res.success) {

                            $('#labId').val('0');

                            $('#labForm')[0].reset();

                            loadCourseData();

                            showToast(
                                'Practical Lab saved successfully!',
                                'success'
                            );

                        }
                        else {

                            showToast(
                                res?.message ||
                                'Unable to save lab.',
                                'danger'
                            );

                        }

                    },

                    error: function(xhr) {

                        console.error(
                            "Save Lab Error:",
                            xhr.responseText
                        );


                        showToast(
                            xhr.responseJSON?.message ||
                            'Error saving lab.',
                            'danger'
                        );

                    }

                });

            });


            // =========================================================
            // MCQ TOPIC CHANGE
            // =========================================================

            $('#mq_topic').on('change', function () {
                    const topicId = $(this).val();

                    const filtered = (dropCache.subTopics || []).filter(function (x) {
                        return String(x.courseTopicId) === String(topicId);
                    });

                    populateDropdown(
                        '#mq_subTopic',
                        filtered,
                        'id',
                        'subTopicName',
                        '-- Select Sub-Topic --'
                    );
                });


            // =========================================================
            // CLOSE SEARCH
            // =========================================================

            $(document).on('click', function(e) {

                if (
                    !$(e.target).closest(
                        '#courseSearchInput, #searchResults'
                    ).length
                ) {

                    $('#searchResults')
                        .addClass('d-none');

                }

            });

        });


        // =============================================================
        // SELECT COURSE
        // =============================================================

        function selectCourse(c) {

            console.log(
                "Selected Course:",
                c
            );


            selectedCourseId =
                c.courseID ??
                c.courseRegistrationId ??
                c.courseId;


            if (!selectedCourseId) {

                console.error(
                    "Course ID missing:",
                    c
                );


                showToast(
                    'Course ID is missing from API response.',
                    'danger'
                );

                return;
            }


            $('#courseSearchInput')
                .val(
                    c.courseName || ''
                );


            $('#searchResults')
                .addClass('d-none');


            $('#selectedCourseName')
                .text(
                    c.courseName || 'Course'
                );


            $('#lblDesc')
                .text(
                    c.description ||
                    c.courseDescription ||
                    'N/A'
                );


            let fromAge =
                c.fromAge ??
                c.from_age ??
                '';


            let toAge =
                c.toAge ??
                c.to_age ??
                '';


            $('#lblAge')
                .text(
                    fromAge || toAge
                        ? `${fromAge} - ${toAge} yrs`
                        : 'N/A'
                );


            $('#lblSessions')
                .text(
                    c.noOfSessions ??
                    c.sessions ??
                    'N/A'
                );


            $('#lblDate')
                .text(
                    c.expectedDeliveryDate
                        ? new Date(
                            c.expectedDeliveryDate
                        ).toLocaleDateString()
                        : 'N/A'
                );


            $('#selectedCourseCard')
                .removeClass('d-none');


            $('#authoringTabsWrapper')
                .removeClass(
                    'opacity-50 pointer-events-none'
                );


            $('#authoringTabs button')
                .prop(
                    'disabled',
                    false
                );


            loadCourseData();

        }


        // =============================================================
        // LOAD COURSE DATA
        // =============================================================

        async function loadCourseData() {

            if (!selectedCourseId) {

                return;

            }


            try {

                await loadCourseDropdowns();

                await loadTopics();

                await loadSubTopics();

                await loadMcqs();
                //await renderMcqs();
                await loadLabs();


                console.log(
                    "All course data loaded."
                );

            }
            catch (error) {

                console.error(
                    "loadCourseData ERROR:",
                    error
                );


                showToast(
                    'Some course data could not be loaded. Check browser console.',
                    'danger'
                );

            }

        }


        // =============================================================
        // CLEAR COURSE
        // =============================================================

        function clearSelectedCourse() {

            selectedCourseId = null;


            dropCache = {

                topics: [],
                subTopics: [],
                orderNumbers: [],
                mcqLevels: [],
                standards: [],
                languages: []

            };


            dataCache = {

                topics: [],
                subTopics: [],
                mcqs: [],
                labs: []

            };


            $('#courseSearchInput')
                .val('');


            $('#selectedCourseCard')
                .addClass('d-none');


            $('#authoringTabsWrapper')
                .addClass(
                    'opacity-50 pointer-events-none'
                );


            $('#authoringTabs button')
                .prop(
                    'disabled',
                    true
                );


            resetTopicForm();


            clearTables();

            clearDropdowns();

        }


        // =============================================================
        // CLEAR TABLES
        // =============================================================

        function clearTables() {

            $('#topicTableBody').html(`
                    <tr>
                        <td colspan="9"
                            class="text-center text-muted py-4">
                            Select a course to load topics.
                        </td>
                    </tr>
                `);


            $('#subTopicTableBody').html(`
                    <tr>
                        <td colspan="5"
                            class="text-center text-muted">
                            No sub-topics added
                        </td>
                    </tr>
                `);


            $('#mcqTableBody').html(`
                    <tr>
                        <td colspan="4"
                            class="text-center text-muted">
                            No MCQs added
                        </td>
                    </tr>
                `);


            $('#labTableBody').html(`
                    <tr>
                        <td colspan="5"
                            class="text-center text-muted">
                            No practical labs added
                        </td>
                    </tr>
                `);


            $('#topicCount').text('0');

        }


        // =============================================================
        // CLEAR DROPDOWNS
        // =============================================================

        function clearDropdowns() {

            $('#tp_lang').html(
                '<option value="">Select Language</option>'
            );

             $('#st_lang').html(
                '<option value="">Select Language</option>'
            );
            $('#st_topic').html(
                '<option value="">-- Select Topic --</option>'
            );


            $('#mq_topic').html(
                '<option value="">-- Select Topic --</option>'
            );


            $('#mq_subTopic').html(
                '<option value="">-- Select Sub-Topic --</option>'
            );


            $('#mq_level').html(
                '<option value="">-- Select Level --</option>'
            );


            $('#lb_standard').html(
                '<option value="">-- Select Standard --</option>'
            );

        }


        // =============================================================
        // LOAD COURSE DROPDOWNS
        // =============================================================

        function loadCourseDropdowns() {

            return new Promise(function(resolve, reject) {

                if (!selectedCourseId) {

                    reject(
                        new Error(
                            'Course ID is missing'
                        )
                    );

                    return;
                }


                let url =
                    `/api/course-authoring/dropdowns/${encodeURIComponent(selectedCourseId)}`;


                console.log(
                    "Loading Dropdowns:",
                    url
                );


                $.ajax({

                    url: url,

                    type: 'GET',

                    success: function(res) {

                        console.log(
                            "Dropdown Response:",
                            res
                        );


                        if (
                            !res ||
                            !res.success
                        ) {

                            reject(
                                new Error(
                                    res?.message ||
                                    'Dropdown API failed'
                                )
                            );

                            return;
                        }


                        // DO NOT do:
                        // dropCache = res;
                        //
                        // Keep a controlled structure.

                        dropCache.topics =
                            Array.isArray(res.topics)
                                ? res.topics
                                : [];


                        dropCache.subTopics =
                            Array.isArray(res.subTopics)
