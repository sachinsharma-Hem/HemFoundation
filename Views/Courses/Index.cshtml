        function loadTopics() {

            return new Promise(function(resolve, reject) {

                let url =
                    `/api/course-authoring/topic/list/${encodeURIComponent(selectedCourseId)}`;


                console.log(
                    "Loading Topics:",
                    url
                );


                $('#topicTableBody').html(`
                        <tr>
                            <td colspan="9"
                                class="text-center py-4">

                                <span class="spinner-border spinner-border-sm me-2"></span>
                                Loading topics...

                            </td>
                        </tr>
                    `);


                $.ajax({

                    url: url,

                    type: 'GET',

                    success: function(res) {

                        console.log(
                            "Topics Response:",
                            res
                        );


                        if (
                            !res ||
                            res.success === false
                        ) {

                            reject(
                                new Error(
                                    res?.message ||
                                    'Topic API failed'
                                )
                            );

                            return;
                        }


                        dataCache.topics =
                            Array.isArray(res.data)
                                ? res.data
                                : [];


                        renderTopics();


                        resolve();

                    },

                    error: function(xhr) {

                        console.error(
                            "Topics API Error:",
                            xhr.status,
                            xhr.responseText
                        );


                        $('#topicTableBody').html(`
                                <tr>
                                    <td colspan="9"
                                        class="text-center text-danger py-4">

                                        Failed to load topics.

                                    </td>
                                </tr>
                            `);


                        reject(xhr);

                    }

                });

            });

        }


