       function editMcq(id) {
           debugger
                const x = (dataCache.mcqs || []).find(
                    m => Number(m.id) === Number(id)
                );

                if (!x) {
                    showToast('Question not found.', 'danger');
                    return;
                }

                $('#mcqId').val(x.id);
                $('#mq_topic').val(x.topicId).trigger('change');
                $('#mq_subTopic').val(x.subTopicId);

                $('#mq_complexity').val(x.complexityLevel);
                $('#mq_language').val(x.languageId);
                $('#mq_editorType').val('HTML');

                setMcqEditorValue('mq_question', x.questionName || '');
                setMcqEditorValue('mq_answerDescription', x.answerDescription || '');

                const options = x.options || [];

                $('#mq_optA').val(options[0]?.optionText || '');
                $('#mq_optB').val(options[1]?.optionText || '');
                $('#mq_optC').val(options[2]?.optionText || '');
                $('#mq_optD').val(options[3]?.optionText || '');

                const correctIndex = options.findIndex(o => o.isAnswer);
                const answerLetter = ['A', 'B', 'C', 'D'][correctIndex] || 'A';

                $(`input[name="rightAns"][value="${answerLetter}"]`).prop('checked', true);

                $('#mcqFormTitle').html(
                    '<i class="bi bi-pencil me-1"></i> Edit MCQ Question'
                );
