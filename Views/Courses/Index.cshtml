    $('#lb_subTopic').val(x.practicalSubtopicID || '');
    $('#lb_level').val(x.practicalLevel || '');
    $('#lb_standard').val(x.practicalStandard || '');
    $('#lb_group').val(x.student_Group || '');
    $('#lb_type').val(x.type || '');
    $('#lb_fileType').val(x.fileType || '');
    $('#lb_order').val(x.orderNo ?? '');
    $('#lb_coins').val(x.coins ?? 10);
    $('#lb_gems').val(x.gems ?? 5);
    $('#lb_isTask').prop('checked', !!x.isTask);
    $('#lb_video').val(x.videoLink || '');
    $('#lb_code').val(x.code || '');
    $('#lb_desc').val(x.description || '');

    if (x.thumbnail) {
        $('#lb_thumbCurrent').html(`<a href="${normalizeFileUrl(x.thumbnail)}" target="_blank" class="small">View Thumbnail</a>`);
    } else {
        $('#lb_thumbCurrent').empty();
    }

    if (x.resources) {
        $('#lb_resCurrent').html(`<a href="${normalizeFileUrl(x.resources)}" target="_blank" class="small">View Resource</a>`);
    } else {
        $('#lb_resCurrent').empty();
    }

    $('#labFormTitle').html(`
        <i class="bi bi-pencil me-1"></i> Edit Practical Lab
    `);
    $('#btnSaveLab').html(`<i class="bi bi-save me-1"></i> Update Practical Lab`);

    document.getElementById('labForm').scrollIntoView({
        behavior: 'smooth',
        block: 'start'
    });
}


        // =============================================================
        // POPULATE DROPDOWN
        // =============================================================

        function populateDropdown(
            selector,
            list,
            valueField,
            textField,
            placeholder = '-- Select --'
        ) {

            let html =
                `<option value="">${escapeHtml(placeholder)}</option>`;


            if (Array.isArray(list)) {

                list.forEach(function(x) {

                    let value =
                        x[valueField] ?? '';


                    let text =
                        x[textField] ?? '';


                    html += `

                            <option value="${escapeHtml(value)}">
                                ${escapeHtml(text)}
                            </option>

                        `;

                });

            }


            $(selector)
                .html(html);

        }


        // =============================================================
        // GENERIC JSON SAVE
        // =============================================================

        function saveRecord(
            url,
            payload,
            successCallback,
            successMsg
        ) {

            $.ajax({

                url: url,

                type: 'POST',

                contentType: 'application/json',

                data:
                    JSON.stringify(payload),

                success: function(res) {

                    console.log(
                        "Save Response:",
                        res
                    );


                    if (
                        res &&
                        res.success
                    ) {

                        successCallback();


                        loadCourseDropdowns();


                        showToast(
                            successMsg,
                            'success'
                        );

                    }
                    else {

                        showToast(
                            res?.message ||
                            'Error saving record.',
                            'danger'
                        );

                    }

                },

                error: function(xhr) {

                    console.error(
                        "Save Error:",
                        xhr.status,
                        xhr.responseText
                    );


                    showToast(
                        xhr.responseJSON?.message ||
                        'Error saving record.',
                        'danger'
                    );

                }

            });

        }


        // =============================================================
        // DELETE
        // =============================================================

        function deleteRecord(
            url,
            reloadCallback
        ) {

            Swal.fire({

                title:
                    'Are you sure?',

                text:
                    'You want to delete this record!',

                icon:
                    'warning',

                showCancelButton:
                    true,

                confirmButtonColor:
                    '#dc3545',

                cancelButtonColor:
                    '#6c757d',

                confirmButtonText:
                    'Yes, delete it!'

            }).then(function(result) {

                if (!result.isConfirmed)
                    return;


                $.ajax({

                    url: url,

                    type: 'DELETE',

                    success: function(res) {

                        if (
                            res &&
                            res.success
                        ) {

                            reloadCallback();


                            showToast(
                                'Deleted successfully!',
                                'success'
                            );

                        }
                        else {

                            showToast(
                                res?.message ||
                                'Unable to delete record.',
                                'danger'
                            );

                        }

                    },

                    error: function(xhr) {

                        console.error(
                            "Delete Error:",
                            xhr.status,
                            xhr.responseText
                        );


                        showToast(
                            xhr.responseJSON?.message ||
                            'Error deleting record.',
                            'danger'
                        );

                    }

                });

            });

        }


        // =============================================================
        // TOAST
        // =============================================================

        function showToast(
            message,
            type = 'success'
        ) {

            const $toast =
                $('#liveToast');


            $toast
                .removeClass(
                    'bg-success bg-danger bg-warning text-dark'
                )
                .addClass(
                    type === 'success'
                        ? 'bg-success'
                        : type === 'warning'
                            ? 'bg-warning text-dark'
                            : 'bg-danger'
                );


            $('#toastMessage').html(`

                    <i class="bi ${type === 'success'
                    ? 'bi-check-circle-fill'
                    : 'bi-exclamation-triangle-fill'
                } me-2"></i>

                    ${escapeHtml(message)}

                `);


            new bootstrap.Toast(
                $toast[0],
                {
                    delay: 3000
                }
            ).show();

        }


        // =============================================================
        // HTML ESCAPE
        // =============================================================

        function escapeHtml(value) {

            if (
                value === null ||
                value === undefined
            ) {

                return '';

            }


            return String(value)
                .replace(
                    /&/g,
                    '&amp;'
                )
                .replace(
                    /</g,
                    '&lt;'
                )
                .replace(
                    />/g,
                    '&gt;'
                )
                .replace(
                    /"/g,
                    '&quot;'
                )
                .replace(
                    /'/g,
                    '&#039;'
                );

        }
        function normalizeFileUrl(url) {
    if (!url) return '';

    url = String(url).trim();

    if (url.startsWith('~/')) {
        return url.substring(1);
    }

    return url;
}
