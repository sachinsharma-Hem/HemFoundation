        // =============================================================
        // EDIT TOPIC
        // =============================================================

        function editTopic(id) {

            let topic =
                dataCache.topics.find(
                    function(x) {

                        return Number(x.id) ===
                            Number(id);

                    }
                );


            if (!topic) {

                showToast(
                    'Topic not found.',
                    'danger'
                );

                return;
            }


            $('#topicId')
                .val(topic.id);


            $('#topicCourseId')
                .val(selectedCourseId);


            $('#tp_name')
                .val(topic.topicName || '');


            $('#tp_order')
                .val(topic.orderNo ?? '');


            $('#tp_lang')
                .val(topic.languageID ?? '');


            $('#tp_desc')
                .val(topic.description || '');


            // Existing resource
            if (topic.resourceFile) {

                $('#tp_resourceCurrent').html(`

                        <div class="small mt-2">

                            <i class="bi bi-paperclip me-1"></i>

                            Existing Resource:

                            <a href="${escapeHtml(topic.resourceFile)}"
                               target="_blank"
                               rel="noopener noreferrer">

                                View File

                            </a>

                        </div>

                    `);

            }
            else {

                $('#tp_resourceCurrent')
                    .empty();

            }


            // Existing exercise
            if (topic.exerciseFile) {

                $('#tp_exerciseCurrent').html(`

                        <div class="small mt-2">

                            <i class="bi bi-paperclip me-1"></i>

                            Existing Exercise:

                            <a href="${escapeHtml(topic.exerciseFile)}"
                               target="_blank"
                               rel="noopener noreferrer">

                                View File

                            </a>

                        </div>

                    `);

            }
            else {

                $('#tp_exerciseCurrent')
                    .empty();

            }


            $('#topicFormTitle').html(`
                    <i class="bi bi-pencil me-1"></i>
                    Edit Topic
                `);


            $('#btnSaveTopic').html(`
                    <i class="bi bi-save me-1"></i>
                    Update Topic
                `);


            document
                .getElementById('topicForm')
                ?.scrollIntoView({
                    behavior: 'smooth',
                    block: 'start'
                });

        }


