@{
    ViewData["Title"] = "View & Edit Profile";
    Layout = ViewBag.SelectedLayout as string ?? "~/Views/Shared/Layouts/_TeacherLayout.cshtml";
}

<!-- Select2 CSS for Searchable School Dropdown -->
<link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />
<link href="https://cdn.jsdelivr.net/npm/select2-bootstrap-5-theme@1.3.0/dist/select2-bootstrap-5-theme.min.css" rel="stylesheet" />

<div class="container-fluid py-4">
    <div class="row g-4">
        <!-- Left Sidebar: Avatar & Password Toggle -->
        <div class="col-xl-4">
            <div class="card border-0 shadow-sm rounded-4 text-center p-4 mb-4" style="background-color: var(--card-bg);">
                <div class="position-relative d-inline-block mx-auto mb-3">
                    <img id="profile-avatar-img" src="/uploads/profiles/default-avatar.png" onerror="this.src='https://cdn-icons-png.flaticon.com/512/149/149071.png'" class="rounded-circle shadow-sm border border-3 border-success object-fit-cover" style="width: 130px; height: 130px;" alt="Profile Photo" />
                    <label for="photoUploadInput" class="position-absolute bottom-0 end-0 bg-success text-white rounded-circle p-2 shadow cursor-pointer" title="Change Photo" style="width: 36px; height: 36px; display: flex; align-items: center; justify-content: center;">
                        <i class="bi bi-camera-fill small"></i>
                    </label>
                    <input type="file" id="photoUploadInput" class="d-none" accept="image/*" />
                </div>
                <h4 id="lbl-fullname" class="fw-bold mb-1 text-dark">Loading...</h4>
                <p id="lbl-email" class="text-muted small mb-2">loading@hemfoundation.org</p>
                <span id="lbl-role" class="badge bg-success-subtle text-success rounded-pill px-3 py-1 fw-medium mx-auto" style="font-size: 0.8rem;" hidden="">Role</span>
            </div>

            <!-- Security / Password Change Section with Toggle Button -->
            <div class="card border-0 shadow-sm rounded-4 p-4" style="background-color: var(--card-bg);">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h5 class="fw-bold m-0 text-dark"><i class="bi bi-shield-lock-fill text-success me-2"></i> Security</h5>
                    <button class="btn btn-sm btn-outline-success rounded-pill px-3" type="button" data-bs-toggle="collapse" data-bs-target="#passwordCollapse" aria-expanded="false" aria-controls="passwordCollapse">
                        <i class="bi bi-key-fill me-1"></i> Change Password
                    </button>
                </div>

                <!-- Collapsible Password Form -->
                <div class="collapse mt-3" id="passwordCollapse">
                    <form id="formChangePassword">
                        <div class="mb-3">
                            <label class="form-label small fw-semibold">Current Password</label>
                            <input type="password" id="txtCurrentPassword" class="form-control rounded-3 shadow-none" required />
                        </div>
                        <div class="mb-3">
                            <label class="form-label small fw-semibold">New Password</label>
                            <input type="password" id="txtNewPassword" class="form-control rounded-3 shadow-none" required />
                        </div>
                        <div class="mb-3">
                            <label class="form-label small fw-semibold">Confirm New Password</label>
                            <input type="password" id="txtConfirmPassword" class="form-control rounded-3 shadow-none" required />
                        </div>
                        <button type="submit" class="btn btn-success w-100 rounded-3 fw-semibold shadow-sm">Update Password</button>
                    </form>
                </div>
            </div>
        </div>

        <!-- Right Main Content -->
        <div class="col-xl-8">
            <form id="formUpdateProfile" enctype="multipart/form-data">

                <!-- 1. Profile Information Form (Upper Card) -->
                <div class="card border-0 shadow-sm rounded-4 p-4 mb-4" style="background-color: var(--card-bg);">
                    <h5 class="fw-bold mb-4 text-dark"><i class="bi bi-person-lines-fill text-success me-2"></i> Profile Information</h5>
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label small fw-semibold">First Name</label>
                            <input type="text" id="txtFirstName" class="form-control rounded-3 shadow-none" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-semibold">Last Name</label>
                            <input type="text" id="txtLastName" class="form-control rounded-3 shadow-none" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-semibold">Mobile Number <span class="text-danger">*</span></label>
                            <input type="text" id="txtMobileNo" class="form-control rounded-3 shadow-none" maxlength="10" oninput="this.value = this.value.replace(/[^0-9]/g, '')" placeholder="Enter 10-digit mobile number" required />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-semibold">Gender</label>
                            <select id="ddlGender" class="form-select rounded-3 shadow-none">
                                <option value="">Select Gender</option>
                                <option value="Male">Male</option>
                                <option value="Female">Female</option>
                                <option value="Other">Other</option>
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-semibold">Email ID</label>
                            <input type="email" id="txtEmail" class="form-control rounded-3 shadow-none" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-semibold">Pincode (Auto-fills City & State)</label>
                            <input type="text" id="txtPincode" maxlength="6" class="form-control rounded-3 shadow-none" />
                        </div>
                        <div class="col-12">
                            <label class="form-label small fw-semibold">Address</label>
                            <input type="text" id="txtAddress" class="form-control rounded-3 shadow-none" />
                        </div>

                        <!-- City & State with Manual Edit Checkbox -->
                        <div class="col-12 d-flex justify-content-between align-items-center mt-2">
                            <label class="form-label small fw-semibold m-0">Location Details</label>
                            <div class="form-check form-switch">
                                <input class="form-check-input" type="checkbox" id="chkManualCityState" role="switch">
                                <label class="form-check-label small text-muted" for="chkManualCityState">Edit City & State Manually</label>
                            </div>
                        </div>

                        <div class="col-md-6">
                            <label class="form-label small fw-semibold text-muted">City</label>
                            <input type="text" id="txtCity" class="form-control rounded-3 shadow-none bg-light" readonly />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-semibold text-muted">State</label>
                            <input type="text" id="txtState" class="form-control rounded-3 shadow-none bg-light" readonly />
                        </div>
                    </div>
                </div>

                <!-- 2. Academic & Guardian Details (Lower Card for Students) -->
                <div id="studentInfoCard" class="card border-0 shadow-sm rounded-4 p-4 mb-4 d-none" style="background-color: var(--card-bg);">
                    <h5 class="fw-bold mb-4 text-dark"><i class="bi bi-mortarboard-fill text-success me-2"></i> Academic & Guardian Details</h5>
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label small fw-semibold">Standard</label>
                            <input type="text" id="txtStandard" class="form-control rounded-3 shadow-none" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-semibold">Division</label>
                            <input type="text" id="txtDivision" class="form-control rounded-3 shadow-none" />
                        </div>
                        <div class="col-12">
                            <label class="form-label small fw-semibold">Institute / School Name</label>
                            <select id="ddlInstitute" class="form-select rounded-3 shadow-none" style="width: 100%;">
                                <option value="">Select or Search School...</option>
                            </select>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label small fw-semibold">Guardian Name</label>
                            <input type="text" id="txtGuardianName" class="form-control rounded-3 shadow-none" />
                        </div>
                        @* <div class="col-md-4">
                            <label class="form-label small fw-semibold">Guardian Email ID</label>
                            <input type="email" id="txtGuardianEmail" class="form-control rounded-3 shadow-none" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label small fw-semibold">Guardian Mobile No</label>
                            <input type="text" id="txtGuardianMobile" class="form-control rounded-3 shadow-none" />
                        </div> *@
                    </div>
                </div>
                <div id="teacherInfoCard" class="card border-0 shadow-sm rounded-4 p-4 mb-4 d-none" style="background-color: var(--card-bg);">
                    <h5 class="fw-bold mb-4 text-dark"><i class="bi bi-mortarboard-fill text-success me-2"></i> Institute Details</h5>
                    <div class="row g-3">
                        
                       
                        <div class="col-12">
                            <label class="form-label small fw-semibold">Institute / School Name</label>
                            <select id="ddlInstituteteacher" class="form-select rounded-3 shadow-none" style="width: 100%;">
                                <option value="">Select or Search School...</option>
                            </select>
                        </div>
                        
                    </div>
                </div>

                <!-- Single Global Save Button at the Bottom -->
                <div class="card border-0 shadow-sm rounded-4 p-3 mb-4" style="background-color: var(--card-bg);">
                    <div class="d-flex justify-content-end align-items-center">
                        <button type="submit" class="btn btn-success px-5 py-2.5 rounded-3 fw-semibold shadow-sm">
                            <i class="bi bi-check-circle me-1"></i> Save Changes
                        </button>
                    </div>
                </div>

            </form>
        </div>
    </div>
</div>

<!-- Modern Bootstrap Modal Popup for Messages -->
<div class="modal fade" id="messageModal" tabindex="-1" aria-labelledby="messageModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg rounded-4 overflow-hidden">
            <div id="modalHeaderBg" class="modal-header text-white px-4 py-3">
                <h5 class="modal-title fw-bold" id="messageModalLabel">Notification</h5>
                <button type="button" class="btn-close btn-close-white shadow-none" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-4 text-center">
                <div id="modalIcon" class="mb-3 fs-1"></div>
                <p id="modalMessageBody" class="fs-6 text-dark mb-0 fw-medium"></p>
            </div>
            <div class="modal-footer border-0 px-4 pb-4 pt-0 justify-content-center">
                <button type="button" class="btn btn-success px-4 rounded-pill fw-semibold" id="modalOkBtn" data-bs-dismiss="modal">OK</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>
    <script>
        // Custom Popup Function
        function showPopup(message, isSuccess = true, callback = null) {
            const $headerBg = $('#modalHeaderBg');
            const $icon = $('#modalIcon');
            const $title = $('#messageModalLabel');

            if (isSuccess) {
                $headerBg.removeClass('bg-danger').addClass('bg-success');
                $title.text('Success');
                $icon.html('<i class="bi bi-check-circle-fill text-success"></i>');
            } else {
                $headerBg.removeClass('bg-success').addClass('bg-danger');
                $title.text('Error');
                $icon.html('<i class="bi bi-exclamation-triangle-fill text-danger"></i>');
            }

            $('#modalMessageBody').text(message);

            const myModal = new bootstrap.Modal(document.getElementById('messageModal'));
            myModal.show();

            if (callback) {
                $('#modalOkBtn').off('click').on('click', callback);
            } else {
                $('#modalOkBtn').off('click');
            }
        }

        $(document).ready(function() {
            const token = localStorage.getItem('jwt_token') || sessionStorage.getItem('jwt_token');
            let currentUserRole = '';

            $('#ddlInstitute').select2({
                theme: 'bootstrap-5',
                placeholder: 'Search and select school...',
                allowClear: true,
                ajax: {
                    url: '/api/profile/institutes',
                    dataType: 'json',
                    delay: 250,
                    headers: { 'Authorization': 'Bearer ' + token },
                    data: function(params) {
                        return { term: params.term };
                    },
                    processResults: function(data) {
                        return { results: data };
                    },
                    cache: true
                }
            });
            $('#ddlInstituteteacher').select2({
                theme: 'bootstrap-5',
                placeholder: 'Search and select school...',
                allowClear: true,
                ajax: {
                    url: '/api/profile/institutes',
                    dataType: 'json',
                    delay: 250,
                    headers: { 'Authorization': 'Bearer ' + token },
                    data: function(params) {
                        return { term: params.term };
                    },
                    processResults: function(data) {
                        return { results: data };
                    },
                    cache: true
                }
            });
            
            // Toggle manual editing for City and State
            $('#chkManualCityState').on('change', function() {
                if ($(this).is(':checked')) {
                    $('#txtCity, #txtState').removeAttr('readonly').removeClass('bg-light').css('background-color', '#fff');
                } else {
                    $('#txtCity, #txtState').attr('readonly', true).addClass('bg-light').css('background-color', '#f8f9fa');
                }
            });

            // Load Profile Data
            $.ajax({
                url: '/api/profile/details',
                type: 'GET',
                headers: { 'Authorization': 'Bearer ' + token },
                success: function(res) {
                    if (res.success) {
                        currentUserRole = res.role;
                        $('#lbl-fullname').text(res.user.fullName || res.user.email);
                        $('#lbl-email').text(res.user.email);
                        $('#lbl-role').text(res.role);

                        $('#txtFirstName').val(res.profile.firstName || '');
                        $('#txtLastName').val(res.profile.lastName || '');
                        $('#txtMobileNo').val(res.user.phoneNumber || res.profile.mobileNo || '');
                        $('#txtEmail').val(res.user.email);
                        $('#txtAddress').val(res.profile.address || '');
                        $('#txtCity').val(res.profile.city || '');
                        $('#txtState').val(res.profile.state || '');
                        $('#txtPincode').val(res.profile.pincode || '');
                        $('#ddlGender').val(res.profile.gender || '');

                        const photo = res.profile.photoUrl;
                        if (photo) {
                            $('#profile-avatar-img').attr('src', photo);
                        }

                        if (res.role && res.role.toLowerCase() === 'wj_students') {
                            $('#studentInfoCard').removeClass('d-none');
                            $('#txtStandard').val(res.profile.standard === 'Not Updated' ? '' : res.profile.standard);
                            $('#txtDivision').val(res.profile.division === 'Not Updated' ? '' : res.profile.division);
                            $('#txtGuardianName').val(res.profile.guardianName === 'Not Updated' ? '' : res.profile.guardianName);
                            //$('#txtGuardianEmail').val(res.profile.guardianEmail === 'Not Updated' ? '' : res.profile.guardianEmail);
                           // $('#txtGuardianMobile').val(res.profile.guardianMobile === 'Not Updated' ? '' : res.profile.guardianMobile);

                            if (res.profile.studentInstituteId && res.profile.studentInstituteName) {
                                let newOption = new Option(res.profile.studentInstituteName, res.profile.studentInstituteId, true, true);
                                $('#ddlInstitute').append(newOption).trigger('change');
                                $('#ddlInstitute').prop('disabled', true);
                            }
                            if (res.profile.standard && res.profile.standard) {
                               
                                $('#txtStandard').prop('disabled', true);
                            }
                            if (res.profile.standard && res.profile.standard) {
                               
                                $('#txtDivision').prop('disabled', true);
                            }
                        }
                        if (res.role && res.role.toLowerCase() === 'wj_teacher') {
                            $('#teacherInfoCard').removeClass('d-none');

                            if (res.profile.studentInstituteId && res.profile.studentInstituteName) {
                                let newOption = new Option(res.profile.studentInstituteName, res.profile.studentInstituteId, true, true);
                                $('#ddlInstituteteacher').append(newOption).trigger('change');
                                $('#ddlInstituteteacher').prop('disabled', true);
                            }
                        }
                    }
                }
            });

            // Pincode Auto-fill
            $('#txtPincode').on('keyup', function() {
                if ($('#chkManualCityState').is(':checked')) return;

                let pincode = $(this).val().trim();
                if (pincode.length === 6) {
                    $.get(`https://api.postalpincode.in/pincode/${pincode}`, function(data) {
                        if (data && data[0].Status === "Success") {
                            let postOffice = data[0].PostOffice[0];
                            $('#txtCity').val(postOffice.District);
                            $('#txtState').val(postOffice.State);
                        }
                    });
                }
            });

            // Photo Preview
            let selectedPhotoFile = null;
            $('#photoUploadInput').on('change', function(e) {
                const file = e.target.files[0];
                if (file) {
                    selectedPhotoFile = file;
                    const reader = new FileReader();
                    reader.onload = function(event) {
                        $('#profile-avatar-img').attr('src', event.target.result);
                    };
                    reader.readAsDataURL(file);
                }
            });

            // Save Form Submission with Popup
            $('#formUpdateProfile').on('submit', function(e) {
                e.preventDefault();
                let formData = new FormData();
                formData.append('firstName', $('#txtFirstName').val());
                formData.append('lastName', $('#txtLastName').val());
                formData.append('phoneNumber', $('#txtMobileNo').val());
                const email = $('#txtEmail').val().trim();
                const standard = $('#txtStandard').val().trim();

                if (standard !== '') {
                    // Standard available hai, email optional rahegi
                    formData.append('guardianEmail', email);
                } else {
                    // Email ki existing value bhejo
                    formData.append('guardianEmail', email);
                }
                formData.append('address', $('#txtAddress').val());
                formData.append('city', $('#txtCity').val());
                formData.append('state', $('#txtState').val());
                formData.append('pincode', $('#txtPincode').val());
                formData.append('gender', $('#ddlGender').val());

                if (currentUserRole && currentUserRole.toLowerCase() === 'wj_students') {
                    formData.append('standard', $('#txtStandard').val());
                    formData.append('division', $('#txtDivision').val());
                    formData.append('guardianName', $('#txtGuardianName').val());
                    // formData.append('guardianEmail', $('#txtGuardianEmail').val());
                    // formData.append('guardianMobile', $('#txtGuardianMobile').val());
                    if (!$('#ddlInstitute').is(':disabled')) {
                        formData.append('instituteID', $('#ddlInstitute').val() || '');
                    }
                }
                if (currentUserRole && currentUserRole.toLowerCase() === 'wj_teacher') {
                     if (!$('#ddlInstituteteacher').is(':disabled')) {
                        formData.append('instituteID', $('#ddlInstituteteacher').val() || '');
                    }
                }

                if (selectedPhotoFile) {
                    formData.append('profilePhoto', selectedPhotoFile);
                }

                $.ajax({
                    url: '/api/profile/update',
                    type: 'POST',
                    data: formData,
                    processData: false,
                    contentType: false,
                    headers: { 'Authorization': 'Bearer ' + token },
                    success: function(res) {
                        showPopup(res.message, true, function() {
                            location.reload();
                        });
                    },
                    error: function(err) {
                        showPopup(err.responseJSON?.message || 'Update failed', false);
                    }
                });
            });

            // Change Password Form with Popup
            $('#formChangePassword').on('submit', function(e) {
                e.preventDefault();
                const newPass = $('#txtNewPassword').val();
                const confirmPass = $('#txtConfirmPassword').val();

                if (newPass !== confirmPass) {
                    showPopup('New Password and Confirm Password do not match.', false);
                    return;
                }

                const payload = {
                    currentPassword: $('#txtCurrentPassword').val(),
                    newPassword: newPass
                };

                $.ajax({
                    url: '/api/profile/change-password',
                    type: 'POST',
                    contentType: 'application/json',
                    headers: { 'Authorization': 'Bearer ' + token },
                    data: JSON.stringify(payload),
                    success: function(res) {
                        showPopup(res.message, true);
                        $('#formChangePassword')[0].reset();
                        $('#passwordCollapse').collapse('hide');
                    },
                    error: function(err) {
                        showPopup(err.responseJSON?.message || 'Password change failed', false);
                    }
                });
            });
        });
    </script>
}