@model HemFoundation.Models.ScrambleModel

@{
    ViewBag.Title = "Scramble Challenge";
    Layout = "~/Views/Shared/Layouts/_TeacherLayout.cshtml";
    var isInWJTeacherRole = User.IsInRole("WJ_Teacher");
}

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css">
<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<link href="https://cdn.jsdelivr.net/npm/bootstrap-sweetalert/dist/sweetalert.css" rel="stylesheet">
<script src="https://cdn.jsdelivr.net/npm/bootstrap-sweetalert/dist/sweetalert.min.js"></script>
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/animate.css/4.1.1/animate.min.css" />

<style>
    :root {
        --slate-900: #0f172a;
        --slate-800: #1e293b;
        --slate-700: #334155;
        --slate-100: #f1f5f9;
        --brand-blue: #0284c7;
        --emerald-500: #10b981;
        --amber-500: #f59e0b;
    }

    body {
        background-color: #f8fafc;
        color: var(--slate-900);
    }

    footer {
        display: none !important;
    }

    .lms-content-stage {
        width: 100% !important;
        max-width: 100vw !important;
        overflow-x: hidden !important;
        padding: 20px 15px !important;
        box-sizing: border-box !important;
    }

    .scramble-workspace-card {
        background: #ffffff;
        border: 1px solid #e2e8f0;
        border-radius: 16px;
        padding: 25px;
        box-shadow: 0 4px 6px -1px rgba(0,0,0,0.02);
        width: 100%;
        box-sizing: border-box;
    }

    .scramble-row-item {
        padding: 12px 0;
        border-bottom: 1px solid #f1f5f9;
    }

        .scramble-row-item:last-child {
            border-bottom: none;
        }

    .scramble-word-title {
        font-size: 16px;
        font-weight: 800;
        letter-spacing: 1.5px;
        color: var(--slate-800);
        margin-bottom: 6px;
        text-transform: uppercase;
    }

    .letter-box-group {
        display: flex;
        flex-wrap: wrap;
        justify-content: center;
        gap: 5px;
    }

    .letter-box {
        width: 32px;
        height: 36px;
        text-align: center;
        font-size: 15px;
        font-weight: 700;
        border-radius: 6px;
        border: 2px solid #cbd5e1;
        transition: all 0.2s ease;
    }

        .letter-box:focus {
            border-color: var(--brand-blue);
            outline: none;
            box-shadow: 0 0 0 3px rgba(2, 132, 199, 0.25);
        }

    .letter-highlight {
        background-color: #fef08a !important;
        color: #854d0e !important;
        border-color: #fde047 !important;
    }

    .letter-normal {
        background-color: #e0f2fe !important;
        color: #0369a1 !important;
        border-color: #bae6fd !important;
    }

    .btn-action-pill {
        border-radius: 30px !important;
        font-weight: 600 !important;
        font-size: 14px !important;
        padding: 8px 26px !important;
        border: none !important;
        transition: all 0.2s ease;
    }

    .btn-pill-primary {
        background: var(--brand-blue) !important;
        color: #fff !important;
    }

        .btn-pill-primary:hover {
            background: #0369a1 !important;
        }
</style>

<div class="container-fluid">
    <div class="lms-content-stage animate__animated animate__fadeIn">

        @{
            var message = TempData["Message"] as string;
            var messageType = TempData["MessageType"] as string ?? "info";
            var alertClass = "alert-info";

            if (messageType == "success") { alertClass = "alert-success"; }
            else if (messageType == "error") { alertClass = "alert-danger"; }
            else if (messageType == "warning") { alertClass = "alert-warning"; }
        }

        @if (!string.IsNullOrEmpty(message))
        {
            <div class="alert @alertClass alert-dismissible fade show mb-3" role="alert">
                @message
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }

        <div class="scramble-workspace-card">
            <h2 style="font-weight:800; font-size:24px; margin:4px 0 2px 0;">Scramble</h2>

            <input type="hidden" value="@ViewBag.CourseID" id="CID" />
            <input type="hidden" value="@ViewBag.CourseName" id="CNAME" />
            <input type="hidden" value="@ViewBag.QuestionID" id="QID" />
            <input type="hidden" value="@ViewBag.TopicId" id="TID" />
            <input type="hidden" value="@ViewBag.Answer" id="CorrectAns" />

            <div class="row">
                <div class="col-12">
                    @if (Model?.scrambleWord_Results != null && Model.scrambleWord_Results.Any())
                    {
                        int j = 1;
                        foreach (var item in Model.scrambleWord_Results)
                        {
                            <div id="@("div" + j)" class="scramble-row-item text-center">
                                <div class="scramble-word-title">
                                    @(item.ScrambleWord)
                                </div>
                                <div class="letter-box-group">
                                    @for (int i = 1; i <= item.UnscrambleWord.Length; i++)
                                    {
                                        bool isHighlight = (item.FirstIndex == i || item.SecondIndex == i || item.ThirdIndex == i || item.FourthIndex == i);
                                        string boxClass = isHighlight ? "letter-box letter-highlight" : "letter-box letter-normal";

                                        <input type="text" value=""
                                               class="@boxClass text-uppercase"
                                               onkeypress="CheckValueMaxLength(this)"
                                               id="@("answer" + j + i)"
                                               name="@("answer" + j + i)"
                                               maxlength="1" />
                                    }
                                </div>
                            </div>
                            j++;
                        }
                    }
                </div>
            </div>

            <hr class="my-4" style="color: #e2e8f0;" />

            <div id="lblQuestion" class="row justify-content-center text-center">
                <div class="col-12 mb-3">
                    <label id="lblquest" class="h5 font-weight-bold text-dark mb-0"></label>
                </div>
                <div class="col-12 d-flex justify-content-center">
                    <button class="btn btn-action-pill btn-pill-primary" id="btntxtAns" type="button"
                            onclick="SaveTxtAns('@ViewBag.QuestionID', '@ViewBag.TopicId')"
                        @(isInWJTeacherRole ? "disabled" : "")>
                        Submit Answer
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

<script type="text/javascript">
    function ValidateAnswer() {
        let allAnswersCorrect = true;
        var scrambleWordResults = [];

        @if (Model?.scrambleWord_Results != null && Model.scrambleWord_Results.Any())
            {
                int j = 1;
                    foreach (var item in Model.scrambleWord_Results)
                {
                    <text>
                            scrambleWordResults.push({
                                id: @j,
                            word: '@item.UnscrambleWord'
                                    });
                    </text>
                j++;
            }
            }

            scrambleWordResults.forEach(function(result) {
                var userinput = "";
                for (var i = 1; i <= result.word.length; i++) {
                    var element = document.getElementById("answer" + result.id + i);
                    if (element) {
                        userinput += element.value;
                    }
                }

                if (userinput.length !== result.word.length) {
                    alert("Please complete the answer for word row: " + result.id);
                    allAnswersCorrect = false;
                } else if (result.word.toUpperCase() !== userinput.toUpperCase()) {
                    alert("Incorrect answer for word row: " + result.id);
                    allAnswersCorrect = false;
                }
            });

        return allAnswersCorrect;
    }
</script>

@section Scripts {
    <script type="text/javascript">
        function humanize(str) {
            if (!str) return "";
            var i, frags = str.split('_');
            for (i = 0; i < frags.length; i++) {
                frags[i] = frags[i].charAt(0).toUpperCase() + frags[i].slice(1);
            }
            return frags.join('<input type="text" value="" id="txtQAns" class="form-control d-inline-block text-center text-uppercase mx-1 my-1" style="max-width: 200px; font-weight:700; border:2px solid var(--brand-blue);" required="required" placeholder="Answer" /> ');
        }

        $(document).ready(function() {
            var Question = '@Html.Raw(ViewBag.Question)';
            var pp = humanize(Question);
            document.getElementById("lblquest").innerHTML = pp;
        });

        function CheckValueMaxLength(obj) {
            var val = obj.id;
            var rr = $("#" + val).val();
            val = rr.replace(/[^a-zA-Z0-9]/, "");
            $("#" + val).val(val);
        }

        function SaveTxtAns(QID, TID) {
            var $submitBtn = $('#btntxtAns');
            $submitBtn.prop('disabled', true);

            if (!ValidateAnswer()) {
                alert("Please correct the answers before proceeding.");
                $submitBtn.prop('disabled', false);
                return;
            }

            let finalAnswer = $("#txtQAns").val();
            if (!finalAnswer || finalAnswer.trim() === "") {
                alert('Final answer is required.');
                $submitBtn.prop('disabled', false);
                return;
            }

            SubmitAnswer(QID, TID, finalAnswer);
        }

        function SubmitAnswer(QuestionId, ScrambleTopicId, Answer) {
            var correctanswer = document.getElementById("CorrectAns").value;
            var $submitBtn = $('#btntxtAns');

            if (Answer !== "" && Answer.trim().toUpperCase() === correctanswer.trim().toUpperCase()) {
                $.ajax({
                    type: "GET",
                    url: '@Url.Action("AddAnswer", "Scramble")',
                    data: {
                        questionID: QuestionId,
                        scrambleTopicId: ScrambleTopicId,
                        answer: Answer,
                        practID: '@ViewBag.PracticleID'
                    },
                    success: function(data) {
                        if (data && data.Success) {
                            alert("Congrats! " + data.Message);
                            setTimeout(function() {
                                window.location.href = '/learn/index';
                            }, 3000);
                        } else {
                            alert('An error occurred: ' + (data ? data.Message : 'Unknown error'));
                            $submitBtn.prop('disabled', false);
                        }
                    },
                    error: function() {
                        alert('Failed to submit the answer. Please try again.');
                        $submitBtn.prop('disabled', false);
                    }
                });
            } else {
                alert("The correct answer should be filled in before submitting, and all characters should be in capital.");
                $submitBtn.prop('disabled', false);
            }
        }
    </script>
}