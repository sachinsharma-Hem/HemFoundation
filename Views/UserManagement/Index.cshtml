@{
    ViewData["Title"] = "User Management";
    Layout = "~/Views/Shared/Layouts/_AdminLayout.cshtml";
}

<div class="container-fluid py-3 px-3 px-md-4">

    <div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-4">

        <div>
            <h2 class="fw-bold text-dark mb-1">
                <i class="bi bi-people-fill text-success me-2"></i>
                User Management
            </h2>
            <p class="text-muted small mb-0">
                Manage, monitor and control all registered system users
            </p>
        </div>

        <div class="d-flex gap-2 flex-wrap">
            <button type="button"
                    class="btn btn-primary btn-sm rounded-pill px-3"
                    id="btnAdminAccounts"
                    title="Admin login accounts">
                <i class="bi bi-shield-lock me-1"></i>
                Admin accounts
            </button>
            <button type="button"
                    class="btn btn-outline-success btn-sm rounded-pill px-3"
                    onclick="loadMasterUsers()"
                    title="Refresh user list">
                <i class="bi bi-arrow-clockwise me-1"></i>
                <span class="d-none d-sm-inline">Refresh</span>
            </button>
        </div>

    </div>


    <!-- =========================================
         STATISTICS CARDS
    ========================================== -->
    <div class="row g-3 mb-4">

        <div class="col-12 col-sm-6 col-lg-3">
            <div class="card border-0 shadow-sm rounded-3 h-100">
                <div class="card-body d-flex align-items-center justify-content-between p-3">
                    <div>
                        <small class="text-muted d-block mb-1">Total Users</small>
                        <h4 class="fw-bold text-dark mb-0" id="statTotalUsers">0</h4>
                    </div>
                    <div class="bg-primary-subtle rounded-3 p-3">
                        <i class="bi bi-people-fill text-primary fs-5"></i>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-12 col-sm-6 col-lg-3">
            <div class="card border-0 shadow-sm rounded-3 h-100">
                <div class="card-body d-flex align-items-center justify-content-between p-3">
                    <div>
                        <small class="text-muted d-block mb-1">Active Users</small>
                        <h4 class="fw-bold text-success mb-0" id="statActiveUsers">0</h4>
                    </div>
                    <div class="bg-success-subtle rounded-3 p-3">
                        <i class="bi bi-check-circle-fill text-success fs-5"></i>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-12 col-sm-6 col-lg-3">
            <div class="card border-0 shadow-sm rounded-3 h-100">
                <div class="card-body d-flex align-items-center justify-content-between p-3">
                    <div>
                        <small class="text-muted d-block mb-1">Inactive Users</small>
                        <h4 class="fw-bold text-danger mb-0" id="statInactiveUsers">0</h4>
                    </div>
                    <div class="bg-danger-subtle rounded-3 p-3">
                        <i class="bi bi-x-circle-fill text-danger fs-5"></i>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-12 col-sm-6 col-lg-3">
            <div class="card border-0 shadow-sm rounded-3 h-100">
                <div class="card-body d-flex align-items-center justify-content-between p-3">
                    <div>
                        <small class="text-muted d-block mb-1">Selected</small>
                        <h4 class="fw-bold text-dark mb-0" id="statSelectedUsers">0</h4>
                    </div>
                    <div class="bg-light rounded-3 p-3">
                        <i class="bi bi-check2-square text-secondary fs-5"></i>
                    </div>
                </div>
            </div>
        </div>

    </div>


    <!-- =========================================
         ROLE DISTRIBUTION CARD
    ========================================== -->
    <div class="card border-0 shadow-sm rounded-3 mb-4">

        <div class="card-body p-3 p-md-4">

            <h6 class="fw-bold text-dark mb-3">
                <i class="bi bi-pie-chart-fill text-primary me-2"></i>
                Role Distribution
            </h6>

            <div id="roleDistribution" class="d-flex flex-wrap gap-2">
                <span class="text-muted small">Loading...</span>
            </div>

        </div>

    </div>


    <!-- =========================================
         FILTER PANEL
    ========================================== -->
    <div class="card border-0 shadow-sm rounded-3 mb-4">

        <div class="card-body p-3 p-md-4">

            <h6 class="fw-bold text-dark mb-3">
                <i class="bi bi-funnel-fill text-secondary me-2"></i>
                Filters
            </h6>

            <div class="row g-2 g-md-3 mb-3">

                <!-- Role Filter -->
                <div class="col-12 col-sm-6 col-lg-3">
                    <label class="form-label small fw-bold text-muted mb-2">
                        Role / Portal
                    </label>
                    <select class="form-select form-select-sm rounded-2 shadow-none border"
                            id="filterRole"
                            onchange="applyFilters()">
                        <option value="">-- All Roles --</option>
                    </select>
                </div>

                <!-- Status Filter -->
                <div class="col-12 col-sm-6 col-lg-3">
                    <label class="form-label small fw-bold text-muted mb-2">
                        Status
                    </label>
                    <select class="form-select form-select-sm rounded-2 shadow-none border"
                            id="filterStatus"
                            onchange="applyFilters()">
                        <option value="">-- All Status --</option>
                        <option value="active">Active</option>
                        <option value="inactive">Inactive</option>
                    </select>
                </div>

                <!-- Date Filter -->
                <div class="col-12 col-sm-6 col-lg-3">
                    <label class="form-label small fw-bold text-muted mb-2">
                        Registered Date
                    </label>
                    <select class="form-select form-select-sm rounded-2 shadow-none border"
                            id="filterDate"
                            onchange="applyFilters()">
                        <option value="">-- All Dates --</option>
                        <option value="today">Today</option>
                        <option value="7days">Last 7 Days</option>
                        <option value="30days">Last 30 Days</option>
                    </select>
                </div>

                <!-- Search -->
                <div class="col-12 col-lg-3">
                    <label class="form-label small fw-bold text-muted mb-2">
                        Search
                    </label>
                    <div class="input-group input-group-sm">
                        <span class="input-group-text bg-light border-0 text-muted rounded-start-2">
                            <i class="bi bi-search"></i>
                        </span>
                        <input type="text"
                               class="form-control form-control-sm bg-light border-0 rounded-end-2 shadow-none"
                               id="searchQuery"
                               placeholder="Name, username, mobile..."
                               onkeyup="applyFilters()">
                    </div>
                </div>

            </div>

            <!-- Action Buttons -->
            <div class="d-flex gap-2 flex-wrap">
                <button type="button"
                        class="btn btn-sm btn-outline-secondary rounded-2"
                        onclick="resetFilters()">
                    <i class="bi bi-arrow-counterclockwise me-1"></i>
                    Reset Filters
                </button>
            </div>

        </div>

    </div>


    <!-- =========================================
         BATCH ACTIONS BAR
    ========================================== -->
    <div class="card border-0 shadow-sm rounded-3 bg-light border border-secondary border-opacity-25 mb-3 d-none"
         id="batchActionsBar">

        <div class="card-body d-flex align-items-center justify-content-between flex-wrap gap-2 p-3">

            <small class="text-muted">
                <i class="bi bi-check2-square me-1"></i>
                <span id="selectedUsersText">0 users selected</span>
            </small>

            <button type="button"
                    class="btn btn-sm btn-danger rounded-2"
                    id="btnDeleteSelected"
                    onclick="deleteSelectedUsers()"
                    disabled>
                <i class="bi bi-trash3-fill me-1"></i>
                Delete Selected
            </button>

        </div>

    </div>


    <!-- =========================================
         RESULTS INFO
    ========================================== -->
    <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-3 px-2">

        <small class="text-muted" id="recordInfo">
            Showing 0 to 0 of 0 users
        </small>

        <small class="text-muted" id="pageInfo">
            Page 1 of 1
        </small>

    </div>


    <!-- =========================================
         TABLE
    ========================================== -->
    <div class="card border-0 shadow-sm rounded-3 mb-4">

        <div class="table-responsive">

            <table class="table table-hover table-sm align-middle mb-0" id="masterUserTable">

                <thead class="table-light border-bottom">

                    <tr>

                        <th class="text-center ps-3" style="width: 45px;">
                            <input type="checkbox"
                                   class="form-check-input shadow-none"
                                   id="selectAllUsers"
                                   onchange="toggleSelectAll()">
                        </th>

                        <th class="py-3" style="width: 50px;">S.No.</th>

                        <th class="py-3">User</th>

                        <th class="py-3 d-none d-lg-table-cell">User Code</th>
                        <th class="py-3 d-none d-lg-table-cell">Password</th>

                        <th class="py-3">Role</th>

                        <th class="py-3 d-none d-md-table-cell">Mobile</th>

                        <th class="py-3 d-none d-xl-table-cell">Registered</th>

                        <th class="py-3 text-center" style="width: 80px;">Status</th>

                        <th class="py-3 text-end pe-3" style="width: 110px;">Actions</th>

                    </tr>

                </thead>

                <tbody id="masterUserTableBody">

                    <tr>
                        <td colspan="9" class="text-center py-5 text-muted">
                            <div class="spinner-border spinner-border-sm text-success mb-2" role="status"></div>
                            <p class="small m-0">Loading user records...</p>
                        </td>
                    </tr>

                </tbody>

            </table>

        </div>

    </div>


    <!-- =========================================
         PAGINATION
    ========================================== -->
    <div class="d-flex flex-wrap justify-content-center justify-content-md-between align-items-center">

        <small class="text-muted d-none d-md-block" id="paginationInfo"></small>

        <nav aria-label="User pagination">
            <ul class="pagination pagination-sm mb-0" id="pagination"></ul>
        </nav>

    </div>

</div>


<!-- =========================================
     VIEW DETAILS MODAL
========================================== -->
<div class="modal fade" id="viewDetailModal" tabindex="-1" aria-hidden="true">

    <div class="modal-dialog modal-dialog-centered modal-lg">

        <div class="modal-content border-0 shadow-lg rounded-3 overflow-hidden">

            <div class="modal-header bg-success text-white px-4 py-3 border-0">
                <h5 class="fw-bold m-0">
                    <i class="bi bi-person-badge me-2"></i>
                    User Details
                </h5>
                <button type="button" class="btn-close btn-close-white shadow-none" data-bs-dismiss="modal"></button>
            </div>

            <div class="modal-body p-4">

                <div class="row g-3">

                    <!-- Section: Identity -->
                    <div class="col-12">
                        <h6 class="text-muted small fw-bold mb-2">Identity</h6>
                    </div>

                    <div class="col-md-6">
                        <small class="text-muted d-block mb-1">User Code</small>
                        <div id="detCode" class="fw-bold text-dark">-</div>
                    </div>

                    <div class="col-md-6">
                        <small class="text-muted d-block mb-1">Username</small>
                        <div id="detUsername" class="fw-bold text-dark">-</div>
                    </div>

                    <div class="col-md-6">
                        <small class="text-muted d-block mb-1">Full Name</small>
                        <div id="detName" class="fw-bold text-dark">-</div>
                    </div>

                    <div class="col-md-6">
                        <small class="text-muted d-block mb-1">Role / Portal</small>
                        <div id="detPortal">
                            <span class="badge bg-primary">-</span>
                        </div>
                    </div>

                    <!-- Section: Contact -->
                    <div class="col-12 pt-3">
                        <h6 class="text-muted small fw-bold mb-2">Contact Information</h6>
                    </div>

                    <div class="col-md-6">
                        <small class="text-muted d-block mb-1">Email</small>
                        <div id="detEmail" class="text-dark text-break">-</div>
                    </div>

                    <div class="col-md-6">
                        <small class="text-muted d-block mb-1">Mobile</small>
                        <div id="detMobile" class="text-dark">-</div>
                    </div>

                    <div class="col-12">
                        <small class="text-muted d-block mb-1">Address</small>
                        <div id="detAddress" class="text-dark">-</div>
                    </div>

                    <!-- Section: Account -->
                    <div class="col-12 pt-3">
                        <h6 class="text-muted small fw-bold mb-2">Account</h6>
                    </div>

                    <div class="col-md-6">
                        <small class="text-muted d-block mb-1">Registered On</small>
                        <div id="detDate" class="text-dark">-</div>
                    </div>

                    <div class="col-md-6">
                        <small class="text-muted d-block mb-1">Status</small>
                        <div id="detStatus">-</div>
                    </div>

                </div>

            </div>

            <div class="modal-footer bg-light border-0">
                <button type="button" class="btn btn-secondary btn-sm rounded-2" data-bs-dismiss="modal">
                    Close
                </button>
            </div>

        </div>

    </div>

</div>


<!-- =========================================
     EDIT ROLE MODAL
========================================== -->
<div class="modal fade" id="editRoleModal" tabindex="-1" aria-hidden="true">

    <div class="modal-dialog modal-dialog-centered">

        <div class="modal-content border-0 shadow-lg rounded-3">

            <div class="modal-header bg-primary text-white px-4 py-3 border-0">
                <h5 class="fw-bold m-0">
                    <i class="bi bi-shield-lock me-2"></i>
                    Update User Role
                </h5>
                <button type="button" class="btn-close btn-close-white shadow-none" data-bs-dismiss="modal"></button>
            </div>

            <div class="modal-body p-4">

                <form id="frmEditRole" onsubmit="submitEditRole(event)">

                    <input type="hidden" id="editIdentityId" />

                    <div class="mb-3">
                        <label class="form-label small fw-bold text-muted">Current User</label>
                        <input type="text"
                               class="form-control form-control-sm bg-light border-0"
                               id="editUserNameDisplay"
                               readonly />
                    </div>

                    <div class="mb-4">
                        <label class="form-label small fw-bold text-muted">
                            Select New Role
                            <span class="text-danger">*</span>
                        </label>
                        <select class="form-select form-select-sm rounded-2 shadow-none border"
                                id="modalRoleSelect"
                                required>
                            <option value="">-- Select Role --</option>
                        </select>
                    </div>

                    <button type="submit" class="btn btn-primary w-100 rounded-2 fw-bold py-2">
                        <i class="bi bi-check-circle me-1"></i>
                        Save Role Changes
                    </button>

                </form>

            </div>

        </div>

    </div>

</div>



<!-- =========================================
     ADMIN ACCOUNTS (public."Admins")
========================================== -->
<div class="modal fade" id="adminAccountsModal" tabindex="-1" aria-labelledby="adminAccountsTitle" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-scrollable modal-fullscreen-md-down">
        <div class="modal-content border-0 rounded-4 overflow-hidden">
            <div class="modal-header border-0 px-4 py-3" style="background:linear-gradient(90deg,#4B2E83,#6c3fb0);color:#fff">
                <div>
                    <h5 class="modal-title fw-bold mb-0" id="adminAccountsTitle"><i class="bi bi-shield-lock me-2"></i>Admin accounts</h5>
                    <small class="opacity-75">People who log in to the admin panel with their own email and password</small>
                </div>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-3 p-md-4 bg-light">
                <div class="d-flex flex-wrap gap-2 align-items-center justify-content-between mb-3">
                    <div class="d-flex flex-wrap gap-2" id="aaSummary"></div>
                    <button type="button" class="btn btn-primary rounded-pill px-3" id="aaToggleForm" hidden>
                        <i class="bi bi-person-plus me-1"></i> Add admin
                    </button>
                </div>
                <div id="aaNotice"></div>

                <!-- Add admin -->
                <form id="aaForm" class="card border-0 shadow-sm rounded-4 mb-3" novalidate autocomplete="off" hidden>
                    <div class="card-body p-3 p-md-4">
                        <h6 class="fw-bold mb-3"><i class="bi bi-person-plus text-primary me-1"></i> New admin</h6>
                        <div class="row g-3">
                            <div class="col-md-6"><label class="form-label small fw-bold" for="aaFirst">First name <span class="text-danger">*</span></label>
                                <input type="text" class="form-control" id="aaFirst" maxlength="100" required></div>
                            <div class="col-md-6"><label class="form-label small fw-bold" for="aaLast">Last name</label>
                                <input type="text" class="form-control" id="aaLast" maxlength="100"></div>
                            <div class="col-md-6"><label class="form-label small fw-bold" for="aaEmail">Email (used to log in) <span class="text-danger">*</span></label>
                                <input type="email" class="form-control" id="aaEmail" maxlength="200" required autocomplete="off"></div>
                            <div class="col-md-6"><label class="form-label small fw-bold" for="aaMobile">Mobile</label>
                                <input type="tel" class="form-control" id="aaMobile" maxlength="10" inputmode="numeric" placeholder="10 digits"></div>
                            <div class="col-md-6"><label class="form-label small fw-bold" for="aaPassword">Password <span class="text-danger">*</span></label>
                                <div class="input-group">
                                    <input type="password" class="form-control" id="aaPassword" maxlength="100" required autocomplete="new-password" placeholder="At least 8 characters, letters and numbers">
                                    <button class="btn btn-outline-secondary" type="button" id="aaShowPw" title="Show password"><i class="bi bi-eye"></i></button>
                                    <button class="btn btn-outline-secondary" type="button" id="aaGenPw" title="Make a strong password"><i class="bi bi-magic"></i></button>
                                </div>
                                <div class="form-text">Share it with the person safely; they log in with the email and this password.</div></div>
                            <div class="col-md-6"><label class="form-label small fw-bold" for="aaRole">Role</label>
                                <select class="form-select" id="aaRole"></select>
                                <div class="form-check form-switch mt-2">
                                    <input class="form-check-input" type="checkbox" role="switch" id="aaSuper">
                                    <label class="form-check-label small" for="aaSuper">Super admin – sees every menu and can manage admins</label>
                                </div></div>
                        </div>
                        <div id="aaFormError" class="alert alert-danger py-2 small mt-3 mb-0" hidden></div>
                        <div class="d-flex gap-2 mt-3">
                            <button type="submit" class="btn btn-success rounded-pill px-4" id="aaSave"><i class="bi bi-check2 me-1"></i> Create admin</button>
                            <button type="button" class="btn btn-light rounded-pill px-3" id="aaCancel">Cancel</button>
                        </div>
                    </div>
                </form>

                <!-- List -->
                <div class="card border-0 shadow-sm rounded-4">
                    <div class="table-responsive">
                        <table class="table align-middle mb-0">
                            <thead class="table-light small text-uppercase text-muted">
                                <tr><th class="ps-3">Admin</th><th>Login email / mobile</th><th style="min-width:200px">Role</th><th>Status</th><th class="pe-3">Added</th></tr>
                            </thead>
                            <tbody id="aaRows"><tr><td colspan="5" class="text-center text-muted py-4">Loading…</td></tr></tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/admin-accounts.js" asp-append-version="true"></script>

    <script>


        let allMasterUsers = [];
        let filteredMasterUsers = [];
        let currentPage = 1;
        const pageSize = 50;
        let availableRoles = [];

        $(document).ready(function() {

            loadRolesDropdown();
            loadMasterUsers();

            // Select All behavior
            $('#selectAllUsers').on('change', function() {
                const isChecked = $(this).is(':checked');
                $('.user-checkbox').prop('checked', isChecked);
                updateDeleteButtonState();
            });

        });


        function loadRolesDropdown() {

            $.get('/api/usermanagement/roles-list')
                .done(function(res) {

                    if (!res || !res.success || !res.data) {
                        return;
                    }

                    availableRoles = res.data;

                    let filterOpts = '<option value="">-- All Roles --</option>';
                    let modalOpts = '<option value="">-- Select Role --</option>';

                    res.data.forEach(function(r) {
                        const roleName = escapeHtml(r.roleName || '-');
                        filterOpts += `<option value="${roleName}">${roleName}</option>`;
                        modalOpts += `<option value="${roleName}">${roleName}</option>`;
                    });

                    $('#filterRole').html(filterOpts);
                    $('#modalRoleSelect').html(modalOpts);

                })
                .fail(function(xhr) {
                    console.error("Roles API Error:", xhr.responseText);
                });

        }

        // Users are loaded one page at a time from the server; filters and
        // search run in the database. filteredMasterUsers keeps the full
        // length (total matches) with only the current page filled, so the
        // existing table, paging and row actions work unchanged.
        let usersRequestId = 0;
        let usersStats = { total: 0, active: 0, inactive: 0 };
        let searchTimer = null;

        function currentFilters() {
            return {
                role: ($('#filterRole').val() || '').trim(),
                status: ($('#filterStatus').val() || '').trim(),
                date: ($('#filterDate').val() || '').trim(),
                search: ($('#searchQuery').val() || '').trim()
            };
        }

        function loadMasterUsers() {

            const requestId = ++usersRequestId;
            showTableLoading("Loading user records...");

            const params = $.param(Object.assign({ page: currentPage, pageSize: pageSize }, currentFilters()));

            $.get('/api/usermanagement/users?' + params)
                .done(function(res) {

                    if (requestId !== usersRequestId) return;   // a newer request is running

                    if (!res || !res.success) {
                        showTableError("Unable to load user records.");
                        return;
                    }

                    const total = res.total || 0;
                    filteredMasterUsers = new Array(total);
                    const start = (currentPage - 1) * pageSize;
                    (res.data || []).forEach(function(u, i) { filteredMasterUsers[start + i] = u; });
                    allMasterUsers = filteredMasterUsers;

                    usersStats = { total: total, active: res.active || 0, inactive: res.inactive || 0 };

                    const totalPages = Math.ceil(total / pageSize) || 1;
                    if (currentPage > totalPages && total > 0) {
                        currentPage = totalPages;
                        loadMasterUsers();
                        return;
                    }

                    updateStatistics();
                    renderRoleDistribution(res.roleCounts || {});
                    renderMasterTable();
                    updateDeleteButtonState();
                    $('#selectAllUsers').prop('checked', false);

                })
                .fail(function(xhr) {
                    if (requestId !== usersRequestId) return;
                    console.error("Users API Error:", xhr.responseText);
                    showTableError("Failed to load user records.");
                });

        }

        function applyFilters() {
            // Typing in the search box waits a moment before asking the server.
            clearTimeout(searchTimer);
            searchTimer = setTimeout(function() {
                currentPage = 1;
                loadMasterUsers();
            }, 300);
        }

        function resetFilters() {
            resetFilterControls();
            currentPage = 1;
            loadMasterUsers();
        }

        function resetFilterControls() {
            $('#filterRole').val('');
            $('#filterStatus').val('');
            $('#filterDate').val('');
            $('#searchQuery').val('');
        }

        function isDateInRange(dateString, rangeType) {

            try {

                const userDate = new Date(dateString);
                const today = new Date();
                today.setHours(0, 0, 0, 0);

                const daysDiff = Math.floor((today - userDate) / (1000 * 60 * 60 * 24));

                switch (rangeType) {
                    case 'today':
                        return daysDiff === 0;
                    case '7days':
                        return daysDiff >= 0 && daysDiff < 7;
                    case '30days':
                        return daysDiff >= 0 && daysDiff < 30;
                    default:
                        return true;
                }

            } catch (e) {
                return false;
            }

        }

        function updateStatistics() {

            const selected = $('.user-checkbox:checked').length;

            $('#statTotalUsers').text(usersStats.total);
            $('#statActiveUsers').text(usersStats.active);
            $('#statInactiveUsers').text(usersStats.inactive);
            $('#statSelectedUsers').text(selected);

        }


        function renderRoleDistribution(roleCounts) {

            const container = $('#roleDistribution');
            container.empty();

            if (!roleCounts || Object.keys(roleCounts).length === 0) {
                container.html('<span class="text-muted small">No role information available.</span>');
                return;
            }

            Object.entries(roleCounts)
                .sort((a, b) => b[1] - a[1])
                .forEach(([role, count]) => {

                    const badge = `
                                <div class="badge bg-light border border-secondary border-opacity-25 text-dark px-3 py-2">
                                    <span class="small">${escapeHtml(role)}</span>
                                    <span class="badge bg-primary rounded-pill ms-2">${count}</span>
                                </div>
                            `;

                    container.append(badge);

                });

        }

        function renderMasterTable() {

            const tbody = $('#masterUserTableBody');

            const totalRecords = filteredMasterUsers.length;
            const totalPages = Math.ceil(totalRecords / pageSize) || 1;

            if (currentPage > totalPages) {
                currentPage = totalPages;
            }

            if (currentPage < 1) {
                currentPage = 1;
            }

            const startIndex = (currentPage - 1) * pageSize;
            const endIndex = Math.min(startIndex + pageSize, totalRecords);

            const pageData = filteredMasterUsers.slice(startIndex, endIndex);

            const showingFrom = totalRecords === 0 ? 0 : startIndex + 1;
            const showingTo = endIndex;

            $('#recordInfo').text(
                `Showing ${showingFrom} to ${showingTo} of ${totalRecords} users`
            );

            $('#pageInfo').text(
                `Page ${currentPage} of ${totalPages}`
            );

            $('#paginationInfo').text(
                `Showing ${showingFrom} to ${showingTo} of ${totalRecords} users`
            );

            if (pageData.length === 0) {

                tbody.html(`
                    <tr>
                        <td colspan="10" class="text-center py-5">

                            <i class="bi bi-inbox fs-2 text-muted"></i>

                            <p class="text-muted small mt-2 mb-3">
                                No users found matching your filters.
                            </p>

                            <button type="button"
                                    class="btn btn-sm btn-outline-success rounded-2"
                                    onclick="resetFilters()">

                                <i class="bi bi-arrow-counterclockwise me-1"></i>
                                Reset Filters

                            </button>

                        </td>
                    </tr>
                `);

                $('#pagination').empty();

                return;
            }


            let html = '';

            pageData.forEach(function(u, index) {

                const actualIndex = startIndex + index;


                const isActive =
                    u.isActive === true ||
                    u.isActive === 1 ||
                    String(u.isActive).toLowerCase() === 'true';

                const statusBadge = isActive

                    ? `
                        <span class="badge bg-success-subtle text-success border border-success border-opacity-50">
                            <i class="bi bi-check-circle me-1"></i>
                            Active
                        </span>
                      `

                    : `
                        <span class="badge bg-danger-subtle text-danger border border-danger border-opacity-50">
                            <i class="bi bi-x-circle me-1"></i>
                            Inactive
                        </span>
                      `;

                let passwordHtml = `
                    <span class="text-muted small">-</span>
                `;

                if (
                    u.password !== null &&
                    u.password !== undefined &&
                    String(u.password).trim() !== '' &&
                    String(u.password) !== '-'
                ) {

                    const password = String(u.password);

                    passwordHtml = `
                        <div class="d-flex align-items-center gap-1">

                            <input type="password"
                                   class="form-control form-control-sm bg-light border"
                                   style="
                                       width: 130px;
                                       font-size: 11px;
                                       height: 30px;
                                   "
                                   id="pwd_${actualIndex}"
                                   value="${escapeHtml(password)}"
                                   readonly />

                            <button type="button"
                                    class="btn btn-sm btn-outline-secondary p-1"
                                    style="
                                        width: 30px;
                                        height: 30px;
                                    "
                                    onclick="togglePassword(${actualIndex})"
                                    title="Show / Hide Password">

                                <i class="bi bi-eye-slash"
                                   id="eye_${actualIndex}"
                                   style="font-size: 12px;">
                                </i>

                            </button>

                        </div>
                    `;
                }

                const fullName = u.fullName || 'U';

                const initials = fullName
                    .split(' ')
                    .filter(n => n && n.trim() !== '')
                    .map(n => n[0])
                    .join('')
                    .substring(0, 2)
                    .toUpperCase();

                html += `
                    <tr>

                        <!-- Checkbox -->
                        <td class="text-center ps-3">

                            <input type="checkbox"
                                   class="form-check-input user-checkbox shadow-none"
                                   value="${escapeHtml(u.identityId || '')}"
                                   onchange="updateDeleteButtonState()">

                        </td>


                        <!-- Serial -->
                        <td class="fw-bold text-secondary small">
                            ${actualIndex + 1}
                        </td>


                        <!-- User Info -->
                        <td>

                            <div class="d-flex align-items-center gap-2">

                                <!-- Avatar -->
                                <div class="bg-primary-subtle text-primary rounded-2 p-2"
                                     style="
                                         width: 36px;
                                         height: 36px;
                                         display: flex;
                                         align-items: center;
                                         justify-content: center;
                                         font-size: 11px;
                                         font-weight: bold;
                                     ">

                                    ${escapeHtml(initials)}

                                </div>


                                <!-- Details -->
                                <div>

                                    <div class="fw-bold text-dark small">
                                        ${escapeHtml(u.fullName || 'N/A')}
                                    </div>

                                    <small class="text-muted">
                                        ${escapeHtml(u.username || '-')}
                                    </small>

                                    <div class="text-muted small d-none d-lg-block">
                                        ${escapeHtml(u.email || '-')}
                                    </div>

                                </div>

                            </div>

                        </td>


                        <!-- User Code -->
                        <td class="small text-muted d-none d-lg-table-cell">

                            ${escapeHtml(u.userCode || '-')}

                        </td>


                        <!-- PASSWORD -->
                        <td class="d-none d-lg-table-cell">

                            ${passwordHtml}

                        </td>


                        <!-- Role -->
                        <td>

                            <span class="badge bg-primary-subtle text-primary px-2 py-1"
                                  style="font-size: 10px;">

                                ${escapeHtml(u.portalName || 'User')}

                            </span>

                        </td>


                        <!-- Mobile -->
                        <td class="small d-none d-md-table-cell">

                            ${escapeHtml(u.phoneNumber || '-')}

                        </td>


                        <!-- Registered Date -->
                        <td class="small text-muted d-none d-xl-table-cell">

                            ${escapeHtml(u.createdDate || '-')}

                        </td>


                        <!-- Status -->
                        <td class="text-center">

                            ${statusBadge}

                        </td>


                        <!-- Actions -->
                        <td class="text-end pe-3">

                            <div class="d-flex justify-content-end gap-2">

                                <!-- View -->
                                <button type="button"
                                        class="btn btn-sm btn-outline-info rounded-2 p-1"
                                        style="
                                            width: 32px;
                                            height: 32px;
                                        "
                                        onclick="viewUserDetailsByIndex(${actualIndex})"
                                        title="View Details">

                                    <i class="bi bi-eye"
                                       style="font-size: 12px;">
                                    </i>

                                </button>


                                <!-- Edit Role -->
                                <button type="button"
                                        class="btn btn-sm btn-outline-primary rounded-2 p-1"
                                        style="
                                            width: 32px;
                                            height: 32px;
                                        "
                                        onclick="openEditRoleModal(${actualIndex})"
                                        title="Edit Role">

                                    <i class="bi bi-shield"
                                       style="font-size: 12px;">
                                    </i>

                                </button>


                                <!-- Delete -->
                                <button type="button"
                                        class="btn btn-sm btn-outline-danger rounded-2 p-1"
                                        style="
                                            width: 32px;
                                            height: 32px;
                                        "
                                        onclick="deleteUserByIndex(${actualIndex})"
                                        title="Delete User">

                                    <i class="bi bi-trash3"
                                       style="font-size: 12px;">
                                    </i>

                                </button>

                            </div>

                        </td>

                    </tr>
                `;
            });


            tbody.html(html);

            renderPagination(totalPages);

            updateDeleteButtonState();
        }

        function renderPagination(totalPages) {

            const paginationContainer = $('#pagination');
            paginationContainer.empty();

            if (totalPages <= 1) {
                return;
            }

            const prevDisabled = currentPage === 1 ? 'disabled' : '';
            paginationContainer.append(`
                        <li class="page-item ${prevDisabled}">
                            <button class="page-link" type="button" onclick="changePage(${currentPage - 1})">
                                <i class="bi bi-chevron-left"></i>
                            </button>
                        </li>
                    `);

            let pages = [];

            if (totalPages <= 7) {
                for (let i = 1; i <= totalPages; i++) {
                    pages.push(i);
                }
            } else {
                pages.push(1);

                if (currentPage > 4) {
                    pages.push('...');
                }

                const start = Math.max(2, currentPage - 2);
                const end = Math.min(totalPages - 1, currentPage + 2);

                for (let i = start; i <= end; i++) {
                    pages.push(i);
                }

                if (currentPage < totalPages - 3) {
                    pages.push('...');
                }

                pages.push(totalPages);
            }

            pages.forEach(function(page) {

                if (page === '...') {
                    paginationContainer.append(`
                                <li class="page-item disabled">
                                    <span class="page-link">...</span>
                                </li>
                            `);
                } else {
                    const active = page === currentPage ? 'active' : '';
                    paginationContainer.append(`
                                <li class="page-item ${active}">
                                    <button class="page-link" type="button" onclick="changePage(${page})">${page}</button>
                                </li>
                            `);
                }

            });

            // Next
            const nextDisabled = currentPage === totalPages ? 'disabled' : '';
            paginationContainer.append(`
                        <li class="page-item ${nextDisabled}">
                            <button class="page-link" type="button" onclick="changePage(${currentPage + 1})">
                                <i class="bi bi-chevron-right"></i>
                            </button>
                        </li>
                    `);

        }


        function changePage(page) {

            const totalPages = Math.ceil(filteredMasterUsers.length / pageSize);

            if (page < 1 || page > totalPages) {
                return;
            }

            currentPage = page;
            loadMasterUsers();

            const table = document.getElementById('masterUserTable');
            if (table) {
                table.scrollIntoView({ behavior: 'smooth', block: 'start' });
            }

        }


        // =========================================================
        // SELECTION & BATCH ACTIONS
        // =========================================================

        function updateDeleteButtonState() {

            const selectedCount = $('.user-checkbox:checked').length;
            const batchBar = $('#batchActionsBar');
            const btn = $('#btnDeleteSelected');

            if (selectedCount > 0) {
                batchBar.removeClass('d-none');
                btn.prop('disabled', false);
            } else {
                batchBar.addClass('d-none');
                btn.prop('disabled', true);
            }

            $('#selectedUsersText').text(`${selectedCount} user${selectedCount !== 1 ? 's' : ''} selected`);

            if (selectedCount > 0) {
                btn.html(`<i class="bi bi-trash3-fill me-1"></i>Delete Selected (${selectedCount})`);
            } else {
                btn.html(`<i class="bi bi-trash3-fill me-1"></i>Delete Selected`);
            }

            // Update select all state
            const totalCheckboxes = $('.user-checkbox').length;
            $('#selectAllUsers').prop('checked', totalCheckboxes > 0 && selectedCount === totalCheckboxes);

            // Update statistics
            updateStatistics();

        }


        function toggleSelectAll() {
            const isChecked = $('#selectAllUsers').is(':checked');
            $('.user-checkbox').prop('checked', isChecked);
            updateDeleteButtonState();
        }


        // =========================================================
        // USER DELETION
        // =========================================================

        function deleteUserByIndex(index) {

            const user = filteredMasterUsers[index];

            if (!user || !user.identityId) {
                showUserMessage('error', 'Invalid User', 'Unable to identify selected user.');
                return;
            }

            const userName = user.fullName || user.username || user.userCode || 'this user';

            Swal.fire({
                icon: 'warning',
                title: 'Deactivate User?',
                html: `<p class="small m-0">This will deactivate <strong>${escapeHtml(userName)}</strong> and lock their account.</p>`,
                confirmButtonText: 'Yes, Deactivate',
                cancelButtonText: 'Cancel',
                confirmButtonColor: '#dc3545',
                showCancelButton: true,
                allowOutsideClick: false,
                allowEscapeKey: false
            }).then((result) => {

                if (!result.isConfirmed) {
                    return;
                }

                const $buttons = $('#masterUserTableBody').find('button');
                $buttons.prop('disabled', true);

                $.ajax({
                    url: `/api/usermanagement/delete/${encodeURIComponent(user.identityId)}`,
                    type: 'DELETE',
                    dataType: 'json',
                    success: function(res) {

                        if (res.success) {
                            showUserMessage('success', 'User Deactivated', res.message || 'User has been deactivated successfully.');
                            loadMasterUsers();
                        } else {
                            showUserMessage('error', 'Deactivation Failed', res.message || 'Unable to deactivate user.');
                        }

                    },
                    error: function(xhr) {

                        const message = xhr.responseJSON?.message || xhr.responseJSON?.error || 'Error deactivating user.';
                        showUserMessage('error', 'Deactivation Failed', message);

                    },
                    complete: function() {
                        $buttons.prop('disabled', false);
                    }
                });

            });

        }


        function deleteSelectedUsers() {

            const selectedIds = $('.user-checkbox:checked')
                .map(function() { return $(this).val(); })
                .get()
                .filter(x => x && String(x).trim() !== '');

            if (selectedIds.length === 0) {
                showUserMessage('warning', 'No Users Selected', 'Please select at least one user.');
                return;
            }

            Swal.fire({
                icon: 'warning',
                title: 'Deactivate Selected Users?',
                html: `<p class="small m-0">This will deactivate <strong>${selectedIds.length}</strong> user(s) and lock their accounts.</p>`,
                confirmButtonText: 'Yes, Deactivate All',
                cancelButtonText: 'Cancel',
                confirmButtonColor: '#dc3545',
                showCancelButton: true,
                allowOutsideClick: false,
                allowEscapeKey: false
            }).then((result) => {

                if (!result.isConfirmed) {
                    return;
                }

                const $btn = $('#btnDeleteSelected');
                const originalHtml = $btn.html();

                $btn.prop('disabled', true).html(`
                            <span class="spinner-border spinner-border-sm me-1"></span>
                            Deactivating...
                        `);

                $.ajax({
                    url: '/api/usermanagement/delete-batch',
                    type: 'POST',
                    contentType: 'application/json',
                    dataType: 'json',
                    data: JSON.stringify({ identityIds: selectedIds }),
                    success: function(res) {

                        if (res.success) {
                            showUserMessage('success', 'Users Deactivated', res.message || `${selectedIds.length} user(s) deactivated successfully.`);
                            $('#selectAllUsers').prop('checked', false);
                            loadMasterUsers();
                        } else {
                            showUserMessage('error', 'Deactivation Failed', res.message || 'Unable to deactivate selected users.');
                        }

                    },
                    error: function(xhr) {

                        const message = xhr.responseJSON?.message || xhr.responseJSON?.error || 'Error deactivating users.';
                        showUserMessage('error', 'Deactivation Failed', message);

                    },
                    complete: function() {
                        $btn.prop('disabled', false).html(originalHtml);
                        updateDeleteButtonState();
                    }
                });

            });

        }


        // =========================================================
        // VIEW DETAILS MODAL
        // =========================================================

        function viewUserDetailsByIndex(index) {

            const user = filteredMasterUsers[index];

            if (!user) {
                return;
            }

            $('#detCode').text(user.userCode || '-');
            $('#detName').text(user.fullName || '-');
            $('#detUsername').text(user.username || '-');
            $('#detEmail').text(user.email || '-');
            $('#detMobile').text(user.phoneNumber || '-');
            $('#detAddress').text(user.address || '-');
            $('#detDate').text(user.createdDate || '-');

            $('#detPortal').html(`<span class="badge bg-primary">${escapeHtml(user.portalName || '-')}</span>`);

            const isActive = user.isActive === true || user.isActive === 1 || String(user.isActive).toLowerCase() === 'true';
            if (isActive) {
                $('#detStatus').html(`<span class="badge bg-success"><i class="bi bi-check-circle me-1"></i>Active</span>`);
            } else {
                $('#detStatus').html(`<span class="badge bg-danger"><i class="bi bi-x-circle me-1"></i>Inactive</span>`);
            }

            const modalElement = document.getElementById('viewDetailModal');
            if (modalElement && typeof bootstrap !== 'undefined') {
                const modal = bootstrap.Modal.getOrCreateInstance(modalElement);
                modal.show();
            }

        }


        // =========================================================
        // EDIT ROLE MODAL
        // =========================================================

        function openEditRoleModal(index) {

            const user = filteredMasterUsers[index];

            if (!user) {
                return;
            }

            $('#editIdentityId').val(user.identityId);
            $('#editUserNameDisplay').val(`${user.fullName || '-'} (${user.username || '-'})`);

            if (user.portalName) {
                const firstRole = user.portalName.split(',')[0].trim();
                $('#modalRoleSelect').val(firstRole);
            } else {
                $('#modalRoleSelect').val('');
            }

            const modalElement = document.getElementById('editRoleModal');
            if (modalElement && typeof bootstrap !== 'undefined') {
                const modal = bootstrap.Modal.getOrCreateInstance(modalElement);
                modal.show();
            }

        }


        function submitEditRole(event) {

            event.preventDefault();

            const identityId = $('#editIdentityId').val();
            const newRole = $('#modalRoleSelect').val();

            if (!identityId || !newRole) {
                showUserMessage('warning', 'Invalid Selection', 'Please select a valid role.');
                return;
            }

            const $btn = $(event.target).find('button[type="submit"]');
            const originalText = $btn.html();

            $btn.prop('disabled', true).html(`
                        <span class="spinner-border spinner-border-sm me-1"></span>
                        Updating...
                    `);

            $.ajax({
                url: '/api/usermanagement/update-role',
                type: 'POST',
                contentType: 'application/json',
                dataType: 'json',
                data: JSON.stringify({
                    identityId: identityId,
                    roleName: newRole
                }),
                success: function(res) {

                    if (res.success) {

                        const modalElement = document.getElementById('editRoleModal');
                        if (modalElement && typeof bootstrap !== 'undefined') {
                            const modal = bootstrap.Modal.getInstance(modalElement);
                            if (modal) modal.hide();
                        }

                        showUserMessage('success', 'Role Updated', res.message || 'User role updated successfully.');
                        loadMasterUsers();

                    } else {

                        showUserMessage('error', 'Update Failed', res.message || 'Failed to update user role.');

                    }

                },
                error: function(xhr) {

                    const message = xhr.responseJSON?.message || 'Error updating user role.';
                    showUserMessage('error', 'Update Failed', message);

                },
                complete: function() {
                    $btn.prop('disabled', false).html(originalText);
                }
            });

        }


        // =========================================================
        // PASSWORD TOGGLE
        // =========================================================

        function togglePassword(index) {

            const input = document.getElementById(`pwd_${index}`);
            const eye = document.getElementById(`eye_${index}`);

            if (!input || !eye) {
                return;
            }

            if (input.type === 'password') {
                input.type = 'text';
                eye.classList.remove('bi-eye-slash');
                eye.classList.add('bi-eye');
            } else {
                input.type = 'password';
                eye.classList.remove('bi-eye');
                eye.classList.add('bi-eye-slash');
            }

        }


        // =========================================================
        // UI HELPERS
        // =========================================================

        function showTableLoading(message) {

            const tbody = $('#masterUserTableBody');
            tbody.html(`
                        <tr>
                            <td colspan="9" class="text-center py-5 text-muted">
                                <div class="spinner-border spinner-border-sm text-success mb-2" role="status"></div>
                                <p class="small m-0">${escapeHtml(message)}</p>
                            </td>
                        </tr>
                    `);

        }


        function showTableError(message) {

            const tbody = $('#masterUserTableBody');
            tbody.html(`
                        <tr>
                            <td colspan="9" class="text-center py-5">
                                <i class="bi bi-exclamation-triangle fs-2 text-danger"></i>
                                <p class="text-danger small mt-2 mb-3">${escapeHtml(message)}</p>
                                <button type="button" class="btn btn-sm btn-outline-success rounded-2" onclick="loadMasterUsers()">
                                    <i class="bi bi-arrow-clockwise me-1"></i>
                                    Retry
                                </button>
                            </td>
                        </tr>
                    `);

            $('#pagination').empty();

        }


        function showUserMessage(type, title, message) {

            if (typeof Swal !== 'undefined') {

                Swal.fire({
                    icon: type,
                    title: title,
                    html: message,
                    confirmButtonText: 'OK',
                    confirmButtonColor: '#198754',
                    allowOutsideClick: true,
                    allowEscapeKey: true
                });

            } else {

                alert(`${title}\n\n${message}`);

            }

        }


        function escapeHtml(value) {

            if (value === null || value === undefined) {
                return '';
            }

            return String(value)
                .replace(/&/g, '&amp;')
                .replace(/</g, '&lt;')
                .replace(/>/g, '&gt;')
                .replace(/"/g, '&quot;')
                .replace(/'/g, '&#039;');

        }

    </script>

}