        function filterTabulator(type, query) {
            let table = type === 'student' ? studentTable : type === 'teacher' ? teacherTable : volunteerTable;
            if (table) {
                if (!query) {
                    table.clearFilter();
                } else {
                    table.setFilter(function(data) {
                        return Object.values(data).some(val => val !== null && val !== undefined && String(val).toLowerCase().includes(query.toLowerCase()));
                    });
                }
            }
        }

        function exportTable(type, format) {
            let table = type === 'student' ? studentTable : type === 'teacher' ? teacherTable : volunteerTable;
            if (table) {
                if (format === 'xlsx') {
                    table.download("xlsx", "DirectoryReport.xlsx", { sheetName: "Data" });
                }
            }
        }

        function ChangeStandard(studentID, studentName, currentStd, currentDiv) {
            $("#hd_StudentID").val(studentID);
            $("#lbl_Student_Name").text(studentName);
            $("#dll_student_standard").val(currentStd);
            $("#dv_division").val(currentDiv);
            var standardModal = new bootstrap.Modal(document.getElementById('Dv_StandardModal'));
            standardModal.show();
        }

        function setStandard() {
            var StudentId = parseInt($("#hd_StudentID").val());
            var Standard = $("#dll_student_standard").val();
            var Division = $("#dv_division").val();

            if (StudentId > 0 && Standard) {
                $.ajax({
                    type: "GET",
                    url: '/api/school/ChangeStandard',
                    dataType: 'json',
                    data: { StudentId: StudentId, Standard: Standard, Division: Division },
                    success: function(response) {
                        if (response.success) {
                            var modalEl = document.getElementById('Dv_StandardModal');
                            var modal = bootstrap.Modal.getInstance(modalEl);
                            modal.hide();
                            Swal.fire("Assigned!", response.message, "success").then(() => { location.reload(); });
                        } else {
                            Swal.fire("Denied", response.message, "error");
                        }
                    }
                });
            } else {
                Swal.fire("Info", "Please select a grade and division before continuing.", "warning");
            }
        }

        function DeleteStudentRosterRow(StudentId) {
            Swal.fire({
                title: 'Unmap Student?',
                text: "This removes the association between this student and your institution mappings.",
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#dc3545',
                cancelButtonColor: '#6c757d',
                confirmButtonText: 'Yes, Unmap Link'
            }).then((result) => {
                if (result.isConfirmed) {
                    $.ajax({
                        type: "GET",
                        url: '/api/school/UnmapStudent',
                        dataType: 'json',
                        data: { StudentId: StudentId },
                        success: function(response) {
                            if (response.success) {
                                Swal.fire("Removed!", response.message, "success").then(() => { location.reload(); });
                            } else {
                                Swal.fire("Info", response.message, "error");
                            }
                        }
                    });
                }
            });
        }

        $(document).on('click', '.SendSMSINS', function() {
            var targetBtn = $(this);
            Swal.fire({
                title: 'Send Details?',
                text: "Are you sure you want to resend login credentials to this phone number?",
                icon: 'question',
                showCancelButton: true,
                confirmButtonColor: '#6f42c1',
                cancelButtonColor: '#6c757d',
                confirmButtonText: 'Yes, Send SMS'
            }).then((result) => {
                if (result.isConfirmed) {
                    var ID = targetBtn.attr("data-id");
                    $.post("/api/school/SendPasswordUser", { ID: ID }, function(data) {
                        if (data == '1') {
                            Swal.fire('Success', 'Message Sent Successfully!!', 'success');
                        } else {
                            Swal.fire('Info', 'Unable to send message. Please try again.', 'info');
                        }
                    });
                }
            });
        });
