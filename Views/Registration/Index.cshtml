@{
    ViewData["Title"] = "School Registration & Management Hub";
    Layout = "~/Views/Shared/Layouts/_TeacherLayout.cshtml";
}

<link href="https://unpkg.com/tabulator-tables@6.2.5/dist/css/tabulator_bootstrap5.min.css" rel="stylesheet">
<link href="~/Content/MultiSelect/bootstrap-multiselect.css" rel="stylesheet" />

<style>
    /* Container Background */
    .glass-nav-pills {
        background-color: rgba(240, 242, 245, 0.6);
        backdrop-filter: blur(12px);
        -webkit-backdrop-filter: blur(12px);
        border: 1px solid rgba(255, 255, 255, 0.4);
    }

        /* Inactive Tab Styles */
        .glass-nav-pills .nav-link {
            color: #6c757d;
            transition: all 0.4s cubic-bezier(0.165, 0.84, 0.44, 1);
            border: 1px solid transparent;
            padding: 0.6rem 1rem;
        }

            /* Hover Effect for Inactive Tabs */
            .glass-nav-pills .nav-link:hover {
                color: #495057;
                background-color: rgba(255, 255, 255, 0.5);
            }

            /* =========================================
            ACTIVE TAB: THE GLASSMORPHISM EFFECT
            ========================================= */
            .glass-nav-pills .nav-link.active {
                background: linear-gradient(135deg, rgba(111, 66, 193, 0.1), rgba(13, 110, 253, 0.05)) !important;
                backdrop-filter: blur(10px) saturate(150%);
                -webkit-backdrop-filter: blur(10px) saturate(150%);
                color: #6f42c1 !important;
                border: 1px solid rgba(111, 66, 193, 0.25);
                box-shadow: 0 4px 15px rgba(111, 66, 193, 0.12), inset 0 1px 1px rgba(255, 255, 255, 0.6);
                transform: translateY(-1px);
            }

    /* Tabulator Customizations to Match Bootstrap */
    /* ============================================
       TABULATOR DIRECTORY TABLE
       ============================================ */

    .directory-table-wrapper {
        width: 100%;
        overflow-x: auto;
        overflow-y: hidden;
        -webkit-overflow-scrolling: touch;
        border-radius: 10px;
    }

        /* Keep table wider than mobile screen when required */
        .directory-table-wrapper .tabulator {
            width: max-content !important;
            min-width: 100%;
            border: 1px solid #dee2e6 !important;
            border-radius: 10px;
            overflow: hidden;
            font-size: 14px;
        }

            /* Header */
            .directory-table-wrapper .tabulator .tabulator-header {
                background: #f8f9fa !important;
                font-weight: 700;
                border-bottom: 1px solid #dee2e6;
            }

            /* Header cells */
            .directory-table-wrapper .tabulator .tabulator-col {
                min-width: 120px;
                background: #f8f9fa !important;
            }

            /* Header title */
            .directory-table-wrapper .tabulator .tabulator-col-title {
                white-space: nowrap;
                overflow: visible;
                text-overflow: clip;
                font-weight: 700;
            }

            /* Header filter */
            .directory-table-wrapper .tabulator .tabulator-header-filter {
                padding: 5px 6px;
            }

                .directory-table-wrapper .tabulator .tabulator-header-filter input,
                .directory-table-wrapper .tabulator .tabulator-header-filter select {
                    width: 100%;
                    min-width: 90px;
                    height: 32px;
                    border: 1px solid #ced4da;
                    border-radius: 6px;
                    padding: 4px 7px;
                    font-size: 12px;
                    outline: none;
                }

                    .directory-table-wrapper .tabulator .tabulator-header-filter input:focus,
                    .directory-table-wrapper .tabulator .tabulator-header-filter select:focus {
                        border-color: #6f42c1;
                        box-shadow: 0 0 0 2px rgba(111, 66, 193, 0.10);
                    }

            /* Table data */
            .directory-table-wrapper .tabulator .tabulator-cell {
                white-space: nowrap;
                overflow: hidden;
                text-overflow: ellipsis;
            }

            /* Do not allow header to become too small */
            .directory-table-wrapper .tabulator .tabulator-col[tabulator-field] {
                min-width: 130px;
            }

            /* Sorting indicator */
            .directory-table-wrapper .tabulator .tabulator-col.tabulator-sortable:hover {
                background-color: #f0ebfa !important;
            }

    /* Mobile */
    @@media (max-width: 768px) {

        .directory-table-wrapper {
            margin-left: 0;
            margin-right: 0;
        }

            .directory-table-wrapper .tabulator {
                min-width: 1100px;
                font-size: 13px;
            }

                .directory-table-wrapper .tabulator .tabulator-col {
                    min-width: 130px;
                }

                .directory-table-wrapper .tabulator .tabulator-cell {
                    padding: 8px 10px;
                }

                .directory-table-wrapper .tabulator .tabulator-header-filter input {
                    min-width: 110px;
                }
    }

    .action-icon-btn {
        padding: 4px 8px;
        margin: 0 2px;
        color: #6c757d;
        transition: color 0.2s ease;
    }

        .action-icon-btn:hover {
            color: #6f42c1;
        }

    .cur-pointer {
        cursor: pointer;
    }

    .multiselect-native-select .btn-group {
        width: 100% !important;
    }

    .multiselect-container {
        width: 100% !important;
        max-height: 250px;
        overflow-y: auto;
    }
    /* Ensure proper Bootstrap modal backdrop overlay layer */
    .modal-backdrop {
        background-color: rgba(0, 0, 0, 0.5) !important;
    }

    /* Fix Bootstrap Multiselect dropdown inside Modals */
    .modal .mult-select-container, .modal .multiselect-container {
        z-index: 1056 !important;
        position: absolute !important;
    }

    .modal-content {
        background-clip: padding-box;
        background-color: #fff;
        border: 0 solid rgba(0,0,0,.2);
        border-radius: 1rem;
        outline: 0;
    }
    /* Force multiselect container dropdown to display above modal elements */
    .modal .multiselect-container.dropdown-menu {
        position: absolute !important;
        inset: auto auto 0 0 !important;
        transform: translate(0px, 38px) !important;
        width: 100% !important;
        z-index: 1060 !important;
    }

    /* Ensure modal body does not clip absolute dropdown items */
    .modal-body {
        overflow: visible !important;


    .glass-nav-pills .nav-link.active {
        /* Soft semi-transparent theme color (Purple/Blue mix) */
        background: linear-gradient(135deg, rgba(111, 66, 193, 0.1), rgba(13, 110, 253, 0.05)) !important;
        
        /* Blur Effect */
        backdrop-filter: blur(10px) saturate(150%);
        -webkit-backdrop-filter: blur(10px) saturate(150%);
        
        /* Text Color & Soft Border */
        color: #6f42c1 !important; /* Elegant Purple Text */
        border: 1px solid rgba(111, 66, 193, 0.25);
        
        /* Floating Shadow */
        box-shadow: 0 4px 15px rgba(111, 66, 193, 0.12), inset 0 1px 1px rgba(255, 255, 255, 0.6);
        transform: translateY(-1px);

    }
</style>

<div class="container-fluid py-4">
    <div class="card border-0 shadow-sm rounded-4 bg-white p-4">
        <h4 class="fw-bold text-dark mb-4"><i class="bi bi-ui-checks-grid text-primary me-2"></i> School Management & Registration Hub</h4>

        <!-- 4 Tabs Navigation with Glassmorphism -->
        <ul class="nav nav-pills nav-fill gap-2 p-2 rounded-pill mb-4 glass-nav-pills shadow-sm" id="regHubTabs" role="tablist">
            <li class="nav-item">
                <button class="nav-link active rounded-pill fw-bold" id="student-tab" data-bs-toggle="tab" data-bs-target="#studentContent" type="button">
                    <i class="bi bi-mortarboard-fill me-2"></i> Students Directory
                </button>
            </li>
            <li class="nav-item">
                <button class="nav-link rounded-pill fw-bold" id="teacher-tab" data-bs-toggle="tab" data-bs-target="#teacherContent" type="button">
                    <i class="bi bi-people-fill me-2"></i> Teachers Directory
                </button>
            </li>
            <li class="nav-item">
                <button class="nav-link rounded-pill fw-bold" id="volunteer-tab" data-bs-toggle="tab" data-bs-target="#volunteerContent" type="button">
                    <i class="bi bi-shield-check me-2"></i> Volunteers Directory
                </button>
            </li>
            <li class="nav-item">
                <button class="nav-link rounded-pill fw-bold" id="bulk-tab" data-bs-toggle="tab" data-bs-target="#bulkContent" type="button">
                    <i class="bi bi-file-earmark-spreadsheet-fill me-2"></i> Bulk Upload & Reports
                </button>
            </li>
        </ul>

        <div class="tab-content" id="regHubTabsContent">

            <!-- TAB 1: STUDENTS LIST -->
            <div class="tab-pane fade show active" id="studentContent">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h5 class="fw-bold text-dark m-0">Enrolled Students</h5>
                    <div class="d-flex flex-column flex-sm-row gap-2">
                        <input type="text" id="studentSearchInput" class="form-control form-control-sm" placeholder="Search students..." onkeyup="filterTabulator('student', this.value)">
                        <button class="btn btn-success btn-sm" onclick="exportTable('student', 'xlsx')">
                            <i class="fas fa-file-excel me-1"></i> Export Excel
                        </button>
                        <button class="btn btn-primary btn-sm" data-bs-toggle="modal" data-bs-target="#modalAddStudent">
                            <i class="bi bi-person-plus-fill me-1"></i> Add New Student
                        </button>
                    </div>
                </div><div id="studentTableContainer">
                <div id="studentTableContainer"></div></div>
            </div>

            <!-- REASSIGN GRADE MODAL (STUDENT) -->
            <div class="modal fade" id="Dv_StandardModal" tabindex="-1" role="dialog" aria-hidden="true" data-bs-backdrop="static">
                <div class="modal-dialog modal-dialog-centered modal-sm">
                    <div class="modal-content border-0 shadow" style="border-radius:14px;">
                        <div class="modal-header border-0 pb-0">
                            <h5 class="modal-title font-weight-bold text-purple-brand"><i class="fas fa-graduation-cap me-2"></i>Reassign Grade</h5>
                            <button type="button" class="btn-close shadow-none" data-bs-dismiss="modal"></button>
                        </div>
                        <div class="modal-body text-center pt-2">
                            <h6 id="lbl_Student_Name" class="fw-bold text-secondary mb-3">Student Name</h6>
                            <input type="hidden" id="hd_StudentID" value="0" />

                            <div class="form-group text-start mb-3">
                                <label class="small fw-bold text-muted mb-1">Standard / Class *</label>
                                <select id="dll_student_standard" class="form-select form-select-md">
                                    <option value="" disabled selected>-- Select Standard --</option>
                                    @for (int i = 3; i <= 15; i++)
                                    {
                                        string suffix = (i == 1) ? "st" : (i == 2) ? "nd" : (i == 3) ? "rd" : "th";
                                        <option value="@(i)@suffix">@(i)@suffix</option>
                                    }
                                </select>
                            </div>
                            <div class="form-group text-start mb-4">
                                <label class="small fw-bold text-muted mb-1">Division / Section</label>
                                <input type="text" id="dv_division" class="form-control form-control-md" placeholder="e.g. A, B, Rose" maxlength="10">
                            </div>

                            <button class="btn btn-primary rounded-pill w-100 fw-bold py-2 bg-purple-brand border-0" onclick="setStandard()" id="btnSet" style="background-color: #6f42c1;">
                                Save Structural Assignment
                            </button>
                        </div>
                    </div>
                </div>
            </div>

            <!-- TAB 2: TEACHERS LIST -->
            <div class="tab-pane fade" id="teacherContent">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h5 class="fw-bold text-dark m-0">Active Teachers</h5>
                <div class="d-flex flex-column flex-sm-row gap-2">
                        <input type="text" id="teacherSearchInput" class="form-control form-control-sm" placeholder="Search teachers..." onkeyup="filterTabulator('teacher', this.value)">
                        <button class="btn btn-success btn-sm" onclick="exportTable('teacher', 'xlsx')">
                            <i class="fas fa-file-excel me-1"></i> Export Excel
                        </button>
                        <button class="btn btn-primary btn-sm" data-bs-toggle="modal" data-bs-target="#modalAddTeacher">
                            <i class="bi bi-person-plus-fill me-1"></i> Add New Teacher
                        </button>
                    </div>
                </div>
            <!-- Tabulator Container --><div class="directory-table-wrapper">
                <div id="teacherTableContainer"></div></div>
            </div>

            <!-- TAB 3: VOLUNTEERS LIST -->
            <div class="tab-pane fade" id="volunteerContent">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h5 class="fw-bold text-dark m-0">Assigned Volunteers</h5>
            <div class="d-flex flex-column flex-sm-row gap-2">
                        <input type="text" id="volunteerSearchInput" class="form-control form-control-sm" placeholder="Search volunteers..." onkeyup="filterTabulator('volunteer', this.value)">
                        <button class="btn btn-success btn-sm" onclick="exportTable('volunteer', 'xlsx')">
                            <i class="fas fa-file-excel me-1"></i> Export Excel
                        </button>
                        <button class="btn btn-primary btn-sm" data-bs-toggle="modal" data-bs-target="#modalAddVolunteer">
                            <i class="bi bi-person-plus-fill me-1"></i> Add New Volunteer
                        </button>
                    </div>
        </div><div class="directory-table-wrapper">
                <div id="volunteerTableContainer"></div></div>
            </div>

            <!-- TAB 4: BULK UPLOAD -->
            <div class="tab-pane fade" id="bulkContent">
                <div class="card border border-primary-subtle rounded-4 p-4 bg-light mb-4">
                    <h5 class="fw-bold text-primary mb-3"><i class="bi bi-file-earmark-arrow-up-fill me-2"></i> Bulk Registration</h5>
                    <form id="bulkUploadForm">
                        <div class="mb-3">
                            <label class="form-label small fw-bold">Select Upload Type</label>
                            <select id="bulkUploadType" class="form-select rounded-3 shadow-none" required>
                                <option value="Student">Students Bulk Upload</option>
                                <option value="Teacher">Teachers Bulk Upload</option>
                                <option value="Volunteer">Volunteer Bulk Upload</option>
                            </select>
                        </div>
                        <div class="mb-3">
                            <label class="form-label small fw-bold">Upload Excel Workbook</label>
                            <input type="file" id="bulkExcelFile" class="form-control rounded-3 shadow-none" accept=".xlsx, .xls" required>
                        </div>
                        <div class="border border-warning rounded-4 p-3 bg-white mb-3">
                            <div class="text-warning fw-bold mb-1"><i class="bi bi-exclamation-triangle-fill me-1"></i> Format Compliance</div>
                            <p class="text-muted small mb-2">Ensure to use Sheet1 structure columns only. Before you upload your data, please ensure every row matches your school's required template.</p>
                            <button type="button" id="downloadTemplateBtn" class="btn btn-outline-dark btn-sm rounded-pill px-3 fw-bold">
                                <i class="bi bi-download me-1"></i> Download Template Blueprint
                            </button>
                        </div>
                        <button type="submit" class="btn btn-purple btn-sm rounded-pill px-4 fw-bold text-white shadow-sm" style="background-color: #6f42c1;">
                            <i class="bi bi-upload me-1"></i> UPLOAD REGISTRATION EXCEL
                        </button>
                    </form>
                </div>
                <h5 class="fw-bold text-dark mb-3">Upload History</h5>
                <div class="table-responsive">
                    <table class="table table-hover align-middle small border" id="logsTable">
                        <thead class="table-light">
                            <tr><th>Type</th><th>File Name</th><th>Status</th><th>Date</th><th>Action</th></tr>
                        </thead>
                        <tbody></tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- ================= MODALS ================= -->

<!-- ASSIGN STANDARD MODAL (TEACHER) -->
<div class="modal fade" id="assignStandardList" tabindex="-1" aria-hidden="true" data-bs-backdrop="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg" style="border-radius: 16px; background-color: #ffffff;">
            <div class="modal-header border-0 pb-0">
                <h4 class="modal-title font-weight-bold" style="color:#6f42c1;"><i class="fas fa-tags me-2"></i>Map Class Allocations</h4>
                <button type="button" class="btn-close shadow-none" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body py-3">
                <input type="hidden" id="teacherId" value="0" />

                <div class="bg-light rounded-3 p-3 mb-4 border">
                    <span class="small text-muted d-block fw-bold text-uppercase tracking-wider">Selected Faculty Member</span>
                    <h4 class="fw-bold text-dark mb-0" id="teacherName">Teacher Name</h4>
                </div>

                <div class="form-group">
                    <label class="fw-bold text-secondary mb-2" for="dll_Standard">Assigned Grades / Standards</label>
                    <div class="d-flex align-items-center gap-2">
                        <div class="w-100 position-relative">
                            <select id="dll_Standard" class="form-control" multiple="multiple"></select>
                        </div>
                        <button type="button" class="btn btn-outline-danger btn-sm ms-2 px-3 rounded-pill fw-bold" id="clearStandards" style="white-space:nowrap;">
                            <i class="fas fa-undo me-1"></i> Clear
                        </button>
                    </div>
                    <small class="form-text text-muted mt-1">Select all standards or subsections this teacher is authorized to access.</small>
                </div>
            </div>
            <div class="modal-footer border-0 pt-0">
                <button type="button" class="btn btn-light rounded-pill px-4" data-bs-dismiss="modal">Cancel</button>
                <button type="button" onclick="fnSubmitStandardToTeacher()" class="btn btn-primary border-0 rounded-pill px-4 fw-bold text-white" style="background-color:#6f42c1;">
                    Save Changes
                </button>
            </div>
        </div>
    </div>
</div>
<!-- ADD STUDENT MODAL -->
<div class="modal fade" id="modalAddStudent" tabindex="-1">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content rounded-4 border-0 shadow-lg p-3">
            <div class="modal-header border-bottom-0 pb-0">
                <h5 class="fw-bold text-primary"><i class="bi bi-mortarboard-fill me-2"></i> Register New Student</h5>
                <button type="button" class="btn-close shadow-none" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <form id="frmAddStudent">
                    <input type="hidden" name="portalId" value="3" />
                    <input type="hidden" name="role" value="WJ_Students" />
                    <div class="row g-3">
                        <div class="col-md-6"><label class="small fw-bold">First Name</label><input type="text" name="firstName" class="form-control" required></div>
                        <div class="col-md-6"><label class="small fw-bold">Last Name</label><input type="text" name="lastName" class="form-control" required></div>
                        <div class="col-md-6"><label class="small fw-bold">Guardian Mobile (Username)</label><input type="text" name="mobileNo" class="form-control" maxlength="10" required></div>
                        <div class="col-md-6"><label class="small fw-bold">Guardian Email</label><input type="email" name="emailID" class="form-control" required></div>
                        <div class="col-md-6"><label class="small fw-bold">Standard</label><select name="standard" id="ddlInternalStandard" class="form-select" required></select></div>
                        <div class="col-md-6"><label class="small fw-bold">Division</label><input type="text" name="division" class="form-control" required></div>
                        <div class="col-md-12"><label class="small fw-bold">Guardian Full Name</label><input type="text" name="guardianName" class="form-control" required></div>
                    </div>
                    <button type="submit" class="btn btn-primary w-100 rounded-pill mt-4 fw-bold">Submit Student</button>
                </form>
            </div>
        </div>
    </div>
</div>

<!-- ADD TEACHER MODAL -->
<div class="modal fade" id="modalAddTeacher" tabindex="-1">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content rounded-4 border-0 shadow-lg p-3">
            <div class="modal-header border-bottom-0 pb-0">
                <h5 class="fw-bold text-success"><i class="bi bi-people-fill me-2"></i> Register New Teacher</h5>
                <button type="button" class="btn-close shadow-none" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <form id="frmAddTeacher">
                    <input type="hidden" name="portalId" value="2" />
                    <input type="hidden" name="role" value="WJ_Teacher" />
                    <div class="row g-3">
                        <div class="col-md-6"><label class="small fw-bold">First Name</label><input type="text" name="firstName" class="form-control" required></div>
                        <div class="col-md-6"><label class="small fw-bold">Last Name</label><input type="text" name="lastName" class="form-control" required></div>
                        <div class="col-md-6"><label class="small fw-bold">Mobile No (Username)</label><input type="text" name="mobileNo" class="form-control" maxlength="10" required></div>
                        <div class="col-md-6"><label class="small fw-bold">Email ID</label><input type="email" name="emailID" class="form-control" required></div>
                        <div class="col-md-6"><label class="small fw-bold">Qualification</label><input type="text" name="qualification" class="form-control" required></div>
                        <div class="col-md-6"><label class="small fw-bold">City</label><input type="text" name="city" class="form-control" required></div>
                    </div>
                    <button type="submit" class="btn btn-success w-100 rounded-pill mt-4 fw-bold">Submit Teacher</button>
                </form>
            </div>
        </div>
    </div>
</div>


<!--Add Volunteer Model-->
<div class="modal fade" id="modalAddVolunteer" tabindex="-1">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content rounded-4 border-0 shadow-lg p-3">
            <div class="modal-header border-bottom-0 pb-0">
                <h5 class="fw-bold text-success"><i class="bi bi-people-fill me-2"></i> Register New Volunteer</h5>
                <button type="button" class="btn-close shadow-none" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <form id="frmAddVolunteer">
                    <input type="hidden" name="portalId" value="7" />
                    <input type="hidden" name="role" value="HF_Volunteers" />
                    <div class="row g-3">
                        <div class="col-md-6"><label class="small fw-bold">First Name</label><input type="text" name="firstName" class="form-control" required></div>
                        <div class="col-md-6"><label class="small fw-bold">Last Name</label><input type="text" name="lastName" class="form-control" required></div>
                        <div class="col-md-6"><label class="small fw-bold">Mobile No (Username)</label><input type="text" name="mobileNo" class="form-control" maxlength="10" required></div>
                        <div class="col-md-6"><label class="small fw-bold">Email ID</label><input type="email" name="emailID" class="form-control" required></div>                    
                        <div class="col-md-6"><label class="small fw-bold">City</label><input type="text" name="city" class="form-control" required></div>
                    </div>
                    <button type="submit" class="btn btn-success w-100 rounded-pill mt-4 fw-bold">Submit Volunteer</button>
                </form>
            </div>
        </div>
    </div>
</div>
<!-- REQUIRED DEPENDENCY ORDER: jQuery MUST load first -->


@section Scripts {
    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <!-- Tabulator JS, SheetJS, Moment.js, SweetAlert2 & MultiSelect -->
    <script type="text/javascript" src="https://unpkg.com/tabulator-tables@6.2.5/dist/js/tabulator.min.js"></script>
    <script type="text/javascript" src="https://cdn.jsdelivr.net/npm/xlsx@0.18.5/dist/xlsx.full.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/moment.js/2.29.4/moment.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="~/Content/MultiSelect/bootstrap-multiselect.js" type="text/javascript"></script>
    <script>
      
        let studentTable, teacherTable, volunteerTable;

        $(document).ready(function() {
            const urlParams = new URLSearchParams(window.location.search);

            const activeTab = urlParams.get('tab');
            const uploadType = urlParams.get('type');

            if (activeTab === 'student') {
                $('#student-tab').tab('show');
            }
            else if (activeTab === 'teacher') {
                $('#teacher-tab').tab('show');
            }
