            function loadSchoolHubData() {
                // Fetch all data from the centralized Universal API endpoint
                $.get('/api/universal/school-lists', function(res) {
                    if (res.success) {
                        initStudentTable(res.students || []);

                        let teachersList = res.teachers || [];
                        teachersList.forEach(function(teacher) {
                            var fname = teacher.firstName || teacher.FirstName || '';
                            var lname = teacher.lastName || teacher.LastName || '';
                            teacher.FirstName = (fname + ' ' + lname).trim();

                            let rawDate = teacher.createdDate || teacher.CreatedDate;
                            if (rawDate) {
                                teacher.CreatedDate = moment(rawDate).format('DD-MMM-YYYY hh:mm A');
                            } else {
                                teacher.CreatedDate = "N/A";
                            }
                        });
                        initTeacherTable(teachersList);
                        initVolunteerTable(res.volunteers || []);

                        let logRows = '';
                        (res.logs || []).forEach(l => {
                            logRows += `<tr><td><span class="badge bg-info-subtle text-info">${l.uploadType}</span></td><td>${l.fileName}</td><td><span class="badge bg-success-subtle text-success">${l.status}</span></td><td>${new Date(l.uploadedDate).toLocaleString()}</td><td><a href="${l.filePath}" target="_blank" class="btn btn-sm btn-light border"><i class="bi bi-download"></i></a></td></tr>`;
                        });
                        $('#logsTable tbody').html(logRows || '<tr><td colspan="5" class="text-center text-muted">No bulk uploads recorded.</td></tr>');
                    }
                }).fail(function() {
                    initStudentTable([]);
                    initTeacherTable([]);
                    initVolunteerTable([]);
