                                Swal.fire('Success!', result.message, 'success').then(() => { location.reload(); });
                            } else {
                                Swal.fire('Info', result.message, 'error');
                            }
                        },
                        error: function() {
                            Swal.fire('Exception Caught', 'Relational integrity constraints blocked immediate elimination.', 'error');
                        }
                    });
                }
            });
        }

        // Open Assign Standards Modal for Teacher
        function fnAssignTeacher(teacherId, teacherName, standard) {
            $('#dll_Standard').multiselect("clearSelection");
            $('#teacherName').text(teacherName);
            $('#teacherId').val(teacherId);
            if (standard) {
                var standardArray = standard.split(',');
                $('#dll_Standard').multiselect('select', standardArray);
            }
        }

            function fnSubmitStandardToTeacher() {
                var teacherId = $('#teacherId').val();
                var standarddata = [];

                var selectedStandard = $("#dll_Standard")[0];
                if (selectedStandard && selectedStandard.selectedOptions) {
                    for (var i = 0; i < selectedStandard.selectedOptions.length; i++) {
                        standarddata.push(selectedStandard.selectedOptions[i].text);
                    }
                }

                if (standarddata.length == 0) {
                    Swal.fire('Selection Empty', 'Please match at least 1 grade standard subset row to proceed.', 'warning');
                    return false;
                }

                var standard = standarddata.join();

                $.ajax({
                    type: "GET",
                    url: '/api/school/assign-standards',
                    data: { teacherId: teacherId, standard: standard },
                    dataType: 'json',
                    success: function(result) {
                        let isSuccess = result.success !== undefined ? result.success : result.Success;
                        let messageText = result.message || result.Message || "Standards assigned successfully.";

                        if (isSuccess) {
                            var modalEl = document.getElementById('assignStandardList');
                            var modal = bootstrap.Modal.getInstance(modalEl);
                            if (modal) {
                                modal.hide();
                            } else {
                                $('#assignStandardList').modal('hide');
                                $('.modal-backdrop').remove();
                                $('body').removeClass('modal-open');
                            }

                            Swal.fire('Assigned!', messageText, 'success').then(() => {
                                location.reload();
                            });
                        } else {
                            Swal.fire('Info', messageText, 'error');
                        }
                    },
                    error: function(xhr) {
                        Swal.fire('Error', xhr.responseJSON?.message || 'An execution anomaly halted standard directory updates.', 'error');
                    }
                });
            }
       
    </script>
}