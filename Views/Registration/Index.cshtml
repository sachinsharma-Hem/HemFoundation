                e.preventDefault();
                let $form = $(this);
                let $submitBtn = $form.find('button[type="submit"]');

                if ($submitBtn.prop('disabled')) {
                    return;
                }

                let formData = new FormData(this);
                let isStudent = $form.attr('id') === 'frmAddStudent';

                $submitBtn.prop('disabled', true);
                let originalBtnText = $submitBtn.html();
                $submitBtn.html('<span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>Processing...');

                $.ajax({
                    url: '/api/universal/register',
                    type: 'POST',
                    data: formData,
                    processData: false,
                    contentType: false,
                    success: function(res) {
                        if (res.success) {
                            alert(res.message);
                            $form[0].reset();
                            if (isStudent) $('#modalAddStudent').modal('hide');
                            else if ($form.attr('id') === 'frmAddTeacher') $('#modalAddTeacher').modal('hide');
                            else $('#modalAddVolunteer').modal('hide');
                            $submitBtn.prop('disabled', false);
                            $submitBtn.html(originalBtnText);
                            loadSchoolHubData();
                        } else {
                            $submitBtn.prop('disabled', false);
                            $submitBtn.html(originalBtnText);
                        }
                    },
                    error: function(xhr) {
                        $submitBtn.prop('disabled', false);
                        $submitBtn.html(originalBtnText);
                        alert(xhr.responseJSON?.message || "Registration failed.");
                    }
                });
            });

