@{
    ViewData["Title"] = "HEM Sampark Dashboard";
    Layout = "~/Views/Shared/Layouts/_SamparkLayout.cshtml";
}

<div class="container-fluid py-4 bg-light min-vh-100" id="samparkApp">

    <!-- Top Greeting & Daily Card -->
    <div class="row g-4 mb-4">
        <div class="col-12 col-lg-7">
            <div class="card border-0 rounded-4 shadow-sm p-4 h-100 bg-white">
                <div class="d-flex align-items-center justify-content-between mb-2">
                    <div class="d-flex align-items-center gap-2 text-warning">
                        <i class="bi bi-sun-fill fs-4"></i>
                        <span class="fw-bold text-dark" id="greetingUserText">Good Morning, Champion!</span>
                    </div>
                    <!-- View PDF Icon Button -->
                    <button id="viewPdfBtn" class="btn btn-danger btn-sm rounded-pill px-3 fw-semibold shadow-sm" data-bs-toggle="modal" data-bs-target="#pdfViewerModal">
                        <i class="bi bi-file-earmark-pdf-fill"></i> Read Daily PDF
                    </button>
                </div>
                <p class="text-muted small mb-3">Let's make today a better day!</p>

                <!-- Dynamic Today's Value Box -->
                <div class="p-3 rounded-4 mb-3" style="background: #fff7f5; border: 1px solid #ffd9d3;">
                    <div class="d-flex justify-content-between align-items-center mb-1">
                        <span class="badge bg-danger-subtle text-danger fw-bold">TODAY'S VALUE</span>
                        <small id="entryDateText" class="text-muted"></small>
                    </div>
                    <h5 id="celebrationHeading" class="fw-bold text-dark mb-1">Loading...</h5>
                    <p id="celebrationContent" class="text-secondary small mb-3 text-truncate-2"></p>
                </div>

                <button id="startChallengeBtn" class="btn text-white w-100 py-3 rounded-pill fw-bold shadow-sm border-0 d-flex align-items-center justify-content-center gap-2" style="background: #6f42c1; display: none;" onclick="startChallenge()">
                    <i class="bi bi-play-circle-fill"></i> START TODAY'S CHALLENGE
                </button>
            </div>
        </div>

        <!-- 7-Day Streak & Previous Submission Result Card -->
        <div class="col-12 col-lg-5">
            <div class="card border-0 rounded-4 shadow-sm p-4 h-100 bg-white d-flex flex-column justify-content-between">
                <div>
                    <div class="d-flex align-items-center gap-2 mb-3 text-danger">
                        <i class="bi bi-fire fs-4"></i>
                        <h5 class="fw-bold m-0 text-dark">Challenge Status & Streak</h5>
                    </div>

                    <!-- Dynamic Previous Result Container -->
                    <div id="previousResultContainer" class="p-3 rounded-3 mb-3 border bg-light d-none">
                        <h6 class="fw-bold text-success mb-1"><i class="bi bi-patch-check-fill me-1"></i> Challenge Completed!</h6>
                        <p class="small text-muted mb-1">You have already submitted today's quiz.</p>
                        <div class="fw-bold text-dark">Your Score: <span id="lblPreviousScore" class="text-primary">-</span></div>
                        <small class="text-muted" id="lblSubmittedTime">-</small>
                    </div>

                    <div id="pendingChallengeNotice" class="alert alert-warning border-0 rounded-3 small p-3 mb-3">
                        <i class="bi bi-info-circle-fill me-1"></i> Read the daily PDF and complete today's challenge to keep your streak alive!
                    </div>
                </div>

                <div class="alert alert-success border-0 rounded-3 small p-3 mb-0">
                    <span class="fw-bold">Value Streak Active!</span> Come back tomorrow for a new challenge.
                </div>
            </div>
        </div>
    </div>

    <!-- Quiz Container Area -->
    <div id="quizContainerCard" class="card border-0 rounded-4 shadow-sm p-4 bg-white d-none mb-4">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h5 id="quizHeaderTitle" class="fw-bold text-primary m-0">Day's Challenge Quiz</h5>
            <span id="quizProgressText" class="badge bg-secondary">Question 1</span>
        </div>
        <div id="quizQuestionBox"></div>
    </div>
</div>

<!-- PDF Viewer Modal -->
<div class="modal fade" id="pdfViewerModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-centered">
        <div class="modal-content rounded-4 border-0 shadow-lg">
            <div class="modal-header bg-dark text-white">
                <h5 class="modal-title fw-bold"><i class="bi bi-book-fill text-warning"></i> Daily Sampark Reading Material</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-0 overflow-hidden" style="height: 80vh;">
                <iframe id="pdfIframe" src="" width="100%" height="100%" style="border:none;"></iframe>
            </div>
            <div class="modal-footer bg-light">
                <button type="button" class="btn btn-success rounded-pill px-4 fw-bold" data-bs-dismiss="modal">
                    <i class="bi bi-check-circle"></i> I Have Read It, Start Quiz
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <script>
        let currentEntryData = null;
        let currentQuestionIndex = 0;
        let userAnswers = [];
        let isSubmitting = false;
        let selectedOption = null;
        let quizCompleted = false;

        document.addEventListener("DOMContentLoaded", loadTodayData);

        async function readApiResponse(response) {
            const text = await response.text();

            try {
                return text ? JSON.parse(text) : {};
            } catch {
                console.error("Non-JSON API response:", text);
                throw new Error(
                    `Server returned an invalid response (HTTP ${response.status}). Check server logs.`
                );
            }
        }

        async function loadTodayData() {
            try {
                const response = await fetch(
                    "/api/hem-sampark/today-entry"
                );

                const result = await readApiResponse(response);

                if (!response.ok || !result.success) {
                    throw new Error(
                        result.message || "Today's challenge is unavailable."
                    );
                }

                currentEntryData = result.data;

                document.getElementById("greetingUserText").textContent =
                    `Good Morning, ${result.userName || "Champion"}!`;

                document.getElementById("entryDateText").textContent =
                    currentEntryData.entryDate || "";

                document.getElementById("celebrationHeading").textContent =
                    currentEntryData.celebrationHeadingEn || "";

                document.getElementById("celebrationContent").textContent =
                    currentEntryData.celebrationContentEn || "";

                if (currentEntryData.pdfUrl) {
                    document.getElementById("pdfIframe").src =
                        currentEntryData.pdfUrl;

                    const pdfShownKey =
                        `pdf_shown_${currentEntryData.id}`;

                    if (!sessionStorage.getItem(pdfShownKey)) {
                        bootstrap.Modal
                            .getOrCreateInstance(
                                document.getElementById("pdfViewerModal")
                            )
                            .show();

                        sessionStorage.setItem(pdfShownKey, "true");
                    }
                }

                if (result.isSubmitted && result.submissionDetails) {
                    showCompletedState(result.submissionDetails);
                } else {
                    quizCompleted = false;

                    document.getElementById("startChallengeBtn")
                        .style.display = "flex";

                    document.getElementById("pendingChallengeNotice")
                        .style.display = "block";

                    document.getElementById("previousResultContainer")
                        .classList.add("d-none");
                }
            } catch (error) {
                console.error("Error loading today's quiz:", error);

                document.getElementById("celebrationHeading").textContent =
                    "Unable to load today's challenge";

                document.getElementById("celebrationContent").textContent =
                    error.message;
            }
        }

        function showCompletedState(details) {
            quizCompleted = true;
            isSubmitting = false;

            const score = Number(details.score ?? 0);
            const total = Number(details.totalQuestions ?? 0);
            const correct = Number(details.correctAnswers ?? score);
            const wrong = Number(
                details.wrongAnswers ?? Math.max(0, total - correct)
            );

            document.getElementById("startChallengeBtn").style.display =
                "none";

            document.getElementById("pendingChallengeNotice")
                .style.display = "none";

            document.getElementById("previousResultContainer")
                .classList.remove("d-none");

            document.getElementById("lblPreviousScore").textContent =
                `${score} / ${total}`;

            document.getElementById("lblSubmittedTime").textContent =
                `Completed on: ${details.submittedAt || "Today"}`;

            const container =
                document.getElementById("previousResultContainer");

            let summary = document.getElementById("quizResultSummary");

            if (!summary) {
                summary = document.createElement("div");
                summary.id = "quizResultSummary";
                summary.className = "mt-2";
                container.appendChild(summary);
            }

            summary.innerHTML = `
                        <div class="row g-2 mt-2">
                            <div class="col-6">
                                <div class="bg-success-subtle rounded-3 p-3">
                                    <div class="small text-muted">Correct Answers</div>
                                    <div class="fs-4 fw-bold text-success">
                                        ${correct}
                                    </div>
                                </div>
                            </div>
                            <div class="col-6">
                                <div class="bg-danger-subtle rounded-3 p-3">
                                    <div class="small text-muted">Wrong Answers</div>
                                    <div class="fs-4 fw-bold text-danger">
                                        ${wrong}
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="alert alert-success mt-3 mb-0">
                            <i class="bi bi-check-circle-fill me-1"></i>
                            <strong>Today's Challenge Completed!</strong>
                            <div class="small mt-1">
                                You have completed today's quiz.
                                Come back tomorrow for the next challenge.
                            </div>
                        </div>
                    `;

            document.getElementById("quizContainerCard")
                .classList.add("d-none");
        }

        function startChallenge() {
            if (quizCompleted || isSubmitting) return;

            if (!currentEntryData ||
                !currentEntryData.questions ||
                currentEntryData.questions.length === 0) {

                Swal.fire({
                    icon: "info",
                    title: "Notice",
                    text: "No questions available for today's challenge."
                });

                return;
            }

            currentQuestionIndex = 0;
            userAnswers = [];
            selectedOption = null;

            document.getElementById("quizContainerCard")
                .classList.remove("d-none");

            document.getElementById("quizContainerCard")
                .scrollIntoView({ behavior: "smooth" });

            renderQuestion();
        }

        function renderQuestion() {
            if (quizCompleted || isSubmitting) return;

            const questions = currentEntryData.questions;

            if (currentQuestionIndex >= questions.length) {
                submitQuizResults();
                return;
            }

            const question = questions[currentQuestionIndex];

            selectedOption = null;

            document.getElementById("quizProgressText").textContent =
                `Question ${currentQuestionIndex + 1} of ${questions.length}`;

            const questionBox =
                document.getElementById("quizQuestionBox");

            questionBox.replaceChildren();

            const heading = document.createElement("p");
            heading.className = "fw-bold fs-6 text-dark mb-3";
            heading.textContent =
                `Q${currentQuestionIndex + 1}. ${question.questionText || ""}`;

            questionBox.appendChild(heading);

            const options = [
                question.option1,
                question.option2,
                question.option3,
                question.option4
            ];

            const optionsContainer = document.createElement("div");
            optionsContainer.className =
                "d-flex flex-column gap-2 mb-3";

            options.forEach((option, index) => {
                const button = document.createElement("button");

                button.type = "button";
                button.className =
                    "btn btn-outline-primary text-start py-2 px-3 rounded-3 option-btn";

                button.textContent =
                    `${index + 1}) ${option || `Option ${index + 1}`}`;

                button.addEventListener("click", () => {
                    selectedOption = index + 1;

                    optionsContainer
                        .querySelectorAll("button")
                        .forEach((item, itemIndex) => {
                            item.classList.toggle(
                                "active",
                                itemIndex + 1 === selectedOption
                            );
                        });

                    nextButton.disabled = false;
                });

                optionsContainer.appendChild(button);
            });

            questionBox.appendChild(optionsContainer);

            const nextButton = document.createElement("button");

            nextButton.type = "button";
            nextButton.className =
                "btn btn-primary rounded-pill px-4 fw-bold";

            nextButton.textContent =
                currentQuestionIndex === questions.length - 1
                    ? "Finish Challenge"
                    : "Next Question";

            nextButton.disabled = true;

            nextButton.addEventListener("click", () => {
                if (selectedOption === null || isSubmitting) return;

                userAnswers.push({
                    questionId: question.id,
                    selectedOption: selectedOption
                });

                currentQuestionIndex++;
                renderQuestion();
            });

            questionBox.appendChild(nextButton);
        }

        async function submitQuizResults() {
            if (isSubmitting || quizCompleted) return;

            if (userAnswers.length !==
                currentEntryData.questions.length) {
                Swal.fire({
                    icon: "warning",
                    title: "Incomplete Quiz",
                    text: "Please answer every question."
                });
                return;
            }

            isSubmitting = true;

            const questionBox =
                document.getElementById("quizQuestionBox");

            questionBox.innerHTML = `
                        <div class="text-center py-5">
                            <div class="spinner-border text-primary mb-3"
                                 role="status"></div>
                            <p class="fw-semibold">Submitting your answers...</p>
                        </div>
                    `;

            try {
                const response = await fetch(
                    "/api/hem-sampark/submit-quiz",
                    {
                        method: "POST",
                        headers: {
                            "Content-Type": "application/json"
                        },
                        body: JSON.stringify({
                            dailyEntryId: currentEntryData.id,
                            answers: userAnswers
                        })
                    }
                );

                const result = await readApiResponse(response);

                if (response.status === 409 &&
                    result.alreadySubmitted) {
                    await loadTodayData();

                    Swal.fire({
                        icon: "info",
                        title: "Already Completed",
                        text: "Today's challenge has already been submitted."
                    });

                    return;
                }

                if (!response.ok || !result.success) {
                    throw new Error(
                        result.message || "Quiz submission failed."
                    );
                }

                showCompletedState({
                    score: result.score,
                    totalQuestions: result.total,
                    correctAnswers: result.correctAnswers,
                    wrongAnswers: result.wrongAnswers,
                    submittedAt: result.submittedAt
                });

                Swal.fire({
                    icon: "success",
                    title: "Today's Challenge Completed!",
                    html: `
                                <div class="mb-3">Great job completing today's quiz!</div>
                                <div class="fs-5 fw-bold">
                                    Score: ${result.score} / ${result.total}
                                </div>
                                <div class="text-success mt-2">
                                    Correct answers: ${result.correctAnswers}
                                </div>
                                <div class="text-danger">
                                    Wrong answers: ${result.wrongAnswers}
                                </div>
                            `,
                    confirmButtonText: "View Result",
                    confirmButtonColor: "#198754"
                }).then(() => {
                    document.getElementById("previousResultContainer")
                        .scrollIntoView({ behavior: "smooth" });
                });

            } catch (error) {
                console.error("Submission failed:", error);

                Swal.fire({
                    icon: "error",
                    title: "Submission Failed",
                    text: error.message ||
                        "Unable to submit the quiz. Please try again."
                });

                // Do not silently discard the selected answers.
                // The server may have saved the submission despite
                // a network failure, so reload authoritative status.
                await loadTodayData();

            } finally {
                isSubmitting = false;
            }
        }
    </script>
}