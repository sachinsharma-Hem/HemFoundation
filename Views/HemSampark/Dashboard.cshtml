@{
    ViewData["Title"] = "HEM Sampark Dashboard";
    Layout = "~/Views/Shared/Layouts/_SamparkLayout.cshtml";
}

@section Nav {
    <nav class="hs-nav" aria-label="HEM Sampark sections">
        <button type="button" data-hs-nav="home" class="active"><i class="bi bi-house-heart"></i> Today</button>
        <button type="button" data-hs-nav="history"><i class="bi bi-graph-up-arrow"></i> My Performance</button>
    </nav>
}

@* The whole dashboard is rendered by wwwroot/js/hem-sampark.js from the
   /api/hem-sampark endpoints. No publication or quiz data is embedded here. *@
<div id="hsView" class="hs-view" aria-live="polite">
    <div class="hs-loading">
        <div class="hs-spinner"></div>
        <p>Loading today's HEM Sampark…</p>
    </div>
</div>

<noscript>
    <div class="hs-card">Please enable JavaScript to use HEM Sampark.</div>
</noscript>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="~/js/hem-sampark.js" asp-append-version="true"></script>
}
