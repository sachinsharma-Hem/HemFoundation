@{
    ViewData["Title"] = "Hem Sampark Admin Panel";
    Layout = "~/Views/Shared/Layouts/_AdminLayout.cshtml";
}

@section Styles {
    <link rel="stylesheet" href="~/css/hem-sampark-admin.css" asp-append-version="true" />
}

<div class="hsa-root" id="hsaRoot">

    <div class="hsa-head">
        <div>
            <h2><i class="bi bi-newspaper me-2" style="color:var(--hsa-primary)"></i>HEM Sampark Admin</h2>
            <p>Create, review and publish the daily publication and its quiz. <span id="hsaBusinessDate"></span></p>
        </div>
        <button type="button" class="btn hsa-btn hsa-btn-primary" id="hsaNewBtn">
            <i class="bi bi-plus-lg"></i> New Publication
        </button>
    </div>

    <div class="hsa-tabs" role="tablist">
        <button type="button" class="hsa-tab active" data-hsa-tab="dashboard"><i class="bi bi-grid-1x2"></i> Dashboard</button>
        <button type="button" class="hsa-tab" data-hsa-tab="publications"><i class="bi bi-file-earmark-pdf"></i> Publications</button>
        <button type="button" class="hsa-tab" data-hsa-tab="master"><i class="bi bi-sliders"></i> Master Settings</button>
        <button type="button" class="hsa-tab" data-hsa-tab="reports"><i class="bi bi-bar-chart-line"></i> User Performance</button>
    </div>

    <!-- ===================== DASHBOARD ===================== -->
    <section class="hsa-panel active" data-hsa-panel="dashboard">
        <div class="hsa-stats" id="hsaStats"></div>

        <div class="hsa-card mb-3">
            <h3 class="hsa-card-title"><i class="bi bi-calendar-check"></i> Today's publication</h3>
            <div id="hsaToday" class="hsa-loading"><span class="hsa-spin"></span></div>
        </div>

        <div class="hsa-card">
            <h3 class="hsa-card-title"><i class="bi bi-signpost-split"></i> How publishing works</h3>
            <div class="hsa-steps">
                <div class="hsa-step"><b>Create</b>Pick the date, add the content and the quiz. It is saved as a draft.</div>
                <div class="hsa-step"><b>Generate PDF</b>The PDF is built from your content and the master settings.</div>
                <div class="hsa-step"><b>Review</b>Preview the PDF. If you edit anything, regenerate it.</div>
                <div class="hsa-step"><b>Publish</b>Users see only the published PDF, on its publication date.</div>
            </div>
        </div>
    </section>

    <!-- ===================== PUBLICATIONS ===================== -->
    <section class="hsa-panel" data-hsa-panel="publications">
        <div class="hsa-card">
            <div class="hsa-filters">
                <div>
                    <label for="hsaSearch">Search</label>
                    <input type="search" class="form-control" id="hsaSearch" placeholder="Title, heading or issue number" autocomplete="off">
                </div>
                <div>
                    <label for="hsaStatus">Status</label>
                    <select class="form-select" id="hsaStatus">
                        <option value="">All active</option>
                        <option value="Draft">Draft</option>
                        <option value="Generated">Generated</option>
                        <option value="Published">Published</option>
                        <option value="Scheduled">Scheduled (upcoming)</option>
                        <option value="Archived">Archived</option>
                    </select>
                </div>
                <div>
                    <label for="hsaFrom">From date</label>
                    <input type="date" class="form-control" id="hsaFrom">
                </div>
                <div>
                    <label for="hsaTo">To date</label>
                    <input type="date" class="form-control" id="hsaTo">
                </div>
                <div>
                    <button type="button" class="btn hsa-btn hsa-btn-light w-100" id="hsaReset"><i class="bi bi-arrow-counterclockwise"></i> Reset</button>
                </div>
            </div>

            <div class="hsa-table-wrap">
                <table class="hsa-table">
                    <thead>
                        <tr>
                            <th>Publication</th>
                            <th>Date</th>
                            <th>Status</th>
                            <th>Last generated</th>
                            <th>Last published</th>
                            <th class="text-center">Quiz</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>
                    <tbody id="hsaPubRows"></tbody>
                </table>
            </div>
            <div class="hsa-pager" id="hsaPubPager"></div>
        </div>
    </section>

    <!-- ===================== MASTER SETTINGS ===================== -->
    <section class="hsa-panel" data-hsa-panel="master">
        <form id="hsaMasterForm" class="hsa-form" novalidate>
            <div class="hsa-card mb-3">
                <h3 class="hsa-card-title"><i class="bi bi-images"></i> Logos shown at the top of every PDF</h3>
                <div class="hsa-logos">
                    <div class="hsa-logo-box">
                        <div data-hsa-logo="1"></div>
                        <label for="hsaLogo1">RR Global</label>
                        <input type="file" class="form-control form-control-sm" id="hsaLogo1" accept=".png,.jpg,.jpeg,.webp">
                    </div>
                    <div class="hsa-logo-box">
                        <div data-hsa-logo="2"></div>
                        <label for="hsaLogo2">HEM Sampark</label>
                        <input type="file" class="form-control form-control-sm" id="hsaLogo2" accept=".png,.jpg,.jpeg,.webp">
                    </div>
                    <div class="hsa-logo-box">
                        <div data-hsa-logo="3"></div>
                        <label for="hsaLogo3">Hema Foundation</label>
                        <input type="file" class="form-control form-control-sm" id="hsaLogo3" accept=".png,.jpg,.jpeg,.webp">
                    </div>
                </div>
                <div class="hsa-hint">PNG, JPG or WEBP, up to 2 MB each. Leave empty to keep the current logo.</div>
            </div>

            <div class="hsa-card mb-3">
                <h3 class="hsa-card-title"><i class="bi bi-chat-quote"></i> Default text</h3>
                <div class="row g-3">
                    <div class="col-md-6">
                        <label for="hsaMValuesEn">Values in Focus (English)</label>
                        <textarea class="form-control" id="hsaMValuesEn" rows="2"></textarea>
                    </div>
                    <div class="col-md-6">
                        <label for="hsaMValuesHi">Values in Focus (Hindi)</label>
                        <textarea class="form-control" id="hsaMValuesHi" rows="2"></textarea>
                    </div>
                    <div class="col-md-6">
                        <label for="hsaMFooterText">Footer text</label>
                        <input type="text" class="form-control" id="hsaMFooterText">
                    </div>
                    <div class="col-md-6">
                        <label for="hsaMFooterLink">Footer link</label>
                        <input type="text" class="form-control" id="hsaMFooterLink">
                    </div>
                    <div class="col-12">
                        <div class="form-check form-switch">
                            <input class="form-check-input" type="checkbox" role="switch" id="hsaMHindiBg">
                            <label class="form-check-label" for="hsaMHindiBg" style="color:var(--hsa-text);font-size:.88rem;font-weight:500">
                                Show a coloured background behind the Hindi heading in the PDF
                            </label>
                        </div>
                    </div>
                </div>
                <div class="hsa-hint">
                    The Morning Mantra is entered separately for each publication.
                    Values in Focus here is the default, used when a publication leaves it empty.
                    Published PDFs do not change; today's and upcoming publications are marked "PDF outdated" until regenerated.
                </div>
            </div>

            <div class="d-flex flex-wrap align-items-center gap-3">
                <button type="submit" class="btn hsa-btn hsa-btn-primary" id="hsaMasterSave"><i class="bi bi-check2"></i> Save Master Settings</button>
                <span class="hsa-sub" id="hsaMasterUpdated"></span>
            </div>
        </form>
    </section>

    <!-- ===================== REPORTS ===================== -->
    <section class="hsa-panel" data-hsa-panel="reports">
        <div class="hsa-card">
            <div class="hsa-filters">
                <div>
                    <label for="hsaRSearch">Search user</label>
                    <input type="search" class="form-control" id="hsaRSearch" placeholder="Name, mobile, user code or user ID" autocomplete="off">
                </div>
                <div>
                    <label for="hsaRFrom">Publication from</label>
                    <input type="date" class="form-control" id="hsaRFrom">
                </div>
                <div>
                    <label for="hsaRTo">Publication to</label>
                    <input type="date" class="form-control" id="hsaRTo">
                </div>
                <div>
                    <button type="button" class="btn hsa-btn hsa-btn-light w-100" id="hsaRReset"><i class="bi bi-arrow-counterclockwise"></i> Reset</button>
                </div>
                <div>
                    <button type="button" class="btn hsa-btn hsa-btn-primary w-100" id="hsaRExport"><i class="bi bi-download"></i> Export CSV</button>
                </div>
            </div>

            <div class="hsa-summary" id="hsaRSummary"></div>

            <div class="hsa-table-wrap">
                <table class="hsa-table" style="min-width:1020px">
                    <thead>
                        <tr>
                            <th>User</th>
                            <th>User ID</th>
                            <th>Publication</th>
                            <th class="text-center">Attempts</th>
                            <th class="text-center">Correct</th>
                            <th class="text-center">Incorrect</th>
                            <th class="text-center">Unanswered</th>
                            <th>Score</th>
                            <th>Result</th>
                            <th>Completed</th>
                        </tr>
                    </thead>
                    <tbody id="hsaRRows"></tbody>
                </table>
            </div>
            <div class="hsa-pager" id="hsaRPager"></div>
        </div>
    </section>
</div>

<!-- ===================== EDITOR ===================== -->
<div class="modal fade hsa-modal" id="hsaEditor" tabindex="-1" data-bs-backdrop="static" aria-labelledby="hsaEditorTitle" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-fullscreen-lg-down modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="hsaEditorTitle">New Publication</h5>
                <button type="button" class="btn-close" id="hsaEditorClose" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div id="hsaEditorState"></div>

                <div class="hsa-subtabs">
                    <button type="button" class="hsa-subtab active" data-hsa-sub="content">Details &amp; Content</button>
                    <button type="button" class="hsa-subtab" data-hsa-sub="quiz">Quiz <span id="hsaQCount"></span></button>
                </div>

                <form id="hsaEditorForm" class="hsa-form" novalidate autocomplete="off">
                    <div class="hsa-subpanel active" data-hsa-subpanel="content">
                        <div class="hsa-card">
                            <div class="row g-3">
                                <div class="col-md-6">
                                    <label for="hsaTitle">Publication title</label>
                                    <input type="text" class="form-control" id="hsaTitle" maxlength="250" placeholder="Defaults to the English heading">
                                </div>
                                <div class="col-6 col-md-3">
                                    <label for="hsaDate" class="hsa-req">Publication date</label>
                                    <input type="date" class="form-control" id="hsaDate" required>
                                </div>
                                <div class="col-6 col-md-3">
                                    <label for="hsaIssue" class="hsa-req">Issue number</label>
                                    <input type="number" class="form-control" id="hsaIssue" min="0" required>
                                </div>
                                <div class="col-md-6">
                                    <label for="hsaDayHi">Day (Hindi)</label>
                                    <input type="text" class="form-control" id="hsaDayHi" placeholder="Filled from the date if left empty">
                                </div>
                                <div class="col-md-6">
                                    <label for="hsaSamvat">Vikram Samvat / details</label>
                                    <input type="text" class="form-control" id="hsaSamvat" placeholder="Vikram Samvat 2083">
                                </div>
                            </div>
                            <div class="hsa-hint">Users see this publication only on its publication date, and only after it is published. Changing the date of a published publication unpublishes it until you regenerate and publish again.</div>
                        </div>

                        <div class="hsa-card">
                            <h3 class="hsa-card-title"><i class="bi bi-sunrise"></i> Morning Mantra</h3>
                            <div class="row g-3">
                                <div class="col-md-6">
                                    <label for="hsaMantraEn">Morning Mantra (English)</label>
                                    <textarea class="form-control" id="hsaMantraEn" rows="3" placeholder="Today's Morning Mantra in English"></textarea>
                                </div>
                                <div class="col-md-6">
                                    <label for="hsaMantraHi">Morning Mantra (Hindi)</label>
                                    <textarea class="form-control" id="hsaMantraHi" rows="3" placeholder="आज का मॉर्निंग मंत्र हिंदी में"></textarea>
                                </div>
                            </div>
                            <div class="hsa-hint">Written for this publication only. If both are empty, the PDF leaves out the Morning Mantra box.</div>
                        </div>

                        <div class="hsa-card">
                            <h3 class="hsa-card-title"><i class="bi bi-stars"></i> Celebrations Today</h3>
                            <div class="row g-3">
                                <div class="col-md-6">
                                    <label for="hsaHeadEn" class="hsa-req">Heading (English)</label>
                                    <input type="text" class="form-control" id="hsaHeadEn" placeholder="WORLD WATER MONITORING DAY" required>
                                </div>
                                <div class="col-md-6">
                                    <label for="hsaHeadHi">Heading (Hindi)</label>
                                    <input type="text" class="form-control" id="hsaHeadHi" placeholder="विश्व जल निगरानी दिवस">
                                </div>
                                <div class="col-md-6">
                                    <label for="hsaContentEn" class="hsa-req">Content (English)</label>
                                    <textarea class="form-control" id="hsaContentEn" rows="9" required></textarea>
                                </div>
                                <div class="col-md-6">
                                    <label for="hsaContentHi">Content (Hindi)</label>
                                    <textarea class="form-control" id="hsaContentHi" rows="9"></textarea>
                                </div>
                                <div class="col-12">
                                    <label for="hsaImage">Picture next to the English text (optional)</label>
                                    <div class="hsa-image-row">
                                        <div class="hsa-image-thumb" id="hsaImageThumb"><i class="bi bi-image"></i></div>
                                        <div class="flex-grow-1">
                                            <input type="file" class="form-control form-control-sm" id="hsaImage" accept=".png,.jpg,.jpeg,.webp">
                                            <div class="hsa-hint">PNG, JPG or WEBP, up to 2 MB. Shown small, at the right of the English paragraph.</div>
                                            <button type="button" class="btn hsa-btn hsa-btn-light mt-2" id="hsaImageRemove" hidden><i class="bi bi-trash"></i> Remove picture</button>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="hsa-card">
                            <h3 class="hsa-card-title"><i class="bi bi-gem"></i> Values in Focus</h3>
                            <div class="row g-3">
                                <div class="col-md-6">
                                    <label for="hsaValuesEn">Values in Focus (English)</label>
                                    <textarea class="form-control" id="hsaValuesEn" rows="2" placeholder="e.g. Compassion, Respect, Awareness"></textarea>
                                </div>
                                <div class="col-md-6">
                                    <label for="hsaValuesHi">Values in Focus (Hindi)</label>
                                    <textarea class="form-control" id="hsaValuesHi" rows="2" placeholder="जैसे करुणा, सम्मान, जागरूकता"></textarea>
                                </div>
                            </div>
                            <div class="hsa-hint">Leave empty to use the default from Master Settings.</div>
                        </div>
                    </div>

                    <div class="hsa-subpanel" data-hsa-subpanel="quiz">
                        <div class="hsa-alert hsa-alert-info">
                            <i class="bi bi-info-circle"></i>
                            <div>The question text is printed in the PDF under "Day's Challenge". Options and the correct answer are used only in the online quiz. Select the radio button next to the correct option.</div>
                        </div>
                        <div id="hsaQuestions"></div>
                        <button type="button" class="btn hsa-btn hsa-btn-light" id="hsaAddQ"><i class="bi bi-plus-lg"></i> Add question</button>
                    </div>

                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn hsa-btn hsa-btn-light me-auto" id="hsaPreviewFromEditor"><i class="bi bi-eye"></i> Preview PDF</button>
                <button type="button" class="btn hsa-btn hsa-btn-light" id="hsaSaveDraft"><i class="bi bi-save"></i> Save only</button>
                <button type="button" class="btn hsa-btn hsa-btn-primary" id="hsaSaveGenerate"><i class="bi bi-file-earmark-pdf"></i> Save &amp; Generate PDF</button>
                <button type="button" class="btn hsa-btn hsa-btn-green" id="hsaPublishFromEditor"><i class="bi bi-send-check"></i> Publish</button>
            </div>
        </div>
    </div>
</div>

<!-- ===================== PDF PREVIEW ===================== -->
<div class="modal fade hsa-modal" id="hsaPreview" tabindex="-1" aria-labelledby="hsaPreviewTitle" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-fullscreen-md-down">
        <div class="modal-content">
            <div class="modal-header gap-2 flex-wrap">
                <h5 class="modal-title me-auto" id="hsaPreviewTitle">PDF Preview</h5>
                <div class="hsa-preview-versions" id="hsaPreviewVersions"></div>
                <button type="button" class="btn-close ms-1" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div id="hsaPreviewState" class="px-3 pt-3"></div>
            <div class="modal-body hsa-preview-body" id="hsaPreviewBody"></div>
            <div class="modal-footer">
                <a class="btn hsa-btn hsa-btn-light me-auto" id="hsaPreviewDownload" href="#"><i class="bi bi-download"></i> Download</a>
                <button type="button" class="btn hsa-btn hsa-btn-light" id="hsaPreviewEdit"><i class="bi bi-pencil"></i> Edit</button>
                <button type="button" class="btn hsa-btn hsa-btn-primary" id="hsaPreviewRegenerate"><i class="bi bi-arrow-repeat"></i> Regenerate PDF</button>
                <button type="button" class="btn hsa-btn hsa-btn-green" id="hsaPreviewPublish"><i class="bi bi-send-check"></i> Publish</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/hem-sampark-admin.js" asp-append-version="true"></script>
}
