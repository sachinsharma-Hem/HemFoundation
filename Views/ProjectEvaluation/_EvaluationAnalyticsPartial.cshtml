@{
    var analyticsSummary = ViewBag.AnalyticsSummary;
}

<style>
    .analytics-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
        gap: 1.5rem;
    }

    .chart-wrapper {
        background: #f9fafb;
        border-radius: 10px;
        padding: 1rem;
        border: 1px solid #e5e7eb;
    }

    .chart-title {
        font-size: 0.95rem;
        font-weight: 600;
        color: #1f2937;
        margin-bottom: 1rem;
        display: flex;
        align-items: center;
        gap: 0.4rem;
    }

    .chart-canvas {
        position: relative;
        height: 260px;
        width: 100%;
    }

    .chart-legend {
        margin-top: 1rem;
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(100px, 1fr));
        gap: 0.6rem;
    }

    .legend-item {
        display: flex;
        align-items: center;
        gap: 0.4rem;
        font-size: 0.75rem;
        color: #374151;
    }

    .legend-color {
        width: 10px;
        height: 10px;
        border-radius: 2px;
        flex-shrink: 0;
    }

    @@media (max-width: 768px) {
        .analytics-grid {
            grid-template-columns: 1fr;
        }

        .chart-canvas {
            height: 220px;
        }
    }
</style>

<div class="analytics-grid" style="margin-top: 0;">
    <!-- Project Submission Split -->
    <div class="chart-wrapper">
        <div class="chart-title">
            <i class="bi bi-pie-chart" style="color: #5850ec;"></i>
            Project Submission Split
        </div>
        <div class="chart-canvas">
            <canvas id="submissionSplitChart"></canvas>
        </div>
        <div class="chart-legend">
            <div class="legend-item">
                <div class="legend-color" style="background: #5850ec;"></div>
                <span>Individual</span>
            </div>
            <div class="legend-item">
                <div class="legend-color" style="background: #ec4899;"></div>
                <span>Family</span>
            </div>
            <div class="legend-item">
                <div class="legend-color" style="background: #10b981;"></div>
                <span>Group</span>
            </div>
            <div class="legend-item">
                <div class="legend-color" style="background: #f59e0b;"></div>
                <span>SEL</span>
            </div>
        </div>
    </div>

    <!-- Evaluation Status by Project Type -->
    <div class="chart-wrapper">
        <div class="chart-title">
            <i class="bi bi-bar-chart" style="color: #10b981;"></i>
            Evaluation Status by Type
        </div>
        <div class="chart-canvas">
            <canvas id="evaluationStatusChart"></canvas>
        </div>
        <div class="chart-legend">
            <div class="legend-item">
                <div class="legend-color" style="background: #10b981;"></div>
                <span>Green</span>
            </div>
            <div class="legend-item">
                <div class="legend-color" style="background: #f59e0b;"></div>
                <span>Orange</span>
            </div>
            <div class="legend-item">
                <div class="legend-color" style="background: #ef4444;"></div>
                <span>Red</span>
            </div>
            <div class="legend-item">
                <div class="legend-color" style="background: #d1d5db;"></div>
                <span>Pending</span>
            </div>
        </div>
    </div>

    <!-- Overall Evaluation Status -->
    <div class="chart-wrapper">
        <div class="chart-title">
            <i class="bi bi-shield-check" style="color: #f59e0b;"></i>
            Overall Evaluation Status
        </div>
        <div class="chart-canvas">
            <canvas id="overallStatusChart"></canvas>
        </div>
        <div class="chart-legend">
            <div class="legend-item">
                <div class="legend-color" style="background: #10b981;"></div>
                <span>Excellent</span>
            </div>
            <div class="legend-item">
                <div class="legend-color" style="background: #f59e0b;"></div>
                <span>Good</span>
            </div>
            <div class="legend-item">
                <div class="legend-color" style="background: #ef4444;"></div>
                <span>Needs Work</span>
            </div>
        </div>
    </div>
</div>


